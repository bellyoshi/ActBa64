' TypesField - フィールドの配置と検索

Function TyFind(t As *TypeTable, name As *Byte) As Long
    Dim i As Long
    Dim names As *Byte
    Dim off As Long
    TyFind = -1
    If t = NULL Then Exit Function
    names = t->typeNames
    i = 0
    While i < t->nTypes
        off = i * TYNAME_LEN
        If TyNameEq(VarPtr(names[off]), name) <> 0 Then
            TyFind = i
            Exit Function
        End If
        i = i + 1
    Wend
End Function

Function TySizeOfName(t As *TypeTable, name As *Byte) As Long
    Dim sz As Long
    Dim ti As Long
    Dim sizes As *Long
    TySizeOfName = 0
    sz = TyPrimSize(name)
    If sz > 0 Then
        TySizeOfName = sz
        Exit Function
    End If
    ti = TyFind(t, name)
    If ti < 0 Then Exit Function
    sizes = t->typeSizes
    TySizeOfName = sizes[ti]
End Function

Function TyAdd(t As *TypeTable, name As *Byte) As Long
    Dim i As Long
    Dim names As *Byte
    Dim firsts As *Long
    Dim sizes As *Long
    Dim j As Long
    Dim off As Long

    TyAdd = -1
    If t = NULL Then Exit Function
    i = TyFind(t, name)
    If i >= 0 Then
        TyAdd = i
        Exit Function
    End If
    If TyEnsureTypeCap(t) = 0 Then Exit Function
    i = t->nTypes
    names = t->typeNames
    firsts = t->typeFirst
    sizes = t->typeSizes
    off = i * TYNAME_LEN
    j = 0
    While name[j] <> 0 And j < TYNAME_LEN - 1
        names[off + j] = name[j]
        j = j + 1
    Wend
    names[off + j] = 0
    sizes[i] = 0
    firsts[i] = -1
    t->typeIsClass[i] = 0
    t->typeVirtFirst[i] = -1
    t->typeVirtCount[i] = 0
    t->typeExplicitAlign[i] = 0
    t->nTypes = i + 1
    TyAdd = i
End Function

Function TySetExplicitAlign(t As *TypeTable, typeIdx As Long, align As Long) As Long
    TySetExplicitAlign = 0
    If t = NULL Then Exit Function
    If typeIdx < 0 Or typeIdx >= t->nTypes Then Exit Function
    If align <> 1 And align <> 2 And align <> 4 And align <> 8 And align <> 16 Then Exit Function
    t->typeExplicitAlign[typeIdx] = align
    TySetExplicitAlign = 1
End Function

Function TySetClass(t As *TypeTable, typeIdx As Long) As Long
    TySetClass = 0
    If t = NULL Then Exit Function
    If typeIdx < 0 Or typeIdx >= t->nTypes Then Exit Function
    t->typeIsClass[typeIdx] = 1
    TySetClass = 1
End Function

Function TyIsClass(t As *TypeTable, typeIdx As Long) As Long
    TyIsClass = 0
    If t = NULL Then Exit Function
    If typeIdx < 0 Or typeIdx >= t->nTypes Then Exit Function
    If t->typeIsClass[typeIdx] = 1 Then TyIsClass = 1
End Function

Function TySetFnPtr(t As *TypeTable, typeIdx As Long, params As Long, retTy As Long) As Long
    TySetFnPtr = 0
    If t = NULL Then Exit Function
    If typeIdx < 0 Or typeIdx >= t->nTypes Then Exit Function
    t->typeIsClass[typeIdx] = 2
    t->typeFirst[typeIdx] = params
    t->typeVirtCount[typeIdx] = retTy
    t->typeSizes[typeIdx] = TyPtrSize()
    TySetFnPtr = 1
End Function

Function TyIsFnPtr(t As *TypeTable, typeIdx As Long) As Long
    TyIsFnPtr = 0
    If t = NULL Then Exit Function
    If typeIdx < 0 Or typeIdx >= t->nTypes Then Exit Function
    If t->typeIsClass[typeIdx] = 2 Then TyIsFnPtr = 1
End Function

' フィールドを持たない型のアラインメント（サイズから推定）
Function TyAlignOfLeaf(t As *TypeTable, typeIdx As Long) As Long
    Dim tsizes As *Long
    Dim esz As Long
    Dim best As Long
    tsizes = t->typeSizes
    esz = tsizes[typeIdx]
    best = 1
    If esz >= 8 Then
        best = 8
    ElseIf esz >= 4 Then
        best = 4
    ElseIf esz >= 2 Then
        best = 2
    End If
    If t->typeExplicitAlign[typeIdx] > best Then best = t->typeExplicitAlign[typeIdx]
    TyAlignOfLeaf = best
End Function

' C 互換: 型のアラインメント（ネスト UDT は要素の最大整列。size 丸めではない）
Function TyAlignOf(t As *TypeTable, typeIdx As Long) As Long
    Dim fi As Long
    Dim nexts As *Long
    Dim firsts As *Long
    Dim sizes As *Long
    Dim tys As *Long
    Dim a As Long
    Dim best As Long
    Dim esz As Long
    Dim fty As Long

    TyAlignOf = 1
    If t = NULL Then Exit Function
    If typeIdx < 0 Or typeIdx >= t->nTypes Then Exit Function
    firsts = t->typeFirst
    nexts = t->fieldNext
    sizes = t->fieldSizes
    tys = t->fieldTypeIdxs
    best = 1
    fi = firsts[typeIdx]
    If fi < 0 Then
        TyAlignOf = TyAlignOfLeaf(t, typeIdx)
        Exit Function
    End If
    While fi >= 0
        fty = tys[fi]
        esz = sizes[fi]
        If fty >= 0 Then
            a = TyAlignOf(t, fty)
        Else
            a = esz
            If a > 8 Then a = 8
            If a < 1 Then a = 1
        End If
        If a > best Then best = a
        fi = nexts[fi]
    Wend
    If t->typeExplicitAlign[typeIdx] > best Then best = t->typeExplicitAlign[typeIdx]
    TyAlignOf = best
End Function

' End Type 時にサイズを型アラインへ切り上げ（MSVC 互換）
Sub TyFinalizeType(t As *TypeTable, typeIdx As Long)
    Dim tsizes As *Long
    Dim a As Long
    Dim sz As Long
    Dim remn As Long

    If t = NULL Then Exit Sub
    If typeIdx < 0 Or typeIdx >= t->nTypes Then Exit Sub
    a = TyAlignOf(t, typeIdx)
    If a < 1 Then Exit Sub
    tsizes = t->typeSizes
    sz = tsizes[typeIdx]
    remn = sz Mod a
    If remn <> 0 Then
        sz = sz + (a - remn)
        tsizes[typeIdx] = sz
    End If
End Sub

Function TyFieldAlign(t As *TypeTable, elemSize As Long, fieldTy As Long) As Long
    Dim align As Long
    ' ネスト UDT は「サイズ」ではなく「型のアライン」で整列（DXGI 等）
    If fieldTy >= 0 Then
        align = TyAlignOf(t, fieldTy)
    Else
        align = elemSize
    End If
    If align > 8 Then align = 8
    If align < 1 Then align = 1
    TyFieldAlign = align
End Function

Function TyAlignFieldOff(off As Long, align As Long) As Long
    Dim cur As Long
    Dim last As Long
    cur = align - 1
    last = off And cur
    While last <> 0
        off = off + 1
        last = off And cur
    Wend
    TyAlignFieldOff = off
End Function

Sub TyCopyFieldName(names As *Byte, fi As Long, name As *Byte)
    Dim j As Long
    Dim cur As Long
    j = 0
    cur = fi * TYNAME_LEN
    While name[j] <> 0 And j < TYNAME_LEN - 1
        names[cur + j] = name[j]
        j = j + 1
    Wend
    names[cur + j] = 0
End Sub

' *Long params: keep *Byte for hosts whose ParseParamType lacks *Long (pre-fix stage0).
Sub TyLinkField(firsts As *Byte, nexts As *Byte, typeIdx As Long, fi As Long)
    Dim last As Long
    Dim firstsL As *Long
    Dim nextsL As *Long
    firstsL = firsts As *Long
    nextsL = nexts As *Long
    If firstsL[typeIdx] < 0 Then
        firstsL[typeIdx] = fi
    Else
        last = firstsL[typeIdx]
        While nextsL[last] >= 0
            last = nextsL[last]
        Wend
        nextsL[last] = fi
    End If
End Sub

Function TyAddField(t As *TypeTable, typeIdx As Long, name As *Byte, elemSize As Long, count As Long, fieldTy As Long) As Long
    Dim fi As Long
    Dim names As *Byte
    Dim offs As *Long
    Dim sizes As *Long
    Dim counts As *Long
    Dim nexts As *Long
    Dim firsts As *Long
    Dim tys As *Long
    Dim tsizes As *Long
    Dim off As Long
    Dim align As Long

    TyAddField = 0
    If t = NULL Then Exit Function
    If typeIdx < 0 Or typeIdx >= t->nTypes Then Exit Function
    If elemSize <= 0 Or count <= 0 Then Exit Function
    If TyEnsureFieldCap(t) = 0 Then Exit Function

    align = TyFieldAlign(t, elemSize, fieldTy)
    tsizes = t->typeSizes
    off = TyAlignFieldOff(tsizes[typeIdx], align)

    fi = t->nFields
    names = t->fieldNames
    offs = t->fieldOffs
    sizes = t->fieldSizes
    counts = t->fieldCounts
    nexts = t->fieldNext
    firsts = t->typeFirst
    tys = t->fieldTypeIdxs

    TyCopyFieldName(names, fi, name)
    offs[fi] = off
    sizes[fi] = elemSize
    counts[fi] = count
    tys[fi] = fieldTy
    nexts[fi] = -1

    TyLinkField(firsts As *Byte, nexts As *Byte, typeIdx, fi)

    tsizes[typeIdx] = off + elemSize * count
    t->nFields = fi + 1
    TyAddField = 1
End Function

Function TyFindField(t As *TypeTable, typeIdx As Long, name As *Byte, ByRef outOff As Long, ByRef outSize As Long, ByRef outCount As Long) As Long
    Dim fieldTy As Long
    TyFindField = TyFindFieldEx(t, typeIdx, name, outOff, outSize, outCount, fieldTy)
End Function

Function TyFindFieldEx(t As *TypeTable, typeIdx As Long, name As *Byte, ByRef outOff As Long, ByRef outSize As Long, ByRef outCount As Long, ByRef outFieldTy As Long) As Long
    Dim fi As Long
    Dim names As *Byte
    Dim offs As *Long
    Dim sizes As *Long
    Dim counts As *Long
    Dim nexts As *Long
    Dim firsts As *Long
    Dim tys As *Long
    Dim cur As Long

    TyFindFieldEx = 0
    outOff = 0
    outSize = 0
    outCount = 0
    outFieldTy = -1
    If t = NULL Then Exit Function
    If typeIdx < 0 Or typeIdx >= t->nTypes Then Exit Function
    names = t->fieldNames
    offs = t->fieldOffs
    sizes = t->fieldSizes
    counts = t->fieldCounts
    nexts = t->fieldNext
    firsts = t->typeFirst
    tys = t->fieldTypeIdxs
    fi = firsts[typeIdx]
    While fi >= 0
        cur = fi * TYNAME_LEN
        If TyNameEq(VarPtr(names[cur]), name) <> 0 Then
            outOff = offs[fi]
            outSize = sizes[fi]
            outCount = counts[fi]
            outFieldTy = tys[fi]
            TyFindFieldEx = 1
            Exit Function
        End If
        fi = nexts[fi]
    Wend
End Function
