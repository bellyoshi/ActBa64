' ===================================================
'  DbgInfoType - .abdbg の var の型の名前を書く（kind / typeIdx から。String は作らない）
' ===================================================

Sub DbgOutKindLo(kind As Long)
    If kind = TY_STRING Then DbgOutZ("String")
    If kind = TY_BYTE Then DbgOutZ("Byte")
    If kind = TY_BYTE_ARR Then DbgOutZ("Byte()")
    If kind = TY_PTR_BYTE Then DbgOutZ("*Byte")
    If kind = TY_LONG_ARR Then DbgOutZ("Long()")
    If kind = TY_STRING_ARR Then DbgOutZ("String()")
    If kind = TY_PTR_LONG Then DbgOutZ("*Long")
End Sub

Sub DbgOutKindMid(kind As Long)
    If kind = TY_DOUBLE Then DbgOutZ("Double")
    If kind = TY_DOUBLE_ARR Then DbgOutZ("Double()")
    If kind = TY_SINGLE Then DbgOutZ("Single")
    If kind = TY_SINGLE_ARR Then DbgOutZ("Single()")
    If kind = TY_PTR_FUNC Then DbgOutZ("*Function")
End Sub

Sub DbgOutKindHi(kind As Long)
    If kind = TY_PTR_BYTE_ARR Then DbgOutZ("*Byte()")
    If kind = TY_WORD_ARR Then DbgOutZ("Word()")
    If kind = TY_INT64_ARR Then DbgOutZ("Int64()")
    If kind = TY_QWORD_ARR Then DbgOutZ("QWord()")
End Sub

' TY_LONG の枠の細かい種類（typeIdx）
Function DbgLongKnown(ti As Long) As Long
    DbgLongKnown = 1
    If ti = LOW_PTI_U32 Or ti = LOW_PTI_I64 Or ti = LOW_PTI_U64 Then Exit Function
    If ti = LOW_PTI_VOID Or ti = LOW_PTI_PW Then Exit Function
    DbgLongKnown = 0
End Function

Sub DbgOutLongName(ti As Long)
    If ti = LOW_PTI_U32 Then DbgOutZ("DWord")
    If ti = LOW_PTI_I64 Then DbgOutZ("Int64")
    If ti = LOW_PTI_U64 Then DbgOutZ("QWord")
    If ti = LOW_PTI_VOID Then DbgOutZ("VoidPtr")
    If ti = LOW_PTI_PW Then DbgOutZ("LONG_PTR")
    If DbgLongKnown(ti) = 0 Then DbgOutZ("Long")
End Sub

' Type / Class の名前（DbgPutUdt が写したもの。無ければ ?）
Sub DbgOutUdt(v As Long)
    Dim p As *Byte
    p = VarPtr(g_dbgVarType[BytesN(v, SYM_NAME_LEN)])
    If p[0] = 0 Then
        DbgOutZ("?")
    Else
        DbgOutZ(p)
    End If
End Sub

Sub DbgOutKind(kind As Long)
    If kind < 0 Or kind > TY_QWORD_ARR Then DbgOutZ("?")
    DbgOutKindLo(kind)
    DbgOutKindMid(kind)
    DbgOutKindHi(kind)
End Sub

Sub DbgOutType(v As Long)
    Dim kind As Long
    kind = g_dbgVarKind[v]
    If kind = TY_LONG Then DbgOutLongName(g_dbgVarTi[v])
    If kind = TY_PTR_UDT Then DbgOutZ("*")
    If kind = TY_UDT Or kind = TY_PTR_UDT Or kind = TY_UDT_ARR Then DbgOutUdt(v)
    If kind = TY_UDT_ARR Then DbgOutZ("()")
    DbgOutKind(kind)
End Sub
