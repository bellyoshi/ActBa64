#console
Declare Function ExitProcess Lib "kernel32.dll" (uExitCode As Long) As Long
Const BIG = 262144
Const MED = 32768
Const IR_STR_LEN = 256
Function BytesN(n As Long, elem As Long) As Long
    Dim r As Long
    r = n
    r = r * elem
    BytesN = r
End Function
Sub Main()
    Dim a As Long
    Dim b As Long
    a = BIG
    If a <> 262144 Then ExitProcess(1)
    b = BytesN(BIG, IR_STR_LEN)
    ' expect 67108864
    If b <> 67108864 Then ExitProcess(2)
    b = BytesN(BIG, 16)
    If b <> 4194304 Then ExitProcess(3)
    a = MED
    If a <> 32768 Then ExitProcess(4)
    ExitProcess(42)
End Sub
Main()
End
