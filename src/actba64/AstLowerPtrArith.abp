' AstLowerPtrArith - 64bit のポインタ +/- 整数は rax/rcx の 64bit で計算する
' グローバルは 4GB より上にあるので、32bit の add では上位が落ちる。

Function LowPtrTyIs(ty As Long, ti As Long) As Long
    LowPtrTyIs = 0
    If ty = TY_PTR_BYTE Or ty = TY_PTR_LONG Or ty = TY_PTR_UDT Then LowPtrTyIs = 1
    If ty = TY_LONG And ti = LOW_PTI_VOID Then LowPtrTyIs = 1
End Function

' v = off, ty, ti, byRef, glob
Function LowPtrVarIs(ctx As *LowerCtx, idx As Long) As Long
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim v(4) As Long
    Dim ast As *Ast
    LowPtrVarIs = 0
    ast = ctx->ast
    AstCopyStr(ast, idx, VarPtr(name))
    If Not LowLookupVar(ctx, VarPtr(name), VarPtr(v), VarPtr(v) + 4, VarPtr(v) + 8, VarPtr(v) + 12, VarPtr(v) + 16) Then Exit Function
    LowPtrVarIs = LowPtrTyIs(v[1], v[2])
End Function

' ポインタを返す関数の呼び出し（strstr(...) + 1 など）
Function LowPtrCallIs(ctx As *LowerCtx, idx As Long) As Long
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim ast As *Ast
    LowPtrCallIs = 0
    ast = ctx->ast
    AstCopyStr(ast, idx, VarPtr(name))
    If LowFuncIndex(ctx, VarPtr(name)) < 0 Then Exit Function
    LowPtrCallIs = LowPtrTyIs(LowFindFuncRetTy(ctx, VarPtr(name)), -1)
End Function

Function LowPtrBiIs(nodes As *AstNode, idx As Long) As Long
    Dim n As Long
    LowPtrBiIs = 0
    n = nodes[idx].num
    If n = BIK_VARPTR Or n = BIK_STRPTR Or n = BIK_ADDRESSOF Then LowPtrBiIs = 1
End Function

' ポインタ + 整数 / 整数 + ポインタ / ポインタ - 整数
Function LowPtrBinIs(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    LowPtrBinIs = 0
    nodes = LowAstNodes(ctx)
    If nodes[idx].num <> BOP_ADD And nodes[idx].num <> BOP_SUB Then Exit Function
    If LowExprIsPtr(ctx, nodes[idx].left) <> 0 Then LowPtrBinIs = 1
    If nodes[idx].num = BOP_SUB Then Exit Function
    If LowExprIsPtr(ctx, nodes[idx].right) <> 0 Then LowPtrBinIs = 1
End Function

Function LowExprIsPtr(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    LowExprIsPtr = 0
    If idx < 0 Then Exit Function
    nodes = LowAstNodes(ctx)
    If nodes[idx].kind = AST_VAR Then LowExprIsPtr = LowPtrVarIs(ctx, idx)
    If nodes[idx].kind = AST_BUILTIN Then LowExprIsPtr = LowPtrBiIs(nodes, idx)
    If nodes[idx].kind = AST_BINOP Then LowExprIsPtr = LowPtrBinIs(ctx, idx)
    If nodes[idx].kind = AST_CALL Then LowExprIsPtr = LowPtrCallIs(ctx, idx)
End Function

Function LowPtrArithUse(ctx As *LowerCtx, idx As Long) As Long
    LowPtrArithUse = 0
    If TyIs32() <> 0 Then Exit Function
    If LowExprType(ctx, idx) <> TY_LONG Then Exit Function
    LowPtrArithUse = LowPtrBinIs(ctx, idx)
End Function

' rcx = 左辺, rax = 右辺
Function LowEmitPtrPair(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    LowEmitPtrPair = 0
    nodes = LowAstNodes(ctx)
    If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
    LowEmitBinHold(ctx->list)
    If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
    LowEmitBinTake(ctx->list)
    LowEmitPtrPair = 1
End Function

' rax にポインタ側（減算は左辺）を置き、rcx 側のノードを返す
Function LowEmitPtrSwap(ctx As *LowerCtx, idx As Long, op As Long) As Long
    Dim nodes As *AstNode
    nodes = LowAstNodes(ctx)
    LowEmitPtrSwap = nodes[idx].left
    If op = BOP_ADD And LowExprIsPtr(ctx, nodes[idx].left) = 0 Then Exit Function
    IrEmit(ctx->list, OP_XCHG_RAX_RCX, 0, 0)
    LowEmitPtrSwap = nodes[idx].right
End Function

' 整数側は符号拡張する（ポインタ + 負数）
Sub LowEmitPtrOp(ctx As *LowerCtx, other As Long, op As Long)
    If LowExprIsPtr(ctx, other) = 0 Then IrEmit(ctx->list, OP_MOVSXD_RCX_ECX, 0, 0)
    If op = BOP_ADD Then IrEmit(ctx->list, OP_ADD_RAX_RCX, 0, 0)
    If op = BOP_SUB Then IrEmit(ctx->list, OP_SUB_RAX_RCX, 0, 0)
End Sub

Function LowExprBinopPtr(ctx As *LowerCtx, idx As Long, op As Long) As Long
    Dim other As Long
    LowExprBinopPtr = 0
    If LowEmitPtrPair(ctx, idx) = 0 Then Exit Function
    other = LowEmitPtrSwap(ctx, idx, op)
    LowEmitPtrOp(ctx, other, op)
    LowExprBinopPtr = 1
End Function
