' ByteCharUtils.abp - ASCII 文字コード定数と判定（Byte）
' Asc("x") や生の文字コード即値の代わりに使う
' 注意: Const 名は大小区別しないため CH_A と CH_a は共存不可
'       小文字は CH_La .. CH_Lz を使う

' --- 制御 / 空白 ---
Const CH_TAB = 9
Const CH_NL = 10
Const CH_CR = 13
Const CH_SP = 32

' --- 記号 ---
Const CH_DQUOTE = 34
Const CH_HASH = 35
Const CH_DOLLAR = 36
Const CH_AMP = 38
Const CH_SQUOTE = 39
Const CH_LPAREN = 40
Const CH_RPAREN = 41
Const CH_STAR = 42
Const CH_PLUS = 43
Const CH_COMMA = 44
Const CH_MINUS = 45
Const CH_DOT = 46
Const CH_SLASH = 47
Const CH_0 = 48
Const CH_9 = 57
Const CH_COLON = 58
Const CH_SEMI = 59
Const CH_LESS = 60
Const CH_EQ = 61
Const CH_GREATER = 62
Const CH_AT = 64
Const CH_LBRACK = 91
Const CH_BSLASH = 92
Const CH_RBRACK = 93
Const CH_CARET = 94
Const CH_UNDER = 95
Const CH_TILDE = 126

' --- 大文字 A-Z ---
Const CH_A = 65
Const CH_B = 66
Const CH_C = 67
Const CH_D = 68
Const CH_E = 69
Const CH_F = 70
Const CH_G = 71
Const CH_H = 72
Const CH_I = 73
Const CH_J = 74
Const CH_K = 75
Const CH_L = 76
Const CH_M = 77
Const CH_N = 78
Const CH_O = 79
Const CH_P = 80
Const CH_Q = 81
Const CH_R = 82
Const CH_S = 83
Const CH_T = 84
Const CH_U = 85
Const CH_V = 86
Const CH_W = 87
Const CH_X = 88
Const CH_Y = 89
Const CH_Z = 90

' --- 小文字 a-z（L 接頭）---
Const CH_La = 97
Const CH_Lb = 98
Const CH_Lc = 99
Const CH_Ld = 100
Const CH_Le = 101
Const CH_Lf = 102
Const CH_Lg = 103
Const CH_Lh = 104
Const CH_Li = 105
Const CH_Lj = 106
Const CH_Lk = 107
Const CH_Ll = 108
Const CH_Lm = 109
Const CH_Ln = 110
Const CH_Lo = 111
Const CH_Lp = 112
Const CH_Lq = 113
Const CH_Lr = 114
Const CH_Ls = 115
Const CH_Lt = 116
Const CH_Lu = 117
Const CH_Lv = 118
Const CH_Lw = 119
Const CH_Lx = 120
Const CH_Ly = 121
Const CH_Lz = 122

Function IsLower(c As Long) As Long
    If c >= CH_La And c <= CH_Lz Then
        IsLower = 1
    Else
        IsLower = 0
    End If
End Function

Function IsUpper(c As Long) As Long
    If c >= CH_A And c <= CH_Z Then
        IsUpper = 1
    Else
        IsUpper = 0
    End If
End Function

Function IsAlphabet(c As Long) As Long
    If IsUpper(c) <> 0 Or IsLower(c) <> 0 Then
        IsAlphabet = 1
    Else
        IsAlphabet = 0
    End If
End Function

Function IsDigit(c As Long) As Long
    If c >= CH_0 And c <= CH_9 Then
        IsDigit = 1
    Else
        IsDigit = 0
    End If
End Function

Function IsSpace(c As Long) As Long
    If c = CH_SP Or c = CH_TAB Or c = CH_NL Or c = CH_CR Then
        IsSpace = 1
    Else
        IsSpace = 0
    End If
End Function

' 識別子に使える文字（英字または _）
Function IsIdentChar(c As Long) As Long
    If IsAlphabet(c) <> 0 Then
        IsIdentChar = 1
    ElseIf c = CH_UNDER Then
        IsIdentChar = 1
    Else
        IsIdentChar = 0
    End If
End Function

Function IsHexDigit(c As Long) As Long
    If IsDigit(c) <> 0 Then
        IsHexDigit = 1
    ElseIf c >= CH_A And c <= CH_F Then
        IsHexDigit = 1
    ElseIf c >= CH_La And c <= CH_Lf Then
        IsHexDigit = 1
    Else
        IsHexDigit = 0
    End If
End Function

' 大文字なら小文字へ。それ以外はそのまま
Function ToLowerChar(c As Long) As Long
    If IsUpper(c) <> 0 Then
        ToLowerChar = c + 32
    Else
        ToLowerChar = c
    End If
End Function
