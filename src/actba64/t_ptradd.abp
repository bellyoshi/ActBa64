#console
Declare Function ExitProcess Lib "kernel32.dll" (uExitCode As Long) As Long
Sub Main()
    Dim buf(15) As Byte
    Dim p As *Byte
    Dim q As *Byte
    Dim i As Long
    i = 0
    While i < 16
        buf[i] = 65 + i
        i = i + 1
    Wend
    p = VarPtr(buf)
    q = p + 3
    If q[0] <> 68 Then ExitProcess(1)
    If q[1] <> 69 Then ExitProcess(2)
    ' also index form
    If (p + 5)[0] <> 70 Then ExitProcess(3)
    ExitProcess(42)
End Sub
Main()
End
