' PreprocLinux - -linux のとき Include\linux\linux.idx を既定ヘッダの後ろへ足す
' Lx_<API名> の関数が、Win32 API の呼び出しスロットに入る（LinuxRt）

Function PpFindLinuxIdx(dst As *Byte) As Long
    Dim rel(SYM_NAME_LEN - 1) As Byte
    lstrcpy(VarPtr(rel), "Include\linux\linux.idx")
    PpFindLinuxIdx = PpFindRelIdx(VarPtr(rel), dst)
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function PpAppendLinuxChunk(ByRef head As *Byte, ByRef headLen As Long) As boolean
    Dim idxPath(PP_ONCE_PATH - 1) As Byte
    PpAppendLinuxChunk = true
    If TyIsLinux() = 0 Then Exit Function
    If PpFindLinuxIdx(VarPtr(idxPath)) = 0 Then
        Print "warning: not found: Include\linux\linux.idx"
        Exit Function
    End If
    PpAppendLinuxChunk = PpAppendIdxPath(head, headLen, VarPtr(idxPath))
End Function
