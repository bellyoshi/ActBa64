' Win32 定数 (NULL / MAX_PATH / GENERIC_* / CreateFile フラグ) は
' ActiveBasic 4.20 の組み込みと Include\default\WinConsts.sbp が提供する。
' ここで再定義すると stage0 ビルドで「すでに定義されています」になる。

' Initial capacity for dynamically grown compiler tables.
Const DYN_INIT = 64

' Compile target: 0=PE32+ (AMD64), 1=PE32 (i386). Host bitness is independent.
Dim g_Target32 As Long

Sub TySetTarget32(v As Long)
    g_Target32 = v
End Sub

Function TyIs32() As Long
    TyIs32 = g_Target32
End Function

Function TyPtrSize() As Long
    If g_Target32 <> 0 Then
        TyPtrSize = 4
    Else
        TyPtrSize = 8
    End If
End Function

Function TySlotAlign(sz As Long) As Long
    Dim a As Long
    a = TyPtrSize()
    If sz < a Then sz = a
    TySlotAlign = (sz + a - 1) And (0 - a)
End Function

Function AlignUp(v As DWord, a As DWord) As DWord
    ' power-of-2 align: (v+a-1) & -a
    AlignUp = (v + a - 1) And (0 - a)
End Function

' AB4.20 は Const*Long を 16bit 乗算することがある (256*131072 → 0 → calloc(0) で AV)。
Function BytesN(n As Long, elem As Long) As Long
    Dim r As Long
    r = n
    r = r * elem
    BytesN = r
End Function

' Grow a heap buffer: calloc(newBytes), copy oldBytes, free old. On failure leave old intact and return NULL.
Function MemGrow(old As *Byte, oldBytes As Long, newBytes As Long) As *Byte
    Dim p As *Byte
    MemGrow = NULL
    If newBytes <= 0 Then Exit Function
    If newBytes < oldBytes Then Exit Function
    p = calloc(newBytes)
    If p = NULL Then Exit Function
    If old <> NULL And oldBytes > 0 Then
        memcpy(p, old, oldBytes)
        free(old)
    End If
    MemGrow = p
End Function

' AB4.20 は Const+DWord+DWord を 16bit 加算することがある (512+64000+40960 → 0)。
Sub AddTo(ByRef dst As Long, b As Long)
    dst = dst + b
End Sub

' AB4.20 の p[off] は off が 16bit のことがある。256 未満の索引だけ使い、ポインタを進める。
Sub PtrAddTo(p As *Byte, off As Long, ByRef dst As *Byte)
    Dim q As *Byte
    Dim n As Long
    q = p
    n = off
    If n < 0 Then
        dst = p
        Exit Sub
    End If
    While n >= 256
        q = VarPtr(q[256])
        n = n - 256
    Wend
    If n > 0 Then
        q = VarPtr(q[n])
    End If
    dst = q
End Sub

Function GetCmd(cnt As Long, buf As *Byte) As Long
    Dim cmd As *Byte
    Dim rawCmd[4096] As Byte
    Dim cmdlen As Long
    Dim cidx As Long
    Dim ctmp[260] As Byte
    Dim n As Long
    Dim m As Long
    cmd = GetCommandLine()
    cmdlen = lstrlen(cmd)
    If cmdlen > 4094 Then cmdlen = 4094
    ' GetCommandLine buffer is read-only; copy first
    memcpy(VarPtr(rawCmd), cmd, cmdlen)
    rawCmd[cmdlen] = 0
    buf[0] = 0
    cidx = 0
    n = 0
    While n < cmdlen
        While n < cmdlen And rawCmd[n] = 32
            n = n + 1
        Wend
        If n >= cmdlen Then Exit While
        m = 0
        If rawCmd[n] = 34 Then
            n = n + 1
            While n < cmdlen And rawCmd[n] <> 34
                If m < 259 Then
                    ctmp[m] = rawCmd[n]
                    m = m + 1
                End If
                n = n + 1
            Wend
            If n < cmdlen And rawCmd[n] = 34 Then n = n + 1
        Else
            While n < cmdlen And rawCmd[n] <> 32
                If m < 259 Then
                    ctmp[m] = rawCmd[n]
                    m = m + 1
                End If
                n = n + 1
            Wend
        End If
        ctmp[m] = 0
        If cidx = cnt Then
            lstrcpy(buf, ctmp)
            GetCmd = 1
            Exit Function
        End If
        cidx = cidx + 1
    Wend
    GetCmd = 0
End Function
Function LoadFile(path As *Byte, ByRef outSize As Long) As *Byte
    Dim hFile As HANDLE
    Dim fsiz As Long
    Dim fsizHigh As Long
    Dim nRead As Long
    Dim p As *Byte
    LoadFile = 0
    outSize = 0
    hFile = CreateFile(path, GENERIC_READ, FILE_SHARE_READ, ByVal NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL)
    If hFile = INVALID_HANDLE_VALUE Then Exit Function
    fsizHigh = 0
    fsiz = GetFileSize(hFile, fsizHigh)
    If fsiz <= 0 Then
        CloseHandle(hFile)
        Exit Function
    End If
    p = malloc(fsiz)
    If p = 0 Then
        CloseHandle(hFile)
        Exit Function
    End If
    ReadFile(hFile, p, fsiz, VarPtr(nRead), ByVal NULL)
    CloseHandle(hFile)
    outSize = fsiz
    LoadFile = p
End Function

Function WriteAll(path As *Byte, p As *Byte, size As Long) As Long
    Dim hFile As HANDLE
    Dim nWritten As Long
    WriteAll = 0
    hFile = CreateFile(path, GENERIC_WRITE, 0, ByVal NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL)
    If hFile = INVALID_HANDLE_VALUE Then Exit Function
    WriteFile(hFile, p, size, VarPtr(nWritten), ByVal NULL)
    CloseHandle(hFile)
    If nWritten = size Then
        WriteAll = 1
    End If
End Function

Sub ZeroMem(p As *Byte, n As Long)
    Dim i As Long
    If n <= 0 Then Exit Sub
    For i = 0 To n - 1
        p[i] = 0
    Next
End Sub

Sub PutDword(p As *Byte, off As DWord, v As DWord)
    Dim q As *Byte
    PtrAddTo(p, off, q)
    memcpy(q, VarPtr(v), 4)
End Sub

Sub PutWord(p As *Byte, off As DWord, v As Word)
    Dim q As *Byte
    PtrAddTo(p, off, q)
    memcpy(q, VarPtr(v), 2)
End Sub

Sub MemCopyAt(dst As *Byte, off As Long, src As *Byte, n As Long)
    Dim q As *Byte
    If n <= 0 Then Exit Sub
    PtrAddTo(dst, off, q)
    memcpy(q, src, n)
End Sub

Sub ZeroAt(dst As *Byte, off As Long, n As Long)
    Dim q As *Byte
    If n <= 0 Then Exit Sub
    PtrAddTo(dst, off, q)
    ZeroMem(q, n)
End Sub

Sub WriteDosStub(buf As *Byte)
    buf[&H40] = &H0E
    buf[&H41] = &H1F
    buf[&H42] = &HBA
    buf[&H43] = &H0E
    buf[&H44] = &H00
    buf[&H45] = &HB4
    buf[&H46] = &H09
    buf[&H47] = &HCD
    buf[&H48] = &H21
    buf[&H49] = &HB8
    buf[&H4A] = &H01
    buf[&H4B] = &H4C
    buf[&H4C] = &HCD
    buf[&H4D] = &H21
    lstrcpy(VarPtr(buf[&H4E]), "This program cannot be run in DOS mode.")
    buf[&H75] = &H0D
    buf[&H76] = &H0A
    buf[&H77] = &H24
End Sub
