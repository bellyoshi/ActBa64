' TRUE / FALSE は AstLower の組み込み定数（AB 4.20 互換: TRUE=1, FALSE=0）。
' その他 Win32 定数 (NULL / MAX_PATH / GENERIC_* 等) は Include\default\WinConsts.sbp。
' ここで再定義すると stage0 ビルドで「すでに定義されています」になる。

' Initial capacity for dynamically grown compiler tables.
Const DYN_INIT = 64
' 識別子・API 名バッファ長（Byte）。Dim x(SYM_NAME_LEN - 1) で使う
Const SYM_NAME_LEN = 64
' DLL エクスポート表（モジュール Dim。stage0 の Type フィールド上限を避ける）
Const EXP_MAX = 64
Const DLL_NAME_LEN = 260
Dim g_ppModuleDll As Long
Dim g_expCount As Long
Dim g_expNames(EXP_MAX * SYM_NAME_LEN - 1) As Byte
Dim g_expLabs(EXP_MAX - 1) As Long
Dim g_expRvas(EXP_MAX - 1) As DWord
Dim g_dllEntryLab As Long
Dim g_startupLab As Long
Dim g_dllFileName(DLL_NAME_LEN - 1) As Byte
Dim g_edataBuf As *Byte
Dim g_edataSize As Long
' 短いキーワード（Then/Else/Sub 等）。Dim x(KW_SHORT_LEN - 1)
Const KW_SHORT_LEN = 8
' 長めキーワード・短い API 名（旧 KW_LEN）。Dim x(KW_LEN - 1)
Const KW_LEN = 16
' 中程度の名前バッファ。Dim x(NAME32_LEN - 1)
Const NAME32_LEN = 32
' Class メソッドのマングル名。Dim x(MANGLED_LEN - 1)
Const MANGLED_LEN = 128
' 汎用テキスト（LEX_TEXT_LEN / AST_STR_LEN / IR_STR_LEN と同値）。Dim x(TEXT_LEN - 1)
Const TEXT_LEN = 256
' AstLower の深い式用スタックパッド（Byte）
Const LOW_STACK_PAD = 2048

' Compile target: 0=PE32+ (AMD64), 1=PE32 (i386). Host bitness is independent.
Dim g_Target32 As Long

Sub TySetTarget32(v As Long)
    g_Target32 = v
End Sub

Function TyIs32() As Long
    TyIs32 = g_Target32
End Function

Function TyPtrSize() As Long
    If g_Target32 <> 0 Then
        TyPtrSize = 4
    Else
        TyPtrSize = 8
    End If
End Function

Function TySlotAlign(sz As Long) As Long
    Dim a As Long
    a = TyPtrSize()
    If sz < a Then sz = a
    TySlotAlign = (sz + a - 1) And (0 - a)
End Function

Function AlignUp(v As DWord, a As DWord) As DWord
    ' power-of-2 align: (v+a-1) & -a
    ' AB4.20 は式全体を 16bit 演算することがあるので DWord 局所へ段階代入する。
    Dim t As DWord
    Dim mask As DWord
    t = v
    t = t + a
    t = t - 1
    mask = 0
    mask = mask - a
    AlignUp = t And mask
End Function

' AB4.20 は Const*Long を 16bit 乗算することがある (256*131072 → 0 → calloc(0) で AV)。
Function BytesN(n As Long, elem As Long) As Long
    Dim r As Long
    r = n
    r = r * elem
    BytesN = r
End Function

' Grow a heap buffer: calloc(newBytes), copy oldBytes, free old. On failure leave old intact and return NULL.
Function MemGrow(old As *Byte, oldBytes As Long, newBytes As Long) As *Byte
    Dim p As *Byte
    MemGrow = NULL
    If newBytes <= 0 Then Exit Function
    If newBytes < oldBytes Then Exit Function
    p = calloc(newBytes)
    If p = NULL Then Exit Function
    If old <> NULL And oldBytes > 0 Then
        memcpy(p, old, oldBytes)
        free(old)
    End If
    MemGrow = p
End Function

' AB4.20 は Const+DWord+DWord を 16bit 加算することがある (512+64000+40960 → 0)。
Sub AddTo(ByRef dst As Long, b As Long)
    dst = dst + b
End Sub

' AB4.20 の p[off] は off が 16bit のことがある。256 未満の索引だけ使い、ポインタを進める。
Sub PtrAddTo(p As *Byte, off As Long, ByRef dst As *Byte)
    Dim q As *Byte
    Dim n As Long
    q = p
    n = off
    If n < 0 Then
        dst = p
        Exit Sub
    End If
    While n >= 256
        q = VarPtr(q[256])
        n = n - 256
    Wend
    If n > 0 Then
        q = VarPtr(q[n])
    End If
    dst = q
End Sub

Sub ZeroMem(p As *Byte, n As Long)
    Dim i As Long
    If n <= 0 Then Exit Sub
    For i = 0 To n - 1
        p[i] = 0
    Next
End Sub

Sub PutDword(p As *Byte, off As DWord, v As DWord)
    Dim q As *Byte
    PtrAddTo(p, off, q)
    memcpy(q, VarPtr(v), 4)
End Sub

Sub PutWord(p As *Byte, off As DWord, v As Word)
    Dim q As *Byte
    PtrAddTo(p, off, q)
    memcpy(q, VarPtr(v), 2)
End Sub

Sub MemCopyAt(dst As *Byte, off As Long, src As *Byte, n As Long)
    Dim q As *Byte
    If n <= 0 Then Exit Sub
    PtrAddTo(dst, off, q)
    memcpy(q, src, n)
End Sub

Sub ZeroAt(dst As *Byte, off As Long, n As Long)
    Dim q As *Byte
    If n <= 0 Then Exit Sub
    PtrAddTo(dst, off, q)
    ZeroMem(q, n)
End Sub
