' --- split from Emiter.abp (part 2) ---
Sub EmitMovRaxR8(cb As *CodeBuffer)
    EmitByte(cb, &H4C)
    EmitByte(cb, &H89)
    EmitByte(cb, &HC0)
End Sub

' mov [rsp+disp32], rax
Sub EmitStoreRspRax(cb As *CodeBuffer, disp As Long)
    EmitByte(cb, &H48)
    EmitByte(cb, &H89)
    EmitByte(cb, &H84)
    EmitByte(cb, &H24)
    EmitDword(cb, disp)
End Sub

' mov rax, [rsp+disp32]
Sub EmitLoadRspRax(cb As *CodeBuffer, disp As Long)
    EmitByte(cb, &H48)
    EmitByte(cb, &H8B)
    EmitByte(cb, &H84)
    EmitByte(cb, &H24)
    EmitDword(cb, disp)
End Sub

' mov r9, rax
Sub EmitMovR9Rax(cb As *CodeBuffer)
    EmitByte(cb, &H49)
    EmitByte(cb, &H89)
    EmitByte(cb, &HC1)
End Sub

' mov [rbp+disp], r8
Sub EmitStoreLocalR8(cb As *CodeBuffer, disp As Long)
    EmitByte(cb, &H4C)
    EmitByte(cb, &H89)
    EmitByte(cb, &H85)
    EmitDword(cb, disp)
End Sub

' mov [rbp+disp], r9
Sub EmitStoreLocalR9(cb As *CodeBuffer, disp As Long)
    EmitByte(cb, &H4C)
    EmitByte(cb, &H89)
    EmitByte(cb, &H8D)
    EmitDword(cb, disp)
End Sub

' mov eax, edx
Sub EmitMovEaxEdx(cb As *CodeBuffer)
    EmitByte(cb, &H89)
    EmitByte(cb, &HD0)
End Sub

' xor edx, edx
Sub EmitXorEdx(cb As *CodeBuffer)
    EmitByte(cb, &H31)
    EmitByte(cb, &HD2)
End Sub

' div ecx  (unsigned; rdx:rax / ecx)
Sub EmitDivEcx(cb As *CodeBuffer)
    EmitByte(cb, &HF7)
    EmitByte(cb, &HF1)
End Sub

' xor eax, ecx
Sub EmitXorEaxEcx(cb As *CodeBuffer)
    EmitByte(cb, &H31)
    EmitByte(cb, &HC8)
End Sub

' not eax
Sub EmitNotEax(cb As *CodeBuffer)
    EmitByte(cb, &HF7)
    EmitByte(cb, &HD0)
End Sub

' shl eax, cl
Sub EmitShlEaxCl(cb As *CodeBuffer)
    EmitByte(cb, &HD3)
    EmitByte(cb, &HE0)
End Sub

' sar eax, cl（符号付き右シフト）
Sub EmitSarEaxCl(cb As *CodeBuffer)
    EmitByte(cb, &HD3)
    EmitByte(cb, &HF8)
End Sub

' imul eax, edx
Sub EmitImulEaxEdx(cb As *CodeBuffer)
    EmitByte(cb, &H0F)
    EmitByte(cb, &HAF)
    EmitByte(cb, &HC2)
End Sub

' dec ecx
Sub EmitDecEcx(cb As *CodeBuffer)
    EmitByte(cb, &HFF)
    EmitByte(cb, &HC9)
End Sub

' test ecx, ecx
Sub EmitTestEcx(cb As *CodeBuffer)
    EmitByte(cb, &H85)
    EmitByte(cb, &HC9)
End Sub

' and eax, imm32
Sub EmitAndEaxImm(cb As *CodeBuffer, imm As Long)
    EmitByte(cb, &H25)
    EmitDword(cb, imm)
End Sub

' cvtsi2ss xmm0, eax / movd eax, xmm0 ― int32 → IEEE Single bits in eax
Sub EmitCvtI32ToSs(cb As *CodeBuffer)
    EmitByte(cb, &HF3)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H2A)
    EmitByte(cb, &HC0)
    EmitByte(cb, &H66)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H7E)
    EmitByte(cb, &HC0)
End Sub

' movq xmm0, rax
Sub EmitMovqXmm0Rax(cb As *CodeBuffer)
    EmitByte(cb, &H66)
    EmitByte(cb, &H48)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H6E)
    EmitByte(cb, &HC0)
End Sub

' movq xmm0, rcx
Sub EmitMovqXmm0Rcx(cb As *CodeBuffer)
    EmitByte(cb, &H66)
    EmitByte(cb, &H48)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H6E)
    EmitByte(cb, &HC1)
End Sub

' movq xmm1, rax
Sub EmitMovqXmm1Rax(cb As *CodeBuffer)
    EmitByte(cb, &H66)
    EmitByte(cb, &H48)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H6E)
    EmitByte(cb, &HC8)
End Sub

' movq rax, xmm0
Sub EmitMovqRaxXmm0(cb As *CodeBuffer)
    EmitByte(cb, &H66)
    EmitByte(cb, &H48)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H7E)
    EmitByte(cb, &HC0)
End Sub

' movabs rax, imm64（lo, hi は IEEE Double ビット）
Sub EmitMovRaxImm64(cb As *CodeBuffer, lo As DWord, hi As DWord)
    EmitByte(cb, &H48)
    EmitByte(cb, &HB8)
    EmitDword(cb, lo)
    EmitDword(cb, hi)
End Sub

' cvtsd2ss xmm0,xmm0 / movd eax,xmm0（rax に Double → eax に Single）
Sub EmitCvtSdToSs(cb As *CodeBuffer)
    EmitMovqXmm0Rax(cb)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H5A)
    EmitByte(cb, &HC0)
    EmitByte(cb, &H66)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H7E)
    EmitByte(cb, &HC0)
End Sub

' cvtsi2sd xmm0, eax / movq rax, xmm0
Sub EmitCvtI32ToSd(cb As *CodeBuffer)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H2A)
    EmitByte(cb, &HC0)
    EmitMovqRaxXmm0(cb)
End Sub

' movd xmm0, eax / cvtss2sd xmm0, xmm0 / movq rax, xmm0
Sub EmitCvtSsToSd(cb As *CodeBuffer)
    EmitByte(cb, &H66)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H6E)
    EmitByte(cb, &HC0)
    EmitByte(cb, &HF3)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H5A)
    EmitByte(cb, &HC0)
    EmitMovqRaxXmm0(cb)
End Sub

' addsd xmm0, xmm1 / movq rax, xmm0  (rcx=left, rax=right)
Sub EmitAddSd(cb As *CodeBuffer)
    EmitMovqXmm0Rcx(cb)
    EmitMovqXmm1Rax(cb)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H58)
    EmitByte(cb, &HC1)
    EmitMovqRaxXmm0(cb)
End Sub

Sub EmitSubSd(cb As *CodeBuffer)
    EmitMovqXmm0Rcx(cb)
    EmitMovqXmm1Rax(cb)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H5C)
    EmitByte(cb, &HC1)
    EmitMovqRaxXmm0(cb)
End Sub

Sub EmitMulSd(cb As *CodeBuffer)
    EmitMovqXmm0Rcx(cb)
    EmitMovqXmm1Rax(cb)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H59)
    EmitByte(cb, &HC1)
    EmitMovqRaxXmm0(cb)
End Sub

Sub EmitDivSd(cb As *CodeBuffer)
    EmitMovqXmm0Rcx(cb)
    EmitMovqXmm1Rax(cb)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H5E)
    EmitByte(cb, &HC1)
    EmitMovqRaxXmm0(cb)
End Sub

' ucomisd xmm0, xmm1 (rcx=left, rax=right)
Sub EmitUcomisd(cb As *CodeBuffer)
    EmitMovqXmm0Rcx(cb)
    EmitMovqXmm1Rax(cb)
    EmitByte(cb, &H66)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H2E)
    EmitByte(cb, &HC1)
End Sub

' 0.0 - x  (rax → rax)
Sub EmitNegSd(cb As *CodeBuffer)
    EmitMovqXmm1Rax(cb)
    EmitByte(cb, &H31)
    EmitByte(cb, &HC0)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H2A)
    EmitByte(cb, &HC0)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H5C)
    EmitByte(cb, &HC1)
    EmitMovqRaxXmm0(cb)
End Sub

' cvttsd2si eax, xmm0 (rax in → eax out)
Sub EmitCvtSdToI32(cb As *CodeBuffer)
    EmitMovqXmm0Rax(cb)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H2C)
    EmitByte(cb, &HC0)
End Sub

' jmp rel32 - returns offset of rel32 field for patching
Function EmitJmpRel32(cb As *CodeBuffer) As Long
    EmitByte(cb, &HE9)
    EmitJmpRel32 = cb->size
    EmitDword(cb, 0)
End Function

' jcc rel32
Function EmitJccRel32(cb As *CodeBuffer, cc As Byte) As Long
    EmitByte(cb, &H0F)
    EmitByte(cb, cc)
    EmitJccRel32 = cb->size
    EmitDword(cb, 0)
End Function

Sub EmitMovRaxGs8(cb As *CodeBuffer)
    EmitByte(cb, &H65)
    EmitByte(cb, &H48)
    EmitByte(cb, &H8B)
    EmitByte(cb, &H04)
    EmitByte(cb, &H25)
    EmitDword(cb, 8)
End Sub

Sub EmitMovR8Rsp(cb As *CodeBuffer)
    EmitByte(cb, &H4C)
    EmitByte(cb, &H8B)
    EmitByte(cb, &HC4)
End Sub

Sub EmitCmpR8Rax(cb As *CodeBuffer)
    EmitByte(cb, &H4C)
    EmitByte(cb, &H3B)
    EmitByte(cb, &HC0)
End Sub

Sub EmitAddR8Imm8(cb As *CodeBuffer, imm As Byte)
    EmitByte(cb, &H49)
    EmitByte(cb, &H83)
    EmitByte(cb, &HC0)
    EmitByte(cb, imm)
End Sub
