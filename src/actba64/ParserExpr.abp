' ===================================================
'  ParserExpr - factor / expression
' ===================================================

' num/den (>0) → IEEE754 Double ビット（Long 演算のみ。AB4.20 の Double 変換を避ける）
Sub ParseEncodeNumDen(num As Long, den As Long, ByRef outLo As Long, ByRef outHi As Long)
    Dim n As Long
    Dim d As Long
    Dim exp As Long
    Dim i As Long
    Dim bit As Long
    Dim place As Long

    outLo = 0
    outHi = 0
    If num <= 0 Or den <= 0 Then Exit Sub
    n = num
    d = den
    exp = 1023
    While n < d
        If n > 1073741823 Then Exit Sub
        n = n * 2
        exp = exp - 1
    Wend
    While n / 2 >= d
        If d > 1073741823 Then Exit Sub
        d = d * 2
        exp = exp + 1
    Wend
    n = n - d
    outHi = exp * 1048576
    i = 0
    While i < 52
        n = n * 2
        bit = 0
        If n >= d Then
            n = n - d
            bit = 1
        End If
        If i < 20 Then
            place = 1
            place = place << (19 - i)
            If bit <> 0 Then outHi = outHi + place
        Else
            place = 1
            place = place << (51 - i)
            If bit <> 0 Then outLo = outLo + place
        End If
        i = i + 1
    Wend
End Sub

' 十進テキスト → IEEE Double ビット（整数のみ）
Sub ParseFloatTextToBits(text As *Byte, ByRef outLo As Long, ByRef outHi As Long)
    Dim i As Long
    Dim c As Long
    Dim dig As Long
    Dim sig As Long
    Dim nd As Long
    Dim den As Long
    Dim j As Long

    outLo = 0
    outHi = 0
    i = 0
    sig = 0
    nd = 0
    c = text[i]
    While c >= 48 And c <= 57
        dig = c - 48
        If sig <= 214748363 Then
            sig = sig * 10 + dig
        End If
        i = i + 1
        c = text[i]
    Wend
    If c = 46 Then
        i = i + 1
        c = text[i]
        While c >= 48 And c <= 57
            dig = c - 48
            If sig <= 214748363 And nd < 9 Then
                sig = sig * 10 + dig
                nd = nd + 1
            End If
            i = i + 1
            c = text[i]
        Wend
    End If
    If sig = 0 Then Exit Sub
    den = 1
    j = 0
    While j < nd
        den = den * 10
        j = j + 1
    Wend
    ParseEncodeNumDen(sig, den, outLo, outHi)
End Sub

' 十進テキスト → Double（ビット組み立て後に載せる）
Function ParseFloatTextToDouble(text As *Byte) As Double
    Dim d As Double
    Dim bits(1) As Long
    ParseFloatTextToBits(text, bits[0], bits[1])
    memcpy(VarPtr(d), VarPtr(bits), 8)
    ParseFloatTextToDouble = d
End Function

' 現在トークンの TK_FLOAT テキスト → Double ビット AST_NUM
' num=lo, left=hi（葉のため left は子インデックスではない）
Function ParseMakeFloatAst(p As *Parser, neg As Long) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim n As Long
    Dim buf(255) As Byte
    Dim lx As *Lexer
    Dim toks As *Tok
    Dim lo As Long
    Dim hi As Long

    ParseMakeFloatAst = -1
    lx = p->lx
    toks = lx->toks
    LexCopyText(lx, toks[p->pos].textOff, VarPtr(buf))
    ParseFloatTextToBits(VarPtr(buf), lo, hi)
    If neg <> 0 Then hi = hi Or &H80000000
    ast = p->ast
    n = AstAddNode(ast, AST_NUM)
    If n < 0 Then Exit Function
    nodes = ast->nodes
    nodes[n].num = lo
    nodes[n].left = hi
    nodes[n].extra = AST_NUM_EXTRA_F64
    ParseMakeFloatAst = n
End Function

Function ParseFactorNum(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim n As Long

    ParseFactorNum = -1
    ast = p->ast
    n = AstAddNode(ast, AST_NUM)
    If n < 0 Then Exit Function
    nodes = ast->nodes
    nodes[n].num = ParseTokNum(p)
    p->pos = p->pos + 1
    ParseFactorNum = n
End Function

Function ParseFactorFloat(p As *Parser) As Long
    Dim n As Long

    ParseFactorFloat = -1
    n = ParseMakeFloatAst(p, 0)
    If n < 0 Then Exit Function
    p->pos = p->pos + 1
    ParseFactorFloat = n
End Function

Function ParseFactorString(p As *Parser) As Long
    Dim ast As *Ast
    Dim n As Long
    Dim s(255) As Byte
    Dim slen As Long

    ParseFactorString = -1
    slen = ParseStringArgLen(p, VarPtr(s))
    If slen < 0 Then Exit Function
    ast = p->ast
    n = AstAddNode(ast, AST_STRING)
    If n < 0 Then Exit Function
    AstSetStrLen(ast, n, VarPtr(s), slen)
    ParseFactorString = n
End Function

Function ParseFactorParen(p As *Parser) As Long
    Dim e As Long

    ParseFactorParen = -1
    p->pos = p->pos + 1
    e = ParseExpr(p)
    If e < 0 Then Exit Function
    If ParseExpect(p, TK_RPAREN) = 0 Then Exit Function
    ParseFactorParen = e
End Function

Function ParseFactorBuiltinA(p As *Parser) As Long
    Dim k(15) As Byte
    Dim bi As Long

    ParseFactorBuiltinA = 0
    bi = 0
    lstrcpy(VarPtr(k), "len")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then bi = BI_LEN
    If bi = 0 Then
        lstrcpy(VarPtr(k), "asc")
        If ParseIdentIs(p, VarPtr(k)) <> 0 Then bi = BI_ASC
    End If
    If bi = 0 Then
        lstrcpy(VarPtr(k), "left$")
        If ParseIdentIs(p, VarPtr(k)) <> 0 Then bi = BI_LEFT
    End If
    If bi = 0 Then
        lstrcpy(VarPtr(k), "mid$")
        If ParseIdentIs(p, VarPtr(k)) <> 0 Then bi = BI_MID
    End If
    If bi = 0 Then
        lstrcpy(VarPtr(k), "varptr")
        If ParseIdentIs(p, VarPtr(k)) <> 0 Then bi = BI_VARPTR
    End If
    If bi = 0 Then
        lstrcpy(VarPtr(k), "sizeof")
        If ParseIdentIs(p, VarPtr(k)) <> 0 Then bi = BI_SIZEOF
    End If
    If bi = 0 Then
        lstrcpy(VarPtr(k), "addressof")
        If ParseIdentIs(p, VarPtr(k)) <> 0 Then bi = BI_ADDRESSOF
    End If
    If bi = 0 Then
        lstrcpy(VarPtr(k), "malloc")
        If ParseIdentIs(p, VarPtr(k)) <> 0 Then bi = BI_MALLOC
    End If
    If bi = 0 Then
        lstrcpy(VarPtr(k), "free")
        If ParseIdentIs(p, VarPtr(k)) <> 0 Then bi = BI_FREE
    End If
    If bi = 0 Then
        lstrcpy(VarPtr(k), "strptr")
        If ParseIdentIs(p, VarPtr(k)) <> 0 Then bi = BI_STRPTR
    End If
    ParseFactorBuiltinA = bi
End Function

