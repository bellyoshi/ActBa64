' ===================================================
'  ParserExpr - factor / expression
' ===================================================

Function ParseFactorNum(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim n As Long

    ParseFactorNum = -1
    ast = p->ast
    n = AstAddNode(ast, AST_NUM)
    If n < 0 Then Exit Function
    nodes = ast->nodes
    nodes[n].num = ParseTokNum(p)
    p->pos = p->pos + 1
    ParseFactorNum = n
End Function

Function ParseFactorFloat(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim n As Long

    ParseFactorFloat = -1
    ast = p->ast
    n = AstAddNode(ast, AST_NUM)
    If n < 0 Then Exit Function
    nodes = ast->nodes
    nodes[n].num = ParseTokNum(p)
    nodes[n].extra = 3
    p->pos = p->pos + 1
    ParseFactorFloat = n
End Function

Function ParseFactorString(p As *Parser) As Long
    Dim ast As *Ast
    Dim n As Long
    Dim s(255) As Byte
    Dim slen As Long

    ParseFactorString = -1
    slen = ParseStringArgLen(p, VarPtr(s))
    If slen < 0 Then Exit Function
    ast = p->ast
    n = AstAddNode(ast, AST_STRING)
    If n < 0 Then Exit Function
    AstSetStrLen(ast, n, VarPtr(s), slen)
    ParseFactorString = n
End Function

Function ParseFactorParen(p As *Parser) As Long
    Dim e As Long

    ParseFactorParen = -1
    p->pos = p->pos + 1
    e = ParseExpr(p)
    If e < 0 Then Exit Function
    If ParseExpect(p, TK_RPAREN) = 0 Then Exit Function
    ParseFactorParen = e
End Function

Function ParseFactorBuiltinA(p As *Parser) As Long
    Dim k(15) As Byte
    Dim bi As Long

    ParseFactorBuiltinA = 0
    bi = 0
    lstrcpy(VarPtr(k), "len")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then bi = BI_LEN
    If bi = 0 Then
        lstrcpy(VarPtr(k), "asc")
        If ParseIdentIs(p, VarPtr(k)) <> 0 Then bi = BI_ASC
    End If
    If bi = 0 Then
        lstrcpy(VarPtr(k), "left$")
        If ParseIdentIs(p, VarPtr(k)) <> 0 Then bi = BI_LEFT
    End If
    If bi = 0 Then
        lstrcpy(VarPtr(k), "mid$")
        If ParseIdentIs(p, VarPtr(k)) <> 0 Then bi = BI_MID
    End If
    If bi = 0 Then
        lstrcpy(VarPtr(k), "varptr")
        If ParseIdentIs(p, VarPtr(k)) <> 0 Then bi = BI_VARPTR
    End If
    If bi = 0 Then
        lstrcpy(VarPtr(k), "sizeof")
        If ParseIdentIs(p, VarPtr(k)) <> 0 Then bi = BI_SIZEOF
    End If
    If bi = 0 Then
        lstrcpy(VarPtr(k), "addressof")
        If ParseIdentIs(p, VarPtr(k)) <> 0 Then bi = BI_ADDRESSOF
    End If
    If bi = 0 Then
        lstrcpy(VarPtr(k), "malloc")
        If ParseIdentIs(p, VarPtr(k)) <> 0 Then bi = BI_MALLOC
    End If
    If bi = 0 Then
        lstrcpy(VarPtr(k), "free")
        If ParseIdentIs(p, VarPtr(k)) <> 0 Then bi = BI_FREE
    End If
    If bi = 0 Then
        lstrcpy(VarPtr(k), "strptr")
        If ParseIdentIs(p, VarPtr(k)) <> 0 Then bi = BI_STRPTR
    End If
    ParseFactorBuiltinA = bi
End Function

