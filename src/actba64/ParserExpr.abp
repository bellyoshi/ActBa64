Function ParseFactorBiMisc(p As *Parser) As Long
    Dim k(15) As Byte
    Dim bi As Long

    ParseFactorBiMisc = 0
    bi = 0
    lstrcpy(VarPtr(k), "rgb")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then bi = BIK_RGB
    If bi = 0 Then
        lstrcpy(VarPtr(k), "elm")
        If ParseIdentIs(p, VarPtr(k)) <> 0 Then bi = BI_ELM
    End If
