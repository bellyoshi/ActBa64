' ===================================================
'  ParserClass - Type / Class
' ===================================================

Function ParseTypeDefStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim types As *TypeTable
    Dim name(63) As Byte
    Dim tname(63) As Byte
    Dim ti As Long
    Dim sz As Long
    Dim sizes As *Long
    Dim nType As Long

    ParseTypeDefStmt = -1
    p->pos = p->pos + 1
    If ParseCopyIdent(p, VarPtr(name)) = 0 Then Exit Function
    If ParseExpect(p, TK_EQ) = 0 Then Exit Function
    ast = p->ast
    types = ast->types
    If ParseTokKind(p) = TK_STAR Then
        p->pos = p->pos + 1
        If ParseCopyIdent(p, VarPtr(tname)) = 0 Then Exit Function
        sz = TyPtrSize()
    Else
        If ParseCopyIdent(p, VarPtr(tname)) = 0 Then Exit Function
        sz = TySizeOfName(types, VarPtr(tname))
        If sz <= 0 Then
            p->err = 1
            Exit Function
        End If
    End If
    ti = TyAdd(types, VarPtr(name))
    If ti < 0 Then
        p->err = 1
        Exit Function
    End If
    sizes = types->typeSizes
    sizes[ti] = sz
    nType = AstAddNode(ast, AST_TYPE)
    If nType < 0 Then Exit Function
    AstSetStr(ast, nType, VarPtr(name))
    ParseTypeDefStmt = nType
End Function


' className_method → dst
Sub ParseMangleClassMember(className As *Byte, member As *Byte, dst As *Byte)
    lstrcpy(dst, className)
    lstrcat(dst, "_")
    lstrcat(dst, member)
End Sub

' クラスメソッド先頭に Me As *Class（PTR_UDT + classTi）を付ける
Function ParsePrependMeParam(p As *Parser, nFirst As Long, ByRef nParams As Long) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nMe As Long
    Dim kMe(7) As Byte

    ParsePrependMeParam = -1
    ast = p->ast
    lstrcpy(VarPtr(kMe), "Me")
    nMe = AstAddNode(ast, AST_VAR)
    If nMe < 0 Then Exit Function
    AstSetStr(ast, nMe, VarPtr(kMe))
    nodes = ast->nodes
    nodes[nMe].num = 0
    nodes[nMe].extra = TY_PTR_UDT
    nodes[nMe].right = p->classTi
    nodes[nMe].nxt = nFirst
    nParams = nParams + 1
    ParsePrependMeParam = nMe
End Function

' 空の ctor/dtor を生成
Function ParseMakeEmptyClassFunc(p As *Parser, mangled As *Byte, isSub As Long) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nFunc As Long
    Dim nMe As Long
    Dim nParams As Long

    ParseMakeEmptyClassFunc = -1
    ast = p->ast
    nParams = 0
    nMe = ParsePrependMeParam(p, -1, nParams)
    If nMe < 0 Then Exit Function
    nFunc = AstAddNode(ast, AST_FUNC)
    If nFunc < 0 Then Exit Function
    AstSetStr(ast, nFunc, mangled)
    nodes = ast->nodes
    nodes[nFunc].left = nMe
    nodes[nFunc].right = -1
    If isSub <> 0 Then
        nodes[nFunc].num = nParams Or 256
    Else
        nodes[nFunc].num = nParams
    End If
    ParseMakeEmptyClassFunc = nFunc
End Function

Function ParseSkipVirtOne(p As *Parser) As Long
    Dim pname(63) As Byte
    Dim typeName(63) As Byte
    Dim k(15) As Byte

    ParseSkipVirtOne = 0
    lstrcpy(VarPtr(k), "byref")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p->pos = p->pos + 1
    Else
        lstrcpy(VarPtr(k), "byval")
        If ParseIdentIs(p, VarPtr(k)) <> 0 Then
            p->pos = p->pos + 1
        End If
    End If
    If ParseCopyIdent(p, VarPtr(pname)) = 0 Then Exit Function
    lstrcpy(VarPtr(k), "as")
    If ParseIdentIs(p, VarPtr(k)) = 0 Then
        p->err = 1
        Exit Function
    End If
    p->pos = p->pos + 1
    While ParseTokKind(p) = TK_STAR
        p->pos = p->pos + 1
    Wend
    lstrcpy(VarPtr(k), "long")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p->pos = p->pos + 1
    Else
        lstrcpy(VarPtr(k), "string")
        If ParseIdentIs(p, VarPtr(k)) <> 0 Then
            p->pos = p->pos + 1
        Else
            lstrcpy(VarPtr(k), "byte")
            If ParseIdentIs(p, VarPtr(k)) <> 0 Then
                p->pos = p->pos + 1
            ElseIf ParseEatLongAlias(p) <> 0 Then
            Else
                If ParseCopyIdent(p, VarPtr(typeName)) = 0 Then
                    p->err = 1
                    Exit Function
                End If
            End If
        End If
    End If
    ParseSkipVirtOne = 1
End Function

' Class 内の Virtual Function/Sub 宣言（本体なし・vtable スロットのみ）
Function ParseSkipVirtParams(p As *Parser) As Long
    ParseSkipVirtParams = 0
    If ParseTokKind(p) <> TK_RPAREN Then
        Do
            If ParseSkipVirtOne(p) = 0 Then Exit Function
            If ParseTokKind(p) <> TK_COMMA Then Exit Do
            p->pos = p->pos + 1
        Loop
    End If
    If ParseExpect(p, TK_RPAREN) = 0 Then Exit Function
    ParseSkipVirtParams = 1
End Function

Function ParseClassVirtHead(p As *Parser, name As *Byte, ByRef isFun As Long) As Long
    Dim kSub(7) As Byte
    Dim kFun(15) As Byte

    ParseClassVirtHead = 0
    isFun = 0
    lstrcpy(VarPtr(kSub), "sub")
    lstrcpy(VarPtr(kFun), "function")
    If ParseIdentIs(p, VarPtr(kFun)) <> 0 Then
        isFun = 1
        p->pos = p->pos + 1
    ElseIf ParseIdentIs(p, VarPtr(kSub)) <> 0 Then
        p->pos = p->pos + 1
    Else
        p->err = 1
        Exit Function
    End If
    If ParseCopyIdent(p, name) = 0 Then Exit Function
    If ParseExpect(p, TK_LPAREN) = 0 Then Exit Function
    If ParseSkipVirtParams(p) = 0 Then Exit Function
    ParseClassVirtHead = 1
End Function

Function ParseClassVirtRet(p As *Parser, isFun As Long) As Long
    Dim typeName(63) As Byte
    Dim kAs(7) As Byte
    Dim kLong(7) As Byte
    Dim kStr(15) As Byte

    ParseClassVirtRet = 0
    lstrcpy(VarPtr(kAs), "as")
    lstrcpy(VarPtr(kLong), "long")
    lstrcpy(VarPtr(kStr), "string")
    If isFun <> 0 Then
        If ParseIdentIs(p, VarPtr(kAs)) <> 0 Then
            p->pos = p->pos + 1
            While ParseTokKind(p) = TK_STAR
                p->pos = p->pos + 1
            Wend
            If ParseIdentIs(p, VarPtr(kStr)) <> 0 Then
                p->pos = p->pos + 1
            ElseIf ParseIdentIs(p, VarPtr(kLong)) <> 0 Then
                p->pos = p->pos + 1
            ElseIf ParseEatLongAlias(p) <> 0 Then
            Else
                If ParseCopyIdent(p, VarPtr(typeName)) = 0 Then Exit Function
            End If
        End If
    End If
    ParseClassVirtRet = 1
End Function

Function ParseClassVirtDecl(p As *Parser) As Long
    Dim name(63) As Byte
    Dim isFun As Long
    Dim ast As *Ast
    Dim types As *TypeTable
    Dim slot As Long

    ParseClassVirtDecl = 0
    If ParseClassVirtHead(p, VarPtr(name), isFun) = 0 Then Exit Function
    If ParseClassVirtRet(p, isFun) = 0 Then Exit Function
    ast = p->ast
    types = ast->types
    slot = TyAddVirt(types, p->classTi, VarPtr(name))
    If slot < 0 Then
        Print "error: too many Virtual methods"
        p->err = 1
        Exit Function
    End If
    ParseClassVirtDecl = 1
End Function

Function ParseClassMethRet(p As *Parser, isFun As Long, ByRef retTy As Long) As Long
    Dim kAs(7) As Byte

    ParseClassMethRet = 0
    retTy = TY_LONG
    If isFun <> 0 Then
        lstrcpy(VarPtr(kAs), "as")
        If ParseIdentIs(p, VarPtr(kAs)) <> 0 Then
            p->pos = p->pos + 1
            If ParseFuncRetType(p, retTy) = 0 Then Exit Function
        End If
    End If
    ParseClassMethRet = 1
End Function

Function ParseClassMethBody(p As *Parser, isFun As Long, name As *Byte, mangled As *Byte, ByRef body As Long) As Long
    Dim kSub(7) As Byte
    Dim kFun(15) As Byte
    Dim saveTi As Long

    ParseClassMethBody = 0
    lstrcpy(VarPtr(kSub), "sub")
    lstrcpy(VarPtr(kFun), "function")
    saveTi = p->classTi
    g_clsMethShort[0] = 0
    g_clsMethMangled[0] = 0
    If isFun <> 0 Then
        lstrcpy(VarPtr(g_clsMethShort), name)
        lstrcpy(VarPtr(g_clsMethMangled), mangled)
        body = ParseStmtListUntilEndPair(p, VarPtr(kFun))
    Else
        body = ParseStmtListUntilEndPair(p, VarPtr(kSub))
    End If
    g_clsMethShort[0] = 0
    g_clsMethMangled[0] = 0
    p->classTi = saveTi
    If p->err <> 0 Then Exit Function
    ParseClassMethBody = 1
End Function

Function ParseClassMethEnd(p As *Parser, isFun As Long) As Long
    Dim kEnd(7) As Byte
    Dim kSub(7) As Byte
    Dim kFun(15) As Byte

    ParseClassMethEnd = 0
    lstrcpy(VarPtr(kEnd), "end")
    lstrcpy(VarPtr(kSub), "sub")
    lstrcpy(VarPtr(kFun), "function")
    If ParseIdentIs(p, VarPtr(kEnd)) = 0 Then
        p->err = 1
        Exit Function
    End If
    p->pos = p->pos + 1
    If isFun <> 0 Then
        If ParseIdentIs(p, VarPtr(kFun)) = 0 Then
            p->err = 1
            Exit Function
        End If
    Else
        If ParseIdentIs(p, VarPtr(kSub)) = 0 Then
            p->err = 1
            Exit Function
        End If
    End If
    p->pos = p->pos + 1
    ParseClassMethEnd = 1
End Function

Function ParseClassMethNode(ast As *Ast, mangled As *Byte, nFirst As Long, body As Long, isFun As Long, nParams As Long, retTy As Long) As Long
    Dim nodes As *AstNode
    Dim nFunc As Long

    ParseClassMethNode = -1
    nFunc = AstAddNode(ast, AST_FUNC)
    If nFunc < 0 Then Exit Function
    AstSetStr(ast, nFunc, mangled)
    nodes = ast->nodes
    nodes[nFunc].left = nFirst
    nodes[nFunc].right = body
    If isFun <> 0 Then
        nodes[nFunc].num = nParams
        nodes[nFunc].extra = retTy
    Else
        nodes[nFunc].num = nParams Or 256
    End If
    ParseClassMethNode = nFunc
End Function

' Class 内の Sub/Function（本体あり）
Function ParseClassMethFinish(p As *Parser, isFun As Long, name As *Byte, mangled As *Byte, nFirst As Long, nParams As Long) As Long
    Dim ast As *Ast
    Dim body As Long
    Dim retTy As Long

    ParseClassMethFinish = -1
    ast = p->ast
    If ParseClassMethRet(p, isFun, retTy) = 0 Then Exit Function
    nFirst = ParsePrependMeParam(p, nFirst, nParams)
    If nFirst < 0 Then Exit Function
    If ParseClassMethBody(p, isFun, name, mangled, body) = 0 Then Exit Function
    If ParseClassMethEnd(p, isFun) = 0 Then Exit Function
    ParseClassMethFinish = ParseClassMethNode(ast, mangled, nFirst, body, isFun, nParams, retTy)
End Function

Function ParseClassMethSig(p As *Parser, className As *Byte, name As *Byte, ByRef isFun As Long, ByRef isDtor As Long, ByRef outIsCtor As Long, ByRef outIsDtor As Long) As Long
    Dim kSub(7) As Byte
    Dim kFun(15) As Byte

    ParseClassMethSig = 0
    isFun = 0
    isDtor = 0
    outIsCtor = 0
    outIsDtor = 0
    lstrcpy(VarPtr(kSub), "sub")
    lstrcpy(VarPtr(kFun), "function")
    If ParseIdentIs(p, VarPtr(kFun)) <> 0 Then
        isFun = 1
        p->pos = p->pos + 1
    ElseIf ParseIdentIs(p, VarPtr(kSub)) <> 0 Then
        p->pos = p->pos + 1
    Else
        p->err = 1
        Exit Function
    End If
    If ParseTokKind(p) = TK_TILDE Then
        If isFun <> 0 Then
            p->err = 1
            Exit Function
        End If
        p->pos = p->pos + 1
        isDtor = 1
        outIsDtor = 1
    End If
    If ParseCopyIdent(p, name) = 0 Then Exit Function
    If isDtor = 0 Then
        If TyNameEq(name, className) <> 0 Then
            outIsCtor = 1
        End If
    End If
    ParseClassMethSig = 1
End Function

Function ParseClassMethMangle(p As *Parser, className As *Byte, name As *Byte, mangled As *Byte, isDtor As Long, outIsCtor As Long) As Long
    ParseClassMethMangle = 0
    If isDtor <> 0 Then
        If TyNameEq(name, className) = 0 Then
            p->err = 1
            Exit Function
        End If
        lstrcpy(mangled, className)
        lstrcat(mangled, "_Dtor")
    ElseIf outIsCtor <> 0 Then
        lstrcpy(mangled, className)
        lstrcat(mangled, "_Ctor")
    Else
        ParseMangleClassMember(className, name, mangled)
    End If
    ParseClassMethMangle = 1
End Function

Function ParseClassMethod(p As *Parser, className As *Byte, ByRef outIsCtor As Long, ByRef outIsDtor As Long) As Long
    Dim isFun As Long
    Dim isDtor As Long
    Dim name(63) As Byte
    Dim mangled(127) As Byte
    Dim nFirst As Long
    Dim nParams As Long

    ParseClassMethod = -1
    If ParseClassMethSig(p, className, VarPtr(name), isFun, isDtor, outIsCtor, outIsDtor) = 0 Then Exit Function
    If ParseClassMethMangle(p, className, VarPtr(name), VarPtr(mangled), isDtor, outIsCtor) = 0 Then Exit Function
    If ParseExpect(p, TK_LPAREN) = 0 Then Exit Function
    If ParseTokKind(p) <> TK_RPAREN Then
        If isDtor <> 0 Then
            p->err = 1
            Exit Function
        End If
    End If
    If ParseParamList(p, nFirst, nParams, 0, 0) = 0 Then Exit Function
    ParseClassMethod = ParseClassMethFinish(p, isFun, VarPtr(name), VarPtr(mangled), nFirst, nParams)
End Function

Function ParseClassInherits(p As *Parser, ti As Long, ByRef isIface As Long) As Long
    Dim kInh(15) As Byte
    Dim parent(63) As Byte
    Dim parentTi As Long
    Dim types As *TypeTable
    Dim ast As *Ast

    ParseClassInherits = 0
    ast = p->ast
    types = ast->types
    isIface = 0
    lstrcpy(VarPtr(kInh), "inherits")
    If ParseIdentIs(p, VarPtr(kInh)) = 0 Then
        ParseClassInherits = 1
        Exit Function
    End If
    p->pos = p->pos + 1
    If ParseCopyIdent(p, VarPtr(parent)) = 0 Then Exit Function
    parentTi = TyFind(types, VarPtr(parent))
    If parentTi < 0 Then
        Print "error: Inherits parent not found: " + MakeStr(VarPtr(parent))
        p->err = 1
        Exit Function
    End If
    If TyIsClass(types, parentTi) = 0 Then
        Print "error: Inherits parent is not a Class"
        p->err = 1
        Exit Function
    End If
    If TyCopyVirts(types, ti, parentTi) = 0 Then
        Print "error: Inherits Virtual copy failed"
        p->err = 1
        Exit Function
    End If
    isIface = 1
    ParseClassInherits = 1
End Function

Function ParseFieldTypeSize(p As *Parser, types As *TypeTable, ByRef sz As Long, ByRef fieldTy As Long) As Long
    Dim tname(63) As Byte

    ParseFieldTypeSize = 0
    fieldTy = -1
    If ParseTokKind(p) = TK_STAR Then
        p->pos = p->pos + 1
        If ParseCopyIdent(p, VarPtr(tname)) = 0 Then
            p->err = 1
            Exit Function
        End If
        sz = TyPtrSize()
        fieldTy = TyPtrFieldTag(VarPtr(tname))
    Else
        If ParseCopyIdent(p, VarPtr(tname)) = 0 Then
            p->err = 1
            Exit Function
        End If
        sz = TySizeOfName(types, VarPtr(tname))
        If sz <= 0 Then
            p->err = 1
            Exit Function
        End If
        fieldTy = TyFind(types, VarPtr(tname))
    End If
    ParseFieldTypeSize = 1
End Function

Function ParseClassField(p As *Parser, ti As Long) As Long
    Dim fname(63) As Byte
    Dim kAs(7) As Byte
    Dim count As Long
    Dim sz As Long
    Dim fieldTy As Long
    Dim types As *TypeTable
    Dim ast As *Ast

    ParseClassField = 0
    ast = p->ast
    types = ast->types
    lstrcpy(VarPtr(kAs), "as")
    If ParseCopyIdent(p, VarPtr(fname)) = 0 Then
        p->err = 1
        Exit Function
    End If
    count = 1
    If ParseTokKind(p) = TK_LPAREN Then
        p->pos = p->pos + 1
        If ParseTokKind(p) <> TK_NUMBER Then
            p->err = 1
            Exit Function
        End If
        count = ParseTokNum(p) + 1
        p->pos = p->pos + 1
        If ParseExpect(p, TK_RPAREN) = 0 Then Exit Function
    End If
    If ParseIdentIs(p, VarPtr(kAs)) = 0 Then
        p->err = 1
        Exit Function
    End If
    p->pos = p->pos + 1
    If ParseFieldTypeSize(p, types, sz, fieldTy) = 0 Then Exit Function
    If TyAddField(types, ti, VarPtr(fname), sz, count, fieldTy) = 0 Then
        p->err = 1
        Exit Function
    End If
    ParseClassField = 1
End Function

Function ParseClassEnsureCd(p As *Parser, name As *Byte, hasCtor As Long, hasDtor As Long, ByRef nPrev As Long) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim mangled(127) As Byte
    Dim nMeth As Long

    ParseClassEnsureCd = 0
    ast = p->ast
    If hasCtor = 0 Then
        lstrcpy(VarPtr(mangled), name)
        lstrcat(VarPtr(mangled), "_Ctor")
        nMeth = ParseMakeEmptyClassFunc(p, VarPtr(mangled), 1)
        If nMeth < 0 Then Exit Function
        nodes = ast->nodes
        nodes[nPrev].nxt = nMeth
        nPrev = nMeth
    End If
    If hasDtor = 0 Then
        lstrcpy(VarPtr(mangled), name)
        lstrcat(VarPtr(mangled), "_Dtor")
        nMeth = ParseMakeEmptyClassFunc(p, VarPtr(mangled), 1)
        If nMeth < 0 Then Exit Function
        nodes = ast->nodes
        nodes[nPrev].nxt = nMeth
    End If
    ParseClassEnsureCd = 1
End Function

Function ParseClassBodyItem(p As *Parser, ast As *Ast, name As *Byte, ti As Long, ByRef nPrev As Long, ByRef hasCtor As Long, ByRef hasDtor As Long, ByRef isIface As Long) As Long
    Dim nodes As *AstNode
    Dim kPriv(15) As Byte
    Dim kPub(15) As Byte
    Dim kProt(15) As Byte
    Dim kVirt(15) As Byte
    Dim kSub(7) As Byte
    Dim kFun(15) As Byte
    Dim nMeth As Long
    Dim isCtor As Long
    Dim isDtor As Long
    Dim access As Long

    ParseClassBodyItem = 0
    lstrcpy(VarPtr(kPriv), "private")
    lstrcpy(VarPtr(kPub), "public")
    lstrcpy(VarPtr(kProt), "protected")
    lstrcpy(VarPtr(kVirt), "virtual")
    lstrcpy(VarPtr(kSub), "sub")
    lstrcpy(VarPtr(kFun), "function")
    If ParseIdentIs(p, VarPtr(kPriv)) <> 0 Then
        p->pos = p->pos + 1
        access = 0
    ElseIf ParseIdentIs(p, VarPtr(kPub)) <> 0 Then
        p->pos = p->pos + 1
        access = 1
    ElseIf ParseIdentIs(p, VarPtr(kProt)) <> 0 Then
        p->pos = p->pos + 1
        access = 1
    ElseIf ParseIdentIs(p, VarPtr(kVirt)) <> 0 Then
        p->pos = p->pos + 1
        If ParseClassVirtDecl(p) = 0 Then Exit Function
        isIface = 1
    ElseIf ParseIdentIs(p, VarPtr(kSub)) <> 0 Or ParseIdentIs(p, VarPtr(kFun)) <> 0 Then
        nMeth = ParseClassMethod(p, name, isCtor, isDtor)
        If nMeth < 0 Then Exit Function
        If isCtor <> 0 Then hasCtor = 1
        If isDtor <> 0 Then hasDtor = 1
        nodes = ast->nodes
        nodes[nPrev].nxt = nMeth
        nPrev = nMeth
        While nodes[nPrev].nxt >= 0
            nPrev = nodes[nPrev].nxt
        Wend
    Else
        If ParseClassField(p, ti) = 0 Then Exit Function
    End If
    ParseClassBodyItem = 1
End Function

Function ParseClassBody(p As *Parser, name As *Byte, ti As Long, ByRef nPrev As Long, ByRef hasCtor As Long, ByRef hasDtor As Long, ByRef isIface As Long) As Long
    Dim ast As *Ast
    Dim kEnd(7) As Byte
    Dim kClass(15) As Byte

    ParseClassBody = 0
    ast = p->ast
    lstrcpy(VarPtr(kEnd), "end")
    lstrcpy(VarPtr(kClass), "class")
    Do
        If ParseIdentIs(p, VarPtr(kEnd)) <> 0 Then
            p->pos = p->pos + 1
            If ParseIdentIs(p, VarPtr(kClass)) = 0 Then
                p->err = 1
                Exit Function
            End If
            p->pos = p->pos + 1
            Exit Do
        End If
        If ParseClassBodyItem(p, ast, name, ti, nPrev, hasCtor, hasDtor, isIface) = 0 Then Exit Function
    Loop
    ParseClassBody = 1
End Function

Function ParseClassOpen(p As *Parser, name As *Byte, ByRef ti As Long, ByRef isIface As Long) As Long
    Dim ast As *Ast
    Dim types As *TypeTable

    ParseClassOpen = 0
    p->pos = p->pos + 1
    If ParseCopyIdent(p, name) = 0 Then Exit Function
    ast = p->ast
    types = ast->types
    ti = TyAdd(types, name)
    If ti < 0 Then
        p->err = 1
        Exit Function
    End If
    If TySetClass(types, ti) = 0 Then
        p->err = 1
        Exit Function
    End If
    If ParseClassInherits(p, ti, isIface) = 0 Then Exit Function
    ParseClassOpen = 1
End Function

Function ParseClassStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim types As *TypeTable
    Dim name(63) As Byte
    Dim ti As Long
    Dim nType As Long
    Dim nFirst As Long
    Dim nPrev As Long
    Dim hasCtor As Long
    Dim hasDtor As Long
    Dim isIface As Long

    ParseClassStmt = -1
    If ParseClassOpen(p, VarPtr(name), ti, isIface) = 0 Then Exit Function
    ast = p->ast
    types = ast->types
    hasCtor = 0
    hasDtor = 0
    nFirst = -1
    nPrev = -1
    p->classTi = ti

    nType = AstAddNode(ast, AST_TYPE)
    If nType < 0 Then Exit Function
    AstSetStr(ast, nType, VarPtr(name))
    nFirst = nType
    nPrev = nType
    If ParseClassBody(p, VarPtr(name), ti, nPrev, hasCtor, hasDtor, isIface) = 0 Then Exit Function

    ' COM インターフェース（Virtual のみ）は空 ctor/dtor を付けない
    If isIface = 0 Then
        If ParseClassEnsureCd(p, VarPtr(name), hasCtor, hasDtor, nPrev) = 0 Then Exit Function
    End If

    TyFinalizeType(types, ti)
    p->classTi = -1
    ParseClassStmt = nFirst
End Function

Function ParseTypeAlign(p As *Parser, types As *TypeTable, ti As Long) As Long
    Dim kAlign(15) As Byte
    Dim alignN As Long

    ParseTypeAlign = 0
    lstrcpy(VarPtr(kAlign), "align")
    If ParseIdentIs(p, VarPtr(kAlign)) <> 0 Then
        p->pos = p->pos + 1
        If ParseExpect(p, TK_LPAREN) = 0 Then Exit Function
        If ParseTokKind(p) <> TK_NUMBER Then
            p->err = 1
            Exit Function
        End If
        alignN = ParseTokNum(p)
        p->pos = p->pos + 1
        If ParseExpect(p, TK_RPAREN) = 0 Then Exit Function
        If TySetExplicitAlign(types, ti, alignN) = 0 Then
            p->err = 1
            Exit Function
        End If
    End If
    ParseTypeAlign = 1
End Function

Function ParseTypeStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim types As *TypeTable
    Dim name(63) As Byte
    Dim kEnd(7) As Byte
    Dim kType(7) As Byte
    Dim ti As Long
    Dim nType As Long

    ParseTypeStmt = -1
    p->pos = p->pos + 1
    If ParseCopyIdent(p, VarPtr(name)) = 0 Then Exit Function
    ast = p->ast
    types = ast->types
    ti = TyAdd(types, VarPtr(name))
    If ti < 0 Then
        p->err = 1
        Exit Function
    End If
    If ParseTypeAlign(p, types, ti) = 0 Then Exit Function
    lstrcpy(VarPtr(kEnd), "end")
    lstrcpy(VarPtr(kType), "type")
    Do
        If ParseIdentIs(p, VarPtr(kEnd)) <> 0 Then
            p->pos = p->pos + 1
            If ParseIdentIs(p, VarPtr(kType)) = 0 Then
                p->err = 1
                Exit Function
            End If
            p->pos = p->pos + 1
            Exit Do
        End If
        If ParseClassField(p, ti) = 0 Then Exit Function
    Loop
    TyFinalizeType(types, ti)
    nType = AstAddNode(ast, AST_TYPE)
    If nType < 0 Then Exit Function
    AstSetStr(ast, nType, VarPtr(name))
    ParseTypeStmt = nType
End Function

Function ParseEnumMem(p As *Parser, ast As *Ast, ByRef nFirst As Long, ByRef nPrev As Long) As Long
    Dim nodes As *AstNode
    Dim mname(63) As Byte
    Dim nMem As Long
    Dim e As Long

    ParseEnumMem = 0
    If ParseCopyIdent(p, VarPtr(mname)) = 0 Then
        p->err = 1
        Exit Function
    End If
    e = -1
    If ParseTokKind(p) = TK_EQ Then
        p->pos = p->pos + 1
        e = ParseExpr(p)
        If e < 0 Or p->err <> 0 Then Exit Function
    End If
    nMem = AstAddNode(ast, AST_ENUMMEM)
    If nMem < 0 Then Exit Function
    AstSetStr(ast, nMem, VarPtr(mname))
    nodes = ast->nodes
    nodes[nMem].left = e
    nodes[nMem].right = -1
    nodes[nMem].nxt = -1
    If nFirst < 0 Then
        nFirst = nMem
    Else
        nodes[nPrev].nxt = nMem
    End If
    nPrev = nMem
    ParseEnumMem = 1
End Function

Function ParseEnumStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim types As *TypeTable
    Dim nodes As *AstNode
    Dim name(63) As Byte
    Dim kEnd(7) As Byte
    Dim kEnum(7) As Byte
    Dim ti As Long
    Dim sizes As *Long
    Dim nEnum As Long
    Dim nFirst As Long
    Dim nPrev As Long

    ParseEnumStmt = -1
    p->pos = p->pos + 1
    If ParseCopyIdent(p, VarPtr(name)) = 0 Then Exit Function
    ast = p->ast
    types = ast->types
    ti = TyAdd(types, VarPtr(name))
    If ti < 0 Then
        p->err = 1
        Exit Function
    End If
    sizes = types->typeSizes
    sizes[ti] = 4
    TyFinalizeType(types, ti)
    lstrcpy(VarPtr(kEnd), "end")
    lstrcpy(VarPtr(kEnum), "enum")
    nFirst = -1
    nPrev = -1
    Do
        If ParseIdentIs(p, VarPtr(kEnd)) <> 0 Then
            p->pos = p->pos + 1
            If ParseIdentIs(p, VarPtr(kEnum)) = 0 Then
                p->err = 1
                Exit Function
            End If
            p->pos = p->pos + 1
            Exit Do
        End If
        If ParseEnumMem(p, ast, nFirst, nPrev) = 0 Then Exit Function
    Loop
    nEnum = AstAddNode(ast, AST_ENUM)
    If nEnum < 0 Then Exit Function
    AstSetStr(ast, nEnum, VarPtr(name))
    nodes = ast->nodes
    nodes[nEnum].left = nFirst
    nodes[nEnum].num = ti
    ParseEnumStmt = nEnum
End Function

