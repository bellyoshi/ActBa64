#console
Sub S4(a As *Byte, b As *Byte, c As *Long, d As *Long)
    a[0] = 1
End Sub

Sub S2(a As *Byte, b As *Byte)
    a[0] = 1
End Sub

Sub S3(a As *Byte, b As *Byte, c As *Long)
    a[0] = 1
End Sub

Dim x(15) As Byte
Dim y(15) As Long
S2(VarPtr(x), VarPtr(x))
S3(VarPtr(x), VarPtr(x), VarPtr(y))
S4(VarPtr(x), VarPtr(x), VarPtr(y), VarPtr(y))
ExitProcess(0)
