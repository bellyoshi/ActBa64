' UDT passed to a Declare'd API (expect 3)
#console
Type SYSTIME4
    a As Long
    b As Long
    c As Long
    d As Long
End Type

Declare Sub MyGetLocalTime Lib "kernel32" Alias "GetLocalTime" (t As SYSTIME4)

Dim st As SYSTIME4
Dim y As Long
Dim n As Long

n = 0
st.a = 0
MyGetLocalTime(st)
y = LOWORD(st.a)
If y >= 2020 Then
    n = n + 1
End If
If y <= 2200 Then
    n = n + 2
End If
ExitProcess(n)
