' runtime Chr$ / Right$ edge cases + user32 Declare
#console
Declare Function MyMbLen Lib "user32" Alias "CharUpperBuffA" (s As *Byte, n As Long) As Long

Dim s As String
Dim t As String
Dim c As Long
Dim n As Long
Dim r As Long

n = 0
c = 66
s = Chr$(c)
If Len(s) = 1 Then
    n = n + 1
End If
If Asc(s) = 66 Then
    n = n + 2
End If
t = "x" + Chr$(c) + "y"
If Len(t) = 3 Then
    n = n + 4
End If
' Right$ with n greater than the string length
s = Right$("ab", 5)
If Len(s) = 2 Then
    n = n + 8
End If
' Right$ with a variable count
c = 2
s = Right$("abcdef", c)
If Len(s) = 2 Then
    n = n + 16
End If
If Asc(s) = 101 Then
    n = n + 32
End If
r = MyMbLen("ab", 2)
If r = 2 Then
    n = n + 64
End If
ExitProcess(n)
