    lstrcpy(VarPtr(k), "lresult")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p.pos = p.pos + 1
        ParseEatLongAlias = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "long_ptr")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p.pos = p.pos + 1
        ParseEatLongAlias = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "ulong_ptr")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p.pos = p.pos + 1
        ParseEatLongAlias = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "lpstr")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p.pos = p.pos + 1
        ParseEatLongAlias = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "lpcstr")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p.pos = p.pos + 1
        ParseEatLongAlias = 1
        Exit Function
