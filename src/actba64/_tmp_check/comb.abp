        Exit Function
    End If
    lstrcpy(VarPtr(k), "getfileattributesa")
    If LowNameEq(name, VarPtr(k)) <> 0 Then
        lstrcpy(apiOut, "GetFileAttributesA")
        LowMapKernelApi = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "getcommandline")
    If LowNameEq(name, VarPtr(k)) <> 0 Then
        lstrcpy(apiOut, "GetCommandLineA")
        LowMapKernelApi = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "getcommandlinea")
    If LowNameEq(name, VarPtr(k)) <> 0 Then
        lstrcpy(apiOut, "GetCommandLineA")
        LowMapKernelApi = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "lstrlen")
    If LowNameEq(name, VarPtr(k)) <> 0 Then
        lstrcpy(apiOut, "lstrlenA")
        LowMapKernelApi = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "lstrlena")
    If LowNameEq(name, VarPtr(k)) <> 0 Then
        lstrcpy(apiOut, "lstrlenA")
        LowMapKernelApi = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "lstrcpy")
    If LowNameEq(name, VarPtr(k)) <> 0 Then
        lstrcpy(apiOut, "lstrcpyA")
        LowMapKernelApi = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "lstrcpya")
    If LowNameEq(name, VarPtr(k)) <> 0 Then
        lstrcpy(apiOut, "lstrcpyA")
        LowMapKernelApi = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "lstrcat")
    If LowNameEq(name, VarPtr(k)) <> 0 Then
        lstrcpy(apiOut, "lstrcatA")
        LowMapKernelApi = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "lstrcata")
    If LowNameEq(name, VarPtr(k)) <> 0 Then
        lstrcpy(apiOut, "lstrcatA")
        LowMapKernelApi = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "getprocessheap")
    If LowNameEq(name, VarPtr(k)) <> 0 Then
        lstrcpy(apiOut, "GetProcessHeap")
        LowMapKernelApi = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "heapalloc")
    If LowNameEq(name, VarPtr(k)) <> 0 Then
        lstrcpy(apiOut, "HeapAlloc")
