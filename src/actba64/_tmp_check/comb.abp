Sub EmitLeaRaxRip(cb As *CodeBuffer, targetRva As DWord, textBaseRva As DWord)
    Dim nextRip As DWord
    EmitByte(cb, &H48)
    EmitByte(cb, &H8D)
    EmitByte(cb, &H05)
    nextRip = textBaseRva + cb.size + 4
    EmitDword(cb, targetRva - nextRip)
End Sub

Sub EmitMovRcxRax(cb As *CodeBuffer)
    EmitByte(cb, &H48)
    EmitByte(cb, &H89)
    EmitByte(cb, &HC1)
End Sub

Sub EmitMovRdxRax(cb As *CodeBuffer)
