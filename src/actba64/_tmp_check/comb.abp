    EmitByte(cb, &HC1)
End Sub

' test eax, eax
Sub EmitTestEax(cb As *CodeBuffer)
    EmitByte(cb, &H85)
    EmitByte(cb, &HC0)
End Sub

' add dword [rbp+disp], 1
Sub EmitIncLocal(cb As *CodeBuffer, disp As Long)
    EmitByte(cb, &HFF)
    EmitByte(cb, &H85)
