End Function

' ---- IR.abp ----
' ===================================================
'  IR - intermediate representation
' ===================================================

Const OP_NOP = 0
Const OP_ENTER = 1
Const OP_LEAVE = 2
Const OP_XOR_ECX = 3
Const OP_XOR_R9D = 4
Const OP_LEA_RDX_STR = 5
Const OP_LEA_R8_STR = 6
Const OP_CALL_API = 7
Const OP_RET = 8
Const OP_MOV_ECX = 9
Const OP_MOV_EAX_IMM = 10
Const OP_LOAD_LOCAL = 11
Const OP_STORE_LOCAL = 12
Const OP_PUSH_RAX = 13
Const OP_POP_RCX = 14
Const OP_ADD_EAX_ECX = 15
Const OP_IMUL_EAX_ECX = 16
Const OP_MOV_ECX_EAX = 17
Const OP_CMP_ECX_EAX = 18
Const OP_TEST_EAX = 19
Const OP_LABEL = 20
Const OP_JMP = 21
Const OP_JZ = 22
Const OP_JNZ = 23
Const OP_JE = 24
Const OP_JNE = 25
Const OP_JL = 26
Const OP_JLE = 27
Const OP_JG = 28
Const OP_JGE = 29
Const OP_INC_LOCAL = 30
Const OP_MOV_EDX_IMM = 31
Const OP_CALL_LAB = 32
Const OP_STORE_LOCAL_ECX = 33
Const OP_STORE_LOCAL_EDX = 34
Const OP_MOV_EDX_EAX = 35
Const OP_LEA_RAX_STR = 36
Const OP_MOV_RCX_RAX = 37
Const OP_MOV_RDX_RAX = 38
Const OP_MOV_R8_RAX = 39
Const OP_MOVZX_EAX_BYTE = 40
Const OP_TEST_RAX = 41
Const OP_RT_CAT = 42
Const OP_RT_LEFT = 43
Const OP_RT_MID = 44
Const OP_XOR_EAX = 45
Const OP_LEA_LOCAL = 46
Const OP_ADD_RAX_RCX = 47
Const OP_LOADZX_BYTE_RAX = 48
Const OP_STORE_BYTE_RAX_CL = 49
Const OP_POP_RDX = 50
Const OP_XCHG_RAX_RCX = 51
Const OP_ADD_RAX_IMM = 52
Const OP_LOADZX_WORD_RAX = 53
Const OP_STORE_WORD_RAX_CX = 54
Const OP_LOAD_DWORD_RAX = 55
Const OP_STORE_DWORD_RAX_ECX = 56
Const OP_LOAD_QWORD_RAX = 57
Const OP_STORE_QWORD_RAX_RCX = 58
Const OP_AND_EAX_ECX = 59
Const OP_OR_EAX_ECX = 60
Const OP_NEG_EAX = 61
Const OP_SUB_EAX_ECX = 62
Const OP_LEA_RAX_LAB = 63
Const OP_SHL_ECX_3 = 64
Const OP_POP_RAX = 65
Const OP_POP_R8 = 66
Const OP_MOV_RAX_R8 = 67
Const OP_SUB_RSP = 68
Const OP_ADD_RSP = 69
Const OP_STORE_RSP_RAX = 70
Const OP_MOV_R9_RAX = 71
Const OP_STORE_LOCAL_R8 = 72
Const OP_STORE_LOCAL_R9 = 73
Const OP_XOR_EDX = 74
Const OP_DIV_ECX = 75
Const OP_MOV_EAX_EDX = 76

Const IR_DLL_USER32 = 1
Const IR_DLL_KERNEL32 = 2
Const IR_DLL_GDI32 = 3
Const IR_DLL_IMM32 = 4
Const IR_DLL_COMDLG32 = 5
Const IR_DLL_SHELL32 = 6

Const IR_MAX_OPS = 262144
Const IR_STR_LEN = 256
Const IR_MAX_FIXUPS = 32768
Const IR_MAX_LABELS = 32768

Type IrOp
    op As Long
    arg1 As DWord
    arg2 As DWord
    strId As Long
End Type

Type IrList
    ops As *IrOp
    strs As *Byte
    count As Long
    capacity As Long
    frameSize As Long
End Type

Function IrCreate(capacity As Long) As *IrList
    Dim list As *IrList
    IrCreate = NULL
    list = calloc(SizeOf(IrList))
    If list = NULL Then Exit Function
    list.ops = calloc(SizeOf(IrOp) * capacity)
    list.strs = calloc(IR_STR_LEN * capacity)
    If list.ops = NULL Or list.strs = NULL Then
        If list.ops <> NULL Then free(list.ops)
        If list.strs <> NULL Then free(list.strs)
        free(list)
        Exit Function
    End If
    list.count = 0
    list.capacity = capacity
    list.frameSize = &H28
    IrCreate = list
End Function

Sub IrFree(list As *IrList)
    If list = NULL Then Exit Sub
    If list.ops <> NULL Then free(list.ops)
    If list.strs <> NULL Then free(list.strs)
    free(list)
End Sub

Sub IrSetStrAt(list As *IrList, idx As Long, s As *Byte)
    Dim i As Long
    Dim off As Long
    Dim strs As *Byte
    strs = list.strs
    off = idx * IR_STR_LEN
    i = 0
    While s[i] <> 0 And i < IR_STR_LEN - 1
        strs[off + i] = s[i]
        i = i + 1
    Wend
    strs[off + i] = 0
End Sub

Sub IrCopyStrAt(list As *IrList, idx As Long, dst As *Byte)
    Dim i As Long
    Dim off As Long
    Dim strs As *Byte
    strs = list.strs
    off = idx * IR_STR_LEN
    i = 0
    Do
        dst[i] = strs[off + i]
        If strs[off + i] = 0 Then Exit Sub
        i = i + 1
        If i >= IR_STR_LEN Then
            dst[IR_STR_LEN - 1] = 0
            Exit Sub
        End If
    Loop
End Sub

Function IrEmit(list As *IrList, op As Long, arg1 As DWord, arg2 As DWord) As Long
    Dim ops As *IrOp
    Dim i As Long
    Dim strs As *Byte
    IrEmit = -1
    If list.count >= list.capacity Then Exit Function
    ops = list.ops
    strs = list.strs
    i = list.count
    ops[i].op = op
    ops[i].arg1 = arg1
    ops[i].arg2 = arg2
    ops[i].strId = -1
    strs[i * IR_STR_LEN] = 0
    IrEmit = i
    list.count = i + 1
End Function

Function IrEmitStr(list As *IrList, op As Long, arg1 As DWord, s As *Byte) As Long
    Dim idx As Long
    idx = IrEmit(list, op, arg1, 0)
    If idx < 0 Then
        IrEmitStr = -1
        Exit Function
    End If
    IrSetStrAt(list, idx, s)
    IrEmitStr = idx
End Function

' ---- CodeGen.abp ----
' ===================================================
'  CodeGen - IR -> machine code
' ===================================================

Type IrFixup
    at As Long
    lab As Long
End Type

Function IrDllNameOf(dllKind As DWord, dst As *Byte) As Long
    IrDllNameOf = 0
    If dllKind = IR_DLL_USER32 Then
        lstrcpy(dst, "user32.dll")
        IrDllNameOf = 1
    ElseIf dllKind = IR_DLL_KERNEL32 Then
        lstrcpy(dst, "kernel32.dll")
        IrDllNameOf = 1
    ElseIf dllKind = IR_DLL_GDI32 Then
        lstrcpy(dst, "gdi32.dll")
        IrDllNameOf = 1
    ElseIf dllKind = IR_DLL_IMM32 Then
        lstrcpy(dst, "imm32.dll")
        IrDllNameOf = 1
    ElseIf dllKind = IR_DLL_COMDLG32 Then
        lstrcpy(dst, "comdlg32.dll")
        IrDllNameOf = 1
    ElseIf dllKind = IR_DLL_SHELL32 Then
        lstrcpy(dst, "shell32.dll")
        IrDllNameOf = 1
    End If
End Function

Sub IrCollect(list As *IrList, builder As *ImportBuilder)
    Dim i As Long
    Dim n As Long
    Dim opv As Long
    Dim ops As *IrOp
    Dim tmp(255) As Byte
    Dim dll(31) As Byte
    Dim sid As Long

    ops = list.ops
    n = list.count
    For i = 0 To n - 1
        opv = ops[i].op
        If opv = OP_CALL_API Then
            If IrDllNameOf(ops[i].arg1, VarPtr(dll)) <> 0 Then
                IrCopyStrAt(list, i, VarPtr(tmp))
                IbAddImport(builder, VarPtr(dll), VarPtr(tmp))
            End If
        ElseIf opv = OP_LEA_RDX_STR Or opv = OP_LEA_R8_STR Or opv = OP_LEA_RAX_STR Then
            IrCopyStrAt(list, i, VarPtr(tmp))
            sid = IbAddString(builder, VarPtr(tmp))
            ops[i].strId = sid
        End If
    Next
End Sub

Sub IrEmitCode(list As *IrList, cb As *CodeBuffer, builder As *ImportBuilder)
    Dim i As Long
    Dim n As Long
    Dim opv As Long
    Dim ops As *IrOp
    Dim tmp(255) As Byte
    Dim dll(31) As Byte
    Dim iatRva As DWord
    Dim strRva As DWord
    Dim labOff As *Long
    Dim fixups As *IrFixup
    Dim nFix As Long
    Dim li As Long
    Dim at As Long
    Dim rel As Long
    Dim nextRip As Long

    labOff = calloc(SizeOf(Long) * IR_MAX_LABELS)
    fixups = calloc(SizeOf(IrFixup) * IR_MAX_FIXUPS)
    If labOff = NULL Or fixups = NULL Then
        If labOff <> NULL Then free(labOff)
        If fixups <> NULL Then free(fixups)
        Exit Sub
    End If

    ops = list.ops
    n = list.count
    nFix = 0
    For i = 0 To IR_MAX_LABELS - 1
        labOff[i] = -1
    Next

    For i = 0 To n - 1
        opv = ops[i].op
        If opv = OP_ENTER Then
            EmitEnter(cb, ops[i].arg1)
        ElseIf opv = OP_LEAVE Then
            EmitLeaveRet(cb)
        ElseIf opv = OP_XOR_ECX Then
            EmitXorEcx(cb)
        ElseIf opv = OP_XOR_R9D Then
            EmitXorR9d(cb)
        ElseIf opv = OP_LEA_RDX_STR Then
            strRva = IbGetStringRva(builder, ops[i].strId)
            EmitLeaRdxRip(cb, strRva, TEXT_RVA)
        ElseIf opv = OP_LEA_R8_STR Then
            strRva = IbGetStringRva(builder, ops[i].strId)
            EmitLeaR8Rip(cb, strRva, TEXT_RVA)
        ElseIf opv = OP_LEA_RAX_STR Then
            strRva = IbGetStringRva(builder, ops[i].strId)
            EmitLeaRaxRip(cb, strRva, TEXT_RVA)
        ElseIf opv = OP_MOV_RCX_RAX Then
            EmitMovRcxRax(cb)
        ElseIf opv = OP_MOV_RDX_RAX Then
            EmitMovRdxRax(cb)
        ElseIf opv = OP_MOV_R8_RAX Then
            EmitMovR8Rax(cb)
        ElseIf opv = OP_MOVZX_EAX_BYTE Then
            EmitMovzxEaxByteRax(cb)
        ElseIf opv = OP_TEST_RAX Then
            EmitTestRax(cb)
        ElseIf opv = OP_XOR_EAX Then
            EmitXorEax(cb)
        ElseIf opv = OP_LEA_LOCAL Then
            EmitLeaLocal(cb, ops[i].arg1)
        ElseIf opv = OP_ADD_RAX_RCX Then
            EmitAddRaxRcx(cb)
        ElseIf opv = OP_LOADZX_BYTE_RAX Then
            EmitLoadzxByteRax(cb)
        ElseIf opv = OP_STORE_BYTE_RAX_CL Then
            EmitStoreByteRaxCl(cb)
        ElseIf opv = OP_ADD_RAX_IMM Then
            EmitAddRaxImm(cb, ops[i].arg1)
        ElseIf opv = OP_LOADZX_WORD_RAX Then
            EmitLoadzxWordRax(cb)
        ElseIf opv = OP_STORE_WORD_RAX_CX Then
            EmitStoreWordRaxCx(cb)
        ElseIf opv = OP_LOAD_DWORD_RAX Then
            EmitLoadDwordRax(cb)
        ElseIf opv = OP_STORE_DWORD_RAX_ECX Then
            EmitStoreDwordRaxEcx(cb)
        ElseIf opv = OP_LOAD_QWORD_RAX Then
            EmitLoadQwordRax(cb)
        ElseIf opv = OP_STORE_QWORD_RAX_RCX Then
            EmitStoreQwordRaxRcx(cb)
        ElseIf opv = OP_AND_EAX_ECX Then
            EmitAndEaxEcx(cb)
        ElseIf opv = OP_OR_EAX_ECX Then
            EmitOrEaxEcx(cb)
        ElseIf opv = OP_NEG_EAX Then
            EmitNegEax(cb)
        ElseIf opv = OP_SUB_EAX_ECX Then
            EmitSubEaxEcx(cb)
        ElseIf opv = OP_POP_RDX Then
            EmitPopRdx(cb)
        ElseIf opv = OP_XCHG_RAX_RCX Then
            EmitXchgRaxRcx(cb)
        ElseIf opv = OP_MOV_ECX Then
            EmitMovEcxImm(cb, ops[i].arg1)
        ElseIf opv = OP_MOV_EAX_IMM Then
            EmitMovEaxImm(cb, ops[i].arg1)
        ElseIf opv = OP_LOAD_LOCAL Then
            EmitLoadLocal(cb, ops[i].arg1)
        ElseIf opv = OP_STORE_LOCAL Then
            EmitStoreLocal(cb, ops[i].arg1)
        ElseIf opv = OP_PUSH_RAX Then
            EmitPushRax(cb)
        ElseIf opv = OP_POP_RCX Then
            EmitPopRcx(cb)
        ElseIf opv = OP_ADD_EAX_ECX Then
            EmitAddEaxEcx(cb)
        ElseIf opv = OP_IMUL_EAX_ECX Then
            EmitImulEaxEcx(cb)
        ElseIf opv = OP_MOV_ECX_EAX Then
            EmitMovEcxEax(cb)
        ElseIf opv = OP_CMP_ECX_EAX Then
            EmitCmpEcxEax(cb)
        ElseIf opv = OP_TEST_EAX Then
            EmitTestEax(cb)
        ElseIf opv = OP_INC_LOCAL Then
            EmitIncLocal(cb, ops[i].arg1)
        ElseIf opv = OP_STORE_LOCAL_ECX Then
            EmitStoreLocalEcx(cb, ops[i].arg1)
        ElseIf opv = OP_STORE_LOCAL_EDX Then
            EmitStoreLocalEdx(cb, ops[i].arg1)
        ElseIf opv = OP_MOV_EDX_IMM Then
            EmitMovEdxImm(cb, ops[i].arg1)
        ElseIf opv = OP_MOV_EDX_EAX Then
            EmitMovEdxEax(cb)
        ElseIf opv = OP_CALL_LAB Then
            at = EmitCallRel32(cb)
            If nFix < IR_MAX_FIXUPS Then
                fixups[nFix].at = at
                fixups[nFix].lab = ops[i].arg1
                nFix = nFix + 1
            End If
        ElseIf opv = OP_LEA_RAX_LAB Then
            at = EmitLeaRaxLabRel32(cb)
            If nFix < IR_MAX_FIXUPS Then
                fixups[nFix].at = at
                fixups[nFix].lab = ops[i].arg1
                nFix = nFix + 1
            End If
        ElseIf opv = OP_SHL_ECX_3 Then
            EmitShlEcx3(cb)
        ElseIf opv = OP_POP_RAX Then
            EmitPopRax(cb)
        ElseIf opv = OP_POP_R8 Then
            EmitPopR8(cb)
        ElseIf opv = OP_MOV_RAX_R8 Then
            EmitMovRaxR8(cb)
        ElseIf opv = OP_SUB_RSP Then
            EmitSubRsp(cb, ops[i].arg1)
        ElseIf opv = OP_ADD_RSP Then
            EmitAddRsp(cb, ops[i].arg1)
        ElseIf opv = OP_STORE_RSP_RAX Then
            EmitStoreRspRax(cb, ops[i].arg1)
        ElseIf opv = OP_MOV_R9_RAX Then
            EmitMovR9Rax(cb)
        ElseIf opv = OP_STORE_LOCAL_R8 Then
            EmitStoreLocalR8(cb, ops[i].arg1)
        ElseIf opv = OP_STORE_LOCAL_R9 Then
            EmitStoreLocalR9(cb, ops[i].arg1)
        ElseIf opv = OP_XOR_EDX Then
            EmitXorEdx(cb)
        ElseIf opv = OP_DIV_ECX Then
            EmitDivEcx(cb)
        ElseIf opv = OP_MOV_EAX_EDX Then
            EmitMovEaxEdx(cb)
        ElseIf opv = OP_LABEL Then
            li = ops[i].arg1
            If li >= 0 And li < IR_MAX_LABELS Then
                labOff[li] = cb.size
            End If
        ElseIf opv = OP_JMP Then
            at = EmitJmpRel32(cb)
            If nFix < IR_MAX_FIXUPS Then
                fixups[nFix].at = at
                fixups[nFix].lab = ops[i].arg1
                nFix = nFix + 1
            End If
        ElseIf opv = OP_JZ Or opv = OP_JE Then
            at = EmitJccRel32(cb, &H84)
            If nFix < IR_MAX_FIXUPS Then
                fixups[nFix].at = at
                fixups[nFix].lab = ops[i].arg1
                nFix = nFix + 1
            End If
        ElseIf opv = OP_JNZ Or opv = OP_JNE Then
            at = EmitJccRel32(cb, &H85)
            If nFix < IR_MAX_FIXUPS Then
                fixups[nFix].at = at
                fixups[nFix].lab = ops[i].arg1
                nFix = nFix + 1
            End If
        ElseIf opv = OP_JL Then
            at = EmitJccRel32(cb, &H8C)
            If nFix < IR_MAX_FIXUPS Then
                fixups[nFix].at = at
                fixups[nFix].lab = ops[i].arg1
                nFix = nFix + 1
            End If
        ElseIf opv = OP_JLE Then
            at = EmitJccRel32(cb, &H8E)
            If nFix < IR_MAX_FIXUPS Then
                fixups[nFix].at = at
                fixups[nFix].lab = ops[i].arg1
                nFix = nFix + 1
            End If
        ElseIf opv = OP_JG Then
            at = EmitJccRel32(cb, &H8F)
            If nFix < IR_MAX_FIXUPS Then
                fixups[nFix].at = at
                fixups[nFix].lab = ops[i].arg1
                nFix = nFix + 1
            End If
        ElseIf opv = OP_JGE Then
            at = EmitJccRel32(cb, &H8D)
            If nFix < IR_MAX_FIXUPS Then
                fixups[nFix].at = at
                fixups[nFix].lab = ops[i].arg1
                nFix = nFix + 1
            End If
        ElseIf opv = OP_CALL_API Then
            IrDllNameOf(ops[i].arg1, VarPtr(dll))
            IrCopyStrAt(list, i, VarPtr(tmp))
            iatRva = IbGetIatRva(builder, VarPtr(dll), VarPtr(tmp))
            EmitCallRip(cb, iatRva, TEXT_RVA)
        ElseIf opv = OP_RET Then
            EmitRet(cb)
        End If
    Next

    For i = 0 To nFix - 1
        li = fixups[i].lab
        at = fixups[i].at
        If li >= 0 And li < IR_MAX_LABELS Then
            If labOff[li] >= 0 Then
                nextRip = at + 4
                rel = labOff[li] - nextRip
                PutDword(VarPtr(cb.buf[at]), 0, rel)
            End If
        End If
    Next
    free(labOff)
    free(fixups)
End Sub

' ---- PeWriter.abp ----
' ===================================================
'  PeWriter - pack .text + .idata into PE32+ GUI EXE
' ===================================================

Function WritePe64(outPath As *Byte, codeBuf As *Byte, codeSize As Long, idataBuf As *Byte, idataSize As DWord, builder As *ImportBuilder, subsystem As Long) As Long
    Dim outBuf As *Byte
    Dim outSize As Long
    Dim textRaw As DWord
    Dim textVirt As DWord
    Dim idataRaw As DWord
    Dim idataVirt As DWord
    Dim sizeImage As DWord
    Dim optOff As DWord
    Dim sectOff As DWord
    Dim idOff As DWord

    WritePe64 = 0

    textVirt = AlignUp(codeSize, SECTION_ALIGN)
    textRaw = AlignUp(codeSize, FILE_ALIGN)
    idataVirt = AlignUp(idataSize, SECTION_ALIGN)
    If idataVirt < SECTION_ALIGN Then idataVirt = SECTION_ALIGN
    idataRaw = AlignUp(idataSize, FILE_ALIGN)
    If idataRaw < FILE_ALIGN Then idataRaw = FILE_ALIGN

    sizeImage = TEXT_RVA + textVirt + idataVirt
    outSize = SIZEOF_HEADERS + textRaw + idataRaw

    outBuf = calloc(outSize)
    If outBuf = NULL Then Exit Function

    ZeroMem(outBuf, SIZEOF_HEADERS)
    PutWord(outBuf, 0, IMAGE_DOS_SIGNATURE)
    PutDword(outBuf, 60, E_LFANEW)
    WriteDosStub(outBuf)

    PutDword(outBuf, E_LFANEW, IMAGE_NT_SIGNATURE)
    PutWord(outBuf, E_LFANEW + 4, IMAGE_FILE_MACHINE_AMD64)
    PutWord(outBuf, E_LFANEW + 6, 2)
    PutWord(outBuf, E_LFANEW + 20, SIZEOF_OPTIONAL_HEADER64)
    PutWord(outBuf, E_LFANEW + 22, IMAGE_FILE_EXECUTABLE_IMAGE Or IMAGE_FILE_LARGE_ADDRESS_AWARE)

    optOff = E_LFANEW + 24
    PutWord(outBuf, optOff + 0, IMAGE_NT_OPTIONAL_HDR64_MAGIC)
    PutDword(outBuf, optOff + 4, textRaw)
    PutDword(outBuf, optOff + 16, TEXT_RVA)
    PutDword(outBuf, optOff + 20, TEXT_RVA)
    PutDword(outBuf, optOff + 24, IMAGE_BASE_LOW)
    PutDword(outBuf, optOff + 28, IMAGE_BASE_HIGH)
    PutDword(outBuf, optOff + 32, SECTION_ALIGN)
    PutDword(outBuf, optOff + 36, FILE_ALIGN)
    PutWord(outBuf, optOff + 40, 5)
    PutWord(outBuf, optOff + 42, 2)
    PutWord(outBuf, optOff + 48, 5)
    PutWord(outBuf, optOff + 50, 2)
    PutDword(outBuf, optOff + 56, sizeImage)
    PutDword(outBuf, optOff + 60, SIZEOF_HEADERS)
    PutWord(outBuf, optOff + 68, subsystem)
    PutDword(outBuf, optOff + 72, &H800000)
    PutDword(outBuf, optOff + 80, &H1000)
    PutDword(outBuf, optOff + 88, &H800000)
    PutDword(outBuf, optOff + 96, &H1000)
    PutDword(outBuf, optOff + 108, 16)

    PutDword(outBuf, optOff + 120, builder.idtRva)
    PutDword(outBuf, optOff + 124, builder.idtSize)
    PutDword(outBuf, optOff + 208, builder.iatRva)
    PutDword(outBuf, optOff + 212, builder.iatSize)

    sectOff = optOff + SIZEOF_OPTIONAL_HEADER64
    lstrcpy(VarPtr(outBuf[sectOff]), ".text")
    PutDword(outBuf, sectOff + 8, codeSize)
    PutDword(outBuf, sectOff + 12, TEXT_RVA)
    PutDword(outBuf, sectOff + 16, textRaw)
    PutDword(outBuf, sectOff + 20, SIZEOF_HEADERS)
    PutDword(outBuf, sectOff + 36, IMAGE_SCN_CNT_CODE Or IMAGE_SCN_MEM_EXECUTE Or IMAGE_SCN_MEM_READ)

    sectOff = sectOff + 40
    lstrcpy(VarPtr(outBuf[sectOff]), ".idata")
    PutDword(outBuf, sectOff + 8, idataSize)
    PutDword(outBuf, sectOff + 12, builder.iatRva)
    PutDword(outBuf, sectOff + 16, idataRaw)
    PutDword(outBuf, sectOff + 20, SIZEOF_HEADERS + textRaw)
    PutDword(outBuf, sectOff + 36, IMAGE_SCN_CNT_INITIALIZED_DATA Or IMAGE_SCN_MEM_READ Or IMAGE_SCN_MEM_WRITE)

    memcpy(VarPtr(outBuf[SIZEOF_HEADERS]), codeBuf, codeSize)
    idOff = SIZEOF_HEADERS + textRaw
    memcpy(VarPtr(outBuf[idOff]), idataBuf, idataSize)

    WriteAll(outPath, outBuf, outSize)
    free(outBuf)
    WritePe64 = 1
End Function

Function WritePe64Gui(outPath As *Byte, codeBuf As *Byte, codeSize As Long, idataBuf As *Byte, idataSize As DWord, builder As *ImportBuilder) As Long
    WritePe64Gui = WritePe64(outPath, codeBuf, codeSize, idataBuf, idataSize, builder, IMAGE_SUBSYSTEM_WINDOWS_GUI)
End Function

' ---- Lexer.abp ----
' ===================================================
'  Lexer - source text -> token list
' ===================================================

Const TK_EOF = 0
Const TK_IDENT = 1
Const TK_STRING = 2
Const TK_LPAREN = 3
Const TK_RPAREN = 4
Const TK_SEMI = 5
Const TK_NUMBER = 6
Const TK_EQ = 7
Const TK_PLUS = 8
Const TK_STAR = 9
Const TK_LT = 10
Const TK_LE = 11
Const TK_GT = 12
Const TK_GE = 13
Const TK_NE = 14
Const TK_COMMA = 15
Const TK_LBRACK = 16
Const TK_RBRACK = 17
Const TK_DOT = 18
Const TK_MINUS = 19
Const TK_ARROW = 20
Const TK_AMP = 21
Const TK_BACKSLASH = 22
Const TK_ERROR = 99

Const LEX_MAX_TOKS = 131072
Const LEX_TEXT_LEN = 256

Type Tok
    kind As Long
    textOff As Long
    num As Long
    line As Long
End Type

Type Lexer
    src As *Byte
    pos As Long
    toks As *Tok
    texts As *Byte
    count As Long
    capacity As Long
    err As Long
    line As Long
End Type

Function LexIsSpace(c As Long) As Long
    If c = 32 Or c = 9 Or c = 10 Or c = 13 Then
        LexIsSpace = 1
    Else
        LexIsSpace = 0
    End If
End Function

Function LexIsAlpha(c As Long) As Long
    If c >= 65 And c <= 90 Then
        LexIsAlpha = 1
    ElseIf c >= 97 And c <= 122 Then
        LexIsAlpha = 1
    ElseIf c = 95 Then
        LexIsAlpha = 1
    Else
        LexIsAlpha = 0
    End If
End Function

Function LexIsDigit(c As Long) As Long
    If c >= 48 And c <= 57 Then
        LexIsDigit = 1
    Else
        LexIsDigit = 0
    End If
End Function

Function LexIsAlnum(c As Long) As Long
    If LexIsAlpha(c) <> 0 Then
        LexIsAlnum = 1
    ElseIf LexIsDigit(c) <> 0 Then
        LexIsAlnum = 1
    Else
        LexIsAlnum = 0
    End If
End Function

Function LexCreate(capacity As Long) As *Lexer
    Dim lx As *Lexer
    LexCreate = NULL
    lx = calloc(SizeOf(Lexer))
    If lx = NULL Then Exit Function
    lx.toks = calloc(SizeOf(Tok) * capacity)
    lx.texts = calloc(LEX_TEXT_LEN * capacity)
    If lx.toks = NULL Or lx.texts = NULL Then
        If lx.toks <> NULL Then free(lx.toks)
        If lx.texts <> NULL Then free(lx.texts)
        free(lx)
        Exit Function
    End If
    lx.capacity = capacity
    lx.count = 0
    lx.pos = 0
    lx.err = 0
    LexCreate = lx
End Function

Sub LexFree(lx As *Lexer)
    If lx = NULL Then Exit Sub
    If lx.toks <> NULL Then free(lx.toks)
    If lx.texts <> NULL Then free(lx.texts)
    free(lx)
End Sub

Sub LexStoreText(lx As *Lexer, idx As Long, s As *Byte, n As Long)
    Dim texts As *Byte
    Dim off As Long
    Dim i As Long
    texts = lx.texts
    off = idx * LEX_TEXT_LEN
    i = 0
    While i < n And i < LEX_TEXT_LEN - 1
        texts[off + i] = s[i]
        i = i + 1
    Wend
    texts[off + i] = 0
End Sub

Sub LexCopyText(lx As *Lexer, idx As Long, dst As *Byte)
    Dim texts As *Byte
    Dim off As Long
    Dim i As Long
    texts = lx.texts
    off = idx * LEX_TEXT_LEN
    i = 0
    Do
        dst[i] = texts[off + i]
        If texts[off + i] = 0 Then Exit Sub
        i = i + 1
        If i >= LEX_TEXT_LEN Then
            dst[LEX_TEXT_LEN - 1] = 0
            Exit Sub
        End If
    Loop
End Sub

Function LexPush(lx As *Lexer, kind As Long) As Long
    Dim toks As *Tok
    Dim i As Long
    LexPush = -1
    If lx.count >= lx.capacity Then
        lx.err = 1
        Exit Function
    End If
    toks = lx.toks
    i = lx.count
    toks[i].kind = kind
    toks[i].textOff = i
    toks[i].num = 0
    toks[i].line = lx.line
    LexPush = i
    lx.count = i + 1
End Function

Function LexTokenize(lx As *Lexer, src As *Byte) As Long
    Dim c As Long
    Dim n2 As Long
    Dim start As Long
    Dim n As Long
    Dim idx As Long
    Dim buf(255) As Byte
    Dim i As Long
    Dim toks As *Tok

    LexTokenize = 0
    lx.src = src
    lx.pos = 0
    lx.count = 0
    lx.err = 0
    lx.line = 1

    While src[lx.pos] <> 0
        c = src[lx.pos]
        If c = 13 Then
            lx.line = lx.line + 1
            lx.pos = lx.pos + 1
            If src[lx.pos] = 10 Then
                lx.pos = lx.pos + 1
            End If
        ElseIf c = 10 Then
            lx.line = lx.line + 1
            lx.pos = lx.pos + 1
        ElseIf c = 32 Or c = 9 Then
            lx.pos = lx.pos + 1
        ElseIf c = 39 Then
            While src[lx.pos] <> 0 And src[lx.pos] <> 10 And src[lx.pos] <> 13
                lx.pos = lx.pos + 1
            Wend
        ElseIf c = 35 Then
            While src[lx.pos] <> 0 And src[lx.pos] <> 10 And src[lx.pos] <> 13
                lx.pos = lx.pos + 1
            Wend
        ElseIf c = 38 Then
            ' &H hex literal, else string concat &
            n2 = src[lx.pos + 1]
            If n2 = 72 Or n2 = 104 Then
                lx.pos = lx.pos + 2
                n = 0
                Do
                    c = src[lx.pos]
                    If c >= 48 And c <= 57 Then
                        n = n * 16 + (c - 48)
                    ElseIf c >= 65 And c <= 70 Then
                        n = n * 16 + (c - 55)
                    ElseIf c >= 97 And c <= 102 Then
                        n = n * 16 + (c - 87)
                    Else
                        Exit Do
                    End If
                    lx.pos = lx.pos + 1
                Loop
                idx = LexPush(lx, TK_NUMBER)
                If idx < 0 Then Exit Function
                toks = lx.toks
                toks[idx].num = n
            Else
                LexPush(lx, TK_AMP)
                lx.pos = lx.pos + 1
            End If
        ElseIf c = 92 Then
            LexPush(lx, TK_BACKSLASH)
            lx.pos = lx.pos + 1
        ElseIf LexIsDigit(c) <> 0 Then
            n = 0
            While LexIsDigit(src[lx.pos]) <> 0
                n = n * 10 + (src[lx.pos] - 48)
                lx.pos = lx.pos + 1
            Wend
            idx = LexPush(lx, TK_NUMBER)
            If idx < 0 Then Exit Function
            toks = lx.toks
            toks[idx].num = n
        ElseIf LexIsAlpha(c) <> 0 Then
            start = lx.pos
            While LexIsAlnum(src[lx.pos]) <> 0
                lx.pos = lx.pos + 1
            Wend
            If src[lx.pos] = 36 Then
                ' trailing $ (Left$ / Mid$)
                lx.pos = lx.pos + 1
            End If
            n = lx.pos - start
            i = 0
            While i < n And i < LEX_TEXT_LEN - 1
                buf[i] = src[start + i]
                i = i + 1
            Wend
            buf[i] = 0
            idx = LexPush(lx, TK_IDENT)
            If idx < 0 Then Exit Function
            LexStoreText(lx, idx, VarPtr(buf), i)
        ElseIf c = 34 Then
            lx.pos = lx.pos + 1
            i = 0
            Do
                If src[lx.pos] = 0 Then
                    lx.err = 1
                    Exit Function
                End If
                If src[lx.pos] = 34 Then
                    If src[lx.pos + 1] = 34 Then
                        If i < LEX_TEXT_LEN - 1 Then
                            buf[i] = 34
                            i = i + 1
                        End If
                        lx.pos = lx.pos + 2
                    Else
                        Exit Do
                    End If
                Else
                    If i < LEX_TEXT_LEN - 1 Then
                        buf[i] = src[lx.pos]
                        i = i + 1
                    End If
                    lx.pos = lx.pos + 1
                End If
            Loop
            buf[i] = 0
            lx.pos = lx.pos + 1
            idx = LexPush(lx, TK_STRING)
            If idx < 0 Then Exit Function
            LexStoreText(lx, idx, VarPtr(buf), i)
        ElseIf c = 40 Then
            LexPush(lx, TK_LPAREN)
            lx.pos = lx.pos + 1
        ElseIf c = 41 Then
            LexPush(lx, TK_RPAREN)
            lx.pos = lx.pos + 1
        ElseIf c = 59 Then
            LexPush(lx, TK_SEMI)
            lx.pos = lx.pos + 1
        ElseIf c = 44 Then
            LexPush(lx, TK_COMMA)
            lx.pos = lx.pos + 1
        ElseIf c = 91 Then
            LexPush(lx, TK_LBRACK)
            lx.pos = lx.pos + 1
        ElseIf c = 93 Then
            LexPush(lx, TK_RBRACK)
            lx.pos = lx.pos + 1
        ElseIf c = 46 Then
            LexPush(lx, TK_DOT)
            lx.pos = lx.pos + 1
        ElseIf c = 43 Then
            LexPush(lx, TK_PLUS)
            lx.pos = lx.pos + 1
        ElseIf c = 45 Then
            If src[lx.pos + 1] = 62 Then
                LexPush(lx, TK_ARROW)
                lx.pos = lx.pos + 2
            Else
                LexPush(lx, TK_MINUS)
                lx.pos = lx.pos + 1
            End If
        ElseIf c = 42 Then
            LexPush(lx, TK_STAR)
            lx.pos = lx.pos + 1
        ElseIf c = 61 Then
            LexPush(lx, TK_EQ)
            lx.pos = lx.pos + 1
        ElseIf c = 60 Then
            n2 = src[lx.pos + 1]
            If n2 = 61 Then
                LexPush(lx, TK_LE)
                lx.pos = lx.pos + 2
            ElseIf n2 = 62 Then
                LexPush(lx, TK_NE)
                lx.pos = lx.pos + 2
            Else
                LexPush(lx, TK_LT)
                lx.pos = lx.pos + 1
            End If
        ElseIf c = 62 Then
            If src[lx.pos + 1] = 61 Then
                LexPush(lx, TK_GE)
                lx.pos = lx.pos + 2
            Else
                LexPush(lx, TK_GT)
                lx.pos = lx.pos + 1
            End If
        Else
            lx.err = 1
            Exit Function
        End If
    Wend

    LexPush(lx, TK_EOF)
    If lx.err <> 0 Then Exit Function
    LexTokenize = 1
End Function

' ---- Types.abp ----
' ===================================================
'  Types - user Type registry (Word/DWord packing)
' ===================================================

Const TYMAX_TYPES = 128
Const TYMAX_FIELDS = 512
Const TYNAME_LEN = 48

Type TypeTable
    nTypes As Long
    nFields As Long
    typeNames As *Byte
    typeSizes As *Long
    typeFirst As *Long
    fieldNames As *Byte
    fieldOffs As *Long
    fieldSizes As *Long
    fieldCounts As *Long
    fieldNext As *Long
End Type

Function TyNameEq(a As *Byte, b As *Byte) As Long
    Dim i As Long
    Dim ca As Long
    Dim cb As Long
    TyNameEq = 0
    i = 0
    Do
        ca = a[i]
        cb = b[i]
        If ca >= 65 And ca <= 90 Then ca = ca + 32
        If cb >= 65 And cb <= 90 Then cb = cb + 32
        If ca <> cb Then Exit Function
        If ca = 0 Then
            TyNameEq = 1
            Exit Function
        End If
        i = i + 1
    Loop
End Function

Sub TyFree(t As *TypeTable)
    If t = NULL Then Exit Sub
    If t.typeNames <> NULL Then free(t.typeNames)
    If t.typeSizes <> NULL Then free(t.typeSizes)
    If t.typeFirst <> NULL Then free(t.typeFirst)
    If t.fieldNames <> NULL Then free(t.fieldNames)
    If t.fieldOffs <> NULL Then free(t.fieldOffs)
    If t.fieldSizes <> NULL Then free(t.fieldSizes)
    If t.fieldCounts <> NULL Then free(t.fieldCounts)
    If t.fieldNext <> NULL Then free(t.fieldNext)
    free(t)
End Sub

Function TyCreate() As *TypeTable
    Dim t As *TypeTable
    TyCreate = NULL
    t = calloc(SizeOf(TypeTable))
    If t = NULL Then Exit Function
    t.typeNames = calloc(TYMAX_TYPES * TYNAME_LEN)
    t.typeSizes = calloc(SizeOf(Long) * TYMAX_TYPES)
    t.typeFirst = calloc(SizeOf(Long) * TYMAX_TYPES)
    t.fieldNames = calloc(TYMAX_FIELDS * TYNAME_LEN)
    t.fieldOffs = calloc(SizeOf(Long) * TYMAX_FIELDS)
    t.fieldSizes = calloc(SizeOf(Long) * TYMAX_FIELDS)
    t.fieldCounts = calloc(SizeOf(Long) * TYMAX_FIELDS)
    t.fieldNext = calloc(SizeOf(Long) * TYMAX_FIELDS)
    If t.typeNames = NULL Or t.typeSizes = NULL Or t.typeFirst = NULL Or t.fieldNames = NULL Or t.fieldOffs = NULL Or t.fieldSizes = NULL Or t.fieldCounts = NULL Or t.fieldNext = NULL Then
        TyFree(t)
        Exit Function
    End If
    t.nTypes = 0
    t.nFields = 0
    TyCreate = t
End Function

Function TyPrimSize(name As *Byte) As Long
    Dim k(15) As Byte
    TyPrimSize = 0
    lstrcpy(VarPtr(k), "byte")
    If TyNameEq(name, VarPtr(k)) <> 0 Then
        TyPrimSize = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "word")
    If TyNameEq(name, VarPtr(k)) <> 0 Then
        TyPrimSize = 2
        Exit Function
    End If
    lstrcpy(VarPtr(k), "dword")
    If TyNameEq(name, VarPtr(k)) <> 0 Then
        TyPrimSize = 4
        Exit Function
    End If
    lstrcpy(VarPtr(k), "long")
    If TyNameEq(name, VarPtr(k)) <> 0 Then
        TyPrimSize = 4
        Exit Function
    End If
    lstrcpy(VarPtr(k), "string")
    If TyNameEq(name, VarPtr(k)) <> 0 Then
        TyPrimSize = 8
        Exit Function
    End If
    lstrcpy(VarPtr(k), "handle")
    If TyNameEq(name, VarPtr(k)) <> 0 Then
        TyPrimSize = 8
        Exit Function
    End If
End Function

Function TyFind(t As *TypeTable, name As *Byte) As Long
    Dim i As Long
    Dim names As *Byte
    Dim off As Long
    TyFind = -1
    If t = NULL Then Exit Function
    names = t.typeNames
    i = 0
    While i < t.nTypes
        off = i * TYNAME_LEN
        If TyNameEq(VarPtr(names[off]), name) <> 0 Then
            TyFind = i
            Exit Function
        End If
        i = i + 1
    Wend
End Function

Function TySizeOfName(t As *TypeTable, name As *Byte) As Long
    Dim sz As Long
    Dim ti As Long
    Dim sizes As *Long
    TySizeOfName = 0
    sz = TyPrimSize(name)
    If sz > 0 Then
        TySizeOfName = sz
        Exit Function
    End If
    ti = TyFind(t, name)
    If ti < 0 Then Exit Function
    sizes = t.typeSizes
    TySizeOfName = sizes[ti]
End Function

Function TyAdd(t As *TypeTable, name As *Byte) As Long
    Dim i As Long
    Dim names As *Byte
    Dim firsts As *Long
    Dim sizes As *Long
    Dim j As Long
    Dim off As Long

    TyAdd = -1
    If t = NULL Then Exit Function
    i = TyFind(t, name)
    If i >= 0 Then
        TyAdd = i
        Exit Function
    End If
    If t.nTypes >= TYMAX_TYPES Then Exit Function
    i = t.nTypes
    names = t.typeNames
    firsts = t.typeFirst
    sizes = t.typeSizes
    off = i * TYNAME_LEN
    j = 0
    While name[j] <> 0 And j < TYNAME_LEN - 1
        names[off + j] = name[j]
        j = j + 1
    Wend
    names[off + j] = 0
    sizes[i] = 0
    firsts[i] = -1
    t.nTypes = i + 1
    TyAdd = i
End Function

Function TyAddField(t As *TypeTable, typeIdx As Long, name As *Byte, elemSize As Long, count As Long) As Long
    Dim fi As Long
    Dim names As *Byte
    Dim offs As *Long
    Dim sizes As *Long
    Dim counts As *Long
    Dim nexts As *Long
    Dim firsts As *Long
    Dim tsizes As *Long
    Dim j As Long
    Dim off As Long
    Dim align As Long
    Dim cur As Long
    Dim last As Long

    TyAddField = 0
    If t = NULL Then Exit Function
    If typeIdx < 0 Or typeIdx >= t.nTypes Then Exit Function
    If elemSize <= 0 Or count <= 0 Then Exit Function
    If t.nFields >= TYMAX_FIELDS Then Exit Function

    align = elemSize
    If align > 8 Then align = 8
    If align = 0 Then align = 1
    tsizes = t.typeSizes
    off = tsizes[typeIdx]
    cur = align - 1
    last = off And cur
    While last <> 0
        off = off + 1
        last = off And cur
    Wend

    fi = t.nFields
    names = t.fieldNames
    offs = t.fieldOffs
    sizes = t.fieldSizes
    counts = t.fieldCounts
    nexts = t.fieldNext
    firsts = t.typeFirst

    j = 0
    cur = fi * TYNAME_LEN
    While name[j] <> 0 And j < TYNAME_LEN - 1
        names[cur + j] = name[j]
        j = j + 1
    Wend
    names[cur + j] = 0
    offs[fi] = off
    sizes[fi] = elemSize
    counts[fi] = count
    nexts[fi] = -1

    If firsts[typeIdx] < 0 Then
        firsts[typeIdx] = fi
    Else
        last = firsts[typeIdx]
        While nexts[last] >= 0
            last = nexts[last]
        Wend
        nexts[last] = fi
    End If

    tsizes[typeIdx] = off + elemSize * count
    t.nFields = fi + 1
    TyAddField = 1
End Function

Function TyFindField(t As *TypeTable, typeIdx As Long, name As *Byte, ByRef outOff As Long, ByRef outSize As Long, ByRef outCount As Long) As Long
    Dim fi As Long
    Dim names As *Byte
    Dim offs As *Long
    Dim sizes As *Long
    Dim counts As *Long
    Dim nexts As *Long
    Dim firsts As *Long
    Dim cur As Long

    TyFindField = 0
    outOff = 0
    outSize = 0
    outCount = 0
    If t = NULL Then Exit Function
    If typeIdx < 0 Or typeIdx >= t.nTypes Then Exit Function
    names = t.fieldNames
    offs = t.fieldOffs
    sizes = t.fieldSizes
    counts = t.fieldCounts
    nexts = t.fieldNext
    firsts = t.typeFirst
    fi = firsts[typeIdx]
    While fi >= 0
        cur = fi * TYNAME_LEN
        If TyNameEq(VarPtr(names[cur]), name) <> 0 Then
            outOff = offs[fi]
            outSize = sizes[fi]
            outCount = counts[fi]
            TyFindField = 1
            Exit Function
        End If
        fi = nexts[fi]
    Wend
End Function

' ---- Ast.abp ----
' ===================================================
'  AST - abstract syntax tree
' ===================================================

Const AST_NONE = 0
Const AST_PROGRAM = 1
Const AST_PRINT = 2
Const AST_STRING = 3
Const AST_EXIT = 4
Const AST_END = 5
Const AST_DIM = 6
Const AST_ASSIGN = 7
Const AST_VAR = 8
Const AST_NUM = 9
Const AST_BINOP = 10
Const AST_IF = 11
Const AST_WHILE = 12
Const AST_FOR = 13
Const AST_FUNC = 14
Const AST_CALL = 15
Const AST_BUILTIN = 16
Const AST_CONST = 17
Const AST_INDEX = 18
Const AST_TYPE = 19
Const AST_MEMBER = 20
Const AST_DO = 21
Const AST_EXITDO = 22
Const AST_EXITFUNC = 23
Const AST_UNARY = 24
Const AST_ARG = 25
Const AST_EXITWHILE = 26
Const AST_INPUT = 27
Const AST_DECLARE = 28
Const AST_INSMENU = 29

' Binop / compare ops (stored in AstNode.num for AST_BINOP)
Const BOP_ADD = 1
Const BOP_MUL = 2
Const BOP_EQ = 3
Const BOP_NE = 4
Const BOP_LT = 5
Const BOP_LE = 6
Const BOP_GT = 7
Const BOP_GE = 8
Const BOP_CAT = 9
Const BOP_AND = 10
Const BOP_OR = 11
Const BOP_SUB = 12
Const BOP_IDIV = 13

' Unary ops (AstNode.num for AST_UNARY)
Const UOP_NEG = 1

' Builtin kind (AstNode.num for AST_BUILTIN)
Const BI_LEN = 1
Const BI_ASC = 2
Const BI_LEFT = 3
Const BI_MID = 4
Const BI_VARPTR = 5
Const BI_SIZEOF = 6
Const BI_ADDRESSOF = 7
Const BI_MALLOC = 8
Const BI_FREE = 9
Const BI_STRPTR = 10
Const BI_STR = 11
Const BI_MEMCPY = 12
Const BI_MAKESTR = 13
Const BI_MAKEINTRESOURCE = 14
Const BI_FILLMEMORY = 15
Const BI_CHR = 16
Const BI_RIGHT = 17
Const BI_RGB = 18
Const BI_LOWORD = 19

' Dim type (AstNode.num for AST_DIM)
Const TY_LONG = 0
Const TY_STRING = 1
Const TY_BYTE = 2
Const TY_BYTE_ARR = 3
Const TY_PTR_BYTE = 4
Const TY_UDT = 5
Const TY_LONG_ARR = 6
Const TY_PTR_UDT = 7
Const TY_STRING_ARR = 8
Const TY_PTR_LONG = 9

Const AST_MAX_NODES = 131072
Const AST_STR_LEN = 256

Type AstNode
    kind As Long
    left As Long
    right As Long
    extra As Long
    nxt As Long
    strId As Long
    num As Long
End Type

Type Ast
    nodes As *AstNode
    strs As *Byte
    count As Long
    capacity As Long
    root As Long
    err As Long
    types As *TypeTable
End Type

Function AstCreate(capacity As Long) As *Ast
    Dim a As *Ast
    AstCreate = NULL
    a = calloc(SizeOf(Ast))
    If a = NULL Then Exit Function
    a.nodes = calloc(SizeOf(AstNode) * capacity)
    a.strs = calloc(AST_STR_LEN * capacity)
    If a.nodes = NULL Or a.strs = NULL Then
        If a.nodes <> NULL Then free(a.nodes)
        If a.strs <> NULL Then free(a.strs)
        free(a)
        Exit Function
    End If
    a.capacity = capacity
    a.count = 0
    a.root = -1
    a.err = 0
    a.types = TyCreate()
    If a.types = NULL Then
        free(a.nodes)
        free(a.strs)
        free(a)
        Exit Function
    End If
    AstCreate = a
End Function

Sub AstFree(a As *Ast)
    If a = NULL Then Exit Sub
    If a.types <> NULL Then TyFree(a.types)
    If a.nodes <> NULL Then free(a.nodes)
    If a.strs <> NULL Then free(a.strs)
    free(a)
End Sub

Function AstAddNode(a As *Ast, kind As Long) As Long
    Dim nodes As *AstNode
    Dim i As Long
    AstAddNode = -1
    If a.count >= a.capacity Then
        a.err = 1
        Exit Function
    End If
    nodes = a.nodes
    i = a.count
    nodes[i].kind = kind
    nodes[i].left = -1
    nodes[i].right = -1
    nodes[i].extra = -1
    nodes[i].nxt = -1
    nodes[i].strId = -1
    nodes[i].num = 0
    AstAddNode = i
    a.count = i + 1
End Function

Sub AstSetStr(a As *Ast, nodeIdx As Long, s As *Byte)
    Dim nodes As *AstNode
    Dim strs As *Byte
    Dim off As Long
    Dim i As Long
    nodes = a.nodes
    strs = a.strs
    off = nodeIdx * AST_STR_LEN
    i = 0
    While s[i] <> 0 And i < AST_STR_LEN - 1
        strs[off + i] = s[i]
        i = i + 1
    Wend
    strs[off + i] = 0
    nodes[nodeIdx].strId = nodeIdx
End Sub

Sub AstCopyStr(a As *Ast, nodeIdx As Long, dst As *Byte)
    Dim strs As *Byte
    Dim off As Long
    Dim i As Long
    strs = a.strs
    off = nodeIdx * AST_STR_LEN
    i = 0
    Do
        dst[i] = strs[off + i]
        If strs[off + i] = 0 Then Exit Sub
        i = i + 1
        If i >= AST_STR_LEN Then
            dst[AST_STR_LEN - 1] = 0
            Exit Sub
        End If
    Loop
End Sub

' ---- Parser.abp ----
' ===================================================
'  Parser - tokens -> AST
'  Dim / assign / expr / If / While / For / ExitProcess / Print / End
' ===================================================

Type Parser
    lx As *Lexer
    ast As *Ast
    pos As Long
    err As Long
End Type

Function ParseToLower(c As Long) As Long
    If c >= 65 And c <= 90 Then
        ParseToLower = c + 32
    Else
        ParseToLower = c
    End If
End Function

Function ParseTokKind(p As *Parser) As Long
    Dim lx As *Lexer
    Dim toks As *Tok
    Dim i As Long
    lx = p.lx
    toks = lx.toks
    i = p.pos
    ParseTokKind = toks[i].kind
End Function

Function ParseTokKindAt(p As *Parser, pos As Long) As Long
    Dim lx As *Lexer
    Dim toks As *Tok
    ParseTokKindAt = TK_EOF
    lx = p.lx
    toks = lx.toks
    If pos < 0 Then Exit Function
    If pos >= lx.count Then Exit Function
    ParseTokKindAt = toks[pos].kind
End Function

Function ParseTokNum(p As *Parser) As Long
    Dim lx As *Lexer
    Dim toks As *Tok
    Dim i As Long
    lx = p.lx
    toks = lx.toks
    i = p.pos
    ParseTokNum = toks[i].num
End Function

Function ParseTokLine(p As *Parser) As Long
    Dim lx As *Lexer
    Dim toks As *Tok
    Dim i As Long
    lx = p.lx
    toks = lx.toks
    i = p.pos
    ParseTokLine = toks[i].line
End Function

Function ParseExpect(p As *Parser, kind As Long) As Long
    ParseExpect = 0
    If ParseTokKind(p) <> kind Then
        p.err = 1
        Exit Function
    End If
    p.pos = p.pos + 1
    ParseExpect = 1
End Function

Function ParseIdentIsAt(p As *Parser, pos As Long, name As *Byte) As Long
    Dim lx As *Lexer
    Dim toks As *Tok
    Dim tmp(63) As Byte
    Dim j As Long

    ParseIdentIsAt = 0
    lx = p.lx
    toks = lx.toks
    If pos < 0 Or pos >= lx.count Then Exit Function
    If toks[pos].kind <> TK_IDENT Then Exit Function
    LexCopyText(lx, toks[pos].textOff, VarPtr(tmp))
    j = 0
    Do
        If ParseToLower(tmp[j]) <> ParseToLower(name[j]) Then Exit Function
        If tmp[j] = 0 Then
            ParseIdentIsAt = 1
            Exit Function
        End If
        j = j + 1
    Loop
End Function

Function ParseIdentIs(p As *Parser, name As *Byte) As Long
    ParseIdentIs = ParseIdentIsAt(p, p.pos, name)
End Function

' End / End Sub の衝突回避: stop は "End" + second（sub/function/if 等）の組のみ
Function ParseStmtListUntilEndPair(p As *Parser, second As *Byte) As Long
    Dim nFirst As Long
    Dim nPrev As Long
    Dim nStmt As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim kEnd(7) As Byte

    ParseStmtListUntilEndPair = -1
    ast = p.ast
    nFirst = -1
    nPrev = -1
    lstrcpy(VarPtr(kEnd), "end")

    While ParseTokKind(p) <> TK_EOF
        If ParseIdentIs(p, VarPtr(kEnd)) <> 0 Then
            If ParseIdentIsAt(p, p.pos + 1, second) <> 0 Then
                ParseStmtListUntilEndPair = nFirst
                Exit Function
            End If
        End If
        nStmt = ParseStmt(p)
        If nStmt < 0 Or p.err <> 0 Then Exit Function
        If nFirst < 0 Then
            nFirst = nStmt
        Else
            nodes = ast.nodes
            nodes[nPrev].nxt = nStmt
        End If
        nPrev = nStmt
        nodes = ast.nodes
        While nodes[nPrev].nxt >= 0
            nPrev = nodes[nPrev].nxt
        Wend
    Wend
    ParseStmtListUntilEndPair = nFirst
End Function

Function ParseCopyIdent(p As *Parser, dst As *Byte) As Long
    Dim lx As *Lexer
    Dim toks As *Tok
    Dim i As Long
    ParseCopyIdent = 0
    lx = p.lx
    toks = lx.toks
    i = p.pos
    If toks[i].kind <> TK_IDENT Then
        p.err = 1
        Exit Function
    End If
    LexCopyText(lx, toks[i].textOff, dst)
    p.pos = p.pos + 1
    ParseCopyIdent = 1
End Function

' dword/word/byte/handle/hwnd/integer → Long 相当（仮引数・戻り値）。一致で pos を進める
Function ParseEatLongAlias(p As *Parser) As Long
    Dim k(31) As Byte

    ParseEatLongAlias = 0
    lstrcpy(VarPtr(k), "dword")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p.pos = p.pos + 1
        ParseEatLongAlias = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "word")
