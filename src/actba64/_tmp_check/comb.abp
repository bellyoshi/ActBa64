End Function

Function LowFindFunc(ctx As *LowerCtx, name As *Byte) As Long
    Dim i As Long
    Dim names As *Byte
    Dim labs As *Long
    Dim off As Long
    LowFindFunc = -1
    names = ctx.funcNames
    labs = ctx.funcLabs
    i = 0
    While i < ctx.funcCount
        off = i * SYM_NAME_LEN
        If LowNameEq(VarPtr(names[off]), name) <> 0 Then
            LowFindFunc = labs[i]
            Exit Function
        End If
        i = i + 1
    Wend
End Function

Function LowFindFuncByRefs(ctx As *LowerCtx, name As *Byte) As Long
    Dim i As Long
    Dim names As *Byte
    Dim bys As *Long
    Dim off As Long
    LowFindFuncByRefs = 0
    names = ctx.funcNames
    bys = ctx.funcByRefs
    i = 0
    While i < ctx.funcCount
        off = i * SYM_NAME_LEN
        If LowNameEq(VarPtr(names[off]), name) <> 0 Then
            LowFindFuncByRefs = bys[i]
            Exit Function
        End If
        i = i + 1
    Wend
End Function

Function LowAddFunc(ctx As *LowerCtx, name As *Byte, lab As Long, byRefBits As Long) As Long
    Dim i As Long
    Dim names As *Byte
    Dim labs As *Long
    Dim bys As *Long
    Dim j As Long
    Dim off As Long

    LowAddFunc = 0
    If ctx.funcCount >= SYM_MAX Then
        ctx.err = 1
        Exit Function
    End If
    i = ctx.funcCount
    names = ctx.funcNames
    labs = ctx.funcLabs
    bys = ctx.funcByRefs
    off = i * SYM_NAME_LEN
    j = 0
    While name[j] <> 0 And j < SYM_NAME_LEN - 1
        names[off + j] = name[j]
        j = j + 1
    Wend
    names[off + j] = 0
    labs[i] = lab
    bys[i] = byRefBits
    ctx.funcCount = i + 1
    LowAddFunc = 1
End Function

