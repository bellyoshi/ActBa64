    lstrcpy(VarPtr(k), "byteptr")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p.pos = p.pos + 1
        ParseEatLongAlias = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "voidptr")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p.pos = p.pos + 1
        ParseEatLongAlias = 1
        Exit Function
