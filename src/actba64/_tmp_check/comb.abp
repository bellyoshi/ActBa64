' ---- PE32PLUS.abp ----
' ===================================================
'  AcBa64 linker - PE32+ (64bit) definitions
' ===================================================

Type IMAGE_DOS_HEADER
    e_magic    As Word
    e_cblp     As Word
    e_cp       As Word
    e_crlc     As Word
    e_cparhdr  As Word
    e_minalloc As Word
    e_maxalloc As Word
    e_ss       As Word
    e_sp       As Word
    e_csum     As Word
    e_ip       As Word
    e_cs       As Word
    e_lfarlc   As Word
    e_ovno     As Word
    e_res(3)   As Word
    e_oemid    As Word
    e_oeminfo  As Word
    e_res2(9)  As Word
    e_lfanew   As Long
End Type

Type IMAGE_DATA_DIRECTORY
    VirtualAddress As DWord
    Size           As DWord
End Type

' PE32+ Optional Header (240 bytes)
Type IMAGE_OPTIONAL_HEADER64
    Magic                       As Word
    MajorLinkerVersion          As Byte
    MinorLinkerVersion          As Byte
    SizeOfCode                  As DWord
    SizeOfInitializedData       As DWord
    SizeOfUninitializedData     As DWord
    AddressOfEntryPoint         As DWord
    BaseOfCode                  As DWord
    ImageBaseLow                As DWord
    ImageBaseHigh               As DWord
    SectionAlignment            As DWord
    FileAlignment               As DWord
    MajorOperatingSystemVersion As Word
    MinorOperatingSystemVersion As Word
    MajorImageVersion           As Word
    MinorImageVersion           As Word
    MajorSubsystemVersion       As Word
    MinorSubsystemVersion       As Word
    Win32VersionValue           As DWord
    SizeOfImage                 As DWord
    SizeOfHeaders               As DWord
    CheckSum                    As DWord
    Subsystem                   As Word
    DllCharacteristics          As Word
    SizeOfStackReserveLow       As DWord
    SizeOfStackReserveHigh      As DWord
    SizeOfStackCommitLow        As DWord
    SizeOfStackCommitHigh       As DWord
    SizeOfHeapReserveLow        As DWord
    SizeOfHeapReserveHigh       As DWord
    SizeOfHeapCommitLow         As DWord
    SizeOfHeapCommitHigh        As DWord
    LoaderFlags                 As DWord
    NumberOfRvaAndSizes         As DWord
    DataDirectory(15)           As IMAGE_DATA_DIRECTORY
End Type

Type IMAGE_SECTION_HEADER
    SecName(7)           As Byte
    VirtualSize          As DWord
    VirtualAddress       As DWord
    SizeOfRawData        As DWord
    PointerToRawData     As DWord
    PointerToRelocations As DWord
    PointerToLinenumbers As DWord
    NumberOfRelocations  As Word
    NumberOfLinenumbers  As Word
    Characteristics      As DWord
End Type

Const IMAGE_DOS_SIGNATURE = &H5A4D
Const IMAGE_NT_SIGNATURE = &H00004550
Const IMAGE_NT_OPTIONAL_HDR64_MAGIC = &H20B
Const IMAGE_FILE_MACHINE_AMD64 = &H8664

Const IMAGE_FILE_RELOCS_STRIPPED = &H0001
Const IMAGE_FILE_EXECUTABLE_IMAGE = &H0002
Const IMAGE_FILE_LARGE_ADDRESS_AWARE = &H0020

Const IMAGE_SCN_CNT_INITIALIZED_DATA = &H00000040
Const IMAGE_SCN_CNT_CODE = &H00000020
Const IMAGE_SCN_MEM_EXECUTE = &H20000000
Const IMAGE_SCN_MEM_WRITE = &H80000000
Const IMAGE_SCN_MEM_READ = &H40000000

Const IMAGE_SUBSYSTEM_WINDOWS_CUI = 3

Const SIZEOF_DOS_HEADER = 64
Const SIZEOF_OPTIONAL_HEADER64 = 240
Const SIZEOF_SECTION_HEADER = 40
Const SIZEOF_FILE_HEADER = 20

Const IMAGE_BASE_LOW = &H40000000
Const IMAGE_BASE_HIGH = &H00000001
Const TEXT_RVA = &H00001000
Const IDATA_RVA = &H00002000
Const SECTION_ALIGN = &H1000
Const FILE_ALIGN = &H200
Const SIZEOF_HEADERS = &H200
Const E_LFANEW = &H80
Const IMAGE_SUBSYSTEM_WINDOWS_GUI = &H0002
' ---- Utils.abp ----
' Win32 / CRT constants for self-host (host abc also provides these)
Const NULL = 0
Const MAX_PATH = 260
Const GENERIC_READ = &H80000000
Const GENERIC_WRITE = &H40000000
Const FILE_SHARE_READ = 1
Const OPEN_EXISTING = 3
Const CREATE_ALWAYS = 2
Const FILE_ATTRIBUTE_NORMAL = 128
Const INVALID_HANDLE_VALUE = &HFFFFFFFF

Function AlignUp(v As DWord, a As DWord) As DWord
    ' power-of-2 align: (v+a-1) & -a
    AlignUp = (v + a - 1) And (0 - a)
End Function

Function GetCmd(cnt As Long, buf As *Byte) As Long
    Dim cmd As *Byte
    Dim line[4096] As Byte
    Dim cmdlen As Long
    Dim cidx As Long
    Dim ctmp[260] As Byte
    Dim n As Long
    Dim m As Long
    cmd = GetCommandLine()
    cmdlen = lstrlen(cmd)
    If cmdlen > 4094 Then cmdlen = 4094
    ' GetCommandLine buffer is read-only; copy first
    memcpy(VarPtr(line), cmd, cmdlen)
    line[cmdlen] = 0
    buf[0] = 0
    cidx = 0
    n = 0
    While n < cmdlen
        While n < cmdlen And line[n] = 32
            n = n + 1
        Wend
        If n >= cmdlen Then Exit While
        m = 0
        If line[n] = 34 Then
            n = n + 1
            While n < cmdlen And line[n] <> 34
                If m < 259 Then
                    ctmp[m] = line[n]
                    m = m + 1
                End If
                n = n + 1
            Wend
            If n < cmdlen And line[n] = 34 Then n = n + 1
        Else
            While n < cmdlen And line[n] <> 32
                If m < 259 Then
                    ctmp[m] = line[n]
                    m = m + 1
                End If
                n = n + 1
            Wend
        End If
        ctmp[m] = 0
        If cidx = cnt Then
            lstrcpy(buf, ctmp)
            GetCmd = 1
            Exit Function
        End If
        cidx = cidx + 1
    Wend
    GetCmd = 0
End Function
Function LoadFile(path As *Byte, ByRef outSize As Long) As *Byte
    Dim hFile As Long
    Dim fsiz As Long
    Dim nRead As Long
    Dim p As *Byte
    LoadFile = 0
    outSize = 0
    hFile = CreateFile(path, GENERIC_READ, FILE_SHARE_READ, 0, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, 0)
    If hFile = INVALID_HANDLE_VALUE Then Exit Function
    fsiz = GetFileSize(hFile, 0)
    If fsiz <= 0 Then
        CloseHandle(hFile)
        Exit Function
    End If
    p = malloc(fsiz)
    If p = 0 Then
        CloseHandle(hFile)
        Exit Function
    End If
    ReadFile(hFile, p, fsiz, VarPtr(nRead), 0)
    CloseHandle(hFile)
    outSize = fsiz
    LoadFile = p
End Function

Function WriteAll(path As *Byte, p As *Byte, size As Long) As Long
    Dim hFile As Long
    Dim nWritten As Long
    WriteAll = 0
    hFile = CreateFile(path, GENERIC_WRITE, 0, 0, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, 0)
    If hFile = INVALID_HANDLE_VALUE Then Exit Function
    WriteFile(hFile, p, size, VarPtr(nWritten), 0)
    CloseHandle(hFile)
    If nWritten = size Then
        WriteAll = 1
    End If
End Function

Sub ZeroMem(p As *Byte, n As Long)
    Dim i As Long
    If n <= 0 Then Exit Sub
    For i = 0 To n - 1
        p[i] = 0
    Next
End Sub

Sub PutDword(p As *Byte, off As DWord, v As DWord)
    memcpy(VarPtr(p[off]), VarPtr(v), 4)
End Sub

Sub PutWord(p As *Byte, off As DWord, v As Word)
    memcpy(VarPtr(p[off]), VarPtr(v), 2)
End Sub

Sub WriteDosStub(buf As *Byte)
    buf[&H40] = &H0E
    buf[&H41] = &H1F
    buf[&H42] = &HBA
    buf[&H43] = &H0E
    buf[&H44] = &H00
    buf[&H45] = &HB4
    buf[&H46] = &H09
    buf[&H47] = &HCD
    buf[&H48] = &H21
    buf[&H49] = &HB8
    buf[&H4A] = &H01
    buf[&H4B] = &H4C
    buf[&H4C] = &HCD
    buf[&H4D] = &H21
    lstrcpy(VarPtr(buf[&H4E]), "This program cannot be run in DOS mode.")
    buf[&H75] = &H0D
    buf[&H76] = &H0A
    buf[&H77] = &H24
End Sub

' ---- ImportBuilder.abp ----
' ===================================================
'  ImportBuilder - dynamic .idata / string pool builder
'  (flat arrays: abc VarPtr cannot take nested indexed members)
' ===================================================

Const IB_MAX_DLL = 8
Const IB_MAX_FUNC = 128
Const IB_MAX_STRING = 256
Const IB_NAME_LEN = 64
Const IB_STR_LEN = 256

Type ImportBuilder
    dllCount As Long
    stringCount As Long
    funcCount(7) As Long
    dllNames(511) As Byte
    funcNames(65535) As Byte
    strValues(65535) As Byte
    funcIatRva(1023) As DWord
    funcHintRva(1023) As DWord
    dllIatRva(7) As DWord
    dllIltRva(7) As DWord
    dllNameRva(7) As DWord
    strRva(255) As DWord
    iatRva As DWord
    iatSize As DWord
    idtRva As DWord
    idtSize As DWord
    totalSize As DWord
End Type

Function IbStrLen(s As *Byte) As Long
    Dim n As Long
    n = 0
    While s[n] <> 0
        n = n + 1
    Wend
    IbStrLen = n
End Function

Function IbStrEq(a As *Byte, b As *Byte) As Long
    Dim i As Long
    i = 0
    Do
        If a[i] <> b[i] Then
            IbStrEq = 0
            Exit Function
        End If
        If a[i] = 0 Then
            IbStrEq = 1
            Exit Function
        End If
        i = i + 1
    Loop
End Function

Sub IbStrCpy(dst As *Byte, src As *Byte, maxLen As Long)
    Dim i As Long
    i = 0
    While src[i] <> 0 And i < maxLen - 1
        dst[i] = src[i]
        i = i + 1
    Wend
    dst[i] = 0
End Sub

Function IbAlign2(v As DWord) As DWord
    IbAlign2 = (v + 1) And &HFFFFFFFE
End Function

Function IbFuncSlot(dIdx As Long, fIdx As Long) As Long
    IbFuncSlot = dIdx * IB_MAX_FUNC + fIdx
End Function

Sub IbCopyToBuilderName(builder As *ImportBuilder, baseOff As Long, src As *Byte, maxLen As Long)
    Dim i As Long
    i = 0
    While src[i] <> 0 And i < maxLen - 1
        builder.dllNames[baseOff + i] = src[i]
        i = i + 1
    Wend
    builder.dllNames[baseOff + i] = 0
End Sub

Sub IbCopyToFuncName(builder As *ImportBuilder, baseOff As Long, src As *Byte, maxLen As Long)
    Dim i As Long
    i = 0
    While src[i] <> 0 And i < maxLen - 1
        builder.funcNames[baseOff + i] = src[i]
        i = i + 1
    Wend
    builder.funcNames[baseOff + i] = 0
End Sub

Sub IbCopyToStrValue(builder As *ImportBuilder, baseOff As Long, src As *Byte, maxLen As Long)
    Dim i As Long
    i = 0
    While src[i] <> 0 And i < maxLen - 1
        builder.strValues[baseOff + i] = src[i]
        i = i + 1
    Wend
    builder.strValues[baseOff + i] = 0
End Sub

Function IbDllNameEq(builder As *ImportBuilder, dIdx As Long, name As *Byte) As Long
    Dim off As Long
    Dim i As Long
    off = dIdx * IB_NAME_LEN
    i = 0
    Do
        If builder.dllNames[off + i] <> name[i] Then
            IbDllNameEq = 0
            Exit Function
        End If
        If builder.dllNames[off + i] = 0 Then
            IbDllNameEq = 1
            Exit Function
        End If
        i = i + 1
    Loop
End Function

Function IbFuncNameEq(builder As *ImportBuilder, dIdx As Long, fIdx As Long, name As *Byte) As Long
    Dim off As Long
    Dim i As Long
    off = IbFuncSlot(dIdx, fIdx) * IB_NAME_LEN
    i = 0
    Do
        If builder.funcNames[off + i] <> name[i] Then
            IbFuncNameEq = 0
            Exit Function
        End If
        If builder.funcNames[off + i] = 0 Then
            IbFuncNameEq = 1
            Exit Function
        End If
        i = i + 1
    Loop
End Function

Function IbStrValueEq(builder As *ImportBuilder, sIdx As Long, name As *Byte) As Long
    Dim off As Long
    Dim i As Long
    off = sIdx * IB_STR_LEN
    i = 0
    Do
        If builder.strValues[off + i] <> name[i] Then
            IbStrValueEq = 0
            Exit Function
        End If
        If builder.strValues[off + i] = 0 Then
            IbStrValueEq = 1
            Exit Function
        End If
        i = i + 1
    Loop
End Function

Function IbDllNameLen(builder As *ImportBuilder, dIdx As Long) As Long
    Dim off As Long
    Dim n As Long
    off = dIdx * IB_NAME_LEN
    n = 0
    While builder.dllNames[off + n] <> 0
        n = n + 1
    Wend
    IbDllNameLen = n
End Function

Function IbFuncNameLen(builder As *ImportBuilder, dIdx As Long, fIdx As Long) As Long
    Dim off As Long
    Dim n As Long
    off = IbFuncSlot(dIdx, fIdx) * IB_NAME_LEN
    n = 0
    While builder.funcNames[off + n] <> 0
        n = n + 1
    Wend
    IbFuncNameLen = n
End Function

Function IbStrValueLen(builder As *ImportBuilder, sIdx As Long) As Long
    Dim off As Long
    Dim n As Long
    off = sIdx * IB_STR_LEN
    n = 0
    While builder.strValues[off + n] <> 0
        n = n + 1
    Wend
    IbStrValueLen = n
End Function

Sub IbInit(builder As *ImportBuilder)
    ZeroMem(builder, SizeOf(ImportBuilder))
End Sub

Function IbAddImport(builder As *ImportBuilder, dllName As *Byte, funcName As *Byte) As Long
    Dim i As Long
    Dim j As Long
    Dim dIdx As Long
    Dim fIdx As Long
    Dim gIdx As Long
    Dim off As Long

    IbAddImport = -1
    gIdx = 0
    For i = 0 To builder.dllCount - 1
        If IbDllNameEq(builder, i, dllName) <> 0 Then
            For j = 0 To builder.funcCount[i] - 1
                If IbFuncNameEq(builder, i, j, funcName) <> 0 Then
                    IbAddImport = gIdx + j
                    Exit Function
                End If
            Next
            If builder.funcCount[i] >= IB_MAX_FUNC Then Exit Function
            fIdx = builder.funcCount[i]
            off = IbFuncSlot(i, fIdx) * IB_NAME_LEN
            IbCopyToFuncName(builder, off, funcName, IB_NAME_LEN)
            builder.funcCount[i] = fIdx + 1
            IbAddImport = gIdx + fIdx
            Exit Function
        End If
        gIdx = gIdx + builder.funcCount[i]
    Next

    If builder.dllCount >= IB_MAX_DLL Then Exit Function
    dIdx = builder.dllCount
    IbCopyToBuilderName(builder, dIdx * IB_NAME_LEN, dllName, IB_NAME_LEN)
    IbCopyToFuncName(builder, IbFuncSlot(dIdx, 0) * IB_NAME_LEN, funcName, IB_NAME_LEN)
    builder.funcCount[dIdx] = 1
    builder.dllCount = dIdx + 1
    IbAddImport = gIdx
End Function

Function IbAddString(builder As *ImportBuilder, strVal As *Byte) As Long
    Dim i As Long
    Dim sIdx As Long

    For i = 0 To builder.stringCount - 1
        If IbStrValueEq(builder, i, strVal) <> 0 Then
            IbAddString = i
            Exit Function
        End If
    Next

    IbAddString = -1
    If builder.stringCount >= IB_MAX_STRING Then Exit Function
    sIdx = builder.stringCount
    IbCopyToStrValue(builder, sIdx * IB_STR_LEN, strVal, IB_STR_LEN)
    builder.stringCount = sIdx + 1
    IbAddString = sIdx
End Function

Function IbGetIatRva(builder As *ImportBuilder, dllName As *Byte, funcName As *Byte) As DWord
    Dim i As Long
    Dim j As Long
    Dim slot As Long

    IbGetIatRva = 0
    For i = 0 To builder.dllCount - 1
        If IbDllNameEq(builder, i, dllName) <> 0 Then
            For j = 0 To builder.funcCount[i] - 1
                If IbFuncNameEq(builder, i, j, funcName) <> 0 Then
                    slot = IbFuncSlot(i, j)
                    IbGetIatRva = builder.funcIatRva[slot]
                    Exit Function
                End If
            Next
            Exit Function
        End If
    Next
End Function

Function IbGetStringRva(builder As *ImportBuilder, strId As Long) As DWord
    IbGetStringRva = 0
    If strId < 0 Or strId >= builder.stringCount Then Exit Function
    IbGetStringRva = builder.strRva[strId]
End Function

Sub IbWriteNameBytes(outBuf As *Byte, dstOff As DWord, builder As *ImportBuilder, srcKind As Long, idx1 As Long, idx2 As Long)
    ' srcKind: 0=dll, 1=func, 2=string
    Dim i As Long
    Dim off As Long
    Dim b As Byte
    If srcKind = 0 Then
        off = idx1 * IB_NAME_LEN
        i = 0
        Do
            b = builder.dllNames[off + i]
            outBuf[dstOff + i] = b
            If b = 0 Then Exit Sub
            i = i + 1
        Loop
    ElseIf srcKind = 1 Then
        off = IbFuncSlot(idx1, idx2) * IB_NAME_LEN
        i = 0
        Do
            b = builder.funcNames[off + i]
            outBuf[dstOff + i] = b
            If b = 0 Then Exit Sub
            i = i + 1
        Loop
    Else
        off = idx1 * IB_STR_LEN
        i = 0
        Do
            b = builder.strValues[off + i]
            outBuf[dstOff + i] = b
            If b = 0 Then Exit Sub
            i = i + 1
        Loop
    End If
End Sub

Sub IbFinalize(builder As *ImportBuilder, baseRva As DWord, outBuf As *Byte, ByRef totalSize As DWord)
    Dim cur As DWord
    Dim i As Long
    Dim j As Long
    Dim n As Long
    Dim hintSz As DWord
    Dim idtOff As DWord
    Dim iltOff As DWord
    Dim nameOff As DWord
    Dim slot As Long

    cur = 0

    builder.iatRva = baseRva
    For i = 0 To builder.dllCount - 1
        builder.dllIatRva[i] = baseRva + cur
        For j = 0 To builder.funcCount[i] - 1
            slot = IbFuncSlot(i, j)
            builder.funcIatRva[slot] = baseRva + cur
            cur = cur + 8
        Next
        cur = cur + 8
    Next
    builder.iatSize = cur

    builder.idtRva = baseRva + cur
    builder.idtSize = (builder.dllCount + 1) * 20
    idtOff = cur
    cur = cur + builder.idtSize

    For i = 0 To builder.dllCount - 1
        builder.dllIltRva[i] = baseRva + cur
        cur = cur + (builder.funcCount[i] + 1) * 8
    Next

    For i = 0 To builder.dllCount - 1
        For j = 0 To builder.funcCount[i] - 1
            cur = IbAlign2(cur)
            slot = IbFuncSlot(i, j)
            builder.funcHintRva[slot] = baseRva + cur
            n = IbFuncNameLen(builder, i, j)
            hintSz = 2 + n + 1
            cur = cur + hintSz
        Next
    Next

    For i = 0 To builder.dllCount - 1
        cur = IbAlign2(cur)
        builder.dllNameRva[i] = baseRva + cur
        n = IbDllNameLen(builder, i)
        cur = cur + n + 1
    Next

    For i = 0 To builder.stringCount - 1
        builder.strRva[i] = baseRva + cur
        n = IbStrValueLen(builder, i)
        cur = cur + n + 1
    Next

    builder.totalSize = cur
    totalSize = cur
    ZeroMem(outBuf, cur)

    For i = 0 To builder.dllCount - 1
        For j = 0 To builder.funcCount[i] - 1
            slot = IbFuncSlot(i, j)
            PutDword(outBuf, builder.funcIatRva[slot] - baseRva, builder.funcHintRva[slot])
        Next
    Next

    For i = 0 To builder.dllCount - 1
        nameOff = idtOff + i * 20
        PutDword(outBuf, nameOff + 0, builder.dllIltRva[i])
        PutDword(outBuf, nameOff + 12, builder.dllNameRva[i])
        PutDword(outBuf, nameOff + 16, builder.dllIatRva[i])
    Next

    For i = 0 To builder.dllCount - 1
        iltOff = builder.dllIltRva[i] - baseRva
        For j = 0 To builder.funcCount[i] - 1
            slot = IbFuncSlot(i, j)
            PutDword(outBuf, iltOff + j * 8, builder.funcHintRva[slot])
        Next
    Next

    For i = 0 To builder.dllCount - 1
        For j = 0 To builder.funcCount[i] - 1
            slot = IbFuncSlot(i, j)
            nameOff = builder.funcHintRva[slot] - baseRva
            PutWord(outBuf, nameOff, 0)
            IbWriteNameBytes(outBuf, nameOff + 2, builder, 1, i, j)
        Next
    Next

    For i = 0 To builder.dllCount - 1
        nameOff = builder.dllNameRva[i] - baseRva
        IbWriteNameBytes(outBuf, nameOff, builder, 0, i, 0)
    Next

    For i = 0 To builder.stringCount - 1
        nameOff = builder.strRva[i] - baseRva
        IbWriteNameBytes(outBuf, nameOff, builder, 2, i, 0)
    Next
End Sub

' ---- Emiter.abp ----
' ===================================================
'  CodeBuffer + x64 emitters (RIP-relative)
' ===================================================

Dim g_IsDebugAsm As Long

Sub WriteAsmLine(s As String)
End Sub

Type CodeBuffer
    buf As *Byte
    capacity As Long
    size As Long
End Type

Sub EmitByte(cb As *CodeBuffer, b As Byte)
    If cb.size >= cb.capacity Then Exit Sub
    cb.buf[cb.size] = b
    cb.size = cb.size + 1
End Sub

Sub EmitDword(cb As *CodeBuffer, dw As DWord)
    If cb.size + 4 > cb.capacity Then Exit Sub
    PutDword(VarPtr(cb.buf[cb.size]), 0, dw)
    cb.size = cb.size + 4
End Sub

Sub EmitCallRip(cb As *CodeBuffer, targetRva As DWord, textBaseRva As DWord)
    Dim nextRip As DWord
    EmitByte(cb, &HFF)
    EmitByte(cb, &H15)
    nextRip = textBaseRva + cb.size + 4
    EmitDword(cb, targetRva - nextRip)
End Sub

Sub EmitLeaRdxRip(cb As *CodeBuffer, targetRva As DWord, textBaseRva As DWord)
    Dim nextRip As DWord
    EmitByte(cb, &H48)
    EmitByte(cb, &H8D)
    EmitByte(cb, &H15)
    nextRip = textBaseRva + cb.size + 4
    EmitDword(cb, targetRva - nextRip)
End Sub

Sub EmitLeaR8Rip(cb As *CodeBuffer, targetRva As DWord, textBaseRva As DWord)
    Dim nextRip As DWord
    EmitByte(cb, &H4C)
    EmitByte(cb, &H8D)
    EmitByte(cb, &H05)
    nextRip = textBaseRva + cb.size + 4
    EmitDword(cb, targetRva - nextRip)
End Sub

' push rbp; mov rbp, rsp; sub rsp, imm32
Sub EmitEnter(cb As *CodeBuffer, frameSize As DWord)
    EmitByte(cb, &H55)
    EmitByte(cb, &H48)
    EmitByte(cb, &H89)
    EmitByte(cb, &HE5)
    EmitByte(cb, &H48)
    EmitByte(cb, &H81)
    EmitByte(cb, &HEC)
    EmitDword(cb, frameSize)
End Sub

' leave; ret  => mov rsp,rbp; pop rbp; ret
Sub EmitLeaveRet(cb As *CodeBuffer)
    EmitByte(cb, &HC9)
    EmitByte(cb, &HC3)
End Sub

Sub EmitSubRsp(cb As *CodeBuffer, imm8 As Byte)
    EmitByte(cb, &H48)
    EmitByte(cb, &H83)
    EmitByte(cb, &HEC)
    EmitByte(cb, imm8)
End Sub

Sub EmitAddRsp(cb As *CodeBuffer, imm8 As Byte)
    EmitByte(cb, &H48)
    EmitByte(cb, &H83)
    EmitByte(cb, &HC4)
    EmitByte(cb, imm8)
End Sub

Sub EmitXorEcx(cb As *CodeBuffer)
    EmitByte(cb, &H31)
    EmitByte(cb, &HC9)
End Sub

Sub EmitXorR9d(cb As *CodeBuffer)
    EmitByte(cb, &H45)
    EmitByte(cb, &H31)
    EmitByte(cb, &HC9)
End Sub

Sub EmitRet(cb As *CodeBuffer)
    EmitByte(cb, &HC3)
End Sub

Sub EmitMovEcxImm(cb As *CodeBuffer, imm As DWord)
    EmitByte(cb, &HB9)
    EmitDword(cb, imm)
End Sub

Sub EmitMovEaxImm(cb As *CodeBuffer, imm As DWord)
    EmitByte(cb, &HB8)
    EmitDword(cb, imm)
End Sub

' mov rax, [rbp + disp32]
Sub EmitLoadLocal(cb As *CodeBuffer, disp As Long)
    EmitByte(cb, &H48)
    EmitByte(cb, &H8B)
    EmitByte(cb, &H85)
    EmitDword(cb, disp)
End Sub

' mov [rbp + disp32], rax
Sub EmitStoreLocal(cb As *CodeBuffer, disp As Long)
    EmitByte(cb, &H48)
    EmitByte(cb, &H89)
    EmitByte(cb, &H85)
    EmitDword(cb, disp)
End Sub

