        ApiCopy(apiOut, "ImmSetCompositionWindow")
        LowMapWinApi = 1
        Exit Function
    End If
End Function

' ---- AstLower.abp ----
' ===================================================
'  AstLower - AST -> IR (locals / arith / control)
' ===================================================

Const SYM_MAX = 512
' Declare 名は長くなりうる（EditorBuild_SetHandleInformation = 32 文字）
Const SYM_NAME_LEN = 64

Const LOW_MF_POPUP = &H10
Const LOW_MF_SEPARATOR = &H800

' Preproc が .pj の #USEWINDOW を反映する（0 = CUI）
Dim gPpUseWindow As Long

Type LowerCtx
    list As *IrList
    ast As *Ast
    symCount As Long
    nextLab As Long
    err As Long
    names As *Byte
    offs As *Long
    types As *Long
    typeIdxs As *Long
    byRefs As *Long
    frameUsed As Long
    retName As *Byte
    inFunc As Long
    funcNames As *Byte
    funcLabs As *Long
    funcByRefs As *Long
    funcCount As Long
    constNames As *Byte
    constVals As *Long
    constCount As Long
    declNames As *Byte
    declApiNames As *Byte
    declDlls As *Long
    declByRefs As *Long
    declCount As Long
    doEndLab As Long
    whileEndLab As Long
    funcEndLab As Long
    rtCatLab As Long
    rtMidLab As Long
    rtStrLab As Long
    rtPrintLab As Long
    rtInputLab As Long
End Type

Function LowToLower(c As Long) As Long
    If c >= 65 And c <= 90 Then
        LowToLower = c + 32
    Else
        LowToLower = c
    End If
End Function

Function LowNameEq(a As *Byte, b As *Byte) As Long
    Dim i As Long
    LowNameEq = 0
    i = 0
    Do
        If LowToLower(a[i]) <> LowToLower(b[i]) Then Exit Function
        If a[i] = 0 Then
            LowNameEq = 1
            Exit Function
        End If
        i = i + 1
    Loop
End Function

Function LowFindSym(ctx As *LowerCtx, name As *Byte) As Long
    Dim i As Long
    Dim names As *Byte
    Dim off As Long
    LowFindSym = -1
    names = ctx.names
    i = 0
    While i < ctx.symCount
        off = i * SYM_NAME_LEN
        If LowNameEq(VarPtr(names[off]), name) <> 0 Then
            LowFindSym = i
            Exit Function
        End If
        i = i + 1
    Wend
End Function

Function LowAddSym(ctx As *LowerCtx, name As *Byte, ty As Long, nbytes As Long, typeIdx As Long, isByRef As Long) As Long
    Dim i As Long
    Dim names As *Byte
    Dim offs As *Long
    Dim types As *Long
    Dim typeIdxs As *Long
    Dim byRefs As *Long
    Dim j As Long
    Dim off As Long
    Dim sz As Long

    LowAddSym = -1
    i = LowFindSym(ctx, name)
    If i >= 0 Then
        LowAddSym = i
        Exit Function
    End If
    If ctx.symCount >= SYM_MAX Then
        ctx.err = 1
        Exit Function
    End If
    i = ctx.symCount
    names = ctx.names
    offs = ctx.offs
    types = ctx.types
    typeIdxs = ctx.typeIdxs
    byRefs = ctx.byRefs
    off = i * SYM_NAME_LEN
    j = 0
    While name[j] <> 0 And j < SYM_NAME_LEN - 1
        names[off + j] = name[j]
        j = j + 1
    Wend
    names[off + j] = 0
    sz = nbytes
    If sz < 8 Then sz = 8
    sz = (sz + 7) And (0 - 8)
    ctx.frameUsed = ctx.frameUsed + sz
    offs[i] = 0 - ctx.frameUsed
    types[i] = ty
    typeIdxs[i] = typeIdx
    byRefs[i] = isByRef
    ctx.symCount = i + 1
    LowAddSym = i
End Function

Function LowFindConst(ctx As *LowerCtx, name As *Byte) As Long
    Dim i As Long
    Dim names As *Byte
    Dim off As Long
    LowFindConst = -1
    names = ctx.constNames
    i = 0
    While i < ctx.constCount
        off = i * SYM_NAME_LEN
        If LowNameEq(VarPtr(names[off]), name) <> 0 Then
            LowFindConst = i
            Exit Function
        End If
        i = i + 1
    Wend
End Function

Function LowAddConst(ctx As *LowerCtx, name As *Byte, v As Long) As Long
    Dim i As Long
    Dim names As *Byte
    Dim vals As *Long
    Dim j As Long
    Dim off As Long

    LowAddConst = 0
    If LowFindConst(ctx, name) >= 0 Then
        LowAddConst = 1
        Exit Function
    End If
    If ctx.constCount >= SYM_MAX Then
        ctx.err = 1
        Exit Function
    End If
    i = ctx.constCount
    names = ctx.constNames
    vals = ctx.constVals
    off = i * SYM_NAME_LEN
    j = 0
    While name[j] <> 0 And j < SYM_NAME_LEN - 1
        names[off + j] = name[j]
        j = j + 1
    Wend
    names[off + j] = 0
    vals[i] = v
    ctx.constCount = i + 1
    LowAddConst = 1
End Function

Function LowBoundVal(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim ci As Long
    Dim vals As *Long
    Dim lv As Long
    Dim rv As Long
    Dim op As Long
    Dim leftIdx As Long
    Dim rightIdx As Long

    LowBoundVal = -1
    If idx < 0 Then Exit Function
    ast = ctx.ast
    nodes = ast.nodes
    If nodes[idx].kind = AST_NUM Then
        LowBoundVal = nodes[idx].num
    ElseIf nodes[idx].kind = AST_VAR Then
        AstCopyStr(ast, idx, VarPtr(name))
        ci = LowFindConst(ctx, VarPtr(name))
        If ci < 0 Then Exit Function
        vals = ctx.constVals
        LowBoundVal = vals[ci]
    ElseIf nodes[idx].kind = AST_BINOP Then
        op = nodes[idx].num
        leftIdx = nodes[idx].left
        rightIdx = nodes[idx].right
        If leftIdx < 0 Or rightIdx < 0 Then Exit Function
        lv = LowBoundVal(ctx, leftIdx)
        If lv < 0 Then Exit Function
        rv = LowBoundVal(ctx, rightIdx)
        If rv < 0 Then Exit Function
        If op = BOP_ADD Then
            LowBoundVal = lv + rv
        ElseIf op = BOP_SUB Then
            LowBoundVal = lv - rv
        ElseIf op = BOP_MUL Then
            LowBoundVal = lv * rv
        ElseIf op = BOP_OR Then
            LowBoundVal = lv Or rv
        ElseIf op = BOP_AND Then
            LowBoundVal = lv And rv
        ElseIf op = BOP_IDIV Then
            If rv <> 0 Then
                LowBoundVal = lv \ rv
            End If
        End If
    End If
End Function

Function LowNewLab(ctx As *LowerCtx) As Long
    Dim id As Long
    id = ctx.nextLab
    ctx.nextLab = id + 1
    LowNewLab = id
End Function

' 既知 kernel32 API 名へ正規化（小文字比較）。成功時 apiOut に正式名を書く
