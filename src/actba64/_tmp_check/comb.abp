End Function

' lea rax, [rip+disp32] - returns offset of disp32 for patching
Function EmitLeaRaxLabRel32(cb As *CodeBuffer) As Long
    EmitByte(cb, &H48)
    EmitByte(cb, &H8D)
    EmitByte(cb, &H05)
