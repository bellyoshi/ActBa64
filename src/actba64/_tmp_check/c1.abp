' Expect: 31
#console
Dim n As Long
n = 0
If Asc(Chr$(65)) = 65 Then
    n = n + 1
End If
If Asc(Right$("Hello", 3)) = 108 Then
    n = n + 2
End If
If RGB(1, 2, 3) = 197121 Then
    n = n + 4
End If
If LOWORD(74565) = 9029 Then
    n = n + 8
End If
If (7 \ 2) = 3 Then
    n = n + 16
End If
ExitProcess(n)
