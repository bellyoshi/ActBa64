' InsMenu lowering (expect 31)
#console
Declare Function MyCreateMenu Lib "user32" Alias "CreateMenu" () As Long
Declare Function MyCreatePopupMenu Lib "user32" Alias "CreatePopupMenu" () As Long
Declare Function MyGetMenuItemCount Lib "user32" Alias "GetMenuItemCount" (h As Long) As Long
Declare Function MyGetMenuItemID Lib "user32" Alias "GetMenuItemID" (h As Long, pos As Long) As Long
Declare Function MyGetSubMenu Lib "user32" Alias "GetSubMenu" (h As Long, pos As Long) As Long

Dim h As Long
Dim hs As Long
Dim n As Long

n = 0
h = MyCreateMenu()
hs = MyCreatePopupMenu()

InsMenu h, 0, 1024, Ex"Help", 100, 0, 0
If MyGetMenuItemCount(h) = 1 Then n = n + 1
If MyGetMenuItemID(h, 0) = 100 Then n = n + 2

InsMenu h, 1, 1024, Ex"Sub", 0, hs, 0
If MyGetMenuItemCount(h) = 2 Then n = n + 4
If MyGetSubMenu(h, 1) = hs Then n = n + 8

InsMenu h, 2, 1024
If MyGetMenuItemCount(h) = 3 Then n = n + 16

ExitProcess(n)
