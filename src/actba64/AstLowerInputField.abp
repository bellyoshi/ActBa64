' AstLowerInputField - Input の複数変数（カンマ区切り）

Const LOW_IN_RESET = 1
Const LOW_IN_EMPTY = 2
Const LOW_IN_HEAD = 3
Const LOW_IN_TAIL = 4

Sub LowStmtInputRead(ctx As *LowerCtx, labIn As Long)
    If labIn < 0 Then Exit Sub
    IrEmit(ctx->list, OP_CALL_LAB, labIn, 0)
End Sub

Sub LowInName(code As Long, dst As *Byte)
    If code = LOW_IN_RESET Then lstrcpy(dst, "InHoldReset")
    If code = LOW_IN_EMPTY Then lstrcpy(dst, "InHoldEmpty")
    If code = LOW_IN_HEAD Then lstrcpy(dst, "InHoldHead$")
    If code = LOW_IN_TAIL Then lstrcpy(dst, "InHoldTail")
End Sub

Sub LowEmitCall0(ctx As *LowerCtx, lab As Long)
    Dim callBytes As Long
    callBytes = LowCallBytes(0)
    If callBytes > 0 Then
        IrEmit(ctx->list, OP_SUB_RSP, callBytes, 0)
    End If
    IrEmit(ctx->list, OP_CALL_LAB, lab, 0)
    LowEmitCallFinish(ctx->list, callBytes)
End Sub

Function LowRequireFunc(ctx As *LowerCtx, name As *Byte) As Long
    LowRequireFunc = LowFindFunc(ctx, name)
    If LowRequireFunc >= 0 Then Exit Function
    Print "error: missing '" + MakeStr(name) + "'"
    ctx->err = 1
End Function

Function LowCallName0(ctx As *LowerCtx, name As *Byte) As Long
    LowCallName0 = LowRequireFunc(ctx, name)
    If LowCallName0 < 0 Then Exit Function
    LowEmitCall0(ctx, LowCallName0)
End Function

Function LowCallIn(ctx As *LowerCtx, code As Long) As Long
    Dim name(SYM_NAME_LEN - 1) As Byte
    LowInName(code, VarPtr(name))
    LowCallIn = LowCallName0(ctx, VarPtr(name))
End Function

Function LowInSetRax(ctx As *LowerCtx) As Long
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim lab As Long
    lstrcpy(VarPtr(name), "InHoldSet")
    lab = LowRequireFunc(ctx, VarPtr(name))
    LowInSetRax = 0
    If lab < 0 Then Exit Function
    LowEmitCall1Rax(ctx->list, 0, 0, 0, lab)
    LowInSetRax = 1
End Function

Function LowEmitHoldGate(ctx As *LowerCtx, labSkip As Long) As Long
    LowEmitHoldGate = LowCallIn(ctx, LOW_IN_EMPTY)
    If LowEmitHoldGate < 0 Then Exit Function
    IrEmit(ctx->list, OP_TEST_EAX, 0, 0)
    IrEmit(ctx->list, OP_JZ, labSkip, 0)
End Function

Function LowEmitFillIfEmpty(ctx As *LowerCtx, labIn As Long, labSkip As Long) As Long
    LowEmitFillIfEmpty = 0
    If LowEmitHoldGate(ctx, labSkip) < 0 Then Exit Function
    IrEmit(ctx->list, OP_CALL_LAB, labIn, 0)
    If LowInSetRax(ctx) = 0 Then Exit Function
    IrEmit(ctx->list, OP_LABEL, labSkip, 0)
    LowEmitFillIfEmpty = 1
End Function

Function LowEmitTakeField(ctx As *LowerCtx) As Long
    LowEmitTakeField = 0
    If LowCallIn(ctx, LOW_IN_HEAD) < 0 Then Exit Function
    IrEmit(ctx->list, OP_PUSH_RAX, 0, 0)
    If LowCallIn(ctx, LOW_IN_TAIL) < 0 Then Exit Function
    IrEmit(ctx->list, OP_POP_RAX, 0, 0)
    LowEmitTakeField = 1
End Function

Function LowInputIsMulti(ctx As *LowerCtx, nVarIdx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    ast = ctx->ast
    nodes = ast->nodes
    LowInputIsMulti = 0
    If nodes[nVarIdx].nxt >= 0 Then LowInputIsMulti = 1
End Function

Function LowInputNext(ctx As *LowerCtx, cur As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    ast = ctx->ast
    nodes = ast->nodes
    LowInputNext = nodes[cur].nxt
End Function

Function LowStmtInputStep(ctx As *LowerCtx, cur As Long, lab As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    LowStmtInputStep = -2
    If Not LowStmtInputOne(ctx, cur, lab) Then Exit Function
    ast = ctx->ast
    nodes = ast->nodes
    LowStmtInputStep = nodes[cur].nxt
End Function

Function LowStmtInputList(ctx As *LowerCtx, cur As Long, lab As Long) As Long
    LowStmtInputList = 1
    If cur < 0 Then Exit Function
    cur = LowStmtInputStep(ctx, cur, lab)
    If cur < -1 Then
        LowStmtInputList = 0
        Exit Function
    End If
    LowStmtInputList = LowStmtInputList(ctx, cur, lab)
End Function

Function LowStmtInputFieldOne(ctx As *LowerCtx, nVarIdx As Long, labIn As Long) As boolean
    Dim labSkip As Long
    LowStmtInputFieldOne = false
    labSkip = LowNewLabel(ctx)
    If LowEmitFillIfEmpty(ctx, labIn, labSkip) = 0 Then Exit Function
    If LowEmitTakeField(ctx) = 0 Then Exit Function
    LowStmtInputFieldOne = LowStmtInputOne(ctx, nVarIdx, -1)
End Function

Function LowStmtInputFieldList(ctx As *LowerCtx, cur As Long, lab As Long) As Long
    LowStmtInputFieldList = 1
    If cur < 0 Then Exit Function
    If Not LowStmtInputFieldOne(ctx, cur, lab) Then
        LowStmtInputFieldList = 0
        Exit Function
    End If
    cur = LowInputNext(ctx, cur)
    LowStmtInputFieldList = LowStmtInputFieldList(ctx, cur, lab)
End Function

Function LowStmtInputFields(ctx As *LowerCtx, nVarIdx As Long, lab As Long) As Long
    LowStmtInputFields = 0
    If LowCallIn(ctx, LOW_IN_RESET) < 0 Then Exit Function
    If LowStmtInputFieldList(ctx, nVarIdx, lab) = 0 Then Exit Function
    If LowCallIn(ctx, LOW_IN_RESET) < 0 Then Exit Function
    LowStmtInputFields = 1
End Function

Function LowInputCount(ctx As *LowerCtx, cur As Long) As Long
    Dim nxt As Long
    LowInputCount = 0
    If cur < 0 Then Exit Function
    nxt = LowInputNext(ctx, cur)
    LowInputCount = LowInputCount(ctx, nxt) + 1
End Function

Function LowEmitStayStr(ctx As *LowerCtx) As boolean
    Dim lab As Long
    lab = LowEnsureRtPrintStay(ctx)
    LowEmitStayStr = false
    If lab < 0 Then Exit Function
    LowEmitCall1Rax(ctx->list, 0, 0, 0, lab)
    LowEmitStayStr = true
End Function

Function LowEmitQBuf(ctx As *LowerCtx) As boolean
    Dim buf(2) As Byte
    buf[0] = 63
    buf[1] = CH_SP
    buf[2] = 0
    LowEmitQBuf = false
    IrEmitStr(ctx->list, OP_LEA_RAX_STR, 0, VarPtr(buf))
    LowEmitQBuf = LowEmitMakeStrRax(ctx)
End Function

' セミコロン区切りのときだけ "? " を出す
Function LowEmitInputMark(ctx As *LowerCtx, semi As Long) As boolean
    LowEmitInputMark = true
    If semi = 0 Then Exit Function
    If Not LowEmitQBuf(ctx) Then
        LowEmitInputMark = false
        Exit Function
    End If
    LowEmitInputMark = LowEmitStayStr(ctx)
End Function

Function LowEmitInputAsk(ctx As *LowerCtx, nPrompt As Long, semi As Long) As boolean
    LowEmitInputAsk = false
    If Not LowStmtInputPrompt(ctx, nPrompt) Then Exit Function
    LowEmitInputAsk = LowEmitInputMark(ctx, semi)
End Function

Function LowEmitRedoText(ctx As *LowerCtx) As boolean
    Dim msg(63) As Byte
    lstrcpy(VarPtr(msg), "入力データの個数が足りません")
    LowEmitRedoText = false
    IrEmitStr(ctx->list, OP_LEA_RAX_STR, 0, VarPtr(msg))
    LowEmitRedoText = LowEmitMakeStrRax(ctx)
End Function

Function LowEmitRedoLine(ctx As *LowerCtx) As boolean
    Dim lab As Long
    LowEmitRedoLine = false
    If Not LowEmitRedoText(ctx) Then Exit Function
    lab = LowEnsureRtPrint(ctx)
    If lab < 0 Then Exit Function
    LowEmitCall1Rax(ctx->list, 0, 0, 0, lab)
    LowEmitRedoLine = true
End Function

Function LowEmitFieldCount(ctx As *LowerCtx) As Long
    Dim name(SYM_NAME_LEN - 1) As Byte
    lstrcpy(VarPtr(name), "InHoldFields")
    LowEmitFieldCount = LowCallName0(ctx, VarPtr(name))
End Function

Sub LowEmitJgeImm(list As *IrList, imm As Long, lab As Long)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, imm, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JGE, lab, 0)
End Sub

Function LowEmitInputShort(ctx As *LowerCtx, nVars As Long, labOk As Long) As Long
    LowEmitInputShort = 0
    If LowEmitFieldCount(ctx) < 0 Then Exit Function
    LowEmitJgeImm(ctx->list, nVars, labOk)
    LowEmitInputShort = 1
End Function

Function LowEmitInputRetry(ctx As *LowerCtx, nVars As Long, labTop As Long, labOk As Long) As Long
    LowEmitInputRetry = 0
    If LowEmitInputShort(ctx, nVars, labOk) = 0 Then Exit Function
    If Not LowEmitRedoLine(ctx) Then Exit Function
    IrEmit(ctx->list, OP_JMP, labTop, 0)
    IrEmit(ctx->list, OP_LABEL, labOk, 0)
    LowEmitInputRetry = 1
End Function

Function LowEmitReadHold(ctx As *LowerCtx, labIn As Long) As Long
    Dim labSkip As Long
    labSkip = LowNewLabel(ctx)
    LowEmitReadHold = LowEmitFillIfEmpty(ctx, labIn, labSkip)
End Function

Function LowEmitInputHead(ctx As *LowerCtx, nPrompt As Long, semi As Long, labIn As Long) As Long
    LowEmitInputHead = 0
    If Not LowEmitInputAsk(ctx, nPrompt, semi) Then Exit Function
    If LowCallIn(ctx, LOW_IN_RESET) < 0 Then Exit Function
    LowEmitInputHead = LowEmitReadHold(ctx, labIn)
End Function

Function LowStmtInputMultiOpen(ctx As *LowerCtx, ByRef labTop As Long, ByRef labOk As Long, ByRef nVars As Long, nVarIdx As Long) As Long
    labTop = LowNewLabel(ctx)
    labOk = LowNewLabel(ctx)
    nVars = LowInputCount(ctx, nVarIdx)
    IrEmit(ctx->list, OP_LABEL, labTop, 0)
    LowStmtInputMultiOpen = 1
End Function

Function LowStmtInputMultiBody(ctx As *LowerCtx, nVarIdx As Long, labIn As Long) As Long
    LowStmtInputMultiBody = 0
    If LowStmtInputFieldList(ctx, nVarIdx, labIn) = 0 Then Exit Function
    If LowCallIn(ctx, LOW_IN_RESET) < 0 Then Exit Function
    LowStmtInputMultiBody = 1
End Function

Function LowStmtInputMulti(ctx As *LowerCtx, nVarIdx As Long, nPrompt As Long, semi As Long, labIn As Long) As Long
    Dim labTop As Long
    Dim labOk As Long
    Dim nVars As Long
    LowStmtInputMulti = 0
    LowStmtInputMultiOpen(ctx, labTop, labOk, nVars, nVarIdx)
    If LowEmitInputHead(ctx, nPrompt, semi, labIn) = 0 Then Exit Function
    If LowEmitInputRetry(ctx, nVars, labTop, labOk) = 0 Then Exit Function
    LowStmtInputMulti = LowStmtInputMultiBody(ctx, nVarIdx, labIn)
End Function

Function LowStmtInputSingle(ctx As *LowerCtx, nVarIdx As Long, lab As Long, nPrompt As Long, semi As Long) As Long
    LowStmtInputSingle = 0
    If Not LowStmtInputPrompt(ctx, nPrompt) Then Exit Function
    If Not LowEmitInputMark(ctx, semi) Then Exit Function
    LowStmtInputSingle = LowStmtInputList(ctx, nVarIdx, lab)
End Function

Function LowStmtInputAll(ctx As *LowerCtx, nVarIdx As Long, lab As Long, nPrompt As Long, semi As Long) As Long
    If LowInputIsMulti(ctx, nVarIdx) = 0 Then
        LowStmtInputAll = LowStmtInputSingle(ctx, nVarIdx, lab, nPrompt, semi)
        Exit Function
    End If
    LowStmtInputAll = LowStmtInputMulti(ctx, nVarIdx, nPrompt, semi, lab)
End Function
