' AstLowerAssign - 代入

Function LowWide32(sz As Long) As Long
    LowWide32 = 0
    If TyIs32() = 0 Then Exit Function
    If sz = 8 Then LowWide32 = 1
End Function

Function LowTyIsDblArr(ty As Long) As Long
    LowTyIsDblArr = 0
    If ty = TY_DOUBLE_ARR Then LowTyIsDblArr = 1
End Function

Function LowSizeIs8(sz As Long) As Long
    LowSizeIs8 = 0
    If sz = 8 Then LowSizeIs8 = 1
End Function

Function LowNameTy(ctx As *LowerCtx, idx As Long) As Long
    Dim vOff As Long, vTy As Long, vTi As Long, vBr As Long, vGl As Long
    Dim name(SYM_NAME_LEN - 1) As Byte
    LowNameTy = -1
    AstCopyStr(ctx->ast, idx, VarPtr(name))
    If Not LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTi), VarPtr(vBr), VarPtr(vGl)) Then Exit Function
    LowNameTy = vTy
End Function

Function LowBaseWide(ctx As *LowerCtx, base As Long) As Long
    LowBaseWide = LowTyIsDblArr(LowNameElemTy(ctx, base))
    If LowNodeKind(ctx, base) = AST_MEMBER Then
        LowBaseWide = LowSizeIs8(LowMemberFieldSize(ctx, base))
        If LowMemberFieldTy(ctx, base) = FIELDTY_PTR_DOUBLE Then LowBaseWide = 1
    End If
End Function

Function LowIndexAssignWide(ctx As *LowerCtx, leftIdx As Long, leftK As Long) As Long
    LowIndexAssignWide = 0
    If TyIs32() = 0 Then Exit Function
    If leftK = AST_CALL Then
        LowIndexAssignWide = LowTyIsDblArr(LowNameTy(ctx, leftIdx))
        Exit Function
    End If
    LowIndexAssignWide = LowBaseWide(ctx, LowNodeLeft(ctx, leftIdx))
End Function

Sub LowPushWide(list As *IrList, wide As Long)
    If wide <> 0 Then
        IrEmit(list, OP_PUSH_DBL, 0, 0)
    Else
        IrEmit(list, OP_PUSH_RAX, 0, 0)
    End If
End Sub

Sub LowPopWide(list As *IrList, wide As Long)
    If wide <> 0 Then
        IrEmit(list, OP_MOV_ECX_EAX, 0, 0)
        IrEmit(list, OP_POP_DBL, 0, 0)
    Else
        IrEmit(list, OP_POP_RCX, 0, 0)
    End If
End Sub

Sub LowStoreArrPtr(list As *IrList, vTy As Long)
    If vTy = TY_DOUBLE_ARR And TyIs32() <> 0 Then
        IrEmit(list, OP_STORE_DBL_MEM, 0, 0)
    Else
        IrEmit(list, OP_STORE_PTR, 0, 0)
    End If
End Sub

Sub LowStoreArrElem(ctx As *LowerCtx, vTy As Long, allowPtrLong As Long)
    If LowIsPtrSlot(vTy) <> 0 Or vTy = TY_DOUBLE_ARR Then
        LowStoreArrPtr(ctx->list, vTy)
    ElseIf vTy = TY_LONG_ARR Or vTy = TY_SINGLE_ARR Then
        LowStoreSized(ctx->list, 4)
    ElseIf vTy = TY_WORD_ARR Then
        LowStoreSized(ctx->list, 2)
    ElseIf allowPtrLong <> 0 And vTy = TY_PTR_LONG Then
        LowStoreSized(ctx->list, 4)
    Else
        IrEmit(ctx->list, OP_STORE_BYTE_RAX_CL, 0, 0)
    End If
End Sub

' a.b(i) = v — メンバ配列／ポインタフィールドへのストア
' 戻り値 true : 正常終了  false : エラーあり
Function LowStoreIndexMember(ctx As *LowerCtx, base As Long) As boolean
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim ast As *Ast
    Dim typeTable As *TypeTable
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim fname(SYM_NAME_LEN - 1) As Byte
    Dim fieldOff As Long
    Dim fieldSize As Long
    Dim fieldCount As Long
    Dim fieldTy As Long
    Dim typeIdx As Long

    LowStoreIndexMember = false
    ast = ctx->ast
    typeTable = ast->types
    AstCopyStr(ast, base, VarPtr(fname))
    ' ネストしたメンバ（h.Raw.GameID[3]）や *T の -> もたどる
    If Not LowResolveMemberField(ctx, base, fieldOff, fieldSize, fieldCount, fieldTy) Then
        ctx->err = 1
        Exit Function
    End If
    If fieldCount > 1 Then
        LowStoreSized(ctx->list, fieldSize)
    ElseIf fieldSize = TyPtrSize() Then
        LowStoreSized(ctx->list, LowPtrFieldElemSize(fieldTy))
    Else
        ctx->err = 1
        Exit Function
    End If
    LowStoreIndexMember = true
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function LowStmtAssignIndexStore(ctx As *LowerCtx, leftIdx As Long, leftK As Long) As boolean
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim base As Long

    LowStmtAssignIndexStore = false
    ast = ctx->ast
    nodes = ast->nodes
    If leftK = AST_CALL Then
        AstCopyStr(ast, leftIdx, VarPtr(name))
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) Then
            LowStoreArrElem(ctx, vTy, 0)
        Else
            IrEmit(ctx->list, OP_STORE_BYTE_RAX_CL, 0, 0)
        End If
    Else
        base = nodes[leftIdx].left
        If nodes[base].kind = AST_MEMBER Then
            If Not LowStoreIndexMember(ctx, base) Then Exit Function
        Else
            AstCopyStr(ast, base, VarPtr(name))
            If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) Then
                LowStoreArrElem(ctx, LowElemTyOf(vTy, vTypeIdx), 1)
            Else
                IrEmit(ctx->list, OP_STORE_BYTE_RAX_CL, 0, 0)
            End If
        End If
    End If
    LowStmtAssignIndexStore = true
End Function

Function LowStmtAssignIndex(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(LOW_STACK_PAD - 1) As Byte
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim leftK As Long
    Dim leftIdx As Long
    Dim base As Long
    Dim wide As Long

    LowStmtAssignIndex = 0
    ast = ctx->ast
    nodes = ast->nodes
    leftIdx = nodes[idx].left
    leftK = nodes[leftIdx].kind
    If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
    If leftK = AST_INDEX Then
        If LowIsStringArrIdx(ctx, leftIdx) <> 0 Then LowCopyCStr(ctx, nodes[idx].right)
    End If
    If leftK = AST_CALL Then
        AstCopyStr(ast, leftIdx, VarPtr(name))
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) Then
            If vTy = TY_SINGLE_ARR Then
                LowEmitCvtToSingleIfNeeded(ctx, nodes[idx].right)
            ElseIf vTy = TY_DOUBLE_ARR Then
                LowEmitCvtToDoubleIfNeeded(ctx, nodes[idx].right)
            End If
        End If
    Else
        ' a[i] = v（*Double の添字や *Double のメンバも含む）は要素の実数の型へ変換する
        If LowIndexFloatTy(ctx, leftIdx) = TY_SINGLE Then LowEmitCvtToSingleIfNeeded(ctx, nodes[idx].right)
        If LowIndexFloatTy(ctx, leftIdx) = TY_DOUBLE Then LowEmitCvtToDoubleIfNeeded(ctx, nodes[idx].right)
    End If
    wide = LowIndexAssignWide(ctx, leftIdx, leftK)
    LowPushWide(ctx->list, wide)
    If LowAddr(ctx, nodes[idx].left) = 0 Then Exit Function
    LowPopWide(ctx->list, wide)
    If Not LowStmtAssignIndexStore(ctx, leftIdx, leftK) Then Exit Function
    LowStmtAssignIndex = 1
End Function

Function LowAssignMemAlt(ctx As *LowerCtx, leftIdx As Long) As Long
    Dim base As Long
    Dim ty As Long
    base = LowNodeLeft(ctx, leftIdx)
    LowAssignMemAlt = 0
    If LowNodeKind(ctx, base) <> AST_VAR Then Exit Function
    ty = LowNameTy(ctx, base)
    If ty < 0 Then Exit Function
    LowAssignMemAlt = LowTyNbytes(ty)
End Function

Function LowAssignMemSize(ctx As *LowerCtx, leftIdx As Long) As Long
    Dim sz As Long
    sz = LowMemberFieldSize(ctx, leftIdx)
    If sz > 0 Then
        LowAssignMemSize = sz
        Exit Function
    End If
    LowAssignMemSize = LowAssignMemAlt(ctx, leftIdx)
End Function

Sub LowBadMember(ctx As *LowerCtx, leftIdx As Long)
    Dim name(SYM_NAME_LEN - 1) As Byte
    AstCopyStr(ctx->ast, leftIdx, VarPtr(name))
    LowPrintErr("error: bad member field '" + MakeStr(VarPtr(name)) + "'")
    ctx->err = 1
End Sub

Function LowAssignRhs(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(LOW_STACK_PAD - 1) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    ast = ctx->ast
    nodes = ast->nodes
    LowAssignRhs = LowExpr(ctx, nodes[idx].right)
End Function

Function LowStoreAtAddr(ctx As *LowerCtx, leftIdx As Long, sz As Long) As Long
    Dim wide As Long
    wide = LowWide32(sz)
    LowPushWide(ctx->list, wide)
    LowStoreAtAddr = 0
    If LowAddr(ctx, leftIdx) = 0 Then Exit Function
    LowPopWide(ctx->list, wide)
    LowStoreSized(ctx->list, sz)
    LowStoreAtAddr = 1
End Function

' メンバの型に合わせて右辺を変換する。整数のメンバへは Long 変数と同じく切り捨て。
Sub LowCvtMem(ctx As *LowerCtx, asg As Long, leftIdx As Long, sz As Long)
    Dim ft As Long
    Dim rhs As Long
    ft = LowMemberFieldTy(ctx, leftIdx)
    rhs = LowNodeRight(ctx, asg)
    If ft = FIELDTY_DOUBLE Then LowEmitCvtToDoubleIfNeeded(ctx, rhs)
    If ft = FIELDTY_SINGLE Then LowEmitCvtToSingleIfNeeded(ctx, rhs)
    If ft = -1 And sz <= 4 Then LowEmitCvtToLongIfNeeded(ctx, rhs, TY_LONG)
End Sub

Function LowAssignMemVal(ctx As *LowerCtx, idx As Long, leftIdx As Long, sz As Long) As Long
    LowAssignMemVal = 0
    If LowAssignRhs(ctx, idx) = 0 Then Exit Function
    LowCvtMem(ctx, idx, leftIdx, sz)
    LowAssignMemVal = LowStoreAtAddr(ctx, leftIdx, sz)
End Function

Function LowAssignMemGo(ctx As *LowerCtx, idx As Long, leftIdx As Long, sz As Long) As Long
    LowAssignMemGo = 0
    If sz <= 0 Then
        LowBadMember(ctx, leftIdx)
        Exit Function
    End If
    LowAssignMemGo = LowAssignMemVal(ctx, idx, leftIdx, sz)
End Function

Function LowStmtAssignMember(ctx As *LowerCtx, idx As Long) As Long
    Dim leftIdx As Long
    leftIdx = LowNodeLeft(ctx, idx)
    LowStmtAssignMember = LowAssignMemGo(ctx, idx, leftIdx, LowAssignMemSize(ctx, leftIdx))
End Function

' ポインタの 4 バイト前にあるヒープ印を見る。rax は戻す。
Sub LowEmitStrTag(list As *IrList)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -4, 0)
    IrEmit(list, OP_LOAD_DWORD_RAX, 0, 0)
    IrEmit(list, OP_MOV_ECX, &H80000000, 0)
    IrEmit(list, OP_AND_EAX_ECX, 0, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_POP_RAX, 0, 0)
End Sub

' ヒープ印があればそのまま。無い C 文字列は MakeStr で複製する。
Sub LowEmitKeepOrCopy(list As *IrList, labMake As Long, labCopy As Long, labDone As Long)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JZ, labCopy, 0)
    LowEmitStrTag(list)
    IrEmit(list, OP_JNZ, labDone, 0)
    IrEmit(list, OP_LABEL, labCopy, 0)
    LowEmitCall1Rax(list, 0, 0, 0, labMake)
    IrEmit(list, OP_LABEL, labDone, 0)
End Sub

' C 文字列を String へ入れるときは長さ付きの複製にする。バッファの再利用で中身が消えない。
Sub LowCopyCStr(ctx As *LowerCtx, rhsIdx As Long)
    Dim lab As Long
    Dim labCopy As Long
    Dim labDone As Long
    If LowExprIsCStr(ctx, rhsIdx) = 0 Then Exit Sub
    lab = LowEnsureRtMakeStr(ctx)
    labCopy = LowNewLabel(ctx)
    labDone = LowNewLabel(ctx)
    LowEmitKeepOrCopy(ctx->list, lab, labCopy, labDone)
End Sub

Function LowStmtAssignVar(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(LOW_STACK_PAD - 1) As Byte
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim folded As Long

    LowStmtAssignVar = 0
    ast = ctx->ast
    nodes = ast->nodes
    AstCopyStr(ast, nodes[idx].left, VarPtr(name))
    If Not LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) Then
        LowerDiagError(ctx, idx, LowUndefMsg$(VarPtr(name)))
        Exit Function
    End If
    LowStrictCheckAssign(ctx, idx, vTy, vTypeIdx, nodes[idx].right)
    LowStrictCheckVal(ctx, idx, vTy)
    folded = 0
    If vTy = TY_SINGLE Then folded = LowEmitSingleF64Lit(ctx, nodes[idx].right)
    If folded = 0 Then
        If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
        If vTy = TY_STRING Then LowCopyCStr(ctx, nodes[idx].right)
        If vTy = TY_SINGLE Then
            LowEmitCvtToSingleIfNeeded(ctx, nodes[idx].right)
        ElseIf vTy = TY_DOUBLE Then
            LowEmitCvtToDoubleIfNeeded(ctx, nodes[idx].right)
        Else
            LowEmitCvtToLongIfNeeded(ctx, nodes[idx].right, vTy)
        End If
    End If
    If LowEmitStoreIfDbl(ctx->list, vOff, vTy, vByRef, vGlob) <> 0 Then
        LowStmtAssignVar = 1
        Exit Function
    End If
    If vByRef <> 0 Then
        IrEmit(ctx->list, OP_PUSH_RAX, 0, 0)
        LowEmitLoadOff(ctx->list, vOff, vGlob)
        IrEmit(ctx->list, OP_POP_RCX, 0, 0)
        ' ByRef の整数は宣言の幅で書く（64bit で Long の隣を壊さない）
        If LowByRefWidth(vTy, vTypeIdx) < 8 Then
            LowStoreSized(ctx->list, LowByRefWidth(vTy, vTypeIdx))
        Else
            IrEmit(ctx->list, OP_STORE_PTR, 0, 0)
        End If
    ElseIf vTy = TY_STRING Then
        LowEmitStoreString(ctx, vOff, vGlob)
    Else
        LowEmitStoreOff(ctx->list, vOff, vGlob)
    End If
    LowStmtAssignVar = 1
End Function

Function LowStmtAssign(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim leftK As Long
    Dim leftIdx As Long

    LowStmtAssign = 0
    ast = ctx->ast
    nodes = ast->nodes
    leftIdx = nodes[idx].left
    leftK = nodes[leftIdx].kind
    If leftK = AST_INDEX Or leftK = AST_CALL Then
        LowStmtAssign = LowStmtAssignIndex(ctx, idx)
    ElseIf leftK = AST_MEMBER Then
        LowStmtAssign = LowStmtAssignMember(ctx, idx)
    ElseIf leftK = AST_VAR Then
        LowStmtAssign = LowStmtAssignVar(ctx, idx)
    Else
        ctx->err = 1
    End If
End Function
