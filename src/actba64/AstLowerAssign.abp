' AstLowerAssign - 代入


' rax = 要素アドレス, rcx = 値。要素型から幅を決めてストア
Sub LowStoreArrElem(ctx As *LowerCtx, vTy As Long, allowPtrLong As Long)
    If vTy = TY_STRING_ARR Or vTy = TY_DOUBLE_ARR Then
        IrEmit(ctx->list, OP_STORE_PTR, 0, 0)
    ElseIf vTy = TY_LONG_ARR Or vTy = TY_SINGLE_ARR Then
        LowStoreSized(ctx->list, 4)
    ElseIf allowPtrLong <> 0 And vTy = TY_PTR_LONG Then
        LowStoreSized(ctx->list, 4)
    Else
        IrEmit(ctx->list, OP_STORE_BYTE_RAX_CL, 0, 0)
    End If
End Sub

' a.b(i) = v — メンバ配列／ポインタフィールドへのストア
Function LowStoreIndexMember(ctx As *LowerCtx, base As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim ast As *Ast
    Dim typeTable As *TypeTable
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim fname(SYM_NAME_LEN - 1) As Byte
    Dim fieldOff As Long
    Dim fieldSize As Long
    Dim fieldCount As Long
    Dim fieldTy As Long
    Dim typeIdx As Long

    LowStoreIndexMember = 0
    ast = ctx->ast
    typeTable = ast->types
    AstCopyStr(ast, base, VarPtr(fname))
    If LowMemberBaseName(ctx, base, VarPtr(name)) = 0 Then
        ctx->err = 1
        Exit Function
    End If
    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
        ctx->err = 1
        Exit Function
    End If
    typeIdx = vTypeIdx
    If TyFindFieldEx(typeTable, typeIdx, VarPtr(fname), fieldOff, fieldSize, fieldCount, fieldTy) = 0 Then
        ctx->err = 1
        Exit Function
    End If
    If fieldCount > 1 Then
        LowStoreSized(ctx->list, fieldSize)
    ElseIf fieldSize = TyPtrSize() Then
        LowStoreSized(ctx->list, LowPtrFieldElemSize(fieldTy))
    Else
        ctx->err = 1
        Exit Function
    End If
    LowStoreIndexMember = 1
End Function

Function LowStmtAssignIndexStore(ctx As *LowerCtx, leftIdx As Long, leftK As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim base As Long

    LowStmtAssignIndexStore = 0
    ast = ctx->ast
    nodes = ast->nodes
    If leftK = AST_CALL Then
        AstCopyStr(ast, leftIdx, VarPtr(name))
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
            LowStoreArrElem(ctx, vTy, 0)
        Else
            IrEmit(ctx->list, OP_STORE_BYTE_RAX_CL, 0, 0)
        End If
    Else
        base = nodes[leftIdx].left
        If nodes[base].kind = AST_MEMBER Then
            If LowStoreIndexMember(ctx, base) = 0 Then Exit Function
        Else
            AstCopyStr(ast, base, VarPtr(name))
            If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
                LowStoreArrElem(ctx, vTy, 1)
            Else
                IrEmit(ctx->list, OP_STORE_BYTE_RAX_CL, 0, 0)
            End If
        End If
    End If
    LowStmtAssignIndexStore = 1
End Function

Function LowStmtAssignIndex(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(LOW_STACK_PAD - 1) As Byte
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim leftK As Long
    Dim leftIdx As Long
    Dim base As Long

    LowStmtAssignIndex = 0
    ast = ctx->ast
    nodes = ast->nodes
    leftIdx = nodes[idx].left
    leftK = nodes[leftIdx].kind
    If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
    If leftK = AST_CALL Then
        AstCopyStr(ast, leftIdx, VarPtr(name))
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
            If vTy = TY_SINGLE_ARR Then
                LowEmitCvtToSingleIfNeeded(ctx, nodes[idx].right)
            ElseIf vTy = TY_DOUBLE_ARR Then
                LowEmitCvtToDoubleIfNeeded(ctx, nodes[idx].right)
            End If
        End If
    Else
        base = nodes[leftIdx].left
        If nodes[base].kind = AST_VAR Then
            AstCopyStr(ast, base, VarPtr(name))
            If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
                If vTy = TY_SINGLE_ARR Then
                    LowEmitCvtToSingleIfNeeded(ctx, nodes[idx].right)
                ElseIf vTy = TY_DOUBLE_ARR Then
                    LowEmitCvtToDoubleIfNeeded(ctx, nodes[idx].right)
                End If
            End If
        End If
    End If
    IrEmit(ctx->list, OP_PUSH_RAX, 0, 0)
    If LowAddr(ctx, nodes[idx].left) = 0 Then Exit Function
    IrEmit(ctx->list, OP_POP_RCX, 0, 0)
    If LowStmtAssignIndexStore(ctx, leftIdx, leftK) = 0 Then Exit Function
    LowStmtAssignIndex = 1
End Function

Function LowStmtAssignMember(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(LOW_STACK_PAD - 1) As Byte
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim leftIdx As Long
    Dim fieldSize As Long
    Dim base As Long

    LowStmtAssignMember = 0
    ast = ctx->ast
    nodes = ast->nodes
    leftIdx = nodes[idx].left
    If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
    IrEmit(ctx->list, OP_PUSH_RAX, 0, 0)
    If LowAddr(ctx, nodes[idx].left) = 0 Then Exit Function
    IrEmit(ctx->list, OP_POP_RCX, 0, 0)
    fieldSize = LowMemberFieldSize(ctx, leftIdx)
    If fieldSize <= 0 Then
        AstCopyStr(ast, leftIdx, VarPtr(name))
        base = nodes[leftIdx].left
        If nodes[base].kind = AST_VAR Then
            AstCopyStr(ast, base, VarPtr(name))
            If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
                fieldSize = LowTyNbytes(vTy)
            End If
        End If
    End If
    If fieldSize <= 0 Then
        AstCopyStr(ast, leftIdx, VarPtr(name))
        Print "error: bad member field '" + MakeStr(VarPtr(name)) + "'"
        ctx->err = 1
        Exit Function
    End If
    LowStoreSized(ctx->list, fieldSize)
    LowStmtAssignMember = 1
End Function

Function LowStmtAssignVar(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(LOW_STACK_PAD - 1) As Byte
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim folded As Long

    LowStmtAssignVar = 0
    ast = ctx->ast
    nodes = ast->nodes
    AstCopyStr(ast, nodes[idx].left, VarPtr(name))
    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
        LowerDiagError(ctx, idx, "assign to undefined '" + MakeStr(VarPtr(name)) + "'")
        Exit Function
    End If
    LowStrictCheckAssign(ctx, idx, vTy, vTypeIdx, nodes[idx].right)
    folded = 0
    If vTy = TY_SINGLE Then folded = LowEmitSingleF64Lit(ctx, nodes[idx].right)
    If folded = 0 Then
        If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
        If vTy = TY_SINGLE Then
            LowEmitCvtToSingleIfNeeded(ctx, nodes[idx].right)
        ElseIf vTy = TY_DOUBLE Then
            LowEmitCvtToDoubleIfNeeded(ctx, nodes[idx].right)
        Else
            LowEmitCvtToLongIfNeeded(ctx, nodes[idx].right, vTy)
        End If
    End If
    If vByRef <> 0 Then
        IrEmit(ctx->list, OP_PUSH_RAX, 0, 0)
        LowEmitLoadOff(ctx->list, vOff, vGlob)
        IrEmit(ctx->list, OP_POP_RCX, 0, 0)
        IrEmit(ctx->list, OP_STORE_PTR, 0, 0)
    ElseIf vTy = TY_STRING Then
        LowEmitStoreString(ctx, vOff, vGlob)
    Else
        LowEmitStoreOff(ctx->list, vOff, vGlob)
    End If
    LowStmtAssignVar = 1
End Function

Function LowStmtAssign(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim leftK As Long
    Dim leftIdx As Long

    LowStmtAssign = 0
    ast = ctx->ast
    nodes = ast->nodes
    leftIdx = nodes[idx].left
    leftK = nodes[leftIdx].kind
    If leftK = AST_INDEX Or leftK = AST_CALL Then
        LowStmtAssign = LowStmtAssignIndex(ctx, idx)
    ElseIf leftK = AST_MEMBER Then
        LowStmtAssign = LowStmtAssignMember(ctx, idx)
    ElseIf leftK = AST_VAR Then
        LowStmtAssign = LowStmtAssignVar(ctx, idx)
    Else
        ctx->err = 1
    End If
End Function
