' ParserDeclare - Declare と InsertMenu

' Declare Function|Sub Name Lib "dll" [Alias "api"] (params) [As Type]
' 戻り値 true : 正常終了  false : エラーあり
Function ParseDeclareHdr(p As *Parser, name As *Byte, libName As *Byte, apiName As *Byte, ByRef isSub As Long) As boolean
    Dim kw(KW_LEN - 1) As Byte

    ParseDeclareHdr = false
    isSub = 0
    lstrcpy(VarPtr(kw), "function")
    If ParseIdentIs(p, VarPtr(kw)) <> 0 Then
        p->pos = p->pos + 1
    Else
        lstrcpy(VarPtr(kw), "sub")
        If ParseIdentIs(p, VarPtr(kw)) <> 0 Then
            p->pos = p->pos + 1
            isSub = 1
        Else
            p->err = 1
            Exit Function
        End If
    End If
    If Not ParseCopyIdent(p, name) Then Exit Function
    lstrcpy(VarPtr(kw), "lib")
    If ParseIdentIs(p, VarPtr(kw)) = 0 Then
        p->err = 1
        Exit Function
    End If
    p->pos = p->pos + 1
    If Not ParseStringArg(p, libName) Then Exit Function
    lstrcpy(VarPtr(kw), "alias")
    If ParseIdentIs(p, VarPtr(kw)) <> 0 Then
        p->pos = p->pos + 1
        If Not ParseStringArg(p, apiName) Then Exit Function
    Else
        lstrcpy(apiName, name)
    End If
    If Not ParseExpect(p, TK_LPAREN) Then Exit Function
    ParseDeclareHdr = true
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function ParseDeclareRetSkip(p As *Parser) As boolean
    Dim kw(KW_LEN - 1) As Byte
    Dim typeName(SYM_NAME_LEN - 1) As Byte

    ParseDeclareRetSkip = false
    lstrcpy(VarPtr(kw), "as")
    If ParseIdentIs(p, VarPtr(kw)) = 0 Then
        ParseDeclareRetSkip = true
        Exit Function
    End If
    p->pos = p->pos + 1
    lstrcpy(VarPtr(kw), "long")
    If ParseIdentIs(p, VarPtr(kw)) <> 0 Then
        p->pos = p->pos + 1
        ParseDeclareRetSkip = true
        Exit Function
    End If
    lstrcpy(VarPtr(kw), "string")
    If ParseIdentIs(p, VarPtr(kw)) <> 0 Then
        p->pos = p->pos + 1
        ParseDeclareRetSkip = true
        Exit Function
    End If
    If ParseTokKind(p) = TK_STAR Then
        p->pos = p->pos + 1
        If ParseTokKind(p) = TK_STAR Then
            p->pos = p->pos + 1
        End If
        lstrcpy(VarPtr(kw), "byte")
        If ParseIdentIs(p, VarPtr(kw)) <> 0 Then
            p->pos = p->pos + 1
        Else
            If Not ParseCopyIdent(p, VarPtr(typeName)) Then Exit Function
        End If
        ParseDeclareRetSkip = true
        Exit Function
    End If
    lstrcpy(VarPtr(typeName), "double")
    If ParseIdentIs(p, VarPtr(typeName)) <> 0 Then
        p->pos = p->pos + 1
        ParseDeclareRetSkip = true
        Exit Function
    End If
    If ParseEatLongAlias(p) Then
        ParseDeclareRetSkip = true
        Exit Function
    End If
    If Not ParseCopyIdent(p, VarPtr(typeName)) Then Exit Function
    ParseDeclareRetSkip = true
End Function

Function ParseDeclareStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nDecl As Long
    Dim nDll As Long
    Dim nApi As Long
    Dim nFirst As Long
    Dim nParams As Long
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim libName(SYM_NAME_LEN - 1) As Byte
    Dim apiName(SYM_NAME_LEN - 1) As Byte
    Dim isSub As Long

    ParseDeclareStmt = -1
    p->pos = p->pos + 1
    ast = p->ast
    If Not ParseDeclareHdr(p, VarPtr(name), VarPtr(libName), VarPtr(apiName), isSub) Then Exit Function
    If Not ParseParamList(p, nFirst, nParams, 1, 1) Then Exit Function
    If isSub = 0 Then
        If Not ParseDeclareRetSkip(p) Then Exit Function
    End If
    nDll = AstAddNode(ast, AST_STRING)
    If nDll < 0 Then Exit Function
    AstSetStr(ast, nDll, VarPtr(libName))
    nApi = AstAddNode(ast, AST_STRING)
    If nApi < 0 Then Exit Function
    AstSetStr(ast, nApi, VarPtr(apiName))
    nDecl = AstAddNode(ast, AST_DECLARE)
    If nDecl < 0 Then Exit Function
    AstSetStr(ast, nDecl, VarPtr(name))
    nodes = ast->nodes
    nodes[nDecl].left = nFirst
    nodes[nDecl].right = nDll
    nodes[nDecl].extra = nApi
    nodes[nDecl].num = nParams
    ParseDeclareStmt = nDecl
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function ParseInsMenuArg(p As *Parser, ast As *Ast, ByRef nFirst As Long, ByRef nPrev As Long, ByRef nArgs As Long) As boolean
    Dim nodes As *AstNode
    Dim nArg As Long
    Dim e As Long
    Dim kEx(KW_SHORT_LEN - 1) As Byte
    Dim s(TEXT_LEN - 1) As Byte

    ParseInsMenuArg = false
    e = -1
    lstrcpy(VarPtr(kEx), "ex")
    If ParseIdentIs(p, VarPtr(kEx)) <> 0 Then
        If ParseTokKindAt(p, p->pos + 1) = TK_STRING Then
            p->pos = p->pos + 1
            If Not ParseStringArg(p, VarPtr(s)) Then Exit Function
            e = AstAddNode(ast, AST_STRING)
            If e < 0 Then Exit Function
            AstSetStr(ast, e, VarPtr(s))
        End If
    End If
    If e < 0 Then
        e = ParseExpr(p)
        If e < 0 Then Exit Function
    End If
    nArg = AstAddNode(ast, AST_ARG)
    If nArg < 0 Then Exit Function
    nodes = ast->nodes
    nodes[nArg].left = e
    If nFirst < 0 Then
        nFirst = nArg
    Else
        nodes[nPrev].nxt = nArg
    End If
    nPrev = nArg
    nArgs = nArgs + 1
    ParseInsMenuArg = true
End Function

' InsMenu hMenu, pos, flags [, caption [, id [, hSubMenu [, ignored]]]]
Function ParseInsMenuStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nIns As Long
    Dim nFirst As Long
    Dim nPrev As Long
    Dim nArgs As Long

    ParseInsMenuStmt = -1
    p->pos = p->pos + 1
    ast = p->ast
    nFirst = -1
    nPrev = -1
    nArgs = 0
    Do
        If Not ParseInsMenuArg(p, ast, nFirst, nPrev, nArgs) Then Exit Function
        If ParseTokKind(p) <> TK_COMMA Then Exit Do
        p->pos = p->pos + 1
    Loop
    If nArgs < 3 Then
        p->err = 1
        Exit Function
    End If
    nIns = AstAddNode(ast, AST_INSMENU)
    If nIns < 0 Then Exit Function
    nodes = ast->nodes
    nodes[nIns].left = nFirst
    nodes[nIns].num = nArgs
    ParseInsMenuStmt = nIns
End Function
