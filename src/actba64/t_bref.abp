#console
Declare Function ExitProcess Lib "kernel32.dll" (uExitCode As Long) As Long
Declare Function calloc Lib "msvcrt.dll" (n As Long) As *Byte
Function SetPtr(ByRef p As *Byte, v As *Byte) As Long
    p = v
    SetPtr = 1
End Function
Function SetLong(ByRef n As Long, v As Long) As Long
    n = v
    SetLong = 1
End Function
Sub Main()
    Dim p As *Byte
    Dim n As Long
    Dim q As *Byte
    p = NULL
    n = 0
    q = calloc(4)
    q[0] = 66
    If SetLong(n, 7) = 0 Then ExitProcess(1)
    If n <> 7 Then ExitProcess(2)
    If SetPtr(p, q) = 0 Then ExitProcess(3)
    If p = NULL Then ExitProcess(4)
    If p[0] <> 66 Then ExitProcess(5)
    ExitProcess(42)
End Sub
Main()
End
