' AST_DO.extra: Do / Loop 条件の位置
Const DO_PLAIN = 0
Const DO_WHILE_TOP = 1
Const DO_UNTIL_TOP = 2
Const DO_WHILE_BOTTOM = 3
Const DO_UNTIL_BOTTOM = 4

' Binop / compare ops (stored in AstNode.num for AST_BINOP)
Const BOP_ADD = 1
Const BOP_MUL = 2
