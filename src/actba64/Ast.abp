Const UOP_NEG = 1
Const UOP_NOT = 2

' Builtin kind (AstNode.num for AST_BUILTIN)
Const BI_LEN = 1
Const BI_ASC = 2
Const BI_LEFT = 3
Const BI_MID = 4
Const BI_VARPTR = 5
Const BI_SIZEOF = 6
Const BI_ADDRESSOF = 7
Const BI_MALLOC = 8
Const BI_FREE = 9
Const BI_STRPTR = 10
Const BI_STR = 11
Const BI_MEMCPY = 12
