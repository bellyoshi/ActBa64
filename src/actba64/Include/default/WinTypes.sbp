' WinTypes.sbp - Win32 構造体（PE32+ ポインタサイズ）

Type SECURITY_ATTRIBUTES
    nLength As DWord
    lpSecurityDescriptor As VoidPtr
    bInheritHandle As Long
End Type

Type PROCESS_INFORMATION
    hProcess As HANDLE
    hThread As HANDLE
    dwProcessId As DWord
    dwThreadId As DWord
End Type

Type STARTUPINFO
    cb As DWord
    lpReserved As VoidPtr
    lpDesktop As VoidPtr
    lpTitle As VoidPtr
    dwX As DWord
    dwY As DWord
    dwXSize As DWord
    dwYSize As DWord
    dwXCountChars As DWord
    dwYCountChars As DWord
    dwFillAttribute As DWord
    dwFlags As DWord
    wShowWindow As Word
    cbReserved2 As Word
    lpReserved2 As VoidPtr
    hStdInput As HANDLE
    hStdOutput As HANDLE
    hStdError As HANDLE
End Type

Type POINTAPI
    x As Long
    y As Long
End Type

Type RECT
    left As Long
    top As Long
    right As Long
    bottom As Long
End Type

Type SIZE
    cx As Long
    cy As Long
End Type

Type MSG
    hwnd As HWND
    message As DWord
    wParam As WPARAM
    lParam As LPARAM
    time As DWord
    pt As POINTAPI
End Type

Type WNDCLASSEX
    cbSize As DWord
    style As DWord
    lpfnWndProc As VoidPtr
    cbClsExtra As Long
    cbWndExtra As Long
    hInstance As HINSTANCE
    hIcon As HICON
    hCursor As HCURSOR
    hbrBackground As HBRUSH
    lpszMenuName As BytePtr
    lpszClassName As BytePtr
    hIconSm As HICON
End Type

Type PAINTSTRUCT
    hdc As HDC
    fErase As Long
    rcPaint As RECT
    fRestore As Long
    fIncUpdate As Long
    rgbReserved(31) As Byte
End Type

Type OPENFILENAME
    lStructSize As DWord
    hwndOwner As HWND
    hInstance As HINSTANCE
    lpstrFilter As VoidPtr
    lpstrCustomFilter As VoidPtr
    nMaxCustFilter As DWord
    nFilterIndex As DWord
    lpstrFile As VoidPtr
    nMaxFile As DWord
    lpstrFileTitle As VoidPtr
    nMaxFileTitle As DWord
    lpstrInitialDir As VoidPtr
    lpstrTitle As VoidPtr
    Flags As DWord
    nFileOffset As Word
    nFileExtension As Word
    lpstrDefExt As VoidPtr
    lCustData As LPARAM
    lpfnHook As VoidPtr
    lpTemplateName As VoidPtr
End Type

Type CREATESTRUCT
    lpCreateParams As VoidPtr
    hInstance As HINSTANCE
    hMenu As HMENU
    hwndParent As HWND
    cy As Long
    cx As Long
    y As Long
    x As Long
    style As Long
    lpszName As LPCSTR
    lpszClass As LPCSTR
    dwExStyle As DWord
End Type
