#console
Declare Function ExitProcess Lib "kernel32.dll" (uExitCode As Long) As Long
Declare Function calloc Lib "msvcrt.dll" (n As Long) As *Byte
Declare Sub free Lib "msvcrt.dll" (p As *Byte)
Const IR_MAX_OPS = 262144
Const IR_STR_LEN = 256
Const AST_MAX_NODES = 131072
Const LEX_MAX_TOKS = 131072
Function BytesN(n As Long, elem As Long) As Long
    Dim r As Long
    r = n
    r = r * elem
    BytesN = r
End Function
Sub Main()
    Dim p As *Byte
    Dim n As Long
    n = BytesN(IR_MAX_OPS, 16)
    If n <> 4194304 Then ExitProcess(1)
    n = BytesN(IR_MAX_OPS, IR_STR_LEN)
    If n <> 67108864 Then ExitProcess(2)
    p = calloc(n)
    If p = NULL Then ExitProcess(3)
    free(p)
    n = BytesN(AST_MAX_NODES, 32)
    ' just ensure non-zero
    If n < 1000 Then ExitProcess(4)
    ExitProcess(42)
End Sub
Main()
End
