' StringBuffer.abp - 可変長バイトバッファ（クラスなし）
' 巨大な String 連結の O(n^2) を避けるため、末尾追記 + 倍増確保
' 注: abc は base->field[i] 未対応のため、添字は一時 *Byte 経由

Const SB_INIT_CAP = 4096

Type StringBuffer
    p As *Byte
    len As Long
    cap As Long
End Type

Sub SbInit(sb As *StringBuffer)
    sb->p = 0
    sb->len = 0
    sb->cap = 0
End Sub

Sub SbFree(sb As *StringBuffer)
    Dim p As *Byte
    p = sb->p
    If p <> 0 Then
        free(p)
    End If
    sb->p = 0
    sb->len = 0
    sb->cap = 0
End Sub

Sub SbClear(sb As *StringBuffer)
    Dim p As *Byte
    sb->len = 0
    p = sb->p
    If p <> 0 Then
        p[0] = 0
    End If
End Sub

Function SbEnsure(sb As *StringBuffer, need As Long) As Long
    Dim np As *Byte
    Dim ncap As Long
    Dim op As *Byte
    Dim n As Long
    SbEnsure = 0
    If need <= sb->cap Then
        SbEnsure = 1
        Exit Function
    End If
    ncap = sb->cap
    If ncap <= 0 Then ncap = SB_INIT_CAP
    While ncap < need
        ncap = ncap * 2
    Wend
    np = malloc(ncap)
    If np = 0 Then
        Print "StringBuffer: out of memory"
        Exit Function
    End If
    n = sb->len
    op = sb->p
    If n > 0 And op <> 0 Then
        memcpy(np, op, n)
    End If
    If op <> 0 Then
        free(op)
    End If
    sb->p = np
    sb->cap = ncap
    SbEnsure = 1
End Function

Sub SbAppendBytes(sb As *StringBuffer, src As *Byte, n As Long)
    Dim p As *Byte
    Dim off As Long
    If n <= 0 Then Exit Sub
    If SbEnsure(sb, sb->len + n + 1) = 0 Then
        ExitProcess(1)
    End If
    p = sb->p
    off = sb->len
    memcpy(VarPtr(p[off]), src, n)
    off = off + n
    sb->len = off
    p[off] = 0
End Sub

Sub SbAppendStr(sb As *StringBuffer, s As String)
    Dim n As Long
    n = Len(s)
    If n <= 0 Then Exit Sub
    SbAppendBytes(sb, StrPtr(s), n)
End Sub

Sub SbAppendCRLF(sb As *StringBuffer)
    Dim crlf[2] As Byte
    crlf[0] = CH_CR
    crlf[1] = CH_NL
    SbAppendBytes(sb, crlf, 2)
End Sub

Sub SbAppendSb(dst As *StringBuffer, src As *StringBuffer)
    Dim sp As *Byte
    Dim n As Long
    n = src->len
    If n <= 0 Then Exit Sub
    sp = src->p
    SbAppendBytes(dst, sp, n)
End Sub

Sub SbAppendByte(sb As *StringBuffer, b As Long)
    Dim p As *Byte
    Dim off As Long
    If SbEnsure(sb, sb->len + 2) = 0 Then
        ExitProcess(1)
    End If
    p = sb->p
    off = sb->len
    p[off] = b And &HFF
    off = off + 1
    sb->len = off
    p[off] = 0
End Sub

' 十進即値を追記（負数・&H80000000 対応）
' 注意: AB420 の / と Mod は大きな Long で精度が崩れる（例: &H40000000 → 1073741764）。
' 整数除算 \ と余りの引き算だけを使う。
Sub SbAppendDec(sb As *StringBuffer, v As Long)
    Dim n As Long
    Dim d As Long
    Dim q As Long
    Dim buf[16] As Byte
    Dim i As Long
    ' Long 最小値は符号反転不可 → 即値は hex で出す
    If v = &H80000000 Then
        SbAppendStr(sb, "0x80000000")
        Exit Sub
    End If
    If v < 0 Then
        SbAppendByte(sb, CH_MINUS)
        v = 0 - v
    End If
    If v = 0 Then
        SbAppendByte(sb, CH_0)
        Exit Sub
    End If
    n = v
    i = 0
    While n > 0
        q = n \ 10
        d = n - q * 10
        buf[i] = CH_0 + d
        i = i + 1
        n = q
    Wend
    While i > 0
        i = i - 1
        SbAppendByte(sb, buf[i])
    Wend
End Sub

Sub SbAppendZeros(sb As *StringBuffer, n As Long)
    Dim p As *Byte
    Dim off As Long
    If n <= 0 Then Exit Sub
    If SbEnsure(sb, sb->len + n + 1) = 0 Then
        ExitProcess(1)
    End If
    p = sb->p
    off = sb->len
    ZeroMem(VarPtr(p[off]), n)
    off = off + n
    sb->len = off
    p[off] = 0
End Sub

' dst を解放し、src の所有権を移す（src は空になる）
Sub SbMove(dst As *StringBuffer, src As *StringBuffer)
    Dim p As *Byte
    p = dst->p
    If p <> 0 Then
        free(p)
    End If
    dst->p = src->p
    dst->len = src->len
    dst->cap = src->cap
    src->p = 0
    src->len = 0
    src->cap = 0
End Sub

Function SbLen(sb As *StringBuffer) As Long
    SbLen = sb->len
End Function

Function SbData(sb As *StringBuffer) As *Byte
    SbData = sb->p
End Function

Function SbIsEmpty(sb As *StringBuffer) As Long
    If sb->len <= 0 Then
        SbIsEmpty = 1
    Else
        SbIsEmpty = 0
    End If
End Function

Function SbToString$(sb As *StringBuffer) As String
    Dim p As *Byte
    Dim n As Long
    p = sb->p
    n = sb->len
    If p = 0 Or n <= 0 Then
        SbToString$ = ""
    Else
        p[n] = 0
        SbToString$ = MakeStr(p)
    End If
End Function
