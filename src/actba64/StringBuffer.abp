' StringBuffer.abp - 可変長バイトバッファ（Class）
' 巨大な String 連結の O(n^2) を避けるため、末尾追記 + 倍増確保
' 注: メンバ名は len / p を避け、組込 Len() や局所 *Byte と衝突しないようにする

Const SB_INIT_CAP = 4096

Class StringBuffer
    Public
    buf As *Byte
    nLen As Long
    nCap As Long

    Sub StringBuffer()
        buf = 0
        nLen = 0
        nCap = 0
    End Sub

    Sub ~StringBuffer()
        Me->Free()
    End Sub

    Sub Free()
        Dim bp As *Byte
        bp = buf
        If bp <> 0 Then
            free(bp)
        End If
        buf = 0
        nLen = 0
        nCap = 0
    End Sub

    Sub Clear()
        Dim bp As *Byte
        nLen = 0
        bp = buf
        If bp <> 0 Then
            bp[0] = 0
        End If
    End Sub

    Function Ensure(need As Long) As Long
        Dim np As *Byte
        Dim ncap As Long
        Dim op As *Byte
        Dim n As Long
        Ensure = 0
        If need <= nCap Then
            Ensure = 1
            Exit Function
        End If
        ncap = nCap
        If ncap <= 0 Then ncap = SB_INIT_CAP
        While ncap < need
            ncap = ncap * 2
        Wend
        np = malloc(ncap)
        If np = 0 Then
            Print "StringBuffer: out of memory"
            Exit Function
        End If
        n = nLen
        op = buf
        If n > 0 And op <> 0 Then
            memcpy(np, op, n)
        End If
        If op <> 0 Then
            free(op)
        End If
        buf = np
        nCap = ncap
        Ensure = 1
    End Function

    Sub AppendBytes(src As *Byte, n As Long)
        Dim bp As *Byte
        Dim off As Long
        If n <= 0 Then Exit Sub
        If Me->Ensure(nLen + n + 1) = 0 Then
            ExitProcess(1)
        End If
        bp = buf
        off = nLen
        memcpy(VarPtr(bp[off]), src, n)
        off = off + n
        nLen = off
        bp[off] = 0
    End Sub

    Sub AppendStr(s As String)
        Dim n As Long
        n = Len(s)
        If n <= 0 Then Exit Sub
        Me->AppendBytes(StrPtr(s), n)
    End Sub

    Sub AppendCRLF()
        Dim crlf[2] As Byte
        crlf[0] = CH_CR
        crlf[1] = CH_NL
        Me->AppendBytes(crlf, 2)
    End Sub

    Sub AppendSb(src As *StringBuffer)
        Dim sp As *Byte
        Dim n As Long
        n = src->nLen
        If n <= 0 Then Exit Sub
        sp = src->buf
        Me->AppendBytes(sp, n)
    End Sub

    Sub AppendByte(b As Long)
        Dim bp As *Byte
        Dim off As Long
        If Me->Ensure(nLen + 2) = 0 Then
            ExitProcess(1)
        End If
        bp = buf
        off = nLen
        bp[off] = b And &HFF
        off = off + 1
        nLen = off
        bp[off] = 0
    End Sub

    ' 十進即値を追記（負数・&H80000000 対応）
    ' 注意: AB420 の / と Mod は大きな Long で精度が崩れる（例: &H40000000 → 1073741764）。
    ' 整数除算 \ と余りの引き算だけを使う。
    Sub AppendDec(v As Long)
        Dim n As Long
        Dim d As Long
        Dim q As Long
        Dim dbuf[16] As Byte
        Dim i As Long
        If v = &H80000000 Then
            Me->AppendStr("0x80000000")
            Exit Sub
        End If
        If v < 0 Then
            Me->AppendByte(CH_MINUS)
            v = 0 - v
        End If
        If v = 0 Then
            Me->AppendByte(CH_0)
            Exit Sub
        End If
        n = v
        i = 0
        While n > 0
            q = n \ 10
            d = n - q * 10
            dbuf[i] = CH_0 + d
            i = i + 1
            n = q
        Wend
        While i > 0
            i = i - 1
            Me->AppendByte(dbuf[i])
        Wend
    End Sub

    Sub AppendZeros(n As Long)
        Dim bp As *Byte
        Dim off As Long
        If n <= 0 Then Exit Sub
        If Me->Ensure(nLen + n + 1) = 0 Then
            ExitProcess(1)
        End If
        bp = buf
        off = nLen
        ZeroMem(VarPtr(bp[off]), n)
        off = off + n
        nLen = off
        bp[off] = 0
    End Sub

    ' 自分を解放し、src の所有権を移す（src は空になる）
    Sub MoveFrom(src As *StringBuffer)
        Me->Free()
        buf = src->buf
        nLen = src->nLen
        nCap = src->nCap
        src->buf = 0
        src->nLen = 0
        src->nCap = 0
    End Sub

    Function GetLen() As Long
        GetLen = nLen
    End Function

    Function IsEmpty() As Long
        If nLen <= 0 Then
            IsEmpty = 1
        Else
            IsEmpty = 0
        End If
    End Function

    Function ToStr$() As String
        Dim bp As *Byte
        Dim n As Long
        bp = buf
        n = nLen
        If bp = 0 Or n <= 0 Then
            ToStr$ = ""
        Else
            bp[n] = 0
            ToStr$ = MakeStr(bp)
        End If
    End Function
End Class
