' AstLowerField - フィールドサイズと幅付きロード

Function LowTyNbytes(typeKind As Long) As Long
    If typeKind = TY_BYTE Then
        LowTyNbytes = 1
    ElseIf typeKind = TY_DOUBLE Then
        LowTyNbytes = 8
    ElseIf typeKind = TY_SINGLE Then
        LowTyNbytes = 4
    ElseIf typeKind = TY_STRING Then
        LowTyNbytes = TyPtrSize()
    ElseIf typeKind = TY_PTR_BYTE Or typeKind = TY_PTR_LONG Or typeKind = TY_PTR_UDT Then
        LowTyNbytes = TyPtrSize()
    Else
        LowTyNbytes = 4
    End If
End Function

Function LowPtrFieldElemSize(fieldTy As Long) As Long
    If fieldTy = FIELDTY_PTR_LONG Then
        LowPtrFieldElemSize = 4
    Else
        LowPtrFieldElemSize = 1
    End If
End Function

Sub LowLoadSized(list As *IrList, sz As Long)
    If sz = 1 Then
        IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
    ElseIf sz = 2 Then
        IrEmit(list, OP_LOADZX_WORD_RAX, 0, 0)
    ElseIf sz = 4 Then
        IrEmit(list, OP_LOAD_DWORD_RAX, 0, 0)
    ElseIf sz = 8 Then
        IrEmit(list, OP_LOAD_QWORD_RAX, 0, 0)
    Else
        IrEmit(list, OP_LOAD_DWORD_RAX, 0, 0)
    End If
End Sub

Sub LowStoreSized(list As *IrList, sz As Long)
    If sz = 1 Then
        IrEmit(list, OP_STORE_BYTE_RAX_CL, 0, 0)
    ElseIf sz = 2 Then
        IrEmit(list, OP_STORE_WORD_RAX_CX, 0, 0)
    ElseIf sz = 4 Then
        IrEmit(list, OP_STORE_DWORD_RAX_ECX, 0, 0)
    ElseIf sz = 8 Then
        IrEmit(list, OP_STORE_QWORD_RAX_RCX, 0, 0)
    Else
        IrEmit(list, OP_STORE_DWORD_RAX_ECX, 0, 0)
    End If
End Sub

' AST_MEMBER のフィールド解決（ネスト / INDEX 基底対応）。成功時 1。
Function LowResolveMemberField(ctx As *LowerCtx, idx As Long, ByRef fieldOff As Long, ByRef fieldSize As Long, ByRef fieldCount As Long, ByRef fieldTy As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim typeTable As *TypeTable
    Dim base As Long
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim fname(SYM_NAME_LEN - 1) As Byte
    Dim typeIdx As Long

    LowResolveMemberField = 0
    fieldOff = 0
    fieldSize = 0
    fieldCount = 0
    fieldTy = -1
    If idx < 0 Then Exit Function
    ast = ctx->ast
    nodes = ast->nodes
    If nodes[idx].kind <> AST_MEMBER Then Exit Function
    typeTable = ast->types
    base = nodes[idx].left
    AstCopyStr(ast, idx, VarPtr(fname))
    If nodes[base].kind = AST_MEMBER Then
        typeIdx = LowMemberFieldType(ctx, base)
    ElseIf nodes[base].kind = AST_VAR Then
        AstCopyStr(ast, base, VarPtr(name))
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then Exit Function
        typeIdx = vTypeIdx
    ElseIf nodes[base].kind = AST_INDEX Then
        AstCopyStr(ast, nodes[base].left, VarPtr(name))
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then Exit Function
        typeIdx = vTypeIdx
    Else
        Exit Function
    End If
    If typeIdx < 0 Then Exit Function
    If TyFindFieldEx(typeTable, typeIdx, VarPtr(fname), fieldOff, fieldSize, fieldCount, fieldTy) = 0 Then Exit Function
    LowResolveMemberField = 1
End Function

' AST_MEMBER ノードが指すフィールドの UDT 型インデックス（ネスト解決用）
Function LowMemberFieldType(ctx As *LowerCtx, idx As Long) As Long
    Dim fieldOff As Long
    Dim fieldSize As Long
    Dim fieldCount As Long
    Dim fieldTy As Long

    LowMemberFieldType = -1
    If LowResolveMemberField(ctx, idx, fieldOff, fieldSize, fieldCount, fieldTy) = 0 Then Exit Function
    LowMemberFieldType = fieldTy
End Function

' Byte size of the field addressed by an AST_MEMBER (supports nesting).
Function LowMemberFieldSize(ctx As *LowerCtx, idx As Long) As Long
    Dim fieldOff As Long
    Dim fieldSize As Long
    Dim fieldCount As Long
    Dim fieldTy As Long

    LowMemberFieldSize = 0
    If LowResolveMemberField(ctx, idx, fieldOff, fieldSize, fieldCount, fieldTy) = 0 Then Exit Function
    LowMemberFieldSize = fieldSize
End Function
