' EmitterAlu - 整数演算と幅付きメモリ

Sub EmitMovRcxRax(cb As *CodeBuffer)
    EmitByte(cb, &H48)
    EmitByte(cb, &H89)
    EmitByte(cb, &HC1)
End Sub

Sub EmitMovRdxRax(cb As *CodeBuffer)
    EmitByte(cb, &H48)
    EmitByte(cb, &H89)
    EmitByte(cb, &HC2)
End Sub

Sub EmitMovR8Rax(cb As *CodeBuffer)
    EmitByte(cb, &H49)
    EmitByte(cb, &H89)
    EmitByte(cb, &HC0)
End Sub

Sub EmitMovzxEaxByteRax(cb As *CodeBuffer)
    EmitByte(cb, &H0F)
    EmitByte(cb, &HB6)
    EmitByte(cb, &H00)
End Sub

Sub EmitTestRax(cb As *CodeBuffer)
    EmitByte(cb, &H48)
    EmitByte(cb, &H85)
    EmitByte(cb, &HC0)
End Sub

Sub EmitXorEax(cb As *CodeBuffer)
    EmitByte(cb, &H31)
    EmitByte(cb, &HC0)
End Sub

' lea rax, [rbp + disp32]
Sub EmitLeaLocal(cb As *CodeBuffer, disp As Long)
    EmitByte(cb, &H48)
    EmitByte(cb, &H8D)
    EmitByte(cb, &H85)
    EmitDword(cb, disp)
End Sub

' add rax, rcx
Sub EmitAddRaxRcx(cb As *CodeBuffer)
    EmitByte(cb, &H48)
    EmitByte(cb, &H01)
    EmitByte(cb, &HC8)
End Sub

' movzx eax, byte [rax]
Sub EmitLoadzxByteRax(cb As *CodeBuffer)
    EmitByte(cb, &H0F)
    EmitByte(cb, &HB6)
    EmitByte(cb, &H00)
End Sub

' mov [rax], cl
Sub EmitStoreByteRaxCl(cb As *CodeBuffer)
    EmitByte(cb, &H88)
    EmitByte(cb, &H08)
End Sub

' add rax, imm32
Sub EmitAddRaxImm(cb As *CodeBuffer, imm As Long)
    EmitByte(cb, &H48)
    EmitByte(cb, &H05)
    EmitDword(cb, imm)
End Sub

' movzx eax, word [rax]
Sub EmitLoadzxWordRax(cb As *CodeBuffer)
    EmitByte(cb, &H0F)
    EmitByte(cb, &HB7)
    EmitByte(cb, &H00)
End Sub

' mov [rax], cx
Sub EmitStoreWordRaxCx(cb As *CodeBuffer)
    EmitByte(cb, &H66)
    EmitByte(cb, &H89)
    EmitByte(cb, &H08)
End Sub

' mov eax, [rax]
Sub EmitLoadDwordRax(cb As *CodeBuffer)
    EmitByte(cb, &H8B)
    EmitByte(cb, &H00)
End Sub

' mov [rax], ecx
Sub EmitStoreDwordRaxEcx(cb As *CodeBuffer)
    EmitByte(cb, &H89)
    EmitByte(cb, &H08)
End Sub

' mov rax, [rax]
Sub EmitLoadQwordRax(cb As *CodeBuffer)
    EmitByte(cb, &H48)
    EmitByte(cb, &H8B)
    EmitByte(cb, &H00)
End Sub

' mov [rax], rcx
Sub EmitStoreQwordRaxRcx(cb As *CodeBuffer)
    EmitByte(cb, &H48)
    EmitByte(cb, &H89)
    EmitByte(cb, &H08)
End Sub

' and eax, ecx
Sub EmitAndEaxEcx(cb As *CodeBuffer)
    EmitByte(cb, &H21)
    EmitByte(cb, &HC8)
End Sub

' or eax, ecx
Sub EmitOrEaxEcx(cb As *CodeBuffer)
    EmitByte(cb, &H09)
    EmitByte(cb, &HC8)
End Sub

' neg eax
Sub EmitNegEax(cb As *CodeBuffer)
    EmitByte(cb, &HF7)
    EmitByte(cb, &HD8)
End Sub

' sub eax, ecx
Sub EmitSubEaxEcx(cb As *CodeBuffer)
    EmitByte(cb, &H29)
    EmitByte(cb, &HC8)
End Sub

Sub EmitPopRdx(cb As *CodeBuffer)
    EmitByte(cb, &H5A)
End Sub

' xchg rax, rcx
Sub EmitXchgRaxRcx(cb As *CodeBuffer)
    EmitByte(cb, &H48)
    EmitByte(cb, &H91)
End Sub

Function EmitCallRel32(cb As *CodeBuffer) As Long
    EmitByte(cb, &HE8)
    EmitCallRel32 = cb->size
    EmitDword(cb, 0)
End Function

' call rax
Sub EmitCallRax(cb As *CodeBuffer)
    EmitByte(cb, &HFF)
    EmitByte(cb, &HD0)
End Sub

' lea rax, [rip+disp32] - returns offset of disp32 for patching
Function EmitLeaRaxLabRel32(cb As *CodeBuffer) As Long
    EmitByte(cb, &H48)
    EmitByte(cb, &H8D)
    EmitByte(cb, &H05)
    EmitLeaRaxLabRel32 = cb->size
    EmitDword(cb, 0)
End Function

' shl ecx, 3
Sub EmitShlEcx3(cb As *CodeBuffer)
    EmitByte(cb, &HC1)
    EmitByte(cb, &HE1)
    EmitByte(cb, 3)
End Sub

' pop rax
Sub EmitPopRax(cb As *CodeBuffer)
    EmitByte(cb, &H58)
End Sub

' pop r8
Sub EmitPopR8(cb As *CodeBuffer)
    EmitByte(cb, &H41)
    EmitByte(cb, &H58)
End Sub

' mov rax, r8
Sub EmitMovRaxR8(cb As *CodeBuffer)
    EmitByte(cb, &H4C)
    EmitByte(cb, &H89)
    EmitByte(cb, &HC0)
End Sub

' mov [rsp+disp32], rax
Sub EmitStoreRspRax(cb As *CodeBuffer, disp As Long)
    EmitByte(cb, &H48)
    EmitByte(cb, &H89)
    EmitByte(cb, &H84)
    EmitByte(cb, &H24)
    EmitDword(cb, disp)
End Sub

' mov rax, [rsp+disp32]
Sub EmitLoadRspRax(cb As *CodeBuffer, disp As Long)
    EmitByte(cb, &H48)
    EmitByte(cb, &H8B)
    EmitByte(cb, &H84)
    EmitByte(cb, &H24)
    EmitDword(cb, disp)
End Sub

' mov r9, rax
Sub EmitMovR9Rax(cb As *CodeBuffer)
    EmitByte(cb, &H49)
    EmitByte(cb, &H89)
    EmitByte(cb, &HC1)
End Sub

' mov [rbp+disp], r8
Sub EmitStoreLocalR8(cb As *CodeBuffer, disp As Long)
    EmitByte(cb, &H4C)
    EmitByte(cb, &H89)
    EmitByte(cb, &H85)
    EmitDword(cb, disp)
End Sub

' mov [rbp+disp], r9
Sub EmitStoreLocalR9(cb As *CodeBuffer, disp As Long)
    EmitByte(cb, &H4C)
    EmitByte(cb, &H89)
    EmitByte(cb, &H8D)
    EmitDword(cb, disp)
End Sub

' mov eax, edx
Sub EmitMovEaxEdx(cb As *CodeBuffer)
    EmitByte(cb, &H89)
    EmitByte(cb, &HD0)
End Sub

' xor edx, edx
Sub EmitXorEdx(cb As *CodeBuffer)
    EmitByte(cb, &H31)
    EmitByte(cb, &HD2)
End Sub

' div ecx  (unsigned; rdx:rax / ecx)
Sub EmitDivEcx(cb As *CodeBuffer)
    EmitByte(cb, &HF7)
    EmitByte(cb, &HF1)
End Sub

' xor eax, ecx
Sub EmitXorEaxEcx(cb As *CodeBuffer)
    EmitByte(cb, &H31)
    EmitByte(cb, &HC8)
End Sub

' not eax
Sub EmitNotEax(cb As *CodeBuffer)
    EmitByte(cb, &HF7)
    EmitByte(cb, &HD0)
End Sub

' shl eax, cl
Sub EmitShlEaxCl(cb As *CodeBuffer)
    EmitByte(cb, &HD3)
    EmitByte(cb, &HE0)
End Sub

' sar eax, cl（符号付き右シフト）
Sub EmitSarEaxCl(cb As *CodeBuffer)
    EmitByte(cb, &HD3)
    EmitByte(cb, &HF8)
End Sub

' imul eax, edx
Sub EmitImulEaxEdx(cb As *CodeBuffer)
    EmitByte(cb, &H0F)
    EmitByte(cb, &HAF)
    EmitByte(cb, &HC2)
End Sub

' dec ecx
Sub EmitDecEcx(cb As *CodeBuffer)
    EmitByte(cb, &HFF)
    EmitByte(cb, &HC9)
End Sub

' test ecx, ecx
Sub EmitTestEcx(cb As *CodeBuffer)
    EmitByte(cb, &H85)
    EmitByte(cb, &HC9)
End Sub

' and eax, imm32
Sub EmitAndEaxImm(cb As *CodeBuffer, imm As Long)
    EmitByte(cb, &H25)
    EmitDword(cb, imm)
End Sub
