' AstLowerDim - 配列サイズと Dim の収集


Function LowStmtList(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim cur As Long
    Dim savedErr As Long
    Dim anyFail As Long

    LowStmtList = 0
    ast = ctx->ast
    nodes = ast->nodes
    cur = idx
    anyFail = 0
    While cur >= 0
        savedErr = ctx->err
        ctx->err = 0
        If LowStmt(ctx, cur) = 0 Then
            anyFail = 1
        End If
        If ctx->err <> 0 Then anyFail = 1
        If savedErr <> 0 Then ctx->err = 1
        cur = nodes[cur].nxt
    Wend
    If anyFail <> 0 Then
        ctx->err = 1
        Exit Function
    End If
    LowStmtList = 1
End Function

' boundIdx: 1D expr, or AST_ARG chain (2D). nElems=product of (b+1); arrLen0=b0+1 for 2D else -1
Function LowDimEvalBoundNode(ctx As *LowerCtx, boundIdx As Long, ByRef nElems As Long, ByRef arrLen0 As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim b0 As Long
    Dim b1 As Long
    Dim nxt As Long

    LowDimEvalBoundNode = 0
    arrLen0 = -1
    nElems = 0
    If boundIdx < 0 Then Exit Function
    ast = ctx->ast
    nodes = ast->nodes
    If nodes[boundIdx].kind = AST_ARG Then
        b0 = LowConstEval(ctx, nodes[boundIdx].left)
        If b0 < 0 Then Exit Function
        nxt = nodes[boundIdx].nxt
        If nxt < 0 Then Exit Function
        b1 = LowConstEval(ctx, nodes[nxt].left)
        If b1 < 0 Then Exit Function
        arrLen0 = b0 + 1
        nElems = arrLen0 * (b1 + 1)
    Else
        b0 = LowConstEval(ctx, boundIdx)
        If b0 < 0 Then Exit Function
        nElems = b0 + 1
    End If
    LowDimEvalBoundNode = 1
End Function

Function LowDimArrBytes(ctx As *LowerCtx, dimIdx As Long, typeKind As Long, ByRef nbytes As Long, ByRef arrLen0 As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim nElems As Long
    LowDimArrBytes = 0
    arrLen0 = -1
    ast = ctx->ast
    nodes = ast->nodes
    If typeKind = TY_BYTE_ARR Then
        If LowDimEvalBoundNode(ctx, nodes[dimIdx].left, nElems, arrLen0) = 0 Then Exit Function
        nbytes = nElems
    ElseIf typeKind = TY_LONG_ARR Then
        If LowDimEvalBoundNode(ctx, nodes[dimIdx].left, nElems, arrLen0) = 0 Then Exit Function
        nbytes = nElems * 4
    ElseIf typeKind = TY_DOUBLE_ARR Then
        If LowDimEvalBoundNode(ctx, nodes[dimIdx].left, nElems, arrLen0) = 0 Then Exit Function
        nbytes = nElems * 8
    ElseIf typeKind = TY_SINGLE_ARR Then
        If LowDimEvalBoundNode(ctx, nodes[dimIdx].left, nElems, arrLen0) = 0 Then Exit Function
        nbytes = nElems * 4
    ElseIf typeKind = TY_STRING_ARR Then
        If LowDimEvalBoundNode(ctx, nodes[dimIdx].left, nElems, arrLen0) = 0 Then Exit Function
        nbytes = nElems * TyPtrSize()
    End If
    LowDimArrBytes = 1
End Function

Function LowDimUdtArrBytes(ctx As *LowerCtx, dimIdx As Long, namePtr As *Byte, ByRef nbytes As Long, ByRef typeIdx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim nElems As Long
    Dim arrLen0 As Long
    Dim typeTable As *TypeTable
    Dim tsizes As *Long
    LowDimUdtArrBytes = 0
    ast = ctx->ast
    nodes = ast->nodes
    typeTable = ast->types
    typeIdx = nodes[dimIdx].extra
    If typeIdx < 0 Then
        Print "error: Dim UDT[] missing type '" + MakeStr(namePtr) + "'"
        Exit Function
    End If
    If LowDimEvalBoundNode(ctx, nodes[dimIdx].left, nElems, arrLen0) = 0 Then Exit Function
    tsizes = typeTable->typeSizes
    nbytes = tsizes[typeIdx]
    If nbytes <= 0 Then
        Print "error: Dim UDT[] size 0 '" + MakeStr(namePtr) + "'"
        Exit Function
    End If
    nbytes = nbytes * nElems
    LowDimUdtArrBytes = 1
End Function

Function LowDimUdtBytes(ctx As *LowerCtx, dimIdx As Long, namePtr As *Byte, ByRef nbytes As Long, ByRef typeIdx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim typeTable As *TypeTable
    Dim tsizes As *Long
    LowDimUdtBytes = 0
    ast = ctx->ast
    nodes = ast->nodes
    typeTable = ast->types
    typeIdx = nodes[dimIdx].extra
    If typeIdx < 0 Then
        Print "error: Dim UDT missing type '" + MakeStr(namePtr) + "'"
        Exit Function
    End If
    tsizes = typeTable->typeSizes
    nbytes = tsizes[typeIdx]
    If nbytes <= 0 Then
        Print "error: Dim UDT size 0 '" + MakeStr(namePtr) + "'"
        Exit Function
    End If
    LowDimUdtBytes = 1
End Function

Function LowDimFixedBytes(ctx As *LowerCtx, dimIdx As Long, typeKind As Long, namePtr As *Byte, ByRef nbytes As Long, ByRef typeIdx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    LowDimFixedBytes = 0
    ast = ctx->ast
    nodes = ast->nodes
    If typeKind = TY_BYTE Then
        nbytes = 1
    ElseIf typeKind = TY_DOUBLE Then
        nbytes = 8
    ElseIf typeKind = TY_SINGLE Then
        nbytes = 4
    ElseIf typeKind = TY_UDT_ARR Then
        If LowDimUdtArrBytes(ctx, dimIdx, namePtr, nbytes, typeIdx) = 0 Then Exit Function
    ElseIf typeKind = TY_UDT Then
        If LowDimUdtBytes(ctx, dimIdx, namePtr, nbytes, typeIdx) = 0 Then Exit Function
    ElseIf typeKind = TY_PTR_UDT Then
        typeIdx = nodes[dimIdx].extra
        If typeIdx < 0 Then Exit Function
        nbytes = TyPtrSize()
    ElseIf typeKind = TY_PTR_FUNC Then
        typeIdx = nodes[dimIdx].extra
        nbytes = TyPtrSize()
    End If
    LowDimFixedBytes = 1
End Function

' Register one AST_DIM (asGlob=1 -> module global, else local). Returns 0 on error.
' 2D non-UDT arrays store len0=(bound0+1) in typeIdx for first-index-fastest flattening.
Function LowRegisterDimNode(ctx As *LowerCtx, dimIdx As Long, asGlob As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim namePtr(SYM_NAME_LEN - 1) As Byte
    Dim typeKind As Long
    Dim nbytes As Long
    Dim typeIdx As Long
    Dim arrLen0 As Long

    LowRegisterDimNode = 0
    ast = ctx->ast
    nodes = ast->nodes
    AstCopyStr(ast, dimIdx, VarPtr(namePtr))
    typeKind = nodes[dimIdx].num
    nbytes = 8
    typeIdx = -1
    arrLen0 = -1
    If LowDimArrBytes(ctx, dimIdx, typeKind, nbytes, arrLen0) = 0 Then Exit Function
    If LowDimFixedBytes(ctx, dimIdx, typeKind, VarPtr(namePtr), nbytes, typeIdx) = 0 Then Exit Function
    If arrLen0 > 0 Then
        If typeKind <> TY_UDT_ARR And typeKind <> TY_UDT And typeKind <> TY_PTR_UDT And typeKind <> TY_PTR_FUNC Then
            typeIdx = arrLen0
        End If
    End If
    If asGlob <> 0 Then
        If LowAddGlob(ctx, VarPtr(namePtr), typeKind, nbytes, typeIdx) < 0 Then
            Print "error: register global '" + MakeStr(VarPtr(namePtr)) + "' typeKind=" + Str$(typeKind)
            Exit Function
        End If
    Else
        If LowAddSym(ctx, VarPtr(namePtr), typeKind, nbytes, typeIdx, 0) < 0 Then
            Print "error: register local '" + MakeStr(VarPtr(namePtr)) + "' typeKind=" + Str$(typeKind)
            Exit Function
        End If
    End If
    LowRegisterDimNode = 1
End Function

' Walk statement list (and nested If/While/For/Do bodies) to register Dims.
Function LowCollectDimsInList(ctx As *LowerCtx, idx As Long, asGlob As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim cur As Long
    Dim kind As Long

    LowCollectDimsInList = 0
    ast = ctx->ast
    nodes = ast->nodes
    cur = idx
    While cur >= 0
        kind = nodes[cur].kind
        If kind = AST_DIM Then
            If LowRegisterDimNode(ctx, cur, asGlob) = 0 Then Exit Function
        ElseIf kind = AST_IF Then
            If LowCollectDimsInList(ctx, nodes[cur].right, asGlob) = 0 Then Exit Function
            If LowCollectDimsInList(ctx, nodes[cur].extra, asGlob) = 0 Then Exit Function
        ElseIf kind = AST_WHILE Then
            If LowCollectDimsInList(ctx, nodes[cur].right, asGlob) = 0 Then Exit Function
        ElseIf kind = AST_DO Then
            If LowCollectDimsInList(ctx, nodes[cur].right, asGlob) = 0 Then Exit Function
        ElseIf kind = AST_FOR Then
            If LowCollectDimsInList(ctx, nodes[cur].num, asGlob) = 0 Then Exit Function
        ElseIf kind = AST_WITH Then
            If LowCollectDimsInList(ctx, nodes[cur].right, asGlob) = 0 Then Exit Function
        End If
        cur = nodes[cur].nxt
    Wend
    LowCollectDimsInList = 1
End Function
