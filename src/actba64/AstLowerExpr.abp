' ===================================================
'  AstLowerExpr - expression lowering
' ===================================================

Function LowAddrIndex(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim k As Long
    Dim base As Long

    LowAddrIndex = 0
    ast = ctx->ast
    nodes = ast->nodes
    k = nodes[idx].kind
    If k = AST_CALL Then
        LowAddrIndex = LowAddrArrayCall(ctx, idx)
        Exit Function
    End If
    base = nodes[idx].left
    If nodes[base].kind = AST_MEMBER Then
        LowAddrIndex = LowAddrIndexMember(ctx, idx)
        Exit Function
    End If
    LowAddrIndex = LowAddrIndexBase(ctx, idx)
End Function

Function LowAddr(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim k As Long

    LowAddr = 0
    If idx < 0 Then
        ctx->err = 1
        Exit Function
    End If
    ast = ctx->ast
    nodes = ast->nodes
    k = nodes[idx].kind
    If k = AST_VAR Then
        LowAddr = LowAddrVar(ctx, idx)
        Exit Function
    End If
    If k = AST_MEMBER Then
        LowAddr = LowAddrMember(ctx, idx)
        Exit Function
    End If
    If k = AST_INDEX Or k = AST_CALL Then
        LowAddr = LowAddrIndex(ctx, idx)
        Exit Function
    End If
    ctx->err = 1
End Function



' 配列名を *Byte 等へ渡すとき先頭アドレスに減衰する
Function LowExprArg(ctx As *LowerCtx, idx As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte

    LowExprArg = 0
    If idx < 0 Then Exit Function
    ast = ctx->ast
    nodes = ast->nodes
    If nodes[idx].kind = AST_VAR Then
        AstCopyStr(ast, idx, VarPtr(name))
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
            If vTy = TY_BYTE_ARR Then
                LowExprArg = LowAddr(ctx, idx)
                Exit Function
            End If
            If vTy = TY_LONG_ARR Then
                LowExprArg = LowAddr(ctx, idx)
                Exit Function
            End If
            If vTy = TY_DOUBLE_ARR Then
                LowExprArg = LowAddr(ctx, idx)
                Exit Function
            End If
            If vTy = TY_SINGLE_ARR Then
                LowExprArg = LowAddr(ctx, idx)
                Exit Function
            End If
            If vTy = TY_UDT_ARR Then
                LowExprArg = LowAddr(ctx, idx)
                Exit Function
            End If
            If vTy = TY_STRING_ARR Then
                LowExprArg = LowAddr(ctx, idx)
                Exit Function
            End If
        End If
    End If
    LowExprArg = LowExpr(ctx, idx)
End Function

' WinAPI へ UDT 変数を渡すときはアドレス渡し（LPRECT 等）
Function LowArgIsUdtVar(ctx As *LowerCtx, idx As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte

    LowArgIsUdtVar = 0
    If idx < 0 Then Exit Function
    ast = ctx->ast
    nodes = ast->nodes
    If nodes[idx].kind <> AST_VAR Then Exit Function
    AstCopyStr(ast, idx, VarPtr(name))
    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then Exit Function
    If vTy = TY_UDT Then LowArgIsUdtVar = 1
End Function

Function LowCallUseAddr(ctx As *LowerCtx, argNode As Long, byBits As Long, bit As Long, isApi As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    LowCallUseAddr = 0
    If argNode < 0 Then Exit Function
    ast = ctx->ast
    nodes = ast->nodes
    If nodes[argNode].num <> 0 Then Exit Function
    LowCallUseAddr = LowUseArgAddr(ctx, nodes[argNode].left, byBits, bit, isApi)
End Function

Function LowUseArgAddr(ctx As *LowerCtx, idx As Long, byBits As Long, bit As Long, isApi As Long) As Long
    Dim v As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    LowUseArgAddr = 0
    If idx >= 0 Then
        ast = ctx->ast
        nodes = ast->nodes
        If nodes[idx].kind = AST_BUILTIN Then
            If nodes[idx].num = BI_VARPTR Or nodes[idx].num = BI_STRPTR Then
                Exit Function
            End If
        End If
    End If
    v = byBits And bit
    If v <> 0 Then
        LowUseArgAddr = 1
        Exit Function
    End If
    If isApi = 0 Then Exit Function
    If LowArgIsUdtVar(ctx, idx) <> 0 Then LowUseArgAddr = 1
End Function

Function LowRecvClassTi(ctx As *LowerCtx, recvIdx As Long) As Long
    Dim nodes As *AstNode
    Dim name(63) As Byte
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim ast As *Ast
    Dim tt As *TypeTable

    LowRecvClassTi = -1
    If recvIdx < 0 Then Exit Function
    ast = ctx->ast
    nodes = ast->nodes
    If nodes[recvIdx].kind <> AST_VAR Then Exit Function
    AstCopyStr(ast, recvIdx, VarPtr(name))
    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then Exit Function
    If vTy <> TY_UDT And vTy <> TY_PTR_UDT Then Exit Function
    tt = ast->types
    If TyIsClass(tt, vTypeIdx) = 0 Then Exit Function
    LowRecvClassTi = vTypeIdx
End Function

Function LowRecvIsPtr(ctx As *LowerCtx, recvIdx As Long) As Long
    Dim nodes As *AstNode
    Dim name(63) As Byte
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim ast As *Ast

    LowRecvIsPtr = 0
    If recvIdx < 0 Then Exit Function
    ast = ctx->ast
    nodes = ast->nodes
    If nodes[recvIdx].kind <> AST_VAR Then Exit Function
    AstCopyStr(ast, recvIdx, VarPtr(name))
    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then Exit Function
    If vTy = TY_PTR_UDT Then LowRecvIsPtr = 1
End Function

Sub LowMangleClass(className As *Byte, member As *Byte, dst As *Byte)
    lstrcpy(dst, className)
    lstrcat(dst, "_")
    lstrcat(dst, member)
End Sub

Sub LowEmitOneClassDtor(ctx As *LowerCtx, ti As Long, vOff As Long, vGlob As Long)
    Dim mangled(127) As Byte
    Dim kDtor(7) As Byte
    Dim lab As Long
    Dim tt As *TypeTable
    Dim j As Long
    Dim stk As Long
    Dim names As *Byte
    Dim ast As *Ast

    If ti < 0 Then Exit Sub
    ast = ctx->ast
    tt = ast->types
    If TyIsClass(tt, ti) = 0 Then Exit Sub
    lstrcpy(VarPtr(kDtor), "Dtor")
    j = ti * 48
    names = tt->typeNames
    LowMangleClass(VarPtr(names[j]), VarPtr(kDtor), VarPtr(mangled))
    lab = LowFindFunc(ctx, VarPtr(mangled))
    If lab < 0 Then Exit Sub
    stk = LowCallStk(1)
    If stk > 0 Then
        IrEmit(ctx->list, OP_SUB_RSP, stk, 0)
    End If
    LowEmitLeaOff(ctx->list, vOff, vGlob)
    IrEmit(ctx->list, OP_STORE_RSP_RAX, 0, 0)
    LowEmitLoadRegArgs(ctx->list, 1)
    IrEmit(ctx->list, OP_CALL_LAB, lab, 0)
    LowEmitCallFinish(ctx->list, stk)
End Sub

Sub LowEmitLocalClassDtors(ctx As *LowerCtx)
    Dim i As Long
    Dim types As *Long
    Dim typeIdxs As *Long
    Dim offs As *Long

    types = ctx->types
    typeIdxs = ctx->typeIdxs
    offs = ctx->offs
    i = ctx->symCount - 1
    While i >= 0
        If types[i] = TY_UDT Then
            LowEmitOneClassDtor(ctx, typeIdxs[i], offs[i], 0)
        End If
        i = i - 1
    Wend
End Sub

Sub LowEmitGlobalClassDtors(ctx As *LowerCtx)
    Dim i As Long
    Dim types As *Long
    Dim typeIdxs As *Long
    Dim offs As *Long

    types = g_gTypes As *Long
    typeIdxs = g_gTypeIdxs As *Long
    offs = g_gOffs As *Long
    i = g_gCount - 1
    While i >= 0
        If types[i] = TY_UDT Then
            LowEmitOneClassDtor(ctx, typeIdxs[i], offs[i], 1)
        End If
        i = i - 1
    Wend
End Sub

Function LowExprNum(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim offs As *Long
    Dim types As *Long
    Dim list As *IrList
    Dim lab As Long
    Dim tt As *TypeTable
    Dim typeIdxs As *Long
    Dim byRefs As *Long

    LowExprNum = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    tt = ast->types
    offs = ctx->offs
    types = ctx->types
    typeIdxs = ctx->typeIdxs
    byRefs = ctx->byRefs

    If nodes[idx].extra = 1 Then
        IrEmit(list, OP_MOV_EAX_IMM, nodes[idx].num, 0)
    ElseIf nodes[idx].extra = AST_NUM_MILLI Then
        IrEmit(list, OP_MOV_EAX_IMM, nodes[idx].num, 0)
        lab = LowEnsureRtMilliToDouble(ctx)
        LowEmitCall1Rax(list, 0, 0, 0, lab)
    Else
        IrEmit(list, OP_MOV_EAX_IMM, nodes[idx].num, 0)
    End If
    LowExprNum = 1
End Function

Function LowExprString(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim buf(255) As Byte
    Dim offs As *Long
    Dim types As *Long
    Dim list As *IrList
    Dim tt As *TypeTable
    Dim typeIdxs As *Long
    Dim byRefs As *Long
    Dim slen As Long
    Dim strs As *Byte
    Dim stOff As Long
    Dim j As Long
    Dim irIdx As Long

    LowExprString = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    tt = ast->types
    offs = ctx->offs
    types = ctx->types
    typeIdxs = ctx->typeIdxs
    byRefs = ctx->byRefs

    slen = AstStrByteLen(ast, idx)
    If slen <= 0 Then
        AstCopyStr(ast, idx, VarPtr(buf))
        slen = 0
        While buf[slen] <> 0
            slen = slen + 1
        Wend
    Else
        AstCopyStrTo(ast, idx, VarPtr(buf), slen)
    End If
    irIdx = IrEmit(list, OP_LEA_RAX_STR, 0, slen)
    If irIdx < 0 Then Exit Function
    IrSetStrAtN(list, irIdx, VarPtr(buf), slen)
    LowExprString = 1
End Function

Function LowExprVar(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim offs As *Long
    Dim types As *Long
    Dim list As *IrList
    Dim ci As Long
    Dim vals As *Long
    Dim strs As *Byte
    Dim tt As *TypeTable
    Dim typeIdxs As *Long
    Dim byRefs As *Long

    LowExprVar = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    tt = ast->types
    offs = ctx->offs
    types = ctx->types
    typeIdxs = ctx->typeIdxs
    byRefs = ctx->byRefs

    AstCopyStr(ast, idx, VarPtr(name))
    ci = LowFindConst(ctx, VarPtr(name))
    If ci >= 0 Then
        vals = ctx->constVals
        IrEmit(list, OP_MOV_EAX_IMM, vals[ci], 0)
        LowExprVar = 1
        Exit Function
    End If
    ci = LowFindStrConst(ctx, VarPtr(name))
    If ci >= 0 Then
        strs = ctx->constStrVals
        IrEmitStr(list, OP_LEA_RAX_STR, 0, VarPtr(strs[ci * AST_STR_LEN]))
        LowExprVar = 1
        Exit Function
    End If
    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
        Print "error: undefined variable '" + MakeStr(VarPtr(name)) + "'"
        ctx->err = 1
        Exit Function
    End If
    LowEmitLoadOff(list, vOff, vGlob)
    If vByRef <> 0 Then
        IrEmit(list, OP_LOAD_QWORD_RAX, 0, 0)
    End If
    LowExprVar = 1
End Function

Function LowExprMember(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim buf(255) As Byte
    Dim offs As *Long
    Dim types As *Long
    Dim list As *IrList
    Dim tt As *TypeTable
    Dim typeIdxs As *Long
    Dim foff As Long
    Dim fsz As Long
    Dim fcnt As Long
    Dim ti As Long
    Dim base As Long
    Dim byRefs As *Long

    LowExprMember = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    tt = ast->types
    offs = ctx->offs
    types = ctx->types
    typeIdxs = ctx->typeIdxs
    byRefs = ctx->byRefs

    If LowAddr(ctx, idx) = 0 Then Exit Function
    AstCopyStr(ast, idx, VarPtr(name))
    base = nodes[idx].left
    If nodes[base].kind = AST_INDEX Then
        AstCopyStr(ast, nodes[base].left, VarPtr(buf))
    ElseIf nodes[base].kind = AST_VAR Then
        AstCopyStr(ast, base, VarPtr(buf))
    Else
        ctx->err = 1
        Exit Function
    End If
    If LowLookupVar(ctx, VarPtr(buf), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
        ctx->err = 1
        Exit Function
    End If
    ti = vTypeIdx
    If TyFindField(tt, ti, VarPtr(name), foff, fsz, fcnt) = 0 Then
        LowLoadSized(list, LowTyNbytes(vTy))
        LowExprMember = 1
        Exit Function
    End If
    LowLoadSized(list, fsz)
    LowExprMember = 1
End Function

Function LowExprIndex(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim buf(255) As Byte
    Dim offs As *Long
    Dim types As *Long
    Dim list As *IrList
    Dim tt As *TypeTable
    Dim typeIdxs As *Long
    Dim foff As Long
    Dim fsz As Long
    Dim fcnt As Long
    Dim fieldTy As Long
    Dim ti As Long
    Dim base As Long
    Dim ix As Long
    Dim byRefs As *Long

    LowExprIndex = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    tt = ast->types
    offs = ctx->offs
    types = ctx->types
    typeIdxs = ctx->typeIdxs
    byRefs = ctx->byRefs

    base = nodes[idx].left
    If nodes[base].kind = AST_MEMBER Then
        If LowAddr(ctx, idx) = 0 Then Exit Function
        AstCopyStr(ast, base, VarPtr(name))
        ix = nodes[base].left
        If nodes[ix].kind = AST_INDEX Then
            AstCopyStr(ast, nodes[ix].left, VarPtr(buf))
        ElseIf nodes[ix].kind = AST_VAR Then
            AstCopyStr(ast, ix, VarPtr(buf))
        Else
            ctx->err = 1
            Exit Function
        End If
        If LowLookupVar(ctx, VarPtr(buf), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
            ctx->err = 1
            Exit Function
        End If
        ti = vTypeIdx
        If TyFindFieldEx(tt, ti, VarPtr(name), foff, fsz, fcnt, fieldTy) = 0 Then
            ctx->err = 1
            Exit Function
        End If
        If fcnt > 1 Then
            LowLoadSized(list, fsz)
        ElseIf fsz = TyPtrSize() Then
            LowLoadSized(list, LowPtrFieldElemSize(fieldTy))
        Else
            ctx->err = 1
            Exit Function
        End If
        LowExprIndex = 1
    Else
        If LowAddr(ctx, idx) = 0 Then Exit Function
        AstCopyStr(ast, base, VarPtr(buf))
        If LowLookupVar(ctx, VarPtr(buf), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
            If vTy = TY_PTR_LONG Or vTy = TY_LONG_ARR Then
                LowLoadSized(list, 4)
            ElseIf vTy = TY_PTR_BYTE Then
                IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
            ElseIf vTy = TY_STRING_ARR Or vTy = TY_DOUBLE_ARR Then
                LowLoadSized(list, 8)
            ElseIf vTy = TY_SINGLE_ARR Then
                LowLoadSized(list, 4)
            ElseIf vTy = TY_UDT_ARR Then
                ' 要素全体の値ロードはしない（メンバアクセス経由）
                ctx->err = 1
                Exit Function
            Else
                IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
            End If
        Else
            IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
        End If
        LowExprIndex = 1
    End If
End Function

Function LowExprBuiltinMem(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList
    Dim labZ As Long
    Dim labE As Long
    Dim sLen(15) As Byte

    LowExprBuiltinMem = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    If nodes[idx].num = BI_FILLMEMORY Then
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        If nodes[idx].extra < 0 Then
            ctx->err = 1
            Exit Function
        End If
        If LowExpr(ctx, nodes[idx].extra) = 0 Then Exit Function
        IrEmit(list, OP_MOV_R8_RAX, 0, 0)
        IrEmit(list, OP_POP_RAX, 0, 0)
        IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
        IrEmit(list, OP_POP_RCX, 0, 0)
        lstrcpy(VarPtr(sLen), "RtlFillMemory")
        IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sLen))
        LowExprBuiltinMem = 1
    ElseIf nodes[idx].num = BI_ASC Then
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        labZ = LowNewLab(ctx)
        labE = LowNewLab(ctx)
        IrEmit(list, OP_TEST_RAX, 0, 0)
        IrEmit(list, OP_JZ, labZ, 0)
        IrEmit(list, OP_MOVZX_EAX_BYTE, 0, 0)
        IrEmit(list, OP_JMP, labE, 0)
        IrEmit(list, OP_LABEL, labZ, 0)
        IrEmit(list, OP_XOR_EAX, 0, 0)
        IrEmit(list, OP_LABEL, labE, 0)
        LowExprBuiltinMem = 1
    ElseIf nodes[idx].num = BI_MEMCPY Then
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        If nodes[idx].extra < 0 Then
            ctx->err = 1
            Exit Function
        End If
        If LowExpr(ctx, nodes[idx].extra) = 0 Then Exit Function
        IrEmit(list, OP_MOV_R8_RAX, 0, 0)
        IrEmit(list, OP_POP_RAX, 0, 0)
        IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
        IrEmit(list, OP_POP_RCX, 0, 0)
        lstrcpy(VarPtr(sLen), "RtlMoveMemory")
        IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sLen))
        LowExprBuiltinMem = 1
    Else
        LowExprBuiltinMem = -1
    End If
End Function

Function LowExprBuiltinLen(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim list As *IrList
    Dim labZ As Long
    Dim labE As Long
    Dim tt As *TypeTable
    Dim ti As Long
    Dim sz As Long
    Dim tsizes As *Long

    LowExprBuiltinLen = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    tt = ast->types
    If nodes[nodes[idx].left].kind = AST_VAR Then
        AstCopyStr(ast, nodes[idx].left, VarPtr(name))
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
            If vTy = TY_UDT Then
                ti = vTypeIdx
                If ti >= 0 Then
                    tsizes = tt->typeSizes
                    sz = tsizes[ti]
                    If sz > 0 Then
                        IrEmit(list, OP_MOV_EAX_IMM, sz, 0)
                        LowExprBuiltinLen = 1
                        Exit Function
                    End If
                End If
            End If
        End If
    End If
    If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
    labZ = LowNewLab(ctx)
    labE = LowNewLab(ctx)
    LowEmitLoadStrLen(list, labZ, labE)
    LowExprBuiltinLen = 1
End Function

Function LowExprBuiltinCore(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim list As *IrList
    Dim lab As Long
    Dim tt As *TypeTable
    Dim sz As Long

    LowExprBuiltinCore = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    tt = ast->types

    If nodes[idx].num = BI_SIZEOF Then
        AstCopyStr(ast, nodes[idx].left, VarPtr(name))
        sz = TySizeOfName(tt, VarPtr(name))
        If sz <= 0 Then
            If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
                ctx->err = 1
                Exit Function
            End If
            ctx->err = 1
            Exit Function
        End If
        IrEmit(list, OP_MOV_EAX_IMM, sz, 0)
        LowExprBuiltinCore = 1
    ElseIf nodes[idx].num = BI_VARPTR Then
        If LowAddr(ctx, nodes[idx].left) = 0 Then Exit Function
        LowExprBuiltinCore = 1
    ElseIf nodes[idx].num = BI_ADDRESSOF Then
        AstCopyStr(ast, idx, VarPtr(name))
        lab = LowFindFunc(ctx, VarPtr(name))
        If lab < 0 Then
            Print "error: AddressOf unknown function '" + MakeStr(VarPtr(name)) + "'"
            ctx->err = 1
            Exit Function
        End If
        IrEmit(list, OP_LEA_RAX_LAB, lab, 0)
        LowExprBuiltinCore = 1
    ElseIf nodes[idx].num = BI_MALLOC Then
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        LowEmitHeapAllocRax(list, 0)
        LowExprBuiltinCore = 1
    ElseIf nodes[idx].num = BI_FREE Then
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        LowEmitHeapFreeRax(list)
        LowExprBuiltinCore = 1
    ElseIf nodes[idx].num = BI_LEN Then
        LowExprBuiltinCore = LowExprBuiltinLen(ctx, idx)
    ElseIf nodes[idx].num = BI_MAKEINTRESOURCE Then
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        LowExprBuiltinCore = 1
    ElseIf nodes[idx].num = BI_STRPTR Then
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        LowExprBuiltinCore = 1
    ElseIf nodes[idx].num = BI_STR Then
        lab = LowEnsureRtStr(ctx)
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        LowEmitCall1Rax(list, 0, 0, 0, lab)
        LowExprBuiltinCore = 1
    ElseIf nodes[idx].num = BI_MAKESTR Then
        lab = LowEnsureRtMakeStr(ctx)
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        LowEmitCall1Rax(list, 0, 0, 0, lab)
        LowExprBuiltinCore = 1
    Else
        LowExprBuiltinCore = -1
    End If
End Function

Function LowExprBuiltinRight(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList
    Dim lab As Long
    Dim labZ As Long
    Dim labA As Long
    Dim labB As Long

    LowExprBuiltinRight = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    ' Right$(s, n) => Mid$(s, len - n + 1, n)
    If nodes[idx].right < 0 Then
        ctx->err = 1
        Exit Function
    End If
    lab = LowEnsureRtMid(ctx)
    labA = LowNewLab(ctx)
    labB = LowNewLab(ctx)
    labZ = LowNewLab(ctx)
    If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    ' stack: s, n  →  rax = s, rcx = n
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_POP_RAX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
    ' rax = s (stack: s, n) → rax = Len(s)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JZ, labA, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -4, 0)
    IrEmit(list, OP_LOAD_DWORD_RAX, 0, 0)
    IrEmit(list, OP_AND_EAX_IMM, 2147483647, 0)
    IrEmit(list, OP_JMP, labB, 0)
    IrEmit(list, OP_LABEL, labA, 0)
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_LABEL, labB, 0)
    ' start = len - n + 1（n はスタックへ戻す）
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
    IrEmit(list, OP_SUB_EAX_ECX, 0, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    ' if start < 1 then start = 1
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 1, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JL, labZ, 0)
    IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
    IrEmit(list, OP_LABEL, labZ, 0)
    IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
    IrEmit(list, OP_POP_RAX, 0, 0)
    If TyIs32() <> 0 Then
        IrEmit(list, OP_POP_RCX, 0, 0)
    Else
        IrEmit(list, OP_MOV_R8_RAX, 0, 0)
        IrEmit(list, OP_POP_RCX, 0, 0)
    End If
    LowEmitCallLab3(list, lab)
    LowExprBuiltinRight = 1
End Function

Function LowExprBuiltinStr(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList
    Dim lab As Long

    LowExprBuiltinStr = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    If nodes[idx].num = BI_LEFT Then
        lab = LowEnsureRtMid(ctx)
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
        If TyIs32() <> 0 Then
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            IrEmit(list, OP_MOV_EAX_IMM, 1, 0)
            IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
            IrEmit(list, OP_POP_RAX, 0, 0)
            IrEmit(list, OP_POP_RCX, 0, 0)
        Else
            IrEmit(list, OP_MOV_R8_RAX, 0, 0)
            IrEmit(list, OP_MOV_EAX_IMM, 1, 0)
            IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
            IrEmit(list, OP_POP_RCX, 0, 0)
        End If
        LowEmitCallLab3(list, lab)
        LowExprBuiltinStr = 1
    ElseIf nodes[idx].num = BI_MID Then
        lab = LowEnsureRtMid(ctx)
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        If nodes[idx].extra >= 0 Then
            If LowExpr(ctx, nodes[idx].extra) = 0 Then Exit Function
        Else
            IrEmit(list, OP_MOV_EAX_IMM, -1, 0)
        End If
        If TyIs32() <> 0 Then
            IrEmit(list, OP_POP_RDX, 0, 0)
            IrEmit(list, OP_POP_RCX, 0, 0)
        Else
            IrEmit(list, OP_MOV_R8_RAX, 0, 0)
            IrEmit(list, OP_POP_RAX, 0, 0)
            IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
            IrEmit(list, OP_POP_RCX, 0, 0)
        End If
        LowEmitCallLab3(list, lab)
        LowExprBuiltinStr = 1
    ElseIf nodes[idx].num = BI_CHR Then
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        IrEmit(list, OP_MOV_EAX_IMM, 6, 0)
        IrEmit(list, OP_MOV_RCX_RAX, 0, 0)
        LowEmitCallStrHeapAlloc(ctx)
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        IrEmit(list, OP_MOV_ECX, &H80000001, 0)
        IrEmit(list, OP_STORE_DWORD_RAX_ECX, 0, 0)
        IrEmit(list, OP_POP_RAX, 0, 0)
        IrEmit(list, OP_ADD_RAX_IMM, 4, 0)
        IrEmit(list, OP_POP_RCX, 0, 0)
        IrEmit(list, OP_STORE_BYTE_RAX_CL, 0, 0)
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
        IrEmit(list, OP_MOV_ECX, 0, 0)
        IrEmit(list, OP_STORE_BYTE_RAX_CL, 0, 0)
        IrEmit(list, OP_POP_RAX, 0, 0)
        LowExprBuiltinStr = 1
    ElseIf nodes[idx].num = BI_RIGHT Then
        LowExprBuiltinStr = LowExprBuiltinRight(ctx, idx)
    ElseIf nodes[idx].num = BIK_RGB Then
        If nodes[idx].right < 0 Or nodes[idx].extra < 0 Then
            ctx->err = 1
            Exit Function
        End If
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
        IrEmit(list, OP_MOV_ECX, 256, 0)
        IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
        IrEmit(list, OP_POP_RCX, 0, 0)
        IrEmit(list, OP_OR_EAX_ECX, 0, 0)
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        If LowExpr(ctx, nodes[idx].extra) = 0 Then Exit Function
        IrEmit(list, OP_MOV_ECX, 65536, 0)
        IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
        IrEmit(list, OP_POP_RCX, 0, 0)
        IrEmit(list, OP_OR_EAX_ECX, 0, 0)
        LowExprBuiltinStr = 1
    ElseIf nodes[idx].num = BI_LOWORD Then
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        IrEmit(list, OP_MOV_ECX, 65535, 0)
        IrEmit(list, OP_AND_EAX_ECX, 0, 0)
        LowExprBuiltinStr = 1
    ElseIf nodes[idx].num = BI_LOBYTE Then
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        IrEmit(list, OP_MOV_ECX, 255, 0)
        IrEmit(list, OP_AND_EAX_ECX, 0, 0)
        LowExprBuiltinStr = 1
    ElseIf nodes[idx].num = BI_HIBYTE Then
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        IrEmit(list, OP_MOV_ECX, 8, 0)
        IrEmit(list, OP_SAR_EAX_CL, 0, 0)
        IrEmit(list, OP_MOV_ECX, 255, 0)
        IrEmit(list, OP_AND_EAX_ECX, 0, 0)
        LowExprBuiltinStr = 1
    ElseIf nodes[idx].num = BI_HIWORD Then
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        IrEmit(list, OP_MOV_ECX, 16, 0)
        IrEmit(list, OP_SAR_EAX_CL, 0, 0)
        IrEmit(list, OP_MOV_ECX, 65535, 0)
        IrEmit(list, OP_AND_EAX_ECX, 0, 0)
        LowExprBuiltinStr = 1
    ElseIf nodes[idx].num = BI_MAKELONG Then
        If nodes[idx].right < 0 Then
            ctx->err = 1
            Exit Function
        End If
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
        IrEmit(list, OP_MOV_ECX, 16, 0)
        IrEmit(list, OP_SHL_EAX_CL, 0, 0)
        IrEmit(list, OP_POP_RCX, 0, 0)
        IrEmit(list, OP_OR_EAX_ECX, 0, 0)
        LowExprBuiltinStr = 1
    ElseIf nodes[idx].num = BI_ELM Then
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        IrEmit(list, OP_MOV_ECX, 1, 0)
        IrEmit(list, OP_ADD_EAX_ECX, 0, 0)
        LowExprBuiltinStr = 1
    ElseIf nodes[idx].num = BI_MAKEWORD Then
        If nodes[idx].right < 0 Then
            ctx->err = 1
            Exit Function
        End If
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        IrEmit(list, OP_MOV_ECX, 255, 0)
        IrEmit(list, OP_AND_EAX_ECX, 0, 0)
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
        IrEmit(list, OP_MOV_ECX, 255, 0)
        IrEmit(list, OP_AND_EAX_ECX, 0, 0)
        IrEmit(list, OP_MOV_ECX, 8, 0)
        IrEmit(list, OP_SHL_EAX_CL, 0, 0)
        IrEmit(list, OP_POP_RCX, 0, 0)
        IrEmit(list, OP_OR_EAX_ECX, 0, 0)
        LowExprBuiltinStr = 1
    Else
        Print "error: unsupported builtin " + Str$(nodes[idx].num)
        ctx->err = 1
    End If
End Function

Function LowExprBuiltin(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim n As Long
    Dim r As Long

    LowExprBuiltin = 0
    ast = ctx->ast
    nodes = ast->nodes
    n = nodes[idx].num
    If n = BI_LEFT Or n = BI_MID Or n = BI_CHR Or n = BI_RIGHT Or n = BIK_RGB Or n = BI_LOWORD Or n = BI_HIBYTE Or n = BI_LOBYTE Or n = BI_HIWORD Or n = BI_MAKELONG Or n = BI_MAKEWORD Or n = BI_ELM Then
        LowExprBuiltin = LowExprBuiltinStr(ctx, idx)
        Exit Function
    End If
    If n = BI_FILLMEMORY Or n = BI_ASC Or n = BI_MEMCPY Then
        LowExprBuiltin = LowExprBuiltinMem(ctx, idx)
        Exit Function
    End If
    r = LowExprBuiltinCore(ctx, idx)
    If r < 0 Then
        Print "error: unsupported builtin " + Str$(n)
        ctx->err = 1
        Exit Function
    End If
    LowExprBuiltin = r
End Function



Function LowExprCallMethodInvoke(ctx As *LowerCtx, idx As Long, ti As Long, nArgs As Long, stk As Long) As Long
    Dim name(63) As Byte
    Dim buf(255) As Byte
    Dim list As *IrList
    Dim lab As Long
    Dim vals As *Long
    Dim tt As *TypeTable
    Dim j As Long
    Dim names As *Byte
    Dim ast As *Ast

    LowExprCallMethodInvoke = 0
    ast = ctx->ast
    list = ctx->list
    tt = ast->types
    AstCopyStr(ast, idx, VarPtr(name))
    j = ti * 48
    names = tt->typeNames
    lab = -1
    vals = tt->typeVirtCount
    If vals[ti] > 0 Then
        lab = TyFindVirt(tt, ti, VarPtr(name))
    End If
    If lab >= 0 Then
        ' COM / Virtual: call [ [*this] + slot*8 ]
        IrEmit(list, OP_LOAD_PTR, 0, 0)
        If lab <> 0 Then
            IrEmit(list, OP_ADD_RAX_IMM, lab * TyPtrSize(), 0)
        End If
        IrEmit(list, OP_LOAD_PTR, 0, 0)
        IrEmit(list, OP_CALL_RAX, 0, 0)
    Else
        LowMangleClass(VarPtr(names[j]), VarPtr(name), VarPtr(buf))
        lab = LowFindFunc(ctx, VarPtr(buf))
        If lab < 0 Then
            Print "error: unknown method '" + MakeStr(VarPtr(buf)) + "'"
            ctx->err = 1
            Exit Function
        End If
        IrEmit(list, OP_CALL_LAB, lab, 0)
    End If    LowEmitCallFinish(list, stk)

    LowExprCallMethodInvoke = 1
End Function

