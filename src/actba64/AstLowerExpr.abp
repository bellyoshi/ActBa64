' ===================================================
'  AstLowerExpr - expression lowering
' ===================================================

Function LowAddrIndex(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim kind As Long
    Dim base As Long

    LowAddrIndex = 0
    ast = ctx->ast
    nodes = ast->nodes
    kind = nodes[idx].kind
    If kind = AST_CALL Then
        LowAddrIndex = LowAddrArrayCall(ctx, idx)
        Exit Function
    End If
    base = nodes[idx].left
    If nodes[base].kind = AST_MEMBER Then
        LowAddrIndex = LowAddrIndexMember(ctx, idx)
        Exit Function
    End If
    LowAddrIndex = LowAddrIndexBase(ctx, idx)
End Function

Function LowAddr(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim kind As Long

    LowAddr = 0
    If idx < 0 Then
        ctx->err = 1
        Exit Function
    End If
    ast = ctx->ast
    nodes = ast->nodes
    kind = nodes[idx].kind
    If kind = AST_VAR Then
        LowAddr = LowAddrVar(ctx, idx)
        Exit Function
    End If
    If kind = AST_MEMBER Then
        LowAddr = LowAddrMember(ctx, idx)
        Exit Function
    End If
    If kind = AST_INDEX Or kind = AST_CALL Then
        LowAddr = LowAddrIndex(ctx, idx)
        Exit Function
    End If
    ctx->err = 1
End Function



' 配列名を *Byte 等へ渡すとき先頭アドレスに減衰する
Function LowExprArg(ctx As *LowerCtx, idx As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte

    LowExprArg = 0
    If idx < 0 Then Exit Function
    ast = ctx->ast
    nodes = ast->nodes
    If nodes[idx].kind = AST_VAR Then
        AstCopyStr(ast, idx, VarPtr(name))
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
            If vTy = TY_BYTE_ARR Then
                LowExprArg = LowAddr(ctx, idx)
                Exit Function
            End If
            If vTy = TY_LONG_ARR Then
                LowExprArg = LowAddr(ctx, idx)
                Exit Function
            End If
            If vTy = TY_DOUBLE_ARR Then
                LowExprArg = LowAddr(ctx, idx)
                Exit Function
            End If
            If vTy = TY_SINGLE_ARR Then
                LowExprArg = LowAddr(ctx, idx)
                Exit Function
            End If
            If vTy = TY_UDT_ARR Then
                LowExprArg = LowAddr(ctx, idx)
                Exit Function
            End If
            If vTy = TY_STRING_ARR Then
                LowExprArg = LowAddr(ctx, idx)
                Exit Function
            End If
        End If
    End If
    LowExprArg = LowExpr(ctx, idx)
End Function

' WinAPI へ UDT 変数を渡すときはアドレス渡し（LPRECT 等）
Function LowArgIsUdtVar(ctx As *LowerCtx, idx As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte

    LowArgIsUdtVar = 0
    If idx < 0 Then Exit Function
    ast = ctx->ast
    nodes = ast->nodes
    If nodes[idx].kind <> AST_VAR Then Exit Function
    AstCopyStr(ast, idx, VarPtr(name))
    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then Exit Function
    If vTy = TY_UDT Then LowArgIsUdtVar = 1
End Function

Function LowCallUseAddr(ctx As *LowerCtx, argNode As Long, byBits As Long, bit As Long, isApi As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    LowCallUseAddr = 0
    If argNode < 0 Then Exit Function
    ast = ctx->ast
    nodes = ast->nodes
    If nodes[argNode].num <> 0 Then Exit Function
    LowCallUseAddr = LowUseArgAddr(ctx, nodes[argNode].left, byBits, bit, isApi)
End Function

Function LowUseArgAddr(ctx As *LowerCtx, idx As Long, byBits As Long, bit As Long, isApi As Long) As Long
    Dim v As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    LowUseArgAddr = 0
    If idx >= 0 Then
        ast = ctx->ast
        nodes = ast->nodes
        If nodes[idx].kind = AST_BUILTIN Then
            If nodes[idx].num = BI_VARPTR Or nodes[idx].num = BI_STRPTR Then
                Exit Function
            End If
        End If
    End If
    v = byBits And bit
    If v <> 0 Then
        LowUseArgAddr = 1
        Exit Function
    End If
    If isApi = 0 Then Exit Function
    If LowArgIsUdtVar(ctx, idx) <> 0 Then LowUseArgAddr = 1
End Function

Function LowRecvClassTi(ctx As *LowerCtx, recvIdx As Long) As Long
    Dim nodes As *AstNode
    Dim name(63) As Byte
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim ast As *Ast
    Dim tt As *TypeTable

    LowRecvClassTi = -1
    If recvIdx < 0 Then Exit Function
    ast = ctx->ast
    nodes = ast->nodes
    If nodes[recvIdx].kind <> AST_VAR Then Exit Function
    AstCopyStr(ast, recvIdx, VarPtr(name))
    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then Exit Function
    If vTy <> TY_UDT And vTy <> TY_PTR_UDT Then Exit Function
    tt = ast->types
    If TyIsClass(tt, vTypeIdx) = 0 Then Exit Function
    LowRecvClassTi = vTypeIdx
End Function

Function LowRecvIsPtr(ctx As *LowerCtx, recvIdx As Long) As Long
    Dim nodes As *AstNode
    Dim name(63) As Byte
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim ast As *Ast

    LowRecvIsPtr = 0
    If recvIdx < 0 Then Exit Function
    ast = ctx->ast
    nodes = ast->nodes
    If nodes[recvIdx].kind <> AST_VAR Then Exit Function
    AstCopyStr(ast, recvIdx, VarPtr(name))
    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then Exit Function
    If vTy = TY_PTR_UDT Then LowRecvIsPtr = 1
End Function

Sub LowMangleClass(className As *Byte, member As *Byte, dst As *Byte)
    lstrcpy(dst, className)
    lstrcat(dst, "_")
    lstrcat(dst, member)
End Sub

Sub LowEmitOneClassDtor(ctx As *LowerCtx, ti As Long, vOff As Long, vGlob As Long)
    Dim mangled(127) As Byte
    Dim kDtor(7) As Byte
    Dim lab As Long
    Dim tt As *TypeTable
    Dim j As Long
    Dim callBytes As Long
    Dim names As *Byte
    Dim ast As *Ast

    If ti < 0 Then Exit Sub
    ast = ctx->ast
    tt = ast->types
    If TyIsClass(tt, ti) = 0 Then Exit Sub
    lstrcpy(VarPtr(kDtor), "Dtor")
    j = ti * 48
    names = tt->typeNames
    LowMangleClass(VarPtr(names[j]), VarPtr(kDtor), VarPtr(mangled))
    lab = LowFindFunc(ctx, VarPtr(mangled))
    If lab < 0 Then Exit Sub
    callBytes = LowCallBytes(1)
    If callBytes > 0 Then
        IrEmit(ctx->list, OP_SUB_RSP, callBytes, 0)
    End If
    LowEmitLeaOff(ctx->list, vOff, vGlob)
    IrEmit(ctx->list, OP_STORE_RSP_RAX, 0, 0)
    LowEmitLoadRegArgs(ctx->list, 1)
    IrEmit(ctx->list, OP_CALL_LAB, lab, 0)
    LowEmitCallFinish(ctx->list, callBytes)
End Sub

Sub LowEmitLocalClassDtors(ctx As *LowerCtx)
    Dim i As Long
    Dim types As *Long
    Dim typeIdxs As *Long
    Dim offs As *Long

    types = ctx->types
    typeIdxs = ctx->typeIdxs
    offs = ctx->offs
    i = ctx->symCount - 1
    While i >= 0
        If types[i] = TY_UDT Then
            LowEmitOneClassDtor(ctx, typeIdxs[i], offs[i], 0)
        End If
        i = i - 1
    Wend
End Sub

Sub LowEmitGlobalClassDtors(ctx As *LowerCtx)
    Dim i As Long
    Dim types As *Long
    Dim typeIdxs As *Long
    Dim offs As *Long

    types = g_globTypes As *Long
    typeIdxs = g_globTypeIdxs As *Long
    offs = g_globOffs As *Long
    i = g_globCount - 1
    While i >= 0
        If types[i] = TY_UDT Then
            LowEmitOneClassDtor(ctx, typeIdxs[i], offs[i], 1)
        End If
        i = i - 1
    Wend
End Sub



Function LowExprCast(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim offs As *Long
    Dim types As *Long
    Dim list As *IrList
    Dim tt As *TypeTable
    Dim typeIdxs As *Long
    Dim byRefs As *Long

    LowExprCast = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    tt = ast->types
    offs = ctx->offs
    types = ctx->types
    typeIdxs = ctx->typeIdxs
    byRefs = ctx->byRefs

    If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
    If nodes[idx].num <> 0 Then
        IrEmit(list, OP_AND_EAX_IMM, nodes[idx].num, 0)
    End If
    LowExprCast = 1
End Function

' 定数畳み込みできる式なら rax に積んで 1
Function LowExprConst(ctx As *LowerCtx, idx As Long) As Long
    Dim ast As *Ast
    Dim list As *IrList
    Dim v As Long
    Dim buf(255) As Byte

    LowExprConst = 0
    ast = ctx->ast
    list = ctx->list
    If LowConstInt(ast, idx, v) <> 0 Then
        IrEmit(list, OP_MOV_EAX_IMM, v, 0)
        LowExprConst = 1
        Exit Function
    End If
    If LowConstStr(ast, idx, VarPtr(buf)) <> 0 Then
        IrEmitStr(list, OP_LEA_RAX_STR, 0, VarPtr(buf))
        LowExprConst = 1
    End If
End Function

Function LowExpr(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim kind As Long

    LowExpr = 0
    If idx < 0 Then
        ctx->err = 1
        Exit Function
    End If
    ast = ctx->ast
    nodes = ast->nodes
    If LowExprConst(ctx, idx) <> 0 Then
        LowExpr = 1
        Exit Function
    End If

    kind = nodes[idx].kind
    If kind = AST_NUM Then
        LowExpr = LowExprNum(ctx, idx)
    ElseIf kind = AST_STRING Then
        LowExpr = LowExprString(ctx, idx)
    ElseIf kind = AST_VAR Then
        LowExpr = LowExprVar(ctx, idx)
    ElseIf kind = AST_MEMBER Then
        LowExpr = LowExprMember(ctx, idx)
    ElseIf kind = AST_INDEX Then
        LowExpr = LowExprIndex(ctx, idx)
    ElseIf kind = AST_BUILTIN Then
        LowExpr = LowExprBuiltin(ctx, idx)
    ElseIf kind = AST_CALL Then
        LowExpr = LowExprCall(ctx, idx)
    ElseIf kind = AST_UNARY Then
        LowExpr = LowExprUnary(ctx, idx)
    ElseIf kind = AST_BINOP Then
        LowExpr = LowExprBinop(ctx, idx)
    ElseIf kind = AST_CAST Then
        LowExpr = LowExprCast(ctx, idx)
    Else
        Print "error: unsupported expr kind " + Str$(kind)
        ctx->err = 1
    End If
End Function
