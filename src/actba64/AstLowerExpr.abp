' ===================================================
'  AstLowerExpr - expression lowering (num..call intrin)
' ===================================================

        If types[i] = TY_UDT Then
            LowEmitOneClassDtor(ctx, typeIdxs[i], offs[i], 0)
        End If
        i = i - 1
    Wend
End Sub

Sub LowEmitGlobalClassDtors(ctx As *LowerCtx)
    Dim i As Long
    Dim types As *Long
    Dim typeIdxs As *Long
    Dim offs As *Long

    types = g_gTypes
    typeIdxs = g_gTypeIdxs
    offs = g_gOffs
    i = g_gCount - 1
    While i >= 0
        If types[i] = TY_UDT Then
            LowEmitOneClassDtor(ctx, typeIdxs[i], offs[i], 1)
        End If
        i = i - 1
    Wend
End Sub

Function LowExprNum(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim offs As *Long
    Dim types As *Long
    Dim list As *IrList
    Dim lab As Long
    Dim tt As *TypeTable
    Dim typeIdxs As *Long
    Dim byRefs As *Long

    LowExprNum = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    tt = ast->types
    offs = ctx->offs
    types = ctx->types
    typeIdxs = ctx->typeIdxs
    byRefs = ctx->byRefs

    If nodes[idx].extra = 1 Then
        IrEmit(list, OP_MOV_EAX_IMM, nodes[idx].num, 0)
    ElseIf nodes[idx].extra = AST_NUM_MILLI Then
        IrEmit(list, OP_MOV_EAX_IMM, nodes[idx].num, 0)
        lab = LowEnsureRtMilliToDouble(ctx)
        LowEmitCall1Rax(list, 0, 0, 0, lab)
    Else
        IrEmit(list, OP_MOV_EAX_IMM, nodes[idx].num, 0)
    End If
    LowExprNum = 1
End Function

Function LowExprString(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim buf(255) As Byte
    Dim offs As *Long
    Dim types As *Long
    Dim list As *IrList
    Dim tt As *TypeTable
    Dim typeIdxs As *Long
    Dim byRefs As *Long

    LowExprString = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    tt = ast->types
    offs = ctx->offs
    types = ctx->types
    typeIdxs = ctx->typeIdxs
    byRefs = ctx->byRefs

    AstCopyStr(ast, idx, VarPtr(buf))
    IrEmitStr(list, OP_LEA_RAX_STR, 0, VarPtr(buf))
    LowExprString = 1
End Function

Function LowExprVar(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim offs As *Long
    Dim types As *Long
    Dim list As *IrList
    Dim ci As Long
    Dim vals As *Long
    Dim strs As *Byte
    Dim tt As *TypeTable
    Dim typeIdxs As *Long
    Dim byRefs As *Long

    LowExprVar = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    tt = ast->types
    offs = ctx->offs
    types = ctx->types
    typeIdxs = ctx->typeIdxs
    byRefs = ctx->byRefs

    AstCopyStr(ast, idx, VarPtr(name))
    ci = LowFindConst(ctx, VarPtr(name))
    If ci >= 0 Then
        vals = ctx->constVals
        IrEmit(list, OP_MOV_EAX_IMM, vals[ci], 0)
        LowExprVar = 1
        Exit Function
    End If
    ci = LowFindStrConst(ctx, VarPtr(name))
    If ci >= 0 Then
        strs = ctx->constStrVals
        IrEmitStr(list, OP_LEA_RAX_STR, 0, VarPtr(strs[ci * AST_STR_LEN]))
        LowExprVar = 1
        Exit Function
    End If
    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
        Print "error: undefined variable '" + MakeStr(VarPtr(name)) + "'"
        ctx->err = 1
        Exit Function
    End If
    LowEmitLoadOff(list, vOff, vGlob)
    If vByRef <> 0 Then
        IrEmit(list, OP_LOAD_QWORD_RAX, 0, 0)
    End If
    LowExprVar = 1
End Function

Function LowExprMember(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim buf(255) As Byte
    Dim offs As *Long
    Dim types As *Long
    Dim list As *IrList
    Dim tt As *TypeTable
    Dim typeIdxs As *Long
    Dim foff As Long
    Dim fsz As Long
    Dim fcnt As Long
    Dim ti As Long
    Dim base As Long
    Dim byRefs As *Long

    LowExprMember = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    tt = ast->types
    offs = ctx->offs
    types = ctx->types
    typeIdxs = ctx->typeIdxs
    byRefs = ctx->byRefs

    If LowAddr(ctx, idx) = 0 Then Exit Function
    AstCopyStr(ast, idx, VarPtr(name))
    base = nodes[idx].left
    If nodes[base].kind = AST_INDEX Then
        AstCopyStr(ast, nodes[base].left, VarPtr(buf))
    ElseIf nodes[base].kind = AST_VAR Then
        AstCopyStr(ast, base, VarPtr(buf))
    Else
        ctx->err = 1
        Exit Function
    End If
    If LowLookupVar(ctx, VarPtr(buf), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
        ctx->err = 1
        Exit Function
    End If
    ti = vTypeIdx
    If TyFindField(tt, ti, VarPtr(name), foff, fsz, fcnt) = 0 Then
        LowLoadSized(list, LowTyNbytes(vTy))
        LowExprMember = 1
        Exit Function
    End If
    LowLoadSized(list, fsz)
    LowExprMember = 1
End Function

Function LowExprIndex(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim buf(255) As Byte
    Dim offs As *Long
    Dim types As *Long
    Dim list As *IrList
    Dim tt As *TypeTable
    Dim typeIdxs As *Long
    Dim foff As Long
    Dim fsz As Long
    Dim fcnt As Long
    Dim fieldTy As Long
    Dim ti As Long
    Dim base As Long
    Dim ix As Long
    Dim byRefs As *Long

    LowExprIndex = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    tt = ast->types
    offs = ctx->offs
    types = ctx->types
    typeIdxs = ctx->typeIdxs
    byRefs = ctx->byRefs

    base = nodes[idx].left
    If nodes[base].kind = AST_MEMBER Then
        If LowAddr(ctx, idx) = 0 Then Exit Function
        AstCopyStr(ast, base, VarPtr(name))
        ix = nodes[base].left
        If nodes[ix].kind = AST_INDEX Then
            AstCopyStr(ast, nodes[ix].left, VarPtr(buf))
        ElseIf nodes[ix].kind = AST_VAR Then
            AstCopyStr(ast, ix, VarPtr(buf))
        Else
            ctx->err = 1
            Exit Function
        End If
        If LowLookupVar(ctx, VarPtr(buf), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
            ctx->err = 1
            Exit Function
        End If
        ti = vTypeIdx
        If TyFindFieldEx(tt, ti, VarPtr(name), foff, fsz, fcnt, fieldTy) = 0 Then
            ctx->err = 1
            Exit Function
        End If
        If fcnt > 1 Then
            LowLoadSized(list, fsz)
        ElseIf fsz = TyPtrSize() Then
            LowLoadSized(list, LowPtrFieldElemSize(fieldTy))
        Else
            ctx->err = 1
            Exit Function
        End If
        LowExprIndex = 1
    Else
        If LowAddr(ctx, idx) = 0 Then Exit Function
        AstCopyStr(ast, base, VarPtr(buf))
        If LowLookupVar(ctx, VarPtr(buf), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
            If vTy = TY_PTR_LONG Or vTy = TY_LONG_ARR Then
                LowLoadSized(list, 4)
            ElseIf vTy = TY_STRING_ARR Or vTy = TY_DOUBLE_ARR Then
                LowLoadSized(list, 8)
            ElseIf vTy = TY_SINGLE_ARR Then
                LowLoadSized(list, 4)
            ElseIf vTy = TY_UDT_ARR Then
                ' 要素全体の値ロードはしない（メンバアクセス経由）
                ctx->err = 1
                Exit Function
            Else
                IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
            End If
        Else
            IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
        End If
        LowExprIndex = 1
    End If
End Function

Function LowExprBuiltinMem(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList
    Dim labZ As Long
    Dim labE As Long
    Dim sLen(15) As Byte

    LowExprBuiltinMem = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    If nodes[idx].num = BI_FILLMEMORY Then
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        If nodes[idx].extra < 0 Then
            ctx->err = 1
            Exit Function
        End If
        If LowExpr(ctx, nodes[idx].extra) = 0 Then Exit Function
        IrEmit(list, OP_MOV_R8_RAX, 0, 0)
        IrEmit(list, OP_POP_RAX, 0, 0)
        IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
        IrEmit(list, OP_POP_RCX, 0, 0)
        lstrcpy(VarPtr(sLen), "RtlFillMemory")
        IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sLen))
        LowExprBuiltinMem = 1
    ElseIf nodes[idx].num = BI_ASC Then
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        labZ = LowNewLab(ctx)
        labE = LowNewLab(ctx)
        IrEmit(list, OP_TEST_RAX, 0, 0)
        IrEmit(list, OP_JZ, labZ, 0)
        IrEmit(list, OP_MOVZX_EAX_BYTE, 0, 0)
        IrEmit(list, OP_JMP, labE, 0)
        IrEmit(list, OP_LABEL, labZ, 0)
        IrEmit(list, OP_XOR_EAX, 0, 0)
        IrEmit(list, OP_LABEL, labE, 0)
        LowExprBuiltinMem = 1
    ElseIf nodes[idx].num = BI_MEMCPY Then
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        If nodes[idx].extra < 0 Then
            ctx->err = 1
            Exit Function
        End If
        If LowExpr(ctx, nodes[idx].extra) = 0 Then Exit Function
        IrEmit(list, OP_MOV_R8_RAX, 0, 0)
        IrEmit(list, OP_POP_RAX, 0, 0)
        IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
        IrEmit(list, OP_POP_RCX, 0, 0)
        lstrcpy(VarPtr(sLen), "RtlMoveMemory")
        IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sLen))
        LowExprBuiltinMem = 1
    Else
        LowExprBuiltinMem = -1
    End If
End Function

Function LowExprBuiltinLen(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim list As *IrList
    Dim labZ As Long
    Dim labE As Long
    Dim tt As *TypeTable
    Dim ti As Long
    Dim sz As Long
    Dim tsizes As *Long

    LowExprBuiltinLen = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    tt = ast->types
    If nodes[nodes[idx].left].kind = AST_VAR Then
        AstCopyStr(ast, nodes[idx].left, VarPtr(name))
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
            If vTy = TY_UDT Then
                ti = vTypeIdx
                If ti >= 0 Then
                    tsizes = tt->typeSizes
                    sz = tsizes[ti]
                    If sz > 0 Then
                        IrEmit(list, OP_MOV_EAX_IMM, sz, 0)
                        LowExprBuiltinLen = 1
                        Exit Function
                    End If
                End If
            End If
        End If
    End If
    If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
    labZ = LowNewLab(ctx)
    labE = LowNewLab(ctx)
    LowEmitLoadStrLen(list, labZ, labE)
    LowExprBuiltinLen = 1
End Function

Function LowExprBuiltinCore(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim list As *IrList
    Dim lab As Long
    Dim tt As *TypeTable
    Dim sz As Long

    LowExprBuiltinCore = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    tt = ast->types

    If nodes[idx].num = BI_SIZEOF Then
        AstCopyStr(ast, nodes[idx].left, VarPtr(name))
        sz = TySizeOfName(tt, VarPtr(name))
        If sz <= 0 Then
            If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
                ctx->err = 1
                Exit Function
            End If
            ctx->err = 1
            Exit Function
        End If
        IrEmit(list, OP_MOV_EAX_IMM, sz, 0)
        LowExprBuiltinCore = 1
    ElseIf nodes[idx].num = BI_VARPTR Then
        If LowAddr(ctx, nodes[idx].left) = 0 Then Exit Function
        LowExprBuiltinCore = 1
    ElseIf nodes[idx].num = BI_ADDRESSOF Then
        AstCopyStr(ast, idx, VarPtr(name))
        lab = LowFindFunc(ctx, VarPtr(name))
        If lab < 0 Then
            Print "error: AddressOf unknown function '" + MakeStr(VarPtr(name)) + "'"
            ctx->err = 1
            Exit Function
        End If
        IrEmit(list, OP_LEA_RAX_LAB, lab, 0)
        LowExprBuiltinCore = 1
    ElseIf nodes[idx].num = BI_MALLOC Then
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        LowEmitHeapAllocRax(list, 0)
        LowExprBuiltinCore = 1
    ElseIf nodes[idx].num = BI_FREE Then
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        LowEmitHeapFreeRax(list)
        LowExprBuiltinCore = 1
    ElseIf nodes[idx].num = BI_LEN Then
        LowExprBuiltinCore = LowExprBuiltinLen(ctx, idx)
    ElseIf nodes[idx].num = BI_MAKEINTRESOURCE Then
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        LowExprBuiltinCore = 1
    ElseIf nodes[idx].num = BI_STRPTR Then
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        LowExprBuiltinCore = 1
    ElseIf nodes[idx].num = BI_STR Then
        lab = LowEnsureRtStr(ctx)
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        LowEmitCall1Rax(list, 0, 0, 0, lab)
        LowExprBuiltinCore = 1
    ElseIf nodes[idx].num = BI_MAKESTR Then
        lab = LowEnsureRtMakeStr(ctx)
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        LowEmitCall1Rax(list, 0, 0, 0, lab)
        LowExprBuiltinCore = 1
    Else
        LowExprBuiltinCore = -1
    End If
End Function

Function LowExprBuiltinRight(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList
    Dim lab As Long
    Dim labZ As Long
    Dim labA As Long
    Dim labB As Long

    LowExprBuiltinRight = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    ' Right$(s, n) => Mid$(s, len - n + 1, n)
    If nodes[idx].right < 0 Then
        ctx->err = 1
        Exit Function
    End If
    lab = LowEnsureRtMid(ctx)
    labA = LowNewLab(ctx)
    labB = LowNewLab(ctx)
    labZ = LowNewLab(ctx)
    If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    ' stack: s, n  →  rax = s, rcx = n
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_POP_RAX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
    ' rax = s (stack: s, n) → rax = Len(s)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JZ, labA, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -4, 0)
    IrEmit(list, OP_LOAD_DWORD_RAX, 0, 0)
    IrEmit(list, OP_AND_EAX_IMM, 2147483647, 0)
    IrEmit(list, OP_JMP, labB, 0)
    IrEmit(list, OP_LABEL, labA, 0)
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_LABEL, labB, 0)
    ' start = len - n + 1（n はスタックへ戻す）
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
    IrEmit(list, OP_SUB_EAX_ECX, 0, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    ' if start < 1 then start = 1
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 1, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JL, labZ, 0)
    IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
    IrEmit(list, OP_LABEL, labZ, 0)
    IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
    IrEmit(list, OP_POP_RAX, 0, 0)
    If TyIs32() <> 0 Then
        IrEmit(list, OP_POP_RCX, 0, 0)
    Else
        IrEmit(list, OP_MOV_R8_RAX, 0, 0)
        IrEmit(list, OP_POP_RCX, 0, 0)
    End If
    LowEmitCallLab3(list, lab)
    LowExprBuiltinRight = 1
End Function

Function LowExprBuiltinStr(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList
    Dim lab As Long

    LowExprBuiltinStr = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    If nodes[idx].num = BI_LEFT Then
        lab = LowEnsureRtMid(ctx)
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
        If TyIs32() <> 0 Then
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            IrEmit(list, OP_MOV_EAX_IMM, 1, 0)
            IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
            IrEmit(list, OP_POP_RAX, 0, 0)
            IrEmit(list, OP_POP_RCX, 0, 0)
        Else
            IrEmit(list, OP_MOV_R8_RAX, 0, 0)
            IrEmit(list, OP_MOV_EAX_IMM, 1, 0)
            IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
            IrEmit(list, OP_POP_RCX, 0, 0)
        End If
        LowEmitCallLab3(list, lab)
        LowExprBuiltinStr = 1
    ElseIf nodes[idx].num = BI_MID Then
        lab = LowEnsureRtMid(ctx)
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        If nodes[idx].extra >= 0 Then
            If LowExpr(ctx, nodes[idx].extra) = 0 Then Exit Function
        Else
            IrEmit(list, OP_MOV_EAX_IMM, -1, 0)
        End If
        If TyIs32() <> 0 Then
            IrEmit(list, OP_POP_RDX, 0, 0)
            IrEmit(list, OP_POP_RCX, 0, 0)
        Else
            IrEmit(list, OP_MOV_R8_RAX, 0, 0)
            IrEmit(list, OP_POP_RAX, 0, 0)
            IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
            IrEmit(list, OP_POP_RCX, 0, 0)
        End If
        LowEmitCallLab3(list, lab)
        LowExprBuiltinStr = 1
    ElseIf nodes[idx].num = BI_CHR Then
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        IrEmit(list, OP_MOV_EAX_IMM, 6, 0)
        IrEmit(list, OP_MOV_RCX_RAX, 0, 0)
        LowEmitCallStrHeapAlloc(ctx)
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        IrEmit(list, OP_MOV_ECX, &H80000001, 0)
        IrEmit(list, OP_STORE_DWORD_RAX_ECX, 0, 0)
        IrEmit(list, OP_POP_RAX, 0, 0)
        IrEmit(list, OP_ADD_RAX_IMM, 4, 0)
        IrEmit(list, OP_POP_RCX, 0, 0)
        IrEmit(list, OP_STORE_BYTE_RAX_CL, 0, 0)
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
        IrEmit(list, OP_MOV_ECX, 0, 0)
        IrEmit(list, OP_STORE_BYTE_RAX_CL, 0, 0)
        IrEmit(list, OP_POP_RAX, 0, 0)
        LowExprBuiltinStr = 1
    ElseIf nodes[idx].num = BI_RIGHT Then
        LowExprBuiltinStr = LowExprBuiltinRight(ctx, idx)
    ElseIf nodes[idx].num = BIK_RGB Then
        If nodes[idx].right < 0 Or nodes[idx].extra < 0 Then
            ctx->err = 1
            Exit Function
        End If
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
        IrEmit(list, OP_MOV_ECX, 256, 0)
        IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
        IrEmit(list, OP_POP_RCX, 0, 0)
        IrEmit(list, OP_OR_EAX_ECX, 0, 0)
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        If LowExpr(ctx, nodes[idx].extra) = 0 Then Exit Function
        IrEmit(list, OP_MOV_ECX, 65536, 0)
        IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
        IrEmit(list, OP_POP_RCX, 0, 0)
        IrEmit(list, OP_OR_EAX_ECX, 0, 0)
        LowExprBuiltinStr = 1
    ElseIf nodes[idx].num = BI_LOWORD Then
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        IrEmit(list, OP_MOV_ECX, 65535, 0)
        IrEmit(list, OP_AND_EAX_ECX, 0, 0)
        LowExprBuiltinStr = 1
    Else
        Print "error: unsupported builtin " + Str$(nodes[idx].num)
        ctx->err = 1
    End If
End Function

Function LowExprBuiltin(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim n As Long
    Dim r As Long

    LowExprBuiltin = 0
    ast = ctx->ast
    nodes = ast->nodes
    n = nodes[idx].num
    If n = BI_LEFT Or n = BI_MID Or n = BI_CHR Or n = BI_RIGHT Or n = BIK_RGB Or n = BI_LOWORD Then
        LowExprBuiltin = LowExprBuiltinStr(ctx, idx)
        Exit Function
    End If
    If n = BI_FILLMEMORY Or n = BI_ASC Or n = BI_MEMCPY Then
        LowExprBuiltin = LowExprBuiltinMem(ctx, idx)
        Exit Function
    End If
    r = LowExprBuiltinCore(ctx, idx)
    If r < 0 Then
        Print "error: unsupported builtin " + Str$(n)
        ctx->err = 1
        Exit Function
    End If
    LowExprBuiltin = r
End Function



Function LowExprCallMethodInvoke(ctx As *LowerCtx, idx As Long, ti As Long, nArgs As Long, stk As Long) As Long
    Dim name(63) As Byte
    Dim buf(255) As Byte
    Dim list As *IrList
    Dim lab As Long
    Dim vals As *Long
    Dim tt As *TypeTable
    Dim j As Long
    Dim names As *Byte
    Dim ast As *Ast

    LowExprCallMethodInvoke = 0
    ast = ctx->ast
    list = ctx->list
    tt = ast->types
    AstCopyStr(ast, idx, VarPtr(name))
    j = ti * 48
    names = tt->typeNames
    lab = -1
    vals = tt->typeVirtCount
    If vals[ti] > 0 Then
        lab = TyFindVirt(tt, ti, VarPtr(name))
    End If
    If lab >= 0 Then
        ' COM / Virtual: call [ [*this] + slot*8 ]
        IrEmit(list, OP_LOAD_PTR, 0, 0)
        If lab <> 0 Then
            IrEmit(list, OP_ADD_RAX_IMM, lab * TyPtrSize(), 0)
        End If
        IrEmit(list, OP_LOAD_PTR, 0, 0)
        IrEmit(list, OP_CALL_RAX, 0, 0)
    Else
        LowMangleClass(VarPtr(names[j]), VarPtr(name), VarPtr(buf))
        lab = LowFindFunc(ctx, VarPtr(buf))
        If lab < 0 Then
            Print "error: unknown method '" + MakeStr(VarPtr(buf)) + "'"
            ctx->err = 1
            Exit Function
        End If
        IrEmit(list, OP_CALL_LAB, lab, 0)
    End If    LowEmitCallFinish(list, stk)

    LowExprCallMethodInvoke = 1
End Function

Function LowExprCallMethod(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim buf(255) As Byte
    Dim list As *IrList
    Dim lab As Long
    Dim nArgs As Long
    Dim vals As *Long
    Dim tt As *TypeTable
    Dim ti As Long
    Dim args(15) As Long
    Dim argi As Long
    Dim argn As Long
    Dim stk As Long
    Dim j As Long
    Dim useAddr As Long
    Dim names As *Byte

    LowExprCallMethod = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    tt = ast->types
    AstCopyStr(ast, idx, VarPtr(name))
    ' obj.Method(...) / p->Method(...) — right=receiver, left=user args, str=short name
    ti = LowRecvClassTi(ctx, nodes[idx].right)
    If ti < 0 Then
        Print "error: method call on non-class"
        ctx->err = 1
        Exit Function
    End If
    tt = ast->types
    j = ti * 48
    names = tt->typeNames
    nArgs = nodes[idx].num + 1
    If nArgs > 16 Then
        ctx->err = 1
        Exit Function
    End If
    args[0] = -1
    argi = 1
    argn = nodes[idx].left
    While argn >= 0
        If argi >= 16 Then
            ctx->err = 1
            Exit Function
        End If
        args[argi] = argn
        argi = argi + 1
        argn = nodes[argn].nxt
    Wend
    If argi <> nArgs Then
        ctx->err = 1
        Exit Function
    End If
    stk = LowCallStk(nArgs)
    IrEmit(list, OP_SUB_RSP, stk, 0)
    ' user args 1..n-1 into home/stack; this (rcx) set last
    argi = 1
    While argi < nArgs
        useAddr = LowCallUseAddr(ctx, args[argi], 0, 0, 1)
        If useAddr <> 0 Then
            If LowAddr(ctx, nodes[args[argi]].left) = 0 Then Exit Function
        Else
            If LowExprArg(ctx, nodes[args[argi]].left) = 0 Then Exit Function
        End If
        IrEmit(list, OP_STORE_RSP_RAX, argi * TyPtrSize(), 0)
        argi = argi + 1
    Wend
    If TyIs32() = 0 Then
    If nArgs >= 4 Then
        IrEmit(list, OP_LOAD_RSP_RAX, 24, 0)
        IrEmit(list, OP_MOV_R9_RAX, 0, 0)
    End If
    If nArgs >= 3 Then
        IrEmit(list, OP_LOAD_RSP_RAX, 16, 0)
        IrEmit(list, OP_MOV_R8_RAX, 0, 0)
    End If
    If nArgs >= 2 Then
        IrEmit(list, OP_LOAD_RSP_RAX, 8, 0)
        IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
    End If
    End If
    ' Me: 値クラスはアドレス、*Class はポインタ値
    If LowRecvIsPtr(ctx, nodes[idx].right) <> 0 Then
        If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
    Else
        If LowAddr(ctx, nodes[idx].right) = 0 Then Exit Function
    End If
    IrEmit(list, OP_STORE_RSP_RAX, 0, 0)
    If TyIs32() = 0 Then
        IrEmit(list, OP_MOV_RCX_RAX, 0, 0)
    End If
    If LowExprCallMethodInvoke(ctx, idx, ti, nArgs, stk) = 0 Then Exit Function
    LowExprCallMethod = 1
End Function

Function LowExprCallMemOp(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim buf(255) As Byte
    Dim list As *IrList
    Dim sLen(15) As Byte
    Dim args(15) As Long
    Dim argi As Long
    Dim argn As Long
    Dim stk As Long

    LowExprCallMemOp = -1
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    AstCopyStr(ast, idx, VarPtr(name))
    lstrcpy(VarPtr(buf), "memcpy")
    If LowNameEq(VarPtr(name), VarPtr(buf)) <> 0 Then
        argi = 0
        argn = nodes[idx].left
        While argn >= 0
            If argi >= 16 Then
                ctx->err = 1
                Exit Function
            End If
            args[argi] = argn
            argi = argi + 1
            argn = nodes[argn].nxt
        Wend
        If argi <> 3 Then
            ctx->err = 1
            Exit Function
        End If
        stk = LowCallStk(3)
        If stk > 0 Then
            IrEmit(list, OP_SUB_RSP, stk, 0)
        End If
        If LowExpr(ctx, nodes[args[0]].left) = 0 Then Exit Function
        IrEmit(list, OP_STORE_RSP_RAX, 0, 0)
        If LowExpr(ctx, nodes[args[1]].left) = 0 Then Exit Function
        IrEmit(list, OP_STORE_RSP_RAX, TyPtrSize(), 0)
        If LowExpr(ctx, nodes[args[2]].left) = 0 Then Exit Function
        IrEmit(list, OP_STORE_RSP_RAX, TyPtrSize() + TyPtrSize(), 0)
        LowEmitLoadRegArgs(list, 3)
        lstrcpy(VarPtr(sLen), "RtlMoveMemory")
        IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sLen))
        LowEmitCallFinish(list, stk)
        LowExprCallMemOp = 1
        Exit Function
    End If
    lstrcpy(VarPtr(buf), "fillmemory")
    If LowNameEq(VarPtr(name), VarPtr(buf)) <> 0 Then
        argi = 0
        argn = nodes[idx].left
        While argn >= 0
            If argi >= 16 Then
                ctx->err = 1
                Exit Function
            End If
            args[argi] = argn
            argi = argi + 1
            argn = nodes[argn].nxt
        Wend
        If argi <> 3 Then
            ctx->err = 1
            Exit Function
        End If
        stk = LowCallStk(3)
        If stk > 0 Then
            IrEmit(list, OP_SUB_RSP, stk, 0)
        End If
        If LowExpr(ctx, nodes[args[0]].left) = 0 Then Exit Function
        IrEmit(list, OP_STORE_RSP_RAX, 0, 0)
        If LowExpr(ctx, nodes[args[1]].left) = 0 Then Exit Function
        IrEmit(list, OP_STORE_RSP_RAX, TyPtrSize(), 0)
        If LowExpr(ctx, nodes[args[2]].left) = 0 Then Exit Function
        IrEmit(list, OP_STORE_RSP_RAX, TyPtrSize() + TyPtrSize(), 0)
        LowEmitLoadRegArgs(list, 3)
        lstrcpy(VarPtr(sLen), "RtlFillMemory")
        IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sLen))
        LowEmitCallFinish(list, stk)
        LowExprCallMemOp = 1
        Exit Function
    End If
End Function

Function LowExprCallIntrin(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim buf(255) As Byte
    Dim list As *IrList
    Dim argn As Long
    Dim r As Long

    LowExprCallIntrin = -1
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    AstCopyStr(ast, idx, VarPtr(name))
    lstrcpy(VarPtr(buf), "free")
    If LowNameEq(VarPtr(name), VarPtr(buf)) <> 0 Then
        argn = nodes[idx].left
        If argn >= 0 Then
            If nodes[argn].kind = AST_ARG Then argn = nodes[argn].left
        End If
        If LowExpr(ctx, argn) = 0 Then Exit Function
        LowEmitHeapFreeRax(list)
        LowExprCallIntrin = 1
        Exit Function
    End If
    lstrcpy(VarPtr(buf), "malloc")
    If LowNameEq(VarPtr(name), VarPtr(buf)) <> 0 Then
        argn = nodes[idx].left
        If argn >= 0 Then
