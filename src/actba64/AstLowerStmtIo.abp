' AstLowerStmtIo - Input、Open、Close

' Input の変数ノード。省略可のプロンプト式は promptOut へ
Function LowInputVarIdx(ctx As *LowerCtx, idx As Long, ByRef promptOut As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim nVarIdx As Long

    ast = ctx->ast
    nodes = ast->nodes
    promptOut = -1
    nVarIdx = nodes[idx].left
    If nodes[idx].right >= 0 Then
        If nodes[nodes[idx].right].kind = AST_VAR Then
            promptOut = nodes[idx].left
            nVarIdx = nodes[idx].right
        End If
    End If
    LowInputVarIdx = nVarIdx
End Function

' 読み取った文字列（rax）を必要なら数値へ
Sub LowEmitInputCvt(ctx As *LowerCtx, vTy As Long)
    Dim lab As Long

    If vTy = TY_STRING Then Exit Sub
    If vTy = TY_SINGLE Or vTy = TY_DOUBLE Then
        lab = LowEnsureRtValDouble(ctx)
    Else
        lab = LowEnsureRtVal(ctx)
    End If
    LowEmitCall1Rax(ctx->list, 0, 0, 0, lab)
    If vTy = TY_SINGLE Then
        IrEmit(ctx->list, OP_CVT_SD_TO_SS, 0, 0)
    End If
End Sub

' rax を Input 先の変数へ格納
Sub LowStoreInputVar(ctx As *LowerCtx, vOff As Long, vTy As Long, vByRef As Long, vGlob As Long)
    If LowEmitStoreIfDbl(ctx->list, vOff, vTy, vByRef, vGlob) <> 0 Then Exit Sub
    If vByRef <> 0 Then
        IrEmit(ctx->list, OP_PUSH_RAX, 0, 0)
        LowEmitLoadOff(ctx->list, vOff, vGlob)
        IrEmit(ctx->list, OP_POP_RCX, 0, 0)
        IrEmit(ctx->list, OP_STORE_QWORD_RAX_RCX, 0, 0)
    ElseIf vTy = TY_STRING Then
        LowEmitStoreString(ctx, vOff, vGlob)
    Else
        LowEmitStoreOff(ctx->list, vOff, vGlob)
    End If
End Sub

' 戻り値 true : 正常終了  false : エラーあり
Function LowStmtInputOne(ctx As *LowerCtx, nVarIdx As Long, labIn As Long) As boolean
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(SYM_NAME_LEN - 1) As Byte

    LowStmtInputOne = false
    ast = ctx->ast
    nodes = ast->nodes
    If nodes[nVarIdx].kind <> AST_VAR Then
        ctx->err = 1
        Exit Function
    End If
    AstCopyStr(ast, nVarIdx, VarPtr(name))
    If Not LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) Then
        ctx->err = 1
        Exit Function
    End If
    If vTy <> TY_STRING And vTy <> TY_LONG And vTy <> TY_BYTE And vTy <> TY_DOUBLE And vTy <> TY_SINGLE Then
        Print "error: Input needs String or numeric variable"
        ctx->err = 1
        Exit Function
    End If
    LowStmtInputRead(ctx, labIn)
    LowEmitInputCvt(ctx, vTy)
    LowStoreInputVar(ctx, vOff, vTy, vByRef, vGlob)
    LowStmtInputOne = true
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function LowStmtInputPromptEmit(ctx As *LowerCtx, nPrompt As Long) As boolean
    Dim lab As Long
    LowStmtInputPromptEmit = false
    If LowExpr(ctx, nPrompt) = 0 Then Exit Function
    lab = LowEnsureRtPrintStay(ctx)
    LowEmitCall1Rax(ctx->list, 0, 0, 0, lab)
    LowEmitStrCollectSafepoint(ctx)
    LowStmtInputPromptEmit = true
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function LowStmtInputPrompt(ctx As *LowerCtx, nPrompt As Long) As boolean
    LowStmtInputPrompt = true
    If nPrompt < 0 Then Exit Function
    LowStmtInputPrompt = LowStmtInputPromptEmit(ctx, nPrompt)
End Function

Function LowInputSemi(ctx As *LowerCtx, idx As Long) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    ast = ctx->ast
    nodes = ast->nodes
    LowInputSemi = nodes[idx].num
End Function

Function LowStmtInputRun(ctx As *LowerCtx, nVarIdx As Long, nPrompt As Long, semi As Long) As Long
    Dim stackPad(LOW_STACK_PAD - 1) As Byte
    Dim lab As Long
    LowStmtInputRun = 0
    lab = LowEnsureRtInput(ctx)
    If LowStmtInputAll(ctx, nVarIdx, lab, nPrompt, semi) = 0 Then Exit Function
    LowEmitStrCollectSafepoint(ctx)
    LowStmtInputRun = 1
End Function

Function LowStmtInput(ctx As *LowerCtx, idx As Long) As Long
    Dim nVarIdx As Long
    Dim nPrompt As Long
    Dim semi As Long
    LowStmtInput = 0
    nVarIdx = LowInputVarIdx(ctx, idx, nPrompt)
    If nVarIdx < 0 Then ctx->err = 1
    If nVarIdx < 0 Then Exit Function
    semi = LowInputSemi(ctx, idx)
    LowStmtInput = LowStmtInputRun(ctx, nVarIdx, nPrompt, semi)
End Function

Function LowStmtOpen(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(LOW_STACK_PAD - 1) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim lab As Long
    Dim mode As Long
    Dim list As *IrList

    LowStmtOpen = 0
    ast = ctx->ast
    nodes = ast->nodes
    list = ctx->list
    mode = nodes[idx].num
    lstrcpy(VarPtr(name), "BaFileOpen")
    lab = LowFindFunc(ctx, VarPtr(name))
    If lab < 0 Then
        Print "error: missing 'BaFileOpen' (Include\default\BasicFile.abp)"
        ctx->err = 1
        Exit Function
    End If
    If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, mode, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
    If TyIs32() <> 0 Then
        IrEmit(list, OP_POP_RDX, 0, 0)
        IrEmit(list, OP_POP_RCX, 0, 0)
    Else
        IrEmit(list, OP_MOV_R8_RAX, 0, 0)
        IrEmit(list, OP_POP_RAX, 0, 0)
        IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
        IrEmit(list, OP_POP_RCX, 0, 0)
    End If
    LowEmitCallLab3(list, lab)
    LowEmitStrCollectSafepoint(ctx)
    LowStmtOpen = 1
End Function

Function LowStmtClose(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(LOW_STACK_PAD - 1) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim lab As Long
    Dim list As *IrList

    LowStmtClose = 0
    ast = ctx->ast
    nodes = ast->nodes
    list = ctx->list
    lstrcpy(VarPtr(name), "BaFileClose")
    lab = LowFindFunc(ctx, VarPtr(name))
    If lab < 0 Then
        Print "error: missing 'BaFileClose' (Include\default\BasicFile.abp)"
        ctx->err = 1
        Exit Function
    End If
    If nodes[idx].left < 0 Then
        IrEmit(list, OP_MOV_EAX_IMM, 0, 0)
    Else
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
    End If
    LowEmitCall1Rax(list, 0, 0, VarPtr(name), lab)
    LowEmitStrCollectSafepoint(ctx)
    LowStmtClose = 1
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function LowStmtFInputOne(ctx As *LowerCtx, varIdx As Long, labIn As Long) As boolean
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim list As *IrList

    LowStmtFInputOne = false
    ast = ctx->ast
    nodes = ast->nodes
    list = ctx->list
    If nodes[varIdx].kind <> AST_VAR Then
        ctx->err = 1
        Exit Function
    End If
    AstCopyStr(ast, varIdx, VarPtr(name))
    If Not LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) Then
        ctx->err = 1
        Exit Function
    End If
    If vTy <> TY_STRING And vTy <> TY_LONG And vTy <> TY_BYTE And vTy <> TY_DOUBLE And vTy <> TY_SINGLE Then
        Print "error: Input # needs String or numeric variable"
        ctx->err = 1
        Exit Function
    End If
    ' rax = file number（呼び出し側が再設定）
    LowEmitCall1Rax(list, 0, 0, 0, labIn)
    LowEmitInputCvt(ctx, vTy)
    LowStoreInputVar(ctx, vOff, vTy, vByRef, vGlob)
    LowStmtFInputOne = true
End Function

Function LowStmtFInput(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(LOW_STACK_PAD - 1) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim lab As Long
    Dim list As *IrList
    Dim cur As Long

    LowStmtFInput = 0
    ast = ctx->ast
    nodes = ast->nodes
    list = ctx->list
    lstrcpy(VarPtr(name), "BaFileInput$")
    lab = LowFindFunc(ctx, VarPtr(name))
    If lab < 0 Then
        Print "error: missing 'BaFileInput$' (Include\default\BasicFile.abp)"
        ctx->err = 1
        Exit Function
    End If
    If nodes[idx].left < 0 Then
        ctx->err = 1
        Exit Function
    End If
    cur = nodes[idx].right
    While cur >= 0
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        If Not LowStmtFInputOne(ctx, cur, lab) Then Exit Function
        cur = nodes[cur].nxt
    Wend
    LowEmitStrCollectSafepoint(ctx)
    LowStmtFInput = 1
End Function
