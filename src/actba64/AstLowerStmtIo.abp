' AstLowerStmtIo - Input、Open、Close

' Input の変数ノード。省略可のプロンプト式は promptOut へ
Function LowInputVarIdx(ctx As *LowerCtx, idx As Long, ByRef promptOut As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim nVarIdx As Long

    ast = ctx->ast
    nodes = ast->nodes
    promptOut = -1
    nVarIdx = nodes[idx].left
    ' プロンプト付き（Input "x", a）は right が読み先の並び。読み先は配列の要素（AST_INDEX / AST_CALL）もある
    If nodes[idx].right >= 0 Then
        promptOut = nodes[idx].left
        nVarIdx = nodes[idx].right
    End If
    LowInputVarIdx = nVarIdx
End Function

' 読み取った文字列（rax）を必要なら数値へ
Sub LowEmitInputCvt(ctx As *LowerCtx, vTy As Long)
    Dim lab As Long

    If vTy = TY_STRING Then Exit Sub
    If vTy = TY_SINGLE Or vTy = TY_DOUBLE Then
        lab = LowEnsureRtValDouble(ctx)
    Else
        lab = LowEnsureRtVal(ctx)
    End If
    LowEmitCall1Rax(ctx->list, 0, 0, 0, lab)
    If vTy = TY_SINGLE Then
        IrEmit(ctx->list, OP_CVT_SD_TO_SS, 0, 0)
    End If
End Sub

' 戻り値 true : 正常終了  false : エラーあり
Function LowEmitInputWide(ctx As *LowerCtx) As boolean
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim lab As Long
    LowEmitInputWide = false
    lstrcpy(VarPtr(name), "StrToI64")
    lab = LowFindFunc(ctx, VarPtr(name))
    If lab < 0 Then
        LowPrintErr("error: " + Tr$(1065, "missing 'StrToI64' (Include\default\Int64Str.abp)"))
        ctx->err = 1
        Exit Function
    End If
    LowEmitCall1Rax(ctx->list, 0, 0, 0, lab)
    LowEmitInputWide = true
End Function

' rax を Input 先の変数へ格納
Sub LowStoreInputVar(ctx As *LowerCtx, vOff As Long, vTy As Long, vByRef As Long, vGlob As Long)
    If LowEmitStoreIfDbl(ctx->list, vOff, vTy, vByRef, vGlob) <> 0 Then Exit Sub
    If vByRef <> 0 Then
        IrEmit(ctx->list, OP_PUSH_RAX, 0, 0)
        LowEmitLoadOff(ctx->list, vOff, vGlob)
        IrEmit(ctx->list, OP_POP_RCX, 0, 0)
        IrEmit(ctx->list, OP_STORE_QWORD_RAX_RCX, 0, 0)
    ElseIf vTy = TY_STRING Then
        LowEmitStoreString(ctx, vOff, vGlob)
    Else
        LowEmitStoreOff(ctx->list, vOff, vGlob)
    End If
End Sub

' Input a[i] / a(i)：要素の型で読み、a[i] = v と同じ道で書く
' 戻り値 true : 正常終了  false : エラーあり
Function LowStmtInputElem(ctx As *LowerCtx, n As Long, labIn As Long) As boolean
    Dim ty As Long
    LowStmtInputElem = false
    ty = LowInputElemTy(ctx, n)
    If ty < 0 Then Exit Function
    LowStmtInputRead(ctx, labIn)
    LowStmtInputElem = LowInputElemStore(ctx, n, ty)
End Function

' 読み先の要素の型（TY_STRING / TY_LONG / TY_BYTE / TY_DOUBLE / TY_SINGLE）。読めない要素なら診断して -1
Function LowInputElemTy(ctx As *LowerCtx, n As Long) As Long
    Dim ty As Long
    LowInputElemTy = -1
    ' String 配列の要素は LowExprType では文字列と分からない
    ty = LowExprType(ctx, n)
    If LowIsStringExpr(ctx, n) <> 0 Then ty = TY_STRING
    If LowNodeKind(ctx, n) = AST_CALL And LowIsArrCallTarget(ctx, n) = 0 Then ty = -1
    If ty <> TY_STRING And ty <> TY_LONG And ty <> TY_BYTE And ty <> TY_DOUBLE And ty <> TY_SINGLE Then
        LowerDiagError(ctx, n, Tr$(1066, "Input needs String or numeric variable"))
        ctx->err = 1
        Exit Function
    End If
    LowInputElemTy = ty
End Function

' rax の読んだ文字列を要素の型へ変換し、要素 n へ書く
' 戻り値 true : 正常終了  false : エラーあり
Function LowInputElemStore(ctx As *LowerCtx, n As Long, ty As Long) As boolean
    Dim stackPad(LOW_STACK_PAD - 1) As Byte
    Dim k As Long
    Dim wide As Long

    LowInputElemStore = false
    k = LowNodeKind(ctx, n)
    If ty = TY_LONG And LowExprWide(ctx, n) <> 0 Then
        If Not LowEmitInputWide(ctx) Then Exit Function
    Else
        LowEmitInputCvt(ctx, ty)
    End If
    wide = LowIndexAssignWide(ctx, n, k)
    LowPushWide(ctx->list, wide)
    If LowAddr(ctx, n) = 0 Then Exit Function
    LowPopWide(ctx->list, wide)
    If Not LowStmtAssignIndexStore(ctx, n, k) Then Exit Function
    LowInputElemStore = true
End Function

' a(i) が配列の変数なら 1（関数の呼び出しは読み先にならない）
Function LowIsArrCallTarget(ctx As *LowerCtx, n As Long) As Long
    Dim vOff As Long, vTy As Long, vTi As Long, vBr As Long, vGl As Long
    Dim name(SYM_NAME_LEN - 1) As Byte
    LowIsArrCallTarget = 0
    AstCopyName(ctx->ast, n, VarPtr(name))
    If Not LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTi), VarPtr(vBr), VarPtr(vGl)) Then Exit Function
    LowIsArrCallTarget = 1
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function LowStmtInputOne(ctx As *LowerCtx, nVarIdx As Long, labIn As Long) As boolean
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(SYM_NAME_LEN - 1) As Byte

    LowStmtInputOne = false
    ast = ctx->ast
    nodes = ast->nodes
    If nodes[nVarIdx].kind = AST_INDEX Or nodes[nVarIdx].kind = AST_CALL Then
        LowStmtInputOne = LowStmtInputElem(ctx, nVarIdx, labIn)
        Exit Function
    End If
    If nodes[nVarIdx].kind <> AST_VAR Then
        ctx->err = 1
        Exit Function
    End If
    AstCopyName(ast, nVarIdx, VarPtr(name))
    If Not LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) Then
        ctx->err = 1
        Exit Function
    End If
    ' AB4 ではポインタも整数として読める
    If vTy = TY_PTR_BYTE Or vTy = TY_PTR_UDT Or vTy = TY_PTR_LONG Or vTy = TY_PTR_FUNC Then vTy = TY_LONG
    If vTy <> TY_STRING And vTy <> TY_LONG And vTy <> TY_BYTE And vTy <> TY_DOUBLE And vTy <> TY_SINGLE Then
        LowPrintErr("error: " + Tr$(1066, "Input needs String or numeric variable"))
        ctx->err = 1
        Exit Function
    End If
    LowStmtInputRead(ctx, labIn)
    If vTy = TY_LONG And LowTiWide(vTypeIdx) <> 0 Then
        ' Int64 / QWord は 64bit の十進で読む（Include\default\Int64Str.abp）
        If Not LowEmitInputWide(ctx) Then Exit Function
    Else
        LowEmitInputCvt(ctx, vTy)
    End If
    LowStoreInputVar(ctx, vOff, LowMoveTy(vTy, vTypeIdx), vByRef, vGlob)
    LowStmtInputOne = true
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function LowStmtInputPromptEmit(ctx As *LowerCtx, nPrompt As Long) As boolean
    LowStmtInputPromptEmit = false
    If LowExpr(ctx, nPrompt) = 0 Then Exit Function
    If Not LowEmitPrintCall(ctx, 1) Then Exit Function
    LowEmitStrCollectSafepoint(ctx)
    LowStmtInputPromptEmit = true
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function LowStmtInputPrompt(ctx As *LowerCtx, nPrompt As Long) As boolean
    LowStmtInputPrompt = true
    If nPrompt < 0 Then Exit Function
    LowStmtInputPrompt = LowStmtInputPromptEmit(ctx, nPrompt)
End Function

Function LowInputSemi(ctx As *LowerCtx, idx As Long) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    ast = ctx->ast
    nodes = ast->nodes
    LowInputSemi = nodes[idx].num
End Function

Function LowStmtInputRun(ctx As *LowerCtx, nVarIdx As Long, nPrompt As Long, semi As Long) As Long
    Dim stackPad(LOW_STACK_PAD - 1) As Byte
    Dim lab As Long
    LowStmtInputRun = 0
    lab = LowEnsureRtInput(ctx)
    If LowStmtInputAll(ctx, nVarIdx, lab, nPrompt, semi) = 0 Then Exit Function
    LowEmitStrCollectSafepoint(ctx)
    LowStmtInputRun = 1
End Function

Function LowStmtInput(ctx As *LowerCtx, idx As Long) As Long
    Dim nVarIdx As Long
    Dim nPrompt As Long
    Dim semi As Long
    LowStmtInput = 0
    nVarIdx = LowInputVarIdx(ctx, idx, nPrompt)
    If nVarIdx < 0 Then ctx->err = 1
    If nVarIdx < 0 Then Exit Function
    semi = LowInputSemi(ctx, idx)
    LowStmtInput = LowStmtInputRun(ctx, nVarIdx, nPrompt, semi)
End Function

Function LowStmtOpen(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(LOW_STACK_PAD - 1) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim lab As Long
    Dim mode As Long
    Dim list As *IrList

    LowStmtOpen = 0
    ast = ctx->ast
    nodes = ast->nodes
    list = ctx->list
    mode = nodes[idx].num
    lstrcpy(VarPtr(name), "BaFileOpen")
    lab = LowFindFunc(ctx, VarPtr(name))
    If lab < 0 Then
        LowPrintErr("error: " + Tr$(1067, "missing 'BaFileOpen' (Include\default\BasicFile.abp)"))
        ctx->err = 1
        Exit Function
    End If
    If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, mode, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
    If TyIs32() <> 0 Then
        IrEmit(list, OP_POP_RDX, 0, 0)
        IrEmit(list, OP_POP_RCX, 0, 0)
    Else
        IrEmit(list, OP_MOV_R8_RAX, 0, 0)
        IrEmit(list, OP_POP_RAX, 0, 0)
        IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
        IrEmit(list, OP_POP_RCX, 0, 0)
    End If
    LowEmitCallLab3(list, lab)
    LowEmitStrCollectSafepoint(ctx)
    LowStmtOpen = 1
End Function

Function LowStmtClose(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(LOW_STACK_PAD - 1) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim lab As Long
    Dim list As *IrList

    LowStmtClose = 0
    ast = ctx->ast
    nodes = ast->nodes
    list = ctx->list
    lstrcpy(VarPtr(name), "BaFileClose")
    lab = LowFindFunc(ctx, VarPtr(name))
    If lab < 0 Then
        LowPrintErr("error: " + Tr$(1068, "missing 'BaFileClose' (Include\default\BasicFile.abp)"))
        ctx->err = 1
        Exit Function
    End If
    If nodes[idx].left < 0 Then
        IrEmit(list, OP_MOV_EAX_IMM, 0, 0)
    Else
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
    End If
    LowEmitCall1Rax(list, 0, 0, VarPtr(name), lab)
    LowEmitStrCollectSafepoint(ctx)
    LowStmtClose = 1
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function LowStmtFInputOne(ctx As *LowerCtx, varIdx As Long, labIn As Long) As boolean
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim list As *IrList

    LowStmtFInputOne = false
    ast = ctx->ast
    nodes = ast->nodes
    list = ctx->list
    If nodes[varIdx].kind = AST_INDEX Or nodes[varIdx].kind = AST_CALL Then
        vTy = LowInputElemTy(ctx, varIdx)
        If vTy < 0 Then Exit Function
        LowEmitCall1Rax(list, 0, 0, 0, labIn)
        LowStmtFInputOne = LowInputElemStore(ctx, varIdx, vTy)
        Exit Function
    End If
    If nodes[varIdx].kind <> AST_VAR Then
        ctx->err = 1
        Exit Function
    End If
    AstCopyName(ast, varIdx, VarPtr(name))
    If Not LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) Then
        ctx->err = 1
        Exit Function
    End If
    If vTy <> TY_STRING And vTy <> TY_LONG And vTy <> TY_BYTE And vTy <> TY_DOUBLE And vTy <> TY_SINGLE Then
        LowPrintErr("error: " + Tr$(1069, "Input # needs String or numeric variable"))
        ctx->err = 1
        Exit Function
    End If
    ' rax = file number（呼び出し側が再設定）
    LowEmitCall1Rax(list, 0, 0, 0, labIn)
    If vTy = TY_LONG And LowTiWide(vTypeIdx) <> 0 Then
        If Not LowEmitInputWide(ctx) Then Exit Function
    Else
        LowEmitInputCvt(ctx, vTy)
    End If
    LowStoreInputVar(ctx, vOff, LowMoveTy(vTy, vTypeIdx), vByRef, vGlob)
    LowStmtFInputOne = true
End Function

Function LowStmtFInput(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(LOW_STACK_PAD - 1) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim lab As Long
    Dim list As *IrList
    Dim cur As Long

    LowStmtFInput = 0
    ast = ctx->ast
    nodes = ast->nodes
    list = ctx->list
    lstrcpy(VarPtr(name), "BaFileInput$")
    lab = LowFindFunc(ctx, VarPtr(name))
    If lab < 0 Then
        LowPrintErr("error: " + Tr$(1070, "missing 'BaFileInput$' (Include\default\BasicFile.abp)"))
        ctx->err = 1
        Exit Function
    End If
    If nodes[idx].left < 0 Then
        ctx->err = 1
        Exit Function
    End If
    cur = nodes[idx].right
    While cur >= 0
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        If Not LowStmtFInputOne(ctx, cur, lab) Then Exit Function
        cur = nodes[cur].nxt
    Wend
    LowEmitStrCollectSafepoint(ctx)
    LowStmtFInput = 1
End Function
