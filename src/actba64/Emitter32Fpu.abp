' Emitter32Fpu - i386 SSE2
' Double の値は edx:eax（上位32:下位32）
' 二項演算の左は [esp] の 8 バイト。命令が spill 8 と合わせて 16 バイト消費する

Sub Emit32MovEspEax(cb As *CodeBuffer)
    EmitByte(cb, &H89)
    EmitByte(cb, &H04)
    EmitByte(cb, &H24)
End Sub

Sub Emit32MovEsp4Edx(cb As *CodeBuffer)
    EmitByte(cb, &H89)
    EmitByte(cb, &H54)
    EmitByte(cb, &H24)
    EmitByte(cb, 4)
End Sub

Sub Emit32SpillRight(cb As *CodeBuffer)
    Emit32SubEsp(cb, 8)
    Emit32MovEspEax(cb)
    Emit32MovEsp4Edx(cb)
End Sub

Sub Emit32MovsdXmm0Esp(cb As *CodeBuffer)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H10)
    EmitByte(cb, &H04)
    EmitByte(cb, &H24)
End Sub

Sub Emit32MovsdXmm0Esp8(cb As *CodeBuffer)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H10)
    EmitByte(cb, &H44)
    EmitByte(cb, &H24)
    EmitByte(cb, 8)
End Sub

Sub Emit32MovsdXmm1Esp(cb As *CodeBuffer)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H10)
    EmitByte(cb, &H0C)
    EmitByte(cb, &H24)
End Sub

Sub Emit32LoadSdPair(cb As *CodeBuffer)
    Emit32SpillRight(cb)
    Emit32MovsdXmm0Esp8(cb)
    Emit32MovsdXmm1Esp(cb)
End Sub

Sub Emit32SdOp(cb As *CodeBuffer, opc As Byte)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H0F)
    EmitByte(cb, opc)
    EmitByte(cb, &HC1)
End Sub

Sub Emit32MovsdEsp8Xmm0(cb As *CodeBuffer)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H11)
    EmitByte(cb, &H44)
    EmitByte(cb, &H24)
    EmitByte(cb, 8)
End Sub

Sub Emit32MovEaxEsp8(cb As *CodeBuffer)
    EmitByte(cb, &H8B)
    EmitByte(cb, &H44)
    EmitByte(cb, &H24)
    EmitByte(cb, 8)
End Sub

Sub Emit32MovEdxEsp12(cb As *CodeBuffer)
    EmitByte(cb, &H8B)
    EmitByte(cb, &H54)
    EmitByte(cb, &H24)
    EmitByte(cb, 12)
End Sub

Sub Emit32TakeSd(cb As *CodeBuffer)
    Emit32MovsdEsp8Xmm0(cb)
    Emit32MovEaxEsp8(cb)
    Emit32MovEdxEsp12(cb)
    Emit32AddEsp(cb, 16)
End Sub

Sub Emit32AddSd(cb As *CodeBuffer)
    Emit32LoadSdPair(cb)
    Emit32SdOp(cb, &H58)
    Emit32TakeSd(cb)
End Sub

Sub Emit32SubSd(cb As *CodeBuffer)
    Emit32LoadSdPair(cb)
    Emit32SdOp(cb, &H5C)
    Emit32TakeSd(cb)
End Sub

Sub Emit32MulSd(cb As *CodeBuffer)
    Emit32LoadSdPair(cb)
    Emit32SdOp(cb, &H59)
    Emit32TakeSd(cb)
End Sub

Sub Emit32DivSd(cb As *CodeBuffer)
    Emit32LoadSdPair(cb)
    Emit32SdOp(cb, &H5E)
    Emit32TakeSd(cb)
End Sub

Sub Emit32UcomisdXmm(cb As *CodeBuffer)
    EmitByte(cb, &H66)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H2E)
    EmitByte(cb, &HC1)
End Sub

Sub Emit32LeaEsp16(cb As *CodeBuffer)
    EmitByte(cb, &H8D)
    EmitByte(cb, &H64)
    EmitByte(cb, &H24)
    EmitByte(cb, 16)
End Sub

Sub Emit32Ucomisd(cb As *CodeBuffer)
    Emit32LoadSdPair(cb)
    Emit32UcomisdXmm(cb)
    Emit32LeaEsp16(cb)
End Sub

Sub Emit32MovsdEspXmm0(cb As *CodeBuffer)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H11)
    EmitByte(cb, &H04)
    EmitByte(cb, &H24)
End Sub

Sub Emit32MovEaxEsp(cb As *CodeBuffer)
    EmitByte(cb, &H8B)
    EmitByte(cb, &H04)
    EmitByte(cb, &H24)
End Sub

Sub Emit32MovEdxEsp4(cb As *CodeBuffer)
    EmitByte(cb, &H8B)
    EmitByte(cb, &H54)
    EmitByte(cb, &H24)
    EmitByte(cb, 4)
End Sub

Sub Emit32TakeSdEsp(cb As *CodeBuffer)
    Emit32MovsdEspXmm0(cb)
    Emit32MovEaxEsp(cb)
    Emit32MovEdxEsp4(cb)
    Emit32AddEsp(cb, 8)
End Sub

Sub Emit32Xmm0ToPair(cb As *CodeBuffer)
    Emit32SubEsp(cb, 8)
    Emit32MovsdEspXmm0(cb)
    Emit32MovEaxEsp(cb)
    Emit32MovEdxEsp4(cb)
    Emit32AddEsp(cb, 8)
End Sub

Sub Emit32CvtI32ToSd(cb As *CodeBuffer)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H2A)
    EmitByte(cb, &HC0)
    Emit32Xmm0ToPair(cb)
End Sub

Sub Emit32SdToXmm0(cb As *CodeBuffer)
    Emit32SpillRight(cb)
    Emit32MovsdXmm0Esp(cb)
    Emit32AddEsp(cb, 8)
End Sub

Sub Emit32CvtSdToI32(cb As *CodeBuffer)
    Emit32SdToXmm0(cb)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H2C)
    EmitByte(cb, &HC0)
End Sub

Sub Emit32NegPrepare(cb As *CodeBuffer)
    EmitXorEax(cb)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H2A)
    EmitByte(cb, &HC0)
End Sub

Sub Emit32NegSd(cb As *CodeBuffer)
    Emit32SpillRight(cb)
    Emit32NegPrepare(cb)
    Emit32MovsdXmm1Esp(cb)
    Emit32SdOp(cb, &H5C)
    Emit32TakeSdEsp(cb)
End Sub

Sub Emit32MovdXmm0Eax(cb As *CodeBuffer)
    EmitByte(cb, &H66)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H6E)
    EmitByte(cb, &HC0)
End Sub

Sub Emit32MovdEaxXmm0(cb As *CodeBuffer)
    EmitByte(cb, &H66)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H7E)
    EmitByte(cb, &HC0)
End Sub

Sub Emit32CvtSsToSd(cb As *CodeBuffer)
    Emit32MovdXmm0Eax(cb)
    EmitByte(cb, &HF3)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H5A)
    EmitByte(cb, &HC0)
    Emit32Xmm0ToPair(cb)
End Sub

Sub Emit32CvtSdToSs(cb As *CodeBuffer)
    Emit32SdToXmm0(cb)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H5A)
    EmitByte(cb, &HC0)
    Emit32MovdEaxXmm0(cb)
End Sub

Sub Emit32MovRaxImm64(cb As *CodeBuffer, lo As DWord, hi As DWord)
    EmitByte(cb, &HB8)
    EmitDword(cb, lo)
    EmitByte(cb, &HBA)
    EmitDword(cb, hi)
End Sub

Sub Emit32MovEdxEbp(cb As *CodeBuffer, disp As Long)
    EmitByte(cb, &H8B)
    EmitByte(cb, &H95)
    EmitDword(cb, disp)
End Sub

Sub Emit32LoadDbl(cb As *CodeBuffer, disp As Long)
    Emit32LoadLocal(cb, disp)
    Emit32MovEdxEbp(cb, disp + 4)
End Sub

Sub Emit32StoreDbl(cb As *CodeBuffer, disp As Long)
    Emit32StoreLocal(cb, disp)
    Emit32StoreLocalEdx(cb, disp + 4)
End Sub

Sub Emit32PushDbl(cb As *CodeBuffer)
    EmitByte(cb, &H52)
    EmitByte(cb, &H50)
End Sub

Sub Emit32PopDbl(cb As *CodeBuffer)
    EmitByte(cb, &H58)
    EmitByte(cb, &H5A)
End Sub

Sub Emit32LoadDblMem(cb As *CodeBuffer)
    EmitByte(cb, &H8B)
    EmitByte(cb, &H50)
    EmitByte(cb, 4)
    EmitByte(cb, &H8B)
    EmitByte(cb, &H00)
End Sub

Sub Emit32StoreDblMem(cb As *CodeBuffer)
    EmitByte(cb, &H89)
    EmitByte(cb, &H01)
    EmitByte(cb, &H89)
    EmitByte(cb, &H51)
    EmitByte(cb, 4)
End Sub

Sub Emit32StoreEspEdx(cb As *CodeBuffer, disp As Long)
    EmitByte(cb, &H89)
    EmitByte(cb, &H94)
    EmitByte(cb, &H24)
    EmitDword(cb, disp)
End Sub

Sub Emit32StoreEspDbl(cb As *CodeBuffer, disp As Long)
    Emit32StoreEspEax(cb, disp)
    Emit32StoreEspEdx(cb, disp + 4)
End Sub
