' AstLowerExit - Exit と重い文の振り分け

Function LowStmtExitLoop(ctx As *LowerCtx, kind As Long) As Long
    LowStmtExitLoop = -1
    If kind = AST_EXITDO Then
        If g_doEndLab < 0 Then
            ctx->err = 1
            LowStmtExitLoop = 0
            Exit Function
        End If
        IrEmit(ctx->list, OP_JMP, g_doEndLab, 0)
        LowStmtExitLoop = 1
        Exit Function
    End If
    If kind = AST_EXITWHILE Then
        If g_whileEndLab < 0 Then
            ctx->err = 1
            LowStmtExitLoop = 0
            Exit Function
        End If
        IrEmit(ctx->list, OP_JMP, g_whileEndLab, 0)
        LowStmtExitLoop = 1
        Exit Function
    End If
    If kind = AST_EXITFOR Then
        If g_forEndLab < 0 Then
            ctx->err = 1
            LowStmtExitLoop = 0
            Exit Function
        End If
        IrEmit(ctx->list, OP_JMP, g_forEndLab, 0)
        LowStmtExitLoop = 1
        Exit Function
    End If
    If kind = AST_EXITFUNC Then
        If g_funcEndLab < 0 Then
            ctx->err = 1
            LowStmtExitLoop = 0
            Exit Function
        End If
        IrEmit(ctx->list, OP_JMP, g_funcEndLab, 0)
        LowStmtExitLoop = 1
    End If
End Function

Function LowStmtExitCont(ctx As *LowerCtx, kind As Long) As Long
    LowStmtExitCont = -1
    If kind = AST_CONTINUEDO Then
        If g_doTopLab < 0 Then
            ctx->err = 1
            LowStmtExitCont = 0
            Exit Function
        End If
        IrEmit(ctx->list, OP_JMP, g_doTopLab, 0)
        LowStmtExitCont = 1
        Exit Function
    End If
    If kind = AST_CONTINUEWHILE Then
        If g_whileTopLab < 0 Then
            ctx->err = 1
            LowStmtExitCont = 0
            Exit Function
        End If
        IrEmit(ctx->list, OP_JMP, g_whileTopLab, 0)
        LowStmtExitCont = 1
        Exit Function
    End If
    If kind = AST_CONTINUEFOR Then
        If g_forContLab < 0 Then
            ctx->err = 1
            LowStmtExitCont = 0
            Exit Function
        End If
        IrEmit(ctx->list, OP_JMP, g_forContLab, 0)
        LowStmtExitCont = 1
    End If
End Function

Function LowStmtExit(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim kind As Long
    Dim r As Long

    LowStmtExit = 0
    ast = ctx->ast
    nodes = ast->nodes
    kind = nodes[idx].kind
    If kind = AST_EXIT Then
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        LowEmitExitEax(ctx)
        LowStmtExit = 1
        Exit Function
    End If
    r = LowStmtExitLoop(ctx, kind)
    If r >= 0 Then
        LowStmtExit = r
        Exit Function
    End If
    r = LowStmtExitCont(ctx, kind)
    If r >= 0 Then
        LowStmtExit = r
        Exit Function
    End If
    If kind = AST_END Then
        LowEmitExitImm(ctx, 0)
        LowStmtExit = 1
    End If
End Function

Function LowStmtIo(ctx As *LowerCtx, idx As Long, kind As Long) As Long
    LowStmtIo = -1
    If kind = AST_PRINT Then
        LowStmtIo = LowStmtPrint(ctx, idx)
        Exit Function
    End If
    If kind = AST_INPUT Then
        LowStmtIo = LowStmtInput(ctx, idx)
        Exit Function
    End If
    If kind = AST_OPEN Then
        LowStmtIo = LowStmtOpen(ctx, idx)
        Exit Function
    End If
    If kind = AST_CLOSE Then
        LowStmtIo = LowStmtClose(ctx, idx)
        Exit Function
    End If
    If kind = AST_FINPUT Then
        LowStmtIo = LowStmtFInput(ctx, idx)
        Exit Function
    End If
    If kind = AST_FIELD Then
        LowStmtIo = LowStmtField(ctx, idx)
        Exit Function
    End If
    If kind = AST_GET Then
        LowStmtIo = LowStmtGet(ctx, idx)
        Exit Function
    End If
    If kind = AST_PUT Then
        LowStmtIo = LowStmtPut(ctx, idx)
        Exit Function
    End If
    If kind = AST_WRITE Then
        LowStmtIo = LowStmtWrite(ctx, idx)
    End If
End Function

Function LowStmtCtrl(ctx As *LowerCtx, idx As Long, kind As Long) As Long
    LowStmtCtrl = 0
    If kind = AST_IF Then
        LowStmtCtrl = LowStmtIf(ctx, idx)
        Exit Function
    End If
    If kind = AST_DO Then
        LowStmtCtrl = LowStmtDo(ctx, idx)
        Exit Function
    End If
    If kind = AST_WHILE Then
        LowStmtCtrl = LowStmtWhile(ctx, idx)
        Exit Function
    End If
    If kind = AST_FOR Then
        LowStmtCtrl = LowStmtFor(ctx, idx)
        Exit Function
    End If
    If kind = AST_WITH Then
        LowStmtCtrl = LowStmtWith(ctx, idx)
        Exit Function
    End If
    Print "error: unsupported statement kind " + Str$(kind)
    ctx->err = 1
End Function

Function LowStmtDispatch(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim kind As Long
    Dim r As Long

    LowStmtDispatch = 0
    If idx < 0 Then
        LowStmtDispatch = 1
        Exit Function
    End If
    ast = ctx->ast
    nodes = ast->nodes
    kind = nodes[idx].kind

    If kind = AST_DIM Then
        LowStmtDispatch = LowStmtDim(ctx, idx)
        Exit Function
    End If
    If kind = AST_CONST Or kind = AST_TYPE Or kind = AST_ENUM Or kind = AST_FUNC Or kind = AST_DECLARE Then
        LowStmtDispatch = 1
        Exit Function
    End If
    If kind = AST_ASSIGN Then
        LowStmtDispatch = LowStmtAssign(ctx, idx)
        Exit Function
    End If
    If kind = AST_INSMENU Then
        LowStmtDispatch = LowStmtInsMenu(ctx, idx)
        Exit Function
    End If
    If kind = AST_CALL Then
        LowStmtDispatch = LowExpr(ctx, idx)
        Exit Function
    End If
    If kind = AST_EXIT Or kind = AST_EXITDO Or kind = AST_EXITWHILE Or kind = AST_EXITFOR Or kind = AST_EXITFUNC Or kind = AST_CONTINUEDO Or kind = AST_CONTINUEWHILE Or kind = AST_CONTINUEFOR Or kind = AST_END Then
        LowStmtDispatch = LowStmtExit(ctx, idx)
        Exit Function
    End If
    r = LowStmtIo(ctx, idx, kind)
    If r < 0 Then
        r = LowStmtCtrl(ctx, idx, kind)
    End If
    LowStmtDispatch = r
End Function
