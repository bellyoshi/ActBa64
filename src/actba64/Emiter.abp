    EmitDword(cb, imm)
End Sub

' cvtsi2ss xmm0, eax / movd eax, xmm0 ― int32 → IEEE Single bits in eax
Sub EmitCvtI32ToSs(cb As *CodeBuffer)
    EmitByte(cb, &HF3)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H2A)
    EmitByte(cb, &HC0)
    EmitByte(cb, &H66)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H7E)
    EmitByte(cb, &HC0)
End Sub

' movq xmm0, rax
Sub EmitMovqXmm0Rax(cb As *CodeBuffer)
    EmitByte(cb, &H66)
    EmitByte(cb, &H48)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H6E)
    EmitByte(cb, &HC0)
End Sub

' movq xmm0, rcx
Sub EmitMovqXmm0Rcx(cb As *CodeBuffer)
    EmitByte(cb, &H66)
    EmitByte(cb, &H48)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H6E)
    EmitByte(cb, &HC1)
End Sub

' movq xmm1, rax
Sub EmitMovqXmm1Rax(cb As *CodeBuffer)
    EmitByte(cb, &H66)
    EmitByte(cb, &H48)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H6E)
    EmitByte(cb, &HC8)
End Sub

' movq rax, xmm0
Sub EmitMovqRaxXmm0(cb As *CodeBuffer)
    EmitByte(cb, &H66)
    EmitByte(cb, &H48)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H7E)
    EmitByte(cb, &HC0)
End Sub

' cvtsi2sd xmm0, eax / movq rax, xmm0
Sub EmitCvtI32ToSd(cb As *CodeBuffer)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H2A)
    EmitByte(cb, &HC0)
    EmitMovqRaxXmm0(cb)
End Sub

' movd xmm0, eax / cvtss2sd xmm0, xmm0 / movq rax, xmm0
Sub EmitCvtSsToSd(cb As *CodeBuffer)
    EmitByte(cb, &H66)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H6E)
    EmitByte(cb, &HC0)
    EmitByte(cb, &HF3)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H5A)
    EmitByte(cb, &HC0)
    EmitMovqRaxXmm0(cb)
End Sub

' addsd xmm0, xmm1 / movq rax, xmm0  (rcx=left, rax=right)
Sub EmitAddSd(cb As *CodeBuffer)
    EmitMovqXmm0Rcx(cb)
    EmitMovqXmm1Rax(cb)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H58)
    EmitByte(cb, &HC1)
    EmitMovqRaxXmm0(cb)
End Sub

Sub EmitSubSd(cb As *CodeBuffer)
    EmitMovqXmm0Rcx(cb)
    EmitMovqXmm1Rax(cb)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H5C)
    EmitByte(cb, &HC1)
    EmitMovqRaxXmm0(cb)
End Sub

Sub EmitMulSd(cb As *CodeBuffer)
    EmitMovqXmm0Rcx(cb)
    EmitMovqXmm1Rax(cb)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H59)
    EmitByte(cb, &HC1)
    EmitMovqRaxXmm0(cb)
End Sub

Sub EmitDivSd(cb As *CodeBuffer)
    EmitMovqXmm0Rcx(cb)
    EmitMovqXmm1Rax(cb)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H5E)
    EmitByte(cb, &HC1)
    EmitMovqRaxXmm0(cb)
End Sub

' ucomisd xmm0, xmm1 (rcx=left, rax=right)
Sub EmitUcomisd(cb As *CodeBuffer)
    EmitMovqXmm0Rcx(cb)
    EmitMovqXmm1Rax(cb)
    EmitByte(cb, &H66)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H2E)
    EmitByte(cb, &HC1)
End Sub

' 0.0 - x  (rax → rax)
Sub EmitNegSd(cb As *CodeBuffer)
    EmitMovqXmm1Rax(cb)
    EmitByte(cb, &H31)
    EmitByte(cb, &HC0)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H2A)
    EmitByte(cb, &HC0)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H5C)
    EmitByte(cb, &HC1)
    EmitMovqRaxXmm0(cb)
End Sub

' cvttsd2si eax, xmm0 (rax in → eax out)
Sub EmitCvtSdToI32(cb As *CodeBuffer)
    EmitMovqXmm0Rax(cb)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H2C)
    EmitByte(cb, &HC0)
End Sub

' jmp rel32 - returns offset of rel32 field for patching
Function EmitJmpRel32(cb As *CodeBuffer) As Long
    EmitByte(cb, &HE9)
    EmitJmpRel32 = cb->size
    EmitDword(cb, 0)
End Function

' jcc rel32
Function EmitJccRel32(cb As *CodeBuffer, cc As Byte) As Long
    EmitByte(cb, &H0F)
    EmitByte(cb, cc)
    EmitJccRel32 = cb->size
    EmitDword(cb, 0)
End Function

Sub EmitMovRaxGs8(cb As *CodeBuffer)
    EmitByte(cb, &H65)
    EmitByte(cb, &H48)
    EmitByte(cb, &H8B)
    EmitByte(cb, &H04)
    EmitByte(cb, &H25)
    EmitDword(cb, 8)
End Sub

Sub EmitMovR8Rsp(cb As *CodeBuffer)
    EmitByte(cb, &H4C)
    EmitByte(cb, &H8B)
    EmitByte(cb, &HC4)
End Sub

Sub EmitCmpR8Rax(cb As *CodeBuffer)
    EmitByte(cb, &H4C)
    EmitByte(cb, &H3B)
    EmitByte(cb, &HC0)
End Sub

Sub EmitAddR8Imm8(cb As *CodeBuffer, imm As Byte)
    EmitByte(cb, &H49)
    EmitByte(cb, &H83)
    EmitByte(cb, &HC0)
    EmitByte(cb, imm)
End Sub
