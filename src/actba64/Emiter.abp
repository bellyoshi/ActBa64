' ===================================================
'  CodeBuffer + x64 emitters (RIP-relative)
' ===================================================

Dim g_IsDebugAsm As Long

Sub WriteAsmLine(s As String)
End Sub

Type CodeBuffer
    buf As *Byte
    capacity As Long
    size As Long
End Type

Sub EmitByte(cb As *CodeBuffer, b As Byte)
    If cb.size >= cb.capacity Then Exit Sub
    cb.buf[cb.size] = b
    cb.size = cb.size + 1
End Sub

Sub EmitDword(cb As *CodeBuffer, dw As DWord)
    If cb.size + 4 > cb.capacity Then Exit Sub
    PutDword(VarPtr(cb.buf[cb.size]), 0, dw)
    cb.size = cb.size + 4
End Sub

Sub EmitCallRip(cb As *CodeBuffer, targetRva As DWord, textBaseRva As DWord)
    Dim nextRip As DWord
    EmitByte(cb, &HFF)
    EmitByte(cb, &H15)
    nextRip = textBaseRva + cb.size + 4
    EmitDword(cb, targetRva - nextRip)
End Sub

Sub EmitLeaRdxRip(cb As *CodeBuffer, targetRva As DWord, textBaseRva As DWord)
    Dim nextRip As DWord
    EmitByte(cb, &H48)
    EmitByte(cb, &H8D)
    EmitByte(cb, &H15)
    nextRip = textBaseRva + cb.size + 4
    EmitDword(cb, targetRva - nextRip)
End Sub

Sub EmitLeaR8Rip(cb As *CodeBuffer, targetRva As DWord, textBaseRva As DWord)
    Dim nextRip As DWord
    EmitByte(cb, &H4C)
    EmitByte(cb, &H8D)
    EmitByte(cb, &H05)
    nextRip = textBaseRva + cb.size + 4
    EmitDword(cb, targetRva - nextRip)
End Sub

' push rbp; mov rbp, rsp; sub rsp, imm32
Sub EmitEnter(cb As *CodeBuffer, frameSize As DWord)
    EmitByte(cb, &H55)
    EmitByte(cb, &H48)
    EmitByte(cb, &H89)
    EmitByte(cb, &HE5)
    EmitByte(cb, &H48)
    EmitByte(cb, &H81)
    EmitByte(cb, &HEC)
    EmitDword(cb, frameSize)
End Sub

' leave; ret  => mov rsp,rbp; pop rbp; ret
Sub EmitLeaveRet(cb As *CodeBuffer)
    EmitByte(cb, &HC9)
    EmitByte(cb, &HC3)
End Sub

Sub EmitSubRsp(cb As *CodeBuffer, imm8 As Byte)
    EmitByte(cb, &H48)
    EmitByte(cb, &H83)
    EmitByte(cb, &HEC)
    EmitByte(cb, imm8)
End Sub

Sub EmitAddRsp(cb As *CodeBuffer, imm8 As Byte)
    EmitByte(cb, &H48)
    EmitByte(cb, &H83)
    EmitByte(cb, &HC4)
    EmitByte(cb, imm8)
End Sub

Sub EmitXorEcx(cb As *CodeBuffer)
    EmitByte(cb, &H31)
    EmitByte(cb, &HC9)
End Sub

Sub EmitXorR9d(cb As *CodeBuffer)
    EmitByte(cb, &H45)
    EmitByte(cb, &H31)
    EmitByte(cb, &HC9)
End Sub

Sub EmitRet(cb As *CodeBuffer)
    EmitByte(cb, &HC3)
End Sub

Sub EmitMovEcxImm(cb As *CodeBuffer, imm As DWord)
    EmitByte(cb, &HB9)
    EmitDword(cb, imm)
End Sub

Sub EmitMovEaxImm(cb As *CodeBuffer, imm As DWord)
    EmitByte(cb, &HB8)
    EmitDword(cb, imm)
End Sub

' mov rax, [rbp + disp32]
Sub EmitLoadLocal(cb As *CodeBuffer, disp As Long)
    EmitByte(cb, &H48)
    EmitByte(cb, &H8B)
    EmitByte(cb, &H85)
    EmitDword(cb, disp)
End Sub

' mov [rbp + disp32], rax
Sub EmitStoreLocal(cb As *CodeBuffer, disp As Long)
    EmitByte(cb, &H48)
    EmitByte(cb, &H89)
    EmitByte(cb, &H85)
    EmitDword(cb, disp)
End Sub

