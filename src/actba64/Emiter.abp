Function EmitCallRel32(cb As *CodeBuffer) As Long
    EmitByte(cb, &HE8)
    EmitCallRel32 = cb.size
    EmitDword(cb, 0)
End Function

' lea rax, [rip+disp32] - returns offset of disp32 for patching
Function EmitLeaRaxLabRel32(cb As *CodeBuffer) As Long
    EmitByte(cb, &H48)
    EmitByte(cb, &H8D)
    EmitByte(cb, &H05)
    EmitLeaRaxLabRel32 = cb.size
    EmitDword(cb, 0)
End Function

' shl ecx, 3
Sub EmitShlEcx3(cb As *CodeBuffer)
    EmitByte(cb, &HC1)
    EmitByte(cb, &HE1)
    EmitByte(cb, 3)
End Sub

' pop rax
Sub EmitPopRax(cb As *CodeBuffer)
    EmitByte(cb, &H58)
End Sub

' pop r8
Sub EmitPopR8(cb As *CodeBuffer)
    EmitByte(cb, &H41)
    EmitByte(cb, &H58)
End Sub

' mov rax, r8
Sub EmitMovRaxR8(cb As *CodeBuffer)
    EmitByte(cb, &H4C)
    EmitByte(cb, &H89)
    EmitByte(cb, &HC0)
End Sub

' mov [rsp+disp32], rax
Sub EmitStoreRspRax(cb As *CodeBuffer, disp As Long)
    EmitByte(cb, &H48)
    EmitByte(cb, &H89)
    EmitByte(cb, &H84)
    EmitByte(cb, &H24)
    EmitDword(cb, disp)
End Sub

