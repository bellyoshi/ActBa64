End Sub

Sub EmitLeaRaxRip(cb As *CodeBuffer, targetRva As DWord, textBaseRva As DWord)
    Dim nextRip As DWord
    EmitByte(cb, &H48)
    EmitByte(cb, &H8D)
    EmitByte(cb, &H05)
    nextRip = textBaseRva + cb.size + 4
    EmitDword(cb, targetRva - nextRip)
End Sub

