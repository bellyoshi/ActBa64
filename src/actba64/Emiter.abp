    EmitByte(cb, &HC0)
End Sub

' add dword [rbp+disp], 1
Sub EmitIncLocal(cb As *CodeBuffer, disp As Long)
    EmitByte(cb, &HFF)
    EmitByte(cb, &H85)
    EmitDword(cb, disp)
End Sub

