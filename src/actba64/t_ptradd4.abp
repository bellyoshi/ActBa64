#console
Declare Function ExitProcess Lib "kernel32.dll" (uExitCode As Long) As Long
#include "ByteCharUtils.abp"
#include "Utils.abp"
Sub Main()
    Dim buf(15) As Byte
    Dim p As *Byte
    Dim q As *Byte
    Dim i As Long
    i = 0
    While i < 16
        buf[i] = 48 + i
        i = i + 1
    Wend
    p = VarPtr(buf)
    PtrAddTo(p, 4, q)
    If q[0] <> 52 Then ExitProcess(10)
    ExitProcess(42)
End Sub
Main()
End
