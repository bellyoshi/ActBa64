' dx_d3d11.sbp - Direct3D 11 cube (6 faces) + matrix transform
' 立方体 6 面（各面を色分け）。拡大縮小 → 回転(Y/X) → 移動 → 簡易透視投影。

Dim g_pVS As *ID3D11VertexShader
Dim g_pPS As *ID3D11PixelShader
Dim g_pVB As *ID3D11Buffer
Dim g_pLayout As *ID3D11InputLayout

' 変換パラメータ（角度はラジアン Double、Sin/Cos にそのまま渡す）
Dim g_tx As Double
Dim g_ty As Double
Dim g_angY As Double
Dim g_angX As Double
Dim g_scale As Double

' 頂点ワーク: (pos3+col4)×36 = 252 floats
Dim g_vdata[251] As Single
Dim g_vertCount As Long

Const CUBE_HALF = 0.4
Const CUBE_VB_BYTES = 1008

Sub dx_ResetXform()
	g_tx = 0
	g_ty = 0
	g_angY = 0.7
	g_angX = 0.5
	g_scale = 1.0
End Sub

Sub dx_StoreSingle(dest As VoidPtr, v As Double)
	Dim s As Single
	s = v
	memcpy(dest, VarPtr(s), 4)
End Sub

' S → Ry → Rx → T → 透視投影
Sub dx_XformPoint(x As Double, y As Double, z As Double, ByRef ox As Double, ByRef oy As Double, ByRef oz As Double)
	Dim sx As Double
	Dim sy As Double
	Dim sz As Double
	Dim cs As Double
	Dim sn As Double
	Dim x1 As Double
	Dim y1 As Double
	Dim z1 As Double
	Dim x2 As Double
	Dim y2 As Double
	Dim z2 As Double
	Dim ez As Double

	sx = x * g_scale
	sy = y * g_scale
	sz = z * g_scale

	cs = Cos(g_angY)
	sn = Sin(g_angY)
	x1 = sx * cs + sz * sn
	y1 = sy
	z1 = sz * cs - sx * sn

	cs = Cos(g_angX)
	sn = Sin(g_angX)
	x2 = x1
	y2 = y1 * cs - z1 * sn
	z2 = y1 * sn + z1 * cs

	x2 = x2 + g_tx
	y2 = y2 + g_ty

	ez = z2 + 2.2
	If ez < 0.4 Then ez = 0.4
	ox = x2 * 1.6 / ez
	oy = y2 * 1.6 / ez
	oz = (ez - 0.4) * 0.2
End Sub

Sub dx_EmitVert(ByRef vi As Long, x As Double, y As Double, z As Double, cr As Double, cg As Double, cb As Double)
	Dim ox As Double
	Dim oy As Double
	Dim oz As Double
	Dim base As Long

	dx_XformPoint(x, y, z, ox, oy, oz)
	base = vi * 7
	dx_StoreSingle(VarPtr(g_vdata[base + 0]), ox)
	dx_StoreSingle(VarPtr(g_vdata[base + 1]), oy)
	dx_StoreSingle(VarPtr(g_vdata[base + 2]), oz)
	dx_StoreSingle(VarPtr(g_vdata[base + 3]), cr)
	dx_StoreSingle(VarPtr(g_vdata[base + 4]), cg)
	dx_StoreSingle(VarPtr(g_vdata[base + 5]), cb)
	dx_StoreSingle(VarPtr(g_vdata[base + 6]), 1.0)
	vi = vi + 1
End Sub

' 三角形 2 枚（Win64 呼び出しは 16 引数超で codegen 制限に触れるため分割）
Sub dx_EmitTri(ByRef vi As Long, x0 As Double, y0 As Double, z0 As Double, x1 As Double, y1 As Double, z1 As Double, x2 As Double, y2 As Double, z2 As Double, cr As Double, cg As Double, cb As Double)
	dx_EmitVert(vi, x0, y0, z0, cr, cg, cb)
	dx_EmitVert(vi, x1, y1, z1, cr, cg, cb)
	dx_EmitVert(vi, x2, y2, z2, cr, cg, cb)
End Sub

Sub dx_BuildVertices()
	Dim vi As Long
	Dim h As Double
	h = CUBE_HALF
	vi = 0
	ZeroMemory(VarPtr(g_vdata[0]), CUBE_VB_BYTES)

	' +Z（赤）
	dx_EmitTri(vi, 0 - h, 0 - h, h, h, 0 - h, h, h, h, h, 1.0, 0.25, 0.25)
	dx_EmitTri(vi, 0 - h, 0 - h, h, h, h, h, 0 - h, h, h, 1.0, 0.25, 0.25)
	' +X（緑）
	dx_EmitTri(vi, h, 0 - h, h, h, 0 - h, 0 - h, h, h, 0 - h, 0.25, 1.0, 0.25)
	dx_EmitTri(vi, h, 0 - h, h, h, h, 0 - h, h, h, h, 0.25, 1.0, 0.25)
	' -Z（青）
	dx_EmitTri(vi, h, 0 - h, 0 - h, 0 - h, 0 - h, 0 - h, 0 - h, h, 0 - h, 0.25, 0.25, 1.0)
	dx_EmitTri(vi, h, 0 - h, 0 - h, 0 - h, h, 0 - h, h, h, 0 - h, 0.25, 0.25, 1.0)
	' -X（黄）
	dx_EmitTri(vi, 0 - h, 0 - h, 0 - h, 0 - h, 0 - h, h, 0 - h, h, h, 1.0, 1.0, 0.25)
	dx_EmitTri(vi, 0 - h, 0 - h, 0 - h, 0 - h, h, h, 0 - h, h, 0 - h, 1.0, 1.0, 0.25)
	' +Y（シアン）
	dx_EmitTri(vi, 0 - h, h, h, h, h, h, h, h, 0 - h, 0.25, 1.0, 1.0)
	dx_EmitTri(vi, 0 - h, h, h, h, h, 0 - h, 0 - h, h, 0 - h, 0.25, 1.0, 1.0)
	' -Y（マゼンタ）
	dx_EmitTri(vi, 0 - h, 0 - h, 0 - h, h, 0 - h, 0 - h, h, 0 - h, h, 1.0, 0.25, 1.0)
	dx_EmitTri(vi, 0 - h, 0 - h, 0 - h, h, 0 - h, h, 0 - h, 0 - h, h, 1.0, 0.25, 1.0)

	g_vertCount = vi
End Sub

Sub dx_UpdateVB()
	If g_pContext = 0 Then Exit Sub
	If g_pVB = 0 Then Exit Sub
	dx_BuildVertices()
	g_pContext->UpdateSubresource(g_pVB, 0, 0, VarPtr(g_vdata[0]), CUBE_VB_BYTES, 0)
End Sub

Sub dx_ReleaseAll()
	dx_ReleaseCom(g_pLayout)
	dx_ReleaseCom(g_pVB)
	dx_ReleaseCom(g_pPS)
	dx_ReleaseCom(g_pVS)
End Sub

Function dx_CreateCubeVB() As Long
	dx_CreateCubeVB = 0
	dx_ResetXform()
	dx_BuildVertices()
	dx_CreateCubeVB = dx_CreateBuffer(CUBE_VB_BYTES, D3D11_BIND_VERTEX_BUFFER, VarPtr(g_vdata[0]), g_pVB)
End Function

Function dx_CreateCube() As Long
	Dim pVSBlob As *ID3DBlob
	dx_CreateCube = 0
	If dx_CreateShaders(dx_PosColorHlsl$(), g_pVS, g_pPS, pVSBlob) = 0 Then Exit Function
	If dx_CreatePosColorLayout(pVSBlob, g_pLayout) = 0 Then Exit Function
	If dx_CreateCubeVB() = 0 Then Exit Function
	dx_CreateCube = 1
End Function

Function dx_LoadSample() As Long
	If dx_CreateCube() = 0 Then
		dx_LoadSample = 0
		Exit Function
	End If
	dx_LoadSample = 1
End Function
#include "dx_d3d11_frame.sbp"
