#console
#include "Utils.abp"
Sub Main()
    Dim arg[260] As Byte
    Dim i As Long
    Dim n As Long
    n = 0
    While n < 5
        If GetCmd(n, arg) = 0 Then
            Print n; "=none"
        Else
            Print n; "=";
            i = 0
            While arg[i] <> 0 And i < 120
                Print Chr$(arg[i]);
                i = i + 1
            Wend
            Print ""
        End If
        n = n + 1
    Wend
End Sub
Main()
End
