#console
#include "ByteCharUtils.abp"
#include "ByteStringUtils.abp"
#include "Utils.abp"
Sub Main()
    Dim arg[260] As Byte
    Dim n As Long
    n = 0
    While GetCmd(n, arg) <> 0
        Print n; ":";
        ' print arg bytes until 0
        Dim i As Long
        i = 0
        While arg[i] <> 0
            Print Chr(arg[i]);
            i = i + 1
            If i > 200 Then Exit While
        Wend
        Print
        n = n + 1
        If n > 20 Then Exit While
    Wend
    ExitProcess(n)
End Sub
Main()
End
