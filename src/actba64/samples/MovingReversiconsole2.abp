' --- split from MovingReversiconsole.abp (part 2) ---
Function CanMove( _
    fromX As Long, _
    fromY As Long, _
    toX As Long, _
    toY As Long, _
    player As Long _
) As Long

    Dim oldFrom As Long
    Dim oldTo As Long

    If IsInside(fromX, fromY) = FALSE Then
        CanMove = FALSE
        Exit Function
    End If

    If IsInside(toX, toY) = FALSE Then
        CanMove = FALSE
        Exit Function
    End If

    If board(fromX, fromY) <> player Then
        CanMove = FALSE
        Exit Function
    End If

    If board(toX, toY) <> EMPTY Then
        CanMove = FALSE
        Exit Function
    End If

    ' A piece moves like a king in chess.
    If Abs(toX - fromX) > 1 Then
        CanMove = FALSE
        Exit Function
    End If

    If Abs(toY - fromY) > 1 Then
        CanMove = FALSE
        Exit Function
    End If

    ' Moving to the same square is not allowed.
    If fromX = toX And fromY = toY Then
        CanMove = FALSE
        Exit Function
    End If

    ' Temporarily move the piece.
    board(fromX, fromY) = EMPTY
    board(toX, toY) = player

    CanMove = CanReverseFrom(toX, toY, player)

    ' Restore the board.
    board(toX, toY) = EMPTY
    board(fromX, fromY) = player

End Function


' ------------------------------------------------------------
' Move a piece.
' ------------------------------------------------------------

Function MovePiece( _
    fromX As Long, _
    fromY As Long, _
    toX As Long, _
    toY As Long, _
    player As Long _
) As Long

    If CanMove(fromX, fromY, toX, toY, player) = FALSE Then

        MovePiece = FALSE
        Exit Function

    End If

    board(fromX, fromY) = EMPTY
    board(toX, toY) = player

    ReversePieces(toX, toY, player)

    MovePiece = TRUE

End Function


' ------------------------------------------------------------
' Check whether the player has at least one legal placement.
' ------------------------------------------------------------

Function HasPlace(player As Long) As Long

    Dim x As Long
    Dim y As Long

    For y = 0 To 7

        For x = 0 To 7

            If CanPlace(x, y, player) Then
                HasPlace = TRUE
                Exit Function
            End If

        Next

    Next

    HasPlace = FALSE

End Function


' ------------------------------------------------------------
' Check whether the player has at least one legal movement.
' ------------------------------------------------------------

Function HasMove(player As Long) As Long

    Dim x As Long
    Dim y As Long
    Dim dir As Long

    Dim toX As Long
    Dim toY As Long

    For y = 0 To 7

        For x = 0 To 7

            If board(x, y) = player Then

                For dir = 0 To 7

                    toX = x + dx(dir)
                    toY = y + dy(dir)

                    If CanMove(x, y, toX, toY, player) Then

                        HasMove = TRUE
                        Exit Function

                    End If

                Next

            End If

        Next

    Next

    HasMove = FALSE

End Function


' ------------------------------------------------------------
' Count pieces.
' ------------------------------------------------------------

Function CountPieces(player As Long) As Long

    Dim x As Long
    Dim y As Long
    Dim count As Long

    count = 0

    For y = 0 To 7

        For x = 0 To 7

            If board(x, y) = player Then
                count = count + 1
            End If

        Next

    Next

    CountPieces = count

End Function

Function UCase$(inputString As String) As String
    Dim i As Integer
    Dim char As String
    Dim result As String

    result = ""

    For i = 1 To Len(inputString)
        char = Mid$(inputString, i, 1)
        If char >= "a" And char <= "z" Then
            char = Chr$(Asc(char) - 32)
        End If
        result = result & char
    Next i

    UCase$ = result
End Function


' ============================================================
' Main program
' ============================================================

InitDirections()
InitBoard()

player = BLACK
passCount = 0

Print "Moving Reversi"
Print "=============="
Print
Print "Commands:"
Print "  P x y          Place a new piece"
Print "  M x1 y1 x2 y2 Move a piece one square"
Print "  Q              Quit"
Print


While passCount < 2

    PrintBoard()

    If player = BLACK Then
        Print "Black turn."
    Else
        Print "White turn."
    End If

    ' Check whether the current player can do anything.
    If HasPlace(player) = FALSE And HasMove(player) = FALSE Then

        Print "No legal move. Pass."
        Print

        passCount = passCount + 1

        player = Opponent(player)

        Continue While

    End If

    passCount = 0

    Print
    Print "Enter command:";

    Input command

    command = UCase$(command)

    If command = "Q" Then
        Exit While
    End If

    ' --------------------------------------------------------
    ' Because INPUT reads one value here, commands are entered
    ' in two steps for simplicity.
    '
    ' Example:
    '
    ' P
    ' 4
    ' 3
    '
    ' or:
    '
    ' M
    ' 4
    ' 4
    ' 5
    ' 5
    ' --------------------------------------------------------

    If command = "P" Then

        Dim x As Long
        Dim y As Long

        Print "X (1-8): ";
        Input x

        Print "Y (1-8): ";
        Input y

        x = x - 1
        y = y - 1

        If PlacePiece(x, y, player) Then

            player = Opponent(player)

        Else

            Print "Illegal placement."

        End If


    ElseIf command = "M" Then

        Dim fromX As Long
        Dim fromY As Long
        Dim toX As Long
        Dim toY As Long

        Print "From X (1-8): ";
        Input fromX

        Print "From Y (1-8): ";
        Input fromY

        Print "To X (1-8): ";
        Input toX

        Print "To Y (1-8): ";
        Input toY

        fromX = fromX - 1
        fromY = fromY - 1

        toX = toX - 1
        toY = toY - 1

        If MovePiece(fromX, fromY, toX, toY, player) Then

            player = Opponent(player)

        Else

            Print "Illegal move."

        End If


    Else

        Print "Unknown command."

    End If

Wend


' ------------------------------------------------------------
' Game result.
' ------------------------------------------------------------

Dim blackCount As Long
Dim whiteCount As Long

blackCount = CountPieces(BLACK)
whiteCount = CountPieces(WHITE)

Print
PrintBoard()

Print "Game Over"
Print

Print "Black: "; blackCount
Print "White: "; whiteCount

If blackCount > whiteCount Then

    Print "Black wins."

ElseIf whiteCount > blackCount Then

    Print "White wins."

Else

    Print "Draw."

End If

Print
Print "Press Enter to exit."

Input command
