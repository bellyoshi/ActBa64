#console
Type Pair
    a As Long
    b As Long
End Type

Sub TouchLong(ByRef x As Long)
    x = x + 1
End Sub

Sub TouchFields(ByRef p As Pair)
    p.a = 11
    p.b = 22
End Sub

Dim n As Long
Dim r As Pair

n = 1
TouchLong(n)
Print "long byref="; n
TouchFields(r)
Print "byref a="; r.a
Print "byref b="; r.b
