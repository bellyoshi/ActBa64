' ============================================================
' Monitors.sbp - モニターの一覧（Screen.Monitors 相当）
' ============================================================

Const MAX_MONITORS = 8

Dim g_monRect[MAX_MONITORS - 1] As RECT
Dim g_monPrimary[MAX_MONITORS - 1] As Long
Dim g_monCount As Long

Function MonEnumProc(hMon As HANDLE, hdc As HDC, lprc As VoidPtr, data As LPARAM) As Long
    Dim mi As MONITORINFO
    MonEnumProc = True
    If g_monCount >= MAX_MONITORS Then Exit Function
    mi.cbSize = SizeOf(MONITORINFO)
    GetMonitorInfoW(hMon, mi)
    MonSetRect(g_monCount, mi.rcMonitor)
    g_monPrimary[g_monCount] = mi.dwFlags And MONITORINFOF_PRIMARY
    g_monCount = g_monCount + 1
End Function

'' 構造体の配列の要素へは、メンバーごとに入れる
Sub MonSetRect(i As Long, ByRef rc As RECT)
    g_monRect[i].left = rc.left
    g_monRect[i].top = rc.top
    g_monRect[i].right = rc.right
    g_monRect[i].bottom = rc.bottom
End Sub

' モニターを数え直す
Sub MonitorsLoad()
    g_monCount = 0
    EnumDisplayMonitors(0, 0, AddressOf(MonEnumProc), 0)
End Sub

' スクリーンに使うモニターの初めの値（メインでない最初のもの。1 台ならメイン）
Function MonitorDefault() As Long
    Dim i As Long
    MonitorDefault = 0
    For i = g_monCount - 1 To 0 Step -1
        If g_monPrimary[i] = 0 Then MonitorDefault = i
    Next
End Function

Function MonitorX(i As Long) As Long
    MonitorX = g_monRect[i].left
End Function

Function MonitorY(i As Long) As Long
    MonitorY = g_monRect[i].top
End Function

Function MonitorW(i As Long) As Long
    MonitorW = g_monRect[i].right - g_monRect[i].left
End Function

Function MonitorH(i As Long) As Long
    MonitorH = g_monRect[i].bottom - g_monRect[i].top
End Function

' メニューに出す名前（"2: 1920 x 1080"、メインなら "（メイン）" を付ける）
Function MonitorName(i As Long) As String
    MonitorName = Str$(i + 1) + ": " + Str$(MonitorW(i)) + " x " + Str$(MonitorH(i))
    If g_monPrimary[i] Then MonitorName = MonitorName + "（メイン）"
End Function
