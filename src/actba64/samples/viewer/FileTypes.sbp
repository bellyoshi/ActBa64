' ============================================================
' FileTypes.sbp - 開けるファイルの種類（ViewerBy2ndFileTypes 相当）
' ============================================================

Const DOC_NONE = 0
Const DOC_IMAGE = 1
Const DOC_PDF = 2

Const VIEWER_FILTER = "PDF / 画像|*.pdf;*.jpg;*.jpeg;*.png;*.bmp|PDF ファイル|*.pdf|画像ファイル|*.jpg;*.jpeg;*.png;*.bmp|すべてのファイル|*.*"

' 英大文字を小文字に（ASCII だけ。写しを作ってから書き換える）
Function ViewerLower(s As String) As String
    Dim t As String, i As Long
    t = Mid$(s, 1, Len(s))
    For i = 0 To Len(t) - 1
        If t[i] >= &H41 And t[i] <= &H5A Then t[i] = t[i] + 32
    Next
    ViewerLower = t
End Function

' 拡張子（"." から。小文字）。無ければ ""
Function ViewerExt(path As String) As String
    Dim i As Long
    i = Len(path)
    While i > 0 And Mid$(path, i, 1) <> "." And FormsIsSep(Mid$(path, i, 1)) = 0
        i = i - 1
    Wend
    ViewerExt = ""
    If i > 0 And Mid$(path, i, 1) = "." Then ViewerExt = ViewerLower(Mid$(path, i, Len(path) - i + 1))
End Function

Function IsImageFile(path As String) As Long
    Dim e As String
    e = ViewerExt(path)
    IsImageFile = (e = ".jpg" Or e = ".jpeg" Or e = ".png" Or e = ".bmp")
End Function

Function IsPdfFile(path As String) As Long
    IsPdfFile = (ViewerExt(path) = ".pdf")
End Function

' ファイルの種類（DOC_*）
Function DocKindOf(path As String) As Long
    DocKindOf = DOC_NONE
    If IsImageFile(path) Then DocKindOf = DOC_IMAGE
    If IsPdfFile(path) Then DocKindOf = DOC_PDF
End Function

Function CanOpen(path As String) As Long
    CanOpen = (DocKindOf(path) <> DOC_NONE)
End Function
