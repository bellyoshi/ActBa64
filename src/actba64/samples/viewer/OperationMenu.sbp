' ============================================================
' OperationMenu.sbp - 操作画面のメニュー（frmOperation の MainMenu 相当）
' ============================================================

Const IDM_OPEN = 2001
Const IDM_EXIT = 2002
Const IDM_ROT000 = 2011
Const IDM_ROT090 = 2012
Const IDM_ROT180 = 2013
Const IDM_ROT270 = 2014
Const IDM_FIRST = 2021
Const IDM_NEXT = 2022
Const IDM_PREV = 2023
Const IDM_LAST = 2024
Const IDM_PAGE = 2025
Const IDM_ZOOMIN = 2031
Const IDM_ZOOMOUT = 2032
Const IDM_ZOOMRATE = 2033
Const IDM_SHOW = 2041
Const IDM_CLOSESCREEN = 2042
Const IDM_BACKGROUND = 2043
Const IDM_BGCOLOR = 2052
Const IDM_AUTO = 2053
Const IDM_ABOUT = 2071
Const IDM_LIST_BASE = 2100          ' ファイル > リスト の i 番目は IDM_LIST_BASE + i
Const IDM_MON_BASE = 2400           ' 設定 > モニター の i 番目は IDM_MON_BASE + i

Dim g_menuBar As HMENU
Dim g_menuList As HMENU             ' ファイル > リスト（ファイルが変わるたびに作り直す）
Dim g_menuMon As HMENU              ' 設定 > スクリーンのモニター

' メニューバーを作る
Function MenuCreateBar() As HMENU
    g_menuBar = CreateMenu()
    AppendMenu(g_menuBar, MF_POPUP, MenuFileMenu() As ULONG_PTR, "ファイル(&F)")
    AppendMenu(g_menuBar, MF_POPUP, MenuViewMenu() As ULONG_PTR, "表示(&V)")
    AppendMenu(g_menuBar, MF_POPUP, MenuSettingMenu() As ULONG_PTR, "設定(&S)")
    AppendMenu(g_menuBar, MF_POPUP, MenuHelpMenu() As ULONG_PTR, "ヘルプ(&H)")
    MenuCreateBar = g_menuBar
End Function

Function MenuFileMenu() As HMENU
    Dim m As HMENU
    m = CreatePopupMenu()
    g_menuList = CreatePopupMenu()
    AppendMenu(m, MF_POPUP, g_menuList As ULONG_PTR, "リスト(&L)")
    AppendMenu(m, MF_STRING, IDM_OPEN, "開く(&O)...")
    AppendMenu(m, MF_SEPARATOR, 0, 0)
    AppendMenu(m, MF_STRING, IDM_EXIT, "終了(&X)")
    MenuFileMenu = m
End Function

Function MenuViewMenu() As HMENU
    Dim m As HMENU
    m = CreatePopupMenu()
    AppendMenu(m, MF_POPUP, MenuRotateMenu() As ULONG_PTR, "回転(&R)")
    AppendMenu(m, MF_POPUP, MenuPageMenu() As ULONG_PTR, "ページ(&P)")
    AppendMenu(m, MF_POPUP, MenuZoomMenu() As ULONG_PTR, "拡大縮小(&Z)")
    AppendMenu(m, MF_POPUP, MenuScreenMenu() As ULONG_PTR, "スクリーン操作(&S)")
    MenuViewMenu = m
End Function

Function MenuRotateMenu() As HMENU
    Dim m As HMENU
    m = CreatePopupMenu()
    AppendMenu(m, MF_STRING, IDM_ROT000, "元の位置")
    AppendMenu(m, MF_STRING, IDM_ROT090, "右へ90°")
    AppendMenu(m, MF_STRING, IDM_ROT180, "180°")
    AppendMenu(m, MF_STRING, IDM_ROT270, "右へ270°")
    MenuRotateMenu = m
End Function

Function MenuPageMenu() As HMENU
    Dim m As HMENU
    m = CreatePopupMenu()
    AppendMenu(m, MF_STRING, IDM_FIRST, "最初のページ")
    AppendMenu(m, MF_STRING, IDM_NEXT, "次のページ")
    AppendMenu(m, MF_STRING, IDM_PREV, "前のページ")
    AppendMenu(m, MF_STRING, IDM_LAST, "最後のページ")
    AppendMenu(m, MF_STRING, IDM_PAGE, "ページを指定...")
    MenuPageMenu = m
End Function

Function MenuZoomMenu() As HMENU
    Dim m As HMENU
    m = CreatePopupMenu()
    AppendMenu(m, MF_STRING, IDM_ZOOMIN, "拡大")
    AppendMenu(m, MF_STRING, IDM_ZOOMOUT, "縮小")
    AppendMenu(m, MF_STRING, IDM_ZOOMRATE, "拡大率を指定...")
    MenuZoomMenu = m
End Function

Function MenuScreenMenu() As HMENU
    Dim m As HMENU
    m = CreatePopupMenu()
    AppendMenu(m, MF_STRING, IDM_SHOW, "スクリーンに表示")
    AppendMenu(m, MF_STRING, IDM_CLOSESCREEN, "表示終了")
    AppendMenu(m, MF_STRING, IDM_BACKGROUND, "背景表示")
    MenuScreenMenu = m
End Function

Function MenuSettingMenu() As HMENU
    Dim m As HMENU
    m = CreatePopupMenu()
    AppendMenu(m, MF_POPUP, MenuMonitorMenu() As ULONG_PTR, "スクリーンのモニター(&M)")
    AppendMenu(m, MF_STRING, IDM_BGCOLOR, "背景色(&C)...")
    AppendMenu(m, MF_STRING, IDM_AUTO, "操作中に自動表示(&A)")
    MenuSettingMenu = m
End Function

Function MenuMonitorMenu() As HMENU
    Dim i As Long
    g_menuMon = CreatePopupMenu()
    For i = 0 To g_monCount - 1
        AppendMenu(g_menuMon, MF_STRING, IDM_MON_BASE + i, MonitorName(i))
    Next
    MenuMonitorMenu = g_menuMon
End Function

Function MenuHelpMenu() As HMENU
    Dim m As HMENU
    m = CreatePopupMenu()
    AppendMenu(m, MF_STRING, IDM_ABOUT, "このアプリについて(&A)")
    MenuHelpMenu = m
End Function

' ファイル > リスト を一覧のファイル名で作り直す
Sub MenuLoadList()
    Dim i As Long, d As *DocFile
    While GetMenuItemCount(g_menuList) > 0
        DeleteMenu(g_menuList, 0, MF_BYPOSITION)
    Wend
    For i = 0 To g_model.Count() - 1
        d = g_model.FileAt(i)
        AppendMenu(g_menuList, MF_STRING, IDM_LIST_BASE + i, ExtractFileName(d->Path()))
    Next
End Sub

' 項目 id を使える / 使えないにする
Sub MenuEnable(id As Long, b As Long)
    If b Then
        EnableMenuItem(g_menuBar, id, MF_BYCOMMAND Or MF_ENABLED)
    Else
        EnableMenuItem(g_menuBar, id, MF_BYCOMMAND Or MF_GRAYED)
    End If
End Sub

Sub MenuCheck(id As Long, b As Long)
    If b Then
        CheckMenuItem(g_menuBar, id, MF_BYCOMMAND Or MF_CHECKED)
    Else
        CheckMenuItem(g_menuBar, id, MF_BYCOMMAND Or MF_UNCHECKED)
    End If
End Sub

' モニターの印を、選んでいるものだけに付ける
Sub MenuCheckMonitor(sel As Long)
    Dim i As Long
    For i = 0 To g_monCount - 1
        MenuCheck(IDM_MON_BASE + i, i = sel)
    Next
End Sub
