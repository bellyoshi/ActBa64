' ============================================================
' ListBox.sbp - 複数選べる一覧の部品（LISTBOX。Lazarus の TListBox）
'
' Forms.sbp の Control を継承する（Windows だけ）。選びかたが変わると、
' フォームの WndProc に WM_COMMAND（HIWORD(wParam) = LBN_SELCHANGE、lParam = Handle）が届く。
' ============================================================

Const LBS_EXTENDEDSEL = &H0800
Const LB_GETSEL = &H0187
Const LB_SETSEL = &H0185
Const LB_GETCOUNT = &H018B

Class ListBox
    Inherits Control
Public
    Override Sub CreateHandle(parent As HWND)
        Dim st As DWord
        st = WS_CHILD Or WS_VISIBLE Or WS_VSCROLL Or LBS_NOTIFY Or LBS_EXTENDEDSEL Or LBS_NOINTEGRALHEIGHT
        Handle = CreateWindowEx(WS_EX_CLIENTEDGE, "LISTBOX", 0, st, Left, Top, Width, Height, parent, 0, GetModuleHandle(0), 0)
        AfterCreate()
    End Sub

    Sub Clear()
        SendMessageW(Handle, LB_RESETCONTENT, 0, 0)
    End Sub

    ' 最後に s（UTF-8）を足す
    Sub AddItem(s As String)
        Dim w[1024] As Byte
        ViewerToWide(s, VarPtr(w[0]) As *Word, 512)
        SendMessageW(Handle, LB_ADDSTRING, 0, VarPtr(w[0]) As LPARAM)
    End Sub

    Function Count() As Long
        Count = SendMessageW(Handle, LB_GETCOUNT, 0, 0) As Long
    End Function

    Function GetSelected(i As Long) As Long
        GetSelected = (SendMessageW(Handle, LB_GETSEL, i, 0) > 0)
    End Function

    Sub SetSelected(i As Long, b As Long)
        Dim v As Long
        v = 0
        If b Then v = 1
        SendMessageW(Handle, LB_SETSEL, v, i)
    End Sub
End Class
