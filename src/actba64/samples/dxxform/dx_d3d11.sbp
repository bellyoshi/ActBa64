' dx_d3d11.sbp - Direct3D 11 matrix transform sample
' 2D アフィン変換（拡大縮小 * 回転 * 移動）で三角形の座標を毎フレーム変換する。
' 角度・座標・色は Double。GPU 頂点バッファへは Single ビット列を memcpy する。

Dim g_pVS As *ID3D11VertexShader
Dim g_pPS As *ID3D11PixelShader
Dim g_pVB As *ID3D11Buffer
Dim g_pLayout As *ID3D11InputLayout

' 変換パラメータ
Dim g_tx As Double
Dim g_ty As Double
Dim g_ang As Double
Dim g_scale As Double

' モデル座標 x,y × 3
Dim g_baseX[2] As Double
Dim g_baseY[2] As Double

' 色（固定）r,g,b,a × 3
Dim g_colR[2] As Double
Dim g_colG[2] As Double
Dim g_colB[2] As Double
Dim g_colA[2] As Double

' 頂点バッファ用ワーク（pos3 + col4）× 3 = 21 floats → 余裕で 27
Dim g_vdata[26] As Single

Sub dx_ResetXform()
	g_tx = 0
	g_ty = 0
	g_ang = 0
	g_scale = 1.0
End Sub

Sub dx_StoreSingle(dest As VoidPtr, v As Double)
	Dim s As Single
	s = v
	memcpy(dest, VarPtr(s), 4)
End Sub

' M = T * R * S  （先に拡大縮小 → 回転 → 移動）
Sub dx_XformPoint(x As Double, y As Double, ByRef ox As Double, ByRef oy As Double)
	Dim sx As Double
	Dim sy As Double
	Dim cs As Double
	Dim sn As Double
	Dim rx As Double
	Dim ry As Double

	sx = x * g_scale
	sy = y * g_scale

	cs = Cos(g_ang)
	sn = Sin(g_ang)
	rx = sx * cs - sy * sn
	ry = sx * sn + sy * cs

	ox = rx + g_tx
	oy = ry + g_ty
End Sub

Sub dx_BuildVertices()
	Dim i As Long
	Dim ox As Double
	Dim oy As Double
	Dim base As Long

	ZeroMemory(VarPtr(g_vdata[0]), 84)
	i = 0
	While i < 3
		dx_XformPoint(g_baseX[i], g_baseY[i], ox, oy)
		base = i * 7
		dx_StoreSingle(VarPtr(g_vdata[base + 0]), ox)
		dx_StoreSingle(VarPtr(g_vdata[base + 1]), oy)
		dx_StoreSingle(VarPtr(g_vdata[base + 2]), 0)
		dx_StoreSingle(VarPtr(g_vdata[base + 3]), g_colR[i])
		dx_StoreSingle(VarPtr(g_vdata[base + 4]), g_colG[i])
		dx_StoreSingle(VarPtr(g_vdata[base + 5]), g_colB[i])
		dx_StoreSingle(VarPtr(g_vdata[base + 6]), g_colA[i])
		i = i + 1
	Wend
End Sub

Sub dx_UpdateVB()
	If g_pContext = 0 Then Exit Sub
	If g_pVB = 0 Then Exit Sub
	dx_BuildVertices()
	g_pContext->UpdateSubresource(g_pVB, 0, 0, VarPtr(g_vdata[0]), 84, 0)
End Sub

Function dx_CompileShader(pSrc As BytePtr, srcLen As DWord, pEntry As BytePtr, pTarget As BytePtr, ByRef ppBlob As *ID3DBlob) As DWord
	Dim pErr As *ID3DBlob
	Dim hr As DWord

	pErr = 0
	hr = D3DCompile(pSrc, srcLen, "triangle.hlsl", 0, 0, pEntry, pTarget, D3DCOMPILE_ENABLE_STRICTNESS, 0, VarPtr(ppBlob), VarPtr(pErr))
	If hr Then
		If pErr Then
			MessageBox(0, pErr->GetBufferPointer(), "dx_fail", MB_OK or MB_ICONSTOP)
			pErr->Release()
		Else
			MessageBox(0, "D3DCompile failed. Check d3dcompiler_47.dll.", "dx_fail", MB_OK or MB_ICONSTOP)
		End If
	End If
	dx_CompileShader = hr
End Function

Sub dx_FailStep(stepName As String, hr As DWord)
	Dim msg As String
	msg = stepName
	msg = msg + " hr="
	msg = msg + Str$(hr)
	MessageBox(0, msg, "dx_fail", MB_OK or MB_ICONSTOP)
End Sub

Sub dx_ReleaseAll()
	If g_pLayout Then
		g_pLayout->Release()
		g_pLayout = 0
	End If
	If g_pVB Then
		g_pVB->Release()
		g_pVB = 0
	End If
	If g_pPS Then
		g_pPS->Release()
		g_pPS = 0
	End If
	If g_pVS Then
		g_pVS->Release()
		g_pVS = 0
	End If
End Sub

Function dx_PosColorHlsl$() As String
	Dim u As String
	Dim hlsl As String
	u = Chr$(95)
	hlsl = "struct VS" + u + "IN{float3 pos:POSITION;float4 col:COLOR;};"
	hlsl = hlsl + "struct VS" + u + "OUT{float4 pos:SV" + u + "POSITION;float4 col:COLOR;};"
	hlsl = hlsl + "VS" + u + "OUT VS(VS" + u + "IN i){VS" + u + "OUT o;o.pos=float4(i.pos,1);o.col=i.col;return o;}"
	hlsl = hlsl + "float4 PS(VS" + u + "OUT i):SV" + u + "Target{return i.col;}"
	dx_PosColorHlsl$ = hlsl
End Function

Function dx_CreatePosColorShaders(ByRef pVSBlob As *ID3DBlob, ByRef vsCode As VoidPtr, ByRef vsLen As DWord) As Long
	Dim hlsl As String
	Dim pPSBlob As *ID3DBlob
	Dim srcLen As DWord
	Dim hr As DWord
	Dim psCode As VoidPtr
	Dim psLen As DWord
	dx_CreatePosColorShaders = 0
	hlsl = dx_PosColorHlsl$()
	pVSBlob = 0
	pPSBlob = 0
	srcLen = Len(hlsl)
	If dx_CompileShader(StrPtr(hlsl), srcLen, StrPtr("VS"), StrPtr("vs_4_0"), pVSBlob) Then Exit Function
	If dx_CompileShader(StrPtr(hlsl), srcLen, StrPtr("PS"), StrPtr("ps_4_0"), pPSBlob) Then
		If pVSBlob Then pVSBlob->Release()
		Exit Function
	End If
	vsCode = pVSBlob->GetBufferPointer()
	vsLen = pVSBlob->GetBufferSize()
	hr = g_pDevice->CreateVertexShader(vsCode, vsLen, 0, VarPtr(g_pVS))
	If hr Then
		dx_FailStep("CreateVertexShader", hr)
		pVSBlob->Release()
		pPSBlob->Release()
		Exit Function
	End If
	psCode = pPSBlob->GetBufferPointer()
	psLen = pPSBlob->GetBufferSize()
	hr = g_pDevice->CreatePixelShader(psCode, psLen, 0, VarPtr(g_pPS))
	If hr Then
		dx_FailStep("CreatePixelShader", hr)
		pVSBlob->Release()
		pPSBlob->Release()
		Exit Function
	End If
	pPSBlob->Release()
	dx_CreatePosColorShaders = 1
End Function

Function dx_CreatePosColorLayout(vsCode As VoidPtr, vsLen As DWord, pVSBlob As *ID3DBlob) As Long
	Dim namePos As String
	Dim nameCol As String
	Dim layout[1] As D3D11_INPUT_ELEMENT_DESC
	Dim tmpDesc As D3D11_INPUT_ELEMENT_DESC
	Dim descSz As DWord
	Dim hr As DWord
	dx_CreatePosColorLayout = 0
	namePos = "POSITION"
	nameCol = "COLOR"
	descSz = Len(tmpDesc)
	ZeroMemory(VarPtr(layout[0]), descSz * 2)
	layout[0].SemanticName = StrPtr(namePos)
	layout[0].SemanticIndex = 0
	layout[0].Format = DXGI_FORMAT_R32G32B32_FLOAT
	layout[0].InputSlot = 0
	layout[0].AlignedByteOffset = 0
	layout[0].InputSlotClass = D3D11_INPUT_PER_VERTEX_DATA
	layout[0].InstanceDataStepRate = 0
	layout[1].SemanticName = StrPtr(nameCol)
	layout[1].SemanticIndex = 0
	layout[1].Format = DXGI_FORMAT_R32G32B32A32_FLOAT
	layout[1].InputSlot = 0
	layout[1].AlignedByteOffset = 12
	layout[1].InputSlotClass = D3D11_INPUT_PER_VERTEX_DATA
	layout[1].InstanceDataStepRate = 0
	hr = g_pDevice->CreateInputLayout(VarPtr(layout[0]), 2, vsCode, vsLen, VarPtr(g_pLayout))
	If hr Then
		dx_FailStep("CreateInputLayout", hr)
		pVSBlob->Release()
		Exit Function
	End If
	pVSBlob->Release()
	dx_CreatePosColorLayout = 1
End Function

Sub dx_InitTriangleModel()
	g_baseX[0] = 0
	g_baseY[0] = 0.5
	g_baseX[1] = 0.5
	g_baseY[1] = -0.5
	g_baseX[2] = -0.5
	g_baseY[2] = -0.5
	g_colR[0] = 1.0
	g_colG[0] = 0.2
	g_colB[0] = 0.2
	g_colA[0] = 1.0
	g_colR[1] = 0.2
	g_colG[1] = 1.0
	g_colB[1] = 0.2
	g_colA[1] = 1.0
	g_colR[2] = 0.2
	g_colG[2] = 0.2
	g_colB[2] = 1.0
	g_colA[2] = 1.0
End Sub

Function dx_CreateTriangleVB() As Long
	Dim bd As D3D11_BUFFER_DESC
	Dim initData As D3D11_SUBRESOURCE_DATA
	Dim hr As DWord
	dx_CreateTriangleVB = 0
	dx_InitTriangleModel()
	dx_ResetXform()
	dx_BuildVertices()
	ZeroMemory(VarPtr(bd), Len(bd))
	ZeroMemory(VarPtr(initData), Len(initData))
	bd.ByteWidth = 84
	bd.Usage = D3D11_USAGE_DEFAULT
	bd.BindFlags = D3D11_BIND_VERTEX_BUFFER
	initData.pSysMem = VarPtr(g_vdata[0])
	hr = g_pDevice->CreateBuffer(VarPtr(bd), VarPtr(initData), VarPtr(g_pVB))
	If hr Then
		dx_FailStep("CreateBuffer VB", hr)
		Exit Function
	End If
	dx_CreateTriangleVB = 1
End Function

Function dx_CreateTriangle() As Long
	Dim pVSBlob As *ID3DBlob
	Dim vsCode As VoidPtr
	Dim vsLen As DWord
	dx_CreateTriangle = 0
	If dx_CreatePosColorShaders(pVSBlob, vsCode, vsLen) = 0 Then Exit Function
	If dx_CreatePosColorLayout(vsCode, vsLen, pVSBlob) = 0 Then Exit Function
	If dx_CreateTriangleVB() = 0 Then Exit Function
	dx_CreateTriangle = 1
End Function

Function dx_LoadSample() As Long
	If dx_CreateTriangle() = 0 Then
		dx_LoadSample = 0
		Exit Function
	End If
	dx_LoadSample = 1
End Function

Sub dx_UpdateInput()
	Dim stepMove As Double
	Dim stepAng As Double
	Dim stepScale As Double
	stepMove = 0.008
	stepAng = 0.035
	stepScale = 0.015

	If dx_KeyDown(VK_LEFT) <> 0 Then g_tx = g_tx - stepMove
	If dx_KeyDown(VK_RIGHT) <> 0 Then g_tx = g_tx + stepMove
	If dx_KeyDown(VK_UP) <> 0 Then g_ty = g_ty + stepMove
	If dx_KeyDown(VK_DOWN) <> 0 Then g_ty = g_ty - stepMove

	If dx_KeyDown(81) <> 0 Then g_ang = g_ang + stepAng
	If dx_KeyDown(69) <> 0 Then g_ang = g_ang - stepAng

	If dx_KeyDown(VK_OEM_PLUS) <> 0 Then g_scale = g_scale + stepScale
	If dx_KeyDown(VK_ADD) <> 0 Then g_scale = g_scale + stepScale
	If dx_KeyDown(VK_OEM_MINUS) <> 0 Then g_scale = g_scale - stepScale
	If dx_KeyDown(VK_SUBTRACT) <> 0 Then g_scale = g_scale - stepScale

	If g_scale < 0.1 Then g_scale = 0.1
	If g_scale > 4.0 Then g_scale = 4.0

	If dx_KeyDown(82) <> 0 Then dx_ResetXform()

	dx_UpdateVB()
End Sub

Sub dx_DrawHelp()
	Dim hdc As HDC
	Dim y As Long
	Dim s As String
	Dim deg As Long

	If hMainWnd = 0 Then Exit Sub
	hdc = GetDC(hMainWnd)
	If hdc = 0 Then Exit Sub

	SelectObject(hdc, hFont_MainWnd)
	SetBkMode(hdc, TRANSPARENT)
	SetTextColor(hdc, &H00FFFF00)

	y = 8
	dx_TextOutUtf8(hdc, 8, y, "[操作方法]")
	y = y + 18
	dx_TextOutUtf8(hdc, 8, y, "矢印 : 移動")
	y = y + 18
	dx_TextOutUtf8(hdc, 8, y, "Q/E  : 回転")
	y = y + 18
	dx_TextOutUtf8(hdc, 8, y, "+/-  : 拡大縮小")
	y = y + 18
	dx_TextOutUtf8(hdc, 8, y, "R    : リセット")
	y = y + 18
	dx_TextOutUtf8(hdc, 8, y, "Esc  : 終了")

	SetTextColor(hdc, &H00FFFFFF)
	y = y + 24
	deg = RadToDeg(g_ang)
	s = "tx=" + Str$(g_tx) + "  ty=" + Str$(g_ty)
	dx_TextOutUtf8(hdc, 8, y, s)
	y = y + 18
	s = "ang=" + Str$(deg) + " deg  scale=" + Str$(g_scale)
	dx_TextOutUtf8(hdc, 8, y, s)

	ReleaseDC(hMainWnd, hdc)
End Sub

Sub dx_Render()
	If g_pContext = 0 Then Exit Sub
	dx_Clear()
	dx_RenderDraw()
	dx_DrawHelp()
	dx_EndScene()
	dx_Present()
End Sub

Sub dx_RenderDraw()
	Dim stride As DWord
	Dim offset As DWord
	stride = 28
	offset = 0

	g_pContext->IASetInputLayout(g_pLayout)
	g_pContext->IASetVertexBuffers(0, 1, VarPtr(g_pVB), VarPtr(stride), VarPtr(offset))
	g_pContext->IASetPrimitiveTopology(D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST)
	g_pContext->VSSetShader(g_pVS, 0, 0)
	g_pContext->PSSetShader(g_pPS, 0, 0)
	g_pContext->Draw(3, 0)
End Sub
