' N88BASIC sample — line / box / circle / ellipse / arc / pie
' Build:
'   .\bin\stage2\actba64.exe .\samples\n88_shapes.abp -o .\samples\n88_shapes.exe
'   .\samples\n88_shapes.exe

#N88BASIC

' 白の四角枠 (B)
Line(40, 40)-(180, 140), 7, B

' 赤の塗りつぶし四角 (BF)
Line(70, 70)-(150, 120), 2, BF

' 水色の円
Circle(320, 90), 50, 5

Sleep(300)

' 黄の横長楕円（比率 0.5）
Circle(480, 90), 60, 6, 0, 0, 0.5

' 緑の塗りつぶし円 (F)
Circle(100, 280), 45, 4, , , , F

' 白の円弧（0 → π）
Circle(280, 280), 55, 7, 0, 3.14

' マゼンタの扇形（負角 + F）
Circle(460, 280), 55, 3, -0.5, -2.5, , F

' 黄の直線
Line(40, 400)-(600, 400), 6

' LP からの続き線（緑）
Line-(300, 450), 4
