#include "dxsample.idx"

If dx_Init(hMainWnd) = 0 Then
	dx_Quit()
	MessageBox(0, "DirectX 11 initialization failed.", "Error", MB_OK or MB_ICONEXCLAMATION)
	ExitProcess(0)
End If

ShowWindow(hMainWnd, SW_SHOW)

Dim msgMain As MSG
Do
	If PeekMessageA(VarPtr(msgMain), 0, 0, 0, PM_REMOVE) Then
		If msgMain.message = WM_QUIT Then Exit Do
		TranslateMessage(VarPtr(msgMain))
		DispatchMessageA(VarPtr(msgMain))
	Else
		dx_Render()
	End If
Loop

dx_Quit()
ExitProcess(msgMain.wParam)
