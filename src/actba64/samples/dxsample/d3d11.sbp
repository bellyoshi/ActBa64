Const D3D11_SDK_VERSION = 7

Const D3D_DRIVER_TYPE_HARDWARE = 1
Const D3D_DRIVER_TYPE_WARP     = 5

Const D3D_FEATURE_LEVEL_10_0 = &HA000
Const D3D_FEATURE_LEVEL_10_1 = &HA100
Const D3D_FEATURE_LEVEL_11_0 = &HB000

Const DXGI_FORMAT_R32G32B32A32_FLOAT = 2
Const DXGI_FORMAT_R32G32B32_FLOAT    = 6
Const DXGI_FORMAT_R8G8B8A8_UNORM     = 28

Const DXGI_USAGE_RENDER_TARGET_OUTPUT = &H20
Const DXGI_SWAP_EFFECT_DISCARD        = 0

Const D3D11_USAGE_DEFAULT      = 0
Const D3D11_BIND_VERTEX_BUFFER = 1

Const D3D11_INPUT_PER_VERTEX_DATA = 0

Const D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST = 4

Const D3DCOMPILE_ENABLE_STRICTNESS = &H800


'--------------
' 構造体
'--------------

Type GUID
	Data1 As DWord
	Data2 As Word
	Data3 As Word
	Data4(7) As Byte
End Type

TypeDef DWordPtr = *DWord
TypeDef SinglePtr = *Single

Type DXGI_RATIONAL
	Numerator As DWord
	Denominator As DWord
End Type

Type DXGI_MODE_DESC
	Width As DWord
	Height As DWord
	RefreshRate As DXGI_RATIONAL
	Format As DWord
	ScanlineOrdering As DWord
	Scaling As DWord
End Type

Type DXGI_SAMPLE_DESC
	Count As DWord
	Quality As DWord
End Type

Type DXGI_SWAP_CHAIN_DESC
	BufferDesc As DXGI_MODE_DESC
	SampleDesc As DXGI_SAMPLE_DESC
	BufferUsage As DWord
	BufferCount As DWord
	OutputWindow As HWND
	Windowed As Long
	SwapEffect As DWord
	Flags As DWord
End Type

Type D3D11_BUFFER_DESC
	ByteWidth As DWord
	Usage As DWord
	BindFlags As DWord
	CPUAccessFlags As DWord
	MiscFlags As DWord
	StructureByteStride As DWord
End Type

Type D3D11_SUBRESOURCE_DATA
	pSysMem As VoidPtr
	SysMemPitch As DWord
	SysMemSlicePitch As DWord
End Type

Type D3D11_INPUT_ELEMENT_DESC
	SemanticName As BytePtr
	SemanticIndex As DWord
	Format As DWord
	InputSlot As DWord
	AlignedByteOffset As DWord
	InputSlotClass As DWord
	InstanceDataStepRate As DWord
End Type

Type D3D11_VIEWPORT
	TopLeftX As Single
	TopLeftY As Single
	Width As Single
	Height As Single
	MinDepth As Single
	MaxDepth As Single
End Type

Type SimpleVertex
	x As Single
	y As Single
	z As Single
	r As Single
	g As Single
	b As Single
	a As Single
End Type


'--------------
' COM インターフェース
'--------------

Class IUnknown
Public
	Virtual Function QueryInterface(ByRef riid As GUID, ppvObject As VoidPtr) As DWord
	Virtual Function AddRef() As DWord
	Virtual Function Release() As DWord
End Class

Class ID3DBlob
	Inherits IUnknown
Public
	Virtual Function GetBufferPointer() As VoidPtr
	Virtual Function GetBufferSize() As DWord
End Class
TypeDef LPID3DBLOB = *ID3DBlob

Class ID3D11Buffer
	Inherits IUnknown
End Class
TypeDef LPID3D11BUFFER = *ID3D11Buffer

Class ID3D11VertexShader
	Inherits IUnknown
End Class
TypeDef LPID3D11VERTEXSHADER = *ID3D11VertexShader

Class ID3D11PixelShader
	Inherits IUnknown
End Class
TypeDef LPID3D11PIXELSHADER = *ID3D11PixelShader

Class ID3D11InputLayout
	Inherits IUnknown
End Class
TypeDef LPID3D11INPUTLAYOUT = *ID3D11InputLayout

Class ID3D11RenderTargetView
	Inherits IUnknown
End Class
TypeDef LPID3D11RENDERTARGETVIEW = *ID3D11RenderTargetView


' IDXGIObject / IDXGIDeviceSubObject / IDXGISwapChain
Class IDXGIObject
	Inherits IUnknown
Public
	Virtual Function SetPrivateData() As DWord
	Virtual Function SetPrivateDataInterface() As DWord
	Virtual Function GetPrivateData() As DWord
	Virtual Function GetParent() As DWord
End Class

Class IDXGIDeviceSubObject
	Inherits IDXGIObject
Public
	Virtual Function GetDevice() As DWord
End Class

Class IDXGISwapChain
	Inherits IDXGIDeviceSubObject
Public
	Virtual Function Present(SyncInterval As DWord, Flags As DWord) As DWord
	Virtual Function GetBuffer(Buffer As DWord, ByRef riid As GUID, ppSurface As VoidPtr) As DWord
End Class
TypeDef LPIDXGISWAPCHAIN = *IDXGISwapChain


' ID3D11Device ?iCreatePixelShader ???B??~????g?p????????j
Class ID3D11Device
	Inherits IUnknown
Public
	Virtual Function CreateBuffer(pDesc As *D3D11_BUFFER_DESC, pInitialData As *D3D11_SUBRESOURCE_DATA, ppBuffer As **ID3D11Buffer) As DWord
	Virtual Function CreateTexture1D() As DWord
	Virtual Function CreateTexture2D() As DWord
	Virtual Function CreateTexture3D() As DWord
	Virtual Function CreateShaderResourceView() As DWord
	Virtual Function CreateUnorderedAccessView() As DWord
	Virtual Function CreateRenderTargetView(pResource As VoidPtr, pDesc As VoidPtr, ppRTView As **ID3D11RenderTargetView) As DWord
	Virtual Function CreateDepthStencilView() As DWord
	Virtual Function CreateInputLayout(pInputElementDescs As *D3D11_INPUT_ELEMENT_DESC, NumElements As DWord, pShaderBytecode As VoidPtr, BytecodeLength As DWord, ppInputLayout As **ID3D11InputLayout) As DWord
	Virtual Function CreateVertexShader(pShaderBytecode As VoidPtr, BytecodeLength As DWord, pClassLinkage As VoidPtr, ppVertexShader As **ID3D11VertexShader) As DWord
	Virtual Function CreateGeometryShader() As DWord
	Virtual Function CreateGeometryShaderWithStreamOutput() As DWord
	Virtual Function CreatePixelShader(pShaderBytecode As VoidPtr, BytecodeLength As DWord, pClassLinkage As VoidPtr, ppPixelShader As **ID3D11PixelShader) As DWord
End Class
TypeDef LPID3D11DEVICE = *ID3D11Device


' ID3D11DeviceChild
Class ID3D11DeviceChild
	Inherits IUnknown
Public
	Virtual Sub GetDevice(ppDevice As VoidPtr)
	Virtual Function GetPrivateData() As DWord
	Virtual Function SetPrivateData() As DWord
	Virtual Function SetPrivateDataInterface() As DWord
End Class

' ID3D11DeviceContext ?iClearRenderTargetView ???j
Class ID3D11DeviceContext
	Inherits ID3D11DeviceChild
Public
	Virtual Sub VSSetConstantBuffers()
	Virtual Sub PSSetShaderResources()
	Virtual Sub PSSetShader(pPixelShader As *ID3D11PixelShader, ppClassInstances As VoidPtr, NumClassInstances As DWord)
	Virtual Sub PSSetSamplers()
	Virtual Sub VSSetShader(pVertexShader As *ID3D11VertexShader, ppClassInstances As VoidPtr, NumClassInstances As DWord)
	Virtual Sub DrawIndexed()
	Virtual Sub Draw(VertexCount As DWord, StartVertexLocation As DWord)
	Virtual Function MapMethod() As DWord
	Virtual Sub Unmap()
	Virtual Sub PSSetConstantBuffers()
	Virtual Sub IASetInputLayout(pInputLayout As *ID3D11InputLayout)
	Virtual Sub IASetVertexBuffers(StartSlot As DWord, NumBuffers As DWord, ppVertexBuffers As **ID3D11Buffer, pStrides As DWordPtr, pOffsets As DWordPtr)
	Virtual Sub IASetIndexBuffer()
	Virtual Sub DrawIndexedInstanced()
	Virtual Sub DrawInstanced()
	Virtual Sub GSSetConstantBuffers()
	Virtual Sub GSSetShader()
	Virtual Sub IASetPrimitiveTopology(Topology As DWord)
	Virtual Sub VSSetShaderResources()
	Virtual Sub VSSetSamplers()
	Virtual Sub BeginQuery()
	Virtual Sub EndQuery()
	Virtual Function GetData() As DWord
	Virtual Sub SetPredication()
	Virtual Sub GSSetShaderResources()
	Virtual Sub GSSetSamplers()
	Virtual Sub OMSetRenderTargets(NumViews As DWord, ppRenderTargetViews As **ID3D11RenderTargetView, pDepthStencilView As VoidPtr)
	Virtual Sub OMSetRenderTargetsAndUnorderedAccessViews()
	Virtual Sub OMSetBlendState()
	Virtual Sub OMSetDepthStencilState()
	Virtual Sub SOSetTargets()
	Virtual Sub DrawAuto()
	Virtual Sub DrawIndexedInstancedIndirect()
	Virtual Sub DrawInstancedIndirect()
	Virtual Sub Dispatch()
	Virtual Sub DispatchIndirect()
	Virtual Sub RSSetState()
	Virtual Sub RSSetViewports(NumViewports As DWord, pViewports As *D3D11_VIEWPORT)
	Virtual Sub RSSetScissorRects()
	Virtual Sub CopySubresourceRegion()
	Virtual Sub CopyResource()
	Virtual Sub UpdateSubresource()
	Virtual Sub CopyStructureCount()
	Virtual Sub ClearRenderTargetView(pRenderTargetView As *ID3D11RenderTargetView, ColorRGBA As SinglePtr)
End Class
TypeDef LPID3D11DEVICECONTEXT = *ID3D11DeviceContext


'--------------
' API
'--------------

Declare Function CoInitialize Lib "ole32.dll" (pvReserved As VoidPtr) As Long
Declare Sub CoUninitialize Lib "ole32.dll" ()

Declare Function D3D11CreateDeviceAndSwapChain Lib "d3d11.dll" (pAdapter As VoidPtr, DriverType As DWord, Software As VoidPtr, Flags As DWord, pFeatureLevels As DWordPtr, FeatureLevels As DWord, SDKVersion As DWord, pSwapChainDesc As *DXGI_SWAP_CHAIN_DESC, ppSwapChain As **IDXGISwapChain, ppDevice As **ID3D11Device, pFeatureLevel As DWordPtr, ppImmediateContext As **ID3D11DeviceContext) As DWord

' Lib name must be <= 16 chars (including .dll). Omit extension so d3dcompiler_47 (15) fits.
Declare Function D3DCompile Lib "d3dcompiler_47" (pSrcData As BytePtr, SrcDataSize As DWord, pSourceName As BytePtr, pDefines As VoidPtr, pInclude As VoidPtr, pEntrypoint As BytePtr, pTarget As BytePtr, Flags1 As DWord, Flags2 As DWord, ppCode As VoidPtr, ppErrorMsgs As VoidPtr) As DWord

Sub ZeroMemory(Destination As VoidPtr, Length As DWord)
	FillMemory(Destination, Length, 0)
End Sub

' Long 値を IEEE754 Single のビット列へ（例: 800 → 800.0f）。ウィンドウサイズ等に使用。
' 注意: (rest * 8388608) / pow2 は 32bit 乗算で溢れるため、先に pow2 で割る。
Function LongToSingleBits(v As Long) As Long
	Dim sign As Long
	Dim u As Long
	Dim hi As Long
	Dim t As Long
	Dim pow2 As Long
	Dim i As Long
	Dim rest As Long
	Dim exp As Long
	Dim mant As Long
	Dim scale As Long

	LongToSingleBits = 0
	If v = 0 Then Exit Function
	sign = 0
	If v < 0 Then
		sign = &H80000000
		u = 0 - v
	Else
		u = v
	End If
	hi = 0
	t = u
	While t > 1
		t = t / 2
		hi = hi + 1
	Wend
	pow2 = 1
	i = 0
	While i < hi
		pow2 = pow2 * 2
		i = i + 1
	Wend
	rest = u - pow2
	exp = hi + 127
	scale = 8388608 / pow2
	mant = rest * scale
	LongToSingleBits = sign Or (exp * 8388608) Or mant
End Function
