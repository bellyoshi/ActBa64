' dx_d3d11.sbp - Direct3D 11 colored triangle sample

Dim g_pVS As *ID3D11VertexShader
Dim g_pPS As *ID3D11PixelShader

Function dx_CompileShader(pSrc As BytePtr, srcLen As DWord, pEntry As BytePtr, pTarget As BytePtr, ByRef ppBlob As *ID3DBlob) As DWord
	Dim pErr As *ID3DBlob
	Dim hr As DWord

	pErr = 0
	hr = D3DCompile(pSrc, srcLen, "triangle.hlsl", 0, 0, pEntry, pTarget, D3DCOMPILE_ENABLE_STRICTNESS, 0, VarPtr(ppBlob), VarPtr(pErr))
	If hr Then
		If pErr Then
			MessageBox(hMainWnd, pErr->GetBufferPointer(), "D3DCompile", MB_OK or MB_ICONSTOP)
			pErr->Release()
		Else
			MessageBox(hMainWnd, "D3DCompile failed. Check d3dcompiler_47.dll.", "Error", MB_OK or MB_ICONSTOP)
		End If
	End If
	dx_CompileShader = hr
End Function

Sub dx_ReleaseAll()
	If g_pPS Then
		g_pPS->Release()
		g_pPS = 0
	End If
	If g_pVS Then
		g_pVS->Release()
		g_pVS = 0
	End If
End Sub

Function dx_TriangleHlsl$() As String
	Dim hlsl As String
	hlsl = "float4 VS(uint id:SV_VertexID):SV_POSITION{"
	hlsl = hlsl + "float2 p=float2(0.0,0.5);"
	hlsl = hlsl + "if(id==1)p=float2(0.5,-0.5);"
	hlsl = hlsl + "if(id==2)p=float2(-0.5,-0.5);"
	hlsl = hlsl + "return float4(p,0.0,1.0);}"
	hlsl = hlsl + "float4 PS():SV_Target{return float4(1.0,0.0,0.0,1.0);}"
	dx_TriangleHlsl$ = hlsl
End Function

Function dx_CreateShadersFromHlsl(hlsl As String) As Long
	Dim pVSBlob As *ID3DBlob
	Dim pPSBlob As *ID3DBlob
	Dim srcLen As DWord
	Dim hr As DWord
	Dim vsCode As VoidPtr
	Dim vsLen As DWord
	Dim psCode As VoidPtr
	Dim psLen As DWord

	dx_CreateShadersFromHlsl = 0
	pVSBlob = 0
	pPSBlob = 0
	srcLen = Len(hlsl)
	If dx_CompileShader(StrPtr(hlsl), srcLen, StrPtr("VS"), StrPtr("vs_4_0"), pVSBlob) Then Exit Function
	If dx_CompileShader(StrPtr(hlsl), srcLen, StrPtr("PS"), StrPtr("ps_4_0"), pPSBlob) Then
		If pVSBlob Then pVSBlob->Release()
		Exit Function
	End If
	vsCode = pVSBlob->GetBufferPointer()
	vsLen = pVSBlob->GetBufferSize()
	hr = g_pDevice->CreateVertexShader(vsCode, vsLen, 0, VarPtr(g_pVS))
	If hr Then
		pVSBlob->Release()
		pPSBlob->Release()
		Exit Function
	End If
	psCode = pPSBlob->GetBufferPointer()
	psLen = pPSBlob->GetBufferSize()
	hr = g_pDevice->CreatePixelShader(psCode, psLen, 0, VarPtr(g_pPS))
	pVSBlob->Release()
	pPSBlob->Release()
	If hr Then Exit Function
	dx_CreateShadersFromHlsl = 1
End Function

Function dx_CreateTriangle() As Long
	dx_CreateTriangle = dx_CreateShadersFromHlsl(dx_TriangleHlsl$())
End Function

Function dx_LoadSample() As Long
	If dx_CreateTriangle() = 0 Then
		MessageBox(hMainWnd, "CreateTriangle resources failed.", "Error", MB_OK or MB_ICONSTOP)
		dx_LoadSample = 0
		Exit Function
	End If
	dx_LoadSample = 1
End Function

Sub dx_Render()
	If g_pContext = 0 Then Exit Sub
	dx_Clear()
	dx_RenderDraw()
	dx_EndScene()
	dx_Present()
End Sub

Sub dx_RenderDraw()
	Dim hello As String
	g_pContext->IASetInputLayout(0)
	g_pContext->IASetPrimitiveTopology(D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST)
	g_pContext->VSSetShader(g_pVS, 0, 0)
	g_pContext->PSSetShader(g_pPS, 0, 0)
	g_pContext->Draw(3, 0)
	hello = "Hello World!"
	dx_DrawText(8, 8, StrPtr(hello), D3DCOLOR_XRGB(255, 255, 255))
End Sub
