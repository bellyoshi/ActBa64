' reversi_gui_draw - 描画とウィンドウ手続き

Sub DrawDisk(hdc As Long, cx As Long, cy As Long, player As Long)
    Dim px As Long
    Dim py As Long
    Dim pen As Long
    Dim brush As Long
    Dim oldPen As Long
    Dim oldBrush As Long
    Dim pad As Long
    px = MARGIN + cx * CELL
    py = MARGIN + cy * CELL
    pad = 4
    If player = BLACK Then
        pen = CreatePen(PS_SOLID, 1, COLOR_BLACK)
        brush = CreateSolidBrush(COLOR_BLACK)
    Else
        pen = CreatePen(PS_SOLID, 2, COLOR_BLACK)
        brush = CreateSolidBrush(COLOR_WHITE)
    End If
    If pen = 0 Then Exit Sub
    If brush = 0 Then
        DeleteObject(pen)
        Exit Sub
    End If
    oldPen = SelectObject(hdc, pen)
    oldBrush = SelectObject(hdc, brush)
    Ellipse(hdc, px + pad, py + pad, px + CELL - pad, py + CELL - pad)
    SelectObject(hdc, oldBrush)
    SelectObject(hdc, oldPen)
    DeleteObject(brush)
    DeleteObject(pen)
End Sub

Sub DrawHint(hdc As Long, cx As Long, cy As Long)
    Dim px As Long
    Dim py As Long
    Dim pen As Long
    Dim brush As Long
    Dim oldPen As Long
    Dim oldBrush As Long
    Dim mid As Long
    px = MARGIN + cx * CELL
    py = MARGIN + cy * CELL
    mid = CELL \ 2
    pen = CreatePen(PS_SOLID, 1, COLOR_HINT)
    brush = CreateSolidBrush(COLOR_HINT)
    If pen = 0 Then Exit Sub
    If brush = 0 Then
        DeleteObject(pen)
        Exit Sub
    End If
    oldPen = SelectObject(hdc, pen)
    oldBrush = SelectObject(hdc, brush)
    Ellipse(hdc, px + mid - 4, py + mid - 4, px + mid + 4, py + mid + 4)
    SelectObject(hdc, oldBrush)
    SelectObject(hdc, oldPen)
    DeleteObject(brush)
    DeleteObject(pen)
End Sub

Sub DrawBoardFrame(hdc As Long)
    Dim i As Long
    Dim pen As Long
    Dim brush As Long
    Dim oldPen As Long
    Dim rc As RECT
    Dim boardPx As Long

    boardPx = CELL * BOARD_SIZE
    rc.left = MARGIN - 2
    rc.top = MARGIN - 2
    rc.right = MARGIN + boardPx + 2
    rc.bottom = MARGIN + boardPx + 2
    brush = CreateSolidBrush(COLOR_BOARD)
    If brush <> 0 Then
        FillRect(hdc, VarPtr(rc), brush)
        DeleteObject(brush)
    End If
    pen = CreatePen(PS_SOLID, 1, COLOR_GRID)
    If pen <> 0 Then
        oldPen = SelectObject(hdc, pen)
        For i = 0 To BOARD_SIZE
            MoveToEx(hdc, MARGIN + i * CELL, MARGIN, 0)
            LineTo(hdc, MARGIN + i * CELL, MARGIN + boardPx)
            MoveToEx(hdc, MARGIN, MARGIN + i * CELL, 0)
            LineTo(hdc, MARGIN + boardPx, MARGIN + i * CELL)
        Next
        SelectObject(hdc, oldPen)
        DeleteObject(pen)
    End If
End Sub

Sub DrawBoardPieces(hdc As Long)
    Dim x As Long
    Dim y As Long
    Dim v As Long
    If GameOver = 0 And CurrentTurn = BLACK Then
        For y = 0 To BOARD_SIZE - 1
            For x = 0 To BOARD_SIZE - 1
                If CanPut(x, y, BLACK) = 1 Then DrawHint(hdc, x, y)
            Next
        Next
    End If
    For y = 0 To BOARD_SIZE - 1
        For x = 0 To BOARD_SIZE - 1
            v = Board(Cell(x, y))
            If v = BLACK Then
                DrawDisk(hdc, x, y, BLACK)
            ElseIf v = WHITE Then
                DrawDisk(hdc, x, y, WHITE)
            End If
        Next
    Next
End Sub

Sub DrawBoard(hdc As Long)
    DrawBoardFrame(hdc)
    DrawBoardPieces(hdc)
End Sub

Sub OnLButtonDown(lParam As Long)
    Dim px As Long
    Dim py As Long
    Dim cx As Long
    Dim cy As Long
    If GameOver <> 0 Then Exit Sub
    If CurrentTurn <> BLACK Then Exit Sub
    px = lParam And 65535
    If px >= 32768 Then px = px - 65536
    py = (lParam \ 65536) And 65535
    If py >= 32768 Then py = py - 65536
    If HitCell(px, py, cx, cy) = 0 Then Exit Sub
    If CanPut(cx, cy, BLACK) = 0 Then Exit Sub
    FlipAndPut(cx, cy, BLACK)
    AdvanceAfterMove()
    UpdateStatus()
    If g_hwnd <> 0 Then InvalidateRect(g_hwnd, ByVal 0, TRUE)
End Sub

Function ReversiWndProc(hWnd As Long, message As DWord, wParam As Long, lParam As Long) As Long
    Dim ps As PAINTSTRUCT
    Dim hdc As Long

    If message = WM_PAINT Then
        hdc = BeginPaint(hWnd, VarPtr(ps))
        DrawBoard(hdc)
        EndPaint(hWnd, VarPtr(ps))
        ReversiWndProc = 0
        Exit Function
    End If
    If message = WM_LBUTTONDOWN Then
        OnLButtonDown(lParam)
        ReversiWndProc = 0
        Exit Function
    End If
    If message = WM_DESTROY Then
        PostQuitMessage(0)
        ReversiWndProc = 0
        Exit Function
    End If
    ReversiWndProc = DefWindowProcA(hWnd, message, wParam, lParam)
End Function

Sub ReversiRun()
    Dim wc As WNDCLASSEX
    Dim hInst As Long
    Dim msg As MSG
    Dim r As Long

    InitDirs()
    InitBoard()

    lstrcpy(VarPtr(g_class), "ActBa64Reversi")
    lstrcpy(VarPtr(g_title), "Reversi")
    hInst = GetModuleHandleA(0)

    FillMemory(VarPtr(wc), SizeOf(WNDCLASSEX), 0)
    wc.cbSize = SizeOf(WNDCLASSEX)
    wc.style = CS_HREDRAW Or CS_VREDRAW
    wc.lpfnWndProc = AddressOf(ReversiWndProc)
    wc.hInstance = hInst
    wc.hCursor = LoadCursorA(0, MAKEINTRESOURCE(IDC_ARROW))
    wc.hbrBackground = GetStockObject(BLACK_BRUSH)
    wc.lpszClassName = VarPtr(g_class)
    RegisterClassExA(VarPtr(wc))

    g_hwnd = CreateWindowExA(0, VarPtr(g_class), VarPtr(g_title), WS_OVERLAPPEDWINDOW Or WS_VISIBLE, 80, 80, WIN_W, WIN_H, 0, 0, hInst, 0)
    If g_hwnd = 0 Then Exit Sub

    UpdateStatus()
    ShowWindow(g_hwnd, SW_SHOW)
    UpdateWindow(g_hwnd)

    Do
        r = GetMessageA(VarPtr(msg), 0, 0, 0)
        If r = 0 Then Exit Do
        If r = -1 Then Exit Do
        TranslateMessage(VarPtr(msg))
        DispatchMessageA(VarPtr(msg))
    Loop
End Sub
