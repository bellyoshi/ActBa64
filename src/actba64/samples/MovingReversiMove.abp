' MovingReversiMove - 駒の移動と着手判定


' ------------------------------------------------------------
' Check whether a piece can move one square.
' ------------------------------------------------------------

Function CanMove( _
    fromX As Long, _
    fromY As Long, _
    toX As Long, _
    toY As Long, _
    player As Long _
) As Long

    Dim oldFrom As Long
    Dim oldTo As Long

    If IsInside(fromX, fromY) = FALSE Then
        CanMove = FALSE
        Exit Function
    End If

    If IsInside(toX, toY) = FALSE Then
        CanMove = FALSE
        Exit Function
    End If

    If board(fromX, fromY) <> player Then
        CanMove = FALSE
        Exit Function
    End If

    If board(toX, toY) <> EMPTY Then
        CanMove = FALSE
        Exit Function
    End If

    ' A piece moves like a king in chess.
    If Abs(toX - fromX) > 1 Then
        CanMove = FALSE
        Exit Function
    End If

    If Abs(toY - fromY) > 1 Then
        CanMove = FALSE
        Exit Function
    End If

    ' Moving to the same square is not allowed.
    If fromX = toX And fromY = toY Then
        CanMove = FALSE
        Exit Function
    End If

    ' Temporarily move the piece.
    board(fromX, fromY) = EMPTY
    board(toX, toY) = player

    CanMove = CanReverseFrom(toX, toY, player)

    ' Restore the board.
    board(toX, toY) = EMPTY
    board(fromX, fromY) = player

End Function


' ------------------------------------------------------------
' Move a piece.
' ------------------------------------------------------------

Function MovePiece( _
    fromX As Long, _
    fromY As Long, _
    toX As Long, _
    toY As Long, _
    player As Long _
) As Long

    If CanMove(fromX, fromY, toX, toY, player) = FALSE Then

        MovePiece = FALSE
        Exit Function

    End If

    board(fromX, fromY) = EMPTY
    board(toX, toY) = player

    ReversePieces(toX, toY, player)

    MovePiece = TRUE

End Function


' ------------------------------------------------------------
' Check whether the player has at least one legal placement.
' ------------------------------------------------------------

Function HasPlace(player As Long) As Long

    Dim x As Long
    Dim y As Long

    For y = 0 To 7

        For x = 0 To 7

            If CanPlace(x, y, player) Then
                HasPlace = TRUE
                Exit Function
            End If

        Next

    Next

    HasPlace = FALSE

End Function


' ------------------------------------------------------------
' Check whether the player has at least one legal movement.
' ------------------------------------------------------------

Function HasMove(player As Long) As Long

    Dim x As Long
    Dim y As Long
    Dim dir As Long

    Dim toX As Long
    Dim toY As Long

    For y = 0 To 7

        For x = 0 To 7

            If board(x, y) = player Then

                For dir = 0 To 7

                    toX = x + dx(dir)
                    toY = y + dy(dir)

                    If CanMove(x, y, toX, toY, player) Then

                        HasMove = TRUE
                        Exit Function

                    End If

                Next

            End If

        Next

    Next

    HasMove = FALSE

End Function


' ------------------------------------------------------------
' Count pieces.
' ------------------------------------------------------------

Function CountPieces(player As Long) As Long

    Dim x As Long
    Dim y As Long
    Dim count As Long

    count = 0

    For y = 0 To 7

        For x = 0 To 7

            If board(x, y) = player Then
                count = count + 1
            End If

        Next

    Next

    CountPieces = count

End Function

Function UCase$(inputString As String) As String
    Dim i As Integer
    Dim char As String
    Dim result As String

    result = ""

    For i = 1 To Len(inputString)
        char = Mid$(inputString, i, 1)
        If char >= "a" And char <= "z" Then
            char = Chr$(Asc(char) - 32)
        End If
        result = result & char
    Next i

    UCase$ = result
End Function
