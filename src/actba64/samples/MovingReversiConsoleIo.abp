' MovingReversiConsoleIo - コンソール版だけが使う表示と入力の補助


' ------------------------------------------------------------
' Print the board.
' B = Black
' W = White
' . = Empty
' ------------------------------------------------------------

Sub PrintBoard()

    Dim x As Long
    Dim y As Long

    Print
    Print "  1 2 3 4 5 6 7 8"

    For y = 0 To 7

        Print y + 1;

        For x = 0 To 7

            Select Case board(x, y)

                Case EMPTY
                    Print " .";

                Case BLACK
                    Print " B";

                Case WHITE
                    Print " W";

            End Select

        Next

        Print

    Next

    Print

End Sub


Function UCase$(inputString As String) As String
    Dim i As Integer
    Dim char As String
    Dim result As String

    result = ""

    For i = 1 To Len(inputString)
        char = Mid$(inputString, i, 1)
        If char >= "a" And char <= "z" Then
            char = Chr$(Asc(char) - 32)
        End If
        result = result & char
    Next i

    UCase$ = result
End Function
