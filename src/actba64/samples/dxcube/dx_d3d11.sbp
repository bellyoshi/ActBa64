' dx_d3d11.sbp - Direct3D 11 cube (8 vertices, index buffer, 3D feel)

Dim g_pVS As *ID3D11VertexShader
Dim g_pPS As *ID3D11PixelShader
Dim g_pVB As *ID3D11Buffer
Dim g_pIB As *ID3D11Buffer
Dim g_pLayout As *ID3D11InputLayout

Dim g_buildRaw[55] As Single
Dim g_buildV[55] As Single
Dim g_buildIdx[35] As DWord

Sub dx_ReleaseAll()
	dx_ReleaseCom(g_pLayout)
	dx_ReleaseCom(g_pIB)
	dx_ReleaseCom(g_pVB)
	dx_ReleaseCom(g_pPS)
	dx_ReleaseCom(g_pVS)
End Sub

Sub dx_FillCubeRawA()
	g_buildRaw[0] = -0.5
	g_buildRaw[1] = -0.5
	g_buildRaw[2] = 0.5
	g_buildRaw[3] = 1.0
	g_buildRaw[4] = 0.0
	g_buildRaw[5] = 0.0
	g_buildRaw[6] = 1.0
	g_buildRaw[7] = 0.5
	g_buildRaw[8] = -0.5
	g_buildRaw[9] = 0.5
	g_buildRaw[10] = 1.0
	g_buildRaw[11] = 1.0
	g_buildRaw[12] = 0.0
	g_buildRaw[13] = 1.0
	g_buildRaw[14] = 0.5
	g_buildRaw[15] = 0.5
	g_buildRaw[16] = 0.5
	g_buildRaw[17] = 0.0
	g_buildRaw[18] = 1.0
	g_buildRaw[19] = 0.0
	g_buildRaw[20] = 1.0
	g_buildRaw[21] = -0.5
	g_buildRaw[22] = 0.5
	g_buildRaw[23] = 0.5
	g_buildRaw[24] = 0.0
	g_buildRaw[25] = 1.0
	g_buildRaw[26] = 1.0
	g_buildRaw[27] = 1.0
End Sub

Sub dx_FillCubeRawB()
	g_buildRaw[28] = -0.5
	g_buildRaw[29] = -0.5
	g_buildRaw[30] = -0.5
	g_buildRaw[31] = 1.0
	g_buildRaw[32] = 0.0
	g_buildRaw[33] = 1.0
	g_buildRaw[34] = 1.0
	g_buildRaw[35] = 0.5
	g_buildRaw[36] = -0.5
	g_buildRaw[37] = -0.5
	g_buildRaw[38] = 1.0
	g_buildRaw[39] = 0.5
	g_buildRaw[40] = 0.0
	g_buildRaw[41] = 1.0
	g_buildRaw[42] = 0.5
	g_buildRaw[43] = 0.5
	g_buildRaw[44] = -0.5
	g_buildRaw[45] = 0.0
	g_buildRaw[46] = 0.0
	g_buildRaw[47] = 1.0
	g_buildRaw[48] = 1.0
	g_buildRaw[49] = -0.5
	g_buildRaw[50] = 0.5
	g_buildRaw[51] = -0.5
	g_buildRaw[52] = 1.0
	g_buildRaw[53] = 1.0
	g_buildRaw[54] = 1.0
	g_buildRaw[55] = 1.0
End Sub

Sub dx_ProjectCubeVerts()
	Dim vi As Long
	Dim x As Single
	Dim y As Single
	Dim z As Single
	vi = 0
	While vi < 8
		x = g_buildRaw[vi * 7 + 0]
		y = g_buildRaw[vi * 7 + 1]
		z = g_buildRaw[vi * 7 + 2]
		g_buildV[vi * 7 + 0] = (x - z) * 0.45
		g_buildV[vi * 7 + 1] = y * 0.55 + (x + z) * 0.2
		g_buildV[vi * 7 + 2] = (z + 1.0) * 0.25
		g_buildV[vi * 7 + 3] = g_buildRaw[vi * 7 + 3]
		g_buildV[vi * 7 + 4] = g_buildRaw[vi * 7 + 4]
		g_buildV[vi * 7 + 5] = g_buildRaw[vi * 7 + 5]
		g_buildV[vi * 7 + 6] = g_buildRaw[vi * 7 + 6]
		vi = vi + 1
	Wend
End Sub

Function dx_CreateCubeVB() As Long
	dx_CreateCubeVB = 0
	ZeroMemory(VarPtr(g_buildRaw[0]), 224)
	ZeroMemory(VarPtr(g_buildV[0]), 224)
	dx_FillCubeRawA()
	dx_FillCubeRawB()
	dx_ProjectCubeVerts()
	dx_CreateCubeVB = dx_CreateBuffer(224, D3D11_BIND_VERTEX_BUFFER, VarPtr(g_buildV[0]), g_pVB)
End Function

Sub dx_PutTri(base As Long, a As DWord, b As DWord, c As DWord)
	g_buildIdx[base] = a
	g_buildIdx[base + 1] = b
	g_buildIdx[base + 2] = c
End Sub

Sub dx_FillCubeIdx()
	ZeroMemory(VarPtr(g_buildIdx[0]), 144)
	dx_PutTri(0, 0, 3, 2)
	dx_PutTri(3, 0, 2, 1)
	dx_PutTri(6, 1, 2, 6)
	dx_PutTri(9, 1, 6, 5)
	dx_PutTri(12, 5, 6, 7)
	dx_PutTri(15, 5, 7, 4)
	dx_PutTri(18, 4, 7, 3)
	dx_PutTri(21, 4, 3, 0)
	dx_PutTri(24, 3, 7, 6)
	dx_PutTri(27, 3, 6, 2)
	dx_PutTri(30, 0, 1, 5)
	dx_PutTri(33, 0, 5, 4)
End Sub

Function dx_CreateCubeIB() As Long
	dx_CreateCubeIB = 0
	dx_FillCubeIdx()
	dx_CreateCubeIB = dx_CreateBuffer(144, D3D11_BIND_INDEX_BUFFER, VarPtr(g_buildIdx[0]), g_pIB)
End Function

Function dx_CreateCube() As Long
	Dim pVSBlob As *ID3DBlob
	dx_CreateCube = 0
	If dx_CreateShaders(dx_PosColorHlsl$(), g_pVS, g_pPS, pVSBlob) = 0 Then Exit Function
	If dx_CreatePosColorLayout(pVSBlob, g_pLayout) = 0 Then Exit Function
	If dx_CreateCubeVB() = 0 Then Exit Function
	If dx_CreateCubeIB() = 0 Then Exit Function
	dx_CreateCube = 1
End Function

Function dx_LoadSample() As Long
	If dx_CreateCube() = 0 Then
		dx_LoadSample = 0
		Exit Function
	End If
	dx_LoadSample = 1
End Function

Sub dx_Render()
	If g_pContext = 0 Then Exit Sub
	dx_Clear()
	dx_RenderDraw()
	dx_EndScene()
	dx_Present()
End Sub

Sub dx_RenderDraw()
	Dim stride As DWord
	Dim offset As DWord
	stride = 28
	offset = 0

	g_pContext->IASetInputLayout(g_pLayout)
	g_pContext->IASetVertexBuffers(0, 1, VarPtr(g_pVB), VarPtr(stride), VarPtr(offset))
	g_pContext->IASetIndexBuffer(g_pIB, DXGI_FORMAT_R32_UINT, 0)
	g_pContext->IASetPrimitiveTopology(D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST)
	g_pContext->VSSetShader(g_pVS, 0, 0)
	g_pContext->PSSetShader(g_pPS, 0, 0)
	g_pContext->DrawIndexed(36, 0, 0)
End Sub
