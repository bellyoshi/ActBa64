' dx_d3d11.sbp - Direct3D 11 per-vertex color triangle sample

Dim g_pVS As *ID3D11VertexShader
Dim g_pPS As *ID3D11PixelShader
Dim g_pVB As *ID3D11Buffer
Dim g_pLayout As *ID3D11InputLayout

Sub dx_ReleaseAll()
	dx_ReleaseCom(g_pLayout)
	dx_ReleaseCom(g_pVB)
	dx_ReleaseCom(g_pPS)
	dx_ReleaseCom(g_pVS)
End Sub

Function dx_CreateTriangleVB() As Long
	Dim vdata[20] As Single
	dx_CreateTriangleVB = 0
	ZeroMemory(VarPtr(vdata[0]), 84)
	vdata[0] = 0.0
	vdata[1] = 0.5
	vdata[2] = 0.0
	vdata[3] = 1.0
	vdata[4] = 0.0
	vdata[5] = 0.0
	vdata[6] = 1.0
	vdata[7] = 0.5
	vdata[8] = -0.5
	vdata[9] = 0.0
	vdata[10] = 0.0
	vdata[11] = 1.0
	vdata[12] = 0.0
	vdata[13] = 1.0
	vdata[14] = -0.5
	vdata[15] = -0.5
	vdata[16] = 0.0
	vdata[17] = 0.0
	vdata[18] = 0.0
	vdata[19] = 1.0
	vdata[20] = 1.0
	dx_CreateTriangleVB = dx_CreateBuffer(84, D3D11_BIND_VERTEX_BUFFER, VarPtr(vdata[0]), g_pVB)
End Function

Function dx_CreateTriangle() As Long
	Dim pVSBlob As *ID3DBlob
	dx_CreateTriangle = 0
	If dx_CreateShaders(dx_PosColorHlsl$(), g_pVS, g_pPS, pVSBlob) = 0 Then Exit Function
	If dx_CreatePosColorLayout(pVSBlob, g_pLayout) = 0 Then Exit Function
	If dx_CreateTriangleVB() = 0 Then Exit Function
	dx_CreateTriangle = 1
End Function

Function dx_LoadSample() As Long
	If dx_CreateTriangle() = 0 Then
		dx_LoadSample = 0
		Exit Function
	End If
	dx_LoadSample = 1
End Function

Sub dx_Render()
	If g_pContext = 0 Then Exit Sub
	dx_Clear()
	dx_RenderDraw()
	dx_EndScene()
	dx_Present()
End Sub

Sub dx_RenderDraw()
	Dim stride As DWord
	Dim offset As DWord
	stride = 28
	offset = 0

	g_pContext->IASetInputLayout(g_pLayout)
	g_pContext->IASetVertexBuffers(0, 1, VarPtr(g_pVB), VarPtr(stride), VarPtr(offset))
	g_pContext->IASetPrimitiveTopology(D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST)
	g_pContext->VSSetShader(g_pVS, 0, 0)
	g_pContext->PSSetShader(g_pPS, 0, 0)
	g_pContext->Draw(3, 0)
End Sub
