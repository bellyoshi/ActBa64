#include "dllcall.idx"

#console

' ↓ ここからプログラムが実行されます

' dllsample.dll の SampleFuncName を呼び出して Print 表示
'   .\bin\stage2\actba64.exe .\samples\dllcall\dllsample\dllsample.pj
'   .\bin\stage2\actba64.exe .\samples\dllcall\dllcall\dllcall.pj

Declare Function SampleFuncName Lib "Dllsample.dll" () As Long

Dim n As Long
n = SampleFuncName()
Print "SampleFuncName()="
Print n
