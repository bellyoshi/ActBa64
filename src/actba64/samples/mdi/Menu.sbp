' File / Window menus. Window は MDI クライアントが子一覧を足す。

Sub MdiBuildMenu()
    g_hMenu = CreateMenu()
    MdiBuildFileMenu()
    MdiBuildWindowMenu()
End Sub

Sub MdiBuildFileMenu()
    Dim h As HMENU
    h = CreatePopupMenu()
    InsMenu h, -1, MF_BYPOSITION, Ex"New(&N)", IDM_NEW, 0, 0
    InsMenu h, -1, MF_BYPOSITION, Ex"Close(&C)", IDM_CLOSE, 0, 0
    InsMenu h, -1, MF_BYPOSITION
    InsMenu h, -1, MF_BYPOSITION, Ex"Exit(&X)", IDM_EXIT, 0, 0
    InsMenu g_hMenu, -1, MF_BYPOSITION, Ex"File(&F)", 0, h, 0
End Sub

Sub MdiBuildWindowMenu()
    Dim h As HMENU
    h = CreatePopupMenu()
    InsMenu h, -1, MF_BYPOSITION, Ex"Cascade(&C)", IDM_CASCADE, 0, 0
    InsMenu h, -1, MF_BYPOSITION, Ex"Tile Horizontal(&H)", IDM_TILEHORZ, 0, 0
    InsMenu h, -1, MF_BYPOSITION, Ex"Tile Vertical(&V)", IDM_TILEVERT, 0, 0
    InsMenu h, -1, MF_BYPOSITION, Ex"Arrange Icons(&A)", IDM_ARRANGE, 0, 0
    InsMenu h, -1, MF_BYPOSITION
    InsMenu g_hMenu, -1, MF_BYPOSITION, Ex"Window(&W)", 0, h, 0
End Sub
