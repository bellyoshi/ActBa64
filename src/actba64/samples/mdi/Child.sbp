' 子ウィンドウは DefMDIChildProc。タイトルをクライアントに描く。

Function ChildProc(hWnd As HWND, message As DWord, wParam As WPARAM, lParam As LPARAM) As LRESULT
    If message = WM_PAINT Then
        ChildProc = ChildPaint(hWnd)
        Exit Function
    End If
    ChildProc = DefMDIChildProc(hWnd, message, wParam, lParam)
End Function

Function ChildPaint(hWnd As HWND) As LRESULT
    Dim ps As PAINTSTRUCT
    Dim hDC As HDC
    hDC = BeginPaint(hWnd, ps)
    ChildDraw(hWnd, hDC)
    EndPaint(hWnd, ps)
    ChildPaint = 0
End Function

Sub ChildDraw(hWnd As HWND, hDC As HDC)
    Dim buf[127] As Byte
    Dim n As Long
    n = GetWindowText(hWnd, VarPtr(buf), 128)
    SetBkMode(hDC, TRANSPARENT)
    TextOut(hDC, 16, 16, VarPtr(buf), n)
    ChildDrawHint(hDC)
End Sub

Sub ChildDrawHint(hDC As HDC)
    TextOut(hDC, 16, 40, "File - New opens another document.", 34)
End Sub
