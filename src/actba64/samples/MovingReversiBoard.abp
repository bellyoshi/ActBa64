' MovingReversiBoard - 盤面、配置、反転


' ------------------------------------------------------------
' Initialize direction vectors.
' ------------------------------------------------------------

Sub InitDirections()

    dx[0] = -1
    dy[0] = -1

    dx[1] = 0
    dy[1] = -1

    dx[2] = 1
    dy[2] = -1

    dx[3] = -1
    dy[3] = 0

    dx[4] = 1
    dy[4] = 0

    dx[5] = -1
    dy[5] = 1

    dx[6] = 0
    dy[6] = 1

    dx[7] = 1
    dy[7] = 1

End Sub


' ------------------------------------------------------------
' Initialize the board.
' ------------------------------------------------------------

Sub InitBoard()

    Dim x As Long
    Dim y As Long

    For y = 0 To 7
        For x = 0 To 7
            board[x, y] = EMPTY
        Next
    Next

    board[3, 3] = WHITE
    board[4, 4] = WHITE

    board[4, 3] = BLACK
    board[3, 4] = BLACK

End Sub


' ------------------------------------------------------------
' Return the opponent color.
' ------------------------------------------------------------

Function Opponent(player As Long) As Long

    If player = BLACK Then
        Opponent = WHITE
    Else
        Opponent = BLACK
    End If

End Function


' ------------------------------------------------------------
' Check whether coordinates are inside the board.
' ------------------------------------------------------------

Function IsInside(x As Long, y As Long) As Long

    If x >= 0 And x < 8 And y >= 0 And y < 8 Then
        IsInside = TRUE
    Else
        IsInside = FALSE
    End If

End Function


' ------------------------------------------------------------
' Print the board.
' B = Black
' W = White
' . = Empty
' ------------------------------------------------------------

Sub PrintBoard()

    Dim x As Long
    Dim y As Long

    Print
    Print "  1 2 3 4 5 6 7 8"

    For y = 0 To 7

        Print y + 1;

        For x = 0 To 7

            Select Case board(x, y)

                Case EMPTY
                    Print " .";

                Case BLACK
                    Print " B";

                Case WHITE
                    Print " W";

            End Select

        Next

        Print

    Next

    Print

End Sub


' ------------------------------------------------------------
' Check whether a piece already located at x,y can flip
' at least one opponent piece.
'
' The square x,y must already contain the player's piece.
' ------------------------------------------------------------

Function CanReverseFrom(x As Long, y As Long, player As Long) As Long

    Dim dir As Long
    Dim nx As Long
    Dim ny As Long
    Dim enemy As Long
    Dim foundEnemy As Long

    enemy = Opponent(player)

    For dir = 0 To 7

        nx = x + dx[dir]
        ny = y + dy[dir]

        foundEnemy = FALSE

        While IsInside(nx, ny)

            If board[nx, ny] = enemy Then

                foundEnemy = TRUE

            ElseIf board[nx, ny] = player Then

                If foundEnemy Then
                    CanReverseFrom = TRUE
                    Exit Function
                End If

                Exit While

            Else

                Exit While

            End If

            nx = nx + dx[dir]
            ny = ny + dy[dir]

        Wend

    Next

    CanReverseFrom = FALSE

End Function


' ------------------------------------------------------------
' Check whether a new piece can be placed.
' ------------------------------------------------------------

Function CanPlace(x As Long, y As Long, player As Long) As Long

    If IsInside(x, y) = FALSE Then
        CanPlace = FALSE
        Exit Function
    End If

    If board[x, y] <> EMPTY Then
        CanPlace = FALSE
        Exit Function
    End If

    board[x, y] = player

    CanPlace = CanReverseFrom(x, y, player)

    board[x, y] = EMPTY

End Function


' ------------------------------------------------------------
' Flip opponent pieces in all valid directions.
'
' This function assumes that board(x,y) already contains
' the player's piece.
' ------------------------------------------------------------

Sub ReversePieces(x As Long, y As Long, player As Long)

    Dim dir As Long
    Dim nx As Long
    Dim ny As Long

    Dim tx[7] As Long
    Dim ty[7] As Long
    Dim count As Long

    Dim enemy As Long
    Dim i As Long

    enemy = Opponent(player)

    For dir = 0 To 7

        nx = x + dx[dir]
        ny = y + dy[dir]

        count = 0

        While IsInside(nx, ny)

            If board[nx, ny] = enemy Then

                tx[count] = nx
                ty[count] = ny
                count = count + 1

            ElseIf board(nx, ny) = player Then

                If count > 0 Then

                    For i = 0 To count - 1
                        board[tx[i], ty[i]] = player
                    Next

                End If

                Exit While

            Else

                Exit While

            End If

            nx = nx + dx(dir)
            ny = ny + dy(dir)

        Wend

    Next

End Sub


' ------------------------------------------------------------
' Place a new piece.
' ------------------------------------------------------------

Function PlacePiece(x As Long, y As Long, player As Long) As Long

    If CanPlace(x, y, player) = FALSE Then

        PlacePiece = FALSE
        Exit Function

    End If

    board(x, y) = player

    ReversePieces(x, y, player)

    PlacePiece = TRUE

End Function
