' ============================================================
' ShogiUnit.sbp - 将棋の盤と規則（Lazarus の ShogiUnit.pas 相当）
'
' 盤は 9x9。X は筋（1〜9、盤の右が 1）、Y は段（1〜9、上が 1）。
' 上（1〜3 段）が後手、下（7〜9 段）が先手の陣。
' 先手かどうか（s）は 1 / 0 で持つ（比較の結果の -1 は入れない）。
' ============================================================

' 駒の種類（Lazarus の TKomaKind）
Const KK_NONE = 0
Const KK_OU = 1         ' 王（先手）
Const KK_GYOKU = 2      ' 玉（後手）
Const KK_HISHA = 3      ' 飛車
Const KK_KAKU = 4       ' 角
Const KK_KIN = 5        ' 金
Const KK_GIN = 6        ' 銀
Const KK_KEI = 7        ' 桂
Const KK_KYO = 8        ' 香
Const KK_FU = 9         ' 歩
Const KK_RYU = 10       ' 龍（飛車の成り）
Const KK_UMA = 11       ' 馬（角の成り）
Const KK_NARIGIN = 12   ' 成銀
Const KK_NARIKEI = 13   ' 成桂
Const KK_NARIKYO = 14   ' 成香
Const KK_TO = 15        ' と（歩の成り）

' 手番（Lazarus の TTurn）
Const TT_SENTE = 0
Const TT_GOTE = 1

' 駒の字。1 字 3 バイト（UTF-8）で KK_* の順
Const SHOGI_KOMA_NAMES = "　王玉飛角金銀桂香歩龍馬全圭杏と"

' ---- 盤の外でも使う小さな関数 ----

Function ShogiAbs(v As Long) As Long
    ShogiAbs = v
    If v < 0 Then ShogiAbs = -v
End Function

Function ShogiSgn(v As Long) As Long
    ShogiSgn = 0
    If v > 0 Then ShogiSgn = 1
    If v < 0 Then ShogiSgn = -1
End Function

' 盤の (x, y) を 0〜80 の番号に
Function ShogiIdx(x As Long, y As Long) As Long
    ShogiIdx = (y - 1) * 9 + x - 1
End Function

Function ShogiInBoard(x As Long, y As Long) As Long
    ShogiInBoard = 0
    If x >= 1 And x <= 9 And y >= 1 And y <= 9 Then ShogiInBoard = 1
End Function

' 前へ進むときの Y の向き（先手は上 = -1、後手は下 = +1）
Function ShogiForwardY(s As Long) As Long
    ShogiForwardY = 1
    If s <> 0 Then ShogiForwardY = -1
End Function

' 駒の字（Lazarus の GetKomaName）
Function ShogiKomaName$(k As Long) As String
    ShogiKomaName$ = Mid$(SHOGI_KOMA_NAMES, k * 3 + 1, 3)
End Function

' 成った駒（成れない駒はそのまま）
Function ShogiNariOf(k As Long) As Long
    ShogiNariOf = k
    If k = KK_HISHA Or k = KK_KAKU Then ShogiNariOf = k + 7
    If k >= KK_GIN And k <= KK_FU Then ShogiNariOf = k + 6
End Function

' 成る前の駒（取った駒を持ち駒にするとき）
Function ShogiMotoOf(k As Long) As Long
    ShogiMotoOf = k
    If k = KK_RYU Or k = KK_UMA Then ShogiMotoOf = k - 7
    If k >= KK_NARIGIN Then ShogiMotoOf = k - 6
End Function

' ---- 駒の動き（dx は筋の差、f は前へ進んだ段の数。後ろは負） ----

' 周りの 8 マスのどれか
Function ShogiIsStep(dx As Long, f As Long) As Long
    ShogiIsStep = 0
    If ShogiAbs(dx) > 1 Or ShogiAbs(f) > 1 Then Exit Function
    If dx <> 0 Or f <> 0 Then ShogiIsStep = 1
End Function

' 金の動き（斜め後ろへは行けない）
Function ShogiKinMove(dx As Long, f As Long) As Long
    ShogiKinMove = 0
    If ShogiIsStep(dx, f) = 0 Then Exit Function
    If dx <> 0 And f = -1 Then Exit Function
    ShogiKinMove = 1
End Function

' 銀の動き（横と真後ろへは行けない）
Function ShogiGinMove(dx As Long, f As Long) As Long
    ShogiGinMove = 0
    If ShogiIsStep(dx, f) = 0 Then Exit Function
    If f = 0 Or (dx = 0 And f = -1) Then Exit Function
    ShogiGinMove = 1
End Function

' 金と同じに動く駒（金・成銀・成桂・成香・と）
Function ShogiIsKinLike(k As Long) As Long
    ShogiIsKinLike = 0
    If k = KK_KIN Or k >= KK_NARIGIN Then ShogiIsKinLike = 1
End Function

' 1 マスずつ動く分（0 以外なら行ける）
Function ShogiStepMove(k As Long, dx As Long, f As Long) As Long
    ShogiStepMove = 0
    If k = KK_FU Then ShogiStepMove = (dx = 0 And f = 1)
    If k = KK_KEI Then ShogiStepMove = (ShogiAbs(dx) = 1 And f = 2)
    If k = KK_GIN Then ShogiStepMove = ShogiGinMove(dx, f)
    If ShogiIsKinLike(k) Then ShogiStepMove = ShogiKinMove(dx, f)
    If k = KK_OU Or k = KK_GYOKU Or k = KK_RYU Or k = KK_UMA Then ShogiStepMove = ShogiIsStep(dx, f)
End Function

' 何マスでも進む分の向きが合っているか（途中の駒は CheckPath で見る）
Function ShogiSlideDir(k As Long, dx As Long, f As Long) As Long
    ShogiSlideDir = 0
    If k = KK_KYO Then ShogiSlideDir = (dx = 0 And f > 0)
    If k = KK_HISHA Or k = KK_RYU Then ShogiSlideDir = ((dx = 0) Xor (f = 0))
    If k = KK_KAKU Or k = KK_UMA Then ShogiSlideDir = (ShogiAbs(dx) = ShogiAbs(f) And dx <> 0)
End Function

' 行き所のない段か（y は先手から見た段。歩・香は 1 段目、桂は 1〜2 段目）
Function ShogiDeadRank(k As Long, s As Long, y As Long) As Long
    Dim r As Long
    r = y
    If s = 0 Then r = 10 - y
    ShogiDeadRank = 0
    If k = KK_FU Or k = KK_KYO Then ShogiDeadRank = (r = 1)
    If k = KK_KEI Then ShogiDeadRank = (r <= 2)
End Function

' 敵陣（先手は 1〜3 段、後手は 7〜9 段）
Function ShogiInZone(s As Long, y As Long) As Long
    ShogiInZone = 0
    If s <> 0 And y <= 3 Then ShogiInZone = 1
    If s = 0 And y >= 7 Then ShogiInZone = 1
End Function

' 初めの並びの 1 段目・9 段目の駒（5 筋が王、外へ金・銀・桂・香）
Function ShogiBackRank(x As Long, s As Long) As Long
    Dim d As Long
    d = ShogiAbs(x - 5)
    ShogiBackRank = KK_KIN + d - 1
    If d = 0 And s <> 0 Then ShogiBackRank = KK_OU
    If d = 0 And s = 0 Then ShogiBackRank = KK_GYOKU
End Function

' ============================================================
' 将棋ゲーム（Lazarus の TShogiGame）
' ============================================================
Class ShogiGame
Private
    kind[80] As Long        ' 盤の駒（ShogiIdx の番号）
    sente[80] As Long       ' 先手の駒なら 1
    mochi[31] As Long       ' 持ち駒の数（先手 16 + 駒、後手 0 + 駒）
    turn As Long            ' TT_SENTE / TT_GOTE

Public
    Sub ShogiGame()
        InitializeBoard()
    End Sub

    ' 初めの並びにする
    Sub InitializeBoard()
        ClearBoard()
        SetupSide(0, 1, 2, 3)       ' 後手（上）
        SetupSide(1, 9, 8, 7)       ' 先手（下）
        turn = TT_SENTE
    End Sub

    Function KindAt(x As Long, y As Long) As Long
        KindAt = KK_NONE
        If ShogiInBoard(x, y) Then KindAt = kind[ShogiIdx(x, y)]
    End Function

    ' 先手の駒なら 1（空きのマスは 0）
    Function SenteAt(x As Long, y As Long) As Long
        SenteAt = 0
        If ShogiInBoard(x, y) Then SenteAt = sente[ShogiIdx(x, y)]
    End Function

    Function GetTurn() As Long
        GetTurn = turn
    End Function

    ' 手番が先手なら 1
    Function TurnIsSente() As Long
        TurnIsSente = 0
        If turn = TT_SENTE Then TurnIsSente = 1
    End Function

    Sub ChangeTurn()
        turn = TT_GOTE - turn
    End Sub

    ' 持ち駒の数（Lazarus の GetMochigoma の 1 種類分）
    Function GetMochi(s As Long, k As Long) As Long
        GetMochi = mochi[s * 16 + k]
    End Function

    Function HasMochigoma(k As Long, s As Long) As Long
        HasMochigoma = 0
        If k >= KK_HISHA And k <= KK_FU And GetMochi(s, k) > 0 Then HasMochigoma = 1
    End Function

    ' 成れるか（動く前か後ろが敵陣で、成れる駒）
    Function CanNaru(k As Long, s As Long, fromY As Long, toY As Long) As Long
        CanNaru = 0
        If ShogiNariOf(k) = k Then Exit Function
        If ShogiInZone(s, fromY) Or ShogiInZone(s, toY) Then CanNaru = 1
    End Function

    ' 成らないと行き所がないか（強制成り）
    Function MustNaru(k As Long, s As Long, toY As Long) As Long
        MustNaru = 0
        If ShogiDeadRank(k, s, toY) Then MustNaru = 1
    End Function

    ' (fx, fy) の駒を (tx, ty) へ動かせるか
    Function IsValidMove(fx As Long, fy As Long, tx As Long, ty As Long) As Long
        Dim s As Long
        s = SenteAt(fx, fy)
        IsValidMove = 0
        If KindAt(fx, fy) = KK_NONE Or ShogiInBoard(tx, ty) = 0 Then Exit Function
        If s <> TurnIsSente() Then Exit Function
        If KindAt(tx, ty) <> KK_NONE And SenteAt(tx, ty) = s Then Exit Function
        IsValidMove = CheckKomaMove(KindAt(fx, fy), s, fx, fy, tx, ty)
    End Function

    ' 駒を動かす。取った駒は持ち駒になる。doNaru が 0 以外なら成る（成れるとき）
    Function MoveKoma(fx As Long, fy As Long, tx As Long, ty As Long, doNaru As Long) As Long
        Dim s As Long
        MoveKoma = 0
        If IsValidMove(fx, fy, tx, ty) = 0 Then Exit Function
        s = SenteAt(fx, fy)
        Capture(tx, ty)
        Place(tx, ty, NaruKind(KindAt(fx, fy), s, fy, ty, doNaru), s)
        Place(fx, fy, KK_NONE, 0)
        MoveKoma = 1
    End Function

    ' 持ち駒を (tx, ty) に打てるか（空き・二歩・行き所のない段）
    Function IsValidDrop(k As Long, tx As Long, ty As Long) As Long
        Dim s As Long
        s = TurnIsSente()
        IsValidDrop = 0
        If HasMochigoma(k, s) = 0 Or IsFree(tx, ty) = 0 Then Exit Function
        If ShogiDeadRank(k, s, ty) Then Exit Function
        If k = KK_FU And CheckNifu(tx, s) <> 0 Then Exit Function
        IsValidDrop = 1
    End Function

    ' 持ち駒を打つ
    Function DropKoma(k As Long, tx As Long, ty As Long) As Long
        Dim s As Long
        DropKoma = 0
        If IsValidDrop(k, tx, ty) = 0 Then Exit Function
        s = TurnIsSente()
        mochi[s * 16 + k] = mochi[s * 16 + k] - 1
        Place(tx, ty, k, s)
        DropKoma = 1
    End Function

Private
    Sub ClearBoard()
        Dim i As Long
        For i = 0 To 80
            kind[i] = KK_NONE
            sente[i] = 0
        Next
        For i = 0 To 31
            mochi[i] = 0
        Next
    End Sub

    ' 片方の駒を並べる（back = 1 段目、mid = 飛角の段、pawn = 歩の段）
    Sub SetupSide(s As Long, back As Long, mid As Long, pawn As Long)
        Dim x As Long, hx As Long
        For x = 1 To 9
            Place(x, back, ShogiBackRank(x, s), s)
            Place(x, pawn, KK_FU, s)
        Next
        hx = 8 - s * 6              ' 飛車は先手 2 筋、後手 8 筋
        Place(hx, mid, KK_HISHA, s)
        Place(10 - hx, mid, KK_KAKU, s)
    End Sub

    Sub Place(x As Long, y As Long, k As Long, s As Long)
        kind[ShogiIdx(x, y)] = k
        sente[ShogiIdx(x, y)] = s
    End Sub

    Function IsFree(x As Long, y As Long) As Long
        IsFree = 0
        If ShogiInBoard(x, y) Then IsFree = (KindAt(x, y) = KK_NONE)
    End Function

    ' (tx, ty) に相手の駒があれば、成る前の駒にして手番の持ち駒へ
    Sub Capture(tx As Long, ty As Long)
        Dim k As Long
        k = ShogiMotoOf(KindAt(tx, ty))
        If k < KK_HISHA Then Exit Sub        ' 空き・王・玉は持ち駒にならない
        mochi[TurnIsSente() * 16 + k] = mochi[TurnIsSente() * 16 + k] + 1
    End Sub

    ' 動いたあとの駒（強制成り・選んだ成り）
    Function NaruKind(k As Long, s As Long, fy As Long, ty As Long, doNaru As Long) As Long
        NaruKind = k
        If MustNaru(k, s, ty) Then NaruKind = ShogiNariOf(k)
        If doNaru <> 0 And CanNaru(k, s, fy, ty) <> 0 Then NaruKind = ShogiNariOf(k)
    End Function

    ' 駒の動きに合っているか（Lazarus の CheckKomaMove）
    Function CheckKomaMove(k As Long, s As Long, fx As Long, fy As Long, tx As Long, ty As Long) As Long
        Dim dx As Long, f As Long
        dx = tx - fx
        f = (ty - fy) * ShogiForwardY(s)
        CheckKomaMove = 0
        If ShogiStepMove(k, dx, f) Then CheckKomaMove = 1
        If ShogiSlideDir(k, dx, f) Then CheckKomaMove = CheckPath(fx, fy, tx, ty)
    End Function

    ' 途中のマスがすべて空きか（飛・角・香・龍・馬）
    Function CheckPath(fx As Long, fy As Long, tx As Long, ty As Long) As Long
        Dim d As Long, i As Long, t As Long
        d = ShogiSgn(ty - fy) * 9 + ShogiSgn(tx - fx)
        i = ShogiIdx(fx, fy) + d
        t = ShogiIdx(tx, ty)
        While i <> t And kind[i] = KK_NONE
            i = i + d
        Wend
        CheckPath = (i = t)
    End Function

    ' 同じ筋に自分の歩（成っていない）があるか
    Function CheckNifu(x As Long, s As Long) As Long
        Dim y As Long
        CheckNifu = 0
        For y = 1 To 9
            If KindAt(x, y) = KK_FU And SenteAt(x, y) = s Then CheckNifu = 1
        Next
    End Function
End Class
