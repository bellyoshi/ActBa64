' ============================================================
' project1 - 将棋（Lazarus の project1.lpr 相当）
'
' 二人で 1 つのマウスを使って指す。王手・詰みの判定はしない。
'
' Build:
'   actba64.exe samples\shogi\project1.abp -o samples\shogi\project1.exe
'   （Windows のみ。盤を GDI で描くので -linux は通らない）
' ============================================================

#include <Forms.sbp>        ' Form / Application / Label
#include "ShogiUnit.sbp"    ' 盤と規則（ShogiGame）
#include "ShogiDraw.sbp"    ' 盤と駒台を描く
#include "Form1.abp"

Dim mainForm As Form1

Application.Initialize()
Application.Run(mainForm)
