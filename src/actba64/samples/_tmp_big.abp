#console
Sub Fill(ByRef n As Long)
    n = n + 1
End Sub
Sub Main()
    Dim raw[4096] As Byte
    Dim n As Long
    Dim i As Long
    n = 0
    raw[0] = 65
    While n < 10
        i = raw[n]
        If i = 0 Then Exit While
        n = n + 1
        If n > 20 Then ExitProcess(99)
    Wend
    Fill(n)
    ExitProcess(n)
End Sub
Main()
End
