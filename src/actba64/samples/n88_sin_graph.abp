' N88BASIC sample — Sin の折れ線グラフ
' Build:
'   .\bin\stage2\actba64.exe .\samples\n88_sin_graph.abp -o .\samples\n88_sin_graph.exe
'   .\samples\n88_sin_graph.exe
'
' 横軸: 0° → 360°（2π）
' 縦軸: sin = -1 … +1（画面では ±150 ドット）

#N88BASIC

Dim i As Long
Dim ang As Long
Dim s As Long
Dim c As Long
Dim x0 As Long
Dim y0 As Long
Dim x1 As Long
Dim y1 As Long
Dim cx As Long
Dim cy As Long
Dim amp As Long
Dim left As Long
Dim width As Long

left = 50
width = 540
cx = left
cy = 240
amp = 160

' 座標枠
Line(left, 40)-(left + width, 440), 7, B

' X 軸（sin=0）
Line(left, cy)-(left + width, cy), 7

' Y 軸
Line(left, 40)-(left, 440), 7

' 目安: +1 / -1
Line(left, cy - amp)-(left + 8, cy - amp), 7
Line(left, cy + amp)-(left + 8, cy + amp), 7

' 目安: 90° / 180° / 270°
Line(left + MathDiv(width, 4), cy - 4)-(left + MathDiv(width, 4), cy + 4), 7
Line(left + MathDiv(width, 2), cy - 4)-(left + MathDiv(width, 2), cy + 4), 7
Line(left + MathDiv(width * 3, 4), cy - 4)-(left + MathDiv(width * 3, 4), cy + 4), 7

' ---- Sin（緑）----
ang = 0
s = Sin(0)
x0 = left
y0 = cy - MathDiv(s * amp, MATH_ONE)
Line(x0, y0)-(x0, y0), 4

i = 1
While i <= 360
    ang = DegToRad(i)
    s = Sin(ang)
    x1 = left + MathDiv(i * width, 360)
    y1 = cy - MathDiv(s * amp, MATH_ONE)
    Line-(x1, y1), 4
    i = i + 1
Wend

Sleep(400)

' ---- Cos（黄）----
ang = 0
c = Cos(0)
x0 = left
y0 = cy - MathDiv(c * amp, MATH_ONE)
Line(x0, y0)-(x0, y0), 6

i = 1
While i <= 360
    ang = DegToRad(i)
    c = Cos(ang)
    x1 = left + MathDiv(i * width, 360)
    y1 = cy - MathDiv(c * amp, MATH_ONE)
    Line-(x1, y1), 6
    i = i + 1
Wend
