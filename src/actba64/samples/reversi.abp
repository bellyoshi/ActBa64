' ActiveBasic 4.x コンソール版リバーシ
#console

Const BOARD_SIZE = 8
Const EMPTY = 0
Const BLACK = 1
Const WHITE = 2

Dim Board(BOARD_SIZE - 1, BOARD_SIZE - 1) As Long
Dim CurrentTurn As Long
Dim dx(7) As Long, dy(7) As Long

' 8方向のベクトルの設定 (dyのインデックスを修正)
dx(0) = -1: dy(0) = -1
dx(1) =  0: dy(1) = -1
dx(2) =  1: dy(2) = -1
dx(3) = -1: dy(3) =  0
dx(4) =  1: dy(4) =  0
dx(5) = -1: dy(5) =  1
dx(6) =  0: dy(6) =  1
dx(7) =  1: dy(7) =  1

Sub InitBoard()
    Dim x As Long, y As Long
    For y = 0 To BOARD_SIZE - 1
        For x = 0 To BOARD_SIZE - 1
            Board(x, y) = EMPTY
        Next x
    Next y
    ' 初期配置
    Board(3, 3) = WHITE: Board(4, 3) = BLACK
    Board(3, 4) = BLACK: Board(4, 4) = WHITE
    CurrentTurn = BLACK
End Sub

Sub DrawBoard()
    Dim x As Long, y As Long
    Print "  0 1 2 3 4 5 6 7"
    For y = 0 To BOARD_SIZE - 1
        Print y; " ";
        For x = 0 To BOARD_SIZE - 1
            Select Case Board(x, y)
                Case EMPTY: Print ". ";
                Case BLACK: Print "O ";
                Case WHITE: Print "X ";
            End Select
        Next x
        Print ""
    Next y
    Print ""
    If CurrentTurn = BLACK Then Print "手番: O (黒)" Else Print "手番: X (白)"
End Sub

Function CanFlipDirection(x As Long, y As Long, dirX As Long, dirY As Long, player As Long) As Long
    Dim opponent As Long
    Dim nx As Long, ny As Long
    Dim count As Long

    If player = BLACK Then opponent = WHITE Else opponent = BLACK
    nx = x + dirX
    ny = y + dirY
    count = 0

    While nx >= 0 And nx < BOARD_SIZE And ny >= 0 And ny < BOARD_SIZE
        If Board(nx, ny) = opponent Then
            count = count + 1
        ElseIf Board(nx, ny) = player Then
            If count > 0 Then
                CanFlipDirection = 1
                Exit Function
            End If
            Exit While
        Else
            Exit While
        End If
        nx = nx + dirX
        ny = ny + dirY
    Wend

    CanFlipDirection = 0
    Exit Function
End Function

Function CanPut(x As Long, y As Long, player As Long) As Long
    Dim i As Long
    If x < 0 Or x >= BOARD_SIZE Or y < 0 Or y >= BOARD_SIZE Then
        CanPut = 0
        Exit Function
    End If
    If Board(x, y) <> EMPTY Then
        CanPut = 0
        Exit Function
    End If

    For i = 0 To 7
        If CanFlipDirection(x, y, dx(i), dy(i), player) = 1 Then
            CanPut = 1
            Exit Function
        End If
    Next i

    CanPut = 0
    Exit Function
End Function

Sub FlipAndPut(x As Long, y As Long, player As Long)
    Dim i As Long, opponent As Long
    Dim nx As Long, ny As Long

    If player = BLACK Then opponent = WHITE Else opponent = BLACK
    Board(x, y) = player

    For i = 0 To 7
        If CanFlipDirection(x, y, dx(i), dy(i), player) = 1 Then
            nx = x + dx(i)
            ny = y + dy(i)
            While Board(nx, ny) = opponent
                Board(nx, ny) = player
                nx = nx + dx(i)
                ny = ny + dy(i)
            Wend
        End If
    Next i
End Sub

' メイン処理
Dim inX As Long, inY As Long

InitBoard()

While 1
    DrawBoard()
    Print "置く位置を入力してください (例: 2 3) / 終了(-1 -1): ";
    Input inX, inY

    If inX = -1 And inY = -1 Then Exit While

    If CanPut(inX, inY, CurrentTurn) = 1 Then
        FlipAndPut(inX, inY, CurrentTurn)
        If CurrentTurn = BLACK Then CurrentTurn = WHITE Else CurrentTurn = BLACK
    Else
        Print "そこには置けません。Key Enter...";
        Input inX
    End If
Wend