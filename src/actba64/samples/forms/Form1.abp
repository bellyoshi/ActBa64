' ============================================================
' Form1 - メインフォーム（Lazarus の unit1.pas + unit1.lfm 相当）
'
' Form の ctor が InitializeComponent() を呼ぶ。
' メッセージを受けるときは Override Function WndProc(...) を足し、
' 扱わないものは Super.WndProc(...) に渡す。
' ============================================================

Class Form1
    Inherits Form
Public

Private
    ' ---- ここからフォームデザイナが生成する部分（unit1.lfm 相当） ----
    Override Sub InitializeComponent()
        Left = 673
        Top = 320
        Width = 320
        Height = 240
        Caption = "Form1"
    End Sub
End Class
