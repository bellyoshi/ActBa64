' ============================================================
' project1 - Form のいちばん小さい例（Lazarus の project1.lpr 相当）
'
' Build:
'   actba64.exe samples\forms\project1.abp -o samples\forms\project1.exe
' ============================================================

#include <Forms.sbp>        ' Form / Application
#include "Form1.abp"

Dim mainForm As Form1       ' Form1 の ctor（Form の ctor）が InitializeComponent を呼ぶ

Application.Initialize()
Application.Run(mainForm)   ' 窓を表示してメッセージループ。閉じたら戻る
