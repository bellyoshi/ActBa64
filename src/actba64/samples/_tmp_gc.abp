#console
Const CH_SP = 32
Const CH_DQUOTE = 34
Sub Tok(rawCmd As *Byte, cmdlen As Long, ByRef n As Long, ctmp As *Byte)
    Dim m As Long
    Dim i As Long
    Dim ch As Long
    m = 0
    i = n
    ch = rawCmd[i]
    If ch = CH_DQUOTE Then
        i = i + 1
        While i < cmdlen
            ch = rawCmd[i]
            If ch = CH_DQUOTE Then Exit While
            If m < 259 Then
                ctmp[m] = rawCmd[i]
                m = m + 1
            End If
            i = i + 1
        Wend
        If i < cmdlen Then
            ch = rawCmd[i]
            If ch = CH_DQUOTE Then i = i + 1
        End If
    Else
        While i < cmdlen
            ch = rawCmd[i]
            If ch = CH_SP Then Exit While
            If m < 259 Then
                ctmp[m] = rawCmd[i]
                m = m + 1
            End If
            i = i + 1
        Wend
    End If
    ctmp[m] = 0
    n = i
End Sub
Function GC(cnt As Long, buf As *Byte) As Long
    Dim rawCmd[4096] As Byte
    Dim cmdlen As Long
    Dim cidx As Long
    Dim ctmp[260] As Byte
    Dim n As Long
    Dim ch As Long
    Dim cmd As *Byte
    cmd = GetCommandLineA()
    cmdlen = lstrlenA(cmd)
    If cmdlen > 4094 Then cmdlen = 4094
    memcpy(VarPtr(rawCmd), cmd, cmdlen)
    rawCmd[cmdlen] = 0
    cidx = 0
    n = 0
    While n < cmdlen
        While n < cmdlen
            ch = rawCmd[n]
            If ch <> CH_SP Then Exit While
            n = n + 1
        Wend
        If n >= cmdlen Then Exit While
        Tok(VarPtr(rawCmd), cmdlen, n, VarPtr(ctmp))
        If cidx = cnt Then
            lstrcpyA(buf, ctmp)
            GC = 1
            Exit Function
        End If
        cidx = cidx + 1
    Wend
    GC = 0
End Function
Sub Main()
    Dim arg[260] As Byte
    Dim n As Long
    n = 0
    While GC(n, arg) <> 0
        n = n + 1
        If n > 20 Then ExitProcess(99)
    Wend
    ExitProcess(n)
End Sub
Main()
End
