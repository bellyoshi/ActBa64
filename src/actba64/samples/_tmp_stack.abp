#console
Const CH_SP = 32
Const MAX_PATH = 260
Function GC(cnt As Long, buf As *Byte) As Long
    Dim rawCmd[4096] As Byte
    Dim cmdlen As Long
    Dim cidx As Long
    Dim ctmp[260] As Byte
    Dim n As Long
    Dim ch As Long
    Dim cmd As *Byte
    Dim m As Long
    cmd = GetCommandLineA()
    cmdlen = lstrlenA(cmd)
    If cmdlen > 4094 Then cmdlen = 4094
    memcpy(VarPtr(rawCmd), cmd, cmdlen)
    rawCmd[cmdlen] = 0
    cidx = 0
    n = 0
    While n < cmdlen
        While n < cmdlen
            ch = rawCmd[n]
            If ch <> CH_SP Then Exit While
            n = n + 1
        Wend
        If n >= cmdlen Then Exit While
        m = 0
        While n < cmdlen
            ch = rawCmd[n]
            If ch = CH_SP Then Exit While
            If m < 259 Then
                ctmp[m] = ch
                m = m + 1
            End If
            n = n + 1
        Wend
        ctmp[m] = 0
        If cidx = cnt Then
            lstrcpyA(buf, ctmp)
            GC = 1
            Exit Function
        End If
        cidx = cidx + 1
    Wend
    GC = 0
End Function
Sub Main()
    Dim outName[MAX_PATH] As Byte
    Dim srcName[MAX_PATH] As Byte
    Dim arg[MAX_PATH] As Byte
    Dim i As Long
    Dim haveOut As Long
    Dim haveSrc As Long
    haveOut = 0
    haveSrc = 0
    outName[0] = 0
    srcName[0] = 0
    i = 1
    While GC(i, arg) <> 0
        If arg[0] = 45 Then
            If GC(i + 1, outName) = 0 Then ExitProcess(8)
            haveOut = 1
            i = i + 2
        Else
            If haveSrc <> 0 Then ExitProcess(9)
            lstrcpyA(VarPtr(srcName), arg)
            haveSrc = 1
            i = i + 1
        End If
        If i > 20 Then ExitProcess(99)
    Wend
    If haveSrc = 0 Or haveOut = 0 Then ExitProcess(7)
    If srcName[0] = 0 Then ExitProcess(6)
    ExitProcess(1)
End Sub
Main()
End
