Function LowAddrVar(ctx As *LowerCtx, idx As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList
    Dim name(SYM_NAME_LEN - 1) As Byte

    LowAddrVar = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    AstCopyStr(ast, idx, VarPtr(name))
    If Not LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) Then
        ctx->err = 1
        Exit Function
    End If
    If vByRef <> 0 Then
        LowEmitLoadOff(list, vOff, vGlob)
    Else
        LowEmitLeaOff(list, vOff, vGlob)
    End If
    LowAddrVar = 1
End Function

' AST_INDEX を基底に持つメンバの基底アドレスを出力し、UDT 型を tiOut へ返す
' 戻り値 true : 正常終了  false : エラーあり
Function LowAddrMemberIdxBase(ctx As *LowerCtx, base As Long, ByRef tiOut As Long) As boolean
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(SYM_NAME_LEN - 1) As Byte

    LowAddrMemberIdxBase = false
    tiOut = -1
    ast = ctx->ast
    nodes = ast->nodes
    If LowAddr(ctx, base) = 0 Then Exit Function
    AstCopyStr(ast, nodes[base].left, VarPtr(name))
    If Not LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) Then
        ctx->err = 1
        Exit Function
    End If
    tiOut = vTypeIdx
    LowAddrMemberIdxBase = true
End Function

' AST_VAR を基底に持つメンバの基底アドレスを出力し、UDT 型を tiOut へ返す
' 戻り値 true : 正常終了  false : エラーあり
Function LowAddrMemberVarBase(ctx As *LowerCtx, idx As Long, base As Long, ByRef tiOut As Long) As boolean
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList
    Dim name(SYM_NAME_LEN - 1) As Byte

    LowAddrMemberVarBase = false
    tiOut = -1
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    AstCopyStr(ast, base, VarPtr(name))
    If Not LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) Then
        ctx->err = 1
        Exit Function
    End If
    tiOut = vTypeIdx
    If nodes[idx].num <> 0 Or vTy = TY_PTR_UDT Or vByRef <> 0 Then
        LowEmitLoadOff(list, vOff, vGlob)
    Else
        LowEmitLeaOff(list, vOff, vGlob)
    End If
    LowAddrMemberVarBase = true
End Function

Function LowAddrMember(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList
    Dim fname(SYM_NAME_LEN - 1) As Byte
    Dim base As Long
    Dim typeTable As *TypeTable
    Dim fieldOff As Long
    Dim fieldSize As Long
    Dim fieldCount As Long
    Dim typeIdx As Long

    LowAddrMember = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    typeTable = ast->types
    base = nodes[idx].left
    AstCopyStr(ast, idx, VarPtr(fname))
    If nodes[base].kind = AST_MEMBER Then
        ' nested: a.b.c — address of a.b then + offset(c)
        If LowAddr(ctx, base) = 0 Then Exit Function
        typeIdx = LowMemberFieldType(ctx, base)
        If typeIdx < 0 Then
            ctx->err = 1
            Exit Function
        End If
    ElseIf nodes[base].kind = AST_INDEX Then
        If Not LowAddrMemberIdxBase(ctx, base, typeIdx) Then Exit Function
    ElseIf nodes[base].kind = AST_VAR Then
        If Not LowAddrMemberVarBase(ctx, idx, base, typeIdx) Then Exit Function
    Else
        ctx->err = 1
        Exit Function
    End If
    If TyFindField(typeTable, typeIdx, VarPtr(fname), fieldOff, fieldSize, fieldCount) = 0 Then
        ' With 対象が UDT でないとき .x は基底のまま（p.x → p）
        LowAddrMember = 1
        Exit Function
    End If
    If AccCheckField(ctx, idx, typeIdx, VarPtr(fname)) = 0 Then Exit Function
    If fieldOff <> 0 Then
        IrEmit(list, OP_ADD_RAX_IMM, fieldOff, 0)
    End If
    LowAddrMember = 1
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function LowIsArrTy(typeKind As Long) As boolean
    LowIsArrTy = false
    If typeKind = TY_BYTE_ARR Or typeKind = TY_LONG_ARR Or typeKind = TY_STRING_ARR Then
        LowIsArrTy = true
    ElseIf typeKind = TY_DOUBLE_ARR Or typeKind = TY_SINGLE_ARR Or typeKind = TY_UDT_ARR Then
        LowIsArrTy = true
    End If
End Function

' rax = 配列先頭, rcx = 添字 → rax = 要素アドレス
Function LowAddrArrayCallScale(ctx As *LowerCtx, list As *IrList, typeTable As *TypeTable, vTy As Long, vTypeIdx As Long) As Long
    Dim typeIdx As Long
    Dim esz As Long
    Dim tsizes As *Long

    LowAddrArrayCallScale = 0
    If vTy = TY_STRING_ARR Then
        LowEmitScalePtr(list)
        IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
    ElseIf vTy = TY_DOUBLE_ARR Then
        IrEmit(list, OP_SHL_ECX_3, 0, 0)
        IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
    ElseIf vTy = TY_LONG_ARR Or vTy = TY_SINGLE_ARR Then
        ' Long/DWord/Single = 4 bytes（WinAPI の UINT* 等と互換）
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
        IrEmit(list, OP_MOV_ECX, 4, 0)
        IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
        IrEmit(list, OP_POP_RCX, 0, 0)
        IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
    ElseIf vTy = TY_UDT_ARR Then
        typeIdx = vTypeIdx
        tsizes = typeTable->typeSizes
        esz = tsizes[typeIdx]
        If esz <= 0 Then
            ctx->err = 1
            Exit Function
        End If
        If esz = 1 Then
            IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
        Else
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
            IrEmit(list, OP_MOV_ECX, esz, 0)
            IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
            IrEmit(list, OP_POP_RCX, 0, 0)
            IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
        End If
    Else
        IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
    End If
    LowAddrArrayCallScale = 1
End Function

' flat = i0 + i1 * len0 into rax (first-index-fastest). len0 from symbol typeIdx.
' 戻り値 true : 正常終了  false : エラーあり
Function LowEmitFlat2D(ctx As *LowerCtx, list As *IrList, i0 As Long, i1 As Long, len0 As Long) As boolean
    LowEmitFlat2D = false
    If len0 <= 0 Then
        ctx->err = 1
        Exit Function
    End If
    If LowExpr(ctx, i1) = 0 Then Exit Function
    LowEmitZxEax(list)
    IrEmit(list, OP_MOV_ECX, len0, 0)
    IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    If LowExpr(ctx, i0) = 0 Then Exit Function
    LowEmitZxEax(list)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
    LowEmitFlat2D = true
End Function

Function LowAddrArrFail(ctx As *LowerCtx) As boolean
    ctx->err = 1
    LowAddrArrFail = false
End Function

Function LowAddrArrNArgs(ctx As *LowerCtx, idx As Long) As Long
    Dim ast As *Ast, nodes As *AstNode
    ast = ctx->ast: nodes = ast->nodes
    LowAddrArrNArgs = nodes[idx].num
End Function

Function LowAddrArrRankOk(ctx As *LowerCtx, nArgs As Long) As boolean
    LowAddrArrRankOk = false
    If nArgs >= 1 And nArgs <= ARR_RANK_MAX Then
        LowAddrArrRankOk = true
    Else
        ctx->err = 1
    End If
End Function

' 配列変数を解決する。未定義・非配列はエラー
' 戻り値 true : 正常終了  false : エラーあり
Function LowAddrArrLookup(ctx As *LowerCtx, idx As Long, ByRef vOff As Long, ByRef vTy As Long, ByRef vTypeIdx As Long, ByRef vGlob As Long) As boolean
    Dim vByRef As Long
    Dim ast As *Ast
    Dim name(SYM_NAME_LEN - 1) As Byte
    ast = ctx->ast
    AstCopyStr(ast, idx, VarPtr(name))
    LowAddrArrLookup = LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob))
    If Not LowAddrArrLookup Or Not LowIsArrTy(vTy) Then LowAddrArrLookup = LowAddrArrFail(ctx)
End Function

' 戻り値 true : 添字個数は妥当  false : 診断済み
Function LowAddrArrCountOk(ctx As *LowerCtx, idx As Long, vTy As Long, vTypeIdx As Long, nArgs As Long) As boolean
    Dim ast As *Ast
    Dim name(SYM_NAME_LEN - 1) As Byte
    LowAddrArrCountOk = true
    If LowArrIdxOk(vTy, vTypeIdx, nArgs) <> 0 Then Exit Function
    ast = ctx->ast
    AstCopyStr(ast, idx, VarPtr(name))
    LowerDiagError(ctx, idx, "bad array index count '" + MakeStr(VarPtr(name)) + "'")
    LowAddrArrCountOk = false
End Function

' 1 次元。添字式は CALL の左（AST_ARG を剥がす）
' 戻り値 true : 正常終了  false : エラーあり
Function LowAddrArrEval1(ctx As *LowerCtx, idx As Long) As boolean
    Dim ast As *Ast, nodes As *AstNode, ix As Long
    ast = ctx->ast: nodes = ast->nodes: ix = nodes[idx].left
    If ix >= 0 Then
        If nodes[ix].kind = AST_ARG Then ix = nodes[ix].left
    End If
    LowAddrArrEval1 = false
    If LowExpr(ctx, ix) <> 0 Then LowAddrArrEval1 = true
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function LowAddrArrEval2(ctx As *LowerCtx, idx As Long, vTy As Long, vTypeIdx As Long) As boolean
    Dim ast As *Ast, nodes As *AstNode, a0 As Long, a1 As Long
    ast = ctx->ast: nodes = ast->nodes: a0 = nodes[idx].left: a1 = -1
    If a0 >= 0 Then a1 = nodes[a0].nxt
    If vTy = TY_UDT_ARR Or a0 < 0 Or a1 < 0 Then
        LowAddrArrEval2 = LowAddrArrFail(ctx)
    Else
        LowAddrArrEval2 = LowEmitFlat2D(ctx, ctx->list, nodes[a0].left, nodes[a1].left, vTypeIdx)
    End If
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function LowAddrArrEvalN(ctx As *LowerCtx, idx As Long, vTypeIdx As Long) As boolean
    Dim ast As *Ast, nodes As *AstNode, a0 As Long
    ast = ctx->ast: nodes = ast->nodes: a0 = nodes[idx].left
    LowAddrArrEvalN = LowEmitFlatN(ctx, ctx->list, a0, vTypeIdx - ARR_POOL_BIT)
    If Not LowAddrArrEvalN Then ctx->err = 1
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function LowAddrArrIndex(ctx As *LowerCtx, idx As Long, nArgs As Long, vTy As Long, vTypeIdx As Long) As boolean
    LowAddrArrIndex = false
    If nArgs >= 3 Then
        LowAddrArrIndex = LowAddrArrEvalN(ctx, idx, vTypeIdx)
    ElseIf nArgs = 2 Then
        LowAddrArrIndex = LowAddrArrEval2(ctx, idx, vTy, vTypeIdx)
    Else
        LowAddrArrIndex = LowAddrArrEval1(ctx, idx)
    End If
End Function

' rax = 添字のあと、配列先頭を足して要素サイズでスケール
' 戻り値 true : 正常終了  false : エラーあり
Function LowAddrArrFinish(ctx As *LowerCtx, vOff As Long, vGlob As Long, vTy As Long, vTypeIdx As Long) As boolean
    Dim ast As *Ast, list As *IrList, typeTable As *TypeTable
    ast = ctx->ast: list = ctx->list: typeTable = ast->types
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    LowEmitLeaOff(list, vOff, vGlob)
    IrEmit(list, OP_POP_RCX, 0, 0)
    LowAddrArrFinish = LowAddrArrayCallScale(ctx, list, typeTable, vTy, vTypeIdx)
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function LowAddrArrEmit(ctx As *LowerCtx, idx As Long) As boolean
    Dim vOff As Long, vTy As Long, vTypeIdx As Long, vGlob As Long, nArgs As Long
    LowAddrArrEmit = false
    nArgs = LowAddrArrNArgs(ctx, idx)
    If Not LowAddrArrRankOk(ctx, nArgs) Then Exit Function
    If Not LowAddrArrLookup(ctx, idx, vOff, vTy, vTypeIdx, vGlob) Then Exit Function
    If Not LowAddrArrCountOk(ctx, idx, vTy, vTypeIdx, nArgs) Then Exit Function
    If Not LowAddrArrIndex(ctx, idx, nArgs, vTy, vTypeIdx) Then Exit Function
    LowAddrArrEmit = LowAddrArrFinish(ctx, vOff, vGlob, vTy, vTypeIdx)
End Function

Function LowAddrArrayCall(ctx As *LowerCtx, idx As Long) As Long
    LowAddrArrayCall = 0
    If LowAddrArrEmit(ctx, idx) Then LowAddrArrayCall = 1
End Function
