' ===================================================
'  AstLowerAddr - RtVal bodies / address lowering
' ===================================================

Sub LowEmitRtValMilliScale(list As *IrList, labScale As Long, labEnd As Long, labDone As Long)
    IrEmit(list, OP_LABEL, labScale, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_MOV_ECX, 1000, 0)
    IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_ADD_EAX_ECX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -24, 0)

    IrEmit(list, OP_LABEL, labEnd, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_POP_RAX, 0, 0)
    IrEmit(list, OP_JZ, labDone, 0)
    IrEmit(list, OP_NEG_EAX, 0, 0)
    IrEmit(list, OP_JMP, labDone, 0)
End Sub

' ValMilli(s) ― 符号付き十進数を千分率（milli）で返す。rc=文字列 ptr
' "3.14"→3140, "7"→7000, "-1.5"→-1500, ".5"→500
Sub LowEmitRtValMilliBody(ctx As *LowerCtx)
    Dim list As *IrList
    Dim labSpace As Long
    Dim labSign As Long
    Dim labPlus As Long
    Dim labDigit As Long
    Dim labDot As Long
    Dim labFrac As Long
    Dim labPad As Long
    Dim labScale As Long
    Dim labEnd As Long
    Dim labDone As Long

    If g_rtValMilliLab < 0 Then Exit Sub
    list = ctx->list
    labSpace = LowNewLab(ctx)
    labSign = LowNewLab(ctx)
    labPlus = LowNewLab(ctx)
    labDigit = LowNewLab(ctx)
    labDot = LowNewLab(ctx)
    labFrac = LowNewLab(ctx)
    labPad = LowNewLab(ctx)
    labScale = LowNewLab(ctx)
    labEnd = LowNewLab(ctx)
    labDone = LowNewLab(ctx)

    ' locals: -8 ptr, -16 neg, -24 ival, -32 frac, -40 fracDigits
    IrEmit(list, OP_LABEL, g_rtValMilliLab, 0)
    IrEmit(list, OP_ENTER, 64, 0)
    LowEmitCaptureArg0(list, -8)
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -16, 0)
    IrEmit(list, OP_STORE_LOCAL, -24, 0)
    IrEmit(list, OP_STORE_LOCAL, -32, 0)
    IrEmit(list, OP_STORE_LOCAL, -40, 0)

    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JZ, labDone, 0)

    LowEmitRtValSkipLeading(list, labSpace, labSign)
    LowEmitRtValParseSign(list, labSign, labPlus, labDigit)
    LowEmitRtValMilliParseDigits(list, labDigit, labDot)
    LowEmitRtValMilliFraction(list, labDot, labFrac, labPad, labScale)
    LowEmitRtValMilliScale(list, labScale, labEnd, labDone)

    IrEmit(list, OP_LABEL, labDone, 0)
    LowEmitLeaveN(list, 1)
End Sub

Sub LowEmitRtM2SNormLo(list As *IrList, labNormLo As Long, labNormHi As Long, labBadExp As Long)
    IrEmit(list, OP_LABEL, labNormLo, 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 1000, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JGE, labNormHi, 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_MOV_ECX_EAX, 0, 0)
    IrEmit(list, OP_ADD_EAX_ECX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -16, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -1, 0)
    IrEmit(list, OP_STORE_LOCAL, -24, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, -140, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JL, labBadExp, 0)
    IrEmit(list, OP_JMP, labNormLo, 0)
End Sub

Sub LowEmitRtM2SNormHi(list As *IrList, labNormHi As Long, labNormDone As Long, labBadExp As Long)
    IrEmit(list, OP_LABEL, labNormHi, 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 2000, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JL, labNormDone, 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_XOR_EDX, 0, 0)
    IrEmit(list, OP_MOV_ECX, 2, 0)
    IrEmit(list, OP_DIV_ECX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -16, 0)
    IrEmit(list, OP_INC_LOCAL, -24, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 140, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JG, labBadExp, 0)
    IrEmit(list, OP_JMP, labNormHi, 0)
End Sub

Sub LowEmitRtM2SAssemble(list As *IrList, labNormDone As Long, labBadExp As Long, labDone As Long)
    IrEmit(list, OP_LABEL, labNormDone, 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_MOV_ECX, 1000, 0)
    IrEmit(list, OP_SUB_EAX_ECX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -32, 0)
    IrEmit(list, OP_MOV_ECX, 8388, 0)
    IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_MOV_ECX, 608, 0)
    IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
    IrEmit(list, OP_XOR_EDX, 0, 0)
    IrEmit(list, OP_MOV_ECX, 1000, 0)
    IrEmit(list, OP_DIV_ECX, 0, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_ADD_EAX_ECX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -32, 0)

    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 127, 0)
    IrEmit(list, OP_STORE_LOCAL, -40, 0)
    IrEmit(list, OP_LOAD_LOCAL, -40, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JLE, labBadExp, 0)
    IrEmit(list, OP_LOAD_LOCAL, -40, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 255, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JGE, labBadExp, 0)

    IrEmit(list, OP_LOAD_LOCAL, -40, 0)
    IrEmit(list, OP_MOV_ECX, 8388608, 0)
    IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_OR_EAX_ECX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_POP_RAX, 0, 0)
    IrEmit(list, OP_JZ, labDone, 0)
    IrEmit(list, OP_MOV_ECX, &H80000000, 0)
    IrEmit(list, OP_OR_EAX_ECX, 0, 0)
    IrEmit(list, OP_JMP, labDone, 0)
End Sub

' MilliToSingle ― eax の千分率 → eax の IEEE Single ビット列（Parser.FloatBitsFromMilli 相当）
Sub LowEmitRtMilliToSingleBody(ctx As *LowerCtx)
    Dim list As *IrList
    Dim labZero As Long
    Dim labPos As Long
    Dim labNormLo As Long
    Dim labNormHi As Long
    Dim labNormDone As Long
    Dim labBadExp As Long
    Dim labDone As Long

    If g_rtMilliToSingleLab < 0 Then Exit Sub
    list = ctx->list
    labZero = LowNewLab(ctx)
    labPos = LowNewLab(ctx)
    labNormLo = LowNewLab(ctx)
    labNormHi = LowNewLab(ctx)
    labNormDone = LowNewLab(ctx)
    labBadExp = LowNewLab(ctx)
    labDone = LowNewLab(ctx)

    ' locals: -8 sign(0/1), -16 num, -24 uexp, -32 man, -40 biased
    IrEmit(list, OP_LABEL, g_rtMilliToSingleLab, 0)
    IrEmit(list, OP_ENTER, 64, 0)
    IrEmit(list, OP_STORE_LOCAL, -16, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JZ, labZero, 0)

    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -8, 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JGE, labPos, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -8, 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_NEG_EAX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -16, 0)

    IrEmit(list, OP_LABEL, labPos, 0)
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -24, 0)

    LowEmitRtM2SNormLo(list, labNormLo, labNormHi, labBadExp)
    LowEmitRtM2SNormHi(list, labNormHi, labNormDone, labBadExp)
    LowEmitRtM2SAssemble(list, labNormDone, labBadExp, labDone)

    IrEmit(list, OP_LABEL, labBadExp, 0)
    IrEmit(list, OP_LABEL, labZero, 0)
    IrEmit(list, OP_XOR_EAX, 0, 0)

    IrEmit(list, OP_LABEL, labDone, 0)
    LowEmitLeaveN(list, 1)
End Sub

' MilliToDouble ― eax の千分率 → rax の IEEE Double
' DIV_SD（xmm0=rcx）は stage0/1 で 0 を返しやすいので、実績のある MilliToSingle 経由にする。
Sub LowEmitRtMilliToDoubleBody(ctx As *LowerCtx)
    Dim list As *IrList
    Dim lab As Long

    If g_rtMilliToDoubleLab < 0 Then Exit Sub
    list = ctx->list
    lab = g_rtMilliToSingleLab
    IrEmit(list, OP_LABEL, g_rtMilliToDoubleLab, 0)
    IrEmit(list, OP_ENTER, 32, 0)
    LowEmitCaptureArg0(list, -8)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    If lab >= 0 Then
        LowEmitCall1Rax(list, 0, 0, 0, lab)
        IrEmit(list, OP_CVT_SS_TO_SD, 0, 0)
    End If
    LowEmitLeaveN(list, 1)
End Sub

' MakeStr(p) ― NUL 終端 BytePtr → 長さ付き String（複製）
Sub LowEmitRtMakeStrBody(ctx As *LowerCtx)
    Dim list As *IrList
    Dim sApi(15) As Byte
    Dim empty(1) As Byte
    Dim labOk As Long
    Dim labCopy As Long
    Dim labNul As Long

    If g_rtMakeStrLab < 0 Then Exit Sub
    list = ctx->list
    empty[0] = 0
    labOk = LowNewLab(ctx)
    labCopy = LowNewLab(ctx)
    labNul = LowNewLab(ctx)

    ' rcx = p; locals: -8 src, -16 len, -24 base, -32 dst
    IrEmit(list, OP_LABEL, g_rtMakeStrLab, 0)
    IrEmit(list, OP_ENTER, 48, 0)
    LowEmitCaptureArg0(list, -8)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JNZ, labOk, 0)
    IrEmitStr(list, OP_LEA_RAX_STR, 0, VarPtr(empty))
    LowEmitLeaveN(list, 1)

    IrEmit(list, OP_LABEL, labOk, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    lstrcpy(VarPtr(sApi), "lstrlenA")
    LowEmitCall1Rax(list, 1, IR_DLL_KERNEL32, VarPtr(sApi), 0)
    IrEmit(list, OP_STORE_LOCAL, -16, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 5, 0)
    IrEmit(list, OP_MOV_RCX_RAX, 0, 0)
    LowEmitCallStrHeapAlloc(ctx)
    IrEmit(list, OP_STORE_LOCAL, -24, 0)

    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_ECX, &H80000000, 0)
    IrEmit(list, OP_POP_RAX, 0, 0)
    IrEmit(list, OP_OR_EAX_ECX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_STORE_DWORD_RAX_ECX, 0, 0)

    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 4, 0)
    IrEmit(list, OP_STORE_LOCAL, -32, 0)

    IrEmit(list, OP_LABEL, labCopy, 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JZ, labNul, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -8, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_STORE_BYTE_RAX_CL, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -32, 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -1, 0)
    IrEmit(list, OP_STORE_LOCAL, -16, 0)
    IrEmit(list, OP_JMP, labCopy, 0)

    IrEmit(list, OP_LABEL, labNul, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_MOV_ECX, 0, 0)
    IrEmit(list, OP_STORE_BYTE_RAX_CL, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 4, 0)
    LowEmitLeaveN(list, 1)
End Sub

' StrCmp(rcx=a, rdx=b) → eax（長さ付き辞書順）
Sub LowEmitRtStrCmpBody(ctx As *LowerCtx)
    Dim list As *IrList
    Dim labMinB As Long
    Dim labLoop As Long
    Dim labByteDiff As Long
    Dim labByLen As Long

    If g_rtStrCmpLab < 0 Then Exit Sub
    list = ctx->list
    labMinB = LowNewLab(ctx)
    labLoop = LowNewLab(ctx)
    labByteDiff = LowNewLab(ctx)
    labByLen = LowNewLab(ctx)

    IrEmit(list, OP_LABEL, g_rtStrCmpLab, 0)
    IrEmit(list, OP_ENTER, 64, 0)
    LowEmitCaptureArg0(list, -8)
    LowEmitCaptureArg1(list, -16)

    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -4, 0)
    IrEmit(list, OP_LOAD_DWORD_RAX, 0, 0)
    IrEmit(list, OP_AND_EAX_IMM, 2147483647, 0)
    IrEmit(list, OP_STORE_LOCAL, -24, 0)

    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -4, 0)
    IrEmit(list, OP_LOAD_DWORD_RAX, 0, 0)
    IrEmit(list, OP_AND_EAX_IMM, 2147483647, 0)
    IrEmit(list, OP_STORE_LOCAL, -32, 0)

    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JLE, labMinB, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_STORE_LOCAL, -40, 0)
    IrEmit(list, OP_JMP, labLoop, 0)
    IrEmit(list, OP_LABEL, labMinB, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_STORE_LOCAL, -40, 0)

    IrEmit(list, OP_LABEL, labLoop, 0)
    IrEmit(list, OP_LOAD_LOCAL, -40, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JZ, labByLen, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JNE, labByteDiff, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -8, 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -16, 0)
    IrEmit(list, OP_LOAD_LOCAL, -40, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -1, 0)
    IrEmit(list, OP_STORE_LOCAL, -40, 0)
    IrEmit(list, OP_JMP, labLoop, 0)

    IrEmit(list, OP_LABEL, labByteDiff, 0)
    IrEmit(list, OP_SUB_EAX_ECX, 0, 0)
    IrEmit(list, OP_NEG_EAX, 0, 0)
    LowEmitLeaveN(list, 2)

    IrEmit(list, OP_LABEL, labByLen, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_SUB_EAX_ECX, 0, 0)
    IrEmit(list, OP_NEG_EAX, 0, 0)
    LowEmitLeaveN(list, 2)
End Sub

' StrFree(rcx=p): ヒープ印付きなら HeapFree(p-4)
Sub LowEmitRtStrFreeBody(ctx As *LowerCtx)
    Dim list As *IrList
    Dim sApi(15) As Byte
    Dim labDone As Long
    Dim labSkip As Long

    If g_rtStrFreeLab < 0 Then Exit Sub
    list = ctx->list
    labDone = LowNewLab(ctx)
    labSkip = LowNewLab(ctx)
    IrEmit(list, OP_LABEL, g_rtStrFreeLab, 0)
    IrEmit(list, OP_ENTER, 32, 0)
    LowEmitCaptureArg0(list, -8)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JZ, labDone, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -4, 0)
    IrEmit(list, OP_STORE_LOCAL, -16, 0)
    IrEmit(list, OP_LOAD_DWORD_RAX, 0, 0)
    IrEmit(list, OP_MOV_ECX, &H80000000, 0)
    IrEmit(list, OP_AND_EAX_ECX, 0, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JZ, labDone, 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    LowEmitHeapFreeRax(list)
    IrEmit(list, OP_LABEL, labDone, 0)
    LowEmitLeaveN(list, 1)
End Sub

Function LowTyNbytes(ty As Long) As Long
    If ty = TY_BYTE Then
        LowTyNbytes = 1
    ElseIf ty = TY_DOUBLE Then
        LowTyNbytes = 8
    ElseIf ty = TY_SINGLE Then
        LowTyNbytes = 4
    ElseIf ty = TY_STRING Then
        LowTyNbytes = TyPtrSize()
    ElseIf ty = TY_PTR_BYTE Or ty = TY_PTR_LONG Or ty = TY_PTR_UDT Then
        LowTyNbytes = TyPtrSize()
    Else
        LowTyNbytes = 4
    End If
End Function

Function LowPtrFieldElemSize(fieldTy As Long) As Long
    If fieldTy = FIELDTY_PTR_LONG Then
        LowPtrFieldElemSize = 4
    Else
        LowPtrFieldElemSize = 1
    End If
End Function

Sub LowLoadSized(list As *IrList, sz As Long)
    If sz = 1 Then
        IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
    ElseIf sz = 2 Then
        IrEmit(list, OP_LOADZX_WORD_RAX, 0, 0)
    ElseIf sz = 4 Then
        IrEmit(list, OP_LOAD_DWORD_RAX, 0, 0)
    ElseIf sz = 8 Then
        IrEmit(list, OP_LOAD_QWORD_RAX, 0, 0)
    Else
        IrEmit(list, OP_LOAD_DWORD_RAX, 0, 0)
    End If
End Sub

Sub LowStoreSized(list As *IrList, sz As Long)
    If sz = 1 Then
        IrEmit(list, OP_STORE_BYTE_RAX_CL, 0, 0)
    ElseIf sz = 2 Then
        IrEmit(list, OP_STORE_WORD_RAX_CX, 0, 0)
    ElseIf sz = 4 Then
        IrEmit(list, OP_STORE_DWORD_RAX_ECX, 0, 0)
    ElseIf sz = 8 Then
        IrEmit(list, OP_STORE_QWORD_RAX_RCX, 0, 0)
    Else
        IrEmit(list, OP_STORE_DWORD_RAX_ECX, 0, 0)
    End If
End Sub

' Address of lvalue -> rax
' AST_MEMBER ノードが指すフィールドの UDT 型インデックス（ネスト解決用）
Function LowMemberFieldType(ctx As *LowerCtx, idx As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim tt As *TypeTable
    Dim base As Long
    Dim name(63) As Byte
    Dim fname(63) As Byte
    Dim ti As Long
    Dim foff As Long
    Dim fsz As Long
    Dim fcnt As Long
    Dim fieldTy As Long
    Dim off As Long
    Dim ty As Long
    Dim typeIdx As Long
    Dim byRef As Long
    Dim isGlob As Long

    LowMemberFieldType = -1
    If idx < 0 Then Exit Function
    ast = ctx->ast
    nodes = ast->nodes
    If nodes[idx].kind <> AST_MEMBER Then Exit Function
    tt = ast->types
    base = nodes[idx].left
    AstCopyStr(ast, idx, VarPtr(fname))
    If nodes[base].kind = AST_MEMBER Then
        ti = LowMemberFieldType(ctx, base)
    ElseIf nodes[base].kind = AST_VAR Then
        AstCopyStr(ast, base, VarPtr(name))
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then Exit Function
        ti = vTypeIdx
    Else
        Exit Function
    End If
    If ti < 0 Then Exit Function
    If TyFindFieldEx(tt, ti, VarPtr(fname), foff, fsz, fcnt, fieldTy) = 0 Then Exit Function
    LowMemberFieldType = fieldTy
End Function

' Byte size of the field addressed by an AST_MEMBER (supports nesting).
Function LowMemberFieldSize(ctx As *LowerCtx, idx As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim tt As *TypeTable
    Dim base As Long
    Dim name(63) As Byte
    Dim fname(63) As Byte
    Dim ti As Long
    Dim foff As Long
    Dim fsz As Long
    Dim fcnt As Long
    Dim fieldTy As Long

    LowMemberFieldSize = 0
    If idx < 0 Then Exit Function
    ast = ctx->ast
    nodes = ast->nodes
    If nodes[idx].kind <> AST_MEMBER Then Exit Function
    tt = ast->types
    base = nodes[idx].left
    AstCopyStr(ast, idx, VarPtr(fname))
    If nodes[base].kind = AST_MEMBER Then
        ti = LowMemberFieldType(ctx, base)
    ElseIf nodes[base].kind = AST_VAR Then
        AstCopyStr(ast, base, VarPtr(name))
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then Exit Function
        ti = vTypeIdx
    ElseIf nodes[base].kind = AST_INDEX Then
        AstCopyStr(ast, nodes[base].left, VarPtr(name))
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then Exit Function
        ti = vTypeIdx
    Else
        Exit Function
    End If
    If ti < 0 Then Exit Function
    If TyFindFieldEx(tt, ti, VarPtr(fname), foff, fsz, fcnt, fieldTy) = 0 Then Exit Function
    LowMemberFieldSize = fsz
End Function

Function LowAddrVar(ctx As *LowerCtx, idx As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList
    Dim name(63) As Byte

    LowAddrVar = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    AstCopyStr(ast, idx, VarPtr(name))
    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
        ctx->err = 1
        Exit Function
    End If
    If vByRef <> 0 Then
        LowEmitLoadOff(list, vOff, vGlob)
    Else
        LowEmitLeaOff(list, vOff, vGlob)
    End If
    LowAddrVar = 1
End Function

Function LowAddrMember(ctx As *LowerCtx, idx As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList
    Dim name(63) As Byte
    Dim fname(63) As Byte
    Dim base As Long
    Dim tt As *TypeTable
    Dim foff As Long
    Dim fsz As Long
    Dim fcnt As Long
    Dim ti As Long

    LowAddrMember = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    tt = ast->types
    base = nodes[idx].left
    AstCopyStr(ast, idx, VarPtr(fname))
    If nodes[base].kind = AST_MEMBER Then
        ' nested: a.b.c — address of a.b then + offset(c)
        If LowAddr(ctx, base) = 0 Then Exit Function
        ti = LowMemberFieldType(ctx, base)
        If ti < 0 Then
            ctx->err = 1
            Exit Function
        End If
    ElseIf nodes[base].kind = AST_INDEX Then
        If LowAddr(ctx, base) = 0 Then Exit Function
        AstCopyStr(ast, nodes[base].left, VarPtr(name))
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
            ctx->err = 1
            Exit Function
        End If
        ti = vTypeIdx
    ElseIf nodes[base].kind = AST_VAR Then
        AstCopyStr(ast, base, VarPtr(name))
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
            ctx->err = 1
            Exit Function
        End If
        ti = vTypeIdx
        If nodes[idx].num <> 0 Then
            LowEmitLoadOff(list, vOff, vGlob)
        ElseIf vTy = TY_PTR_UDT Then
            LowEmitLoadOff(list, vOff, vGlob)
        Else
            LowEmitLeaOff(list, vOff, vGlob)
        End If
    Else
        ctx->err = 1
        Exit Function
    End If
    If TyFindField(tt, ti, VarPtr(fname), foff, fsz, fcnt) = 0 Then
        ' With 対象が UDT でないとき .x は基底のまま（p.x → p）
        LowAddrMember = 1
        Exit Function
    End If
    If foff <> 0 Then
        IrEmit(list, OP_ADD_RAX_IMM, foff, 0)
    End If
    LowAddrMember = 1
End Function

Function LowAddrArrayCall(ctx As *LowerCtx, idx As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList
    Dim name(63) As Byte
    Dim nArgs As Long
    Dim tt As *TypeTable
    Dim ti As Long
    Dim esz As Long
    Dim tsizes As *Long
    Dim ix As Long

    LowAddrArrayCall = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    tt = ast->types
    nArgs = nodes[idx].num
    If nArgs <> 1 Then
        ctx->err = 1
        Exit Function
    End If
    AstCopyStr(ast, idx, VarPtr(name))
    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
        ctx->err = 1
        Exit Function
    End If
    If vTy <> TY_BYTE_ARR Then
        If vTy <> TY_LONG_ARR Then
            If vTy <> TY_STRING_ARR Then
                If vTy <> TY_DOUBLE_ARR Then
                    If vTy <> TY_SINGLE_ARR Then
                        If vTy <> TY_UDT_ARR Then
                            ctx->err = 1
                            Exit Function
                        End If
                    End If
                End If
            End If
        End If
    End If
    ' index expr is left of CALL (AST_ARG wrapper)
    ix = nodes[idx].left
    If ix >= 0 Then
        If nodes[ix].kind = AST_ARG Then ix = nodes[ix].left
    End If
    If LowExpr(ctx, ix) = 0 Then Exit Function
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    LowEmitLeaOff(list, vOff, vGlob)
    IrEmit(list, OP_POP_RCX, 0, 0)
    If vTy = TY_STRING_ARR Then
        LowEmitScalePtr(list)
        IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
    ElseIf vTy = TY_DOUBLE_ARR Then
        IrEmit(list, OP_SHL_ECX_3, 0, 0)
        IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
    ElseIf vTy = TY_LONG_ARR Or vTy = TY_SINGLE_ARR Then
        ' Long/DWord/Single = 4 bytes（WinAPI の UINT* 等と互換）
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
        IrEmit(list, OP_MOV_ECX, 4, 0)
        IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
        IrEmit(list, OP_POP_RCX, 0, 0)
        IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
    ElseIf vTy = TY_UDT_ARR Then
        ti = vTypeIdx
        tsizes = tt->typeSizes
        esz = tsizes[ti]
        If esz <= 0 Then
            ctx->err = 1
            Exit Function
        End If
        If esz = 1 Then
            IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
        Else
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
            IrEmit(list, OP_MOV_ECX, esz, 0)
            IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
            IrEmit(list, OP_POP_RCX, 0, 0)
            IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
        End If
    Else
        IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
    End If
    LowAddrArrayCall = 1
End Function

Function LowAddrIndexMember(ctx As *LowerCtx, idx As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList
    Dim name(63) As Byte
    Dim fname(63) As Byte
    Dim base As Long
    Dim tt As *TypeTable
    Dim foff As Long
    Dim fsz As Long
    Dim fcnt As Long
    Dim fieldTy As Long
    Dim ti As Long
    Dim esz As Long
    Dim ix As Long

    LowAddrIndexMember = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    tt = ast->types
    base = nodes[idx].left
    AstCopyStr(ast, base, VarPtr(fname))
    ix = nodes[base].left
    If nodes[ix].kind = AST_INDEX Then
        AstCopyStr(ast, nodes[ix].left, VarPtr(name))
    ElseIf nodes[ix].kind = AST_VAR Then
        AstCopyStr(ast, ix, VarPtr(name))
    Else
        ctx->err = 1
        Exit Function
    End If
    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
        ctx->err = 1
        Exit Function
    End If
    ti = vTypeIdx
    If TyFindFieldEx(tt, ti, VarPtr(fname), foff, fsz, fcnt, fieldTy) = 0 Then
        ctx->err = 1
        Exit Function
    End If
    If fcnt > 1 Then
        ' UDT array field: &field[0] + index * elemSize
        esz = fsz
        If esz <= 0 Then
            ctx->err = 1
            Exit Function
        End If
        If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
        LowEmitZxEax(list)
        If esz <> 1 Then
            IrEmit(list, OP_MOV_ECX, esz, 0)
            IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
        End If
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        If LowAddr(ctx, base) = 0 Then Exit Function
        IrEmit(list, OP_POP_RCX, 0, 0)
        IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
    ElseIf fsz = TyPtrSize() Then
        ' pointer field: *Long は index*4、それ以外（*Byte 等）はバイト添字
        esz = LowPtrFieldElemSize(fieldTy)
        If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
        LowEmitZxEax(list)
        If esz <> 1 Then
            IrEmit(list, OP_MOV_ECX, esz, 0)
            IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
        End If
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        If LowExpr(ctx, base) = 0 Then Exit Function
        IrEmit(list, OP_POP_RCX, 0, 0)
        IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
    Else
        ctx->err = 1
        Exit Function
    End If
    LowAddrIndexMember = 1
End Function

Function LowAddrIndexArr(ctx As *LowerCtx, list As *IrList, tt As *TypeTable, vOff As Long, vTy As Long, vTypeIdx As Long, vGlob As Long) As Long
    Dim ti As Long
    Dim esz As Long
    Dim tsizes As *Long

    LowAddrIndexArr = 0
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    If vTy = TY_BYTE_ARR Then
        LowEmitLeaOff(list, vOff, vGlob)
    ElseIf vTy = TY_STRING_ARR Then
        LowEmitLeaOff(list, vOff, vGlob)
        IrEmit(list, OP_POP_RCX, 0, 0)
        LowEmitScalePtr(list)
        IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
        LowAddrIndexArr = 1
        Exit Function
    ElseIf vTy = TY_DOUBLE_ARR Then
        LowEmitLeaOff(list, vOff, vGlob)
        IrEmit(list, OP_POP_RCX, 0, 0)
        IrEmit(list, OP_SHL_ECX_3, 0, 0)
        IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
        LowAddrIndexArr = 1
        Exit Function
    ElseIf vTy = TY_LONG_ARR Or vTy = TY_SINGLE_ARR Then
        LowEmitLeaOff(list, vOff, vGlob)
        IrEmit(list, OP_POP_RCX, 0, 0)
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
        IrEmit(list, OP_MOV_ECX, 4, 0)
        IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
        IrEmit(list, OP_POP_RCX, 0, 0)
        IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
        LowAddrIndexArr = 1
        Exit Function
    ElseIf vTy = TY_UDT_ARR Then
        ti = vTypeIdx
        tsizes = tt->typeSizes
        esz = tsizes[ti]
        If esz <= 0 Then
            ctx->err = 1
            Exit Function
        End If
        LowEmitLeaOff(list, vOff, vGlob)
        IrEmit(list, OP_POP_RCX, 0, 0)
        If esz = 1 Then
            IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
        Else
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
            IrEmit(list, OP_MOV_ECX, esz, 0)
            IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
            IrEmit(list, OP_POP_RCX, 0, 0)
            IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
        End If
        LowAddrIndexArr = 1
        Exit Function
    ElseIf vTy = TY_PTR_BYTE Then
        LowEmitLoadOff(list, vOff, vGlob)
    Else
        ctx->err = 1
        Exit Function
    End If
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
    LowAddrIndexArr = 1
End Function

Function LowAddrIndexBase(ctx As *LowerCtx, idx As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList
    Dim name(63) As Byte
    Dim base As Long
    Dim tt As *TypeTable
    Dim ti As Long
    Dim esz As Long
    Dim tsizes As *Long

    LowAddrIndexBase = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    tt = ast->types
    base = nodes[idx].left
    AstCopyStr(ast, base, VarPtr(name))
    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
        ctx->err = 1
        Exit Function
    End If
    If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
    LowEmitZxEax(list)
    If vTy = TY_PTR_UDT Then
        ti = vTypeIdx
        tsizes = tt->typeSizes
        esz = tsizes[ti]
        If esz <= 0 Then
            ctx->err = 1
            Exit Function
        End If
        IrEmit(list, OP_MOV_ECX, esz, 0)
        IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        LowEmitLoadOff(list, vOff, vGlob)
        IrEmit(list, OP_POP_RCX, 0, 0)
        IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
        LowAddrIndexBase = 1
        Exit Function
    End If
    If vTy = TY_PTR_LONG Then
        IrEmit(list, OP_MOV_ECX, 4, 0)
        IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        LowEmitLoadOff(list, vOff, vGlob)
        IrEmit(list, OP_POP_RCX, 0, 0)
        IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
        LowAddrIndexBase = 1
        Exit Function
    End If
    LowAddrIndexBase = LowAddrIndexArr(ctx, list, tt, vOff, vTy, vTypeIdx, vGlob)
End Function

