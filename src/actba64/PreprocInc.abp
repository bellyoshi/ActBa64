' PreprocInc - include 展開

Function PpAppend(dst As *Byte, ByRef dstLen As Long, dstCap As Long, src As *Byte, n As Long) As Long
    Dim i As Long
    PpAppend = 0
    If dstLen + n + 1 > dstCap Then Exit Function
    i = 0
    While i < n
        dst[dstLen + i] = src[i]
        i = i + 1
    Wend
    dstLen = dstLen + n
    dst[dstLen] = CH_NUL
    PpAppend = 1
End Function

Function PpEmitFileMark(dst As *Byte, ByRef dstLen As Long, dstCap As Long, path As *Byte) As Long
    Dim hdr(15) As Byte
    Dim tail(7) As Byte
    PpEmitFileMark = 0
    lstrcpy(VarPtr(hdr), "' ---- ")
    If PpAppend(dst, dstLen, dstCap, VarPtr(hdr), 7) = 0 Then Exit Function
    If PpAppend(dst, dstLen, dstCap, path, lstrlen(path)) = 0 Then Exit Function
    lstrcpy(VarPtr(tail), " ----")
    tail[5] = CH_CR
    tail[6] = CH_NL
    tail[7] = CH_NUL
    If PpAppend(dst, dstLen, dstCap, VarPtr(tail), 7) = 0 Then Exit Function
    PpEmitFileMark = 1
End Function

Function PpEmitFileEnd(dst As *Byte, ByRef dstLen As Long, dstCap As Long) As Long
    Dim s(23) As Byte
    PpEmitFileEnd = 0
    lstrcpy(VarPtr(s), "' ---- end ----")
    If PpAppend(dst, dstLen, dstCap, VarPtr(s), 15) = 0 Then Exit Function
    s[0] = CH_CR
    s[1] = CH_NL
    If PpAppend(dst, dstLen, dstCap, VarPtr(s), 2) = 0 Then Exit Function
    PpEmitFileEnd = 1
End Function

Function PpNameIsEnd(name As *Byte) As Long
    PpNameIsEnd = 0
    If name = 0 Then Exit Function
    If ToLowerChar(name[0]) <> CH_Le Then Exit Function
    If ToLowerChar(name[1]) <> CH_Ln Then Exit Function
    If ToLowerChar(name[2]) <> CH_Ld Then Exit Function
    If name[3] <> CH_NUL Then Exit Function
    PpNameIsEnd = 1
End Function

Function PpLineIsFileMark(line As *Byte, n As Long, nameOut As *Byte, nameMax As Long) As Long
    Dim i As Long
    Dim nameLen As Long
    PpLineIsFileMark = 0
    nameOut[0] = CH_NUL
    i = 0
    While i < n
        If line[i] <> CH_SP And line[i] <> CH_TAB Then Exit While
        i = i + 1
    Wend
    If i + 7 > n Then Exit Function
    If line[i] <> CH_SQUOTE Then Exit Function
    If line[i + 1] <> CH_SP Then Exit Function
    If line[i + 2] <> CH_MINUS Then Exit Function
    If line[i + 3] <> CH_MINUS Then Exit Function
    If line[i + 4] <> CH_MINUS Then Exit Function
    If line[i + 5] <> CH_MINUS Then Exit Function
    If line[i + 6] <> CH_SP Then Exit Function
    i = i + 7
    nameLen = 0
    While i < n
        If i + 5 <= n Then
            If line[i] = CH_SP And line[i + 1] = CH_MINUS And line[i + 2] = CH_MINUS And line[i + 3] = CH_MINUS And line[i + 4] = CH_MINUS Then
                Exit While
            End If
        End If
        If nameLen < nameMax - 1 Then
            nameOut[nameLen] = line[i]
            nameLen = nameLen + 1
        End If
        i = i + 1
    Wend
    nameOut[nameLen] = CH_NUL
    If nameLen <= 0 Then Exit Function
    PpLineIsFileMark = 1
End Function

Function PpLineEndAt(src As *Byte, from As Long) As Long
    Dim i As Long
    Dim c As Long
    i = from
    While src[i] <> CH_NUL
        c = src[i]
        If c = CH_NL Or c = CH_CR Then Exit While
        i = i + 1
    Wend
    PpLineEndAt = i
End Function

Sub PpCopyMarkName(dst As *Byte, src As *Byte)
    Dim k As Long
    k = 0
    While src[k] <> CH_NUL And k < 259
        dst[k] = src[k]
        k = k + 1
    Wend
    dst[k] = CH_NUL
End Sub

Function PpMapSrcName$(src As *Byte, combLine As Long, ByRef localLine As Long) As String
    Dim i As Long
    Dim start As Long
    Dim n As Long
    Dim cur As Long
    Dim nestSp As Long
    Dim off As Long
    Dim name(259) As Byte
    Dim names(4159) As Byte
    Dim locs(15) As Long

    PpMapSrcName$ = ""
    localLine = combLine
    If src = 0 Then Exit Function
    If combLine <= 0 Then combLine = 1
    i = 0
    cur = 1
    nestSp = 0
    While src[i] <> CH_NUL
        start = i
        i = PpLineEndAt(src, i)
        n = i - start
        If PpLineIsFileMark(VarPtr(src[start]), n, VarPtr(name), 260) <> 0 Then
            If PpNameIsEnd(VarPtr(name)) <> 0 Then
                If nestSp > 0 Then nestSp = nestSp - 1
            Else
                If nestSp < 16 Then
                    off = nestSp * 260
                    PpCopyMarkName(VarPtr(names[off]), VarPtr(name))
                    locs[nestSp] = 0
                    nestSp = nestSp + 1
                End If
            End If
        Else
            If nestSp > 0 Then locs[nestSp - 1] = locs[nestSp - 1] + 1
        End If
        If cur >= combLine Then Exit While
        If src[i] = CH_CR Then i = i + 1
        If src[i] = CH_NL Then i = i + 1
        cur = cur + 1
    Wend
    If nestSp > 0 Then
        off = (nestSp - 1) * 260
        localLine = locs[nestSp - 1]
        If localLine < 1 Then localLine = 1
        PpMapSrcName$ = MakeStr(VarPtr(names[off]))
    End If
End Function

Function PpErrLoc$(src As *Byte, combLine As Long) As String
    Dim file As String
    Dim localLine As Long
    file = PpMapSrcName$(src, combLine, localLine)
    If Len(file) > 0 Then
        PpErrLoc$ = file + "(" + Str$(localLine) + ")"
    Else
        PpErrLoc$ = "line " + Str$(combLine)
    End If
End Function

Function PpEmitLineCrlf(dst As *Byte, ByRef dstLen As Long, dstCap As Long, line As *Byte, n As Long) As Long
    Dim crlf(3) As Byte
    PpEmitLineCrlf = 0
    If n > 0 Then
        If PpAppend(dst, dstLen, dstCap, line, n) = 0 Then Exit Function
    End If
    crlf[0] = CH_CR
    crlf[1] = CH_NL
    If PpAppend(dst, dstLen, dstCap, VarPtr(crlf), 2) = 0 Then Exit Function
    PpEmitLineCrlf = 1
End Function

Function PpResolveIncPath(inc As *Byte, isAngle As Long, curFile As *Byte, full As *Byte) As Long
    Dim dir(511) As Byte
    PpResolveIncPath = 0
    full[0] = CH_NUL
    If inc[0] = CH_NUL Then Exit Function
    If isAngle <> 0 Then
        If PpResolveAngleInclude(inc, full) = 0 Then Exit Function
    ElseIf (inc[1] = CH_COLON) Or (inc[0] = CH_BSLASH) Or (inc[0] = CH_SLASH) Then
        lstrcpy(full, inc)
    Else
        PpDirOf(curFile, VarPtr(dir))
        lstrcpy(full, VarPtr(dir))
        lstrcat(full, inc)
    End If
    PpResolveIncPath = 1
End Function

Function PpExpandIncludeLine(dst As *Byte, ByRef dstLen As Long, dstCap As Long, line As *Byte, n As Long, curFile As *Byte, depth As Long) As Long
    Dim inc(255) As Byte
    Dim full(511) As Byte
    Dim isAngle As Long
    Dim child As *Byte
    Dim childSize As Long
    PpExpandIncludeLine = 0
    isAngle = 0
    If PpExtractInclude(line, n, VarPtr(inc), isAngle) = 0 Then Exit Function
    If PpResolveIncPath(VarPtr(inc), isAngle, curFile, VarPtr(full)) = 0 Then Exit Function
    If PpEmitLineCrlf(dst, dstLen, dstCap, line, n) = 0 Then Exit Function
    If PpOnceHas(VarPtr(full)) <> 0 Then
        PpExpandIncludeLine = 1
        Exit Function
    End If
    child = LoadFile(VarPtr(full), childSize)
    If child = NULL Then Exit Function
    PpOnceAdd(VarPtr(full))
    If PpExpandInto(dst, dstLen, dstCap, child, childSize, VarPtr(full), depth + 1) = 0 Then
        free(child)
        Exit Function
    End If
    free(child)
    PpExpandIncludeLine = 1
End Function

Function PpExpandNormalLine(dst As *Byte, ByRef dstLen As Long, dstCap As Long, line As *Byte, n As Long) As Long
    Dim wOut(1023) As Byte
    Dim wN As Long
    Dim wSt As Long
    PpExpandNormalLine = 0
    wN = 0
    wSt = PpRewriteWithLine(line, n, VarPtr(wOut), wN)
    If wSt = 0 Then
        If g_ppDidPrintErr = 0 Then
            Print "error: too long line after With rewrite (>" + Str$(PP_LINE_MAX) + ")"
            g_ppDidPrintErr = 1
        End If
        Exit Function
    End If
    If wSt = 2 Then
        ' With / End With 行は出力しない
        PpExpandNormalLine = 1
        Exit Function
    End If
    If wSt = 1 And wN > 0 Then
        If PpEmitLineCrlf(dst, dstLen, dstCap, VarPtr(wOut), wN) = 0 Then Exit Function
    Else
        If PpEmitLineCrlf(dst, dstLen, dstCap, line, n) = 0 Then Exit Function
    End If
    PpExpandNormalLine = 1
End Function

Function PpExpandInto(dst As *Byte, ByRef dstLen As Long, dstCap As Long, src As *Byte, srcSize As Long, curFile As *Byte, depth As Long) As Long
    Dim i As Long
    Dim start As Long
    Dim n As Long
    Dim c As Long
    Dim line(1023) As Byte
    Dim j As Long
    Dim lineNo As Long

    PpExpandInto = 0
    If depth >= PP_MAX_DEPTH Then Exit Function
    If depth = 0 Then PpWithReset()
    If PpEmitFileMark(dst, dstLen, dstCap, curFile) = 0 Then Exit Function
    i = 0
    lineNo = 1
    While i < srcSize
        start = i
        While i < srcSize
            c = src[i]
            If c = CH_NL Or c = CH_CR Then Exit While
            i = i + 1
        Wend
        n = i - start
        If n >= PP_LINE_MAX Then
            PpErrorTooLongLine(curFile, lineNo, n)
            Exit Function
        End If
        j = 0
        While j < n
            line[j] = src[start + j]
            j = j + 1
        Wend
        line[n] = CH_NUL
        If PpTryResourceLine(VarPtr(line), n, curFile) <> 0 Then
            ' #resource 行は出力しない
        ElseIf PpIsIncludeLine(VarPtr(line), n) <> 0 Then
            If PpExpandIncludeLine(dst, dstLen, dstCap, VarPtr(line), n, curFile, depth) = 0 Then Exit Function
        Else
            If PpExpandNormalLine(dst, dstLen, dstCap, VarPtr(line), n) = 0 Then Exit Function
        End If
        If i < srcSize And src[i] = CH_CR Then i = i + 1
        If i < srcSize And src[i] = CH_NL Then i = i + 1
        lineNo = lineNo + 1
    Wend
    If PpEmitFileEnd(dst, dstLen, dstCap) = 0 Then Exit Function
    PpExpandInto = 1
End Function

Function ExpandIncludes(src As *Byte, srcSize As Long, srcPath As *Byte) As *Byte
    Dim dst As *Byte
    Dim dstLen As Long
    Dim dstCap As Long

    ExpandIncludes = NULL
    dstCap = BytesN(srcSize, 8) + 262144
    If dstCap < 2097152 Then dstCap = 2097152
    dst = calloc(dstCap)
    If dst = NULL Then Exit Function
    dstLen = 0
    dst[0] = CH_NUL
    If PpExpandInto(dst, dstLen, dstCap, src, srcSize, srcPath, 0) = 0 Then
        free(dst)
        Exit Function
    End If
    ExpandIncludes = dst
End Function

Function PpSourceHasStrict(src As *Byte) As Long
    Dim i As Long
    Dim start As Long
    Dim n As Long
    Dim line(127) As Byte
    Dim j As Long
    Dim word(15) As Byte

    PpSourceHasStrict = 0
    If src = NULL Then Exit Function
    i = 0
    While src[i] <> CH_NUL
        start = i
        While src[i] <> CH_NUL And src[i] <> CH_NL And src[i] <> CH_CR
            i = i + 1
        Wend
        n = i - start
        If n > 127 Then n = 127
        j = 0
        While j < n
            line[j] = src[start + j]
            j = j + 1
        Wend
        line[n] = CH_NUL
        j = 0
        While j < n And (line[j] = CH_SP Or line[j] = CH_TAB)
            j = j + 1
        Wend
        If j < n And line[j] = CH_HASH Then
            j = j + 1
            While j < n And (line[j] = CH_SP Or line[j] = CH_TAB)
                j = j + 1
            Wend
            lstrcpy(VarPtr(word), "strict")
            If PpLineWordMatch(VarPtr(line), j, n, VarPtr(word)) <> 0 Then
                PpSourceHasStrict = 1
                Exit Function
            End If
        End If
        If i < 0 Then Exit While
        If src[i] = CH_CR Then i = i + 1
        If src[i] = CH_NL Then i = i + 1
    Wend
End Function

Function PpLineWordMatch(line As *Byte, pos As Long, n As Long, word As *Byte) As Long
    Dim i As Long
    Dim wi As Long
    PpLineWordMatch = 0
    i = pos
    wi = 0
    While word[wi] <> CH_NUL And i < n
        If ToLowerChar(line[i]) <> ToLowerChar(word[wi]) Then Exit Function
        i = i + 1
        wi = wi + 1
    Wend
    If word[wi] <> CH_NUL Then Exit Function
    If i < n And PpIsIdentCont(line[i]) <> 0 Then Exit Function
    PpLineWordMatch = 1
End Function

Function PpIsIdentCont(c As Long) As Long
    If (c >= CH_A And c <= CH_Z) Or (c >= CH_La And c <= CH_Lz) Or (c >= CH_0 And c <= CH_9) Or c = CH_UNDER Then
        PpIsIdentCont = 1
    Else
        PpIsIdentCont = 0
    End If
End Function
