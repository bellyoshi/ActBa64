' PreprocInc - include 展開

' 戻り値 true : 正常終了  false : エラーあり
Function PpAppend(dst As *Byte, ByRef dstLen As Long, dstCap As Long, src As *Byte, n As Long) As boolean
    Dim i As Long
    PpAppend = false
    If dstLen + n + 1 > dstCap Then Exit Function
    i = 0
    While i < n
        dst[dstLen + i] = src[i]
        i = i + 1
    Wend
    dstLen = dstLen + n
    dst[dstLen] = CH_NUL
    PpAppend = true
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function PpEmitFileMark(dst As *Byte, ByRef dstLen As Long, dstCap As Long, path As *Byte) As boolean
    Dim hdr(KW_LEN - 1) As Byte
    Dim tail(PP_FILE_MARK_TAIL) As Byte
    PpEmitFileMark = false
    lstrcpy(VarPtr(hdr), "' ---- ")
    If Not PpAppend(dst, dstLen, dstCap, VarPtr(hdr), PP_FILE_MARK_HEAD) Then Exit Function
    If Not PpAppend(dst, dstLen, dstCap, path, lstrlen(path)) Then Exit Function
    lstrcpy(VarPtr(tail), " ----")
    tail[5] = CH_CR
    tail[6] = CH_NL
    tail[7] = CH_NUL
    If Not PpAppend(dst, dstLen, dstCap, VarPtr(tail), PP_FILE_MARK_TAIL) Then Exit Function
    PpEmitFileMark = true
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function PpEmitFileEnd(dst As *Byte, ByRef dstLen As Long, dstCap As Long) As boolean
    Dim s(PP_FILE_END_MARK) As Byte
    PpEmitFileEnd = false
    lstrcpy(VarPtr(s), "' ---- end ----")
    If Not PpAppend(dst, dstLen, dstCap, VarPtr(s), PP_FILE_END_MARK) Then Exit Function
    s[0] = CH_CR
    s[1] = CH_NL
    If Not PpAppend(dst, dstLen, dstCap, VarPtr(s), 2) Then Exit Function
    PpEmitFileEnd = true
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function PpNameIsEnd(name As *Byte) As boolean
    PpNameIsEnd = false
    If name = 0 Then Exit Function
    If ToLowerChar(name[0]) <> CH_Le Then Exit Function
    If ToLowerChar(name[1]) <> CH_Ln Then Exit Function
    If ToLowerChar(name[2]) <> CH_Ld Then Exit Function
    If name[3] <> CH_NUL Then Exit Function
    PpNameIsEnd = true
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function PpLineIsFileMark(line As *Byte, n As Long, nameOut As *Byte, nameMax As Long) As boolean
    Dim i As Long
    Dim nameLen As Long
    PpLineIsFileMark = false
    nameOut[0] = CH_NUL
    i = 0
    While i < n
        If Not IsHSpace(line[i]) Then Exit While
        i = i + 1
    Wend
    If i + PP_FILE_MARK_HEAD > n Then Exit Function
    If line[i] <> CH_SQUOTE Then Exit Function
    If line[i + 1] <> CH_SP Then Exit Function
    If line[i + 2] <> CH_MINUS Then Exit Function
    If line[i + 3] <> CH_MINUS Then Exit Function
    If line[i + 4] <> CH_MINUS Then Exit Function
    If line[i + 5] <> CH_MINUS Then Exit Function
    If line[i + 6] <> CH_SP Then Exit Function
    i = i + PP_FILE_MARK_HEAD
    nameLen = 0
    While i < n
        If i + PP_FILE_MARK_ENDSEP <= n Then
            If line[i] = CH_SP And line[i + 1] = CH_MINUS And line[i + 2] = CH_MINUS And line[i + 3] = CH_MINUS And line[i + 4] = CH_MINUS Then
                Exit While
            End If
        End If
        If nameLen < nameMax - 1 Then
            nameOut[nameLen] = line[i]
            nameLen = nameLen + 1
        End If
        i = i + 1
    Wend
    nameOut[nameLen] = CH_NUL
    If nameLen <= 0 Then Exit Function
    PpLineIsFileMark = true
End Function

Function PpLineEndAt(src As *Byte, from As Long) As Long
    Dim i As Long
    Dim c As Long
    i = from
    While src[i] <> CH_NUL
        c = src[i]
        If c = CH_NL Or c = CH_CR Then Exit While
        i = i + 1
    Wend
    PpLineEndAt = i
End Function

Sub PpCopyMarkName(dst As *Byte, src As *Byte)
    Dim k As Long
    k = 0
    While src[k] <> CH_NUL And k < PJ_PATH_LEN - 1
        dst[k] = src[k]
        k = k + 1
    Wend
    dst[k] = CH_NUL
End Sub

Dim g_mapSrc As *Byte
Dim g_mapI As Long
Dim g_mapCur As Long
Dim g_mapNest As Long
Dim g_mapHit As Long
Dim g_mapLocal As Long
Dim g_mapNames(4159) As Byte
Dim g_mapLocs(15) As Long
Dim g_mapOut(259) As Byte

Sub PpMapReset()
    g_mapSrc = NULL
    g_mapI = 0
    g_mapCur = 1
    g_mapNest = 0
    g_mapHit = 0
    g_mapLocal = 1
    g_mapOut(0) = 0
End Sub

Sub PpMapPush(name As *Byte)
    Dim off As Long
    If g_mapNest >= PP_MAX_DEPTH Then Exit Sub
    off = g_mapNest * PJ_PATH_LEN
    PpCopyMarkName(VarPtr(g_mapNames(off)), name)
    g_mapLocs(g_mapNest) = 0
    g_mapNest = g_mapNest + 1
End Sub

Sub PpMapMark(name As *Byte)
    If PpNameIsEnd(name) <> 0 Then
        If g_mapNest > 0 Then g_mapNest = g_mapNest - 1
    Else
        PpMapPush(name)
    End If
End Sub

Sub PpMapNoteLine(src As *Byte, start As Long, n As Long)
    Dim name(PJ_PATH_LEN - 1) As Byte
    If PpLineIsFileMark(VarPtr(src[start]), n, VarPtr(name), PJ_PATH_LEN) Then
        PpMapMark(VarPtr(name))
    ElseIf g_mapNest > 0 Then
        g_mapLocs(g_mapNest - 1) = g_mapLocs(g_mapNest - 1) + 1
    End If
End Sub

Sub PpMapAdvance(src As *Byte)
    If src[g_mapI] = CH_CR Then g_mapI = g_mapI + 1
    If src[g_mapI] = CH_NL Then g_mapI = g_mapI + 1
    g_mapCur = g_mapCur + 1
End Sub

Function PpMapStep(src As *Byte) As Long
    Dim start As Long
    PpMapStep = 0
    If src[g_mapI] = CH_NUL Then Exit Function
    start = g_mapI
    g_mapI = PpLineEndAt(src, g_mapI)
    PpMapNoteLine(src, start, g_mapI - start)
    PpMapStep = 1
End Function

Sub PpMapCopyOut(off As Long)
    Dim k As Long
    k = 0
    While g_mapNames(off + k) <> 0 And k < PJ_PATH_LEN - 1
        g_mapOut(k) = g_mapNames(off + k)
        k = k + 1
    Wend
    g_mapOut(k) = 0
End Sub

Sub PpMapLocal()
    g_mapLocal = 1
    If g_mapNest <= 0 Then Exit Sub
    g_mapLocal = g_mapLocs(g_mapNest - 1)
    If g_mapLocal < 1 Then g_mapLocal = 1
End Sub

Sub PpMapStore()
    Dim off As Long
    g_mapHit = g_mapCur
    g_mapOut(0) = 0
    PpMapLocal()
    off = 0
    If g_mapNest > 0 Then off = (g_mapNest - 1) * PJ_PATH_LEN
    If g_mapNest > 0 Then PpMapCopyOut(off)
End Sub

Function PpMapSrcName$(src As *Byte, combLine As Long, ByRef localLine As Long) As String
    PpMapSrcName$ = ""
    localLine = combLine
    If src = 0 Then Exit Function
    If combLine <= 0 Then combLine = 1
    If src <> g_mapSrc Or (combLine < g_mapCur And combLine <> g_mapHit) Then PpMapReset()
    g_mapSrc = src
    If combLine = g_mapHit Then
        localLine = g_mapLocal
        PpMapSrcName$ = MakeStr(VarPtr(g_mapOut(0)))
        Exit Function
    End If
    While src[g_mapI] <> CH_NUL
        If PpMapStep(src) = 0 Then Exit While
        If g_mapCur >= combLine Then Exit While
        PpMapAdvance(src)
    Wend
    PpMapStore()
    PpMapAdvance(src)
    localLine = g_mapLocal
    PpMapSrcName$ = MakeStr(VarPtr(g_mapOut(0)))
End Function

Function PpErrLoc$(src As *Byte, combLine As Long) As String
    Dim file As String
    Dim localLine As Long
    file = PpMapSrcName$(src, combLine, localLine)
    If Len(file) > 0 Then
        PpErrLoc$ = file + "(" + Str$(localLine) + ")"
    Else
        PpErrLoc$ = "line " + Str$(combLine)
    End If
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function PpEmitLineCrlf(dst As *Byte, ByRef dstLen As Long, dstCap As Long, line As *Byte, n As Long) As boolean
    Dim crlf(1) As Byte
    PpEmitLineCrlf = false
    If n > 0 Then
        If Not PpAppend(dst, dstLen, dstCap, line, n) Then Exit Function
    End If
    crlf[0] = CH_CR
    crlf[1] = CH_NL
    If Not PpAppend(dst, dstLen, dstCap, VarPtr(crlf), 2) Then Exit Function
    PpEmitLineCrlf = true
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function PpResolveIncPath(inc As *Byte, isAngle As Long, curFile As *Byte, full As *Byte) As boolean
    Dim dir(PP_ONCE_PATH - 1) As Byte
    PpResolveIncPath = false
    full[0] = CH_NUL
    If inc[0] = CH_NUL Then Exit Function
    If isAngle <> 0 Then
        If PpResolveAngleInclude(inc, full) = 0 Then Exit Function
    ElseIf (inc[1] = CH_COLON) Or (inc[0] = CH_BSLASH) Or (inc[0] = CH_SLASH) Then
        lstrcpy(full, inc)
    Else
        PpDirOf(curFile, VarPtr(dir))
        lstrcpy(full, VarPtr(dir))
        lstrcat(full, inc)
    End If
    PpResolveIncPath = true
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function PpExpandIncludeLine(dst As *Byte, ByRef dstLen As Long, dstCap As Long, line As *Byte, n As Long, curFile As *Byte, depth As Long) As boolean
    Dim inc(PP_WITH_CUR_LEN - 1) As Byte
    Dim full(PP_ONCE_PATH - 1) As Byte
    Dim isAngle As Long
    Dim child As *Byte
    Dim childSize As Long
    PpExpandIncludeLine = false
    isAngle = 0
    If Not PpExtractInclude(line, n, VarPtr(inc), isAngle) Then Exit Function
    If Not PpResolveIncPath(VarPtr(inc), isAngle, curFile, VarPtr(full)) Then Exit Function
    If Not PpEmitLineCrlf(dst, dstLen, dstCap, line, n) Then Exit Function
    If PpOnceHas(VarPtr(full)) Then
        PpExpandIncludeLine = true
        Exit Function
    End If
    child = LoadFile(VarPtr(full), childSize)
    If child = NULL Then Exit Function
    PpOnceAdd(VarPtr(full))
    If Not PpExpandInto(dst, dstLen, dstCap, child, childSize, VarPtr(full), depth + 1) Then
        free(child)
        Exit Function
    End If
    free(child)
    PpExpandIncludeLine = true
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function PpExpandNormalLine(dst As *Byte, ByRef dstLen As Long, dstCap As Long, line As *Byte, n As Long) As boolean
    Dim wOut(PP_LINE_MAX - 1) As Byte
    Dim wN As Long
    Dim wSt As Long
    PpExpandNormalLine = false
    wN = 0
    wSt = PpRewriteWithLine(line, n, VarPtr(wOut), wN)
    If wSt = 0 Then
        If g_ppDidPrintErr = 0 Then
            Print "error: too long line after With rewrite (>" + Str$(PP_LINE_MAX) + ")"
            g_ppDidPrintErr = 1
        End If
        Exit Function
    End If
    If wSt = 2 Then
        ' With / End With 行は出力しない
        PpExpandNormalLine = true
        Exit Function
    End If
    If wSt = 1 And wN > 0 Then
        If Not PpEmitLineCrlf(dst, dstLen, dstCap, VarPtr(wOut), wN) Then Exit Function
    Else
        If Not PpEmitLineCrlf(dst, dstLen, dstCap, line, n) Then Exit Function
    End If
    PpExpandNormalLine = true
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function PpExpandInto(dst As *Byte, ByRef dstLen As Long, dstCap As Long, src As *Byte, srcSize As Long, curFile As *Byte, depth As Long) As boolean
    Dim i As Long
    Dim start As Long
    Dim n As Long
    Dim c As Long
    Dim line(PP_LINE_MAX - 1) As Byte
    Dim j As Long
    Dim lineNo As Long

    PpExpandInto = false
    If depth >= PP_MAX_DEPTH Then Exit Function
    If depth = 0 Then PpWithReset()
    If Not PpEmitFileMark(dst, dstLen, dstCap, curFile) Then Exit Function
    i = 0
    lineNo = 1
    While i < srcSize
        start = i
        While i < srcSize
            c = src[i]
            If c = CH_NL Or c = CH_CR Then Exit While
            i = i + 1
        Wend
        n = i - start
        If n >= PP_LINE_MAX Then
            PpErrorTooLongLine(curFile, lineNo, n)
            Exit Function
        End If
        j = 0
        While j < n
            line[j] = src[start + j]
            j = j + 1
        Wend
        line[n] = CH_NUL
        If PpTryResourceLine(VarPtr(line), n, curFile) Then
            ' #resource 行は出力しない
        ElseIf PpIsIncludeLine(VarPtr(line), n) Then
            If Not PpExpandIncludeLine(dst, dstLen, dstCap, VarPtr(line), n, curFile, depth) Then Exit Function
        Else
            If Not PpExpandNormalLine(dst, dstLen, dstCap, VarPtr(line), n) Then Exit Function
        End If
        If i < srcSize And src[i] = CH_CR Then i = i + 1
        If i < srcSize And src[i] = CH_NL Then i = i + 1
        lineNo = lineNo + 1
    Wend
    If Not PpEmitFileEnd(dst, dstLen, dstCap) Then Exit Function
    PpExpandInto = true
End Function

Function ExpandIncludes(src As *Byte, srcSize As Long, srcPath As *Byte) As *Byte
    Dim dst As *Byte
    Dim dstLen As Long
    Dim dstCap As Long

    ExpandIncludes = NULL
    dstCap = BytesN(srcSize, PP_EXPAND_GROW) + PP_EXPAND_EXTRA
    If dstCap < PP_EXPAND_MIN Then dstCap = PP_EXPAND_MIN
    dst = calloc(dstCap)
    If dst = NULL Then Exit Function
    dstLen = 0
    dst[0] = CH_NUL
    If Not PpExpandInto(dst, dstLen, dstCap, src, srcSize, srcPath, 0) Then
        free(dst)
        Exit Function
    End If
    ExpandIncludes = dst
End Function

Function PpSourceHasStrict(src As *Byte) As Long
    Dim i As Long
    Dim start As Long
    Dim n As Long
    Dim line(PP_STRICT_LINE - 1) As Byte
    Dim j As Long
    Dim word(KW_LEN - 1) As Byte

    PpSourceHasStrict = 0
    If src = NULL Then Exit Function
    i = 0
    While src[i] <> CH_NUL
        start = i
        While src[i] <> CH_NUL And src[i] <> CH_NL And src[i] <> CH_CR
            i = i + 1
        Wend
        n = i - start
        If n > PP_STRICT_LINE - 1 Then n = PP_STRICT_LINE - 1
        j = 0
        While j < n
            line[j] = src[start + j]
            j = j + 1
        Wend
        line[n] = CH_NUL
        j = 0
        While j < n And IsHSpace(line[j])
            j = j + 1
        Wend
        If j < n And line[j] = CH_HASH Then
            j = j + 1
            While j < n And IsHSpace(line[j])
                j = j + 1
            Wend
            lstrcpy(VarPtr(word), "strict")
            If PpLineWordMatch(VarPtr(line), j, n, VarPtr(word)) Then
                PpSourceHasStrict = 1
                Exit Function
            End If
        End If
        If i < 0 Then Exit While
        If src[i] = CH_CR Then i = i + 1
        If src[i] = CH_NL Then i = i + 1
    Wend
End Function

' 戻り値 true : 成り立つ  false : 成り立たない
Function PpLineWordMatch(line As *Byte, pos As Long, n As Long, word As *Byte) As boolean
    Dim i As Long
    Dim wi As Long
    PpLineWordMatch = false
    i = pos
    wi = 0
    While word[wi] <> CH_NUL And i < n
        If ToLowerChar(line[i]) <> ToLowerChar(word[wi]) Then Exit Function
        i = i + 1
        wi = wi + 1
    Wend
    If word[wi] <> CH_NUL Then Exit Function
    If i < n And PpIsIdentCont(line[i]) Then Exit Function
    PpLineWordMatch = true
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function PpIsIdentCont(c As Long) As boolean
    If IsAlphabet(c) Or IsDigit(c) Or c = CH_UNDER Then
        PpIsIdentCont = true
    Else
        PpIsIdentCont = false
    End If
End Function
