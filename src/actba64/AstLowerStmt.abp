' ===================================================
'  AstLowerStmt - jumps / Dim / Assign / Print / File IO
' ===================================================

Function LowJumpIfFalse(ctx As *LowerCtx, idx As Long, lab As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim op As Long
    Dim jcc As Long
    Dim labSkip As Long

    LowJumpIfFalse = 0
    ast = ctx->ast
    nodes = ast->nodes
    If nodes[idx].kind = AST_UNARY Then
        If nodes[idx].num = UOP_NOT Then
            If Not LowJumpIfTrue(ctx, nodes[idx].left, lab) Then Exit Function
            LowJumpIfFalse = 1
            Exit Function
        End If
    End If
    If nodes[idx].kind <> AST_BINOP Then
        If LowExpr(ctx, idx) = 0 Then Exit Function
        IrEmit(ctx->list, OP_TEST_EAX, 0, 0)
        IrEmit(ctx->list, OP_JZ, lab, 0)
        LowJumpIfFalse = 1
        Exit Function
    End If
    op = nodes[idx].num
    If op = BOP_AND Then
        If LowJumpIfFalse(ctx, nodes[idx].left, lab) = 0 Then Exit Function
        If LowJumpIfFalse(ctx, nodes[idx].right, lab) = 0 Then Exit Function
        LowJumpIfFalse = 1
    ElseIf op = BOP_OR Then
        labSkip = LowNewLabel(ctx)
        If Not LowJumpIfTrue(ctx, nodes[idx].left, labSkip) Then Exit Function
        If LowJumpIfFalse(ctx, nodes[idx].right, lab) = 0 Then Exit Function
        IrEmit(ctx->list, OP_LABEL, labSkip, 0)
        LowJumpIfFalse = 1
    ElseIf op = BOP_EQ Or op = BOP_NE Or op = BOP_LT Or op = BOP_LE Or op = BOP_GT Or op = BOP_GE Then
        jcc = LowCmpFalseJcc(ctx, idx)
        If jcc = 0 Then Exit Function
        IrEmit(ctx->list, jcc, lab, 0)
        LowJumpIfFalse = 1
    Else
        If LowExpr(ctx, idx) = 0 Then Exit Function
        IrEmit(ctx->list, OP_TEST_EAX, 0, 0)
        IrEmit(ctx->list, OP_JZ, lab, 0)
        LowJumpIfFalse = 1
    End If
End Function

' 比較 BINOP が真のとき lab へ飛ぶ
' 戻り値 true : 正常終了  false : エラーあり
Function LowJumpCmpTrue(ctx As *LowerCtx, idx As Long, lab As Long) As boolean
    Dim jcc As Long
    Dim jTrue As Long

    LowJumpCmpTrue = false
    jcc = LowCmpFalseJcc(ctx, idx)
    If jcc = 0 Then Exit Function
    jTrue = LowCmpTrueJcc(jcc)
    If jTrue = 0 Then
        ctx->err = 1
        Exit Function
    End If
    IrEmit(ctx->list, jTrue, lab, 0)
    LowJumpCmpTrue = true
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function LowJumpIfTrue(ctx As *LowerCtx, idx As Long, lab As Long) As boolean
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim op As Long
    Dim labSkip As Long

    LowJumpIfTrue = false
    ast = ctx->ast
    nodes = ast->nodes
    If nodes[idx].kind = AST_UNARY Then
        If nodes[idx].num = UOP_NOT Then
            If LowJumpIfFalse(ctx, nodes[idx].left, lab) = 0 Then Exit Function
            LowJumpIfTrue = true
            Exit Function
        End If
    End If
    If nodes[idx].kind <> AST_BINOP Then
        If LowExpr(ctx, idx) = 0 Then Exit Function
        IrEmit(ctx->list, OP_TEST_EAX, 0, 0)
        IrEmit(ctx->list, OP_JNZ, lab, 0)
        LowJumpIfTrue = true
        Exit Function
    End If
    op = nodes[idx].num
    If op = BOP_OR Then
        If Not LowJumpIfTrue(ctx, nodes[idx].left, lab) Then Exit Function
        If Not LowJumpIfTrue(ctx, nodes[idx].right, lab) Then Exit Function
        LowJumpIfTrue = true
    ElseIf op = BOP_AND Then
        labSkip = LowNewLabel(ctx)
        If LowJumpIfFalse(ctx, nodes[idx].left, labSkip) = 0 Then Exit Function
        If Not LowJumpIfTrue(ctx, nodes[idx].right, lab) Then Exit Function
        IrEmit(ctx->list, OP_LABEL, labSkip, 0)
        LowJumpIfTrue = true
    ElseIf op = BOP_EQ Or op = BOP_NE Or op = BOP_LT Or op = BOP_LE Or op = BOP_GT Or op = BOP_GE Then
        If Not LowJumpCmpTrue(ctx, idx, lab) Then Exit Function
        LowJumpIfTrue = true
    Else
        If LowExpr(ctx, idx) = 0 Then Exit Function
        IrEmit(ctx->list, OP_TEST_EAX, 0, 0)
        IrEmit(ctx->list, OP_JNZ, lab, 0)
        LowJumpIfTrue = true
    End If
End Function

' If を別関数に分離（LowStmt 巨大フレームの入れ子によるスタック破壊を避ける）
Function LowStmtIf(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim labElse As Long
    Dim labEnd As Long
    Dim thenList As Long
    Dim elseList As Long
    Dim r As Long

    LowStmtIf = 0
    ast = ctx->ast
    nodes = ast->nodes
    thenList = nodes[idx].right
    elseList = nodes[idx].extra
    labElse = LowNewLabel(ctx)
    labEnd = LowNewLabel(ctx)
    r = LowJumpIfFalse(ctx, nodes[idx].left, labElse)
    If r = 0 Then Exit Function
    r = LowStmtList(ctx, thenList)
    If r = 0 Then Exit Function
    IrEmit(ctx->list, OP_JMP, labEnd, 0)
    IrEmit(ctx->list, OP_LABEL, labElse, 0)
    r = LowStmtList(ctx, elseList)
    If r = 0 Then Exit Function
    IrEmit(ctx->list, OP_LABEL, labEnd, 0)
    LowStmtIf = 1
End Function

Function LowStmt(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim kind As Long

    ' 薄いディスパッチ: 巨大フレームの LowStmtDispatch を入れ子にしない
    LowStmt = 0
    If idx < 0 Then
        LowStmt = 1
        Exit Function
    End If
    ast = ctx->ast
    nodes = ast->nodes
    kind = nodes[idx].kind
    If LnIsJump(kind) <> 0 Then
        LowStmt = LnEmit(ctx, idx)
        Exit Function
    End If
    If kind = AST_IF Then
        LowStmt = LowStmtIf(ctx, idx)
        Exit Function
    End If
    If kind = AST_CALL Then
        LowStmt = LowExpr(ctx, idx)
        Exit Function
    End If
    If kind = AST_EXITFUNC Then
        If g_funcEndLab < 0 Then
            ctx->err = 1
            Exit Function
        End If
        IrEmit(ctx->list, OP_JMP, g_funcEndLab, 0)
        LowStmt = 1
        Exit Function
    End If
    LowStmt = LowStmtDispatch(ctx, idx)
End Function

' クラス typeIdx の Ctor ラベルを引く（マングル名を dst へ）
Function LowFindCtorLab(ctx As *LowerCtx, typeTable As *TypeTable, typeIdx As Long, dst As *Byte) As Long
    Dim j As Long
    Dim kCtor(KW_SHORT_LEN - 1) As Byte
    Dim names As *Byte

    j = typeIdx * TYNAME_LEN
    lstrcpy(VarPtr(kCtor), "Ctor")
    names = typeTable->typeNames
    LowMangleClass(VarPtr(names[j]), VarPtr(kCtor), dst)
    LowFindCtorLab = LowFindFunc(ctx, dst)
End Function

' this を含む Ctor 引数の個数。AST_ARG 以外が先頭なら -1
Function LowCtorArgCount(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim argNode As Long
    Dim nArgs As Long

    ast = ctx->ast
    nodes = ast->nodes
    nArgs = 1
    argNode = nodes[idx].right
    While argNode >= 0
        If nodes[argNode].kind <> AST_ARG Then Exit While
        nArgs = nArgs + 1
        argNode = nodes[argNode].nxt
    Wend
    If nodes[idx].right >= 0 Then
        If nodes[nodes[idx].right].kind <> AST_ARG Then
            nArgs = -1
        End If
    End If
    LowCtorArgCount = nArgs
End Function

' Ctor のユーザー引数を rsp+8.. のホーム領域へ
' 戻り値 true : 正常終了  false : エラーあり
Function LowEmitCtorArgs(ctx As *LowerCtx, idx As Long, nArgs As Long) As boolean
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim argIdx As Long
    Dim argNode As Long

    LowEmitCtorArgs = false
    ast = ctx->ast
    nodes = ast->nodes
    argIdx = 1
    argNode = nodes[idx].right
    While argIdx < nArgs
        If LowExprArg(ctx, nodes[argNode].left) = 0 Then Exit Function
        IrEmit(ctx->list, OP_STORE_RSP_RAX, argIdx * TyPtrSize(), 0)
        argIdx = argIdx + 1
        argNode = nodes[argNode].nxt
    Wend
    LowEmitCtorArgs = true
End Function

' this をホーム領域へ置いて Ctor を呼ぶ
' 戻り値 true : 正常終了  false : エラーあり
Function LowEmitCtorCall(ctx As *LowerCtx, idx As Long, lab As Long, nArgs As Long, callBytes As Long) As boolean
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim ast As *Ast
    Dim fname(SYM_NAME_LEN - 1) As Byte

    LowEmitCtorCall = false
    ast = ctx->ast
    AstCopyStr(ast, idx, VarPtr(fname))
    If Not LowLookupVar(ctx, VarPtr(fname), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) Then
        ctx->err = 1
        Exit Function
    End If
    LowEmitLeaOff(ctx->list, vOff, vGlob)
    IrEmit(ctx->list, OP_STORE_RSP_RAX, 0, 0)
    LowEmitLoadRegArgs(ctx->list, nArgs)
    IrEmit(ctx->list, OP_CALL_LAB, lab, 0)
    LowEmitCallFinish(ctx->list, callBytes)
    LowEmitCtorCall = true
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function LowStmtDimCtor(ctx As *LowerCtx, idx As Long) As boolean
    Dim stackPad(LOW_STACK_PAD - 1) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim lab As Long
    Dim typeTable As *TypeTable
    Dim typeIdx As Long
    Dim nArgs As Long
    Dim callBytes As Long

    LowStmtDimCtor = false
    ast = ctx->ast
    nodes = ast->nodes
    typeTable = ast->types
    AstCopyStr(ast, idx, VarPtr(name))
    If nodes[idx].num <> TY_UDT Then
        Exit Function
    End If
    typeIdx = nodes[idx].extra
    If typeIdx < 0 Then Exit Function
    If TyIsClass(typeTable, typeIdx) = 0 Then Exit Function
    lab = LowFindCtorLab(ctx, typeTable, typeIdx, VarPtr(name))
    If lab < 0 Then
        Print "error: missing ctor '" + MakeStr(VarPtr(name)) + "'"
        ctx->err = 1
        Exit Function
    End If
    nArgs = LowCtorArgCount(ctx, idx)
    If nArgs <= 0 Then Exit Function
    callBytes = LowCallBytes(nArgs)
    If callBytes > 0 Then
        IrEmit(ctx->list, OP_SUB_RSP, callBytes, 0)
    End If
    If Not LowEmitCtorArgs(ctx, idx, nArgs) Then Exit Function
    If Not LowEmitCtorCall(ctx, idx, lab, nArgs, callBytes) Then Exit Function
    LowStmtDimCtor = true
End Function

Function LowStmtDim(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(LOW_STACK_PAD - 1) As Byte
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(SYM_NAME_LEN - 1) As Byte

    LowStmtDim = 0
    ast = ctx->ast
    nodes = ast->nodes
    If LowStmtDimCtor(ctx, idx) Then
        LowStmtDim = 1
        Exit Function
    End If
    If ctx->err <> 0 Then Exit Function
    If nodes[idx].right >= 0 Then
        If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
        AstCopyStr(ast, idx, VarPtr(name))
        If Not LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) Then
            ctx->err = 1
            Exit Function
        End If
        If vTy = TY_SINGLE Then
            LowEmitCvtToSingleIfNeeded(ctx, nodes[idx].right)
        ElseIf vTy = TY_DOUBLE Then
            LowEmitCvtToDoubleIfNeeded(ctx, nodes[idx].right)
        Else
            LowEmitCvtToLongIfNeeded(ctx, nodes[idx].right, vTy)
        End If
        If LowEmitStoreIfDbl(ctx->list, vOff, vTy, vByRef, vGlob) = 0 Then
            LowEmitStoreOff(ctx->list, vOff, vGlob)
        End If
    End If
    LowStmtDim = 1
End Function
