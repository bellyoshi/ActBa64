' ===================================================
'  AstLowerStmt - jumps / Dim / Assign / Print / File IO
' ===================================================

Function LowJumpIfFalse(ctx As *LowerCtx, idx As Long, lab As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim op As Long
    Dim jcc As Long
    Dim labSkip As Long

    LowJumpIfFalse = 0
    ast = ctx->ast
    nodes = ast->nodes
    If nodes[idx].kind = AST_UNARY Then
        If nodes[idx].num = UOP_NOT Then
            If LowJumpIfTrue(ctx, nodes[idx].left, lab) = 0 Then Exit Function
            LowJumpIfFalse = 1
            Exit Function
        End If
    End If
    If nodes[idx].kind <> AST_BINOP Then
        If LowExpr(ctx, idx) = 0 Then Exit Function
        IrEmit(ctx->list, OP_TEST_EAX, 0, 0)
        IrEmit(ctx->list, OP_JZ, lab, 0)
        LowJumpIfFalse = 1
        Exit Function
    End If
    op = nodes[idx].num
    If op = BOP_AND Then
        If LowJumpIfFalse(ctx, nodes[idx].left, lab) = 0 Then Exit Function
        If LowJumpIfFalse(ctx, nodes[idx].right, lab) = 0 Then Exit Function
        LowJumpIfFalse = 1
    ElseIf op = BOP_OR Then
        labSkip = LowNewLab(ctx)
        If LowJumpIfTrue(ctx, nodes[idx].left, labSkip) = 0 Then Exit Function
        If LowJumpIfFalse(ctx, nodes[idx].right, lab) = 0 Then Exit Function
        IrEmit(ctx->list, OP_LABEL, labSkip, 0)
        LowJumpIfFalse = 1
    ElseIf op = BOP_EQ Or op = BOP_NE Or op = BOP_LT Or op = BOP_LE Or op = BOP_GT Or op = BOP_GE Then
        jcc = LowCmpFalseJcc(ctx, idx)
        If jcc = 0 Then Exit Function
        IrEmit(ctx->list, jcc, lab, 0)
        LowJumpIfFalse = 1
    Else
        If LowExpr(ctx, idx) = 0 Then Exit Function
        IrEmit(ctx->list, OP_TEST_EAX, 0, 0)
        IrEmit(ctx->list, OP_JZ, lab, 0)
        LowJumpIfFalse = 1
    End If
End Function

' 比較 BINOP が真のとき lab へ飛ぶ
Function LowJumpCmpTrue(ctx As *LowerCtx, idx As Long, lab As Long) As Long
    Dim jcc As Long
    Dim jTrue As Long

    LowJumpCmpTrue = 0
    jcc = LowCmpFalseJcc(ctx, idx)
    If jcc = 0 Then Exit Function
    jTrue = LowCmpTrueJcc(jcc)
    If jTrue = 0 Then
        ctx->err = 1
        Exit Function
    End If
    IrEmit(ctx->list, jTrue, lab, 0)
    LowJumpCmpTrue = 1
End Function

Function LowJumpIfTrue(ctx As *LowerCtx, idx As Long, lab As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim op As Long
    Dim labSkip As Long

    LowJumpIfTrue = 0
    ast = ctx->ast
    nodes = ast->nodes
    If nodes[idx].kind = AST_UNARY Then
        If nodes[idx].num = UOP_NOT Then
            If LowJumpIfFalse(ctx, nodes[idx].left, lab) = 0 Then Exit Function
            LowJumpIfTrue = 1
            Exit Function
        End If
    End If
    If nodes[idx].kind <> AST_BINOP Then
        If LowExpr(ctx, idx) = 0 Then Exit Function
        IrEmit(ctx->list, OP_TEST_EAX, 0, 0)
        IrEmit(ctx->list, OP_JNZ, lab, 0)
        LowJumpIfTrue = 1
        Exit Function
    End If
    op = nodes[idx].num
    If op = BOP_OR Then
        If LowJumpIfTrue(ctx, nodes[idx].left, lab) = 0 Then Exit Function
        If LowJumpIfTrue(ctx, nodes[idx].right, lab) = 0 Then Exit Function
        LowJumpIfTrue = 1
    ElseIf op = BOP_AND Then
        labSkip = LowNewLab(ctx)
        If LowJumpIfFalse(ctx, nodes[idx].left, labSkip) = 0 Then Exit Function
        If LowJumpIfTrue(ctx, nodes[idx].right, lab) = 0 Then Exit Function
        IrEmit(ctx->list, OP_LABEL, labSkip, 0)
        LowJumpIfTrue = 1
    ElseIf op = BOP_EQ Or op = BOP_NE Or op = BOP_LT Or op = BOP_LE Or op = BOP_GT Or op = BOP_GE Then
        If LowJumpCmpTrue(ctx, idx, lab) = 0 Then Exit Function
        LowJumpIfTrue = 1
    Else
        If LowExpr(ctx, idx) = 0 Then Exit Function
        IrEmit(ctx->list, OP_TEST_EAX, 0, 0)
        IrEmit(ctx->list, OP_JNZ, lab, 0)
        LowJumpIfTrue = 1
    End If
End Function

' If を別関数に分離（LowStmt 巨大フレームの入れ子によるスタック破壊を避ける）
Function LowStmtIf(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim labElse As Long
    Dim labEnd As Long
    Dim thenList As Long
    Dim elseList As Long
    Dim r As Long

    LowStmtIf = 0
    ast = ctx->ast
    nodes = ast->nodes
    thenList = nodes[idx].right
    elseList = nodes[idx].extra
    labElse = LowNewLab(ctx)
    labEnd = LowNewLab(ctx)
    r = LowJumpIfFalse(ctx, nodes[idx].left, labElse)
    If r = 0 Then Exit Function
    r = LowStmtList(ctx, thenList)
    If r = 0 Then Exit Function
    IrEmit(ctx->list, OP_JMP, labEnd, 0)
    IrEmit(ctx->list, OP_LABEL, labElse, 0)
    r = LowStmtList(ctx, elseList)
    If r = 0 Then Exit Function
    IrEmit(ctx->list, OP_LABEL, labEnd, 0)
    LowStmtIf = 1
End Function

Function LowStmt(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim k As Long

    ' 薄いディスパッチ: 巨大フレームの LowStmtHeavy を入れ子にしない
    LowStmt = 0
    If idx < 0 Then
        LowStmt = 1
        Exit Function
    End If
    ast = ctx->ast
    nodes = ast->nodes
    k = nodes[idx].kind
    If k = AST_IF Then
        LowStmt = LowStmtIf(ctx, idx)
        Exit Function
    End If
    If k = AST_CALL Then
        LowStmt = LowExpr(ctx, idx)
        Exit Function
    End If
    If k = AST_EXITFUNC Then
        If g_funcEndLab < 0 Then
            ctx->err = 1
            Exit Function
        End If
        IrEmit(ctx->list, OP_JMP, g_funcEndLab, 0)
        LowStmt = 1
        Exit Function
    End If
    LowStmt = LowStmtHeavy(ctx, idx)
End Function

' クラス ti の Ctor ラベルを引く（マングル名を dst へ）
Function LowFindCtorLab(ctx As *LowerCtx, tt As *TypeTable, ti As Long, dst As *Byte) As Long
    Dim j As Long
    Dim kCtor(7) As Byte
    Dim names As *Byte

    j = ti * 48
    lstrcpy(VarPtr(kCtor), "Ctor")
    names = tt->typeNames
    LowMangleClass(VarPtr(names[j]), VarPtr(kCtor), dst)
    LowFindCtorLab = LowFindFunc(ctx, dst)
End Function

' this を含む Ctor 引数の個数。AST_ARG 以外が先頭なら -1
Function LowCtorArgCount(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim argn As Long
    Dim nArgs As Long

    ast = ctx->ast
    nodes = ast->nodes
    nArgs = 1
    argn = nodes[idx].right
    While argn >= 0
        If nodes[argn].kind <> AST_ARG Then Exit While
        nArgs = nArgs + 1
        argn = nodes[argn].nxt
    Wend
    If nodes[idx].right >= 0 Then
        If nodes[nodes[idx].right].kind <> AST_ARG Then
            nArgs = -1
        End If
    End If
    LowCtorArgCount = nArgs
End Function

' Ctor のユーザー引数を rsp+8.. のホーム領域へ
Function LowEmitCtorArgs(ctx As *LowerCtx, idx As Long, nArgs As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim argi As Long
    Dim argn As Long

    LowEmitCtorArgs = 0
    ast = ctx->ast
    nodes = ast->nodes
    argi = 1
    argn = nodes[idx].right
    While argi < nArgs
        If LowExprArg(ctx, nodes[argn].left) = 0 Then Exit Function
        IrEmit(ctx->list, OP_STORE_RSP_RAX, argi * TyPtrSize(), 0)
        argi = argi + 1
        argn = nodes[argn].nxt
    Wend
    LowEmitCtorArgs = 1
End Function

' this をホーム領域へ置いて Ctor を呼ぶ
Function LowEmitCtorCall(ctx As *LowerCtx, idx As Long, lab As Long, nArgs As Long, stk As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim ast As *Ast
    Dim fname(63) As Byte

    LowEmitCtorCall = 0
    ast = ctx->ast
    AstCopyStr(ast, idx, VarPtr(fname))
    If LowLookupVar(ctx, VarPtr(fname), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
        ctx->err = 1
        Exit Function
    End If
    LowEmitLeaOff(ctx->list, vOff, vGlob)
    IrEmit(ctx->list, OP_STORE_RSP_RAX, 0, 0)
    LowEmitLoadRegArgs(ctx->list, nArgs)
    IrEmit(ctx->list, OP_CALL_LAB, lab, 0)
    LowEmitCallFinish(ctx->list, stk)
    LowEmitCtorCall = 1
End Function

Function LowStmtDimCtor(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim lab As Long
    Dim tt As *TypeTable
    Dim ti As Long
    Dim nArgs As Long
    Dim stk As Long

    LowStmtDimCtor = 0
    ast = ctx->ast
    nodes = ast->nodes
    tt = ast->types
    AstCopyStr(ast, idx, VarPtr(name))
    If nodes[idx].num <> TY_UDT Then
        Exit Function
    End If
    ti = nodes[idx].extra
    If ti < 0 Then Exit Function
    If TyIsClass(tt, ti) = 0 Then Exit Function
    lab = LowFindCtorLab(ctx, tt, ti, VarPtr(name))
    If lab < 0 Then
        Print "error: missing ctor '" + MakeStr(VarPtr(name)) + "'"
        ctx->err = 1
        Exit Function
    End If
    nArgs = LowCtorArgCount(ctx, idx)
    If nArgs <= 0 Then Exit Function
    stk = LowCallStk(nArgs)
    If stk > 0 Then
        IrEmit(ctx->list, OP_SUB_RSP, stk, 0)
    End If
    If LowEmitCtorArgs(ctx, idx, nArgs) = 0 Then Exit Function
    If LowEmitCtorCall(ctx, idx, lab, nArgs, stk) = 0 Then Exit Function
    LowStmtDimCtor = 1
End Function

Function LowStmtDim(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte

    LowStmtDim = 0
    ast = ctx->ast
    nodes = ast->nodes
    If LowStmtDimCtor(ctx, idx) <> 0 Then
        LowStmtDim = 1
        Exit Function
    End If
    If ctx->err <> 0 Then Exit Function
    If nodes[idx].right >= 0 Then
        If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
        AstCopyStr(ast, idx, VarPtr(name))
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
            ctx->err = 1
            Exit Function
        End If
        If vTy = TY_SINGLE Then
            LowEmitCvtToSingleIfNeeded(ctx, nodes[idx].right)
        ElseIf vTy = TY_DOUBLE Then
            LowEmitCvtToDoubleIfNeeded(ctx, nodes[idx].right)
        Else
            LowEmitCvtToLongIfNeeded(ctx, nodes[idx].right, vTy)
        End If
        LowEmitStoreOff(ctx->list, vOff, vGlob)
    End If
    LowStmtDim = 1
End Function


' rax = 要素アドレス, rcx = 値。要素型から幅を決めてストア
Sub LowStoreArrElem(ctx As *LowerCtx, vTy As Long, allowPtrLong As Long)
    If vTy = TY_STRING_ARR Or vTy = TY_DOUBLE_ARR Then
        IrEmit(ctx->list, OP_STORE_PTR, 0, 0)
    ElseIf vTy = TY_LONG_ARR Or vTy = TY_SINGLE_ARR Then
        LowStoreSized(ctx->list, 4)
    ElseIf allowPtrLong <> 0 And vTy = TY_PTR_LONG Then
        LowStoreSized(ctx->list, 4)
    Else
        IrEmit(ctx->list, OP_STORE_BYTE_RAX_CL, 0, 0)
    End If
End Sub

' a.b(i) = v — メンバ配列／ポインタフィールドへのストア
Function LowStoreIndexMember(ctx As *LowerCtx, base As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim ast As *Ast
    Dim tt As *TypeTable
    Dim name(63) As Byte
    Dim fname(63) As Byte
    Dim foff As Long
    Dim fsz As Long
    Dim fcnt As Long
    Dim fieldTy As Long
    Dim ti As Long

    LowStoreIndexMember = 0
    ast = ctx->ast
    tt = ast->types
    AstCopyStr(ast, base, VarPtr(fname))
    If LowMemberBaseName(ctx, base, VarPtr(name)) = 0 Then
        ctx->err = 1
        Exit Function
    End If
    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
        ctx->err = 1
        Exit Function
    End If
    ti = vTypeIdx
    If TyFindFieldEx(tt, ti, VarPtr(fname), foff, fsz, fcnt, fieldTy) = 0 Then
        ctx->err = 1
        Exit Function
    End If
    If fcnt > 1 Then
        LowStoreSized(ctx->list, fsz)
    ElseIf fsz = TyPtrSize() Then
        LowStoreSized(ctx->list, LowPtrFieldElemSize(fieldTy))
    Else
        ctx->err = 1
        Exit Function
    End If
    LowStoreIndexMember = 1
End Function

Function LowStmtAssignIndexStore(ctx As *LowerCtx, leftIdx As Long, leftK As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim base As Long

    LowStmtAssignIndexStore = 0
    ast = ctx->ast
    nodes = ast->nodes
    If leftK = AST_CALL Then
        AstCopyStr(ast, leftIdx, VarPtr(name))
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
            LowStoreArrElem(ctx, vTy, 0)
        Else
            IrEmit(ctx->list, OP_STORE_BYTE_RAX_CL, 0, 0)
        End If
    Else
        base = nodes[leftIdx].left
        If nodes[base].kind = AST_MEMBER Then
            If LowStoreIndexMember(ctx, base) = 0 Then Exit Function
        Else
            AstCopyStr(ast, base, VarPtr(name))
            If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
                LowStoreArrElem(ctx, vTy, 1)
            Else
                IrEmit(ctx->list, OP_STORE_BYTE_RAX_CL, 0, 0)
            End If
        End If
    End If
    LowStmtAssignIndexStore = 1
End Function

Function LowStmtAssignIndex(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim leftK As Long
    Dim leftIdx As Long
    Dim base As Long

    LowStmtAssignIndex = 0
    ast = ctx->ast
    nodes = ast->nodes
    leftIdx = nodes[idx].left
    leftK = nodes[leftIdx].kind
    If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
    If leftK = AST_CALL Then
        AstCopyStr(ast, leftIdx, VarPtr(name))
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
            If vTy = TY_SINGLE_ARR Then
                LowEmitCvtToSingleIfNeeded(ctx, nodes[idx].right)
            ElseIf vTy = TY_DOUBLE_ARR Then
                LowEmitCvtToDoubleIfNeeded(ctx, nodes[idx].right)
            End If
        End If
    Else
        base = nodes[leftIdx].left
        If nodes[base].kind = AST_VAR Then
            AstCopyStr(ast, base, VarPtr(name))
            If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
                If vTy = TY_SINGLE_ARR Then
                    LowEmitCvtToSingleIfNeeded(ctx, nodes[idx].right)
                ElseIf vTy = TY_DOUBLE_ARR Then
                    LowEmitCvtToDoubleIfNeeded(ctx, nodes[idx].right)
                End If
            End If
        End If
    End If
    IrEmit(ctx->list, OP_PUSH_RAX, 0, 0)
    If LowAddr(ctx, nodes[idx].left) = 0 Then Exit Function
    IrEmit(ctx->list, OP_POP_RCX, 0, 0)
    If LowStmtAssignIndexStore(ctx, leftIdx, leftK) = 0 Then Exit Function
    LowStmtAssignIndex = 1
End Function

Function LowStmtAssignMember(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim leftIdx As Long
    Dim fsz As Long
    Dim base As Long

    LowStmtAssignMember = 0
    ast = ctx->ast
    nodes = ast->nodes
    leftIdx = nodes[idx].left
    If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
    IrEmit(ctx->list, OP_PUSH_RAX, 0, 0)
    If LowAddr(ctx, nodes[idx].left) = 0 Then Exit Function
    IrEmit(ctx->list, OP_POP_RCX, 0, 0)
    fsz = LowMemberFieldSize(ctx, leftIdx)
    If fsz <= 0 Then
        AstCopyStr(ast, leftIdx, VarPtr(name))
        base = nodes[leftIdx].left
        If nodes[base].kind = AST_VAR Then
            AstCopyStr(ast, base, VarPtr(name))
            If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
                fsz = LowTyNbytes(vTy)
            End If
        End If
    End If
    If fsz <= 0 Then
        AstCopyStr(ast, leftIdx, VarPtr(name))
        Print "error: bad member field '" + MakeStr(VarPtr(name)) + "'"
        ctx->err = 1
        Exit Function
    End If
    LowStoreSized(ctx->list, fsz)
    LowStmtAssignMember = 1
End Function

Function LowStmtAssignVar(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte

    LowStmtAssignVar = 0
    ast = ctx->ast
    nodes = ast->nodes
    If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
    AstCopyStr(ast, nodes[idx].left, VarPtr(name))
    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
        LowerDiagError(ctx, idx, "assign to undefined '" + MakeStr(VarPtr(name)) + "'")
        Exit Function
    End If
    LowStrictCheckAssign(ctx, idx, vTy, vTypeIdx, nodes[idx].right)
    If vTy = TY_SINGLE Then
        LowEmitCvtToSingleIfNeeded(ctx, nodes[idx].right)
    ElseIf vTy = TY_DOUBLE Then
        LowEmitCvtToDoubleIfNeeded(ctx, nodes[idx].right)
    Else
        LowEmitCvtToLongIfNeeded(ctx, nodes[idx].right, vTy)
    End If
    If vByRef <> 0 Then
        IrEmit(ctx->list, OP_PUSH_RAX, 0, 0)
        LowEmitLoadOff(ctx->list, vOff, vGlob)
        IrEmit(ctx->list, OP_POP_RCX, 0, 0)
        IrEmit(ctx->list, OP_STORE_PTR, 0, 0)
    ElseIf vTy = TY_STRING Then
        LowEmitStoreString(ctx, vOff, vGlob)
    Else
        LowEmitStoreOff(ctx->list, vOff, vGlob)
    End If
    LowStmtAssignVar = 1
End Function

Function LowStmtAssign(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim leftK As Long
    Dim leftIdx As Long

    LowStmtAssign = 0
    ast = ctx->ast
    nodes = ast->nodes
    leftIdx = nodes[idx].left
    leftK = nodes[leftIdx].kind
    If leftK = AST_INDEX Or leftK = AST_CALL Then
        LowStmtAssign = LowStmtAssignIndex(ctx, idx)
    ElseIf leftK = AST_MEMBER Then
        LowStmtAssign = LowStmtAssignMember(ctx, idx)
    ElseIf leftK = AST_VAR Then
        LowStmtAssign = LowStmtAssignVar(ctx, idx)
    Else
        ctx->err = 1
    End If
End Function


' AST_ARG チェーン n 番目の実引数式（無ければ -1）
Function LowArgExpr(ctx As *LowerCtx, idx As Long, n As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim argn As Long
    Dim i As Long

    LowArgExpr = -1
    ast = ctx->ast
    nodes = ast->nodes
    argn = nodes[idx].left
    i = 0
    While argn >= 0 And i < n
        argn = nodes[argn].nxt
        i = i + 1
    Wend
    If argn < 0 Then Exit Function
    LowArgExpr = nodes[argn].left
End Function

' lpNewItem（第5引数）を rsp+32 へ
Function LowEmitInsMenuItem(ctx As *LowerCtx, idx As Long, nArgs As Long) As Long
    Dim list As *IrList

    LowEmitInsMenuItem = 0
    list = ctx->list
    If nArgs >= 4 Then
        If LowExpr(ctx, LowArgExpr(ctx, idx, 3)) = 0 Then Exit Function
    Else
        IrEmit(list, OP_XOR_EAX, 0, 0)
    End If
    IrEmit(list, OP_STORE_RSP_RAX, 32, 0)
    LowEmitInsMenuItem = 1
End Function

' uIDNewItem を r9、flags を r8 へ
Function LowEmitInsMenuFlags(ctx As *LowerCtx, idx As Long, nArgs As Long) As Long
    Dim list As *IrList
    Dim labSub As Long
    Dim labDone As Long

    LowEmitInsMenuFlags = 0
    list = ctx->list
    If nArgs >= 6 Then
        ' hSubMenu <> 0 なら uIDNewItem = hSubMenu かつ MF_POPUP
        labSub = LowNewLab(ctx)
        labDone = LowNewLab(ctx)
        If LowExpr(ctx, LowArgExpr(ctx, idx, 5)) = 0 Then Exit Function
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        IrEmit(list, OP_TEST_RAX, 0, 0)
        IrEmit(list, OP_JNZ, labSub, 0)
        IrEmit(list, OP_POP_RAX, 0, 0)
        If LowExpr(ctx, LowArgExpr(ctx, idx, 4)) = 0 Then Exit Function
        IrEmit(list, OP_MOV_R9_RAX, 0, 0)
        If LowExpr(ctx, LowArgExpr(ctx, idx, 2)) = 0 Then Exit Function
        IrEmit(list, OP_MOV_R8_RAX, 0, 0)
        IrEmit(list, OP_JMP, labDone, 0)
        IrEmit(list, OP_LABEL, labSub, 0)
        IrEmit(list, OP_POP_RAX, 0, 0)
        IrEmit(list, OP_MOV_R9_RAX, 0, 0)
        If LowExpr(ctx, LowArgExpr(ctx, idx, 2)) = 0 Then Exit Function
        IrEmit(list, OP_MOV_ECX, LOW_MF_POPUP, 0)
        IrEmit(list, OP_OR_EAX_ECX, 0, 0)
        IrEmit(list, OP_MOV_R8_RAX, 0, 0)
        IrEmit(list, OP_LABEL, labDone, 0)
    Else
        If nArgs >= 5 Then
            If LowExpr(ctx, LowArgExpr(ctx, idx, 4)) = 0 Then Exit Function
        Else
            IrEmit(list, OP_XOR_EAX, 0, 0)
        End If
        IrEmit(list, OP_MOV_R9_RAX, 0, 0)
        If LowExpr(ctx, LowArgExpr(ctx, idx, 2)) = 0 Then Exit Function
        If nArgs = 3 Then
            IrEmit(list, OP_MOV_ECX, LOW_MF_SEPARATOR, 0)
            IrEmit(list, OP_OR_EAX_ECX, 0, 0)
        End If
        IrEmit(list, OP_MOV_R8_RAX, 0, 0)
    End If
    LowEmitInsMenuFlags = 1
End Function

Function LowStmtInsMenu(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim list As *IrList
    Dim nArgs As Long
    Dim stk As Long
    Dim sApi(31) As Byte

    LowStmtInsMenu = 0
    list = ctx->list
    ' InsertMenuA(hMenu, pos, flags, uIDNewItem, lpNewItem)
    nArgs = LowCountCallArgs(ctx, idx, 0)
    If nArgs < 0 Then
        ctx->err = 1
        Exit Function
    End If
    If nArgs < 3 Then
        ctx->err = 1
        Exit Function
    End If
    stk = 48
    IrEmit(list, OP_SUB_RSP, stk, 0)
    If LowEmitInsMenuItem(ctx, idx, nArgs) = 0 Then Exit Function
    If LowEmitInsMenuFlags(ctx, idx, nArgs) = 0 Then Exit Function
    If LowExpr(ctx, LowArgExpr(ctx, idx, 1)) = 0 Then Exit Function
    IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
    If LowExpr(ctx, LowArgExpr(ctx, idx, 0)) = 0 Then Exit Function
    IrEmit(list, OP_MOV_RCX_RAX, 0, 0)
    lstrcpy(VarPtr(sApi), "InsertMenuA")
    IrEmitStr(list, OP_CALL_API, IR_DLL_USER32, VarPtr(sApi))
    LowEmitCallFinish(list, stk)
    LowStmtInsMenu = 1
End Function

' Print 対象が単純変数のときその宣言型、それ以外／文字列式なら -1
Function LowPrintVarTy(ctx As *LowerCtx, exprIdx As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte

    LowPrintVarTy = -1
    ast = ctx->ast
    nodes = ast->nodes
    If LowIsStringExpr(ctx, exprIdx) <> 0 Then Exit Function
    If nodes[exprIdx].kind <> AST_VAR Then Exit Function
    AstCopyStr(ast, exprIdx, VarPtr(name))
    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then Exit Function
    LowPrintVarTy = vTy
End Function

' Print 対象を rax の文字列ポインタへ
Function LowEmitPrintValue(ctx As *LowerCtx, exprIdx As Long, vTy As Long) As Long
    Dim name(63) As Byte
    Dim lab As Long
    Dim labStr As Long
    Dim exprTy As Long

    LowEmitPrintValue = 0
    exprTy = LowExprType(ctx, exprIdx)
    If vTy = TY_BYTE_ARR Then
        If LowExprArg(ctx, exprIdx) = 0 Then Exit Function
    ElseIf vTy = TY_PTR_BYTE Then
        If LowExpr(ctx, exprIdx) = 0 Then Exit Function
    ElseIf LowIsStringExpr(ctx, exprIdx) = 0 And exprTy = TY_DOUBLE And TyIs32() = 0 Then
        lstrcpy(VarPtr(name), "StrD$")
        lab = LowFindFunc(ctx, VarPtr(name))
        If lab < 0 Then
            Print "error: missing 'StrD$' (Include\default\DoubleStr.abp)"
            ctx->err = 1
            Exit Function
        End If
        If LowExpr(ctx, exprIdx) = 0 Then Exit Function
        LowEmitCall1Rax(ctx->list, 0, 0, VarPtr(name), lab)
    ElseIf LowIsStringExpr(ctx, exprIdx) = 0 Then
        labStr = LowEnsureRtStr(ctx)
        If LowExpr(ctx, exprIdx) = 0 Then Exit Function
        LowEmitCall1Rax(ctx->list, 0, 0, VarPtr(name), labStr)
    Else
        If LowExpr(ctx, exprIdx) = 0 Then Exit Function
    End If
    LowEmitPrintValue = 1
End Function

' rax の文字列を出力（N88 モードは N88_Print へ）
Function LowEmitPrintCall(ctx As *LowerCtx, stay As Long) As Long
    Dim name(63) As Byte
    Dim lab As Long

    LowEmitPrintCall = 0
    If PpIsN88Basic() <> 0 Then
        lstrcpy(VarPtr(name), "N88_Print")
        If stay <> 0 Then
            lstrcpy(VarPtr(name), "N88_PrintStay")
        End If
        lab = LowFindFunc(ctx, VarPtr(name))
        If lab < 0 Then
            Print "error: missing '" + MakeStr(VarPtr(name)) + "'"
            ctx->err = 1
            Exit Function
        End If
        IrEmit(ctx->list, OP_SUB_RSP, LowCallStk(1), 0)
        IrEmit(ctx->list, OP_STORE_RSP_RAX, 0, 0)
        LowEmitLoadRegArgs(ctx->list, 1)
        IrEmit(ctx->list, OP_CALL_LAB, lab, 0)
        LowEmitCallFinish(ctx->list, LowCallStk(1))
    Else
        lab = LowEnsureRtPrint(ctx)
        LowEmitCall1Rax(ctx->list, 0, 0, VarPtr(name), lab)
    End If
    LowEmitPrintCall = 1
End Function

Function LowStmtPrintOneConsole(ctx As *LowerCtx, exprIdx As Long, stay As Long) As Long
    Dim stackPad(2047) As Byte
    Dim vTy As Long

    LowStmtPrintOneConsole = 0
    If exprIdx < 0 Then
        LowStmtPrintOneConsole = 1
        Exit Function
    End If
    vTy = LowPrintVarTy(ctx, exprIdx)
    If LowEmitPrintValue(ctx, exprIdx, vTy) = 0 Then Exit Function
    If LowEmitPrintCall(ctx, stay) = 0 Then Exit Function
    LowStmtPrintOneConsole = 1
End Function

Function LowStmtPrint(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim cur As Long
    Dim fileIdx As Long

    LowStmtPrint = 0
    ast = ctx->ast
    nodes = ast->nodes
    fileIdx = nodes[idx].left
    If fileIdx >= 0 Then
        LowStmtPrint = LowStmtPrintFile(ctx, idx, fileIdx)
        Exit Function
    End If
    cur = nodes[idx].right
    If cur < 0 Then
        LowStmtPrint = 1
        Exit Function
    End If
    If LowStmtPrintOneConsole(ctx, nodes[cur].left, nodes[idx].num) = 0 Then Exit Function
    LowEmitStrCollectSafepoint(ctx)
    LowStmtPrint = 1
End Function

' Print #n, ... — BaFileWrite* 経由
Function LowStmtPrintFile(ctx As *LowerCtx, idx As Long, fileIdx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim labItem As Long
    Dim labSp As Long
    Dim labNl As Long
    Dim list As *IrList
    Dim cur As Long
    Dim first As Long

    LowStmtPrintFile = 0
    ast = ctx->ast
    nodes = ast->nodes
    list = ctx->list
    lstrcpy(VarPtr(name), "BaFileWriteItem")
    labItem = LowFindFunc(ctx, VarPtr(name))
    lstrcpy(VarPtr(name), "BaFileWriteComma")
    labSp = LowFindFunc(ctx, VarPtr(name))
    lstrcpy(VarPtr(name), "BaFileWriteNl")
    labNl = LowFindFunc(ctx, VarPtr(name))
    If labItem < 0 Or labSp < 0 Or labNl < 0 Then
        Print "error: missing BaFileWrite*"
        ctx->err = 1
        Exit Function
    End If
    first = 1
    cur = nodes[idx].right
    While cur >= 0
        If first = 0 Then
            If LowExpr(ctx, fileIdx) = 0 Then Exit Function
            LowEmitCall1Rax(list, 0, 0, 0, labSp)
        End If
        first = 0
        If LowEmitToStringRax(ctx, nodes[cur].left) = 0 Then Exit Function
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        If LowExpr(ctx, fileIdx) = 0 Then Exit Function
        IrEmit(list, OP_MOV_RCX_RAX, 0, 0)
        IrEmit(list, OP_POP_RAX, 0, 0)
        IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
        LowEmitCallLab2(list, labItem)
        cur = nodes[cur].nxt
    Wend
    If nodes[idx].num = 0 Then
        If LowExpr(ctx, fileIdx) = 0 Then Exit Function
        LowEmitCall1Rax(list, 0, 0, 0, labNl)
    End If
    LowEmitStrCollectSafepoint(ctx)
    LowStmtPrintFile = 1
End Function

' Input の変数ノード。省略可のプロンプト式は promptOut へ
Function LowInputVarIdx(ctx As *LowerCtx, idx As Long, ByRef promptOut As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim nVarIdx As Long

    ast = ctx->ast
    nodes = ast->nodes
    promptOut = -1
    nVarIdx = nodes[idx].left
    If nodes[idx].right >= 0 Then
        If nodes[nodes[idx].right].kind = AST_VAR Then
            promptOut = nodes[idx].left
            nVarIdx = nodes[idx].right
        End If
    End If
    LowInputVarIdx = nVarIdx
End Function

' 読み取った文字列（rax）を必要なら数値へ
Sub LowEmitInputCvt(ctx As *LowerCtx, vTy As Long)
    Dim lab As Long

    If vTy = TY_STRING Then Exit Sub
    If vTy = TY_SINGLE Or vTy = TY_DOUBLE Then
        lab = LowEnsureRtValDouble(ctx)
    Else
        lab = LowEnsureRtVal(ctx)
    End If
    LowEmitCall1Rax(ctx->list, 0, 0, 0, lab)
    If vTy = TY_SINGLE Then
        IrEmit(ctx->list, OP_CVT_SD_TO_SS, 0, 0)
    End If
End Sub

' rax を Input 先の変数へ格納
Sub LowStoreInputVar(ctx As *LowerCtx, vOff As Long, vTy As Long, vByRef As Long, vGlob As Long)
    If vByRef <> 0 Then
        IrEmit(ctx->list, OP_PUSH_RAX, 0, 0)
        LowEmitLoadOff(ctx->list, vOff, vGlob)
        IrEmit(ctx->list, OP_POP_RCX, 0, 0)
        IrEmit(ctx->list, OP_STORE_QWORD_RAX_RCX, 0, 0)
    ElseIf vTy = TY_STRING Then
        LowEmitStoreString(ctx, vOff, vGlob)
    Else
        LowEmitStoreOff(ctx->list, vOff, vGlob)
    End If
End Sub

Function LowStmtInput(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim lab As Long
    Dim nVarIdx As Long
    Dim nPrompt As Long

    LowStmtInput = 0
    ast = ctx->ast
    nodes = ast->nodes
    nVarIdx = LowInputVarIdx(ctx, idx, nPrompt)
    If nVarIdx < 0 Then
        ctx->err = 1
        Exit Function
    End If
    If nodes[nVarIdx].kind <> AST_VAR Then
        ctx->err = 1
        Exit Function
    End If
    If nPrompt >= 0 Then
        If LowExpr(ctx, nPrompt) = 0 Then Exit Function
        lab = LowEnsureRtPrint(ctx)
        LowEmitCall1Rax(ctx->list, 0, 0, VarPtr(name), lab)
        LowEmitStrCollectSafepoint(ctx)
    End If
    AstCopyStr(ast, nVarIdx, VarPtr(name))
    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
        ctx->err = 1
        Exit Function
    End If
    If vTy <> TY_STRING And vTy <> TY_LONG And vTy <> TY_BYTE And vTy <> TY_DOUBLE And vTy <> TY_SINGLE Then
        Print "error: Input needs String or numeric variable"
        ctx->err = 1
        Exit Function
    End If
    lab = LowEnsureRtInput(ctx)
    IrEmit(ctx->list, OP_CALL_LAB, lab, 0)
    LowEmitInputCvt(ctx, vTy)
    LowStoreInputVar(ctx, vOff, vTy, vByRef, vGlob)
    LowEmitStrCollectSafepoint(ctx)
    LowStmtInput = 1
End Function

Function LowStmtOpen(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim lab As Long
    Dim mode As Long
    Dim list As *IrList

    LowStmtOpen = 0
    ast = ctx->ast
    nodes = ast->nodes
    list = ctx->list
    mode = nodes[idx].num
    lstrcpy(VarPtr(name), "BaFileOpen")
    lab = LowFindFunc(ctx, VarPtr(name))
    If lab < 0 Then
        Print "error: missing 'BaFileOpen' (Include\default\BasicFile.abp)"
        ctx->err = 1
        Exit Function
    End If
    If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, mode, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
    If TyIs32() <> 0 Then
        IrEmit(list, OP_POP_RDX, 0, 0)
        IrEmit(list, OP_POP_RCX, 0, 0)
    Else
        IrEmit(list, OP_MOV_R8_RAX, 0, 0)
        IrEmit(list, OP_POP_RAX, 0, 0)
        IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
        IrEmit(list, OP_POP_RCX, 0, 0)
    End If
    LowEmitCallLab3(list, lab)
    LowEmitStrCollectSafepoint(ctx)
    LowStmtOpen = 1
End Function

Function LowStmtClose(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim lab As Long
    Dim list As *IrList

    LowStmtClose = 0
    ast = ctx->ast
    nodes = ast->nodes
    list = ctx->list
    lstrcpy(VarPtr(name), "BaFileClose")
    lab = LowFindFunc(ctx, VarPtr(name))
    If lab < 0 Then
        Print "error: missing 'BaFileClose' (Include\default\BasicFile.abp)"
        ctx->err = 1
        Exit Function
    End If
    If nodes[idx].left < 0 Then
        IrEmit(list, OP_MOV_EAX_IMM, 0, 0)
    Else
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
    End If
    LowEmitCall1Rax(list, 0, 0, VarPtr(name), lab)
    LowEmitStrCollectSafepoint(ctx)
    LowStmtClose = 1
End Function

Function LowStmtFInputOne(ctx As *LowerCtx, varIdx As Long, labIn As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim list As *IrList

    LowStmtFInputOne = 0
    ast = ctx->ast
    nodes = ast->nodes
    list = ctx->list
    If nodes[varIdx].kind <> AST_VAR Then
        ctx->err = 1
        Exit Function
    End If
    AstCopyStr(ast, varIdx, VarPtr(name))
    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
        ctx->err = 1
        Exit Function
    End If
    If vTy <> TY_STRING And vTy <> TY_LONG And vTy <> TY_BYTE And vTy <> TY_DOUBLE And vTy <> TY_SINGLE Then
        Print "error: Input # needs String or numeric variable"
        ctx->err = 1
        Exit Function
    End If
    ' rax = file number（呼び出し側が再設定）
    LowEmitCall1Rax(list, 0, 0, 0, labIn)
    LowEmitInputCvt(ctx, vTy)
    LowStoreInputVar(ctx, vOff, vTy, vByRef, vGlob)
    LowStmtFInputOne = 1
End Function

Function LowStmtFInput(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim lab As Long
    Dim list As *IrList
    Dim cur As Long

    LowStmtFInput = 0
    ast = ctx->ast
    nodes = ast->nodes
    list = ctx->list
    lstrcpy(VarPtr(name), "BaFileInput$")
    lab = LowFindFunc(ctx, VarPtr(name))
    If lab < 0 Then
        Print "error: missing 'BaFileInput$' (Include\default\BasicFile.abp)"
        ctx->err = 1
        Exit Function
    End If
    If nodes[idx].left < 0 Then
        ctx->err = 1
        Exit Function
    End If
    cur = nodes[idx].right
    While cur >= 0
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        If LowStmtFInputOne(ctx, cur, lab) = 0 Then Exit Function
        cur = nodes[cur].nxt
    Wend
    LowEmitStrCollectSafepoint(ctx)
    LowStmtFInput = 1
End Function

