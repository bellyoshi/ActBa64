' ===================================================
'  AstLowerStmt - jumps / Dim / Assign / Print / File IO
' ===================================================

Function LowJumpIfFalse(ctx As *LowerCtx, idx As Long, lab As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim op As Long
    Dim jcc As Long
    Dim labSkip As Long

    LowJumpIfFalse = 0
    ast = ctx->ast
    nodes = ast->nodes
    If nodes[idx].kind = AST_UNARY Then
        If nodes[idx].num = UOP_NOT Then
            If LowJumpIfTrue(ctx, nodes[idx].left, lab) = 0 Then Exit Function
            LowJumpIfFalse = 1
            Exit Function
        End If
    End If
    If nodes[idx].kind <> AST_BINOP Then
        If LowExpr(ctx, idx) = 0 Then Exit Function
        IrEmit(ctx->list, OP_TEST_EAX, 0, 0)
        IrEmit(ctx->list, OP_JZ, lab, 0)
        LowJumpIfFalse = 1
        Exit Function
    End If
    op = nodes[idx].num
    If op = BOP_AND Then
        If LowJumpIfFalse(ctx, nodes[idx].left, lab) = 0 Then Exit Function
        If LowJumpIfFalse(ctx, nodes[idx].right, lab) = 0 Then Exit Function
        LowJumpIfFalse = 1
    ElseIf op = BOP_OR Then
        labSkip = LowNewLab(ctx)
        If LowJumpIfTrue(ctx, nodes[idx].left, labSkip) = 0 Then Exit Function
        If LowJumpIfFalse(ctx, nodes[idx].right, lab) = 0 Then Exit Function
        IrEmit(ctx->list, OP_LABEL, labSkip, 0)
        LowJumpIfFalse = 1
    ElseIf op = BOP_EQ Or op = BOP_NE Or op = BOP_LT Or op = BOP_LE Or op = BOP_GT Or op = BOP_GE Then
        jcc = LowCmpFalseJcc(ctx, idx)
        If jcc = 0 Then Exit Function
        IrEmit(ctx->list, jcc, lab, 0)
        LowJumpIfFalse = 1
    Else
        If LowExpr(ctx, idx) = 0 Then Exit Function
        IrEmit(ctx->list, OP_TEST_EAX, 0, 0)
        IrEmit(ctx->list, OP_JZ, lab, 0)
        LowJumpIfFalse = 1
    End If
End Function

' 比較 BINOP が真のとき lab へ飛ぶ
Function LowJumpCmpTrue(ctx As *LowerCtx, idx As Long, lab As Long) As Long
    Dim jcc As Long
    Dim jTrue As Long

    LowJumpCmpTrue = 0
    jcc = LowCmpFalseJcc(ctx, idx)
    If jcc = 0 Then Exit Function
    jTrue = LowCmpTrueJcc(jcc)
    If jTrue = 0 Then
        ctx->err = 1
        Exit Function
    End If
    IrEmit(ctx->list, jTrue, lab, 0)
    LowJumpCmpTrue = 1
End Function

Function LowJumpIfTrue(ctx As *LowerCtx, idx As Long, lab As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim op As Long
    Dim labSkip As Long

    LowJumpIfTrue = 0
    ast = ctx->ast
    nodes = ast->nodes
    If nodes[idx].kind = AST_UNARY Then
        If nodes[idx].num = UOP_NOT Then
            If LowJumpIfFalse(ctx, nodes[idx].left, lab) = 0 Then Exit Function
            LowJumpIfTrue = 1
            Exit Function
        End If
    End If
    If nodes[idx].kind <> AST_BINOP Then
        If LowExpr(ctx, idx) = 0 Then Exit Function
        IrEmit(ctx->list, OP_TEST_EAX, 0, 0)
        IrEmit(ctx->list, OP_JNZ, lab, 0)
        LowJumpIfTrue = 1
        Exit Function
    End If
    op = nodes[idx].num
    If op = BOP_OR Then
        If LowJumpIfTrue(ctx, nodes[idx].left, lab) = 0 Then Exit Function
        If LowJumpIfTrue(ctx, nodes[idx].right, lab) = 0 Then Exit Function
        LowJumpIfTrue = 1
    ElseIf op = BOP_AND Then
        labSkip = LowNewLab(ctx)
        If LowJumpIfFalse(ctx, nodes[idx].left, labSkip) = 0 Then Exit Function
        If LowJumpIfTrue(ctx, nodes[idx].right, lab) = 0 Then Exit Function
        IrEmit(ctx->list, OP_LABEL, labSkip, 0)
        LowJumpIfTrue = 1
    ElseIf op = BOP_EQ Or op = BOP_NE Or op = BOP_LT Or op = BOP_LE Or op = BOP_GT Or op = BOP_GE Then
        If LowJumpCmpTrue(ctx, idx, lab) = 0 Then Exit Function
        LowJumpIfTrue = 1
    Else
        If LowExpr(ctx, idx) = 0 Then Exit Function
        IrEmit(ctx->list, OP_TEST_EAX, 0, 0)
        IrEmit(ctx->list, OP_JNZ, lab, 0)
        LowJumpIfTrue = 1
    End If
End Function

' If を別関数に分離（LowStmt 巨大フレームの入れ子によるスタック破壊を避ける）
Function LowStmtIf(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim labElse As Long
    Dim labEnd As Long
    Dim thenList As Long
    Dim elseList As Long
    Dim r As Long

    LowStmtIf = 0
    ast = ctx->ast
    nodes = ast->nodes
    thenList = nodes[idx].right
    elseList = nodes[idx].extra
    labElse = LowNewLab(ctx)
    labEnd = LowNewLab(ctx)
    r = LowJumpIfFalse(ctx, nodes[idx].left, labElse)
    If r = 0 Then Exit Function
    r = LowStmtList(ctx, thenList)
    If r = 0 Then Exit Function
    IrEmit(ctx->list, OP_JMP, labEnd, 0)
    IrEmit(ctx->list, OP_LABEL, labElse, 0)
    r = LowStmtList(ctx, elseList)
    If r = 0 Then Exit Function
    IrEmit(ctx->list, OP_LABEL, labEnd, 0)
    LowStmtIf = 1
End Function

Function LowStmt(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim k As Long

    ' 薄いディスパッチ: 巨大フレームの LowStmtHeavy を入れ子にしない
    LowStmt = 0
    If idx < 0 Then
        LowStmt = 1
        Exit Function
    End If
    ast = ctx->ast
    nodes = ast->nodes
    k = nodes[idx].kind
    If k = AST_IF Then
        LowStmt = LowStmtIf(ctx, idx)
        Exit Function
    End If
    If k = AST_CALL Then
        LowStmt = LowExpr(ctx, idx)
        Exit Function
    End If
    If k = AST_EXITFUNC Then
        If g_funcEndLab < 0 Then
            ctx->err = 1
            Exit Function
        End If
        IrEmit(ctx->list, OP_JMP, g_funcEndLab, 0)
        LowStmt = 1
        Exit Function
    End If
    LowStmt = LowStmtHeavy(ctx, idx)
End Function

' クラス ti の Ctor ラベルを引く（マングル名を dst へ）
Function LowFindCtorLab(ctx As *LowerCtx, tt As *TypeTable, ti As Long, dst As *Byte) As Long
    Dim j As Long
    Dim kCtor(7) As Byte
    Dim names As *Byte

    j = ti * 48
    lstrcpy(VarPtr(kCtor), "Ctor")
    names = tt->typeNames
    LowMangleClass(VarPtr(names[j]), VarPtr(kCtor), dst)
    LowFindCtorLab = LowFindFunc(ctx, dst)
End Function

' this を含む Ctor 引数の個数。AST_ARG 以外が先頭なら -1
Function LowCtorArgCount(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim argn As Long
    Dim nArgs As Long

    ast = ctx->ast
    nodes = ast->nodes
    nArgs = 1
    argn = nodes[idx].right
    While argn >= 0
        If nodes[argn].kind <> AST_ARG Then Exit While
        nArgs = nArgs + 1
        argn = nodes[argn].nxt
    Wend
    If nodes[idx].right >= 0 Then
        If nodes[nodes[idx].right].kind <> AST_ARG Then
            nArgs = -1
        End If
    End If
    LowCtorArgCount = nArgs
End Function

' Ctor のユーザー引数を rsp+8.. のホーム領域へ
Function LowEmitCtorArgs(ctx As *LowerCtx, idx As Long, nArgs As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim argi As Long
    Dim argn As Long

    LowEmitCtorArgs = 0
    ast = ctx->ast
    nodes = ast->nodes
    argi = 1
    argn = nodes[idx].right
    While argi < nArgs
        If LowExprArg(ctx, nodes[argn].left) = 0 Then Exit Function
        IrEmit(ctx->list, OP_STORE_RSP_RAX, argi * TyPtrSize(), 0)
        argi = argi + 1
        argn = nodes[argn].nxt
    Wend
    LowEmitCtorArgs = 1
End Function

' this をホーム領域へ置いて Ctor を呼ぶ
Function LowEmitCtorCall(ctx As *LowerCtx, idx As Long, lab As Long, nArgs As Long, stk As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim ast As *Ast
    Dim fname(63) As Byte

    LowEmitCtorCall = 0
    ast = ctx->ast
    AstCopyStr(ast, idx, VarPtr(fname))
    If LowLookupVar(ctx, VarPtr(fname), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
        ctx->err = 1
        Exit Function
    End If
    LowEmitLeaOff(ctx->list, vOff, vGlob)
    IrEmit(ctx->list, OP_STORE_RSP_RAX, 0, 0)
    LowEmitLoadRegArgs(ctx->list, nArgs)
    IrEmit(ctx->list, OP_CALL_LAB, lab, 0)
    LowEmitCallFinish(ctx->list, stk)
    LowEmitCtorCall = 1
End Function

Function LowStmtDimCtor(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim lab As Long
    Dim tt As *TypeTable
    Dim ti As Long
    Dim nArgs As Long
    Dim stk As Long

    LowStmtDimCtor = 0
    ast = ctx->ast
    nodes = ast->nodes
    tt = ast->types
    AstCopyStr(ast, idx, VarPtr(name))
    If nodes[idx].num <> TY_UDT Then
        Exit Function
    End If
    ti = nodes[idx].extra
    If ti < 0 Then Exit Function
    If TyIsClass(tt, ti) = 0 Then Exit Function
    lab = LowFindCtorLab(ctx, tt, ti, VarPtr(name))
    If lab < 0 Then
        Print "error: missing ctor '" + MakeStr(VarPtr(name)) + "'"
        ctx->err = 1
        Exit Function
    End If
    nArgs = LowCtorArgCount(ctx, idx)
    If nArgs <= 0 Then Exit Function
    stk = LowCallStk(nArgs)
    If stk > 0 Then
        IrEmit(ctx->list, OP_SUB_RSP, stk, 0)
    End If
    If LowEmitCtorArgs(ctx, idx, nArgs) = 0 Then Exit Function
    If LowEmitCtorCall(ctx, idx, lab, nArgs, stk) = 0 Then Exit Function
    LowStmtDimCtor = 1
End Function

Function LowStmtDim(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte

    LowStmtDim = 0
    ast = ctx->ast
    nodes = ast->nodes
    If LowStmtDimCtor(ctx, idx) <> 0 Then
        LowStmtDim = 1
        Exit Function
    End If
    If ctx->err <> 0 Then Exit Function
    If nodes[idx].right >= 0 Then
        If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
        AstCopyStr(ast, idx, VarPtr(name))
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
            ctx->err = 1
            Exit Function
        End If
        If vTy = TY_SINGLE Then
            LowEmitCvtToSingleIfNeeded(ctx, nodes[idx].right)
        ElseIf vTy = TY_DOUBLE Then
            LowEmitCvtToDoubleIfNeeded(ctx, nodes[idx].right)
        Else
            LowEmitCvtToLongIfNeeded(ctx, nodes[idx].right, vTy)
        End If
        LowEmitStoreOff(ctx->list, vOff, vGlob)
    End If
    LowStmtDim = 1
End Function
