#console
#include "ByteCharUtils.abp"
#include "ByteStringUtils.abp"
#include "Utils.abp"
Sub Main()
    Dim outName[MAX_PATH] As Byte
    Dim srcName[MAX_PATH] As Byte
    Dim arg[MAX_PATH] As Byte
    Dim n As Long
    Dim i As Long
    Dim haveOut As Long
    Dim haveSrc As Long
    haveOut = 0
    haveSrc = 0
    i = 1
    While GetCmd(i, arg) <> 0
        If arg[0] = 45 Then
            If GetCmd(i + 1, outName) = 0 Then ExitProcess(8)
            haveOut = 1
            i = i + 2
        Else
            If haveSrc <> 0 Then ExitProcess(9)
            lstrcpy(VarPtr(srcName), arg)
            haveSrc = 1
            i = i + 1
        End If
        If i > 30 Then ExitProcess(99)
    Wend
    If haveSrc = 0 Or haveOut = 0 Then ExitProcess(7)
    If srcName[0] = 0 Then ExitProcess(6)
    ExitProcess(1)
End Sub
Main()
End
