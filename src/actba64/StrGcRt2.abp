' --- split from StrGcRt.abp (part 2) ---
Sub LowEmitRtStrCollectPrec(list As *IrList, labPrec As Long, labPrecDone As Long, labPrecise As Long)
    Dim gcPrecCnt As Long
    Dim gcPrecRoots As Long

    gcPrecCnt = g_gcBaseOff + GC_HDR_PRECISE_COUNT
    gcPrecRoots = g_gcBaseOff + GC_HDR_PRECISE_ROOTS
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -16, 0)
    IrEmit(list, OP_LABEL, labPrec, 0)
    IrEmit(list, OP_LEA_RAX_GLOB, gcPrecCnt, 0)
        IrEmit(list, OP_LOAD_PTR, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JGE, labPrecDone, 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_MOV_ECX_EAX, 0, 0)
    IrEmit(list, OP_ADD_EAX_ECX, 0, 0)
    IrEmit(list, OP_ADD_EAX_ECX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LEA_RAX_GLOB, gcPrecRoots, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
    IrEmit(list, OP_LOAD_DWORD_RAX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LEA_RAX_GLOB, 0, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
        IrEmit(list, OP_LOAD_PTR, 0, 0)
    LowEmitCall1Rax(list, 0, 0, 0, labPrecise)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -16, 0)
    IrEmit(list, OP_JMP, labPrec, 0)
    IrEmit(list, OP_LABEL, labPrecDone, 0)
End Sub

' グローバル領域全体を conservative に走査
Sub LowEmitRtStrCollectGlob(list As *IrList, labGlob As Long, labGlobDone As Long, labCons As Long)
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -24, 0)
    IrEmit(list, OP_LABEL, labGlob, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, g_gcBaseOff, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JGE, labGlobDone, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LEA_RAX_GLOB, 0, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
        IrEmit(list, OP_LOAD_PTR, 0, 0)
    LowEmitCall1Rax(list, 0, 0, 0, labCons)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_ADD_RAX_IMM, TyPtrSize(), 0)
    IrEmit(list, OP_STORE_LOCAL, -24, 0)
    IrEmit(list, OP_JMP, labGlob, 0)
    IrEmit(list, OP_LABEL, labGlobDone, 0)
End Sub

Sub LowEmitRtStrCollectBody(ctx As *LowerCtx)
    Dim list As *IrList
    Dim labClr As Long
    Dim labClrDone As Long
    Dim labPrec As Long
    Dim labPrecDone As Long
    Dim labGlob As Long
    Dim labGlobDone As Long
    Dim labStk As Long
    Dim labStkDone As Long
    Dim labSweep As Long
    Dim labSweepDone As Long
    Dim labSweepNext As Long
    Dim gcCount As Long
    Dim gcBlocks As Long
    Dim gcMarks As Long

    If g_rtStrCollectLab < 0 Then Exit Sub
    gcCount = g_gcBaseOff + GC_HDR_COUNT
    gcBlocks = g_gcBaseOff + GC_HDR_BLOCKS
    gcMarks = g_gcBaseOff + GC_HDR_MARKS
    list = ctx->list
    labClr = LowNewLab(ctx)
    labClrDone = LowNewLab(ctx)
    labPrec = LowNewLab(ctx)
    labPrecDone = LowNewLab(ctx)
    labGlob = LowNewLab(ctx)
    labGlobDone = LowNewLab(ctx)
    labStk = LowNewLab(ctx)
    labStkDone = LowNewLab(ctx)
    labSweep = LowNewLab(ctx)
    labSweepDone = LowNewLab(ctx)
    labSweepNext = LowNewLab(ctx)

    IrEmit(list, OP_LABEL, g_rtStrCollectLab, 0)
    IrEmit(list, OP_ENTER, 128, 0)
    LowEmitRtStrCollectPrec(list, labPrec, labPrecDone, g_rtStrGcPreciseLab)
    LowEmitRtStrCollectGlob(list, labGlob, labGlobDone, g_rtStrGcConsLab)
    LowEmitRtStrCollectStk(ctx, labStk, labStkDone, g_rtStrGcConsLab, labSweep, labSweepDone, labSweepNext, labClr, labClrDone, gcCount, gcBlocks, gcMarks)
End Sub

Sub LowEmitRtStrCollectStk(ctx As *LowerCtx, labStk As Long, labStkDone As Long, labCons As Long, labSweep As Long, labSweepDone As Long, labSweepNext As Long, labClr As Long, labClrDone As Long, gcCount As Long, gcBlocks As Long, gcMarks As Long)
    Dim list As *IrList
    list = ctx->list
    IrEmit(list, OP_MOV_R8_RSP, 0, 0)
    IrEmit(list, OP_MOV_RAX_R8, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -32, 0)
    IrEmit(list, OP_LABEL, labStk, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_RAX_GS8, 0, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_RCX_RAX, 0, 0)
    IrEmit(list, OP_JAE, labStkDone, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
        IrEmit(list, OP_LOAD_PTR, 0, 0)
    LowEmitCall1Rax(list, 0, 0, 0, labCons)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_ADD_RAX_IMM, TyPtrSize(), 0)
    IrEmit(list, OP_STORE_LOCAL, -32, 0)
    IrEmit(list, OP_JMP, labStk, 0)
    IrEmit(list, OP_LABEL, labStkDone, 0)

    IrEmit(list, OP_LEA_RAX_GLOB, gcCount, 0)
        IrEmit(list, OP_LOAD_PTR, 0, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -1, 0)
    IrEmit(list, OP_STORE_LOCAL, -40, 0)
    LowEmitRtStrCollectSweep(ctx, labSweep, labSweepDone, labSweepNext, labClr, labClrDone, gcCount, gcBlocks, gcMarks)
End Sub
