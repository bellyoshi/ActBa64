' --- split from AstLowerExpr.abp (part 3) ---
Function LowExprBuiltinCore(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim list As *IrList
    Dim lab As Long
    Dim n As Long

    LowExprBuiltinCore = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    n = nodes[idx].num

    If n = BI_SIZEOF Then
        LowExprBuiltinCore = LowExprBuiltinSizeof(ctx, idx)
    ElseIf n = BI_VARPTR Then
        If LowAddr(ctx, nodes[idx].left) = 0 Then Exit Function
        LowExprBuiltinCore = 1
    ElseIf n = BI_ADDRESSOF Then
        AstCopyStr(ast, idx, VarPtr(name))
        lab = LowFindFunc(ctx, VarPtr(name))
        If lab < 0 Then
            Print "error: AddressOf unknown function '" + MakeStr(VarPtr(name)) + "'"
            ctx->err = 1
            Exit Function
        End If
        IrEmit(list, OP_LEA_RAX_LAB, lab, 0)
        LowExprBuiltinCore = 1
    ElseIf n = BI_MALLOC Then
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        LowEmitHeapAllocRax(list, 0)
        LowExprBuiltinCore = 1
    ElseIf n = BI_FREE Then
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        LowEmitHeapFreeRax(list)
        LowExprBuiltinCore = 1
    ElseIf n = BI_LEN Then
        LowExprBuiltinCore = LowExprBuiltinLen(ctx, idx)
    Else
        LowExprBuiltinCore = LowExprBuiltinCore2(ctx, idx)
    End If
End Function

' stack: s, n → rax = Len(s)（s, n はスタックに残す）
Sub LowEmitRightLen(list As *IrList, labA As Long, labB As Long)
    ' stack: s, n  →  rax = s, rcx = n
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_POP_RAX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
    ' rax = s (stack: s, n) → rax = Len(s)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JZ, labA, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -4, 0)
    IrEmit(list, OP_LOAD_DWORD_RAX, 0, 0)
    IrEmit(list, OP_AND_EAX_IMM, 2147483647, 0)
    IrEmit(list, OP_JMP, labB, 0)
    IrEmit(list, OP_LABEL, labA, 0)
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_LABEL, labB, 0)
End Sub

Sub LowEmitRightStart(list As *IrList, labZ As Long)
    ' start = len - n + 1（n はスタックへ戻す）
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
    IrEmit(list, OP_SUB_EAX_ECX, 0, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    ' if start < 1 then start = 1
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 1, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JL, labZ, 0)
    IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
    IrEmit(list, OP_LABEL, labZ, 0)
End Sub

Function LowExprBuiltinRight(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList
    Dim lab As Long
    Dim labZ As Long
    Dim labA As Long
    Dim labB As Long

    LowExprBuiltinRight = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    ' Right$(s, n) => Mid$(s, len - n + 1, n)
    If nodes[idx].right < 0 Then
        ctx->err = 1
        Exit Function
    End If
    lab = LowEnsureRtMid(ctx)
    labA = LowNewLab(ctx)
    labB = LowNewLab(ctx)
    labZ = LowNewLab(ctx)
    If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    LowEmitRightLen(list, labA, labB)
    LowEmitRightStart(list, labZ)
    IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
    IrEmit(list, OP_POP_RAX, 0, 0)
    If TyIs32() <> 0 Then
        IrEmit(list, OP_POP_RCX, 0, 0)
    Else
        IrEmit(list, OP_MOV_R8_RAX, 0, 0)
        IrEmit(list, OP_POP_RCX, 0, 0)
    End If
    LowEmitCallLab3(list, lab)
    LowExprBuiltinRight = 1
End Function

Function LowExprBuiltinLeft(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList
    Dim lab As Long

    LowExprBuiltinLeft = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    lab = LowEnsureRtMid(ctx)
    If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
    If TyIs32() <> 0 Then
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        IrEmit(list, OP_MOV_EAX_IMM, 1, 0)
        IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
        IrEmit(list, OP_POP_RAX, 0, 0)
        IrEmit(list, OP_POP_RCX, 0, 0)
    Else
        IrEmit(list, OP_MOV_R8_RAX, 0, 0)
        IrEmit(list, OP_MOV_EAX_IMM, 1, 0)
        IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
        IrEmit(list, OP_POP_RCX, 0, 0)
    End If
    LowEmitCallLab3(list, lab)
    LowExprBuiltinLeft = 1
End Function

Function LowExprBuiltinMid(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList
    Dim lab As Long

    LowExprBuiltinMid = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    lab = LowEnsureRtMid(ctx)
    If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    If nodes[idx].extra >= 0 Then
        If LowExpr(ctx, nodes[idx].extra) = 0 Then Exit Function
    Else
        IrEmit(list, OP_MOV_EAX_IMM, -1, 0)
    End If
    If TyIs32() <> 0 Then
        IrEmit(list, OP_POP_RDX, 0, 0)
        IrEmit(list, OP_POP_RCX, 0, 0)
    Else
        IrEmit(list, OP_MOV_R8_RAX, 0, 0)
        IrEmit(list, OP_POP_RAX, 0, 0)
        IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
        IrEmit(list, OP_POP_RCX, 0, 0)
    End If
    LowEmitCallLab3(list, lab)
    LowExprBuiltinMid = 1
End Function

Function LowExprBuiltinChr(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList

    LowExprBuiltinChr = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 6, 0)
    IrEmit(list, OP_MOV_RCX_RAX, 0, 0)
    LowEmitCallStrHeapAlloc(ctx)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_ECX, &H80000001, 0)
    IrEmit(list, OP_STORE_DWORD_RAX_ECX, 0, 0)
    IrEmit(list, OP_POP_RAX, 0, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 4, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_STORE_BYTE_RAX_CL, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    IrEmit(list, OP_MOV_ECX, 0, 0)
    IrEmit(list, OP_STORE_BYTE_RAX_CL, 0, 0)
    IrEmit(list, OP_POP_RAX, 0, 0)
    LowExprBuiltinChr = 1
End Function

Function LowExprBuiltinRgb(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList

    LowExprBuiltinRgb = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    If nodes[idx].right < 0 Or nodes[idx].extra < 0 Then
        ctx->err = 1
        Exit Function
    End If
    If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
    IrEmit(list, OP_MOV_ECX, 256, 0)
    IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_OR_EAX_ECX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    If LowExpr(ctx, nodes[idx].extra) = 0 Then Exit Function
    IrEmit(list, OP_MOV_ECX, 65536, 0)
    IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_OR_EAX_ECX, 0, 0)
    LowExprBuiltinRgb = 1
End Function

Function LowExprBuiltinMakeLong(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList

    LowExprBuiltinMakeLong = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    If nodes[idx].right < 0 Then
        ctx->err = 1
        Exit Function
    End If
    If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
    IrEmit(list, OP_MOV_ECX, 16, 0)
    IrEmit(list, OP_SHL_EAX_CL, 0, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_OR_EAX_ECX, 0, 0)
    LowExprBuiltinMakeLong = 1
End Function

Function LowExprBuiltinMakeWord(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList

    LowExprBuiltinMakeWord = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    If nodes[idx].right < 0 Then
        ctx->err = 1
        Exit Function
    End If
    If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
    IrEmit(list, OP_MOV_ECX, 255, 0)
    IrEmit(list, OP_AND_EAX_ECX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
    IrEmit(list, OP_MOV_ECX, 255, 0)
    IrEmit(list, OP_AND_EAX_ECX, 0, 0)
    IrEmit(list, OP_MOV_ECX, 8, 0)
    IrEmit(list, OP_SHL_EAX_CL, 0, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_OR_EAX_ECX, 0, 0)
    LowExprBuiltinMakeWord = 1
End Function

' LoWord / LoByte / HiByte / HiWord / Elm。未対応なら -1
Function LowExprBuiltinMask(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList
    Dim n As Long

    LowExprBuiltinMask = -1
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    n = nodes[idx].num
    If n <> BI_LOWORD And n <> BI_LOBYTE And n <> BI_HIBYTE And n <> BI_HIWORD And n <> BI_ELM Then Exit Function
    LowExprBuiltinMask = 0
    If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
    If n = BI_LOWORD Then
        IrEmit(list, OP_MOV_ECX, 65535, 0)
        IrEmit(list, OP_AND_EAX_ECX, 0, 0)
    ElseIf n = BI_LOBYTE Then
        IrEmit(list, OP_MOV_ECX, 255, 0)
        IrEmit(list, OP_AND_EAX_ECX, 0, 0)
    ElseIf n = BI_HIBYTE Then
        IrEmit(list, OP_MOV_ECX, 8, 0)
        IrEmit(list, OP_SAR_EAX_CL, 0, 0)
        IrEmit(list, OP_MOV_ECX, 255, 0)
        IrEmit(list, OP_AND_EAX_ECX, 0, 0)
    ElseIf n = BI_HIWORD Then
        IrEmit(list, OP_MOV_ECX, 16, 0)
        IrEmit(list, OP_SAR_EAX_CL, 0, 0)
        IrEmit(list, OP_MOV_ECX, 65535, 0)
        IrEmit(list, OP_AND_EAX_ECX, 0, 0)
    Else
        IrEmit(list, OP_MOV_ECX, 1, 0)
        IrEmit(list, OP_ADD_EAX_ECX, 0, 0)
    End If
    LowExprBuiltinMask = 1
End Function

' ビット合成／抽出系。未対応なら -1
Function LowExprBuiltinBits(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim n As Long

    ast = ctx->ast
    nodes = ast->nodes
    n = nodes[idx].num
    If n = BIK_RGB Then
        LowExprBuiltinBits = LowExprBuiltinRgb(ctx, idx)
    ElseIf n = BI_MAKELONG Then
        LowExprBuiltinBits = LowExprBuiltinMakeLong(ctx, idx)
    ElseIf n = BI_MAKEWORD Then
        LowExprBuiltinBits = LowExprBuiltinMakeWord(ctx, idx)
    Else
        LowExprBuiltinBits = LowExprBuiltinMask(ctx, idx)
    End If
End Function

Function LowExprBuiltinStr(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim n As Long
    Dim r As Long

    LowExprBuiltinStr = 0
    ast = ctx->ast
    nodes = ast->nodes
    n = nodes[idx].num
    If n = BI_LEFT Then
        LowExprBuiltinStr = LowExprBuiltinLeft(ctx, idx)
        Exit Function
    End If
    If n = BI_MID Then
        LowExprBuiltinStr = LowExprBuiltinMid(ctx, idx)
        Exit Function
    End If
    If n = BI_CHR Then
        LowExprBuiltinStr = LowExprBuiltinChr(ctx, idx)
        Exit Function
    End If
    If n = BI_RIGHT Then
        LowExprBuiltinStr = LowExprBuiltinRight(ctx, idx)
        Exit Function
    End If
    r = LowExprBuiltinBits(ctx, idx)
    If r < 0 Then
        Print "error: unsupported builtin " + Str$(n)
        ctx->err = 1
        Exit Function
    End If
    LowExprBuiltinStr = r
End Function
