#console
Declare Function ExitProcess Lib "kernel32.dll" (uExitCode As Long) As Long
Declare Function calloc Lib "msvcrt.dll" (n As Long) As *Byte
Declare Sub free Lib "msvcrt.dll" (p As *Byte)
Function Grow(ByRef head As *Byte, ByRef headLen As Long) As Long
    Dim nxt As *Byte
    Dim i As Long
    Grow = 0
    nxt = calloc(headLen + 2)
    If nxt = NULL Then Exit Function
    i = 0
    While i < headLen
        nxt[i] = head[i]
        i = i + 1
    Wend
    nxt[headLen] = 66
    nxt[headLen + 1] = 0
    free(head)
    head = nxt
    headLen = headLen + 1
    Grow = 1
End Function
Sub Main()
    Dim head As *Byte
    Dim headLen As Long
    head = calloc(1)
    head[0] = 0
    headLen = 0
    If Grow(head, headLen) = 0 Then ExitProcess(1)
    If Grow(head, headLen) = 0 Then ExitProcess(2)
    If headLen <> 2 Then ExitProcess(10 + headLen)
    If head[0] <> 66 Then ExitProcess(20)
    If head[1] <> 66 Then ExitProcess(21)
    ExitProcess(42)
End Sub
Main()
End
