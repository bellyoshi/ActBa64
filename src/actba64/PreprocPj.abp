' ===================================================
'  PreprocPj - project / #SOURCE combine
' ===================================================

Function PpFileExists(path As *Byte) As Long
    Dim p As *Byte
    Dim n As Long
    PpFileExists = 0
    p = LoadFile(path, n)
    If p = NULL Then Exit Function
    free(p)
    PpFileExists = 1
End Function

' 実行ファイルのあるディレクトリ（末尾は区切り文字付き）
Function PpToolDir(dst As *Byte) As Long
    Dim buf(511) As Byte
    Dim n As Long
    PpToolDir = 0
    dst[0] = 0
    buf[0] = 0
    n = GetModuleFileName(0, VarPtr(buf), 512)
    If n <= 0 Then buf[0] = 0
    If buf[0] = 0 Then
        If GetCmd(0, VarPtr(buf)) = 0 Then Exit Function
    End If
    If buf[0] = 0 Then Exit Function
    PpDirOf(VarPtr(buf), dst)
    If dst[0] = 0 Then Exit Function
    PpToolDir = 1
End Function

' ツール隣 / 3 階層上まで / カレントの Include\... 相対パスを解決
Function PpFindRelIdx(rel As *Byte, dst As *Byte) As Long
    Dim dir(511) As Byte

    PpFindRelIdx = 0
    dst[0] = 0
    If PpToolDir(VarPtr(dir)) <> 0 Then
        lstrcpy(dst, VarPtr(dir))
        lstrcat(dst, rel)
        If PpFileExists(dst) <> 0 Then
            PpFindRelIdx = 1
            Exit Function
        End If
        lstrcpy(dst, VarPtr(dir))
        lstrcat(dst, "..\")
        lstrcat(dst, rel)
        If PpFileExists(dst) <> 0 Then
            PpFindRelIdx = 1
            Exit Function
        End If
        lstrcpy(dst, VarPtr(dir))
        lstrcat(dst, "..\..\")
        lstrcat(dst, rel)
        If PpFileExists(dst) <> 0 Then
            PpFindRelIdx = 1
            Exit Function
        End If
        lstrcpy(dst, VarPtr(dir))
        lstrcat(dst, "..\..\..\")
        lstrcat(dst, rel)
        If PpFileExists(dst) <> 0 Then
            PpFindRelIdx = 1
            Exit Function
        End If
    End If
    lstrcpy(dst, rel)
    If PpFileExists(dst) <> 0 Then
        PpFindRelIdx = 1
        Exit Function
    End If
    dst[0] = 0
End Function

Function PpResolveAngleInclude(rel As *Byte, dst As *Byte) As Long
    Dim path(511) As Byte
    PpResolveAngleInclude = 0
    dst[0] = 0
    lstrcpy(VarPtr(path), "Include\")
    lstrcat(VarPtr(path), rel)
    If PpFindRelIdx(VarPtr(path), dst) <> 0 Then
        PpResolveAngleInclude = 1
        Exit Function
    End If
    PpResolveAngleInclude = PpFindRelIdx(rel, dst)
End Function

Function PpFindDefaultIdx(dst As *Byte) As Long
    Dim rel(63) As Byte
    lstrcpy(VarPtr(rel), "Include\default\default.idx")
    PpFindDefaultIdx = PpFindRelIdx(VarPtr(rel), dst)
End Function

Function PpFindConsoleIdx(dst As *Byte) As Long
    Dim rel(63) As Byte
    lstrcpy(VarPtr(rel), "Include\console\console.idx")
    PpFindConsoleIdx = PpFindRelIdx(VarPtr(rel), dst)
End Function

Function PpFindN88BasicIdx(dst As *Byte) As Long
    Dim rel(63) As Byte
    lstrcpy(VarPtr(rel), "Include\N88BASIC\n88basic.idx")
    PpFindN88BasicIdx = PpFindRelIdx(VarPtr(rel), dst)
End Function

' actba64 専用（Declare Lib）。actba32/abc の default.idx には載せない
Function PpFindUnicodeApi(dst As *Byte) As Long
    Dim rel(63) As Byte
    lstrcpy(VarPtr(rel), "Include\default\UnicodeApi.sbp")
    PpFindUnicodeApi = PpFindRelIdx(VarPtr(rel), dst)
End Function

' 行頭（空白可）が #name か。name は小文字。続きは空白/終端/' のみ可
Function PpLineIsHashDir(line As *Byte, n As Long, name As *Byte) As Long
    Dim i As Long
    Dim j As Long
    Dim c As Long

    PpLineIsHashDir = 0
    i = 0
    While i < n
        c = line[i]
        If c <> 32 And c <> 9 Then Exit While
        i = i + 1
    Wend
    If i >= n Or line[i] <> 35 Then Exit Function
    i = i + 1
    j = 0
    While name[j] <> 0
        If i >= n Then Exit Function
        If PpToLower(line[i]) <> name[j] Then Exit Function
        i = i + 1
        j = j + 1
    Wend
    If i < n Then
        c = line[i]
        If c <> 32 And c <> 9 And c <> 39 And c <> 13 And c <> 10 Then Exit Function
    End If
    PpLineIsHashDir = 1
End Function

Function PpSourceHasHashDir(src As *Byte, name As *Byte) As Long
    Dim i As Long
    Dim start As Long
    Dim n As Long
    Dim c As Long
    Dim line(511) As Byte
    Dim j As Long

    PpSourceHasHashDir = 0
    If src = NULL Then Exit Function
    i = 0
    While src[i] <> 0
        start = i
        While src[i] <> 0
            c = src[i]
            If c = 10 Or c = 13 Then Exit While
            i = i + 1
        Wend
        n = i - start
        If n >= PP_LINE_MAX Then n = PP_LINE_MAX - 1
        j = 0
        While j < n
            line[j] = src[start + j]
            j = j + 1
        Wend
        line[n] = 0
        If PpLineIsHashDir(VarPtr(line), n, name) <> 0 Then
            PpSourceHasHashDir = 1
            Exit Function
        End If
        If src[i] = 13 Then i = i + 1
        If src[i] = 10 Then i = i + 1
    Wend
End Function

Function PpDupText(src As *Byte) As *Byte
    Dim n As Long
    Dim dst As *Byte
    PpDupText = NULL
    n = lstrlen(src)
    dst = calloc(n + 1)
    If dst = NULL Then Exit Function
    If n > 0 Then memcpy(dst, src, n)
    dst[n] = 0
    PpDupText = dst
End Function

Function PpConcatText(a As *Byte, aLen As Long, b As *Byte, bLen As Long) As *Byte
    Dim dst As *Byte
    PpConcatText = NULL
    dst = calloc(aLen + bLen + 1)
    If dst = NULL Then Exit Function
    If aLen > 0 And a <> NULL Then memcpy(dst, a, aLen)
    If bLen > 0 And b <> NULL Then memcpy(VarPtr(dst[aLen]), b, bLen)
    dst[aLen + bLen] = 0
    PpConcatText = dst
End Function

' idx を ExpandIncludes して返す（失敗時は警告して空文字相当の "" を返す）
Function PpLoadIdxExpanded(idxPath As *Byte) As *Byte
    Dim idxSrc As *Byte
    Dim idxSize As Long
    Dim part As *Byte
    Dim empty As *Byte

    PpLoadIdxExpanded = NULL
    idxSrc = LoadFile(idxPath, idxSize)
    If idxSrc = NULL Then
        Print "warning: cannot open: " + MakeStr(idxPath)
        empty = calloc(1)
        If empty <> NULL Then empty[0] = 0
        PpLoadIdxExpanded = empty
        Exit Function
    End If
    part = ExpandIncludes(idxSrc, idxSize, idxPath)
    free(idxSrc)
    If part = NULL Then
        Print "warning: preprocess failed: " + MakeStr(idxPath)
        empty = calloc(1)
        If empty <> NULL Then empty[0] = 0
        PpLoadIdxExpanded = empty
        Exit Function
    End If
    PpLoadIdxExpanded = part
End Function

Function PpConcatHead(ByRef head As *Byte, ByRef headLen As Long, part As *Byte) As Long
    Dim nxt As *Byte
    Dim partLen As Long
    PpConcatHead = 0
    If part = NULL Then
        free(head)
        Exit Function
    End If
    partLen = lstrlen(part)
    nxt = PpConcatText(head, headLen, part, partLen)
    free(head)
    free(part)
    If nxt = NULL Then Exit Function
    head = nxt
    headLen = headLen + partLen
    PpConcatHead = 1
End Function

Function PpAppendIdxPath(ByRef head As *Byte, ByRef headLen As Long, idxPath As *Byte) As Long
    Dim part As *Byte
    PpAppendIdxPath = 0
    part = PpLoadIdxExpanded(idxPath)
    If PpConcatHead(head, headLen, part) = 0 Then Exit Function
    PpAppendIdxPath = 1
End Function

Function PpAppendDefaultChunk(ByRef head As *Byte, ByRef headLen As Long) As Long
    Dim idxPath(511) As Byte
    PpAppendDefaultChunk = 0
    If PpFindDefaultIdx(VarPtr(idxPath)) = 0 Then
        Print "warning: not found: Include\default\default.idx"
        PpAppendDefaultChunk = 1
        Exit Function
    End If
    If PpAppendIdxPath(head, headLen, VarPtr(idxPath)) = 0 Then Exit Function
    PpAppendDefaultChunk = 1
End Function

Function PpAppendUnicodeChunk(ByRef head As *Byte, ByRef headLen As Long) As Long
    Dim idxPath(511) As Byte
    PpAppendUnicodeChunk = 1
    If PpFindUnicodeApi(VarPtr(idxPath)) = 0 Then Exit Function
    If PpAppendIdxPath(head, headLen, VarPtr(idxPath)) = 0 Then
        PpAppendUnicodeChunk = 0
        Exit Function
    End If
End Function

Function PpAppendConsoleChunk(ByRef head As *Byte, ByRef headLen As Long) As Long
    Dim idxPath(511) As Byte
    PpAppendConsoleChunk = 0
    If PpFindConsoleIdx(VarPtr(idxPath)) = 0 Then
        Print "warning: not found: Include\console\console.idx"
        PpAppendConsoleChunk = 1
        Exit Function
    End If
    If PpAppendIdxPath(head, headLen, VarPtr(idxPath)) = 0 Then Exit Function
    PpAppendConsoleChunk = 1
End Function

Function PpAppendN88Chunk(ByRef head As *Byte, ByRef headLen As Long) As Long
    Dim idxPath(511) As Byte
    PpAppendN88Chunk = 0
    If PpFindN88BasicIdx(VarPtr(idxPath)) = 0 Then
        Print "warning: not found: Include\N88BASIC\n88basic.idx"
        PpAppendN88Chunk = 1
        Exit Function
    End If
    If PpAppendIdxPath(head, headLen, VarPtr(idxPath)) = 0 Then Exit Function
    PpAppendN88Chunk = 1
End Function

Function PpAppendN88Foot(ByRef head As *Byte, ByRef headLen As Long) As Long
    Dim foot(31) As Byte
    Dim footLen As Long
    Dim nxt As *Byte
    PpAppendN88Foot = 0
    foot[0] = 13
    foot[1] = 10
    lstrcpy(VarPtr(foot[2]), "N88_Run()")
    footLen = lstrlen(VarPtr(foot))
    foot[footLen] = 13
    footLen = footLen + 1
    foot[footLen] = 10
    footLen = footLen + 1
    foot[footLen] = 0
    nxt = PpConcatText(head, headLen, VarPtr(foot), footLen)
    free(head)
    If nxt = NULL Then Exit Function
    head = nxt
    PpAppendN88Foot = 1
End Function

Function PpDetectConsole(src As *Byte) As Long
    Dim kCon(15) As Byte
    lstrcpy(VarPtr(kCon), "console")
    PpDetectConsole = PpSourceHasHashDir(src, VarPtr(kCon))
End Function

Function PpDetectN88(src As *Byte) As Long
    Dim kn88(15) As Byte
    Dim kPrompt(15) As Byte
    Dim want As Long
    lstrcpy(VarPtr(kn88), "n88basic")
    lstrcpy(VarPtr(kPrompt), "prompt")
    want = PpSourceHasHashDir(src, VarPtr(kn88))
    If want = 0 Then
        want = PpSourceHasHashDir(src, VarPtr(kPrompt))
    End If
    PpDetectN88 = want
End Function

' Include\default を常時先頭へ。#console / #n88basic / #prompt なら各 idx も挿入。
' #n88basic / #prompt 時は GUI サブシステムを有効化し、末尾に N88_Run() を付ける。
Function PpPrependDefaults(src As *Byte) As *Byte
    Dim head As *Byte
    Dim nxt As *Byte
    Dim headLen As Long
    Dim srcLen As Long
    Dim wantCon As Long
    Dim wantN88 As Long

    PpPrependDefaults = NULL
    wantCon = PpDetectConsole(src)
    wantN88 = PpDetectN88(src)
    g_ppN88Basic = wantN88
    If wantN88 <> 0 Then
        g_ppUseWindow = 1
    End If

    head = calloc(1)
    If head = NULL Then Exit Function
    head[0] = 0
    headLen = 0

    If PpAppendDefaultChunk(head, headLen) = 0 Then Exit Function
    If PpAppendUnicodeChunk(head, headLen) = 0 Then Exit Function
    If wantCon <> 0 Then
        If PpAppendConsoleChunk(head, headLen) = 0 Then Exit Function
    End If
    If wantN88 <> 0 Then
        If PpAppendN88Chunk(head, headLen) = 0 Then Exit Function
    End If

    srcLen = lstrlen(src)
    nxt = PpConcatText(head, headLen, src, srcLen)
    free(head)
    If nxt = NULL Then Exit Function
    head = nxt
    headLen = headLen + srcLen

    If wantN88 <> 0 Then
        If PpAppendN88Foot(head, headLen) = 0 Then Exit Function
    End If

    PpPrependDefaults = head
End Function

Const PJ_PATH_LEN = 260

Function PpPathEndsWithPj(path As *Byte) As Long
    Dim n As Long
    Dim c0 As Long
    Dim c1 As Long
    Dim c2 As Long
    PpPathEndsWithPj = 0
    n = lstrlen(path)
    If n < 3 Then Exit Function
    c0 = path[n - 3]
    c1 = PpToLower(path[n - 2])
    c2 = PpToLower(path[n - 1])
    If c0 = 46 And c1 = 112 And c2 = 106 Then
        PpPathEndsWithPj = 1
    End If
End Function

Function PpLineIsSourceHeader(line As *Byte, n As Long) As Long
    Dim i As Long
    Dim word(15) As Byte
    Dim k As Long
    Dim c As Long
    PpLineIsSourceHeader = 0
    i = 0
    While i < n
        c = line[i]
        If c <> 32 And c <> 9 Then Exit While
        i = i + 1
    Wend
    If i >= n Then Exit Function
    If line[i] <> 35 Then Exit Function
    i = i + 1
    lstrcpy(VarPtr(word), "source")
    k = 0
    While word[k] <> 0
        If i + k >= n Then Exit Function
        If PpToLower(line[i + k]) <> word[k] Then Exit Function
        k = k + 1
    Wend
    If i + k < n Then
        c = line[i + k]
        If c <> 32 And c <> 9 And c <> 0 Then Exit Function
    End If
    PpLineIsSourceHeader = 1
End Function

Function PpSkipWsAt(line As *Byte, n As Long, from As Long) As Long
    Dim i As Long
    Dim c As Long
    i = from
    While i < n
        c = line[i]
        If c <> 32 And c <> 9 Then Exit While
        i = i + 1
    Wend
    PpSkipWsAt = i
End Function

Function PpParseEqNumber(line As *Byte, n As Long, from As Long, ByRef valOut As Long) As Long
    Dim i As Long
    Dim c As Long
    Dim v As Long
    Dim got As Long
    PpParseEqNumber = 0
    i = from
    v = 0
    got = 0
    While i < n
        c = line[i]
        If c >= 48 And c <= 57 Then
            v = v * 10 + (c - 48)
            got = 1
        ElseIf c = 32 Or c = 9 Then
            If got <> 0 Then Exit While
        Else
            Exit While
        End If
        i = i + 1
    Wend
    If got = 0 Then Exit Function
    valOut = v
    PpParseEqNumber = 1
End Function

' #USEWINDOW=1 / #usewindow=0 （#SOURCE 節の外も含め全行を対象）
Function PpLineUseWindow(line As *Byte, n As Long, ByRef valOut As Long) As Long
    Dim i As Long
    Dim k As Long
    Dim word(15) As Byte

    PpLineUseWindow = 0
    i = PpSkipWsAt(line, n, 0)
    If i >= n Then Exit Function
    If line[i] <> 35 Then Exit Function
    i = i + 1
    lstrcpy(VarPtr(word), "usewindow")
    k = 0
    While word[k] <> 0
        If i + k >= n Then Exit Function
        If PpToLower(line[i + k]) <> word[k] Then Exit Function
        k = k + 1
    Wend
    i = PpSkipWsAt(line, n, i + k)
    If i >= n Then Exit Function
    If line[i] <> 61 Then Exit Function
    If PpParseEqNumber(line, n, i + 1, valOut) = 0 Then Exit Function
    PpLineUseWindow = 1
End Function

Function PpTrimCopy(line As *Byte, n As Long, dst As *Byte, dstMax As Long) As Long
    Dim i As Long
    Dim j As Long
    Dim c As Long
    PpTrimCopy = 0
    dst[0] = 0
    i = 0
    While i < n
        c = line[i]
        If c <> 32 And c <> 9 Then Exit While
        i = i + 1
    Wend
    If i < n And line[i] = 39 Then Exit Function
    j = 0
    While i < n And j < dstMax - 1
        c = line[i]
        If c = 39 Then Exit While
        dst[j] = c As Byte
        j = j + 1
        i = i + 1
    Wend
    While j > 0
        c = dst[j - 1]
        If c <> 32 And c <> 9 Then Exit While
        j = j - 1
    Wend
    dst[j] = 0
    PpTrimCopy = j
End Function

Sub PpJoinSrcPath(dir As *Byte, name As *Byte, full As *Byte)
    full[0] = 0
    If (name[1] = 58) Or (name[0] = 92) Or (name[0] = 47) Then
        lstrcpy(full, name)
    Else
        lstrcpy(full, dir)
        lstrcat(full, name)
    End If
End Sub

Function PpEmitSrcHeader(dst As *Byte, ByRef dstLen As Long, dstCap As Long, name As *Byte) As Long
    Dim hdr(63) As Byte
    PpEmitSrcHeader = 0
    lstrcpy(VarPtr(hdr), "' ---- ")
    If PpAppend(dst, dstLen, dstCap, VarPtr(hdr), lstrlen(VarPtr(hdr))) = 0 Then Exit Function
    If PpAppend(dst, dstLen, dstCap, name, lstrlen(name)) = 0 Then Exit Function
    lstrcpy(VarPtr(hdr), " ----")
    hdr[5] = 13
    hdr[6] = 10
    hdr[7] = 0
    If PpAppend(dst, dstLen, dstCap, VarPtr(hdr), 7) = 0 Then Exit Function
    PpEmitSrcHeader = 1
End Function

Function PpAppendOneSource(dst As *Byte, ByRef dstLen As Long, dstCap As Long, dir As *Byte, name As *Byte) As Long
    Dim full(511) As Byte
    Dim src As *Byte
    Dim srcSize As Long
    Dim expanded As *Byte
    Dim expLen As Long
    Dim crlf(3) As Byte
    PpAppendOneSource = 0
    PpJoinSrcPath(dir, name, VarPtr(full))
    If PpOnceHas(VarPtr(full)) <> 0 Then
        PpAppendOneSource = 1
        Exit Function
    End If
    src = LoadFile(VarPtr(full), srcSize)
    If src = NULL Then Exit Function
    PpOnceAdd(VarPtr(full))
    expanded = ExpandIncludes(src, srcSize, VarPtr(full))
    free(src)
    If expanded = NULL Then Exit Function
    If PpEmitSrcHeader(dst, dstLen, dstCap, name) = 0 Then
        free(expanded)
        Exit Function
    End If
    expLen = lstrlen(expanded)
    If PpAppend(dst, dstLen, dstCap, expanded, expLen) = 0 Then
        free(expanded)
        Exit Function
    End If
    crlf[0] = 13
    crlf[1] = 10
    If PpAppend(dst, dstLen, dstCap, VarPtr(crlf), 2) = 0 Then
        free(expanded)
        Exit Function
    End If
    free(expanded)
    PpAppendOneSource = 1
End Function

Function PpHandleSourceLoop(line As *Byte, n As Long, ByRef inSource As Long, dst As *Byte, ByRef dstLen As Long, dstCap As Long, dir As *Byte, ByRef nSrc As Long) As Long
    Dim j As Long
    Dim c As Long
    Dim name(259) As Byte
    PpHandleSourceLoop = 1
    If PpLineIsSourceHeader(line, n) <> 0 Then
        inSource = 1
        Exit Function
    End If
    If inSource = 0 Then Exit Function
    j = 0
    While j < n
        c = line[j]
        If c <> 32 And c <> 9 Then Exit While
        j = j + 1
    Wend
    If j < n And line[j] = 35 Then
        inSource = 0
        Exit Function
    End If
    If PpTrimCopy(line, n, VarPtr(name), PJ_PATH_LEN) > 0 Then
        If PpAppendOneSource(dst, dstLen, dstCap, dir, VarPtr(name)) = 0 Then
            PpHandleSourceLoop = 0
            Exit Function
        End If
        nSrc = nSrc + 1
    End If
End Function

Function PpNextPjLine(pj As *Byte, pjSize As Long, ByRef i As Long, line As *Byte) As Long
    Dim start As Long
    Dim n As Long
    Dim c As Long
    Dim j As Long
    start = i
    While i < pjSize
        c = pj[i]
        If c = 10 Or c = 13 Then Exit While
        i = i + 1
    Wend
    n = i - start
    If n >= PP_LINE_MAX Then n = PP_LINE_MAX - 1
    j = 0
    While j < n
        line[j] = pj[start + j]
        j = j + 1
    Wend
    line[n] = 0
    If i < pjSize And pj[i] = 13 Then i = i + 1
    If i < pjSize And pj[i] = 10 Then i = i + 1
    PpNextPjLine = n
End Function

Function PpPjProcessLine(line As *Byte, n As Long, ByRef inSource As Long, dst As *Byte, ByRef dstLen As Long, dstCap As Long, dir As *Byte, ByRef nSrc As Long) As Long
    Dim uwVal As Long
    PpPjProcessLine = 0
    If PpLineUseWindow(line, n, uwVal) <> 0 Then
        g_ppUseWindow = uwVal
    End If
    If PpHandleSourceLoop(line, n, inSource, dst, dstLen, dstCap, dir, nSrc) = 0 Then Exit Function
    PpPjProcessLine = 1
End Function

Function CombinePjSources(pjPath As *Byte) As *Byte
    Dim pj As *Byte
    Dim pjSize As Long
    Dim i As Long
    Dim n As Long
    Dim line(511) As Byte
    Dim dir(511) As Byte
    Dim inSource As Long
    Dim dst As *Byte
    Dim dstLen As Long
    Dim dstCap As Long
    Dim nSrc As Long

    CombinePjSources = NULL
    PpOnceReset()
    g_ppUseWindow = 0
    pj = LoadFile(pjPath, pjSize)
    If pj = NULL Then Exit Function
    PpDirOf(pjPath, VarPtr(dir))

    ' Full actba64.pj sources exceed 256KiB once headers are included.
    dstCap = 2097152
    dst = calloc(dstCap)
    If dst = NULL Then
        free(pj)
        Exit Function
    End If
    dstLen = 0
    dst[0] = 0
    inSource = 0
    nSrc = 0
    i = 0
    While i < pjSize
        n = PpNextPjLine(pj, pjSize, i, VarPtr(line))
        If PpPjProcessLine(VarPtr(line), n, inSource, dst, dstLen, dstCap, VarPtr(dir), nSrc) = 0 Then
            free(pj)
            free(dst)
            Exit Function
        End If
    Wend
    free(pj)
    If nSrc <= 0 Then
        free(dst)
        Exit Function
    End If
    CombinePjSources = dst
End Function
