' ===================================================
'  PreprocPj - project / #SOURCE combine
' ===================================================

Function PpFileExists(path As *Byte) As Long
    Dim p As *Byte
    Dim n As Long
    PpFileExists = 0
    p = LoadFile(path, n)
    If p = NULL Then Exit Function
    free(p)
    PpFileExists = 1
End Function

' 実行ファイルのあるディレクトリ（末尾は区切り文字付き）
Function PpToolDir(dst As *Byte) As Long
    Dim buf(511) As Byte
    Dim n As Long
    PpToolDir = 0
    dst[0] = 0
    buf[0] = 0
    n = GetModuleFileName(0, VarPtr(buf), 512)
    If n <= 0 Then buf[0] = 0
    If buf[0] = 0 Then
        If GetCmd(0, VarPtr(buf)) = 0 Then Exit Function
    End If
    If buf[0] = 0 Then Exit Function
    PpDirOf(VarPtr(buf), dst)
    If dst[0] = 0 Then Exit Function
    PpToolDir = 1
End Function

' ツール隣 / 3 階層上まで / カレントの Include\... 相対パスを解決
Function PpFindRelIdx(rel As *Byte, dst As *Byte) As Long
    Dim dir(511) As Byte

    PpFindRelIdx = 0
    dst[0] = 0
    If PpToolDir(VarPtr(dir)) <> 0 Then
        lstrcpy(dst, VarPtr(dir))
        lstrcat(dst, rel)
        If PpFileExists(dst) <> 0 Then
            PpFindRelIdx = 1
            Exit Function
        End If
        lstrcpy(dst, VarPtr(dir))
        lstrcat(dst, "..\")
        lstrcat(dst, rel)
        If PpFileExists(dst) <> 0 Then
            PpFindRelIdx = 1
            Exit Function
        End If
        lstrcpy(dst, VarPtr(dir))
        lstrcat(dst, "..\..\")
        lstrcat(dst, rel)
        If PpFileExists(dst) <> 0 Then
            PpFindRelIdx = 1
            Exit Function
        End If
        lstrcpy(dst, VarPtr(dir))
        lstrcat(dst, "..\..\..\")
        lstrcat(dst, rel)
        If PpFileExists(dst) <> 0 Then
            PpFindRelIdx = 1
            Exit Function
        End If
    End If
    lstrcpy(dst, rel)
    If PpFileExists(dst) <> 0 Then
        PpFindRelIdx = 1
        Exit Function
    End If
    dst[0] = 0
End Function

Function PpResolveAngleInclude(rel As *Byte, dst As *Byte) As Long
    Dim path(511) As Byte
    PpResolveAngleInclude = 0
    dst[0] = 0
    lstrcpy(VarPtr(path), "Include\")
    lstrcat(VarPtr(path), rel)
    If PpFindRelIdx(VarPtr(path), dst) <> 0 Then
        PpResolveAngleInclude = 1
        Exit Function
    End If
    PpResolveAngleInclude = PpFindRelIdx(rel, dst)
End Function

Function PpFindDefaultIdx(dst As *Byte) As Long
    Dim rel(63) As Byte
    lstrcpy(VarPtr(rel), "Include\default\default.idx")
    PpFindDefaultIdx = PpFindRelIdx(VarPtr(rel), dst)
End Function

Function PpFindConsoleIdx(dst As *Byte) As Long
    Dim rel(63) As Byte
    lstrcpy(VarPtr(rel), "Include\console\console.idx")
    PpFindConsoleIdx = PpFindRelIdx(VarPtr(rel), dst)
End Function

Function PpFindN88BasicIdx(dst As *Byte) As Long
    Dim rel(63) As Byte
    lstrcpy(VarPtr(rel), "Include\N88BASIC\n88basic.idx")
    PpFindN88BasicIdx = PpFindRelIdx(VarPtr(rel), dst)
End Function

' actba64 専用（Declare Lib）。actba32/abc の default.idx には載せない
Function PpFindUnicodeApi(dst As *Byte) As Long
    Dim rel(63) As Byte
    lstrcpy(VarPtr(rel), "Include\default\UnicodeApi.sbp")
    PpFindUnicodeApi = PpFindRelIdx(VarPtr(rel), dst)
End Function

' 行頭（空白可）が #name か。name は小文字。続きは空白/終端/' のみ可
Function PpLineIsHashDir(line As *Byte, n As Long, name As *Byte) As Long
    Dim i As Long
    Dim j As Long
    Dim c As Long

    PpLineIsHashDir = 0
    i = 0
    While i < n
        c = line[i]
        If c <> 32 And c <> 9 Then Exit While
        i = i + 1
    Wend
    If i >= n Or line[i] <> 35 Then Exit Function
    i = i + 1
    j = 0
    While name[j] <> 0
        If i >= n Then Exit Function
        If PpToLower(line[i]) <> name[j] Then Exit Function
        i = i + 1
        j = j + 1
    Wend
    If i < n Then
        c = line[i]
        If c <> 32 And c <> 9 And c <> 39 And c <> 13 And c <> 10 Then Exit Function
    End If
    PpLineIsHashDir = 1
End Function

Function PpSourceHasHashDir(src As *Byte, name As *Byte) As Long
    Dim i As Long
    Dim start As Long
    Dim n As Long
    Dim c As Long
    Dim line(1023) As Byte
    Dim j As Long

    PpSourceHasHashDir = 0
    If src = NULL Then Exit Function
    i = 0
    While src[i] <> 0
        start = i
        While src[i] <> 0
            c = src[i]
            If c = 10 Or c = 13 Then Exit While
            i = i + 1
        Wend
        n = i - start
        If n >= PP_LINE_MAX Then n = PP_LINE_MAX - 1
        j = 0
        While j < n
            line[j] = src[start + j]
            j = j + 1
        Wend
        line[n] = 0
        If PpLineIsHashDir(VarPtr(line), n, name) <> 0 Then
            PpSourceHasHashDir = 1
            Exit Function
        End If
        If src[i] = 13 Then i = i + 1
        If src[i] = 10 Then i = i + 1
    Wend
End Function

Function PpDupText(src As *Byte) As *Byte
    Dim n As Long
    Dim dst As *Byte
    PpDupText = NULL
    n = lstrlen(src)
    dst = calloc(n + 1)
    If dst = NULL Then Exit Function
    If n > 0 Then memcpy(dst, src, n)
    dst[n] = 0
    PpDupText = dst
End Function

Function PpConcatText(a As *Byte, aLen As Long, b As *Byte, bLen As Long) As *Byte
    Dim dst As *Byte
    PpConcatText = NULL
    dst = calloc(aLen + bLen + 1)
    If dst = NULL Then Exit Function
    If aLen > 0 And a <> NULL Then memcpy(dst, a, aLen)
    If bLen > 0 And b <> NULL Then memcpy(VarPtr(dst[aLen]), b, bLen)
    dst[aLen + bLen] = 0
    PpConcatText = dst
End Function

' idx を ExpandIncludes して返す（失敗時は警告して空文字相当の "" を返す）
Function PpLoadIdxExpanded(idxPath As *Byte) As *Byte
    Dim idxSrc As *Byte
    Dim idxSize As Long
    Dim part As *Byte
    Dim empty As *Byte

    PpLoadIdxExpanded = NULL
    idxSrc = LoadFile(idxPath, idxSize)
    If idxSrc = NULL Then
        Print "warning: cannot open: " + MakeStr(idxPath)
        empty = calloc(1)
        If empty <> NULL Then empty[0] = 0
        PpLoadIdxExpanded = empty
        Exit Function
    End If
    part = ExpandIncludes(idxSrc, idxSize, idxPath)
    free(idxSrc)
    If part = NULL Then
        Print "warning: preprocess failed: " + MakeStr(idxPath)
        empty = calloc(1)
        If empty <> NULL Then empty[0] = 0
        PpLoadIdxExpanded = empty
        Exit Function
    End If
    PpLoadIdxExpanded = part
End Function

Function PpConcatHead(ByRef head As *Byte, ByRef headLen As Long, part As *Byte) As Long
    Dim nxt As *Byte
    Dim partLen As Long
    PpConcatHead = 0
    If part = NULL Then
        free(head)
        Exit Function
    End If
    partLen = lstrlen(part)
    nxt = PpConcatText(head, headLen, part, partLen)
    free(head)
    free(part)
    If nxt = NULL Then Exit Function
    head = nxt
    headLen = headLen + partLen
    PpConcatHead = 1
End Function

Function PpAppendIdxPath(ByRef head As *Byte, ByRef headLen As Long, idxPath As *Byte) As Long
    Dim part As *Byte
    PpAppendIdxPath = 0
    part = PpLoadIdxExpanded(idxPath)
    If PpConcatHead(head, headLen, part) = 0 Then Exit Function
    PpAppendIdxPath = 1
End Function

Function PpAppendDefaultChunk(ByRef head As *Byte, ByRef headLen As Long) As Long
    Dim idxPath(511) As Byte
    PpAppendDefaultChunk = 0
    If PpFindDefaultIdx(VarPtr(idxPath)) = 0 Then
        Print "warning: not found: Include\default\default.idx"
        PpAppendDefaultChunk = 1
        Exit Function
    End If
    If PpAppendIdxPath(head, headLen, VarPtr(idxPath)) = 0 Then Exit Function
    PpAppendDefaultChunk = 1
End Function

Function PpAppendUnicodeChunk(ByRef head As *Byte, ByRef headLen As Long) As Long
    Dim idxPath(511) As Byte
    PpAppendUnicodeChunk = 1
    If PpFindUnicodeApi(VarPtr(idxPath)) = 0 Then Exit Function
    If PpAppendIdxPath(head, headLen, VarPtr(idxPath)) = 0 Then
        PpAppendUnicodeChunk = 0
        Exit Function
    End If
End Function

Function PpAppendConsoleChunk(ByRef head As *Byte, ByRef headLen As Long) As Long
    Dim idxPath(511) As Byte
    PpAppendConsoleChunk = 0
    If PpFindConsoleIdx(VarPtr(idxPath)) = 0 Then
        Print "warning: not found: Include\console\console.idx"
        PpAppendConsoleChunk = 1
        Exit Function
    End If
    If PpAppendIdxPath(head, headLen, VarPtr(idxPath)) = 0 Then Exit Function
    PpAppendConsoleChunk = 1
End Function

Function PpAppendN88Chunk(ByRef head As *Byte, ByRef headLen As Long) As Long
    Dim idxPath(511) As Byte
    PpAppendN88Chunk = 0
    If PpFindN88BasicIdx(VarPtr(idxPath)) = 0 Then
        Print "warning: not found: Include\N88BASIC\n88basic.idx"
        PpAppendN88Chunk = 1
        Exit Function
    End If
    If PpAppendIdxPath(head, headLen, VarPtr(idxPath)) = 0 Then Exit Function
    PpAppendN88Chunk = 1
End Function

Function PpAppendN88Foot(ByRef head As *Byte, ByRef headLen As Long) As Long
    Dim foot(31) As Byte
    Dim footLen As Long
    Dim nxt As *Byte
    PpAppendN88Foot = 0
    foot[0] = 13
    foot[1] = 10
    lstrcpy(VarPtr(foot[2]), "N88_Run()")
    footLen = lstrlen(VarPtr(foot))
    foot[footLen] = 13
    footLen = footLen + 1
    foot[footLen] = 10
    footLen = footLen + 1
    foot[footLen] = 0
    nxt = PpConcatText(head, headLen, VarPtr(foot), footLen)
    free(head)
    If nxt = NULL Then Exit Function
    head = nxt
    PpAppendN88Foot = 1
End Function

Function PpDetectConsole(src As *Byte) As Long
    Dim kCon(15) As Byte
    lstrcpy(VarPtr(kCon), "console")
    PpDetectConsole = PpSourceHasHashDir(src, VarPtr(kCon))
End Function

Function PpDetectN88(src As *Byte) As Long
    Dim kn88(15) As Byte
    Dim kPrompt(15) As Byte
    Dim want As Long
    lstrcpy(VarPtr(kn88), "n88basic")
    lstrcpy(VarPtr(kPrompt), "prompt")
    want = PpSourceHasHashDir(src, VarPtr(kn88))
    If want = 0 Then
        want = PpSourceHasHashDir(src, VarPtr(kPrompt))
    End If
    PpDetectN88 = want
End Function

' Include\default を常時先頭へ。#console / #n88basic / #prompt なら各 idx も挿入。
' #n88basic / #prompt 時は GUI サブシステムを有効化し、末尾に N88_Run() を付ける。
Function PpPrependDefaults(src As *Byte) As *Byte
    Dim head As *Byte
    Dim nxt As *Byte
    Dim headLen As Long
    Dim srcLen As Long
    Dim wantCon As Long
    Dim wantN88 As Long

    PpPrependDefaults = NULL
    wantCon = PpDetectConsole(src)
    wantN88 = PpDetectN88(src)
    g_ppN88Basic = wantN88
    If wantN88 <> 0 Then
        g_ppUseWindow = 1
    End If

    head = calloc(1)
    If head = NULL Then Exit Function
    head[0] = 0
    headLen = 0

    If PpAppendDefaultChunk(head, headLen) = 0 Then Exit Function
    If PpAppendUnicodeChunk(head, headLen) = 0 Then Exit Function
    If wantCon <> 0 Then
        If PpAppendConsoleChunk(head, headLen) = 0 Then Exit Function
    End If
    If wantN88 <> 0 Then
        If PpAppendN88Chunk(head, headLen) = 0 Then Exit Function
    End If

    srcLen = lstrlen(src)
    nxt = PpConcatText(head, headLen, src, srcLen)
    free(head)
    If nxt = NULL Then Exit Function
    head = nxt
    headLen = headLen + srcLen

    If wantN88 <> 0 Then
        If PpAppendN88Foot(head, headLen) = 0 Then Exit Function
    End If

    PpPrependDefaults = head
End Function

Const PJ_PATH_LEN = 260
