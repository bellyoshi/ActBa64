' LexerLit - 数値と文字列

Function LexHexLit(lx As *Lexer) As Long
    Dim src As *Byte
    Dim n2 As Long
    Dim c As Long
    Dim n As Long
    Dim v As Long
    Dim idx As Long
    Dim toks As *Tok
    Dim nd As Long
    LexHexLit = 0
    src = lx->src
    n2 = src[lx->pos + 1]
    If IsHSpace(n2) Then
        idx = LexAmpSpacedHex(lx)
        If idx > 0 Then
            lx->pos = idx - 1
            n2 = src[idx]
        End If
    End If
    If IsHexPrefix(n2) Then
        lx->pos = lx->pos + 2
        n = 0
        nd = 0
        LexLit64Clear()
        Do
            c = src[lx->pos]
            v = HexDigitValue(c)
            If v < 0 Then Exit Do
            n = n * LEX_RADIX_HEX + v
            LexLit64MulAdd(LEX_RADIX_HEX, v)
            nd = nd + 1
            lx->pos = lx->pos + 1
        Loop
        LexSkipLongSuffix(lx)
        ' 9..16 桁の &H は、64bit 出力なら Int64 のリテラル
        If nd > 8 And nd <= 16 And TyIs32() = 0 Then
            LexHexLit = LexPushLit64(lx)
            Exit Function
        End If
        idx = LexPush(lx, TK_NUMBER)
        If idx < 0 Then Exit Function
        toks = lx->toks
        toks[idx].num = n
    Else
        LexPush(lx, TK_AMP)
        lx->pos = lx->pos + 1
    End If
    LexHexLit = 1
End Function

' 式の途中で、後ろに値が来る語（If x = ... の If、And、Return など）なら 1
Function LexWordTakesValue(w As *Byte) As Long
    LexWordTakesValue = 1
    If lstrcmpi(w, "if") = 0 Or lstrcmpi(w, "then") = 0 Or lstrcmpi(w, "else") = 0 Or lstrcmpi(w, "elseif") = 0 Then Exit Function
    If lstrcmpi(w, "and") = 0 Or lstrcmpi(w, "or") = 0 Or lstrcmpi(w, "xor") = 0 Or lstrcmpi(w, "not") = 0 Then Exit Function
    If lstrcmpi(w, "mod") = 0 Or lstrcmpi(w, "to") = 0 Or lstrcmpi(w, "step") = 0 Or lstrcmpi(w, "while") = 0 Then Exit Function
    If lstrcmpi(w, "until") = 0 Or lstrcmpi(w, "case") = 0 Or lstrcmpi(w, "return") = 0 Or lstrcmpi(w, "print") = 0 Then Exit Function
    LexWordTakesValue = 0
End Function

' & HC のように & と H の間に空白がある 16 進（ActiveBasic は通す）。H の位置、違えば 0。
' 直前が値（識別子・数・文字列・閉じ括弧）なら連結の & なので 0
Function LexAmpSpacedHex(lx As *Lexer) As Long
    Dim src As *Byte
    Dim toks As *Tok
    Dim k As Long
    Dim pk As Long
    Dim texts As *Byte
    LexAmpSpacedHex = 0
    If lx->count > 0 Then
        toks = lx->toks
        pk = toks[lx->count - 1].kind
        If pk = TK_IDENT Then
            texts = lx->texts
            If LexWordTakesValue(VarPtr(texts[(lx->count - 1) * LEX_TEXT_LEN])) = 0 Then Exit Function
        End If
        If pk = TK_NUMBER Or pk = TK_FLOAT Or pk = TK_STRING Then Exit Function
        If pk = TK_RPAREN Or pk = TK_RBRACK Then Exit Function
    End If
    src = lx->src
    k = lx->pos + 1
    While IsHSpace(src[k])
        k = k + 1
    Wend
    If Not IsHexPrefix(src[k]) Then Exit Function
    If HexDigitValue(src[k + 1]) < 0 Then Exit Function
    LexAmpSpacedHex = k
End Function

' &H1007& の末尾 &（Long の型文字）。後ろが &H や識別子なら演算子の & なので残す
Sub LexSkipLongSuffix(lx As *Lexer)
    Dim src As *Byte
    Dim nxt As Long
    src = lx->src
    If src[lx->pos] <> CH_AMP Then Exit Sub
    nxt = src[lx->pos + 1]
    If IsIdentCont(nxt) Or nxt = CH_AMP Then Exit Sub
    lx->pos = lx->pos + 1
End Sub

' 数字の後ろの . は、次が数字か、識別子の始まりでなければ小数点（1.5 / 1.+1.）
Function LexDotIsFloat(ByVal nxt As Long) As Long
    LexDotIsFloat = 1
    If IsDigit(nxt) Then Exit Function
    If IsIdentCont(nxt) Then LexDotIsFloat = 0
End Function

' . の次が数字なら、先頭の 0 を省いた小数（.5）の始まり
Function LexDotDigit(lx As *Lexer, c As Long) As Long
    Dim src As *Byte
    LexDotDigit = 0
    If c <> CH_DOT Then Exit Function
    src = lx->src
    If IsDigit(src[lx->pos + 1]) Then LexDotDigit = 1
End Function

Function LexNumber(lx As *Lexer) As Long
    Dim start As Long
    Dim isF As Long
    start = lx->pos
    lx->pos = LexSkipDigits(lx->src, start)
    isF = LexScanFrac(lx)
    If LexScanExp(lx) <> 0 Then isF = 1
    If isF = 0 Then isF = LexDecTooBig(lx->src, start, lx->pos)
    ' 32bit に入らない十進の整数は、64bit 出力なら Int64 のリテラル（入らなければ Double）
    If isF = 1 And LexDecIsInt(lx->src, start, lx->pos) <> 0 Then
        If LexPushDec64(lx, start) <> 0 Then
            LexNumber = 1
            Exit Function
        End If
    End If
    If isF <> 0 Then
        LexNumber = LexPushFloat(lx, start)
    Else
        LexNumber = LexPushInt(lx, start)
    End If
End Function

' src[k] から数字の並びを飛ばした位置
Function LexSkipDigits(src As *Byte, k As Long) As Long
    While IsDigit(src[k])
        k = k + 1
    Wend
    LexSkipDigits = k
End Function

' 1.5 / 1. の小数部（. の次が識別子なら小数点ではない）。読んだら 1
Function LexScanFrac(lx As *Lexer) As Long
    Dim src As *Byte
    LexScanFrac = 0
    src = lx->src
    If src[lx->pos] <> CH_DOT Then Exit Function
    If LexDotIsFloat(src[lx->pos + 1]) = 0 Then Exit Function
    lx->pos = LexSkipDigits(src, lx->pos + 1)
    LexScanFrac = 1
End Function

' 1e10 / 2.5E-3 / 1E+3 の指数部。e の次が数字か、符号と数字のときだけ。読んだら 1
Function LexScanExp(lx As *Lexer) As Long
    Dim src As *Byte
    Dim k As Long
    LexScanExp = 0
    src = lx->src
    If ToLowerChar(src[lx->pos]) <> CH_Le Then Exit Function
    k = lx->pos + 1
    If src[k] = CH_PLUS Or src[k] = CH_MINUS Then k = k + 1
    If IsDigit(src[k]) = false Then Exit Function
    lx->pos = LexSkipDigits(src, k)
    LexScanExp = 1
End Function

' start..fin が数字だけなら 1（小数点・指数なし）
Function LexDecIsInt(src As *Byte, start As Long, fin As Long) As Long
    Dim i As Long
    LexDecIsInt = 0
    For i = start To fin - 1
        If IsDigit(src[i]) = false Then Exit Function
    Next
    LexDecIsInt = 1
End Function

' ---------------------------------------------------
'  64bit の整数リテラル。コンパイラ自身は 32bit の算術だけで書く（stage0 は AB4.20）ので、
'  16 ビットずつ 4 つ（g_lit64(0) が最下位）に分けて積む
' ---------------------------------------------------
Const LEX_NUM_I64 = 4
' 2^63 .. 2^64-1 の十進（QWord のリテラル）
Const LEX_NUM_U64 = 8
Dim g_lit64(3) As Long

Sub LexLit64Clear()
    Dim i As Long
    For i = 0 To 3
        g_lit64(i) = 0
    Next
End Sub

' g_lit64 = g_lit64 * m + a。2^64 を超えたら 0
Function LexLit64MulAdd(m As Long, a As Long) As Long
    Dim i As Long
    Dim cur As Long
    Dim carry As Long
    carry = a
    For i = 0 To 3
        cur = g_lit64(i) * m + carry
        g_lit64(i) = cur And &HFFFF
        carry = cur >> 16
    Next
    LexLit64MulAdd = 1
    If carry <> 0 Then LexLit64MulAdd = 0
End Function

Function LexLit64Lo() As Long
    LexLit64Lo = g_lit64(0) Or (g_lit64(1) << 16)
End Function

Function LexLit64Hi() As Long
    LexLit64Hi = g_lit64(2) Or (g_lit64(3) << 16)
End Function

Function LexPushLit64(lx As *Lexer) As Long
    Dim idx As Long
    Dim toks As *Tok
    LexPushLit64 = 0
    idx = LexPush(lx, TK_NUMBER)
    If idx < 0 Then Exit Function
    toks = lx->toks
    toks[idx].num = LexLit64Lo()
    toks[idx].numHi = LexLit64Hi()
    toks[idx].wide = LEX_NUM_I64
    LexPushLit64 = 1
End Function

' 十進 start..pos を 64bit のリテラルに。9223372036854775807 までは Int64、
' 18446744073709551615 までは QWord。-actba32 やそれを超えるときは 0（Double で読む）
Function LexPushDec64(lx As *Lexer, start As Long) As Long
    Dim i As Long
    Dim toks As *Tok
    LexPushDec64 = 0
    If TyIs32() <> 0 Then Exit Function
    LexLit64Clear()
    For i = start To lx->pos - 1
        If LexLit64MulAdd(LEX_RADIX_DEC, DigitValue(lx->src[i])) = 0 Then Exit Function
    Next
    If LexPushLit64(lx) = 0 Then Exit Function
    ' 符号ビットが立つ（2^63 以上）なら Int64 に入らないので QWord
    If g_lit64(3) >= &H8000 Then
        toks = lx->toks
        toks[lx->count - 1].wide = LEX_NUM_U64
    End If
    LexPushDec64 = 1
End Function

' 整数が DWord（4294967295）に入らなければ 1。そのときは Double として読む（64bit 整数は無いので）
Function LexDecTooBig(src As *Byte, start As Long, fin As Long) As Long
    While fin - start > 1 And src[start] = CH_0
        start = start + 1
    Wend
    LexDecTooBig = 0
    If fin - start > 10 Then LexDecTooBig = 1
    If fin - start = 10 Then LexDecTooBig = LexDec10Big(src, start)
End Function

' 10 桁の十進が 4294967295 より大きければ 1
Function LexDec10Big(src As *Byte, start As Long) As Long
    Dim hi As Long
    Dim i As Long
    hi = 0
    For i = start To start + 8
        hi = hi * LEX_RADIX_DEC + DigitValue(src[i])
    Next
    LexDec10Big = 0
    If hi > 429496729 Or (hi = 429496729 And DigitValue(src[start + 9]) > 5) Then LexDec10Big = 1
End Function

' start..pos を十進整数の TK_NUMBER に（4294967295 までは 32bit のビット列）
Function LexPushInt(lx As *Lexer, start As Long) As Long
    Dim n As Long
    Dim i As Long
    Dim idx As Long
    Dim toks As *Tok
    LexPushInt = 0
    n = 0
    For i = start To lx->pos - 1
        n = n * LEX_RADIX_DEC + DigitValue(lx->src[i])
    Next
    idx = LexPush(lx, TK_NUMBER)
    If idx < 0 Then Exit Function
    toks = lx->toks
    toks[idx].num = n
    LexPushInt = 1
End Function

' start..pos のテキストを TK_FLOAT に（IEEE 化は Parser）
Function LexPushFloat(lx As *Lexer, start As Long) As Long
    Dim n As Long
    Dim i As Long
    Dim idx As Long
    Dim buf(LEX_TEXT_MAXIDX) As Byte
    LexPushFloat = 0
    n = lx->pos - start
    If n > LEX_TEXT_MAXIDX Then n = LEX_TEXT_MAXIDX
    For i = 0 To n - 1
        buf[i] = lx->src[start + i]
    Next
    idx = LexPush(lx, TK_FLOAT)
    If idx < 0 Then Exit Function
    LexStoreText(lx, idx, VarPtr(buf), n)
    LexPushFloat = 1
End Function

Function LexIdent(lx As *Lexer) As Long
    Dim src As *Byte
    Dim start As Long
    Dim n As Long
    Dim i As Long
    Dim idx As Long
    Dim buf(LEX_TEXT_MAXIDX) As Byte
    LexIdent = 0
    src = lx->src
    start = lx->pos
    While IsIdentCont(src[lx->pos])
        lx->pos = lx->pos + 1
    Wend
    If src[lx->pos] = CH_DOLLAR Then
        lx->pos = lx->pos + 1
    End If
    n = lx->pos - start
    i = 0
    While i < n And i < LEX_TEXT_MAXIDX
        buf[i] = src[start + i]
        i = i + 1
    Wend
    buf[i] = CH_NUL
    If LexEmitJoined(lx, VarPtr(buf)) <> 0 Then
        LexIdent = 1
        Exit Function
    End If
    i = LexNarrowWideInt(lx, VarPtr(buf), i)
    i = LexCharType(lx, VarPtr(buf), i)
    ' this / THIS はメソッドの隠し引数 This（変数名は大文字小文字を区別するので、ここで揃える）
    If i = 4 Then
        If lstrcmpi(VarPtr(buf), "this") = 0 Then lstrcpy(VarPtr(buf), "This")
    End If
    idx = LexPush(lx, TK_IDENT)
    If idx < 0 Then Exit Function
    LexStoreText(lx, idx, VarPtr(buf), i)
    LexMarkWide(lx, idx)
    LexIdent = 1
End Function

' QWord は DWord、Int64 は Long と読む。戻り値は新しい長さ
' 64bit 出力では語に印（Tok.num の LEX_WIDE_I64 / LEX_WIDE_U64）を付け、64bit を読める所が
' 印を使う（LEX_WIDE_USED）。使われなかった印は構文解析のあとで警告する（ParseWarnWide）。
' -actba32 はこれまでどおりここで警告する
Const LEX_WIDE_I64 = 1
Const LEX_WIDE_U64 = 2
Const LEX_WIDE_USED = 256
Dim g_lexWide As Long

Function LexNarrowWideInt(lx As *Lexer, buf As *Byte, n As Long) As Long
    LexNarrowWideInt = n
    g_lexWide = 0
    If ByteNameEqCI(buf, "qword") Then
        lstrcpy(buf, "DWord")
        g_lexWide = LEX_WIDE_U64
    ElseIf ByteNameEqCI(buf, "int64") Then
        lstrcpy(buf, "Long")
        g_lexWide = LEX_WIDE_I64
    Else
        Exit Function
    End If
    LexNarrowWideInt = lstrlen(buf)
    If TyIs32() <> 0 Then
        DiagWarn(lx->srcLine, LexWideMsg$(g_lexWide))
        g_lexWide = 0
    End If
End Function

' w は LEX_WIDE_I64 / LEX_WIDE_U64。元の型名と置き換え先の両方を出す（「QWord は DWord（32 ビット）」）
Function LexWideMsg$(w As Long) As String
    If w = LEX_WIDE_U64 Then
        LexWideMsg$ = Tr2$(1102, "64-bit integers are not supported; {0} is read as {1} (32-bit)", "QWord", "DWord")
    Else
        LexWideMsg$ = Tr2$(1102, "64-bit integers are not supported; {0} is read as {1} (32-bit)", "Int64", "Long")
    End If
End Function

Sub LexMarkWide(lx As *Lexer, idx As Long)
    Dim toks As *Tok
    If g_lexWide = 0 Then Exit Sub
    toks = lx->toks
    toks[idx].wide = g_lexWide
    g_lexWide = 0
End Sub

' 直前が As（As *Char の * は飛ばす）か SizeOf( なら 1。Char を型名として読む位置
Function LexAfterAs(lx As *Lexer) As Long
    Dim toks As *Tok
    Dim k As Long
    Dim w(SYM_NAME_LEN - 1) As Byte
    LexAfterAs = 0
    toks = lx->toks
    k = lx->count - 1
    While LexTokIs(lx, k, TK_STAR) <> 0
        k = k - 1
    Wend
    If LexTokIs(lx, k, TK_LPAREN) <> 0 Then k = k - 1
    If LexTokIs(lx, k, TK_IDENT) = 0 Then Exit Function
    LexCopyText(lx, toks[k].textSlot, VarPtr(w))
    If ByteNameEqCI(VarPtr(w), "as") Or ByteNameEqCI(VarPtr(w), "sizeof") Then LexAfterAs = 1
End Function

' k 番目の字句が kind なら 1（範囲外は 0）
Function LexTokIs(lx As *Lexer, k As Long, kind As Long) As Long
    Dim toks As *Tok
    LexTokIs = 0
    If k < 0 Or k >= lx->count Then Exit Function
    toks = lx->toks
    If toks[k].kind = kind Then LexTokIs = 1
End Function

' 型の位置の Char は Byte（ActiveBasic 4 の Char は 1 バイト）。変数名の char はそのまま
Function LexCharType(lx As *Lexer, buf As *Byte, n As Long) As Long
    LexCharType = n
    If ByteNameEqCI(buf, "char") = 0 Then Exit Function
    If LexAfterAs(lx) = 0 Then Exit Function
    lstrcpy(buf, "Byte")
    LexCharType = 4
End Function

' 文字列の字句を積む。n は全体の長さ。255 バイトを超えたものは LongStr の lid（numHi = lid + 1）
Function LexPushStrTok(lx As *Lexer, buf As *Byte, n As Long, lid As Long) As Long
    Dim idx As Long
    Dim toks As *Tok
    Dim k As Long
    LexPushStrTok = 0
    k = n
    If k > LEX_TEXT_MAXIDX Then k = LEX_TEXT_MAXIDX
    buf[k] = CH_NUL
    idx = LexPush(lx, TK_STRING)
    If idx < 0 Then Exit Function
    LexStoreText(lx, idx, buf, k)
    toks = lx->toks
    toks[idx].num = n
    toks[idx].numHi = lid + 1
    LexPushStrTok = 1
End Function

Function LexString(lx As *Lexer) As Long
    Dim src As *Byte
    Dim i As Long
    Dim idx As Long
    Dim toks As *Tok
    Dim buf(LEX_TEXT_MAXIDX) As Byte
    Dim lid As Long
    LexString = 0
    src = lx->src
    lx->pos = lx->pos + 1
    i = 0
    lid = -1
    Do
        If src[lx->pos] = CH_NUL Then
            lx->err = 1
            Exit Function
        End If
        If src[lx->pos] = CH_DQUOTE Then
            If src[lx->pos + 1] = CH_DQUOTE Then
                If Not LongStrLexPut(VarPtr(buf), i, lid, CH_DQUOTE) Then lx->err = 1
                lx->pos = lx->pos + 2
            Else
                Exit Do
            End If
        Else
            If Not LongStrLexPut(VarPtr(buf), i, lid, src[lx->pos]) Then lx->err = 1
            lx->pos = lx->pos + 1
        End If
    Loop
    lx->pos = lx->pos + 1
    LexString = LexPushStrTok(lx, VarPtr(buf), i, lid)
End Function

Function LexEscapeChar(n2 As Long) As Long
    If n2 = CH_Ln Then
        LexEscapeChar = CH_NL
    ElseIf n2 = CH_Lr Then
        LexEscapeChar = CH_CR
    ElseIf n2 = CH_Lt Then
        LexEscapeChar = CH_TAB
    ElseIf n2 = CH_0 Then
        LexEscapeChar = CH_NUL
    ElseIf n2 = CH_BSLASH Then
        LexEscapeChar = CH_BSLASH
    ElseIf n2 = CH_DQUOTE Or n2 = CH_Lq Then
        LexEscapeChar = CH_DQUOTE
    Else
        LexEscapeChar = n2
    End If
End Function

' 16 進 1 桁を読めば値（lx->pos を進める）、無ければ -1
Function LexExHex1(lx As *Lexer) As Long
    Dim src As *Byte
    src = lx->src
    LexExHex1 = HexDigitValue(src[lx->pos])
    If LexExHex1 >= 0 Then lx->pos = lx->pos + 1
End Function

' \x の後ろの 16 進 2 桁まで（AB 4.20 の \xhh）。1 桁も無ければ x そのもの
Function LexExHex(lx As *Lexer) As Long
    Dim d As Long
    LexExHex = LexExHex1(lx)
    If LexExHex < 0 Then LexExHex = CH_Lx : Exit Function
    d = LexExHex1(lx)
    If d >= 0 Then LexExHex = LexExHex * 16 + d
End Function

' \ の次の文字（lx->pos）から 1 文字を読み、lx->pos を後ろへ進める
Function LexExEscape(lx As *Lexer) As Long
    Dim src As *Byte
    src = lx->src
    LexExEscape = LexEscapeChar(src[lx->pos])
    lx->pos = lx->pos + 1
    If src[lx->pos - 1] = CH_Lx Then LexExEscape = LexExHex(lx)
End Function

Function LexExString(lx As *Lexer) As Long
    Dim src As *Byte
    Dim i As Long
    Dim idx As Long
    Dim toks As *Tok
    Dim buf(LEX_TEXT_MAXIDX) As Byte
    Dim c As Long
    Dim lid As Long
    LexExString = 0
    src = lx->src
    If src[lx->pos] <> CH_DQUOTE Then Exit Function
    lx->pos = lx->pos + 1
    i = 0
    lid = -1
    Do
        If src[lx->pos] = CH_NUL Then
            lx->err = 1
            Exit Function
        End If
        If src[lx->pos] = CH_DQUOTE Then
            Exit Do
        End If
        If src[lx->pos] = CH_BSLASH Then
            lx->pos = lx->pos + 1
            If src[lx->pos] = CH_NUL Then
                lx->err = 1
                Exit Function
            End If
            c = LexExEscape(lx)
        Else
            c = src[lx->pos]
            lx->pos = lx->pos + 1
        End If
        If Not LongStrLexPut(VarPtr(buf), i, lid, c) Then lx->err = 1
    Loop
    lx->pos = lx->pos + 1
    LexExString = LexPushStrTok(lx, VarPtr(buf), i, lid)
End Function

Function LexTryExStringAfterIdent(lx As *Lexer) As Long
    Dim src As *Byte
    Dim last As Long
    Dim toks As *Tok
    Dim texts As *Byte
    Dim off As Long
    Dim c0 As Long
    Dim c1 As Long
    LexTryExStringAfterIdent = 0
    If lx->count <= 0 Then Exit Function
    last = lx->count - 1
    toks = lx->toks
    If toks[last].kind <> TK_IDENT Then Exit Function
    texts = lx->texts
    off = toks[last].textSlot * LEX_TEXT_LEN
    c0 = ToLowerChar(texts[off])
    c1 = ToLowerChar(texts[off + 1])
    If texts[off + 2] <> CH_NUL Then Exit Function
    If c0 <> CH_Le Or c1 <> CH_Lx Then Exit Function
    src = lx->src
    While IsHSpace(src[lx->pos])
        lx->pos = lx->pos + 1
    Wend
    If src[lx->pos] <> CH_DQUOTE Then Exit Function
    lx->count = last
    LexTryExStringAfterIdent = LexExString(lx)
End Function
