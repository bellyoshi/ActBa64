' LexerLit - 数値と文字列

Function LexHexLit(lx As *Lexer) As Long
    Dim src As *Byte
    Dim n2 As Long
    Dim c As Long
    Dim n As Long
    Dim v As Long
    Dim idx As Long
    Dim toks As *Tok
    LexHexLit = 0
    src = lx->src
    n2 = src[lx->pos + 1]
    If IsHexPrefix(n2) Then
        lx->pos = lx->pos + 2
        n = 0
        Do
            c = src[lx->pos]
            v = HexDigitValue(c)
            If v < 0 Then Exit Do
            n = n * LEX_RADIX_HEX + v
            lx->pos = lx->pos + 1
        Loop
        LexSkipLongSuffix(lx)
        idx = LexPush(lx, TK_NUMBER)
        If idx < 0 Then Exit Function
        toks = lx->toks
        toks[idx].num = n
    Else
        LexPush(lx, TK_AMP)
        lx->pos = lx->pos + 1
    End If
    LexHexLit = 1
End Function

' &H1007& の末尾 &（Long の型文字）。後ろが &H や識別子なら演算子の & なので残す
Sub LexSkipLongSuffix(lx As *Lexer)
    Dim src As *Byte
    Dim nxt As Long
    src = lx->src
    If src[lx->pos] <> CH_AMP Then Exit Sub
    nxt = src[lx->pos + 1]
    If IsIdentCont(nxt) Or nxt = CH_AMP Then Exit Sub
    lx->pos = lx->pos + 1
End Sub

' 数字の後ろの . は、次が数字か、識別子の始まりでなければ小数点（1.5 / 1.+1.）
Function LexDotIsFloat(ByVal nxt As Long) As Long
    LexDotIsFloat = 1
    If IsDigit(nxt) Then Exit Function
    If IsIdentCont(nxt) Then LexDotIsFloat = 0
End Function

Function LexNumber(lx As *Lexer) As Long
    Dim src As *Byte
    Dim start As Long
    Dim n As Long
    Dim i As Long
    Dim idx As Long
    Dim toks As *Tok
    Dim buf(LEX_TEXT_MAXIDX) As Byte

    LexNumber = 0
    src = lx->src
    start = lx->pos
    n = 0
    While IsDigit(src[lx->pos])
        n = n * LEX_RADIX_DEC + DigitValue(src[lx->pos])
        lx->pos = lx->pos + 1
    Wend
    ' 1.5 / 1.12345 / 1. → TK_FLOAT（テキスト保持。IEEE 化は Parser）
    If src[lx->pos] = CH_DOT Then
        If LexDotIsFloat(src[lx->pos + 1]) Then
            lx->pos = lx->pos + 1
            While IsDigit(src[lx->pos])
                lx->pos = lx->pos + 1
            Wend
            n = lx->pos - start
            If n > LEX_TEXT_MAXIDX Then n = LEX_TEXT_MAXIDX
            i = 0
            While i < n
                buf[i] = src[start + i]
                i = i + 1
            Wend
            idx = LexPush(lx, TK_FLOAT)
            If idx < 0 Then Exit Function
            LexStoreText(lx, idx, VarPtr(buf), n)
        Else
            idx = LexPush(lx, TK_NUMBER)
            If idx < 0 Then Exit Function
            toks = lx->toks
            toks[idx].num = n
        End If
    Else
        idx = LexPush(lx, TK_NUMBER)
        If idx < 0 Then Exit Function
        toks = lx->toks
        toks[idx].num = n
    End If
    LexNumber = 1
End Function

Function LexIdent(lx As *Lexer) As Long
    Dim src As *Byte
    Dim start As Long
    Dim n As Long
    Dim i As Long
    Dim idx As Long
    Dim buf(LEX_TEXT_MAXIDX) As Byte
    LexIdent = 0
    src = lx->src
    start = lx->pos
    While IsIdentCont(src[lx->pos])
        lx->pos = lx->pos + 1
    Wend
    If src[lx->pos] = CH_DOLLAR Then
        lx->pos = lx->pos + 1
    End If
    n = lx->pos - start
    i = 0
    While i < n And i < LEX_TEXT_MAXIDX
        buf[i] = src[start + i]
        i = i + 1
    Wend
    buf[i] = CH_NUL
    If LexEmitJoined(lx, VarPtr(buf)) <> 0 Then
        LexIdent = 1
        Exit Function
    End If
    i = LexNarrowWideInt(lx, VarPtr(buf), i)
    i = LexCharType(lx, VarPtr(buf), i)
    idx = LexPush(lx, TK_IDENT)
    If idx < 0 Then Exit Function
    LexStoreText(lx, idx, VarPtr(buf), i)
    LexIdent = 1
End Function

' 64bit 整数は未対応。QWord は DWord、Int64 は Long と読み、警告を出す。戻り値は新しい長さ
Function LexNarrowWideInt(lx As *Lexer, buf As *Byte, n As Long) As Long
    Dim msg As String
    LexNarrowWideInt = n
    If ByteNameEqCI(buf, "qword") Then
        lstrcpy(buf, "DWord")
    ElseIf ByteNameEqCI(buf, "int64") Then
        lstrcpy(buf, "Long")
    Else
        Exit Function
    End If
    LexNarrowWideInt = lstrlen(buf)
    msg = "64-bit integers are not supported; " + MakeStr(buf) + " (32-bit) is used instead"
    DiagWarn(lx->srcLine, msg)
End Function

' 直前が As（As *Char の * は飛ばす）か SizeOf( なら 1。Char を型名として読む位置
Function LexAfterAs(lx As *Lexer) As Long
    Dim toks As *Tok
    Dim k As Long
    Dim w(SYM_NAME_LEN - 1) As Byte
    LexAfterAs = 0
    toks = lx->toks
    k = lx->count - 1
    While LexTokIs(lx, k, TK_STAR) <> 0
        k = k - 1
    Wend
    If LexTokIs(lx, k, TK_LPAREN) <> 0 Then k = k - 1
    If LexTokIs(lx, k, TK_IDENT) = 0 Then Exit Function
    LexCopyText(lx, toks[k].textSlot, VarPtr(w))
    If ByteNameEqCI(VarPtr(w), "as") Or ByteNameEqCI(VarPtr(w), "sizeof") Then LexAfterAs = 1
End Function

' k 番目の字句が kind なら 1（範囲外は 0）
Function LexTokIs(lx As *Lexer, k As Long, kind As Long) As Long
    Dim toks As *Tok
    LexTokIs = 0
    If k < 0 Or k >= lx->count Then Exit Function
    toks = lx->toks
    If toks[k].kind = kind Then LexTokIs = 1
End Function

' 型の位置の Char は Byte（ActiveBasic 4 の Char は 1 バイト）。変数名の char はそのまま
Function LexCharType(lx As *Lexer, buf As *Byte, n As Long) As Long
    LexCharType = n
    If ByteNameEqCI(buf, "char") = 0 Then Exit Function
    If LexAfterAs(lx) = 0 Then Exit Function
    lstrcpy(buf, "Byte")
    LexCharType = 4
End Function

Function LexString(lx As *Lexer) As Long
    Dim src As *Byte
    Dim i As Long
    Dim idx As Long
    Dim toks As *Tok
    Dim buf(LEX_TEXT_MAXIDX) As Byte
    LexString = 0
    src = lx->src
    lx->pos = lx->pos + 1
    i = 0
    Do
        If src[lx->pos] = CH_NUL Then
            lx->err = 1
            Exit Function
        End If
        If src[lx->pos] = CH_DQUOTE Then
            If src[lx->pos + 1] = CH_DQUOTE Then
                If i < LEX_TEXT_MAXIDX Then
                    buf[i] = CH_DQUOTE
                    i = i + 1
                End If
                lx->pos = lx->pos + 2
            Else
                Exit Do
            End If
        Else
            If i < LEX_TEXT_MAXIDX Then
                buf[i] = src[lx->pos]
                i = i + 1
            End If
            lx->pos = lx->pos + 1
        End If
    Loop
    buf[i] = CH_NUL
    lx->pos = lx->pos + 1
    idx = LexPush(lx, TK_STRING)
    If idx < 0 Then Exit Function
    LexStoreText(lx, idx, VarPtr(buf), i)
    toks = lx->toks
    toks[idx].num = i
    LexString = 1
End Function

Function LexEscapeChar(n2 As Long) As Long
    If n2 = CH_Ln Then
        LexEscapeChar = CH_NL
    ElseIf n2 = CH_Lr Then
        LexEscapeChar = CH_CR
    ElseIf n2 = CH_Lt Then
        LexEscapeChar = CH_TAB
    ElseIf n2 = CH_0 Then
        LexEscapeChar = CH_NUL
    ElseIf n2 = CH_BSLASH Then
        LexEscapeChar = CH_BSLASH
    ElseIf n2 = CH_DQUOTE Then
        LexEscapeChar = CH_DQUOTE
    Else
        LexEscapeChar = n2
    End If
End Function

Function LexExString(lx As *Lexer) As Long
    Dim src As *Byte
    Dim i As Long
    Dim idx As Long
    Dim toks As *Tok
    Dim buf(LEX_TEXT_MAXIDX) As Byte
    Dim c As Long
    LexExString = 0
    src = lx->src
    If src[lx->pos] <> CH_DQUOTE Then Exit Function
    lx->pos = lx->pos + 1
    i = 0
    Do
        If src[lx->pos] = CH_NUL Then
            lx->err = 1
            Exit Function
        End If
        If src[lx->pos] = CH_DQUOTE Then
            Exit Do
        End If
        If src[lx->pos] = CH_BSLASH Then
            lx->pos = lx->pos + 1
            If src[lx->pos] = CH_NUL Then
                lx->err = 1
                Exit Function
            End If
            c = LexEscapeChar(src[lx->pos])
            lx->pos = lx->pos + 1
        Else
            c = src[lx->pos]
            lx->pos = lx->pos + 1
        End If
        If i < LEX_TEXT_MAXIDX Then
            buf[i] = c As Byte
            i = i + 1
        End If
    Loop
    buf[i] = CH_NUL
    lx->pos = lx->pos + 1
    idx = LexPush(lx, TK_STRING)
    If idx < 0 Then Exit Function
    LexStoreText(lx, idx, VarPtr(buf), i)
    toks = lx->toks
    toks[idx].num = i
    LexExString = 1
End Function

Function LexTryExStringAfterIdent(lx As *Lexer) As Long
    Dim src As *Byte
    Dim last As Long
    Dim toks As *Tok
    Dim texts As *Byte
    Dim off As Long
    Dim c0 As Long
    Dim c1 As Long
    LexTryExStringAfterIdent = 0
    If lx->count <= 0 Then Exit Function
    last = lx->count - 1
    toks = lx->toks
    If toks[last].kind <> TK_IDENT Then Exit Function
    texts = lx->texts
    off = toks[last].textSlot * LEX_TEXT_LEN
    c0 = ToLowerChar(texts[off])
    c1 = ToLowerChar(texts[off + 1])
    If texts[off + 2] <> CH_NUL Then Exit Function
    If c0 <> CH_Le Or c1 <> CH_Lx Then Exit Function
    src = lx->src
    While IsHSpace(src[lx->pos])
        lx->pos = lx->pos + 1
    Wend
    If src[lx->pos] <> CH_DQUOTE Then Exit Function
    lx->count = last
    LexTryExStringAfterIdent = LexExString(lx)
End Function
