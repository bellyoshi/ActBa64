#console
Declare Function ExitProcess Lib "kernel32.dll" (uExitCode As Long) As Long
Sub Copy3(dst As *Byte, src As *Byte, off As Long)
    dst[0] = (src + off)[0]
    dst[1] = (src + off)[1]
    dst[2] = (src + off)[2]
End Sub
Sub Main()
    Dim buf(15) As Byte
    Dim out(3) As Byte
    Dim i As Long
    i = 0
    While i < 16
        buf[i] = 48 + i
        i = i + 1
    Wend
    Copy3(VarPtr(out), VarPtr(buf), 4)
    If out[0] <> 52 Then ExitProcess(10)
    If out[1] <> 53 Then ExitProcess(11)
    If out[2] <> 54 Then ExitProcess(12)
    ExitProcess(42)
End Sub
Main()
End
