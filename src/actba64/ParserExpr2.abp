' --- split from ParserExpr.abp (part 2) ---
Function ParseFactorIdentIndex(p As *Parser, name As *Byte) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim n As Long
    Dim e As Long
    Dim arg0 As Long

    ParseFactorIdentIndex = -1
    ast = p->ast
    p->pos = p->pos + 1
    e = ParseExpr(p)
    If e < 0 Then Exit Function
    If ParseExpect(p, TK_RBRACK) = 0 Then Exit Function
    arg0 = AstAddNode(ast, AST_VAR)
    If arg0 < 0 Then Exit Function
    AstSetStr(ast, arg0, name)
    n = AstAddNode(ast, AST_INDEX)
    If n < 0 Then Exit Function
    nodes = ast->nodes
    nodes[n].left = arg0
    nodes[n].right = e
    nodes[n].num = 1
    ParseFactorIdentIndex = ParsePostfixMemIdx(p, n)
End Function

Function ParseFactorIdentCall(p As *Parser, name As *Byte) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim n As Long
    Dim arg0 As Long
    Dim nArgs As Long

    ParseFactorIdentCall = -1
    ast = p->ast
    p->pos = p->pos + 1
    If ParseArgList(p, arg0, nArgs) = 0 Then Exit Function
    n = AstAddNode(ast, AST_CALL)
    If n < 0 Then Exit Function
    AstSetStr(ast, n, name)
    nodes = ast->nodes
    nodes[n].left = arg0
    nodes[n].right = -1
    nodes[n].extra = -1
    nodes[n].num = nArgs
    ParseFactorIdentCall = n
End Function

Function ParseFactorIdent(p As *Parser) As Long
    Dim n As Long
    Dim name(63) As Byte
    Dim bi As Long
    Dim idLine As Long

    ParseFactorIdent = -1
    bi = ParseFactorBuiltinA(p)
    If bi = 0 Then bi = ParseFactorBuiltinB(p)
    If bi = BI_SIZEOF Then
        ParseFactorIdent = ParseFactorSizeof(p)
        Exit Function
    End If
    If bi = BI_ADDRESSOF Then
        ParseFactorIdent = ParseFactorAddressOf(p)
        Exit Function
    End If
    If bi = BI_VARPTR Then
        ParseFactorIdent = ParseFactorVarPtr(p)
        Exit Function
    End If
    If bi <> 0 Then
        ParseFactorIdent = ParseFactorBuiltinCall(p, bi)
        Exit Function
    End If
    idLine = ParseTokLine(p)
    If ParseCopyIdent(p, VarPtr(name)) = 0 Then Exit Function
    If ParseTokKind(p) = TK_LBRACK Then
        n = ParseFactorIdentIndex(p, VarPtr(name))
        If n >= 0 Then AstSetSrcLine(p->ast, n, idLine)
        ParseFactorIdent = n
        Exit Function
    End If
    If ParseTokKind(p) = TK_LPAREN Then
        n = ParseFactorIdentCall(p, VarPtr(name))
        If n >= 0 Then AstSetSrcLine(p->ast, n, idLine)
        ParseFactorIdent = n
        Exit Function
    End If
    n = ParseClassIdentExpr(p, VarPtr(name))
    If n < 0 Then Exit Function
    AstSetSrcLine(p->ast, n, idLine)
    n = ParsePostfixMemIdx(p, n)
    If n < 0 Then Exit Function
    ParseFactorIdent = ParseMemberCall(p, n)
End Function

' ---- expressions ----

Function ParseFactor(p As *Parser) As Long
    ParseFactor = -1
    If ParseTokKind(p) = TK_NUMBER Then
        ParseFactor = ParseFactorNum(p)
        Exit Function
    End If
    If ParseTokKind(p) = TK_FLOAT Then
        ParseFactor = ParseFactorFloat(p)
        Exit Function
    End If
    If ParseTokKind(p) = TK_STRING Then
        ParseFactor = ParseFactorString(p)
        Exit Function
    End If
    If ParseTokKind(p) = TK_LPAREN Then
        ParseFactor = ParseFactorParen(p)
        Exit Function
    End If
    If ParseTokKind(p) = TK_DOT Then
        If p->withBase < 0 Then
            p->err = 1
            Exit Function
        End If
        ParseFactor = ParseWithLval(p)
        Exit Function
    End If
    If ParseTokKind(p) = TK_IDENT Then
        ParseFactor = ParseFactorIdent(p)
        Exit Function
    End If
    p->err = 1
End Function

' ^ は単項 - より高優先（-2^2 = -(2^2)）。右結合。As は primary 直後
Function ParsePower(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim left As Long
    Dim right As Long
    Dim n As Long

    ParsePower = -1
    left = ParseFactor(p)
    If left < 0 Then Exit Function
    If ParseTokKind(p) <> TK_CARET Then
        ParsePower = left
        Exit Function
    End If
    p->pos = p->pos + 1
    right = ParsePower(p)
    If right < 0 Then Exit Function
    ast = p->ast
    n = AstAddNode(ast, AST_BINOP)
    If n < 0 Then Exit Function
    nodes = ast->nodes
    nodes[n].num = BOP_POW
    nodes[n].left = left
    nodes[n].right = right
    ParsePower = n
End Function

Function ParseUnary(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim e As Long
    Dim n As Long
    Dim bits As Long

    ParseUnary = -1
    If ParseTokKind(p) = TK_MINUS Then
        ' -1.5 → IEEE Double ビット（符号付き）
        If ParseTokKindAt(p, p->pos + 1) = TK_FLOAT Then
            p->pos = p->pos + 1
            n = ParseMakeFloatAst(p, 1)
            If n < 0 Then Exit Function
            p->pos = p->pos + 1
            ParseUnary = n
            Exit Function
        End If
        p->pos = p->pos + 1
        e = ParseUnary(p)
        If e < 0 Then Exit Function
        ast = p->ast
        n = AstAddNode(ast, AST_UNARY)
        If n < 0 Then Exit Function
        nodes = ast->nodes
        nodes[n].num = UOP_NEG
        nodes[n].left = e
        ParseUnary = n
        Exit Function
    End If
    ParseUnary = ParsePower(p)
End Function

Function ParseTerm(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim left As Long
    Dim right As Long
    Dim n As Long
    Dim op As Long
    Dim kMod(7) As Byte

    ParseTerm = -1
    left = ParseUnary(p)
    If left < 0 Then Exit Function
    lstrcpy(VarPtr(kMod), "mod")
    ast = p->ast
    Do
        If ParseTokKind(p) = TK_STAR Then
            op = BOP_MUL
        ElseIf ParseTokKind(p) = TK_SLASH Then
            op = BOP_DIV
        ElseIf ParseTokKind(p) = TK_BACKSLASH Then
            op = BOP_IDIV
        ElseIf ParseIdentIs(p, VarPtr(kMod)) <> 0 Then
            op = BOP_MOD
        Else
            Exit Do
        End If
        p->pos = p->pos + 1
        right = ParseUnary(p)
        If right < 0 Then Exit Function
        n = AstAddNode(ast, AST_BINOP)
        If n < 0 Then Exit Function
        nodes = ast->nodes
        nodes[n].num = op
        nodes[n].left = left
        nodes[n].right = right
        left = n
    Loop
    ParseTerm = left
End Function

Function ParseAddExpr(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim left As Long
    Dim right As Long
    Dim n As Long
    Dim op As Long

    ParseAddExpr = -1
    left = ParseTerm(p)
    If left < 0 Then Exit Function
    ast = p->ast
    Do
        If ParseTokKind(p) = TK_PLUS Then
            op = BOP_ADD
        ElseIf ParseTokKind(p) = TK_MINUS Then
            op = BOP_SUB
        ElseIf ParseTokKind(p) = TK_AMP Then
            op = BOP_CAT
        Else
            Exit Do
        End If
        p->pos = p->pos + 1
        right = ParseTerm(p)
        If right < 0 Then Exit Function
        n = AstAddNode(ast, AST_BINOP)
        If n < 0 Then Exit Function
        nodes = ast->nodes
        nodes[n].num = op
        nodes[n].left = left
        nodes[n].right = right
        left = n
    Loop
    ParseAddExpr = left
End Function

Function ParseShiftExpr(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim left As Long
    Dim right As Long
    Dim n As Long
    Dim op As Long

    ParseShiftExpr = -1
    left = ParseAddExpr(p)
    If left < 0 Then Exit Function
    ast = p->ast
    Do
        If ParseTokKind(p) = TK_SHL Then
            op = BOP_SHL
        ElseIf ParseTokKind(p) = TK_SHR Then
            op = BOP_SHR
        Else
            Exit Do
        End If
        p->pos = p->pos + 1
        right = ParseAddExpr(p)
        If right < 0 Then Exit Function
        n = AstAddNode(ast, AST_BINOP)
        If n < 0 Then Exit Function
        nodes = ast->nodes
        nodes[n].num = op
        nodes[n].left = left
        nodes[n].right = right
        left = n
    Loop
    ParseShiftExpr = left
End Function

Function ParseRelExpr(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim left As Long
    Dim right As Long
    Dim n As Long
    Dim op As Long

    ParseRelExpr = -1
    left = ParseShiftExpr(p)
    If left < 0 Then Exit Function
    op = ParseCmpOp(p)
    If op = 0 Then
        ParseRelExpr = left
        Exit Function
    End If
    p->pos = p->pos + 1
    right = ParseShiftExpr(p)
    If right < 0 Then Exit Function
    ast = p->ast
    n = AstAddNode(ast, AST_BINOP)
    If n < 0 Then Exit Function
    nodes = ast->nodes
    nodes[n].num = op
    nodes[n].left = left
    nodes[n].right = right
    ParseRelExpr = n
End Function

Function ParseNotExpr(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim e As Long
    Dim n As Long
    Dim kNot(7) As Byte

    ParseNotExpr = -1
    lstrcpy(VarPtr(kNot), "not")
    If ParseIdentIs(p, VarPtr(kNot)) <> 0 Then
        p->pos = p->pos + 1
        e = ParseNotExpr(p)
        If e < 0 Then Exit Function
        ast = p->ast
        n = AstAddNode(ast, AST_UNARY)
        If n < 0 Then Exit Function
        nodes = ast->nodes
        nodes[n].num = UOP_NOT
        nodes[n].left = e
        ParseNotExpr = n
        Exit Function
    End If
    ParseNotExpr = ParseRelExpr(p)
End Function

Function ParseAndExpr(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim left As Long
    Dim right As Long
    Dim n As Long
    Dim kAnd(7) As Byte

    ParseAndExpr = -1
    left = ParseNotExpr(p)
    If left < 0 Then Exit Function
    lstrcpy(VarPtr(kAnd), "and")
    ast = p->ast
    While ParseIdentIs(p, VarPtr(kAnd)) <> 0
        p->pos = p->pos + 1
        right = ParseNotExpr(p)
        If right < 0 Then Exit Function
        n = AstAddNode(ast, AST_BINOP)
        If n < 0 Then Exit Function
        nodes = ast->nodes
        nodes[n].num = BOP_AND
        nodes[n].left = left
        nodes[n].right = right
        left = n
    Wend
    ParseAndExpr = left
End Function
