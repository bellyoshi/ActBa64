'エラトステネスのふるいで素数を求める
'#console '#consoleは省略可能
const N = 100
const true = -1
const false = 0

Dim isPrime[N] As Long

Sub Sieve()
	Dim i As Long
	Dim j As Long

	'仮に2以降を全て素数にしておく。
	isPrime[0] = false
	isPrime[1] = false
	For i = 2 to N
		isPrime[i] = true
	Next

	'ループの最大値をもとめる
	Dim s As Long
	s = Sqr(N)'√N

	'ふるい
	for i = 2 To s
		If isPrime[i] Then
			j = 2
		    While i * j <= N
		     isPrime[i * j] = false
		     j+=1
		    Wend
		End If
	Next
End Sub

Sub Output()
	Dim i As Long
	For i = 0 To N
		If (isPrime[i] = true) Then
			Print i
		End If
	Next
End Sub

Sieve()
Output()


	