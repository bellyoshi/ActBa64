' ===================================================
'  ParserStmtIO - stmt lists / Print / File IO
' ===================================================

Function ParseStmtListUntil(p As *Parser, stop1 As *Byte, stop2 As *Byte) As Long
    Dim nFirst As Long
    Dim nPrev As Long
    Dim nStmt As Long
    Dim ast As *Ast
    Dim nodes As *AstNode

    ParseStmtListUntil = -1
    ast = p->ast
    nFirst = -1
    nPrev = -1

    While ParseTokKind(p) <> TK_EOF
        ParseSkipColons(p)
        If ParseTokKind(p) = TK_EOF Then Exit While
        If ParseIdentIs(p, stop1) <> 0 Then
            ParseStmtListUntil = nFirst
            Exit Function
        End If
        If stop2[0] <> 0 Then
            If ParseIdentIs(p, stop2) <> 0 Then
                ParseStmtListUntil = nFirst
                Exit Function
            End If
        End If
        nStmt = ParseStmt(p)
        If nStmt < 0 Or p->err <> 0 Then Exit Function
        If nFirst < 0 Then
            nFirst = nStmt
        Else
            nodes = ast->nodes
            nodes[nPrev].nxt = nStmt
        End If
        nPrev = nStmt
        nodes = ast->nodes
        While nodes[nPrev].nxt >= 0
            nPrev = nodes[nPrev].nxt
        Wend
    Wend
    ParseStmtListUntil = nFirst
End Function

Function ParseStmtListUntil3(p As *Parser, stop1 As *Byte, stop2 As *Byte, stop3 As *Byte) As Long
    Dim nFirst As Long
    Dim nPrev As Long
    Dim nStmt As Long
    Dim ast As *Ast
    Dim nodes As *AstNode

    ParseStmtListUntil3 = -1
    ast = p->ast
    nFirst = -1
    nPrev = -1

    While ParseTokKind(p) <> TK_EOF
        ParseSkipColons(p)
        If ParseTokKind(p) = TK_EOF Then Exit While
        If ParseIdentIs(p, stop1) <> 0 Then
            ParseStmtListUntil3 = nFirst
            Exit Function
        End If
        If stop2[0] <> 0 Then
            If ParseIdentIs(p, stop2) <> 0 Then
                ParseStmtListUntil3 = nFirst
                Exit Function
            End If
        End If
        If stop3[0] <> 0 Then
            If ParseIdentIs(p, stop3) <> 0 Then
                ParseStmtListUntil3 = nFirst
                Exit Function
            End If
        End If
        nStmt = ParseStmt(p)
        If nStmt < 0 Or p->err <> 0 Then Exit Function
        If nFirst < 0 Then
            nFirst = nStmt
        Else
            nodes = ast->nodes
            nodes[nPrev].nxt = nStmt
        End If
        nPrev = nStmt
        nodes = ast->nodes
        While nodes[nPrev].nxt >= 0
            nPrev = nodes[nPrev].nxt
        Wend
    Wend
    ParseStmtListUntil3 = nFirst
End Function

Function ParsePrintStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nPrint As Long
    Dim stay As Long
    Dim e As Long

    ParsePrintStmt = -1
    p->pos = p->pos + 1
    If ParseTokKind(p) = TK_LPAREN Then
        p->pos = p->pos + 1
        e = ParseExpr(p)
        If e < 0 Then Exit Function
        If ParseExpect(p, TK_RPAREN) = 0 Then Exit Function
    Else
        e = ParseExpr(p)
        If e < 0 Then Exit Function
    End If
    If ParseTokKind(p) = TK_SEMI Then
        p->pos = p->pos + 1
        stay = 1
    Else
        stay = 0
    End If

    ast = p->ast
    nPrint = AstAddNode(ast, AST_PRINT)
    If nPrint < 0 Then Exit Function
    nodes = ast->nodes
    nodes[nPrint].left = e
    nodes[nPrint].num = stay
    ParsePrintStmt = nPrint
End Function

' Input var ― stdin から1行読み取り、文字列または数値変数へ代入
' Input #n, var[, ...] ― ファイルからフィールド読み取り
Function ParseInputStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nInput As Long
    Dim nVar As Long
    Dim nFile As Long
    Dim nFirst As Long
    Dim nPrev As Long
    Dim name(63) As Byte

    ParseInputStmt = -1
    p->pos = p->pos + 1
    If ParseTokKind(p) = TK_HASH Then
        p->pos = p->pos + 1
        nFile = ParseExpr(p)
        If nFile < 0 Then Exit Function
        If ParseExpect(p, TK_COMMA) = 0 Then Exit Function
        nFirst = -1
        nPrev = -1
        Do
            If ParseCopyIdent(p, VarPtr(name)) = 0 Then Exit Function
            ast = p->ast
            nVar = AstAddNode(ast, AST_VAR)
            If nVar < 0 Then Exit Function
            AstSetStr(ast, nVar, VarPtr(name))
            If nFirst < 0 Then
                nFirst = nVar
            Else
                nodes = ast->nodes
                nodes[nPrev].nxt = nVar
            End If
            nPrev = nVar
            If ParseTokKind(p) <> TK_COMMA Then Exit Do
            p->pos = p->pos + 1
        Loop
        nInput = AstAddNode(ast, AST_FINPUT)
        If nInput < 0 Then Exit Function
        nodes = ast->nodes
        nodes[nInput].left = nFile
        nodes[nInput].right = nFirst
        ParseInputStmt = nInput
        Exit Function
    End If
    If ParseCopyIdent(p, VarPtr(name)) = 0 Then Exit Function
    ast = p->ast
    nVar = AstAddNode(ast, AST_VAR)
    If nVar < 0 Then Exit Function
    AstSetStr(ast, nVar, VarPtr(name))
    nInput = AstAddNode(ast, AST_INPUT)
    If nInput < 0 Then Exit Function
    nodes = ast->nodes
    nodes[nInput].left = nVar
    ParseInputStmt = nInput
End Function

' Open path [For Input|Output|Append] As [#]num
Function ParseOpenStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nOpen As Long
    Dim path As Long
    Dim num As Long
    Dim mode As Long
    Dim k(15) As Byte

    ParseOpenStmt = -1
    p->pos = p->pos + 1
    ' path のあと As が続くため As キャストを含めない
    path = ParseExprNoAs(p)
    If path < 0 Then Exit Function
    mode = OPEN_MODE_ALL
    lstrcpy(VarPtr(k), "for")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p->pos = p->pos + 1
        lstrcpy(VarPtr(k), "input")
        If ParseIdentIs(p, VarPtr(k)) <> 0 Then
            p->pos = p->pos + 1
            mode = OPEN_MODE_INPUT
        Else
            lstrcpy(VarPtr(k), "output")
            If ParseIdentIs(p, VarPtr(k)) <> 0 Then
                p->pos = p->pos + 1
                mode = OPEN_MODE_OUTPUT
            Else
                lstrcpy(VarPtr(k), "append")
                If ParseIdentIs(p, VarPtr(k)) <> 0 Then
                    p->pos = p->pos + 1
                    mode = OPEN_MODE_APPEND
                Else
                    p->err = 1
                    Exit Function
                End If
            End If
        End If
    End If
    lstrcpy(VarPtr(k), "as")
    If ParseIdentIs(p, VarPtr(k)) = 0 Then
        p->err = 1
        Exit Function
    End If
    p->pos = p->pos + 1
    If ParseTokKind(p) = TK_HASH Then
        p->pos = p->pos + 1
    End If
    num = ParseExpr(p)
    If num < 0 Then Exit Function
    ast = p->ast
    nOpen = AstAddNode(ast, AST_OPEN)
    If nOpen < 0 Then Exit Function
    nodes = ast->nodes
    nodes[nOpen].left = path
    nodes[nOpen].right = num
    nodes[nOpen].num = mode
    ParseOpenStmt = nOpen
End Function

' Close [[#]num] ― 省略時は全クローズ（left = -1）
Function ParseCloseStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nClose As Long
    Dim num As Long

    ParseCloseStmt = -1
    p->pos = p->pos + 1
    num = -1
    If ParseTokKind(p) = TK_HASH Then
        p->pos = p->pos + 1
        num = ParseExpr(p)
        If num < 0 Then Exit Function
    ElseIf ParseTokKind(p) = TK_NUMBER Or ParseTokKind(p) = TK_IDENT Or ParseTokKind(p) = TK_LPAREN Then
        num = ParseExpr(p)
        If num < 0 Then Exit Function
    End If
    ast = p->ast
    nClose = AstAddNode(ast, AST_CLOSE)
    If nClose < 0 Then Exit Function
    nodes = ast->nodes
    nodes[nClose].left = num
    ParseCloseStmt = nClose
End Function

' Field #num, fieldLen
Function ParseFieldStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nField As Long
    Dim nFile As Long
    Dim nLen As Long

    ParseFieldStmt = -1
    p->pos = p->pos + 1
    If ParseExpect(p, TK_HASH) = 0 Then Exit Function
    nFile = ParseExpr(p)
    If nFile < 0 Then Exit Function
    If ParseExpect(p, TK_COMMA) = 0 Then Exit Function
    nLen = ParseExpr(p)
    If nLen < 0 Then Exit Function
    ast = p->ast
    nField = AstAddNode(ast, AST_FIELD)
    If nField < 0 Then Exit Function
    nodes = ast->nodes
    nodes[nField].left = nFile
    nodes[nField].right = nLen
    ParseFieldStmt = nField
End Function

' Get #num, rec, var
Function ParseGetStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nGet As Long
    Dim nFile As Long
    Dim nRec As Long
    Dim nVar As Long
    Dim name(63) As Byte

    ParseGetStmt = -1
    p->pos = p->pos + 1
    If ParseExpect(p, TK_HASH) = 0 Then Exit Function
    nFile = ParseExpr(p)
    If nFile < 0 Then Exit Function
    If ParseExpect(p, TK_COMMA) = 0 Then Exit Function
    nRec = ParseExpr(p)
    If nRec < 0 Then Exit Function
    If ParseExpect(p, TK_COMMA) = 0 Then Exit Function
    If ParseCopyIdent(p, VarPtr(name)) = 0 Then Exit Function
    ast = p->ast
    nVar = AstAddNode(ast, AST_VAR)
    If nVar < 0 Then Exit Function
    AstSetStr(ast, nVar, VarPtr(name))
    nGet = AstAddNode(ast, AST_GET)
    If nGet < 0 Then Exit Function
    nodes = ast->nodes
    nodes[nGet].left = nFile
    nodes[nGet].right = nRec
    nodes[nGet].extra = nVar
    ParseGetStmt = nGet
End Function

' Put #num, rec, expr
Function ParsePutStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nPut As Long
    Dim nFile As Long
    Dim nRec As Long
    Dim nData As Long

    ParsePutStmt = -1
    p->pos = p->pos + 1
    If ParseExpect(p, TK_HASH) = 0 Then Exit Function
    nFile = ParseExpr(p)
    If nFile < 0 Then Exit Function
    If ParseExpect(p, TK_COMMA) = 0 Then Exit Function
    nRec = ParseExpr(p)
    If nRec < 0 Then Exit Function
    If ParseExpect(p, TK_COMMA) = 0 Then Exit Function
    nData = ParseExpr(p)
    If nData < 0 Then Exit Function
    ast = p->ast
    nPut = AstAddNode(ast, AST_PUT)
    If nPut < 0 Then Exit Function
    nodes = ast->nodes
    nodes[nPut].left = nFile
    nodes[nPut].right = nRec
    nodes[nPut].extra = nData
    ParsePutStmt = nPut
End Function

' Write [#num,] [expr [, expr ...]] [;]
Function ParseWriteStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nWrite As Long
    Dim nFile As Long
    Dim nArg As Long
    Dim nFirst As Long
    Dim nPrev As Long
    Dim e As Long
    Dim stay As Long

    ParseWriteStmt = -1
    p->pos = p->pos + 1
    nFile = -1
    nFirst = -1
    nPrev = -1
    stay = 0
    If ParseTokKind(p) = TK_HASH Then
        p->pos = p->pos + 1
        nFile = ParseExpr(p)
        If nFile < 0 Then Exit Function
        If ParseTokKind(p) = TK_COMMA Then
            p->pos = p->pos + 1
        End If
    End If
    ' optional data list
    If ParseTokKind(p) <> TK_SEMI Then
        If ParseTokKind(p) = TK_NUMBER Or ParseTokKind(p) = TK_FLOAT Or ParseTokKind(p) = TK_STRING Or ParseTokKind(p) = TK_IDENT Or ParseTokKind(p) = TK_LPAREN Or ParseTokKind(p) = TK_MINUS Or ParseTokKind(p) = TK_PLUS Then
            Do
                e = ParseExpr(p)
                If e < 0 Then Exit Function
                ast = p->ast
                nArg = AstAddNode(ast, AST_ARG)
                If nArg < 0 Then Exit Function
                nodes = ast->nodes
                nodes[nArg].left = e
                If nFirst < 0 Then
                    nFirst = nArg
                Else
                    nodes[nPrev].nxt = nArg
                End If
                nPrev = nArg
                If ParseTokKind(p) <> TK_COMMA Then Exit Do
                p->pos = p->pos + 1
            Loop
        End If
    End If
    If ParseTokKind(p) = TK_SEMI Then
        p->pos = p->pos + 1
        stay = 1
    End If
    ast = p->ast
    nWrite = AstAddNode(ast, AST_WRITE)
    If nWrite < 0 Then Exit Function
    nodes = ast->nodes
    nodes[nWrite].left = nFile
    nodes[nWrite].right = nFirst
    nodes[nWrite].num = stay
    ParseWriteStmt = nWrite
End Function

Function ParseExitStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nExit As Long
    Dim e As Long

    ParseExitStmt = -1
    p->pos = p->pos + 1
    If ParseExpect(p, TK_LPAREN) = 0 Then Exit Function
    e = ParseExpr(p)
    If e < 0 Then Exit Function
    If ParseExpect(p, TK_RPAREN) = 0 Then Exit Function
    ast = p->ast
    nExit = AstAddNode(ast, AST_EXIT)
    If nExit < 0 Then Exit Function
    nodes = ast->nodes
    nodes[nExit].left = e
    ParseExitStmt = nExit
End Function

Function ParseEndStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nEnd As Long
    Dim nCall As Long
    Dim kType(7) As Byte
    Dim name(15) As Byte

    ParseEndStmt = -1
    p->pos = p->pos + 1
    lstrcpy(VarPtr(kType), "type")
    If ParseIdentIs(p, VarPtr(kType)) <> 0 Then
        p->err = 1
        Exit Function
    End If
    ast = p->ast
    If p->n88Mode <> 0 Then
        ' End → N88_End()（窓を表示して閉じるまで待つ）
        lstrcpy(VarPtr(name), "N88_End")
        nCall = AstAddNode(ast, AST_CALL)
        If nCall < 0 Then Exit Function
        AstSetStr(ast, nCall, VarPtr(name))
        nodes = ast->nodes
        nodes[nCall].left = -1
        nodes[nCall].right = -1
        nodes[nCall].num = 0
        ParseEndStmt = nCall
        Exit Function
    End If
    nEnd = AstAddNode(ast, AST_END)
    If nEnd < 0 Then Exit Function
    ParseEndStmt = nEnd
End Function

' 引数ノードを1つ追加してリスト末尾へつなぐ
Function ParseLinkArg(ast As *Ast, ByRef arg0 As Long, ByRef nPrev As Long, ByRef nArgs As Long, e As Long) As Long
    Dim nodes As *AstNode
    Dim arg1 As Long
    ParseLinkArg = 0
    arg1 = AstAddNode(ast, AST_ARG)
    If arg1 < 0 Then Exit Function
    nodes = ast->nodes
    nodes[arg1].left = e
    nodes[arg1].nxt = -1
    If arg0 < 0 Then
        arg0 = arg1
    Else
        nodes[nPrev].nxt = arg1
    End If
    nPrev = arg1
    nArgs = nArgs + 1
    ParseLinkArg = 1
End Function

Function ParseMakeNum(ast As *Ast, v As Long) As Long
    Dim nodes As *AstNode
    Dim n As Long
    ParseMakeNum = -1
    n = AstAddNode(ast, AST_NUM)
    If n < 0 Then Exit Function
    nodes = ast->nodes
    nodes[n].num = v
    ParseMakeNum = n
End Function

' 千分率 (value*1000) → IEEE754 Single ビット列（D3D 等の Single 代入用）
Function FloatBitsFromMilli(milli As Long) As Long
    Dim sign As Long
    Dim num As Long
    Dim uexp As Long
    Dim man As Long
    Dim biased As Long

    FloatBitsFromMilli = 0
    If milli = 0 Then Exit Function
    sign = 0
    If milli < 0 Then
        sign = 1
        milli = 0 - milli
    End If
    num = milli
    uexp = 0
    While num < 1000
        num = num * 2
        uexp = uexp - 1
        If uexp < -140 Then Exit Function
    Wend
    While num >= 2000
        num = num / 2
        uexp = uexp + 1
        If uexp > 140 Then Exit Function
    Wend
    man = (num - 1000) * 8388 + ((num - 1000) * 608) / 1000
    biased = uexp + 127
    If biased <= 0 Then Exit Function
    If biased >= 255 Then Exit Function
    FloatBitsFromMilli = (sign * &H80000000) Or (biased * 8388608) Or man
End Function

' B / BF → mode 1 / 2。該当しなければ 0
