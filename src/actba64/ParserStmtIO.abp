' ===================================================
'  ParserStmtIO - stmt lists / Print / File IO
' ===================================================

' Print 項目の直後。1 は ;（空白1文字）、2 は ,（タブ）
Const PRINT_SEP_SEMI = 1
Const PRINT_SEP_COMMA = 2

Function ParseStmtListUntil(p As *Parser, stop1 As *Byte, stop2 As *Byte) As Long
    Dim nFirst As Long
    Dim nPrev As Long
    Dim nStmt As Long
    Dim ast As *Ast
    Dim nodes As *AstNode

    ParseStmtListUntil = -1
    ast = p->ast
    nFirst = -1
    nPrev = -1

    While ParseTokKind(p) <> TK_EOF
        ParseSkipColons(p)
        If ParseTokKind(p) = TK_EOF Then Exit While
        If ParseIdentIs(p, stop1) <> 0 Then
            ParseStmtListUntil = nFirst
            Exit Function
        End If
        If stop2[0] <> 0 Then
            If ParseIdentIs(p, stop2) <> 0 Then
                ParseStmtListUntil = nFirst
                Exit Function
            End If
        End If
        nStmt = ParseStmt(p)
        If nStmt < 0 Or p->err <> 0 Then Exit Function
        If nFirst < 0 Then
            nFirst = nStmt
        Else
            nodes = ast->nodes
            nodes[nPrev].nxt = nStmt
        End If
        nPrev = nStmt
        nodes = ast->nodes
        While nodes[nPrev].nxt >= 0
            nPrev = nodes[nPrev].nxt
        Wend
    Wend
    ParseStmtListUntil = nFirst
End Function

Function ParseStmtListUntil3(p As *Parser, stop1 As *Byte, stop2 As *Byte, stop3 As *Byte) As Long
    Dim nFirst As Long
    Dim nPrev As Long
    Dim nStmt As Long
    Dim ast As *Ast
    Dim nodes As *AstNode

    ParseStmtListUntil3 = -1
    ast = p->ast
    nFirst = -1
    nPrev = -1

    While ParseTokKind(p) <> TK_EOF
        ParseSkipColons(p)
        If ParseTokKind(p) = TK_EOF Then Exit While
        If ParseIdentIs(p, stop1) <> 0 Then
            ParseStmtListUntil3 = nFirst
            Exit Function
        End If
        If stop2[0] <> 0 Then
            If ParseIdentIs(p, stop2) <> 0 Then
                ParseStmtListUntil3 = nFirst
                Exit Function
            End If
        End If
        If stop3[0] <> 0 Then
            If ParseIdentIs(p, stop3) <> 0 Then
                ParseStmtListUntil3 = nFirst
                Exit Function
            End If
        End If
        nStmt = ParseStmt(p)
        If nStmt < 0 Or p->err <> 0 Then Exit Function
        If nFirst < 0 Then
            nFirst = nStmt
        Else
            nodes = ast->nodes
            nodes[nPrev].nxt = nStmt
        End If
        nPrev = nStmt
        nodes = ast->nodes
        While nodes[nPrev].nxt >= 0
            nPrev = nodes[nPrev].nxt
        Wend
    Wend
    ParseStmtListUntil3 = nFirst
End Function

' 戻り値 true : 成り立つ  false : 成り立たない
Function ParseHashFilePrefix(p As *Parser, ByRef nFile As Long) As boolean
    ParseHashFilePrefix = false
    nFile = -1
    If ParseTokKind(p) = TK_HASH Then
        p->pos = p->pos + 1
        nFile = ParseExpr(p)
        If nFile < 0 Then Exit Function
        If ParseTokKind(p) = TK_COMMA Then
            p->pos = p->pos + 1
        End If
    End If
    ParseHashFilePrefix = true
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function ParseIoExprCanStart(p As *Parser) As boolean
    Dim k As Long
    ParseIoExprCanStart = false
    k = ParseTokKind(p)
    If k = TK_NUMBER Or k = TK_FLOAT Or k = TK_STRING Or k = TK_IDENT Or k = TK_LPAREN Or k = TK_MINUS Or k = TK_PLUS Then
        ParseIoExprCanStart = true
    End If
End Function

Sub ParseIoLink(nodes As *AstNode, nArg As Long, e As Long, ByRef nFirst As Long, ByRef nPrev As Long)
    nodes[nArg].left = e
    If nFirst < 0 Then
        nFirst = nArg
    Else
        nodes[nPrev].nxt = nArg
    End If
    nPrev = nArg
End Sub

Function ParseIoArgNode(ast As *Ast, e As Long, ByRef nFirst As Long, ByRef nPrev As Long) As boolean
    Dim nArg As Long
    ParseIoArgNode = false
    nArg = AstAddNode(ast, AST_ARG)
    If nArg < 0 Then Exit Function
    ParseIoLink(ast->nodes, nArg, e, nFirst, nPrev)
    ParseIoArgNode = true
End Function

Function ParseIoComma(p As *Parser, nodes As *AstNode, nArg As Long) As Long
    ParseIoComma = 0
    If ParseTokKind(p) <> TK_COMMA Then Exit Function
    p->pos = p->pos + 1
    nodes[nArg].num = PRINT_SEP_COMMA
    ParseIoComma = 1
End Function

' セミコロンの次が同じ行の項目でなければ true（文末の ; は戻す）
Function ParseIoSemiRewind(p As *Parser, srcLine As Long) As boolean
    ParseIoSemiRewind = true
    If Not ParseIoExprCanStart(p) Then Exit Function
    If ParseTokLine(p) <> srcLine Then Exit Function
    ParseIoSemiRewind = false
End Function

Function ParseIoSemiKeep(p As *Parser, nodes As *AstNode, nArg As Long, srcLine As Long) As Long
    ParseIoSemiKeep = 0
    If ParseIoSemiRewind(p, srcLine) Then
        p->pos = p->pos - 1
        Exit Function
    End If
    nodes[nArg].num = PRINT_SEP_SEMI
    ParseIoSemiKeep = 1
End Function

Function ParseIoSemi(p As *Parser, nodes As *AstNode, nArg As Long) As Long
    Dim srcLine As Long
    ParseIoSemi = 0
    If ParseTokKind(p) <> TK_SEMI Then Exit Function
    srcLine = ParseTokLine(p)
    p->pos = p->pos + 1
    ParseIoSemi = ParseIoSemiKeep(p, nodes, nArg, srcLine)
End Function

Function ParseIoTakeSep(p As *Parser, nodes As *AstNode, nArg As Long) As Long
    ParseIoTakeSep = ParseIoComma(p, nodes, nArg)
    If ParseIoTakeSep <> 0 Then Exit Function
    ParseIoTakeSep = ParseIoSemi(p, nodes, nArg)
End Function

' 1 項目。1=続く  0=終わり  -1=エラー
Function ParseIoExprStep(p As *Parser, ast As *Ast, ByRef nFirst As Long, ByRef nPrev As Long) As Long
    Dim e As Long
    Dim nodes As *AstNode
    ParseIoExprStep = -1
    e = ParseExpr(p)
    If e < 0 Then Exit Function
    If Not ParseIoArgNode(ast, e, nFirst, nPrev) Then Exit Function
    nodes = ast->nodes
    ParseIoExprStep = ParseIoTakeSep(p, nodes, nPrev)
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function ParseIoExprArgs(p As *Parser, ast As *Ast, ByRef nFirst As Long, ByRef nPrev As Long) As boolean
    Dim step As Long
    ParseIoExprArgs = false
    Do
        step = ParseIoExprStep(p, ast, nFirst, nPrev)
        If step < 0 Then Exit Function
        If step = 0 Then Exit Do
    Loop
    ParseIoExprArgs = true
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function ParsePrintItems(p As *Parser, ByRef nFirst As Long) As boolean
    Dim nPrev As Long
    ParsePrintItems = true
    nFirst = -1
    nPrev = -1
    If ParseTokKind(p) = TK_SEMI Or Not ParseIoExprCanStart(p) Then Exit Function
    ParsePrintItems = ParseIoExprArgs(p, p->ast, nFirst, nPrev)
End Function

Function ParsePrintStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nPrint As Long
    Dim nFile As Long
    Dim nFirst As Long
    Dim stay As Long

    ParsePrintStmt = -1
    p->pos = p->pos + 1
    stay = 0
    If Not ParseHashFilePrefix(p, nFile) Then Exit Function
    If Not ParsePrintItems(p, nFirst) Then Exit Function
    If ParseTokKind(p) = TK_SEMI Then
        p->pos = p->pos + 1
        stay = 1
    End If

    ast = p->ast
    nPrint = AstAddNode(ast, AST_PRINT)
    If nPrint < 0 Then Exit Function
    nodes = ast->nodes
    nodes[nPrint].left = nFile
    nodes[nPrint].right = nFirst
    nodes[nPrint].num = stay
    ParsePrintStmt = nPrint
End Function

Function ParseInputFileVars(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nInput As Long
    Dim nVar As Long
    Dim nFile As Long
    Dim nFirst As Long
    Dim nPrev As Long
    Dim name(SYM_NAME_LEN - 1) As Byte

    ParseInputFileVars = -1
    p->pos = p->pos + 1
    nFile = ParseExpr(p)
    If nFile < 0 Then Exit Function
    If Not ParseExpect(p, TK_COMMA) Then Exit Function
    nFirst = -1
    nPrev = -1
    Do
        If Not ParseCopyIdent(p, VarPtr(name)) Then Exit Function
        ast = p->ast
        nVar = AstAddNode(ast, AST_VAR)
        If nVar < 0 Then Exit Function
        AstSetStr(ast, nVar, VarPtr(name))
        If nFirst < 0 Then
            nFirst = nVar
        Else
            nodes = ast->nodes
            nodes[nPrev].nxt = nVar
        End If
        nPrev = nVar
        If ParseTokKind(p) <> TK_COMMA Then Exit Do
        p->pos = p->pos + 1
    Loop
    nInput = AstAddNode(ast, AST_FINPUT)
    If nInput < 0 Then Exit Function
    nodes = ast->nodes
    nodes[nInput].left = nFile
    nodes[nInput].right = nFirst
    ParseInputFileVars = nInput
End Function

' 1=カンマ  2=セミコロン（? を出す）  0=失敗
Function ParseInputSepKind(p As *Parser) As Long
    ParseInputSepKind = 0
    If ParseTokKind(p) = TK_COMMA Then ParseInputSepKind = 1
    If ParseTokKind(p) = TK_SEMI Then ParseInputSepKind = 2
    If ParseInputSepKind = 0 Then ParseFail(p, "expected ',' or ';'")
    If ParseInputSepKind = 0 Then Exit Function
    p->pos = p->pos + 1
End Function

Function ParseInputSemiBit(kind As Long) As Long
    ParseInputSemiBit = 0
    If kind = 2 Then ParseInputSemiBit = 1
End Function

Function ParseInputVarNode(p As *Parser) As Long
    Dim ast As *Ast
    Dim name(SYM_NAME_LEN - 1) As Byte
    ParseInputVarNode = -1
    If Not ParseCopyIdent(p, VarPtr(name)) Then Exit Function
    ast = p->ast
    ParseInputVarNode = AstAddNode(ast, AST_VAR)
    If ParseInputVarNode < 0 Then Exit Function
    AstSetStr(ast, ParseInputVarNode, VarPtr(name))
End Function

Sub ParseInputBind(nodes As *AstNode, nInput As Long, nPrompt As Long, nVar As Long, semi As Long)
    nodes[nInput].left = nPrompt
    nodes[nInput].right = nVar
    nodes[nInput].num = semi
End Sub

Function ParseInputLink(ast As *Ast, nPrompt As Long, nVar As Long, semi As Long) As Long
    Dim nodes As *AstNode
    Dim nInput As Long
    nInput = AstAddNode(ast, AST_INPUT)
    ParseInputLink = nInput
    If nInput < 0 Then Exit Function
    nodes = ast->nodes
    ParseInputBind(nodes, nInput, nPrompt, nVar, semi)
End Function

Function ParseInputEatComma(p As *Parser) As boolean
    ParseInputEatComma = false
    If ParseTokKind(p) <> TK_COMMA Then Exit Function
    p->pos = p->pos + 1
    ParseInputEatComma = true
End Function

Function ParseInputChain(p As *Parser, nPrev As Long, nVar As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    ParseInputChain = -1
    If nVar < 0 Then Exit Function
    ast = p->ast
    nodes = ast->nodes
    nodes[nPrev].nxt = nVar
    ParseInputChain = nVar
End Function

Function ParseInputVarTail(p As *Parser, nPrev As Long) As Long
    Dim nVar As Long
    ParseInputVarTail = nPrev
    If Not ParseInputEatComma(p) Then Exit Function
    nVar = ParseInputChain(p, nPrev, ParseInputVarNode(p))
    ParseInputVarTail = nVar
    If nVar < 0 Then Exit Function
    ParseInputVarTail = ParseInputVarTail(p, nVar)
End Function

Function ParseInputVars(p As *Parser, ByRef nVar As Long) As boolean
    ParseInputVars = false
    nVar = ParseInputVarNode(p)
    If nVar < 0 Then Exit Function
    If ParseInputVarTail(p, nVar) < 0 Then Exit Function
    ParseInputVars = true
End Function

Function ParseInputAfterSep(p As *Parser, nPrompt As Long) As Long
    Dim nVar As Long
    Dim kind As Long
    ParseInputAfterSep = -1
    If nPrompt < 0 Then Exit Function
    kind = ParseInputSepKind(p)
    If kind = 0 Then Exit Function
    If Not ParseInputVars(p, nVar) Then Exit Function
    ParseInputAfterSep = ParseInputLink(p->ast, nPrompt, nVar, ParseInputSemiBit(kind))
End Function

Function ParseInputPrompt(p As *Parser) As Long
    Dim nPrompt As Long
    nPrompt = ParseExpr(p)
    ParseInputPrompt = ParseInputAfterSep(p, nPrompt)
End Function

' Input var[, var...] ― 1行をカンマで分け、足りなければ次の行
' Input #n, var[, ...] ― ファイルからフィールド読み取り
Function ParseInputStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nInput As Long
    Dim nVar As Long
    Dim nFirst As Long
    Dim nPrev As Long
    Dim name(SYM_NAME_LEN - 1) As Byte

    ParseInputStmt = -1
    p->pos = p->pos + 1
    If ParseTokKind(p) = TK_HASH Then
        ParseInputStmt = ParseInputFileVars(p)
        Exit Function
    End If
    If ParseTokKind(p) = TK_STRING Then
        ParseInputStmt = ParseInputPrompt(p)
        Exit Function
    End If
    nFirst = -1
    nPrev = -1
    Do
        If Not ParseCopyIdent(p, VarPtr(name)) Then Exit Function
        ast = p->ast
        nVar = AstAddNode(ast, AST_VAR)
        If nVar < 0 Then Exit Function
        AstSetStr(ast, nVar, VarPtr(name))
        If nFirst < 0 Then
            nFirst = nVar
        Else
            nodes = ast->nodes
            nodes[nPrev].nxt = nVar
        End If
        nPrev = nVar
        If ParseTokKind(p) <> TK_COMMA Then Exit Do
        p->pos = p->pos + 1
    Loop
    nInput = AstAddNode(ast, AST_INPUT)
    If nInput < 0 Then Exit Function
    nodes = ast->nodes
    nodes[nInput].left = nFirst
    nodes[nInput].right = -1
    ParseInputStmt = nInput
End Function
