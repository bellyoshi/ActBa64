' ===================================================
'  ParserStmtIO - stmt lists / Print / File IO
' ===================================================

Function ParseStmtListUntil(p As *Parser, stop1 As *Byte, stop2 As *Byte) As Long
    Dim nFirst As Long
    Dim nPrev As Long
    Dim nStmt As Long
    Dim ast As *Ast
    Dim nodes As *AstNode

    ParseStmtListUntil = -1
    ast = p->ast
    nFirst = -1
    nPrev = -1

    While ParseTokKind(p) <> TK_EOF
        ParseSkipColons(p)
        If ParseTokKind(p) = TK_EOF Then Exit While
        If ParseIdentIs(p, stop1) <> 0 Then
            ParseStmtListUntil = nFirst
            Exit Function
        End If
        If stop2[0] <> 0 Then
            If ParseIdentIs(p, stop2) <> 0 Then
                ParseStmtListUntil = nFirst
                Exit Function
            End If
        End If
        nStmt = ParseStmt(p)
        If nStmt < 0 Or p->err <> 0 Then Exit Function
        If nFirst < 0 Then
            nFirst = nStmt
        Else
            nodes = ast->nodes
            nodes[nPrev].nxt = nStmt
        End If
        nPrev = nStmt
        nodes = ast->nodes
        While nodes[nPrev].nxt >= 0
            nPrev = nodes[nPrev].nxt
        Wend
    Wend
    ParseStmtListUntil = nFirst
End Function

Function ParseStmtListUntil3(p As *Parser, stop1 As *Byte, stop2 As *Byte, stop3 As *Byte) As Long
    Dim nFirst As Long
    Dim nPrev As Long
    Dim nStmt As Long
    Dim ast As *Ast
    Dim nodes As *AstNode

    ParseStmtListUntil3 = -1
    ast = p->ast
    nFirst = -1
    nPrev = -1

    While ParseTokKind(p) <> TK_EOF
        ParseSkipColons(p)
        If ParseTokKind(p) = TK_EOF Then Exit While
        If ParseIdentIs(p, stop1) <> 0 Then
            ParseStmtListUntil3 = nFirst
            Exit Function
        End If
        If stop2[0] <> 0 Then
            If ParseIdentIs(p, stop2) <> 0 Then
                ParseStmtListUntil3 = nFirst
                Exit Function
            End If
        End If
        If stop3[0] <> 0 Then
            If ParseIdentIs(p, stop3) <> 0 Then
                ParseStmtListUntil3 = nFirst
                Exit Function
            End If
        End If
        nStmt = ParseStmt(p)
        If nStmt < 0 Or p->err <> 0 Then Exit Function
        If nFirst < 0 Then
            nFirst = nStmt
        Else
            nodes = ast->nodes
            nodes[nPrev].nxt = nStmt
        End If
        nPrev = nStmt
        nodes = ast->nodes
        While nodes[nPrev].nxt >= 0
            nPrev = nodes[nPrev].nxt
        Wend
    Wend
    ParseStmtListUntil3 = nFirst
End Function

Function ParseHashFilePrefix(p As *Parser, ByRef nFile As Long) As Long
    ParseHashFilePrefix = 0
    nFile = -1
    If ParseTokKind(p) = TK_HASH Then
        p->pos = p->pos + 1
        nFile = ParseExpr(p)
        If nFile < 0 Then Exit Function
        If ParseTokKind(p) = TK_COMMA Then
            p->pos = p->pos + 1
        End If
    End If
    ParseHashFilePrefix = 1
End Function

Function ParseIoExprArgs(p As *Parser, ast As *Ast, ByRef nFirst As Long, ByRef nPrev As Long) As Long
    Dim nodes As *AstNode
    Dim nArg As Long
    Dim e As Long

    ParseIoExprArgs = 0
    Do
        e = ParseExpr(p)
        If e < 0 Then Exit Function
        nArg = AstAddNode(ast, AST_ARG)
        If nArg < 0 Then Exit Function
        nodes = ast->nodes
        nodes[nArg].left = e
        If nFirst < 0 Then
            nFirst = nArg
        Else
            nodes[nPrev].nxt = nArg
        End If
        nPrev = nArg
        If ParseTokKind(p) <> TK_COMMA Then Exit Do
        p->pos = p->pos + 1
    Loop
    ParseIoExprArgs = 1
End Function

Function ParsePrintItems(p As *Parser, ByRef nFirst As Long) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nArg As Long
    Dim nPrev As Long
    Dim e As Long

    ParsePrintItems = 0
    nFirst = -1
    nPrev = -1
    If ParseTokKind(p) = TK_LPAREN Then
        p->pos = p->pos + 1
        e = ParseExpr(p)
        If e < 0 Then Exit Function
        If ParseExpect(p, TK_RPAREN) = 0 Then Exit Function
        ast = p->ast
        nArg = AstAddNode(ast, AST_ARG)
        If nArg < 0 Then Exit Function
        nodes = ast->nodes
        nodes[nArg].left = e
        nFirst = nArg
    ElseIf ParseTokKind(p) <> TK_SEMI Then
        If ParseTokKind(p) = TK_NUMBER Or ParseTokKind(p) = TK_FLOAT Or ParseTokKind(p) = TK_STRING Or ParseTokKind(p) = TK_IDENT Or ParseTokKind(p) = TK_LPAREN Or ParseTokKind(p) = TK_MINUS Or ParseTokKind(p) = TK_PLUS Then
            ast = p->ast
            If ParseIoExprArgs(p, ast, nFirst, nPrev) = 0 Then Exit Function
        End If
    End If
    ParsePrintItems = 1
End Function

Function ParsePrintStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nPrint As Long
    Dim nFile As Long
    Dim nFirst As Long
    Dim stay As Long

    ParsePrintStmt = -1
    p->pos = p->pos + 1
    stay = 0
    If ParseHashFilePrefix(p, nFile) = 0 Then Exit Function
    If ParsePrintItems(p, nFirst) = 0 Then Exit Function
    If ParseTokKind(p) = TK_SEMI Then
        p->pos = p->pos + 1
        stay = 1
    End If

    ast = p->ast
    nPrint = AstAddNode(ast, AST_PRINT)
    If nPrint < 0 Then Exit Function
    nodes = ast->nodes
    nodes[nPrint].left = nFile
    nodes[nPrint].right = nFirst
    nodes[nPrint].num = stay
    ParsePrintStmt = nPrint
End Function

Function ParseInputFileVars(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nInput As Long
    Dim nVar As Long
    Dim nFile As Long
    Dim nFirst As Long
    Dim nPrev As Long
    Dim name(63) As Byte

    ParseInputFileVars = -1
    p->pos = p->pos + 1
    nFile = ParseExpr(p)
    If nFile < 0 Then Exit Function
    If ParseExpect(p, TK_COMMA) = 0 Then Exit Function
    nFirst = -1
    nPrev = -1
    Do
        If ParseCopyIdent(p, VarPtr(name)) = 0 Then Exit Function
        ast = p->ast
        nVar = AstAddNode(ast, AST_VAR)
        If nVar < 0 Then Exit Function
        AstSetStr(ast, nVar, VarPtr(name))
        If nFirst < 0 Then
            nFirst = nVar
        Else
            nodes = ast->nodes
            nodes[nPrev].nxt = nVar
        End If
        nPrev = nVar
        If ParseTokKind(p) <> TK_COMMA Then Exit Do
        p->pos = p->pos + 1
    Loop
    nInput = AstAddNode(ast, AST_FINPUT)
    If nInput < 0 Then Exit Function
    nodes = ast->nodes
    nodes[nInput].left = nFile
    nodes[nInput].right = nFirst
    ParseInputFileVars = nInput
End Function

Function ParseInputPrompt(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nInput As Long
    Dim nVar As Long
    Dim nPrompt As Long
    Dim name(63) As Byte

    ParseInputPrompt = -1
    nPrompt = ParseExpr(p)
    If nPrompt < 0 Then Exit Function
    If ParseExpect(p, TK_COMMA) = 0 Then Exit Function
    If ParseCopyIdent(p, VarPtr(name)) = 0 Then Exit Function
    ast = p->ast
    nVar = AstAddNode(ast, AST_VAR)
    If nVar < 0 Then Exit Function
    AstSetStr(ast, nVar, VarPtr(name))
    nInput = AstAddNode(ast, AST_INPUT)
    If nInput < 0 Then Exit Function
    nodes = ast->nodes
    nodes[nInput].left = nPrompt
    nodes[nInput].right = nVar
    ParseInputPrompt = nInput
End Function

' Input var ― stdin から1行読み取り、文字列または数値変数へ代入
' Input #n, var[, ...] ― ファイルからフィールド読み取り
Function ParseInputStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nInput As Long
    Dim nVar As Long
    Dim name(63) As Byte

    ParseInputStmt = -1
    p->pos = p->pos + 1
    If ParseTokKind(p) = TK_HASH Then
        ParseInputStmt = ParseInputFileVars(p)
        Exit Function
    End If
    If ParseTokKind(p) = TK_STRING Then
        ParseInputStmt = ParseInputPrompt(p)
        Exit Function
    End If
    If ParseCopyIdent(p, VarPtr(name)) = 0 Then Exit Function
    ast = p->ast
    nVar = AstAddNode(ast, AST_VAR)
    If nVar < 0 Then Exit Function
    AstSetStr(ast, nVar, VarPtr(name))
    nInput = AstAddNode(ast, AST_INPUT)
    If nInput < 0 Then Exit Function
    nodes = ast->nodes
    nodes[nInput].left = nVar
    nodes[nInput].right = -1
    ParseInputStmt = nInput
End Function
