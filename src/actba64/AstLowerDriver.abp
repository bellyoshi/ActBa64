' ===================================================
'  AstLowerDriver - AstToIr pipeline
' ===================================================

Function AstToIrEmitFuncFinish(ctx As *LowerCtx, stmt As Long, retBuf As *Byte, leaveArgCount As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList
    Dim namePtr(63) As Byte
    Dim offs As *Long
    Dim pi As Long
    Dim savedErr As Long

    AstToIrEmitFuncFinish = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    offs = ctx->offs
    savedErr = ctx->err
    ctx->err = 0
    If LowStmtList(ctx, nodes[stmt].right) = 0 Then
        If ctx->err = 0 Then
            AstCopyStr(ast, stmt, VarPtr(namePtr))
            LowerDiagError(ctx, stmt, "codegen in function '" + MakeStr(VarPtr(namePtr)) + "'")
        End If
    End If
    If ctx->err <> 0 Then savedErr = 1
    ctx->err = savedErr
    IrEmit(list, OP_LABEL, g_funcEndLab, 0)
    LowEmitLocalClassDtors(ctx)
    ' エピローグでは Collect しない。入れ子の Mid$ / Lower$ 終了時に
    ' 呼び出し元の String が conservative 漏れで解放されるのを防ぐ。
    If retBuf[0] <> 0 Then
        pi = LowFindSym(ctx, retBuf)
        If pi < 0 Then Exit Function
        IrEmit(list, OP_LOAD_LOCAL, offs[pi], 0)
    End If
    LowEmitLeave(list, leaveArgCount)
    ctx->inFunc = 0
    g_funcEndLab = -1
    retBuf[0] = 0
    AstToIrEmitFuncFinish = 1
End Function

Function AstToIrEmitFuncs(ctx As *LowerCtx, prog As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim stmt As Long
    Dim retBuf(63) As Byte
    Dim leaveArgCount As Long

    AstToIrEmitFuncs = 0
    ast = ctx->ast
    nodes = ast->nodes
    stmt = nodes[prog].left
    While stmt >= 0
        If nodes[stmt].kind = AST_FUNC Then
            leaveArgCount = AstToIrEmitFuncSetup(ctx, stmt, VarPtr(retBuf))
            If leaveArgCount < 0 Then Exit Function
            If AstToIrEmitFuncFinish(ctx, stmt, VarPtr(retBuf), leaveArgCount) = 0 Then Exit Function
        End If
        stmt = nodes[stmt].nxt
    Wend
    AstToIrEmitFuncs = 1
End Function

Function AstToIrEmitMain(ctx As *LowerCtx, prog As Long, labMain As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList
    Dim stmt As Long
    Dim frame As Long
    Dim savedErr As Long

    AstToIrEmitMain = 0
    list = ctx->list
    ast = ctx->ast
    nodes = ast->nodes
    ' main: module Dims are globals; frame only needs temps (16-byte aligned)
    ctx->symCount = 0
    ctx->frameUsed = 0
    frame = LowAlign16(&H28)

    IrEmit(list, OP_LABEL, labMain, 0)
    IrEmit(list, OP_ENTER, frame, 0)
    LowEmitGcPreciseRootsInit(ctx)

    stmt = nodes[prog].left
    While stmt >= 0
        If nodes[stmt].kind <> AST_FUNC And nodes[stmt].kind <> AST_CONST And nodes[stmt].kind <> AST_TYPE And nodes[stmt].kind <> AST_ENUM Then
            savedErr = ctx->err
            ctx->err = 0
            If LowStmt(ctx, stmt) = 0 Then
                If ctx->err = 0 Then
                    LowerDiagError(ctx, stmt, "codegen in module stmt kind " + Str$(nodes[stmt].kind))
                End If
            End If
            If ctx->err <> 0 Then savedErr = 1
            ctx->err = savedErr
        End If
        stmt = nodes[stmt].nxt
    Wend

    If ctx->err <> 0 Or DiagErrorCount() > 0 Then
        Exit Function
    End If

    LowEmitGlobalClassDtors(ctx)
    LowEmitStrCollectSafepoint(ctx)
    LowEmitExitImm(ctx, 0)
    IrEmit(list, OP_LEAVE, 0, 0)
    AstToIrEmitMain = 1
End Function

Sub AstToIrEmitRt(ctx As *LowerCtx)
    LowEmitRtCatBody(ctx)
    LowEmitRtMidBody(ctx)
    LowEmitRtStrBody(ctx)
    LowEmitRtPrintBody(ctx)
    LowEmitRtInputBody(ctx)
    LowEmitRtValBody(ctx)
    LowEmitRtValDoubleBody(ctx)
    LowEmitRtMakeStrBody(ctx)
    LowEmitRtStrCmpBody(ctx)
    LowEmitRtStrFreeBody(ctx)
    LowEmitRtStrHeapAllocBody(ctx)
    LowEmitRtStrGcPreciseBody(ctx)
    LowEmitRtStrGcConsBody(ctx)
    LowEmitRtStrCollectBody(ctx)
End Sub

Function AstToIrAlloc() As Long
    AstToIrAlloc = 0
    g_freeSymNames = calloc(BytesN(DYN_INIT, SYM_NAME_LEN))
    g_freeSymOffs = calloc(BytesN(DYN_INIT, SizeOf(Long)))
    g_freeSymTypes = calloc(BytesN(DYN_INIT, SizeOf(Long)))
    g_freeSymTypeIdxs = calloc(BytesN(DYN_INIT, SizeOf(Long)))
    g_freeSymByRefs = calloc(BytesN(DYN_INIT, SizeOf(Long)))
    g_freeGlobNames = calloc(BytesN(DYN_INIT, SYM_NAME_LEN))
    g_freeGlobOffs = calloc(BytesN(DYN_INIT, SizeOf(Long)))
    g_freeGlobTypes = calloc(BytesN(DYN_INIT, SizeOf(Long)))
    g_freeGlobTypeIdxs = calloc(BytesN(DYN_INIT, SizeOf(Long)))
    g_freeFuncNames = calloc(BytesN(DYN_INIT, SYM_NAME_LEN))
    g_freeFuncLabs = calloc(BytesN(DYN_INIT, SizeOf(Long)))
    g_freeFuncByRefs = calloc(BytesN(DYN_INIT, SizeOf(Long)))
    g_freeConstNames = calloc(BytesN(DYN_INIT, SYM_NAME_LEN))
    g_freeConstVals = calloc(BytesN(DYN_INIT, SizeOf(Long)))
    g_freeConstStrNames = calloc(BytesN(DYN_INIT, SYM_NAME_LEN))
    g_freeConstStrVals = calloc(BytesN(DYN_INIT, AST_STR_LEN))
    g_freeDeclNames = calloc(BytesN(DYN_INIT, SYM_NAME_LEN))
    g_freeDeclApiNames = calloc(BytesN(DYN_INIT, SYM_NAME_LEN))
    g_freeDeclDlls = calloc(BytesN(DYN_INIT, SizeOf(Long)))
    g_freeDeclByRefs = calloc(BytesN(DYN_INIT, SizeOf(Long)))
    g_preciseRoots = calloc(BytesN(GC_MAX_PRECISE, SizeOf(Long)))
    g_fnPreciseRoots = calloc(BytesN(GC_MAX_PRECISE, SizeOf(Long)))
    g_globNbytes = calloc(BytesN(DYN_INIT, SizeOf(Long)))
    If g_freeSymNames = NULL Or g_freeSymOffs = NULL Or g_freeSymTypes = NULL Or g_freeSymTypeIdxs = NULL Or g_freeSymByRefs = NULL Then
        Exit Function
    End If
    If g_freeGlobNames = NULL Or g_freeGlobOffs = NULL Or g_freeGlobTypes = NULL Or g_freeGlobTypeIdxs = NULL Then
        Exit Function
    End If
    If g_freeFuncNames = NULL Or g_freeFuncLabs = NULL Or g_freeFuncByRefs = NULL Then
        Exit Function
    End If
    If g_freeConstNames = NULL Or g_freeConstVals = NULL Or g_freeConstStrNames = NULL Or g_freeConstStrVals = NULL Then
        Exit Function
    End If
    If g_freeDeclNames = NULL Or g_freeDeclApiNames = NULL Or g_freeDeclDlls = NULL Or g_freeDeclByRefs = NULL Then
        Exit Function
    End If
    If g_preciseRoots = NULL Or g_fnPreciseRoots = NULL Or g_globNbytes = NULL Then Exit Function
    g_symCap = DYN_INIT
    g_globCap = DYN_INIT
    g_funcCap = DYN_INIT
    g_constCap = DYN_INIT
    g_constStrCap = DYN_INIT
    g_declCap = DYN_INIT
    g_globNames = g_freeGlobNames
    g_globOffs = g_freeGlobOffs
    g_globTypes = g_freeGlobTypes
    g_globTypeIdxs = g_freeGlobTypeIdxs
    g_globCount = 0
    g_globDataSize = 0
    AstToIrAlloc = 1
End Function

Sub AstToIrInitLabs()
    g_doEndLab = -1
    g_doTopLab = -1
    g_whileEndLab = -1
    g_whileTopLab = -1
    g_forEndLab = -1
    g_forContLab = -1
    g_funcEndLab = -1
    g_rtCatLab = -1
    g_rtMidLab = -1
    g_rtStrLab = -1
    g_rtPrintLab = -1
    g_rtInputLab = -1
    g_rtValLab = -1
    g_rtValDoubleLab = -1
    g_rtMakeStrLab = -1
    g_rtStrCmpLab = -1
    g_rtStrFreeLab = -1
    g_rtStrHeapAllocLab = -1
    g_rtStrGcPreciseLab = -1
    g_rtStrGcConsLab = -1
    g_rtStrCollectLab = -1
End Sub

Sub AstToIrInitCtx(ctx As *LowerCtx, list As *IrList, ast As *Ast)
    ctx->list = list
    ctx->ast = ast
    ctx->symCount = 0
    ctx->nextLab = 0
    ctx->err = 0
    ctx->names = g_freeSymNames
    ctx->offs = g_freeSymOffs As *Long
    ctx->types = g_freeSymTypes As *Long
    ctx->typeIdxs = g_freeSymTypeIdxs As *Long
    ctx->byRefs = g_freeSymByRefs As *Long
    ctx->frameUsed = 0
    ctx->inFunc = 0
    ctx->funcNames = g_freeFuncNames
    ctx->funcLabs = g_freeFuncLabs As *Long
    ctx->funcByRefs = g_freeFuncByRefs As *Long
    ctx->funcCount = 0
    ctx->constNames = g_freeConstNames
    ctx->constVals = g_freeConstVals As *Long
    ctx->constCount = 0
    ctx->constStrNames = g_freeConstStrNames
    ctx->constStrVals = g_freeConstStrVals
    ctx->constStrCount = 0
    ctx->declNames = g_freeDeclNames
    ctx->declApiNames = g_freeDeclApiNames
    ctx->declDlls = g_freeDeclDlls As *Long
    ctx->declByRefs = g_freeDeclByRefs As *Long
    ctx->declCount = 0
    AstToIrInitLabs()
    g_gcBaseOff = 0
    g_preciseRootCount = 0
    g_fnPreciseRootCount = 0
    list->globSize = 0
End Sub

Function AstToIrBindMod(ctx As *LowerCtx, prog As Long, list As *IrList) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    AstToIrBindMod = 0
    ast = ctx->ast
    nodes = ast->nodes
    If AstToIrRegDecls(ctx, prog) = 0 Then Exit Function
    If AstToIrRegConsts(ctx, prog) = 0 Then Exit Function
    If AstToIrRegFuncs(ctx, prog) = 0 Then Exit Function
    ' module-level Dim -> globals (before any function emit; nested Dims in main too)
    If LowCollectDimsInList(ctx, nodes[prog].left, 1) = 0 Then Exit Function
    LowCollectPreciseGlobRoots()
    g_gcBaseOff = g_globDataSize
    g_globDataSize = g_globDataSize + GC_REGION_SIZE
    list->globSize = g_globDataSize
    AstToIrBindMod = 1
End Function

Function AstToIr(ast As *Ast, list As *IrList, ByRef subsystemOut As Long) As Long
    Dim ctx As LowerCtx
    Dim nodes As *AstNode
    Dim prog As Long
    Dim labMain As Long

    AstToIr = 0
    subsystemOut = IMAGE_SUBSYSTEM_WINDOWS_CUI
    If ast->root < 0 Then Exit Function
    nodes = ast->nodes
    prog = ast->root
    If nodes[prog].kind <> AST_PROGRAM Then Exit Function

    If AstToIrAlloc() = 0 Then
        LowFreeAstBufs()
        Exit Function
    End If
    AstToIrInitCtx(VarPtr(ctx), list, ast)

    ' #USEWINDOW による GUI サブシステム切り替えは CompileSource 側で行う
    If AstToIrBindMod(VarPtr(ctx), prog, list) = 0 Then
        LowFreeAstBufs()
        Exit Function
    End If

    labMain = LowNewLabel(VarPtr(ctx))
    IrEmit(list, OP_JMP, labMain, 0)

    If AstToIrEmitFuncs(VarPtr(ctx), prog) = 0 Then
        LowFreeAstBufs()
        Exit Function
    End If
    If AstToIrEmitMain(VarPtr(ctx), prog, labMain) = 0 Then
        LowFreeAstBufs()
        Exit Function
    End If
    AstToIrEmitRt(VarPtr(ctx))

    LowFreeAstBufs()
    g_globNames = NULL
    g_globOffs = NULL
    g_globTypes = NULL
    g_globTypeIdxs = NULL
    g_globCount = 0
    g_globDataSize = 0
    AstToIr = 1
End Function

