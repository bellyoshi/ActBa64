' AstLowerI64 - Int64 / QWord（x64 のみ）
' 値は rax の 64bit。印は変数・仮引数の LOW_PTI_I64 / LOW_PTI_U64（TY_LONG の typeIdx）と、
' Type メンバの FIELDTY_INT64 / FIELDTY_QWORD（8 バイト）。
' 32bit の式（Long / DWord）は rax の上位が 0 なので、64bit へ入れるときに広げる。

' LowExprWide の結果をノードごとに覚える（0 = まだ、1 = 64bit でない、2 = Int64、3 = QWord）。
' 式の木を何度もたどらないように。AstToIrInitCtx で作り直す
Dim g_wideCache As *Long
Dim g_wideCacheCap As Long

Sub LowWideCacheReset(ast As *Ast)
    If g_wideCache <> NULL Then free(g_wideCache)
    g_wideCacheCap = ast->capacity
    g_wideCache = calloc(BytesN(g_wideCacheCap, SizeOf(Long))) As *Long
    If g_wideCache = NULL Then g_wideCacheCap = 0
End Sub

Function LowWideCode(w As Long) As Long
    LowWideCode = 1
    If w = LOW_PTI_I64 Then LowWideCode = 2
    If w = LOW_PTI_U64 Then LowWideCode = 3
End Function

Function LowWideFromCode(c As Long) As Long
    LowWideFromCode = 0
    If c = 2 Then LowWideFromCode = LOW_PTI_I64
    If c = 3 Then LowWideFromCode = LOW_PTI_U64
End Function

' 64bit の式なら LOW_PTI_I64 / LOW_PTI_U64、違えば 0
Function LowExprWide(ctx As *LowerCtx, idx As Long) As Long
    Dim c As Long
    LowExprWide = 0
    If idx < 0 Then Exit Function
    If idx < g_wideCacheCap Then
        c = g_wideCache[idx]
        If c <> 0 Then
            LowExprWide = LowWideFromCode(c)
            Exit Function
        End If
    End If
    LowExprWide = LowExprWideCalc(ctx, idx)
    If idx < g_wideCacheCap Then g_wideCache[idx] = LowWideCode(LowExprWide)
End Function

Function LowExprWideCalc(ctx As *LowerCtx, idx As Long) As Long
    Dim kind As Long
    LowExprWideCalc = 0
    kind = LowNodeKind(ctx, idx)
    If kind = AST_VAR Then LowExprWideCalc = LowVarWide(ctx, idx)
    If kind = AST_MEMBER Then LowExprWideCalc = LowMemberWide(ctx, idx)
    If kind = AST_NUM Then LowExprWideCalc = LowNumWide(ctx, idx)
    If kind = AST_UNARY Then LowExprWideCalc = LowUnaryWide(ctx, idx)
    If kind = AST_BINOP Then LowExprWideCalc = LowBinopWide(ctx, idx)
    If kind = AST_CALL Then LowExprWideCalc = LowCallWide(ctx, idx)
    If kind = AST_INDEX Then LowExprWideCalc = LowIndexWide(ctx, idx)
End Function

' Int64 / QWord の配列（TY_INT64_ARR / TY_QWORD_ARR）なら 1
Function LowIsWideArr(ty As Long) As Long
    LowIsWideArr = 0
    If ty = TY_INT64_ARR Or ty = TY_QWORD_ARR Then LowIsWideArr = 1
End Function

Function LowWideArrMark(ty As Long) As Long
    LowWideArrMark = 0
    If ty = TY_INT64_ARR Then LowWideArrMark = LOW_PTI_I64
    If ty = TY_QWORD_ARR Then LowWideArrMark = LOW_PTI_U64
End Function

' a[i] / a[i, j]（左が配列の変数）
Function LowIndexWide(ctx As *LowerCtx, idx As Long) As Long
    Dim base As Long
    LowIndexWide = 0
    base = LowNodeLeft(ctx, idx)
    If base < 0 Then Exit Function
    If LowNodeKind(ctx, base) = AST_MEMBER Then
        LowIndexWide = LowMemberArrWide(ctx, base)
        Exit Function
    End If
    If LowNodeKind(ctx, base) <> AST_VAR Then Exit Function
    LowIndexWide = LowWideArrMark(LowNameElemTy(ctx, base))
End Function

' t.v[i] の v が Int64 / QWord の配列のメンバ
Function LowMemberArrWide(ctx As *LowerCtx, mem As Long) As Long
    Dim ft As Long
    LowMemberArrWide = 0
    If LowMemberIsArr(ctx, mem) = 0 Then Exit Function
    ft = LowMemberFieldTy(ctx, mem)
    If ft = FIELDTY_INT64 Then LowMemberArrWide = LOW_PTI_I64
    If ft = FIELDTY_QWORD Then LowMemberArrWide = LOW_PTI_U64
End Function

' Function ... As Int64 / As QWord（メソッドも）の呼び出し。配列の要素・関数ポインタはまだ 32bit
Function LowCallWide(ctx As *LowerCtx, idx As Long) As Long
    Dim sig(MANGLED_LEN - 1) As Byte
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim ti As Long
    Dim vOff As Long, vTy As Long, vTi As Long, vByRef As Long, vGlob As Long
    LowCallWide = 0
    ti = LowCallMethodTi(ctx, idx)
    If ti >= 0 Then
        LowMethodSigTo(ctx, idx, ti, VarPtr(sig))
        LowCallWide = LowFuncRetWideAt(LowFuncIndex(ctx, VarPtr(sig)))
        Exit Function
    End If
    OvlFixCall(ctx, idx)
    AstCopyStr(ctx->ast, idx, VarPtr(name))
    ' 配列の要素と関数ポインタは対象外（自分の名前の再帰呼び出しは戻り値の変数と同じ名前なので通す）
    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTi), VarPtr(vByRef), VarPtr(vGlob)) Then
        ' a(i) / a(i, j) の要素
        LowCallWide = LowWideArrMark(vTy)
        If vTy = TY_PTR_FUNC Then LowCallWide = LowTiWide(vTi)
        If vTy = TY_PTR_FUNC Or LowIsArrTy(vTy) Then Exit Function
    End If
    LowCallWide = LowFuncRetWideAt(LowFuncIndex(ctx, VarPtr(name)))
    If LowCallWide = 0 Then LowCallWide = LowDeclRetWide(ctx, VarPtr(name))
End Function

Function LowNumWide(ctx As *LowerCtx, idx As Long) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    ast = ctx->ast
    nodes = ast->nodes
    LowNumWide = 0
    If nodes[idx].extra = AST_NUM_EXTRA_I64 Then LowNumWide = LOW_PTI_I64
End Function

' -x / Not x は x と同じ幅
Function LowUnaryWide(ctx As *LowerCtx, idx As Long) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    ast = ctx->ast
    nodes = ast->nodes
    LowUnaryWide = 0
    If nodes[idx].num <> UOP_NEG And nodes[idx].num <> UOP_NOT Then Exit Function
    LowUnaryWide = LowExprWide(ctx, nodes[idx].left)
End Function

' 整数の + - * \ Mod And Or Xor は、どちらかが 64bit なら 64bit（Int64 が入れば Int64、ほかは QWord）。
' << >> は左辺の幅。浮動小数・文字列の演算は対象外（ポインタの演算は先に AstLowerPtrArith が取る）
Function LowBinopWide(ctx As *LowerCtx, idx As Long) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim op As Long
    Dim lw As Long
    Dim rw As Long
    LowBinopWide = 0
    ast = ctx->ast
    nodes = ast->nodes
    op = nodes[idx].num
    If LowWideOpOk(op) = 0 Then Exit Function
    If LowWideOperandsInt(ctx, idx) = 0 Then Exit Function
    lw = LowExprWide(ctx, nodes[idx].left)
    If op = BOP_SHL Or op = BOP_SHR Then
        LowBinopWide = lw
        Exit Function
    End If
    rw = LowExprWide(ctx, nodes[idx].right)
    LowBinopWide = LowWideJoin(lw, rw)
End Function

Function LowWideJoin(lw As Long, rw As Long) As Long
    LowWideJoin = 0
    If lw = 0 And rw = 0 Then Exit Function
    LowWideJoin = LOW_PTI_I64
    If lw = LOW_PTI_U64 And rw <> LOW_PTI_I64 Then LowWideJoin = LOW_PTI_U64
    If rw = LOW_PTI_U64 And lw <> LOW_PTI_I64 Then LowWideJoin = LOW_PTI_U64
End Function

Function LowWideOpOk(op As Long) As Long
    LowWideOpOk = 0
    If op = BOP_ADD Or op = BOP_SUB Or op = BOP_MUL Or op = BOP_AND Or op = BOP_OR Or op = BOP_XOR Then LowWideOpOk = 1
    If op = BOP_IDIV Or op = BOP_MOD Or op = BOP_SHL Or op = BOP_SHR Then LowWideOpOk = 1
End Function

' 両辺とも整数（Double / Single / 文字列でない）
Function LowWideOperandsInt(ctx As *LowerCtx, idx As Long) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim fty As Long
    LowWideOperandsInt = 0
    ast = ctx->ast
    nodes = ast->nodes
    If LowIsStringExpr(ctx, nodes[idx].left) <> 0 Then Exit Function
    If LowIsStringExpr(ctx, nodes[idx].right) <> 0 Then Exit Function
    fty = LowPromoteType(LowExprType(ctx, nodes[idx].left), LowExprType(ctx, nodes[idx].right))
    If fty <> TY_LONG Then Exit Function
    LowWideOperandsInt = 1
End Function

' 比較を 64bit でするなら 1（整数どうしで、どちらかが 64bit）
Function LowCmpIsWide(ctx As *LowerCtx, idx As Long) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    LowCmpIsWide = 0
    If LowWideOperandsInt(ctx, idx) = 0 Then Exit Function
    ast = ctx->ast
    nodes = ast->nodes
    If LowExprWide(ctx, nodes[idx].left) <> 0 Then LowCmpIsWide = 1
    If LowExprWide(ctx, nodes[idx].right) <> 0 Then LowCmpIsWide = 1
End Function

' 64bit の比較は、両辺とも符号なし（QWord・DWord・非負のリテラル）なら符号なし
Function LowCmpIsU64(ctx As *LowerCtx, idx As Long) As Long
    LowCmpIsU64 = LowWideOpUnsigned(ctx, idx, BOP_EQ)
End Function

' 式を評価して 64bit に広げる
Function LowEmitWideExpr(ctx As *LowerCtx, e As Long) As Long
    LowEmitWideExpr = 0
    If LowExpr(ctx, e) = 0 Then Exit Function
    LowEmitCvtToWide(ctx, e)
    LowEmitWideExpr = 1
End Function

' 64bit の二項演算。rcx = 左辺、rax = 右辺にしてから演算する
Function LowExprBinopWide(ctx As *LowerCtx, idx As Long, op As Long) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim list As *IrList
    LowExprBinopWide = 0
    ast = ctx->ast
    nodes = ast->nodes
    list = ctx->list
    If LowEmitWideExpr(ctx, nodes[idx].left) = 0 Then Exit Function
    LowEmitBinHold(list)
    If op = BOP_SHL Or op = BOP_SHR Then
        If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
        LowEmitCvtToLongIfNeeded(ctx, nodes[idx].right, TY_LONG)
    Else
        If LowEmitWideExpr(ctx, nodes[idx].right) = 0 Then Exit Function
    End If
    LowEmitBinTake(list)
    If LowWideOpUnsigned(ctx, idx, op) <> 0 And (op = BOP_IDIV Or op = BOP_MOD Or op = BOP_SHR) Then
        IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
        LowEmitWideUnsigned(list, op)
    Else
        LowEmitWideOp(list, op)
    End If
    LowExprBinopWide = 1
End Function

' 符号なしの \ Mod >>（rax = 左辺、rcx = 右辺）
Sub LowEmitWideUnsigned(list As *IrList, op As Long)
    If op = BOP_SHR Then IrEmit(list, OP_SHR_RAX_CL, 0, 0)
    If op = BOP_IDIV Or op = BOP_MOD Then IrEmit(list, OP_DIV_RCX, 0, 0)
    If op = BOP_MOD Then IrEmit(list, OP_MOV_RAX_RDX, 0, 0)
End Sub

Sub LowEmitWideOp(list As *IrList, op As Long)
    If op = BOP_ADD Then
        IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
    ElseIf op = BOP_MUL Then
        IrEmit(list, OP_IMUL_RAX_RCX, 0, 0)
    ElseIf op = BOP_AND Then
        IrEmit(list, OP_AND_RAX_RCX, 0, 0)
    ElseIf op = BOP_OR Then
        IrEmit(list, OP_OR_RAX_RCX, 0, 0)
    ElseIf op = BOP_XOR Then
        IrEmit(list, OP_XOR_RAX_RCX, 0, 0)
    Else
        ' 引き算・割り算・シフトは rax = 左辺、rcx = 右辺
        IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
        LowEmitWideOrdered(list, op)
    End If
End Sub

Sub LowEmitWideOrdered(list As *IrList, op As Long)
    If op = BOP_SUB Then IrEmit(list, OP_SUB_RAX_RCX, 0, 0)
    If op = BOP_SHL Then IrEmit(list, OP_SHL_RAX_CL, 0, 0)
    If op = BOP_SHR Then IrEmit(list, OP_SAR_RAX_CL, 0, 0)
    If op = BOP_IDIV Or op = BOP_MOD Then IrEmit(list, OP_IDIV_RCX, 0, 0)
    If op = BOP_MOD Then IrEmit(list, OP_MOV_RAX_RDX, 0, 0)
End Sub

' 符号なしとして読める整数の式: QWord、DWord、整数のリテラル（Int64 のリテラルは非負のときだけ）
Function LowExprUnsignedW(ctx As *LowerCtx, e As Long) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    LowExprUnsignedW = 1
    If LowExprWide(ctx, e) = LOW_PTI_U64 Then Exit Function
    If LowExprIsU32(ctx, e) <> 0 Then Exit Function
    If LowWideIsIntLit(ctx, e) <> 0 Then
        ast = ctx->ast
        nodes = ast->nodes
        If nodes[e].extra <> AST_NUM_EXTRA_I64 Then Exit Function
        If nodes[e].left >= 0 Then Exit Function
    End If
    LowExprUnsignedW = 0
End Function

' 64bit の演算を符号なしでするなら 1（AB 4.20 と同じく、両辺とも符号なしのとき）。>> は左辺が QWord のとき
Function LowWideOpUnsigned(ctx As *LowerCtx, idx As Long, op As Long) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    ast = ctx->ast
    nodes = ast->nodes
    LowWideOpUnsigned = 0
    If op = BOP_SHR Then
        If LowExprWide(ctx, nodes[idx].left) = LOW_PTI_U64 Then LowWideOpUnsigned = 1
        Exit Function
    End If
    If LowExprUnsignedW(ctx, nodes[idx].left) = 0 Then Exit Function
    LowWideOpUnsigned = LowExprUnsignedW(ctx, nodes[idx].right)
End Function

' 64bit の比較: rcx = 左辺、rax = 右辺で cmp rcx, rax
Function LowEmitWideCmp(ctx As *LowerCtx, idx As Long) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim list As *IrList
    LowEmitWideCmp = 0
    ast = ctx->ast
    nodes = ast->nodes
    list = ctx->list
    If LowEmitWideExpr(ctx, nodes[idx].left) = 0 Then Exit Function
    LowEmitBinHold(list)
    If LowEmitWideExpr(ctx, nodes[idx].right) = 0 Then Exit Function
    LowEmitBinTake(list)
    IrEmit(list, OP_CMP_RCX_RAX, 0, 0)
    LowEmitWideCmp = 1
End Function

Function LowExprUnaryWide(ctx As *LowerCtx, idx As Long) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    LowExprUnaryWide = 0
    ast = ctx->ast
    nodes = ast->nodes
    If LowEmitWideExpr(ctx, nodes[idx].left) = 0 Then Exit Function
    If nodes[idx].num = UOP_NEG Then IrEmit(ctx->list, OP_NEG_RAX, 0, 0)
    If nodes[idx].num = UOP_NOT Then IrEmit(ctx->list, OP_NOT_RAX, 0, 0)
    LowExprUnaryWide = 1
End Function

' Function の flags から戻り値の変数の typeIdx（Int64 / QWord の印、無ければ -1）
Function LowFuncRetTi(flags As Long) As Long
    LowFuncRetTi = -1
    If (flags And AST_FUNC_RET_I64) <> 0 Then LowFuncRetTi = LOW_PTI_I64
    If (flags And AST_FUNC_RET_U64) <> 0 Then LowFuncRetTi = LOW_PTI_U64
End Function

Function LowTiWide(ti As Long) As Long
    LowTiWide = 0
    If ti = LOW_PTI_I64 Or ti = LOW_PTI_U64 Then LowTiWide = ti
End Function

Function LowVarWide(ctx As *LowerCtx, idx As Long) As Long
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim vOff As Long, vTy As Long, vTi As Long, vByRef As Long, vGlob As Long
    LowVarWide = 0
    AstCopyStr(ctx->ast, idx, VarPtr(name))
    If Not LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTi), VarPtr(vByRef), VarPtr(vGlob)) Then
        LowVarWide = LowConstWide(ctx, VarPtr(name))
        Exit Function
    End If
    If vTy = TY_LONG Then LowVarWide = LowTiWide(vTi)
End Function

Function LowMemberWide(ctx As *LowerCtx, idx As Long) As Long
    Dim ft As Long
    LowMemberWide = 0
    If LowMemberIsArr(ctx, idx) <> 0 Then Exit Function
    ft = LowMemberFieldTy(ctx, idx)
    If ft = FIELDTY_INT64 Then LowMemberWide = LOW_PTI_I64
    If ft = FIELDTY_QWORD Then LowMemberWide = LOW_PTI_U64
End Function

' 評価済みの右辺 rhsIdx（rax）を 64bit の整数にする
' Double / Single は 0 へ切り捨て、DWord と整数のリテラルは 0 で、Long は符号で広げる
Sub LowEmitCvtToWide(ctx As *LowerCtx, rhsIdx As Long)
    Dim ty As Long
    If LowExprWide(ctx, rhsIdx) <> 0 Then Exit Sub
    ty = LowExprType(ctx, rhsIdx)
    If ty = TY_DOUBLE Then
        IrEmit(ctx->list, OP_CVT_SD_TO_I64, 0, 0)
        Exit Sub
    End If
    If ty = TY_SINGLE Then
        IrEmit(ctx->list, OP_CVT_SS_TO_SD, 0, 0)
        IrEmit(ctx->list, OP_CVT_SD_TO_I64, 0, 0)
        Exit Sub
    End If
    ' ポインタ（*T・VoidPtr・VarPtr・ポインタの演算・ポインタを返す関数）は rax の 64bit のまま
    If LowExprIsPtr(ctx, rhsIdx) <> 0 Then Exit Sub
    If ty = TY_PTR_BYTE Or ty = TY_PTR_LONG Or ty = TY_PTR_UDT Or ty = TY_PTR_FUNC Then Exit Sub
    If LowExprIsU32(ctx, rhsIdx) <> 0 Or LowWideIsIntLit(ctx, rhsIdx) <> 0 Then
        LowEmitZxEax(ctx->list)
        Exit Sub
    End If
    IrEmit(ctx->list, OP_MOVSXD_RAX_EAX, 0, 0)
End Sub

' 整数のリテラル（3000000000 は 0..4294967295 として読む。-5 は単項の - なので Long の式）
Function LowWideIsIntLit(ctx As *LowerCtx, idx As Long) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    LowWideIsIntLit = 0
    If LowNodeKind(ctx, idx) <> AST_NUM Then Exit Function
    ast = ctx->ast
    nodes = ast->nodes
    If nodes[idx].extra = AST_NUM_EXTRA_SINGLE Or nodes[idx].extra = AST_NUM_EXTRA_DOUBLE Then Exit Function
    LowWideIsIntLit = 1
End Function

' 64bit の式 e（rax）を Double へ。QWord は符号なしで（2^63 以上も）
Sub LowEmitCvtWideToDouble(ctx As *LowerCtx, e As Long)
    If LowExprWide(ctx, e) = LOW_PTI_U64 Then
        IrEmit(ctx->list, OP_CVT_U64_TO_SD, 0, 0)
    Else
        IrEmit(ctx->list, OP_CVT_I64_TO_SD, 0, 0)
    End If
End Sub

' 入れる先が QWord のときの LowEmitCvtToWide（Double は 2^63 以上も符号なしで切り捨てる）
Sub LowEmitCvtToWideT(ctx As *LowerCtx, rhsIdx As Long, dstMark As Long)
    Dim ty As Long
    If dstMark = LOW_PTI_U64 And LowExprWide(ctx, rhsIdx) = 0 Then
        ty = LowExprType(ctx, rhsIdx)
        If ty = TY_DOUBLE Then
            IrEmit(ctx->list, OP_CVT_SD_TO_U64, 0, 0)
            Exit Sub
        End If
        If ty = TY_SINGLE Then
            IrEmit(ctx->list, OP_CVT_SS_TO_SD, 0, 0)
            IrEmit(ctx->list, OP_CVT_SD_TO_U64, 0, 0)
            Exit Sub
        End If
    End If
    LowEmitCvtToWide(ctx, rhsIdx)
End Sub
