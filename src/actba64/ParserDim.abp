' ===================================================
'  ParserDim - Dim / Const / Assign
' ===================================================

' bound: -1=scalar, 1D expr, or AST_ARG chain for rank >= 2 (max ARR_RANK_MAX)
' 戻り値 true : 正常終了  false : エラーあり
Function ParseDimBound(p As *Parser, ByRef bound As Long) As boolean
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nArgs As Long
    Dim closeKind As Long

    ParseDimBound = false
    bound = -1
    If ParseTokKind(p) = TK_LPAREN Then
        closeKind = TK_RPAREN
    ElseIf ParseTokKind(p) = TK_LBRACK Then
        closeKind = TK_RBRACK
    Else
        ParseDimBound = true
        Exit Function
    End If
    p->pos = p->pos + 1
    ast = p->ast
    bound = ParseIdxExprs(p, nArgs)
    If bound < 0 Then Exit Function
    If nArgs = 1 Then
        nodes = ast->nodes
        bound = nodes[bound].left
    End If
    If Not ParseExpect(p, closeKind) Then Exit Function
    ParseDimBound = true
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function ParseDimStringSuffix(name As *Byte, bound As Long, ByRef ty As Long, ByRef ti As Long) As boolean
    ParseDimStringSuffix = false
    ti = 0
    While name[ti] <> 0
        ti = ti + 1
    Wend
    If ti > 0 And name[ti - 1] = CH_DOLLAR And bound < 0 Then
        ty = TY_STRING
        ti = -1
        ParseDimStringSuffix = true
    End If
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function ParseAsPtrByteLong(p As *Parser, ByRef ty As Long) As boolean
    Dim kw(KW_LEN - 1) As Byte

    ParseAsPtrByteLong = false
    lstrcpy(VarPtr(kw), "byte")
    If ParseIdentIs(p, VarPtr(kw)) <> 0 Then
        p->pos = p->pos + 1
        ty = TY_PTR_BYTE
        ParseAsPtrByteLong = true
        Exit Function
    End If
    lstrcpy(VarPtr(kw), "long")
    If ParseIdentIs(p, VarPtr(kw)) <> 0 Then
        p->pos = p->pos + 1
        ty = TY_PTR_LONG
        ParseAsPtrByteLong = true
        Exit Function
    End If
    If ParseEatLongAlias(p) Then
        ty = TY_PTR_LONG
        ParseAsPtrByteLong = true
    End If
End Function

Function ParseAsPtrUdt(p As *Parser, ByRef ty As Long, ByRef ti As Long) As Long
    Dim typeName(SYM_NAME_LEN - 1) As Byte
    Dim types As *TypeTable
    Dim ast As *Ast

    ParseAsPtrUdt = 0
    ast = p->ast
    types = ast->types
    If Not ParseCopyIdent(p, VarPtr(typeName)) Then
        p->err = 1
        Exit Function
    End If
    ti = TyFind(types, VarPtr(typeName))
    If ti < 0 Then
        p->err = 1
        Exit Function
    End If
    ty = TY_PTR_UDT
    ParseAsPtrUdt = 1
End Function

Function ParseAsPtrDataType(p As *Parser, ByRef ty As Long, ByRef ti As Long) As Long
    ParseAsPtrDataType = 0
    If ParseAsPtrByteLong(p, ty) Then
        ParseAsPtrDataType = 1
        Exit Function
    End If
    ParseAsPtrDataType = ParseAsPtrUdt(p, ty, ti)
End Function

' ti: UDT 型番号、または TY_PTR_FUNC のとき戻り型（Sub は -1）
' params: TY_PTR_FUNC の仮引数鎖（それ以外は -1）
Function ParseAsPtrType(p As *Parser, ByRef ty As Long, ByRef ti As Long, ByRef params As Long) As Long
    ParseAsPtrType = 0
    params = -1
    p->pos = p->pos + 1
    If ParseFnPtrTry(p, ty, ti, params) Then
        ParseAsPtrType = 1
        Exit Function
    End If
    If p->err <> 0 Then Exit Function
    ParseAsPtrType = ParseAsPtrDataType(p, ty, ti)
End Function

Sub ParseAsLongTy(bound As Long, ByRef ty As Long)
    If bound >= 0 Then
        ty = TY_LONG_ARR
    Else
        ty = TY_LONG
    End If
End Sub

' 戻り値 true : 正常終了  false : エラーあり
Function ParseAsIntType(p As *Parser, bound As Long, ByRef ty As Long) As boolean
    Dim kw(KW_LEN - 1) As Byte

    ParseAsIntType = false
    lstrcpy(VarPtr(kw), "long")
    If ParseIdentIs(p, VarPtr(kw)) = 0 Then
        lstrcpy(VarPtr(kw), "integer")
        If ParseIdentIs(p, VarPtr(kw)) = 0 Then Exit Function
    End If
    ParseAsLongTy(bound, ty)
    p->pos = p->pos + 1
    ParseAsIntType = true
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function ParseAsStrByteType(p As *Parser, bound As Long, ByRef ty As Long) As boolean
    Dim kw(KW_LEN - 1) As Byte

    ParseAsStrByteType = false
    lstrcpy(VarPtr(kw), "string")
    If ParseIdentIs(p, VarPtr(kw)) <> 0 Then
        If bound >= 0 Then
            ty = TY_STRING_ARR
        Else
            ty = TY_STRING
        End If
        p->pos = p->pos + 1
        ParseAsStrByteType = true
        Exit Function
    End If
    lstrcpy(VarPtr(kw), "byte")
    If ParseIdentIs(p, VarPtr(kw)) <> 0 Then
        p->pos = p->pos + 1
        If bound >= 0 Then
            ty = TY_BYTE_ARR
        Else
            ty = TY_BYTE
        End If
        ParseAsStrByteType = true
    End If
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function ParseAsFloatType(p As *Parser, bound As Long, ByRef ty As Long) As boolean
    Dim kw(KW_LEN - 1) As Byte

    ParseAsFloatType = false
    lstrcpy(VarPtr(kw), "double")
    If ParseIdentIs(p, VarPtr(kw)) <> 0 Then
        p->pos = p->pos + 1
        If bound >= 0 Then
            ty = TY_DOUBLE_ARR
        Else
            ty = TY_DOUBLE
        End If
        ParseAsFloatType = true
        Exit Function
    End If
    lstrcpy(VarPtr(kw), "single")
    If ParseIdentIs(p, VarPtr(kw)) <> 0 Then
        p->pos = p->pos + 1
        If bound >= 0 Then
            ty = TY_SINGLE_ARR
        Else
            ty = TY_SINGLE
        End If
        ParseAsFloatType = true
    End If
End Function

Function ParseAsAliasOrUdt(p As *Parser, bound As Long, ByRef ty As Long, ByRef ti As Long) As Long
    Dim typeName(SYM_NAME_LEN - 1) As Byte
    Dim types As *TypeTable
    Dim ast As *Ast

    ParseAsAliasOrUdt = 0
    ast = p->ast
    types = ast->types
    If ParseEatBytePtrAlias(p) Then
        If bound >= 0 Then
            p->err = 1
            Exit Function
        End If
        ty = TY_PTR_BYTE
        ParseAsAliasOrUdt = 1
        Exit Function
    End If
    If ParseEatLongAlias(p) Then
        ParseAsLongTy(bound, ty)
        ParseAsAliasOrUdt = 1
        Exit Function
    End If
    If Not ParseCopyIdent(p, VarPtr(typeName)) Then
        p->err = 1
        Exit Function
    End If
    ti = TyFind(types, VarPtr(typeName))
    If ti < 0 Then
        p->err = 1
        Exit Function
    End If
    If bound >= 0 Then
        ty = TY_UDT_ARR
    Else
        ty = TY_UDT
    End If
    ParseAsAliasOrUdt = 1
End Function

Function ParseAsPrimType(p As *Parser, bound As Long, ByRef ty As Long, ByRef ti As Long) As Long
    ParseAsPrimType = 0
    If ParseAsIntType(p, bound, ty) Then
        ParseAsPrimType = 1
        Exit Function
    End If
    If ParseAsStrByteType(p, bound, ty) Then
        ParseAsPrimType = 1
        Exit Function
    End If
    If ParseAsFloatType(p, bound, ty) Then
        ParseAsPrimType = 1
        Exit Function
    End If
    ParseAsPrimType = ParseAsAliasOrUdt(p, bound, ty, ti)
End Function

' 戻り値 true : 正常終了  false : エラーあり
' #n88basic の Dim name（型なしスカラー）は Double
Function ParseDimN88Bare(p As *Parser, bound As Long, ByRef ty As Long, ByRef ti As Long) As boolean
    ParseDimN88Bare = false
    If p->n88Mode = 0 Then Exit Function
    If bound >= 0 Then Exit Function
    ty = TY_DOUBLE
    ti = -1
    ParseDimN88Bare = true
End Function

Function ParseDimNoAs(p As *Parser, name As *Byte, bound As Long, ByRef ty As Long, ByRef ti As Long) As boolean
    ParseDimNoAs = true
    If ParseDimStringSuffix(name, bound, ty, ti) Then Exit Function
    If ParseDimN88Bare(p, bound, ty, ti) Then Exit Function
    ParseFail(p, "expected 'As'")
    ParseDimNoAs = false
End Function

Function ParseDimAsInit(p As *Parser, ByRef ty As Long, ByRef ti As Long, ByRef params As Long) As Long
    Dim kAs(KW_SHORT_LEN - 1) As Byte
    ty = -1
    ti = -1
    params = -1
    lstrcpy(VarPtr(kAs), "as")
    ParseDimAsInit = ParseIdentIs(p, VarPtr(kAs))
End Function

Function ParseDimAsBody(p As *Parser, bound As Long, ByRef ty As Long, ByRef ti As Long, ByRef params As Long) As boolean
    ParseDimAsBody = false
    p->pos = p->pos + 1
    If ParseTokKind(p) = TK_STAR Then
        If ParseAsPtrType(p, ty, ti, params) = 0 Then Exit Function
    Else
        If ParseAsPrimType(p, bound, ty, ti) = 0 Then Exit Function
    End If
    ParseDimAsBody = true
End Function

Function ParseDimAsType(p As *Parser, name As *Byte, bound As Long, ByRef ty As Long, ByRef ti As Long, ByRef params As Long) As boolean
    If ParseDimAsInit(p, ty, ti, params) = 0 Then
        ParseDimAsType = ParseDimNoAs(p, name, bound, ty, ti)
    Else
        ParseDimAsType = ParseDimAsBody(p, bound, ty, ti, params)
    End If
End Function

Function ParseDimResolveFnPtrAlias(p As *Parser, ByRef ty As Long, ByRef ti As Long, ByRef params As Long) As Long
    Dim ast As *Ast
    Dim types As *TypeTable
    Dim retTy As Long
    Dim firsts As *Long
    Dim rets As *Long

    ParseDimResolveFnPtrAlias = 1
    If ty <> TY_UDT Then Exit Function
    If ti < 0 Then Exit Function
    ast = p->ast
    types = ast->types
    If TyIsFnPtr(types, ti) = 0 Then Exit Function
    firsts = types->typeFirst
    rets = types->typeVirtCount
    params = firsts[ti]
    retTy = rets[ti]
    ty = TY_PTR_FUNC
    ti = retTy
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function ParseDimClassCtor(p As *Parser, ty As Long, ti As Long, ByRef initE As Long) As boolean
    Dim types As *TypeTable
    Dim nArgs As Long
    Dim ast As *Ast

    ParseDimClassCtor = false
    ast = p->ast
    types = ast->types
    If ty = TY_UDT And ti >= 0 Then
        If TyIsClass(types, ti) <> 0 Then
            If ParseTokKind(p) = TK_LPAREN Then
                p->pos = p->pos + 1
                If ParseArgList(p, initE, nArgs) = 0 Then Exit Function
            End If
        End If
    End If
    ParseDimClassCtor = true
End Function

Function ParseDimBoundTyOk(ty As Long) As Long
    ParseDimBoundTyOk = 0
    If ty = TY_BYTE_ARR Then ParseDimBoundTyOk = 1
    If ty = TY_LONG_ARR Then ParseDimBoundTyOk = 1
    If ty = TY_STRING_ARR Then ParseDimBoundTyOk = 1
    If ty = TY_DOUBLE_ARR Then ParseDimBoundTyOk = 1
    If ty = TY_SINGLE_ARR Then ParseDimBoundTyOk = 1
    If ty = TY_UDT_ARR Then ParseDimBoundTyOk = 1
End Function

Function ParseDimMakeNode(p As *Parser, name As *Byte, ty As Long, bound As Long, initE As Long, ti As Long) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nDim As Long

    ParseDimMakeNode = -1
    ast = p->ast
    nDim = AstAddNode(ast, AST_DIM)
    If nDim < 0 Then Exit Function
    AstSetStr(ast, nDim, name)
    nodes = ast->nodes
    nodes[nDim].num = ty
    nodes[nDim].left = bound
    nodes[nDim].right = initE
    nodes[nDim].extra = ti
    ParseDimMakeNode = nDim
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function ParseDimOneInit(p As *Parser, ByRef initE As Long) As boolean
    ParseDimOneInit = false
    initE = -1
    If ParseTokKind(p) = TK_EQ Then
        p->pos = p->pos + 1
        initE = ParseExprNoAs(p)
        If initE < 0 Then Exit Function
    End If
    ParseDimOneInit = true
End Function

Function ParseDimOneTail(p As *Parser, ByRef initE As Long) As Long
    ParseDimOneTail = 0
    If ParseTokKind(p) = TK_EQ Then
        If initE >= 0 Then
            p->err = 1
            Exit Function
        End If
        p->pos = p->pos + 1
        initE = ParseExprNoAs(p)
        If initE < 0 Then Exit Function
    End If
    ParseDimOneTail = 1
End Function

Function ParseDimOneTyped(p As *Parser, name As *Byte, ByRef ty As Long, ByRef bound As Long, ByRef ti As Long, ByRef initE As Long) As Long
    Dim params As Long

    ParseDimOneTyped = 0
    If Not ParseDimAsType(p, name, bound, ty, ti, params) Then Exit Function
    If ParseDimResolveFnPtrAlias(p, ty, ti, params) = 0 Then Exit Function
    If ty < 0 Then
        p->err = 1
        Exit Function
    End If
    If bound >= 0 Then
        If ParseDimBoundTyOk(ty) = 0 Then
            p->err = 1
            Exit Function
        End If
    End If
    If ty = TY_PTR_FUNC Then bound = params
    If Not ParseDimClassCtor(p, ty, ti, initE) Then Exit Function
    ParseDimOneTyped = ParseDimOneTail(p, initE)
End Function

Function ParseDimOne(p As *Parser) As Long
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim ty As Long
    Dim bound As Long
    Dim ti As Long
    Dim initE As Long

    ParseDimOne = -1
    If Not ParseCopyIdent(p, VarPtr(name)) Then Exit Function
    If Not ParseDimBound(p, bound) Then Exit Function
    If Not ParseDimOneInit(p, initE) Then Exit Function
    If ParseDimOneTyped(p, VarPtr(name), ty, bound, ti, initE) = 0 Then Exit Function
    ParseDimOne = ParseDimMakeNode(p, VarPtr(name), ty, bound, initE, ti)
End Function

Function ParseDimStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nFirst As Long
    Dim nPrev As Long
    Dim nDim As Long

    ParseDimStmt = -1
    p->pos = p->pos + 1
    nFirst = -1
    nPrev = -1
    ast = p->ast
    Do
        nDim = ParseDimOne(p)
        If nDim < 0 Then Exit Function
        If nFirst < 0 Then
            nFirst = nDim
        Else
            nodes = ast->nodes
            nodes[nPrev].nxt = nDim
        End If
        nPrev = nDim
        If ParseTokKind(p) <> TK_COMMA Then Exit Do
        p->pos = p->pos + 1
    Loop
    ParseDimStmt = nFirst
End Function
