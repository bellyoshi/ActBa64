' ===================================================
'  ParserDim - Dim / Const / Assign
' ===================================================

Function ParseDimBound(p As *Parser, ByRef bound As Long) As Long
    ParseDimBound = 0
    bound = -1
    If ParseTokKind(p) = TK_LPAREN Then
        p->pos = p->pos + 1
        bound = ParseExpr(p)
        If bound < 0 Then Exit Function
        If ParseExpect(p, TK_RPAREN) = 0 Then Exit Function
    ElseIf ParseTokKind(p) = TK_LBRACK Then
        p->pos = p->pos + 1
        bound = ParseExpr(p)
        If bound < 0 Then Exit Function
        If ParseExpect(p, TK_RBRACK) = 0 Then Exit Function
    End If
    ParseDimBound = 1
End Function

Function ParseDimStringSuffix(name As *Byte, bound As Long, ByRef ty As Long, ByRef ti As Long) As Long
    ParseDimStringSuffix = 0
    ti = 0
    While name[ti] <> 0
        ti = ti + 1
    Wend
    If ti > 0 And name[ti - 1] = 36 And bound < 0 Then
        ty = TY_STRING
        ti = -1
        ParseDimStringSuffix = 1
    End If
End Function

Function ParseAsPtrType(p As *Parser, ByRef ty As Long, ByRef ti As Long) As Long
    Dim typeName(63) As Byte
    Dim k(15) As Byte
    Dim types As *TypeTable
    Dim ast As *Ast

    ParseAsPtrType = 0
    ast = p->ast
    types = ast->types
    p->pos = p->pos + 1
    lstrcpy(VarPtr(k), "byte")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p->pos = p->pos + 1
        ty = TY_PTR_BYTE
        ParseAsPtrType = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "long")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p->pos = p->pos + 1
        ty = TY_PTR_LONG
        ParseAsPtrType = 1
        Exit Function
    End If
    If ParseEatLongAlias(p) <> 0 Then
        ty = TY_PTR_LONG
        ParseAsPtrType = 1
        Exit Function
    End If
    If ParseCopyIdent(p, VarPtr(typeName)) = 0 Then
        p->err = 1
        Exit Function
    End If
    ti = TyFind(types, VarPtr(typeName))
    If ti < 0 Then
        p->err = 1
        Exit Function
    End If
    ty = TY_PTR_UDT
    ParseAsPtrType = 1
End Function

Sub ParseAsLongTy(bound As Long, ByRef ty As Long)
    If bound >= 0 Then
        ty = TY_LONG_ARR
    Else
        ty = TY_LONG
    End If
End Sub

Function ParseAsIntType(p As *Parser, bound As Long, ByRef ty As Long) As Long
    Dim k(15) As Byte

    ParseAsIntType = 0
    lstrcpy(VarPtr(k), "long")
    If ParseIdentIs(p, VarPtr(k)) = 0 Then
        lstrcpy(VarPtr(k), "integer")
        If ParseIdentIs(p, VarPtr(k)) = 0 Then Exit Function
    End If
    ParseAsLongTy(bound, ty)
    p->pos = p->pos + 1
    ParseAsIntType = 1
End Function

Function ParseAsStrByteType(p As *Parser, bound As Long, ByRef ty As Long) As Long
    Dim k(15) As Byte

    ParseAsStrByteType = 0
    lstrcpy(VarPtr(k), "string")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        If bound >= 0 Then
            ty = TY_STRING_ARR
        Else
            ty = TY_STRING
        End If
        p->pos = p->pos + 1
        ParseAsStrByteType = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "byte")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p->pos = p->pos + 1
        If bound >= 0 Then
            ty = TY_BYTE_ARR
        Else
            ty = TY_BYTE
        End If
        ParseAsStrByteType = 1
    End If
End Function

Function ParseAsFloatType(p As *Parser, bound As Long, ByRef ty As Long) As Long
    Dim k(15) As Byte

    ParseAsFloatType = 0
    lstrcpy(VarPtr(k), "double")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p->pos = p->pos + 1
        If bound >= 0 Then
            ty = TY_DOUBLE_ARR
        Else
            ty = TY_DOUBLE
        End If
        ParseAsFloatType = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "single")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p->pos = p->pos + 1
        If bound >= 0 Then
            ty = TY_SINGLE_ARR
        Else
            ty = TY_SINGLE
        End If
        ParseAsFloatType = 1
    End If
End Function

Function ParseAsAliasOrUdt(p As *Parser, bound As Long, ByRef ty As Long, ByRef ti As Long) As Long
    Dim typeName(63) As Byte
    Dim types As *TypeTable
    Dim ast As *Ast

    ParseAsAliasOrUdt = 0
    ast = p->ast
    types = ast->types
    If ParseEatBytePtrAlias(p) <> 0 Then
        If bound >= 0 Then
            p->err = 1
            Exit Function
        End If
        ty = TY_PTR_BYTE
        ParseAsAliasOrUdt = 1
        Exit Function
    End If
    If ParseEatLongAlias(p) <> 0 Then
        ParseAsLongTy(bound, ty)
        ParseAsAliasOrUdt = 1
        Exit Function
    End If
    If ParseCopyIdent(p, VarPtr(typeName)) = 0 Then
        p->err = 1
        Exit Function
    End If
    ti = TyFind(types, VarPtr(typeName))
    If ti < 0 Then
        p->err = 1
        Exit Function
    End If
    If bound >= 0 Then
        ty = TY_UDT_ARR
    Else
        ty = TY_UDT
    End If
    ParseAsAliasOrUdt = 1
End Function

Function ParseAsPrimType(p As *Parser, bound As Long, ByRef ty As Long, ByRef ti As Long) As Long
    ParseAsPrimType = 0
    If ParseAsIntType(p, bound, ty) <> 0 Then
        ParseAsPrimType = 1
        Exit Function
    End If
    If ParseAsStrByteType(p, bound, ty) <> 0 Then
        ParseAsPrimType = 1
        Exit Function
    End If
    If ParseAsFloatType(p, bound, ty) <> 0 Then
        ParseAsPrimType = 1
        Exit Function
    End If
    ParseAsPrimType = ParseAsAliasOrUdt(p, bound, ty, ti)
End Function

Function ParseDimAsType(p As *Parser, name As *Byte, bound As Long, ByRef ty As Long, ByRef ti As Long) As Long
    Dim kAs(7) As Byte

    ParseDimAsType = 0
    ty = -1
    ti = -1
    lstrcpy(VarPtr(kAs), "as")
    If ParseIdentIs(p, VarPtr(kAs)) = 0 Then
        If ParseDimStringSuffix(name, bound, ty, ti) = 0 Then
            p->err = 1
            Exit Function
        End If
        ParseDimAsType = 1
        Exit Function
    End If
    p->pos = p->pos + 1
    If ParseTokKind(p) = TK_STAR Then
        If ParseAsPtrType(p, ty, ti) = 0 Then Exit Function
    Else
        If ParseAsPrimType(p, bound, ty, ti) = 0 Then Exit Function
    End If
    ParseDimAsType = 1
End Function

Function ParseDimClassCtor(p As *Parser, ty As Long, ti As Long, ByRef initE As Long) As Long
    Dim types As *TypeTable
    Dim nArgs As Long
    Dim ast As *Ast

    ParseDimClassCtor = 0
    ast = p->ast
    types = ast->types
    If ty = TY_UDT And ti >= 0 Then
        If TyIsClass(types, ti) <> 0 Then
            If ParseTokKind(p) = TK_LPAREN Then
                p->pos = p->pos + 1
                If ParseArgList(p, initE, nArgs) = 0 Then Exit Function
            End If
        End If
    End If
    ParseDimClassCtor = 1
End Function

Function ParseDimBoundTyOk(ty As Long) As Long
    ParseDimBoundTyOk = 0
    If ty = TY_BYTE_ARR Then ParseDimBoundTyOk = 1
    If ty = TY_LONG_ARR Then ParseDimBoundTyOk = 1
    If ty = TY_STRING_ARR Then ParseDimBoundTyOk = 1
    If ty = TY_DOUBLE_ARR Then ParseDimBoundTyOk = 1
    If ty = TY_SINGLE_ARR Then ParseDimBoundTyOk = 1
    If ty = TY_UDT_ARR Then ParseDimBoundTyOk = 1
End Function

Function ParseDimMakeNode(p As *Parser, name As *Byte, ty As Long, bound As Long, initE As Long, ti As Long) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nDim As Long

    ParseDimMakeNode = -1
    ast = p->ast
    nDim = AstAddNode(ast, AST_DIM)
    If nDim < 0 Then Exit Function
    AstSetStr(ast, nDim, name)
    nodes = ast->nodes
    nodes[nDim].num = ty
    nodes[nDim].left = bound
    nodes[nDim].right = initE
    nodes[nDim].extra = ti
    ParseDimMakeNode = nDim
End Function

Function ParseDimOne(p As *Parser) As Long
    Dim name(63) As Byte
    Dim ty As Long
    Dim bound As Long
    Dim ti As Long
    Dim initE As Long

    ParseDimOne = -1
    If ParseCopyIdent(p, VarPtr(name)) = 0 Then Exit Function
    If ParseDimBound(p, bound) = 0 Then Exit Function
    initE = -1
    If ParseTokKind(p) = TK_EQ Then
        p->pos = p->pos + 1
        initE = ParseExprNoAs(p)
        If initE < 0 Then Exit Function
    End If
    If ParseDimAsType(p, VarPtr(name), bound, ty, ti) = 0 Then Exit Function
    If ty < 0 Then
        p->err = 1
        Exit Function
    End If
    If bound >= 0 Then
        If ParseDimBoundTyOk(ty) = 0 Then
            p->err = 1
            Exit Function
        End If
    End If
    If ParseDimClassCtor(p, ty, ti, initE) = 0 Then Exit Function
    If ParseTokKind(p) = TK_EQ Then
        If initE >= 0 Then
            p->err = 1
            Exit Function
        End If
        p->pos = p->pos + 1
        initE = ParseExprNoAs(p)
        If initE < 0 Then Exit Function
    End If
    ParseDimOne = ParseDimMakeNode(p, VarPtr(name), ty, bound, initE, ti)
End Function

Function ParseDimStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nFirst As Long
    Dim nPrev As Long
    Dim nDim As Long

    ParseDimStmt = -1
    p->pos = p->pos + 1
    nFirst = -1
    nPrev = -1
    ast = p->ast
    Do
        nDim = ParseDimOne(p)
        If nDim < 0 Then Exit Function
        If nFirst < 0 Then
            nFirst = nDim
        Else
            nodes = ast->nodes
            nodes[nPrev].nxt = nDim
        End If
        nPrev = nDim
        If ParseTokKind(p) <> TK_COMMA Then Exit Do
        p->pos = p->pos + 1
    Loop
    ParseDimStmt = nFirst
End Function
