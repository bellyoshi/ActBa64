' ParserPrintUsing - Print Using fmt; a, b ... を
'   Print PuUseEnd$(PuUseVal$(PuUseVal$(PuUseBeg$(fmt), a), b)) にする（Include の Using.abp）
' 文末が ; / , なら改行しない。PuUseVal$ は引数の型で Double / Long / String を呼び分ける。

Function ParseAddArg(ast As *Ast, e As Long, prev As Long) As Long
    Dim nodes As *AstNode
    Dim arg1 As Long
    arg1 = AstAddNode(ast, AST_ARG)
    ParseAddArg = arg1
    If arg1 < 0 Then Exit Function
    nodes = ast->nodes
    nodes[arg1].left = e
    If prev >= 0 Then nodes[prev].nxt = arg1
End Function

Sub ParseCallSet(ast As *Ast, n As Long, a0 As Long, cnt As Long)
    Dim nodes As *AstNode
    nodes = ast->nodes
    nodes[n].left = a0
    nodes[n].num = cnt
    nodes[n].right = -1
    nodes[n].extra = -1
End Sub

Function ParseCallN(ast As *Ast, name As *Byte, a0 As Long, cnt As Long) As Long
    Dim n As Long
    n = AstAddNode(ast, AST_CALL)
    ParseCallN = n
    If n < 0 Then Exit Function
    AstSetStr(ast, n, name)
    ParseCallSet(ast, n, a0, cnt)
End Function

' 0 = PuUseBeg$  1 = PuUseVal$  2 = PuUseEnd$
Sub ParseUsingName(which As Long, name As *Byte)
    lstrcpy(name, "PuUseBeg$")
    If which = 1 Then lstrcpy(name, "PuUseVal$")
    If which = 2 Then lstrcpy(name, "PuUseEnd$")
End Sub

Function ParseUsingArgN(y As Long) As Long
    ParseUsingArgN = 1
    If y >= 0 Then ParseUsingArgN = 2
End Function

' which の関数を引数 x（と y。y < 0 なら 1 引数）で呼ぶ式
Function ParseUsingCall(p As *Parser, which As Long, x As Long, y As Long) As Long
    Dim ast As *Ast
    Dim a0 As Long
    Dim name(SYM_NAME_LEN - 1) As Byte
    ast = p->ast
    ParseUsingName(which, VarPtr(name))
    a0 = ParseAddArg(ast, x, -1)
    If y >= 0 Then ParseAddArg(ast, y, a0)
    ParseUsingCall = ParseCallN(ast, VarPtr(name), a0, ParseUsingArgN(y))
End Function

Sub ParsePrintSet(ast As *Ast, nPrint As Long, nFile As Long, nArg As Long, stay As Long)
    Dim nodes As *AstNode
    nodes = ast->nodes
    nodes[nPrint].left = nFile
    nodes[nPrint].right = nArg
    nodes[nPrint].num = stay
End Sub

Function ParsePrintNode(ast As *Ast, nFile As Long, nArg As Long, stay As Long) As Long
    Dim nPrint As Long
    nPrint = AstAddNode(ast, AST_PRINT)
    ParsePrintNode = -1
    If nArg < 0 Or nPrint < 0 Then Exit Function
    ParsePrintSet(ast, nPrint, nFile, nArg, stay)
    ParsePrintNode = nPrint
End Function

Function ParsePrintWrap(p As *Parser, nFile As Long, expr As Long, stay As Long) As Long
    Dim ast As *Ast
    Dim nArg As Long
    ast = p->ast
    nArg = ParseAddArg(ast, expr, -1)
    ParsePrintWrap = ParsePrintNode(ast, nFile, nArg, stay)
End Function

Function ParseUsingSep(p As *Parser) As Long
    Dim k As Long
    k = ParseTokKind(p)
    ParseUsingSep = 0
    If k <> TK_SEMI And k <> TK_COMMA Then Exit Function
    p->pos = p->pos + 1
    ParseUsingSep = 1
End Function

' 値のあとの ; / ,。1 = 同じ行に次の値  0 = 終わり（区切りで終わったら stay = 1）
Function ParseUsingNext(p As *Parser, ByRef stay As Long) As Long
    Dim srcLine As Long
    ParseUsingNext = 0
    srcLine = ParseTokLogLine(p)
    If ParseUsingSep(p) = 0 Then Exit Function
    stay = 1
    If ParseIoSemiRewind(p, srcLine) Then Exit Function
    stay = 0
    ParseUsingNext = 1
End Function

' 値を 1 つ読み、acc を PuUseVal$(acc, 値) で包む
Function ParseUsingVal(p As *Parser, acc As Long) As Long
    Dim val As Long
    ParseUsingVal = -1
    val = ParseExpr(p)
    If val < 0 Then Exit Function
    ParseUsingVal = ParseUsingCall(p, 1, acc, val)
End Function

Function ParseUsingMore(p As *Parser, acc As Long, ByRef stay As Long) As Long
    ParseUsingMore = 0
    If acc >= 0 Then ParseUsingMore = ParseUsingNext(p, stay)
End Function

Function ParseUsingVals(p As *Parser, acc As Long, ByRef stay As Long) As Long
    Dim more As Long
    more = 1
    stay = 0
    While more <> 0
        acc = ParseUsingVal(p, acc)
        more = ParseUsingMore(p, acc, stay)
    Wend
    ParseUsingVals = acc
End Function

Function ParseUsingChain(p As *Parser, fmt As Long, ByRef stay As Long) As Long
    Dim acc As Long
    ParseUsingChain = -1
    acc = ParseUsingCall(p, 0, fmt, -1)
    If acc >= 0 Then acc = ParseUsingVals(p, acc, stay)
    If acc < 0 Then Exit Function
    ParseUsingChain = ParseUsingCall(p, 2, acc, -1)
End Function

Function ParsePrintUsingBody(p As *Parser, nFile As Long) As Long
    Dim fmt As Long
    Dim acc As Long
    Dim stay As Long
    ParsePrintUsingBody = -1
    fmt = ParseExpr(p)
    If fmt < 0 Or ParseUsingSep(p) = 0 Then Exit Function
    acc = ParseUsingChain(p, fmt, stay)
    If acc >= 0 Then ParsePrintUsingBody = ParsePrintWrap(p, nFile, acc, stay)
End Function

Function ParseUsingLead(p As *Parser, ByRef nFile As Long) As Long
    Dim kw(KW_LEN - 1) As Byte
    ParseUsingLead = 0
    If Not ParseHashFilePrefix(p, nFile) Then Exit Function
    lstrcpy(VarPtr(kw), "using")
    If ParseIdentIs(p, VarPtr(kw)) = 0 Then Exit Function
    p->pos = p->pos + 1
    ParseUsingLead = 1
End Function

Function ParsePrintUsingTry(p As *Parser, atPrint As Long) As Long
    Dim nFile As Long
    If ParseUsingLead(p, nFile) = 0 Then
        p->pos = atPrint
        ParsePrintUsingTry = ParsePrintStmt(p)
        Exit Function
    End If
    ParsePrintUsingTry = ParsePrintUsingBody(p, nFile)
End Function

Function ParsePrintOrUsing(p As *Parser) As Long
    Dim atPrint As Long
    atPrint = p->pos
    p->pos = p->pos + 1
    ParsePrintOrUsing = ParsePrintUsingTry(p, atPrint)
End Function
