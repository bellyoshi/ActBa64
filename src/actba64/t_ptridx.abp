#console
Declare Function ExitProcess Lib "kernel32.dll" (uExitCode As Long) As Long
Type Lx
    pos As Long
End Type
Function Scan(lx As *Lx, src As *Byte) As Long
    Dim n As Long
    n = 0
    While src[lx->pos] <> 0
        n = n + 1
        lx->pos = lx->pos + 1
        If n > 1000 Then
            Scan = -1
            Exit Function
        End If
    Wend
    Scan = n
End Function
Sub Main()
    Dim lx As Lx
    Dim buf(20) As Byte
    Dim n As Long
    Dim i As Long
    i = 0
    While i < 5
        buf[i] = 65 + i
        i = i + 1
    Wend
    buf[5] = 0
    lx.pos = 0
    n = Scan(VarPtr(lx), VarPtr(buf))
    If n <> 5 Then ExitProcess(10 + n)
    ExitProcess(42)
End Sub
Main()
End
