' CharUtils.abp - 文字コード定数と判定
' Asc("x") や生の文字コード即値の代わりに使う
' 注意: Const 名は小文字化されるため CH_A と CH_a は共存不可
'       小文字アルファベットは CH_LA .. CH_LZ を使う

' --- 制御 / 空白 ---
Const CH_TAB = 9
Const CH_NL = 10
Const CH_CR = 13
Const CH_SP = 32

' --- 記号 ---
Const CH_DQUOTE = 34
Const CH_HASH = 35
Const CH_DOLLAR = 36
Const CH_AMP = 38
Const CH_SQUOTE = 39
Const CH_LPAREN = 40
Const CH_RPAREN = 41
Const CH_STAR = 42
Const CH_PLUS = 43
Const CH_COMMA = 44
Const CH_MINUS = 45
Const CH_DOT = 46
Const CH_SLASH = 47
Const CH_0 = 48
Const CH_9 = 57
Const CH_COLON = 58
Const CH_SEMI = 59
Const CH_LESS = 60
Const CH_EQ = 61
Const CH_GREATER = 62
Const CH_AT = 64
Const CH_LBRACK = 91
Const CH_BSLASH = 92
Const CH_RBRACK = 93
Const CH_UNDER = 95

' --- 大文字（範囲・&H / hex）---
Const CH_A = 65
Const CH_F = 70
Const CH_H = 72
Const CH_I = 73
Const CH_X = 88
Const CH_Z = 90

' --- 小文字 a-z（CH_A と衝突しないよう L 接頭）---
Const CH_LA = 97
Const CH_LB = 98
Const CH_LC = 99
Const CH_LD = 100
Const CH_LE = 101
Const CH_LF = 102
Const CH_LG = 103
Const CH_LH = 104
Const CH_LI = 105
Const CH_LJ = 106
Const CH_LK = 107
Const CH_LL = 108
Const CH_LM = 109
Const CH_LN = 110
Const CH_LO = 111
Const CH_LP = 112
Const CH_LQ = 113
Const CH_LR = 114
Const CH_LS = 115
Const CH_LT = 116
Const CH_LU = 117
Const CH_LV = 118
Const CH_LW = 119
Const CH_LX = 120
Const CH_LY = 121
Const CH_LZ = 122

Function IsLower(c As Long) As Long
    If c >= CH_LA And c <= CH_LZ Then
        IsLower = 1
    Else
        IsLower = 0
    End If
End Function

Function IsUpper(c As Long) As Long
    If c >= CH_A And c <= CH_Z Then
        IsUpper = 1
    Else
        IsUpper = 0
    End If
End Function

Function IsAlphabet(c As Long) As Long
    If IsUpper(c) <> 0 Or IsLower(c) <> 0 Then
        IsAlphabet = 1
    Else
        IsAlphabet = 0
    End If
End Function

Function IsDigit(c As Long) As Long
    If c >= CH_0 And c <= CH_9 Then
        IsDigit = 1
    Else
        IsDigit = 0
    End If
End Function

Function IsHexDigit(c As Long) As Long
    If IsDigit(c) <> 0 Then
        IsHexDigit = 1
    ElseIf c >= CH_A And c <= CH_F Then
        IsHexDigit = 1
    ElseIf c >= CH_LA And c <= CH_LF Then
        IsHexDigit = 1
    Else
        IsHexDigit = 0
    End If
End Function

' 大文字なら小文字へ。それ以外はそのまま
Function ToLowerChar(c As Long) As Long
    If IsUpper(c) <> 0 Then
        ToLowerChar = c + 32
    Else
        ToLowerChar = c
    End If
End Function
