' ===================================================
'  CodeBuffer + x64 emitters (RIP-relative)
' ===================================================

Dim g_IsDebugAsm As Long

Sub WriteAsmLine(s As String)
End Sub

Type CodeBuffer
    buf As *Byte
    capacity As Long
    size As Long
End Type

Sub EmitByte(cb As *CodeBuffer, b As Byte)
    Dim q As *Byte
    If cb->size >= cb->capacity Then Exit Sub
    PtrAddTo(cb->buf, cb->size, q)
    q[0] = b
    cb->size = cb->size + 1
End Sub

Sub EmitDword(cb As *CodeBuffer, dw As DWord)
    If cb->size + 4 > cb->capacity Then Exit Sub
    PutDword(cb->buf, cb->size, dw)
    cb->size = cb->size + 4
End Sub

Sub EmitCallRip(cb As *CodeBuffer, targetRva As DWord, textBaseRva As DWord)
    Dim nextRip As DWord
    EmitByte(cb, &HFF)
    EmitByte(cb, &H15)
    nextRip = textBaseRva + cb->size + 4
    EmitDword(cb, targetRva - nextRip)
End Sub

Sub EmitLeaRdxRip(cb As *CodeBuffer, targetRva As DWord, textBaseRva As DWord)
    Dim nextRip As DWord
    EmitByte(cb, &H48)
    EmitByte(cb, &H8D)
    EmitByte(cb, &H15)
    nextRip = textBaseRva + cb->size + 4
    EmitDword(cb, targetRva - nextRip)
End Sub

Sub EmitLeaR8Rip(cb As *CodeBuffer, targetRva As DWord, textBaseRva As DWord)
    Dim nextRip As DWord
    EmitByte(cb, &H4C)
    EmitByte(cb, &H8D)
    EmitByte(cb, &H05)
    nextRip = textBaseRva + cb->size + 4
    EmitDword(cb, targetRva - nextRip)
End Sub

' push rbp; mov rbp, rsp; sub rsp, imm32
Sub EmitEnter(cb As *CodeBuffer, frameSize As DWord)
    EmitByte(cb, &H55)
    EmitByte(cb, &H48)
    EmitByte(cb, &H89)
    EmitByte(cb, &HE5)
    EmitByte(cb, &H48)
    EmitByte(cb, &H81)
    EmitByte(cb, &HEC)
    EmitDword(cb, frameSize)
End Sub

' leave; ret  => mov rsp,rbp; pop rbp; ret
Sub EmitLeaveRet(cb As *CodeBuffer)
    EmitByte(cb, &HC9)
    EmitByte(cb, &HC3)
End Sub

Sub EmitSubRsp(cb As *CodeBuffer, imm8 As Byte)
    EmitByte(cb, &H48)
    EmitByte(cb, &H83)
    EmitByte(cb, &HEC)
    EmitByte(cb, imm8)
End Sub

Sub EmitAddRsp(cb As *CodeBuffer, imm8 As Byte)
    EmitByte(cb, &H48)
    EmitByte(cb, &H83)
    EmitByte(cb, &HC4)
    EmitByte(cb, imm8)
End Sub

Sub EmitXorEcx(cb As *CodeBuffer)
    EmitByte(cb, &H31)
    EmitByte(cb, &HC9)
End Sub

Sub EmitXorR9d(cb As *CodeBuffer)
    EmitByte(cb, &H45)
    EmitByte(cb, &H31)
    EmitByte(cb, &HC9)
End Sub

Sub EmitRet(cb As *CodeBuffer)
    EmitByte(cb, &HC3)
End Sub

Sub EmitMovEcxImm(cb As *CodeBuffer, imm As DWord)
    EmitByte(cb, &HB9)
    EmitDword(cb, imm)
End Sub

Sub EmitMovEaxImm(cb As *CodeBuffer, imm As DWord)
    EmitByte(cb, &HB8)
    EmitDword(cb, imm)
End Sub

' mov rax, [rbp + disp32]
Sub EmitLoadLocal(cb As *CodeBuffer, disp As Long)
    EmitByte(cb, &H48)
    EmitByte(cb, &H8B)
    EmitByte(cb, &H85)
    EmitDword(cb, disp)
End Sub

' mov [rbp + disp32], rax
Sub EmitStoreLocal(cb As *CodeBuffer, disp As Long)
    EmitByte(cb, &H48)
    EmitByte(cb, &H89)
    EmitByte(cb, &H85)
    EmitDword(cb, disp)
End Sub

Sub EmitPushRax(cb As *CodeBuffer)
    EmitByte(cb, &H50)
End Sub

Sub EmitPopRcx(cb As *CodeBuffer)
    EmitByte(cb, &H59)
End Sub

' add eax, ecx
Sub EmitAddEaxEcx(cb As *CodeBuffer)
    EmitByte(cb, &H01)
    EmitByte(cb, &HC8)
End Sub

' imul eax, ecx
Sub EmitImulEaxEcx(cb As *CodeBuffer)
    EmitByte(cb, &H0F)
    EmitByte(cb, &HAF)
    EmitByte(cb, &HC1)
End Sub

' mov ecx, eax
Sub EmitMovEcxEax(cb As *CodeBuffer)
    EmitByte(cb, &H89)
    EmitByte(cb, &HC1)
End Sub

' cmp ecx, eax
Sub EmitCmpEcxEax(cb As *CodeBuffer)
    EmitByte(cb, &H39)
    EmitByte(cb, &HC1)
End Sub

' cmp rcx, rax
Sub EmitCmpRcxRax(cb As *CodeBuffer)
    EmitByte(cb, &H48)
    EmitByte(cb, &H39)
    EmitByte(cb, &HC1)
End Sub

' test eax, eax
Sub EmitTestEax(cb As *CodeBuffer)
    EmitByte(cb, &H85)
    EmitByte(cb, &HC0)
End Sub

' add dword [rbp+disp], 1
Sub EmitIncLocal(cb As *CodeBuffer, disp As Long)
    EmitByte(cb, &HFF)
    EmitByte(cb, &H85)
    EmitDword(cb, disp)
End Sub

Sub EmitStoreLocalEcx(cb As *CodeBuffer, disp As Long)
    EmitByte(cb, &H48)
    EmitByte(cb, &H89)
    EmitByte(cb, &H8D)
    EmitDword(cb, disp)
End Sub

Sub EmitStoreLocalEdx(cb As *CodeBuffer, disp As Long)
    EmitByte(cb, &H48)
    EmitByte(cb, &H89)
    EmitByte(cb, &H95)
    EmitDword(cb, disp)
End Sub

Sub EmitMovEdxImm(cb As *CodeBuffer, imm As DWord)
    EmitByte(cb, &HBA)
    EmitDword(cb, imm)
End Sub

' mov edx, eax
Sub EmitMovEdxEax(cb As *CodeBuffer)
    EmitByte(cb, &H89)
    EmitByte(cb, &HC2)
End Sub

Sub EmitLeaRaxRip(cb As *CodeBuffer, targetRva As DWord, textBaseRva As DWord)
    Dim nextRip As DWord
    EmitByte(cb, &H48)
    EmitByte(cb, &H8D)
    EmitByte(cb, &H05)
    nextRip = textBaseRva + cb->size + 4
    EmitDword(cb, targetRva - nextRip)
End Sub

' jmp rel32 - returns offset of rel32 field for patching
Function EmitJmpRel32(cb As *CodeBuffer) As Long
    EmitByte(cb, &HE9)
    EmitJmpRel32 = cb->size
    EmitDword(cb, 0)
End Function

' jcc rel32
Function EmitJccRel32(cb As *CodeBuffer, cc As Byte) As Long
    EmitByte(cb, &H0F)
    EmitByte(cb, cc)
    EmitJccRel32 = cb->size
    EmitDword(cb, 0)
End Function

Sub EmitMovRaxGs8(cb As *CodeBuffer)
    EmitByte(cb, &H65)
    EmitByte(cb, &H48)
    EmitByte(cb, &H8B)
    EmitByte(cb, &H04)
    EmitByte(cb, &H25)
    EmitDword(cb, 8)
End Sub

Sub EmitMovR8Rsp(cb As *CodeBuffer)
    EmitByte(cb, &H4C)
    EmitByte(cb, &H8B)
    EmitByte(cb, &HC4)
End Sub

Sub EmitCmpR8Rax(cb As *CodeBuffer)
    EmitByte(cb, &H4C)
    EmitByte(cb, &H3B)
    EmitByte(cb, &HC0)
End Sub

Sub EmitAddR8Imm8(cb As *CodeBuffer, imm As Byte)
    EmitByte(cb, &H49)
    EmitByte(cb, &H83)
    EmitByte(cb, &HC0)
    EmitByte(cb, imm)
End Sub
