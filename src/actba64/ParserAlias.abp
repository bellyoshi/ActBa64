' BytePtr → バイトポインタ型（Long 別名ではない）
Function ParseEatBytePtrAlias(p As *Parser) As Long
    Dim kw(15) As Byte

    ParseEatBytePtrAlias = 0
    lstrcpy(VarPtr(kw), "byteptr")
    If ParseEatAliasIf(p, VarPtr(kw)) <> 0 Then
        ParseEatBytePtrAlias = 1
    End If
End Function

' dword/word/byte/handle/hwnd/integer → Long 相当（仮引数・戻り値）。一致で pos を進める
Function ParseEatLongAlias(p As *Parser) As Long
    ParseEatLongAlias = 0
    If ParseEatLongWidth(p) <> 0 Then
        ParseEatLongAlias = 1
        Exit Function
    End If
    If ParseEatLongWinH(p) <> 0 Then
        ParseEatLongAlias = 1
        Exit Function
    End If
    If ParseEatLongGdiH(p) <> 0 Then
        ParseEatLongAlias = 1
        Exit Function
    End If
    If ParseEatLongParam(p) <> 0 Then
        ParseEatLongAlias = 1
        Exit Function
    End If
    If ParseEatLongStrPtr(p) <> 0 Then
        ParseEatLongAlias = 1
    End If
End Function
