End Function

' VoidPtr はコード生成上 Long のまま。right = -2 は #strict の警告用。
Function ParseEatVoidPtrMark(p As *Parser, ByRef pty As Long, ByRef pti As Long) As Long
    Dim kw(KW_LEN - 1) As Byte
    ParseEatVoidPtrMark = 0
    lstrcpy(VarPtr(kw), "voidptr")
    If ParseEatAliasIf(p, VarPtr(kw)) = 0 Then
        ' Declare の ByRef x As Any は何でもアドレスで渡す。VoidPtr と同じに読む
        lstrcpy(VarPtr(kw), "any")
        If ParseEatAliasIf(p, VarPtr(kw)) = 0 Then Exit Function
    End If
    pty = TY_LONG
    pti = -2
    ParseEatVoidPtrMark = 1
End Function

' *Double / *Single / *Word / *BytePtr は TY_PTR_LONG と同じ幅で、pti に要素の型の印を置く
Function ParseEatStarElem(p As *Parser, ByRef pti As Long) As Long
    Dim kw(KW_LEN - 1) As Byte
    Dim mark As Long
    ParseEatStarElem = 0
    mark = ParseStarPtrMark(p)
    lstrcpy(VarPtr(kw), "double")
    If ParseIdentIs(p, VarPtr(kw)) <> 0 Then mark = LOW_PTI_DBL
    lstrcpy(VarPtr(kw), "single")
    If ParseIdentIs(p, VarPtr(kw)) <> 0 Then mark = LOW_PTI_SGL
    If mark = 0 Then Exit Function
    p->pos = p->pos + 1
    pti = mark
    ParseEatStarElem = 1
End Function

' *BytePtr / *VoidPtr（要素はポインタ幅）、*Word（要素は 2 バイト）の印。違えば 0
Function ParseStarPtrMark(p As *Parser) As Long
    Dim kw(KW_LEN - 1) As Byte
    ParseStarPtrMark = 0
    lstrcpy(VarPtr(kw), "byteptr")
    If ParseIdentIs(p, VarPtr(kw)) <> 0 Then ParseStarPtrMark = LOW_PTI_PTRV
    lstrcpy(VarPtr(kw), "voidptr")
    If ParseIdentIs(p, VarPtr(kw)) <> 0 Then ParseStarPtrMark = LOW_PTI_PTRV
    lstrcpy(VarPtr(kw), "word")
    If ParseIdentIs(p, VarPtr(kw)) <> 0 Then ParseStarPtrMark = LOW_PTI_WORD
End Function

' BytePtr → バイトポインタ型（Long 別名ではない）
' 戻り値 true : 成り立つ  false : 成り立たない
Function ParseEatBytePtrAlias(p As *Parser) As boolean
    Dim kw(KW_LEN - 1) As Byte

    ParseEatBytePtrAlias = false
    lstrcpy(VarPtr(kw), "byteptr")
    If ParseEatAliasIf(p, VarPtr(kw)) Then
        ParseEatBytePtrAlias = true
    End If
End Function

' dword/word/byte/handle/hwnd/integer → Long 相当（仮引数・戻り値）。一致で pos を進める
' 戻り値 true : 成り立つ  false : 成り立たない
Function ParseEatLongAlias(p As *Parser) As boolean
    ParseEatLongAlias = false
    If ParseEatLongWidth(p) Then
        ParseEatLongAlias = true
        Exit Function
    End If
    If ParseEatLongWinH(p) Then
        ParseEatLongAlias = true
        Exit Function
    End If
    If ParseEatLongGdiH(p) Then
        ParseEatLongAlias = true
        Exit Function
    End If
    If ParseEatLongPenBmp(p) Then
        ParseEatLongAlias = true
        Exit Function
    End If
    If ParseEatLongParam(p) Then
        ParseEatLongAlias = true
        Exit Function
    End If
    If ParseEatLongStrPtr(p) Then
        ParseEatLongAlias = true
    End If
End Function

Function ParseUserLongOk(p As *Parser, name As *Byte) As Long
    Dim ast As *Ast
    Dim types As *TypeTable
    Dim ti As Long
    ast = p->ast
    types = ast->types
    ti = TyFind(types, name)
    ParseUserLongOk = TyIsBareLong(types, ti)
End Function

' フィールドの無いポインタ幅の TypeDef（WordPtr など）なら読み進めて 1
Function ParseEatUserPtr(p As *Parser) As Long
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim ast As *Ast
    Dim ti As Long
    Dim pos0 As Long
    pos0 = p->pos
    ParseEatUserPtr = 0
    If Not ParseCopyIdent(p, VarPtr(name)) Then Exit Function
    ast = p->ast
    ti = TyFind(ast->types, VarPtr(name))
    If TyIsBareAlias(ast->types, ti) <> 0 And TySizeOfName(ast->types, VarPtr(name)) = TyPtrSize() Then ParseEatUserPtr = 1
    If ParseEatUserPtr = 0 Then p->pos = pos0
End Function

Function ParseEatUserLong(p As *Parser) As Long
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim pos0 As Long
    pos0 = p->pos
    ParseEatUserLong = 0
    If Not ParseCopyIdent(p, VarPtr(name)) Then Exit Function
    ParseEatUserLong = ParseUserLongOk(p, VarPtr(name))
    If ParseEatUserLong = 0 Then p->pos = pos0
End Function
