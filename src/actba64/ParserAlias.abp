' ParserAlias - 型エイリアス

' 戻り値 true : 正常終了  false : エラーあり
Function ParseCopyIdent(p As *Parser, dst As *Byte) As boolean
    Dim lx As *Lexer
    Dim toks As *Tok
    Dim i As Long
    ParseCopyIdent = false
    lx = p->lx
    toks = lx->toks
    i = p->pos
    If toks[i].kind <> TK_IDENT Then
        p->err = 1
        Exit Function
    End If
    LexCopyText(lx, toks[i].textSlot, dst)
    p->pos = p->pos + 1
    ParseCopyIdent = true
End Function

' 戻り値 true : 成り立つ  false : 成り立たない
Function ParseEatAliasIf(p As *Parser, lit As *Byte) As boolean
    ParseEatAliasIf = false
    If ParseIdentIs(p, lit) <> 0 Then
        p->pos = p->pos + 1
        ParseEatAliasIf = true
    End If
End Function

' 戻り値 true : 成り立つ  false : 成り立たない
Function ParseEatLongWidth(p As *Parser) As boolean
    Dim kw(NAME32_LEN - 1) As Byte

    ParseEatLongWidth = false
    lstrcpy(VarPtr(kw), "dword")
    If ParseEatAliasIf(p, VarPtr(kw)) Then
        ParseEatLongWidth = true
        Exit Function
    End If
    lstrcpy(VarPtr(kw), "word")
    If ParseEatAliasIf(p, VarPtr(kw)) Then
        ParseEatLongWidth = true
        Exit Function
    End If
    lstrcpy(VarPtr(kw), "byte")
    If ParseEatAliasIf(p, VarPtr(kw)) Then
        ParseEatLongWidth = true
        Exit Function
    End If
    lstrcpy(VarPtr(kw), "integer")
    If ParseEatAliasIf(p, VarPtr(kw)) Then
        ParseEatLongWidth = true
    End If
End Function

