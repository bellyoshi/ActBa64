' BytePtr → バイトポインタ型（Long 別名ではない）
Function ParseEatBytePtrAlias(p As *Parser) As Long
    Dim kw(KW_LEN - 1) As Byte

    ParseEatBytePtrAlias = 0
    lstrcpy(VarPtr(kw), "byteptr")
    If ParseEatAliasIf(p, VarPtr(kw)) <> 0 Then
        ParseEatBytePtrAlias = 1
    End If
End Function

' dword/word/byte/handle/hwnd/integer → Long 相当（仮引数・戻り値）。一致で pos を進める
Function ParseEatLongAlias(p As *Parser) As Long
    ParseEatLongAlias = 0
    If ParseEatLongWidth(p) <> 0 Then
        ParseEatLongAlias = 1
        Exit Function
    End If
    If ParseEatLongWinH(p) <> 0 Then
        ParseEatLongAlias = 1
        Exit Function
    End If
    If ParseEatLongGdiH(p) <> 0 Then
        ParseEatLongAlias = 1
        Exit Function
    End If
    If ParseEatLongParam(p) <> 0 Then
        ParseEatLongAlias = 1
        Exit Function
    End If
    If ParseEatLongStrPtr(p) <> 0 Then
        ParseEatLongAlias = 1
    End If
End Function

Function ParseUserLongOk(p As *Parser, name As *Byte) As Long
    Dim ast As *Ast
    Dim types As *TypeTable
    Dim ti As Long
    ast = p->ast
    types = ast->types
    ti = TyFind(types, name)
    ParseUserLongOk = TyIsBareLong(types, ti)
End Function

Function ParseEatUserLong(p As *Parser) As Long
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim pos0 As Long
    pos0 = p->pos
    ParseEatUserLong = 0
    If ParseCopyIdent(p, VarPtr(name)) = 0 Then Exit Function
    ParseEatUserLong = ParseUserLongOk(p, VarPtr(name))
    If ParseEatUserLong = 0 Then p->pos = pos0
End Function
