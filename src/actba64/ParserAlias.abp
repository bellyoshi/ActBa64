' ParserAlias - 型エイリアス

Function ParseCopyIdent(p As *Parser, dst As *Byte) As Long
    Dim lx As *Lexer
    Dim toks As *Tok
    Dim i As Long
    ParseCopyIdent = 0
    lx = p->lx
    toks = lx->toks
    i = p->pos
    If toks[i].kind <> TK_IDENT Then
        p->err = 1
        Exit Function
    End If
    LexCopyText(lx, toks[i].textSlot, dst)
    p->pos = p->pos + 1
    ParseCopyIdent = 1
End Function

Function ParseEatAliasIf(p As *Parser, lit As *Byte) As Long
    ParseEatAliasIf = 0
    If ParseIdentIs(p, lit) <> 0 Then
        p->pos = p->pos + 1
        ParseEatAliasIf = 1
    End If
End Function

Function ParseEatLongWidth(p As *Parser) As Long
    Dim kw(NAME32_LEN - 1) As Byte

    ParseEatLongWidth = 0
    lstrcpy(VarPtr(kw), "dword")
    If ParseEatAliasIf(p, VarPtr(kw)) <> 0 Then
        ParseEatLongWidth = 1
        Exit Function
    End If
    lstrcpy(VarPtr(kw), "word")
    If ParseEatAliasIf(p, VarPtr(kw)) <> 0 Then
        ParseEatLongWidth = 1
        Exit Function
    End If
    lstrcpy(VarPtr(kw), "byte")
    If ParseEatAliasIf(p, VarPtr(kw)) <> 0 Then
        ParseEatLongWidth = 1
        Exit Function
    End If
    lstrcpy(VarPtr(kw), "integer")
    If ParseEatAliasIf(p, VarPtr(kw)) <> 0 Then
        ParseEatLongWidth = 1
    End If
End Function

