' hpen / hbitmap はハンドル値。構造体のアドレスで渡すと線が描けない
Function ParseEatLongPenBmp(p As *Parser) As boolean
    Dim kw(NAME32_LEN - 1) As Byte
    ParseEatLongPenBmp = false
    lstrcpy(VarPtr(kw), "hpen")
    If ParseEatAliasIf(p, VarPtr(kw)) Then ParseEatLongPenBmp = true
    If ParseEatLongPenBmp Then Exit Function
    lstrcpy(VarPtr(kw), "hbitmap")
    If ParseEatAliasIf(p, VarPtr(kw)) Then ParseEatLongPenBmp = true
End Function

