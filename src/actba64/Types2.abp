' --- split from Types.abp (part 2) ---
Function TyAlignOf(t As *TypeTable, typeIdx As Long) As Long
    Dim fi As Long
    Dim nexts As *Long
    Dim firsts As *Long
    Dim sizes As *Long
    Dim tys As *Long
    Dim a As Long
    Dim best As Long
    Dim esz As Long
    Dim fty As Long

    TyAlignOf = 1
    If t = NULL Then Exit Function
    If typeIdx < 0 Or typeIdx >= t->nTypes Then Exit Function
    firsts = t->typeFirst
    nexts = t->fieldNext
    sizes = t->fieldSizes
    tys = t->fieldTypeIdxs
    best = 1
    fi = firsts[typeIdx]
    If fi < 0 Then
        TyAlignOf = TyAlignOfLeaf(t, typeIdx)
        Exit Function
    End If
    While fi >= 0
        fty = tys[fi]
        esz = sizes[fi]
        If fty >= 0 Then
            a = TyAlignOf(t, fty)
        Else
            a = esz
            If a > 8 Then a = 8
            If a < 1 Then a = 1
        End If
        If a > best Then best = a
        fi = nexts[fi]
    Wend
    If t->typeExplicitAlign[typeIdx] > best Then best = t->typeExplicitAlign[typeIdx]
    TyAlignOf = best
End Function

' End Type 時にサイズを型アラインへ切り上げ（MSVC 互換）
Sub TyFinalizeType(t As *TypeTable, typeIdx As Long)
    Dim tsizes As *Long
    Dim a As Long
    Dim sz As Long
    Dim remn As Long

    If t = NULL Then Exit Sub
    If typeIdx < 0 Or typeIdx >= t->nTypes Then Exit Sub
    a = TyAlignOf(t, typeIdx)
    If a < 1 Then Exit Sub
    tsizes = t->typeSizes
    sz = tsizes[typeIdx]
    remn = sz Mod a
    If remn <> 0 Then
        sz = sz + (a - remn)
        tsizes[typeIdx] = sz
    End If
End Sub

Function TyFieldAlign(t As *TypeTable, elemSize As Long, fieldTy As Long) As Long
    Dim align As Long
    ' ネスト UDT は「サイズ」ではなく「型のアライン」で整列（DXGI 等）
    If fieldTy >= 0 Then
        align = TyAlignOf(t, fieldTy)
    Else
        align = elemSize
    End If
    If align > 8 Then align = 8
    If align < 1 Then align = 1
    TyFieldAlign = align
End Function

Function TyAlignFieldOff(off As Long, align As Long) As Long
    Dim cur As Long
    Dim last As Long
    cur = align - 1
    last = off And cur
    While last <> 0
        off = off + 1
        last = off And cur
    Wend
    TyAlignFieldOff = off
End Function

Sub TyCopyFieldName(names As *Byte, fi As Long, name As *Byte)
    Dim j As Long
    Dim cur As Long
    j = 0
    cur = fi * TYNAME_LEN
    While name[j] <> 0 And j < TYNAME_LEN - 1
        names[cur + j] = name[j]
        j = j + 1
    Wend
    names[cur + j] = 0
End Sub

Sub TyLinkField(firsts As *Long, nexts As *Long, typeIdx As Long, fi As Long)
    Dim last As Long
    If firsts[typeIdx] < 0 Then
        firsts[typeIdx] = fi
    Else
        last = firsts[typeIdx]
        While nexts[last] >= 0
            last = nexts[last]
        Wend
        nexts[last] = fi
    End If
End Sub

Function TyAddField(t As *TypeTable, typeIdx As Long, name As *Byte, elemSize As Long, count As Long, fieldTy As Long) As Long
    Dim fi As Long
    Dim names As *Byte
    Dim offs As *Long
    Dim sizes As *Long
    Dim counts As *Long
    Dim nexts As *Long
    Dim firsts As *Long
    Dim tys As *Long
    Dim tsizes As *Long
    Dim off As Long
    Dim align As Long

    TyAddField = 0
    If t = NULL Then Exit Function
    If typeIdx < 0 Or typeIdx >= t->nTypes Then Exit Function
    If elemSize <= 0 Or count <= 0 Then Exit Function
    If TyEnsureFieldCap(t) = 0 Then Exit Function

    align = TyFieldAlign(t, elemSize, fieldTy)
    tsizes = t->typeSizes
    off = TyAlignFieldOff(tsizes[typeIdx], align)

    fi = t->nFields
    names = t->fieldNames
    offs = t->fieldOffs
    sizes = t->fieldSizes
    counts = t->fieldCounts
    nexts = t->fieldNext
    firsts = t->typeFirst
    tys = t->fieldTypeIdxs

    TyCopyFieldName(names, fi, name)
    offs[fi] = off
    sizes[fi] = elemSize
    counts[fi] = count
    tys[fi] = fieldTy
    nexts[fi] = -1

    TyLinkField(firsts, nexts, typeIdx, fi)

    tsizes[typeIdx] = off + elemSize * count
    t->nFields = fi + 1
    TyAddField = 1
End Function

Function TyFindField(t As *TypeTable, typeIdx As Long, name As *Byte, ByRef outOff As Long, ByRef outSize As Long, ByRef outCount As Long) As Long
    Dim fi As Long
    Dim names As *Byte
    Dim offs As *Long
    Dim sizes As *Long
    Dim counts As *Long
    Dim nexts As *Long
    Dim firsts As *Long
    Dim cur As Long

    TyFindField = 0
    outOff = 0
    outSize = 0
    outCount = 0
    If t = NULL Then Exit Function
    If typeIdx < 0 Or typeIdx >= t->nTypes Then Exit Function
    names = t->fieldNames
    offs = t->fieldOffs
    sizes = t->fieldSizes
    counts = t->fieldCounts
    nexts = t->fieldNext
    firsts = t->typeFirst
    fi = firsts[typeIdx]
    While fi >= 0
        cur = fi * TYNAME_LEN
        If TyNameEq(VarPtr(names[cur]), name) <> 0 Then
            outOff = offs[fi]
            outSize = sizes[fi]
            outCount = counts[fi]
            TyFindField = 1
            Exit Function
        End If
        fi = nexts[fi]
    Wend
End Function

Function TyFindFieldEx(t As *TypeTable, typeIdx As Long, name As *Byte, ByRef outOff As Long, ByRef outSize As Long, ByRef outCount As Long, ByRef outFieldTy As Long) As Long
    Dim fi As Long
    Dim names As *Byte
    Dim offs As *Long
    Dim sizes As *Long
    Dim counts As *Long
    Dim nexts As *Long
    Dim firsts As *Long
    Dim tys As *Long
    Dim cur As Long

    TyFindFieldEx = 0
    outOff = 0
    outSize = 0
    outCount = 0
    outFieldTy = -1
    If t = NULL Then Exit Function
    If typeIdx < 0 Or typeIdx >= t->nTypes Then Exit Function
    names = t->fieldNames
    offs = t->fieldOffs
    sizes = t->fieldSizes
    counts = t->fieldCounts
    nexts = t->fieldNext
    firsts = t->typeFirst
    tys = t->fieldTypeIdxs
    fi = firsts[typeIdx]
    While fi >= 0
        cur = fi * TYNAME_LEN
        If TyNameEq(VarPtr(names[cur]), name) <> 0 Then
            outOff = offs[fi]
            outSize = sizes[fi]
            outCount = counts[fi]
            outFieldTy = tys[fi]
            TyFindFieldEx = 1
            Exit Function
        End If
        fi = nexts[fi]
    Wend
End Function

' Virtual メソッドを追加。戻り値は vtable スロット番号（失敗時 -1）
' 各型のスロットは virtNames[typeVirtFirst .. + typeVirtCount) の連続領域
Function TyAddVirt(t As *TypeTable, typeIdx As Long, name As *Byte) As Long
    Dim vi As Long
    Dim names As *Byte
    Dim firsts As *Long
    Dim counts As *Long
    Dim j As Long
    Dim cur As Long
    Dim base As Long
    Dim cnt As Long

    TyAddVirt = -1
    If t = NULL Then Exit Function
    If typeIdx < 0 Or typeIdx >= t->nTypes Then Exit Function
    If TyEnsureVirtCap(t) = 0 Then Exit Function

    firsts = t->typeVirtFirst
    counts = t->typeVirtCount
    names = t->virtNames
    cnt = counts[typeIdx]
    base = firsts[typeIdx]
    If cnt = 0 Or base < 0 Then
        base = t->nVirts
        firsts[typeIdx] = base
        counts[typeIdx] = 0
        cnt = 0
    Else
        ' 連続配置のため、末尾に足すのはこの型が最後に追加された場合のみ
        If base + cnt <> t->nVirts Then
            Print "error: Virtual slot packing"
            Exit Function
        End If
    End If

    vi = t->nVirts
    j = 0
    cur = vi * TYNAME_LEN
    While name[j] <> 0 And j < TYNAME_LEN - 1
        names[cur + j] = name[j]
        j = j + 1
    Wend
    names[cur + j] = 0

    TyAddVirt = cnt
    counts[typeIdx] = cnt + 1
    t->nVirts = vi + 1
End Function

' 名前から vtable スロットを探す。無ければ -1
Function TyFindVirt(t As *TypeTable, typeIdx As Long, name As *Byte) As Long
    Dim names As *Byte
    Dim firsts As *Long
    Dim counts As *Long
    Dim cur As Long
    Dim slot As Long
    Dim base As Long
    Dim cnt As Long

    TyFindVirt = -1
    If t = NULL Then Exit Function
    If typeIdx < 0 Or typeIdx >= t->nTypes Then Exit Function
    names = t->virtNames
    firsts = t->typeVirtFirst
    counts = t->typeVirtCount
    base = firsts[typeIdx]
    cnt = counts[typeIdx]
    If base < 0 Or cnt <= 0 Then Exit Function
    slot = 0
    While slot < cnt
        cur = (base + slot) * TYNAME_LEN
        If TyNameEq(VarPtr(names[cur]), name) <> 0 Then
            TyFindVirt = slot
            Exit Function
        End If
        slot = slot + 1
    Wend
End Function

' 親クラスの Virtual スロットを子へコピー（Inherits）
Function TyCopyVirts(t As *TypeTable, dstTi As Long, srcTi As Long) As Long
    Dim names As *Byte
    Dim firsts As *Long
    Dim counts As *Long
    Dim cur As Long
    Dim slot As Long
    Dim base As Long
    Dim cnt As Long
    Dim i As Long

    TyCopyVirts = 0
    If t = NULL Then Exit Function
    If dstTi < 0 Or dstTi >= t->nTypes Then Exit Function
    If srcTi < 0 Or srcTi >= t->nTypes Then Exit Function
    names = t->virtNames
    firsts = t->typeVirtFirst
    counts = t->typeVirtCount
    base = firsts[srcTi]
    cnt = counts[srcTi]
    If cnt <= 0 Or base < 0 Then
        TyCopyVirts = 1
        Exit Function
    End If
    i = 0
    While i < cnt
        cur = (base + i) * TYNAME_LEN
        slot = TyAddVirt(t, dstTi, VarPtr(names[cur]))
        If slot < 0 Then Exit Function
        i = i + 1
    Wend
    TyCopyVirts = 1
End Function
