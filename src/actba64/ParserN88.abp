' ===================================================
'  ParserN88 - N88 BASIC graphics stmts
' ===================================================

' B / BF → mode 1 / 2。該当しなければ 0
Function ParseN88BoxMode(p As *Parser) As Long
    Dim kB(3) As Byte
    Dim kBf(3) As Byte
    ParseN88BoxMode = 0
    lstrcpy(VarPtr(kBf), "bf")
    If ParseIdentIs(p, VarPtr(kBf)) <> 0 Then
        p->pos = p->pos + 1
        ParseN88BoxMode = 2
        Exit Function
    End If
    lstrcpy(VarPtr(kB), "b")
    If ParseIdentIs(p, VarPtr(kB)) <> 0 Then
        p->pos = p->pos + 1
        ParseN88BoxMode = 1
    End If
End Function

Function ParseN88XyPair(p As *Parser, ByRef e1 As Long, ByRef e2 As Long) As Long
    ParseN88XyPair = 0
    If ParseExpect(p, TK_LPAREN) = 0 Then Exit Function
    e1 = ParseExpr(p)
    If e1 < 0 Then Exit Function
    If ParseExpect(p, TK_COMMA) = 0 Then Exit Function
    e2 = ParseExpr(p)
    If e2 < 0 Then Exit Function
    If ParseExpect(p, TK_RPAREN) = 0 Then Exit Function
    ParseN88XyPair = 1
End Function

Function ParseN88LineOpts(p As *Parser, ByRef e5 As Long, ByRef mode As Long) As Long
    Dim m As Long

    ParseN88LineOpts = 0
    e5 = -1
    mode = 0
    If ParseTokKind(p) <> TK_COMMA Then
        ParseN88LineOpts = 1
        Exit Function
    End If
    p->pos = p->pos + 1
    m = ParseN88BoxMode(p)
    If m <> 0 Then
        mode = m
    ElseIf ParseTokKind(p) = TK_COMMA Then
        p->pos = p->pos + 1
        mode = ParseN88BoxMode(p)
        If mode = 0 Then
            p->err = 1
            Exit Function
        End If
    Else
        e5 = ParseExpr(p)
        If e5 < 0 Then Exit Function
        If ParseTokKind(p) = TK_COMMA Then
            p->pos = p->pos + 1
            mode = ParseN88BoxMode(p)
            If mode = 0 Then
                p->err = 1
                Exit Function
            End If
        End If
    End If
    ParseN88LineOpts = 1
End Function

Function ParseN88LineHead(p As *Parser, ByRef useLp As Long, ByRef e1 As Long, ByRef e2 As Long, ByRef e3 As Long, ByRef e4 As Long, ByRef e5 As Long, ByRef mode As Long) As Long
    ParseN88LineHead = 0
    useLp = 0
    e1 = -1
    e2 = -1
    mode = 0
    If ParseTokKind(p) = TK_MINUS Then
        useLp = 1
        p->pos = p->pos + 1
    Else
        If ParseN88XyPair(p, e1, e2) = 0 Then Exit Function
        If ParseExpect(p, TK_MINUS) = 0 Then Exit Function
    End If
    If ParseN88XyPair(p, e3, e4) = 0 Then Exit Function
    If ParseN88LineOpts(p, e5, mode) = 0 Then Exit Function
    ParseN88LineHead = 1
End Function

Function ParseN88LineCall(ast As *Ast, useLp As Long, e1 As Long, e2 As Long, e3 As Long, e4 As Long, e5 As Long, e6 As Long) As Long
    Dim nodes As *AstNode
    Dim nCall As Long
    Dim name(15) As Byte
    Dim arg0 As Long
    Dim nPrev As Long
    Dim nArgs As Long

    ParseN88LineCall = -1
    arg0 = -1
    nPrev = -1
    nArgs = 0
    If useLp = 0 Then
        If ParseLinkArg(ast, arg0, nPrev, nArgs, e1) = 0 Then Exit Function
        If ParseLinkArg(ast, arg0, nPrev, nArgs, e2) = 0 Then Exit Function
        If ParseLinkArg(ast, arg0, nPrev, nArgs, e3) = 0 Then Exit Function
        If ParseLinkArg(ast, arg0, nPrev, nArgs, e4) = 0 Then Exit Function
        If ParseLinkArg(ast, arg0, nPrev, nArgs, e5) = 0 Then Exit Function
        If ParseLinkArg(ast, arg0, nPrev, nArgs, e6) = 0 Then Exit Function
        lstrcpy(VarPtr(name), "Line")
    Else
        If ParseLinkArg(ast, arg0, nPrev, nArgs, e3) = 0 Then Exit Function
        If ParseLinkArg(ast, arg0, nPrev, nArgs, e4) = 0 Then Exit Function
        If ParseLinkArg(ast, arg0, nPrev, nArgs, e5) = 0 Then Exit Function
        If ParseLinkArg(ast, arg0, nPrev, nArgs, e6) = 0 Then Exit Function
        lstrcpy(VarPtr(name), "LineCont")
    End If
    nCall = AstAddNode(ast, AST_CALL)
    If nCall < 0 Then Exit Function
    AstSetStr(ast, nCall, VarPtr(name))
    nodes = ast->nodes
    nodes[nCall].left = arg0
    nodes[nCall].right = -1
    nodes[nCall].num = nArgs
    ParseN88LineCall = nCall
End Function

' LINE [(x1,y1)]-(x2,y2)[,color][,B|BF]
' → Line(sx,sy,ex,ey,color,mode) または LineCont(ex,ey,color,mode)
Function ParseN88LineStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim e1 As Long
    Dim e2 As Long
    Dim e3 As Long
    Dim e4 As Long
    Dim e5 As Long
    Dim e6 As Long
    Dim useLp As Long
    Dim mode As Long

    ParseN88LineStmt = -1
    p->pos = p->pos + 1
    If ParseN88LineHead(p, useLp, e1, e2, e3, e4, e5, mode) = 0 Then Exit Function
    ast = p->ast
    If e5 < 0 Then
        e5 = ParseMakeNum(ast, 7)
        If e5 < 0 Then Exit Function
    End If
    e6 = ParseMakeNum(ast, mode)
    If e6 < 0 Then Exit Function
    ParseN88LineStmt = ParseN88LineCall(ast, useLp, e1, e2, e3, e4, e5, e6)
End Function

Function ParseN88DblFloat(p As *Parser, ByRef outD As Double) As Long
    Dim buf(255) As Byte
    Dim lx As *Lexer
    Dim toks As *Tok
    Dim d As Double

    ParseN88DblFloat = 0
    lx = p->lx
    toks = lx->toks
    LexCopyText(lx, toks[p->pos].textSlot, VarPtr(buf))
    d = ParseFloatTextToDouble(VarPtr(buf))
    p->pos = p->pos + 1
    outD = d
    ParseN88DblFloat = 1
End Function

' 角度/aspect リテラル → Double。空なら 0。負号なら neg=1（絶対値）
Function ParseN88Double(p As *Parser, ByRef outD As Double, ByRef neg As Long) As Long
    Dim sign As Long
    Dim v As Long
    Dim d As Double

    ParseN88Double = 0
    outD = 0
    neg = 0
    sign = 1
    If ParseTokKind(p) = TK_MINUS Then
        sign = -1
        neg = 1
        p->pos = p->pos + 1
    End If
    If ParseTokKind(p) = TK_FLOAT Then
        ParseN88Double = ParseN88DblFloat(p, outD)
        Exit Function
    End If
    If ParseTokKind(p) = TK_NUMBER Then
        v = ParseTokNum(p)
        p->pos = p->pos + 1
        d = 0
        d = d + v
        outD = d
        ParseN88Double = 1
        Exit Function
    End If
    If ParseTokKind(p) = TK_IDENT Or ParseTokKind(p) = TK_LPAREN Then
        v = ParseExpr(p)
        If v < 0 Then
            ParseN88Double = -1
            Exit Function
        End If
        p->err = 1
        ParseN88Double = -1
        Exit Function
    End If
    If sign < 0 Then
        p->err = 1
        ParseN88Double = -1
    End If
End Function

' n88: Line...-(...) または Line-(...) なら専用、否则は通常
Function ParseN88LineOrAssign(p As *Parser) As Long
    Dim save As Long
    Dim ok As Long

    ParseN88LineOrAssign = -1
    save = p->pos
    ok = 0
    p->pos = p->pos + 1
    If ParseTokKind(p) = TK_MINUS Then
        ok = 1
    ElseIf ParseTokKind(p) = TK_LPAREN Then
        p->pos = p->pos + 1
        If ParseExpr(p) >= 0 Then
            If ParseTokKind(p) = TK_COMMA Then
                p->pos = p->pos + 1
                If ParseExpr(p) >= 0 Then
                    If ParseTokKind(p) = TK_RPAREN Then
                        p->pos = p->pos + 1
                        If ParseTokKind(p) = TK_MINUS Then
                            ok = 1
                        End If
                    End If
                End If
            End If
        End If
    End If
    p->pos = save
    p->err = 0
    If ok <> 0 Then
        ParseN88LineOrAssign = ParseN88LineStmt(p)
    Else
        ParseN88LineOrAssign = ParseAssignStmt(p)
    End If
End Function
