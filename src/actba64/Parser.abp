' ===================================================
'  Parser - tokens -> AST
'  Dim / assign / expr / If / While / For / ExitProcess / Print / End
' ===================================================

Type Parser
    lx As *Lexer
    ast As *Ast
    pos As Long
    err As Long
    n88Mode As Long
    classTi As Long
    withBase As Long
End Type

Dim g_clsMethShort(63) As Byte
Dim g_clsMethMangled(127) As Byte
Dim g_parseArgByVal As Long
Dim g_withSave As Long

Function ParseToLower(c As Long) As Long
    If c >= 65 And c <= 90 Then
        ParseToLower = c + 32
    Else
        ParseToLower = c
    End If
End Function

Function ParseTokKind(p As *Parser) As Long
    Dim lx As *Lexer
    Dim toks As *Tok
    Dim i As Long
    lx = p->lx
    toks = lx->toks
    i = p->pos
    ParseTokKind = toks[i].kind
End Function

Function ParseTokKindAt(p As *Parser, pos As Long) As Long
    Dim lx As *Lexer
    Dim toks As *Tok
    ParseTokKindAt = TK_EOF
    lx = p->lx
    toks = lx->toks
    If pos < 0 Then Exit Function
    If pos >= lx->count Then Exit Function
    ParseTokKindAt = toks[pos].kind
End Function

Function ParseTokNum(p As *Parser) As Long
    Dim lx As *Lexer
    Dim toks As *Tok
    Dim i As Long
    lx = p->lx
    toks = lx->toks
    i = p->pos
    ParseTokNum = toks[i].num
End Function

Function ParseTokLine(p As *Parser) As Long
    Dim lx As *Lexer
    Dim toks As *Tok
    Dim i As Long
    lx = p->lx
    toks = lx->toks
    i = p->pos
    ParseTokLine = toks[i].srcLine
End Function

Function ParseExpect(p As *Parser, kind As Long) As Long
    Dim want As String
    ParseExpect = 0
    If ParseTokKind(p) <> kind Then
        If kind = TK_LPAREN Then
            want = "'('"
        ElseIf kind = TK_RPAREN Then
            want = "')'"
        ElseIf kind = TK_LBRACK Then
            want = "'['"
        ElseIf kind = TK_RBRACK Then
            want = "']'"
        ElseIf kind = TK_EQ Then
            want = "'='"
        ElseIf kind = TK_COMMA Then
            want = "','"
        ElseIf kind = TK_DOT Then
            want = "'.'"
        Else
            want = "token"
        End If
        ParseFail(p, "expected " + want)
        Exit Function
    End If
    p->pos = p->pos + 1
    ParseExpect = 1
End Function

Sub ParseFail(p As *Parser, msg As String)
    Dim srcLine As Long
    If p = NULL Then Exit Sub
    srcLine = ParseTokLine(p)
    If srcLine <= 0 Then srcLine = 1
    DiagError(srcLine, msg)
    p->err = 1
End Sub

' Skip tokens on the current line so parsing can resume at the next line.
Sub ParseRecoverStmt(p As *Parser)
    Dim srcLine As Long
    Dim lx As *Lexer
    Dim toks As *Tok
    If p = NULL Then Exit Sub
    lx = p->lx
    toks = lx->toks
    If p->pos < 0 Or p->pos >= lx->count Then Exit Sub
    srcLine = toks[p->pos].srcLine
    While p->pos < lx->count
        If toks[p->pos].kind = TK_EOF Then Exit Sub
        If toks[p->pos].srcLine > srcLine Then
            p->err = 0
            Exit Sub
        End If
        p->pos = p->pos + 1
    Wend
    p->err = 0
End Sub

Function ParseIdentIsAt(p As *Parser, pos As Long, name As *Byte) As Long
    Dim lx As *Lexer
    Dim toks As *Tok
    Dim tmp(63) As Byte
    Dim j As Long

    ParseIdentIsAt = 0
    lx = p->lx
    toks = lx->toks
    If pos < 0 Or pos >= lx->count Then Exit Function
    If toks[pos].kind <> TK_IDENT Then Exit Function
    LexCopyText(lx, toks[pos].textOff, VarPtr(tmp))
    j = 0
    Do
        If ParseToLower(tmp[j]) <> ParseToLower(name[j]) Then Exit Function
        If tmp[j] = 0 Then
            ParseIdentIsAt = 1
            Exit Function
        End If
        j = j + 1
    Loop
End Function

Function ParseIdentIs(p As *Parser, name As *Byte) As Long
    ParseIdentIs = ParseIdentIsAt(p, p->pos, name)
End Function

' 文区切り `:`（同一行に複数文）
Sub ParseSkipColons(p As *Parser)
    While ParseTokKind(p) = TK_COLON
        p->pos = p->pos + 1
    Wend
End Sub

' End / End Sub の衝突回避: stop は "End" + second（sub/function/if 等）の組のみ
Function ParseStmtListUntilEndPair(p As *Parser, second As *Byte) As Long
    Dim nFirst As Long
    Dim nPrev As Long
    Dim nStmt As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim kEnd(7) As Byte

    ParseStmtListUntilEndPair = -1
    ast = p->ast
    nFirst = -1
    nPrev = -1
    lstrcpy(VarPtr(kEnd), "end")

    While ParseTokKind(p) <> TK_EOF
        ParseSkipColons(p)
        If ParseTokKind(p) = TK_EOF Then Exit While
        If ParseIdentIs(p, VarPtr(kEnd)) <> 0 Then
            If ParseIdentIsAt(p, p->pos + 1, second) <> 0 Then
                ParseStmtListUntilEndPair = nFirst
                Exit Function
            End If
        End If
        nStmt = ParseStmt(p)
        If nStmt < 0 Or p->err <> 0 Then
            ' Nested lists still abort; top-level ParseProgram recovers.
            Exit Function
        End If
        If nFirst < 0 Then
            nFirst = nStmt
        Else
            nodes = ast->nodes
            nodes[nPrev].nxt = nStmt
        End If
        nPrev = nStmt
        nodes = ast->nodes
        While nodes[nPrev].nxt >= 0
            nPrev = nodes[nPrev].nxt
        Wend
    Wend
    ' Reached EOF without End <second>
    ParseFail(p, "expected 'End " + MakeStr(second) + "'")
    ParseStmtListUntilEndPair = nFirst
End Function
