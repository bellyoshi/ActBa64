' ===================================================
'  Parser - tokens -> AST
'  Dim / assign / expr / If / While / For / ExitProcess / Print / End
' ===================================================

Type Parser
    lx As *Lexer
    ast As *Ast
    pos As Long
    err As Long
    n88Mode As Long
    classTi As Long
    withBase As Long
End Type

Dim g_clsMethShort(63) As Byte
Dim g_clsMethMangled(127) As Byte
Dim g_parseArgByVal As Long
Dim g_withSave As Long

Function ParseToLower(c As Long) As Long
    If c >= 65 And c <= 90 Then
        ParseToLower = c + 32
    Else
        ParseToLower = c
    End If
End Function

Function ParseTokKind(p As *Parser) As Long
    Dim lx As *Lexer
    Dim toks As *Tok
    Dim i As Long
    lx = p->lx
    toks = lx->toks
    i = p->pos
    ParseTokKind = toks[i].kind
End Function

Function ParseTokKindAt(p As *Parser, pos As Long) As Long
    Dim lx As *Lexer
    Dim toks As *Tok
    ParseTokKindAt = TK_EOF
    lx = p->lx
    toks = lx->toks
    If pos < 0 Then Exit Function
    If pos >= lx->count Then Exit Function
    ParseTokKindAt = toks[pos].kind
End Function

Function ParseTokNum(p As *Parser) As Long
    Dim lx As *Lexer
    Dim toks As *Tok
    Dim i As Long
    lx = p->lx
    toks = lx->toks
    i = p->pos
    ParseTokNum = toks[i].num
End Function

Function ParseTokLine(p As *Parser) As Long
    Dim lx As *Lexer
    Dim toks As *Tok
    Dim i As Long
    lx = p->lx
    toks = lx->toks
    i = p->pos
    ParseTokLine = toks[i].srcLine
End Function

Function ParseExpect(p As *Parser, kind As Long) As Long
    ParseExpect = 0
    If ParseTokKind(p) <> kind Then
        p->err = 1
        Exit Function
    End If
    p->pos = p->pos + 1
    ParseExpect = 1
End Function

Function ParseIdentIsAt(p As *Parser, pos As Long, name As *Byte) As Long
    Dim lx As *Lexer
    Dim toks As *Tok
    Dim tmp(63) As Byte
    Dim j As Long

    ParseIdentIsAt = 0
    lx = p->lx
    toks = lx->toks
    If pos < 0 Or pos >= lx->count Then Exit Function
    If toks[pos].kind <> TK_IDENT Then Exit Function
    LexCopyText(lx, toks[pos].textOff, VarPtr(tmp))
    j = 0
    Do
        If ParseToLower(tmp[j]) <> ParseToLower(name[j]) Then Exit Function
        If tmp[j] = 0 Then
            ParseIdentIsAt = 1
            Exit Function
        End If
        j = j + 1
    Loop
End Function

Function ParseIdentIs(p As *Parser, name As *Byte) As Long
    ParseIdentIs = ParseIdentIsAt(p, p->pos, name)
End Function

' 文区切り `:`（同一行に複数文）
Sub ParseSkipColons(p As *Parser)
    While ParseTokKind(p) = TK_COLON
        p->pos = p->pos + 1
    Wend
End Sub

' End / End Sub の衝突回避: stop は "End" + second（sub/function/if 等）の組のみ
Function ParseStmtListUntilEndPair(p As *Parser, second As *Byte) As Long
    Dim nFirst As Long
    Dim nPrev As Long
    Dim nStmt As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim kEnd(7) As Byte

    ParseStmtListUntilEndPair = -1
    ast = p->ast
    nFirst = -1
    nPrev = -1
    lstrcpy(VarPtr(kEnd), "end")

    While ParseTokKind(p) <> TK_EOF
        ParseSkipColons(p)
        If ParseTokKind(p) = TK_EOF Then Exit While
        If ParseIdentIs(p, VarPtr(kEnd)) <> 0 Then
            If ParseIdentIsAt(p, p->pos + 1, second) <> 0 Then
                ParseStmtListUntilEndPair = nFirst
                Exit Function
            End If
        End If
        nStmt = ParseStmt(p)
        If nStmt < 0 Or p->err <> 0 Then Exit Function
        If nFirst < 0 Then
            nFirst = nStmt
        Else
            nodes = ast->nodes
            nodes[nPrev].nxt = nStmt
        End If
        nPrev = nStmt
        nodes = ast->nodes
        While nodes[nPrev].nxt >= 0
            nPrev = nodes[nPrev].nxt
        Wend
    Wend
    ParseStmtListUntilEndPair = nFirst
End Function

' クラスメソッド内の識別子: 戻り値名 / メンバ変数 → Me.field / 通常 VAR
Function ParseClassIdentExpr(p As *Parser, name As *Byte) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim types As *TypeTable
    Dim n As Long
    Dim nMe As Long
    Dim foff As Long
    Dim fsz As Long
    Dim fcnt As Long
    Dim kMe(7) As Byte

    ParseClassIdentExpr = -1
    ast = p->ast
    types = ast->types
    If g_clsMethShort[0] <> 0 Then
        If TyNameEq(name, VarPtr(g_clsMethShort)) <> 0 Then
            n = AstAddNode(ast, AST_VAR)
            If n < 0 Then Exit Function
            AstSetStr(ast, n, VarPtr(g_clsMethMangled))
            ParseClassIdentExpr = n
            Exit Function
        End If
    End If
    If p->classTi >= 0 Then
        If TyFindField(types, p->classTi, name, foff, fsz, fcnt) <> 0 Then
            lstrcpy(VarPtr(kMe), "Me")
            nMe = AstAddNode(ast, AST_VAR)
            If nMe < 0 Then Exit Function
            AstSetStr(ast, nMe, VarPtr(kMe))
            n = AstAddNode(ast, AST_MEMBER)
            If n < 0 Then Exit Function
            AstSetStr(ast, n, name)
            nodes = ast->nodes
            nodes[n].left = nMe
            nodes[n].num = 1
            ParseClassIdentExpr = n
            Exit Function
        End If
    End If
    n = AstAddNode(ast, AST_VAR)
    If n < 0 Then Exit Function
    AstSetStr(ast, n, name)
    ParseClassIdentExpr = n
End Function

' With ブロック内の .field / .Method(...) — g_withBase を起点にメンバ鎖を構築
Function ParseWithLval(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim cur As Long
    Dim name(63) As Byte
    Dim e As Long
    Dim arg0 As Long
    Dim arg1 As Long
    Dim arg2 As Long
    Dim nArgs As Long
    Dim nPrev As Long

    ParseWithLval = -1
    If p->withBase < 0 Then
        p->err = 1
        Exit Function
    End If
    If ParseTokKind(p) <> TK_DOT Then
        p->err = 1
        Exit Function
    End If
    ast = p->ast
    cur = p->withBase
    Do
        If ParseTokKind(p) = TK_DOT Then
            p->pos = p->pos + 1
            If ParseCopyIdent(p, VarPtr(name)) = 0 Then Exit Function
            arg0 = AstAddNode(ast, AST_MEMBER)
            If arg0 < 0 Then Exit Function
            AstSetStr(ast, arg0, VarPtr(name))
            nodes = ast->nodes
            nodes[arg0].left = cur
            nodes[arg0].num = 0
            cur = arg0
        ElseIf ParseTokKind(p) = TK_LBRACK Then
            p->pos = p->pos + 1
            e = ParseExpr(p)
            If e < 0 Then Exit Function
            If ParseExpect(p, TK_RBRACK) = 0 Then Exit Function
            arg0 = AstAddNode(ast, AST_INDEX)
            If arg0 < 0 Then Exit Function
            nodes = ast->nodes
            nodes[arg0].left = cur
            nodes[arg0].right = e
            nodes[arg0].num = 1
            cur = arg0
        Else
            Exit Do
        End If
    Loop
    If ParseTokKind(p) = TK_LPAREN Then
        nodes = ast->nodes
        If nodes[cur].kind = AST_MEMBER Then
            AstCopyStr(ast, cur, VarPtr(name))
            arg2 = nodes[cur].left
            p->pos = p->pos + 1
            arg0 = -1
            nPrev = -1
            nArgs = 0
            If ParseTokKind(p) <> TK_RPAREN Then
                Do
                    e = ParseArgExpr(p)
                    If e < 0 Then Exit Function
                    arg1 = AstAddNode(ast, AST_ARG)
                    If arg1 < 0 Then Exit Function
                    nodes = ast->nodes
                    nodes[arg1].left = e
                    nodes[arg1].num = g_parseArgByVal
                    If arg0 < 0 Then
                        arg0 = arg1
                    Else
                        nodes[nPrev].nxt = arg1
                    End If
                    nPrev = arg1
                    nArgs = nArgs + 1
                    If ParseTokKind(p) <> TK_COMMA Then Exit Do
                    p->pos = p->pos + 1
                Loop
            End If
            If ParseExpect(p, TK_RPAREN) = 0 Then Exit Function
            cur = AstAddNode(ast, AST_CALL)
            If cur < 0 Then Exit Function
            AstSetStr(ast, cur, VarPtr(name))
            nodes = ast->nodes
            nodes[cur].left = arg0
            nodes[cur].right = arg2
            nodes[cur].extra = -3
            nodes[cur].num = nArgs
        End If
    End If
    ParseWithLval = cur
End Function

Function ParseCopyIdent(p As *Parser, dst As *Byte) As Long
    Dim lx As *Lexer
    Dim toks As *Tok
    Dim i As Long
    ParseCopyIdent = 0
    lx = p->lx
    toks = lx->toks
    i = p->pos
    If toks[i].kind <> TK_IDENT Then
        p->err = 1
        Exit Function
    End If
    LexCopyText(lx, toks[i].textOff, dst)
    p->pos = p->pos + 1
    ParseCopyIdent = 1
End Function

Function ParseEatAliasIf(p As *Parser, lit As *Byte) As Long
    ParseEatAliasIf = 0
    If ParseIdentIs(p, lit) <> 0 Then
        p->pos = p->pos + 1
        ParseEatAliasIf = 1
    End If
End Function

