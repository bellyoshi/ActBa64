' dword/word/byte/handle/hwnd/integer → Long 相当（仮引数・戻り値）。一致で pos を進める
Function ParseEatLongAlias(p As *Parser) As Long
    ParseEatLongAlias = 0
    If ParseEatLongAliasA(p) <> 0 Then
        ParseEatLongAlias = 1
        Exit Function
    End If
    If ParseEatLongAliasB(p) <> 0 Then
        ParseEatLongAlias = 1
    End If
End Function

' As キャスト: mask（0=変換なし）。-1=失敗、-2=String 禁止
Function ParseCastMask(p As *Parser) As Long
    Dim k(31) As Byte
    Dim name(63) As Byte

    ParseCastMask = -1
    lstrcpy(VarPtr(k), "string")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        ParseCastMask = -2
        Exit Function
    End If
    lstrcpy(VarPtr(k), "byte")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p->pos = p->pos + 1
        ParseCastMask = 255
        Exit Function
    End If
    lstrcpy(VarPtr(k), "char")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p->pos = p->pos + 1
        ParseCastMask = 255
        Exit Function
    End If
    lstrcpy(VarPtr(k), "word")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p->pos = p->pos + 1
        ParseCastMask = 65535
        Exit Function
    End If
    lstrcpy(VarPtr(k), "long")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p->pos = p->pos + 1
        ParseCastMask = 0
        Exit Function
    End If
    lstrcpy(VarPtr(k), "dword")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p->pos = p->pos + 1
        ParseCastMask = 0
        Exit Function
    End If
    lstrcpy(VarPtr(k), "integer")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p->pos = p->pos + 1
        ParseCastMask = 0
        Exit Function
    End If
    lstrcpy(VarPtr(k), "single")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p->pos = p->pos + 1
        ParseCastMask = 0
        Exit Function
    End If
    lstrcpy(VarPtr(k), "double")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p->pos = p->pos + 1
        ParseCastMask = 0
        Exit Function
    End If
    lstrcpy(VarPtr(k), "int64")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p->pos = p->pos + 1
        ParseCastMask = 0
        Exit Function
    End If
    lstrcpy(VarPtr(k), "qword")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p->pos = p->pos + 1
        ParseCastMask = 0
        Exit Function
    End If
    ' ハンドル・ポインタ別名は幅変換なし
    If ParseEatLongAlias(p) <> 0 Then
        ParseCastMask = 0
        Exit Function
    End If
    If ParseCopyIdent(p, VarPtr(name)) = 0 Then Exit Function
    ParseCastMask = 0
End Function

' expression As type（失敗時 -1）
Function ParseApplyAs(p As *Parser, e As Long) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim n As Long
    Dim mask As Long
    Dim k(7) As Byte

    ParseApplyAs = e
    If e < 0 Then
        ParseApplyAs = -1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "as")
    If ParseIdentIs(p, VarPtr(k)) = 0 Then Exit Function
    p->pos = p->pos + 1
    If ParseTokKind(p) = TK_STAR Then
        p->pos = p->pos + 1
    End If
    mask = ParseCastMask(p)
    If mask = -2 Then
        Print "error: cannot cast to/from String"
        p->err = 1
        ParseApplyAs = -1
        Exit Function
    End If
    If mask < 0 Then
        p->err = 1
        ParseApplyAs = -1
        Exit Function
    End If
    ast = p->ast
    n = AstAddNode(ast, AST_CAST)
    If n < 0 Then
        ParseApplyAs = -1
        Exit Function
    End If
    nodes = ast->nodes
    nodes[n].left = e
    nodes[n].num = mask
    ParseApplyAs = n
End Function

' 次が代入演算子か（= / += / ++ / Mod= 等）
Function ParseIsAssignOpAhead(p As *Parser) As Long
    Dim k(7) As Byte
    Dim t As Long

    ParseIsAssignOpAhead = 0
    t = ParseTokKind(p)
    If t = TK_EQ Then
        ParseIsAssignOpAhead = 1
        Exit Function
    End If
    If t = TK_PLUS Then
        If ParseTokKindAt(p, p->pos + 1) = TK_PLUS Or ParseTokKindAt(p, p->pos + 1) = TK_EQ Then
            ParseIsAssignOpAhead = 1
        End If
        Exit Function
    End If
    If t = TK_MINUS Then
        If ParseTokKindAt(p, p->pos + 1) = TK_MINUS Or ParseTokKindAt(p, p->pos + 1) = TK_EQ Then
            ParseIsAssignOpAhead = 1
        End If
        Exit Function
    End If
    If t = TK_STAR Or t = TK_SLASH Or t = TK_BACKSLASH Or t = TK_SHL Or t = TK_SHR Then
        If ParseTokKindAt(p, p->pos + 1) = TK_EQ Then
            ParseIsAssignOpAhead = 1
        End If
        Exit Function
    End If
    lstrcpy(VarPtr(k), "mod")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        If ParseTokKindAt(p, p->pos + 1) = TK_EQ Then ParseIsAssignOpAhead = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "and")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        If ParseTokKindAt(p, p->pos + 1) = TK_EQ Then ParseIsAssignOpAhead = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "or")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        If ParseTokKindAt(p, p->pos + 1) = TK_EQ Then ParseIsAssignOpAhead = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "xor")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        If ParseTokKindAt(p, p->pos + 1) = TK_EQ Then ParseIsAssignOpAhead = 1
    End If
End Function

Function ParseMakeAssignBin(p As *Parser, left As Long, op As Long, right As Long) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nBin As Long
    Dim nAsg As Long

    ParseMakeAssignBin = -1
    If left < 0 Or right < 0 Then Exit Function
    ast = p->ast
    nBin = AstAddNode(ast, AST_BINOP)
    If nBin < 0 Then Exit Function
    nodes = ast->nodes
    nodes[nBin].num = op
    nodes[nBin].left = left
    nodes[nBin].right = right
    nAsg = AstAddNode(ast, AST_ASSIGN)
    If nAsg < 0 Then Exit Function
    nodes = ast->nodes
    nodes[nAsg].left = left
    nodes[nAsg].right = nBin
    ParseMakeAssignBin = nAsg
End Function

' lvalue の後の = / += / ++ など
Function ParseAssignIncDec(p As *Parser, left As Long) As Long
    Dim nOne As Long
    Dim ast As *Ast
    Dim nodes As *AstNode

    ParseAssignIncDec = -2
    ast = p->ast
    If ParseTokKind(p) = TK_PLUS Then
        If ParseTokKindAt(p, p->pos + 1) = TK_PLUS Then
            p->pos = p->pos + 2
            nOne = AstAddNode(ast, AST_NUM)
            If nOne < 0 Then
                ParseAssignIncDec = -1
                Exit Function
            End If
            nodes = ast->nodes
            nodes[nOne].num = 1
            ParseAssignIncDec = ParseMakeAssignBin(p, left, BOP_ADD, nOne)
            Exit Function
        End If
    End If
    If ParseTokKind(p) = TK_MINUS Then
        If ParseTokKindAt(p, p->pos + 1) = TK_MINUS Then
            p->pos = p->pos + 2
            nOne = AstAddNode(ast, AST_NUM)
            If nOne < 0 Then
                ParseAssignIncDec = -1
                Exit Function
            End If
            nodes = ast->nodes
            nodes[nOne].num = 1
            ParseAssignIncDec = ParseMakeAssignBin(p, left, BOP_SUB, nOne)
        End If
    End If
End Function

Function ParseCompoundAssignOp(p As *Parser) As Long
    Dim k(7) As Byte
    Dim op As Long

    ParseCompoundAssignOp = 0
    op = 0
    If ParseTokKind(p) = TK_PLUS Then
        If ParseTokKindAt(p, p->pos + 1) = TK_EQ Then
            op = BOP_ADD
            p->pos = p->pos + 2
        End If
    ElseIf ParseTokKind(p) = TK_MINUS Then
        If ParseTokKindAt(p, p->pos + 1) = TK_EQ Then
            op = BOP_SUB
            p->pos = p->pos + 2
        End If
    ElseIf ParseTokKind(p) = TK_STAR Then
        If ParseTokKindAt(p, p->pos + 1) = TK_EQ Then
            op = BOP_MUL
            p->pos = p->pos + 2
        End If
    ElseIf ParseTokKind(p) = TK_SLASH Then
        If ParseTokKindAt(p, p->pos + 1) = TK_EQ Then
            op = BOP_DIV
            p->pos = p->pos + 2
        End If
    ElseIf ParseTokKind(p) = TK_BACKSLASH Then
        If ParseTokKindAt(p, p->pos + 1) = TK_EQ Then
            op = BOP_IDIV
            p->pos = p->pos + 2
        End If
    ElseIf ParseTokKind(p) = TK_SHL Then
        If ParseTokKindAt(p, p->pos + 1) = TK_EQ Then
            op = BOP_SHL
            p->pos = p->pos + 2
        End If
    ElseIf ParseTokKind(p) = TK_SHR Then
        If ParseTokKindAt(p, p->pos + 1) = TK_EQ Then
            op = BOP_SHR
            p->pos = p->pos + 2
        End If
    Else
        lstrcpy(VarPtr(k), "mod")
        If ParseIdentIs(p, VarPtr(k)) <> 0 Then
            If ParseTokKindAt(p, p->pos + 1) = TK_EQ Then
                op = BOP_MOD
                p->pos = p->pos + 2
            End If
        End If
        If op = 0 Then
            lstrcpy(VarPtr(k), "and")
            If ParseIdentIs(p, VarPtr(k)) <> 0 Then
                If ParseTokKindAt(p, p->pos + 1) = TK_EQ Then
                    op = BOP_AND
                    p->pos = p->pos + 2
                End If
            End If
        End If
        If op = 0 Then
            lstrcpy(VarPtr(k), "or")
            If ParseIdentIs(p, VarPtr(k)) <> 0 Then
                If ParseTokKindAt(p, p->pos + 1) = TK_EQ Then
                    op = BOP_OR
                    p->pos = p->pos + 2
                End If
            End If
        End If
        If op = 0 Then
            lstrcpy(VarPtr(k), "xor")
            If ParseIdentIs(p, VarPtr(k)) <> 0 Then
                If ParseTokKindAt(p, p->pos + 1) = TK_EQ Then
                    op = BOP_XOR
                    p->pos = p->pos + 2
                End If
            End If
        End If
    End If
    ParseCompoundAssignOp = op
End Function

Function ParseAssignOpRhs(p As *Parser, left As Long) As Long
    Dim e As Long
    Dim op As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nAsg As Long
    Dim nInc As Long

    ParseAssignOpRhs = -1
    If left < 0 Then Exit Function
    ast = p->ast
    nInc = ParseAssignIncDec(p, left)
    If nInc <> -2 Then
        ParseAssignOpRhs = nInc
        Exit Function
    End If
    op = ParseCompoundAssignOp(p)
    If op <> 0 Then
        e = ParseExpr(p)
        If e < 0 Then Exit Function
        ParseAssignOpRhs = ParseMakeAssignBin(p, left, op, e)
        Exit Function
    End If
    If ParseExpect(p, TK_EQ) = 0 Then Exit Function
    e = ParseExpr(p)
    If e < 0 Then Exit Function
    nAsg = AstAddNode(ast, AST_ASSIGN)
    If nAsg < 0 Then Exit Function
    nodes = ast->nodes
    nodes[nAsg].left = left
    nodes[nAsg].right = e
    ParseAssignOpRhs = nAsg
End Function

Function ParseStringArg(p As *Parser, dst As *Byte) As Long
    Dim lx As *Lexer
    Dim toks As *Tok
    Dim i As Long
    ParseStringArg = 0
    lx = p->lx
    toks = lx->toks
    i = p->pos
    If toks[i].kind <> TK_STRING Then
        p->err = 1
        Exit Function
    End If
    LexCopyText(lx, toks[i].textOff, dst)
    p->pos = p->pos + 1
    ParseStringArg = 1
End Function

Function ParseIsKeywordStmt(p As *Parser) As Long
    Dim k(15) As Byte
    ParseIsKeywordStmt = 0
    lstrcpy(VarPtr(k), "print")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        ParseIsKeywordStmt = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "exitprocess")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        ParseIsKeywordStmt = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "end")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        ParseIsKeywordStmt = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "dim")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        ParseIsKeywordStmt = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "if")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        ParseIsKeywordStmt = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "else")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        ParseIsKeywordStmt = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "while")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        ParseIsKeywordStmt = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "wend")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        ParseIsKeywordStmt = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "for")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        ParseIsKeywordStmt = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "next")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        ParseIsKeywordStmt = 1
        Exit Function
    End If
End Function

Function ParseArgList(p As *Parser, ByRef arg0 As Long, ByRef nArgs As Long) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim e As Long
    Dim arg1 As Long
    Dim nPrev As Long

    ParseArgList = 0
    ast = p->ast
    arg0 = -1
    nArgs = 0
    nPrev = -1
    If ParseTokKind(p) <> TK_RPAREN Then
        Do
            e = ParseArgExpr(p)
            If e < 0 Then Exit Function
            arg1 = AstAddNode(ast, AST_ARG)
            If arg1 < 0 Then Exit Function
            nodes = ast->nodes
            nodes[arg1].left = e
            nodes[arg1].num = g_parseArgByVal
            If arg0 < 0 Then
                arg0 = arg1
            Else
                nodes[nPrev].nxt = arg1
            End If
            nPrev = arg1
            nArgs = nArgs + 1
            If ParseTokKind(p) <> TK_COMMA Then Exit Do
            p->pos = p->pos + 1
        Loop
    End If
    If ParseExpect(p, TK_RPAREN) = 0 Then Exit Function
    ParseArgList = 1
End Function

Function ParsePostfixMemIdx(p As *Parser, n As Long) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim name(63) As Byte
    Dim e As Long
    Dim arg0 As Long

    ParsePostfixMemIdx = -1
    ast = p->ast
    Do
        If ParseTokKind(p) = TK_DOT Then
            p->pos = p->pos + 1
            If ParseCopyIdent(p, VarPtr(name)) = 0 Then Exit Function
            arg0 = AstAddNode(ast, AST_MEMBER)
            If arg0 < 0 Then Exit Function
            AstSetStr(ast, arg0, VarPtr(name))
            nodes = ast->nodes
            nodes[arg0].left = n
            nodes[arg0].num = 0
            n = arg0
        ElseIf ParseTokKind(p) = TK_ARROW Then
            p->pos = p->pos + 1
            If ParseCopyIdent(p, VarPtr(name)) = 0 Then Exit Function
            arg0 = AstAddNode(ast, AST_MEMBER)
            If arg0 < 0 Then Exit Function
            AstSetStr(ast, arg0, VarPtr(name))
            nodes = ast->nodes
            nodes[arg0].left = n
            nodes[arg0].num = 1
            n = arg0
        ElseIf ParseTokKind(p) = TK_LBRACK Then
            p->pos = p->pos + 1
            e = ParseExpr(p)
            If e < 0 Then Exit Function
            If ParseExpect(p, TK_RBRACK) = 0 Then Exit Function
            arg0 = AstAddNode(ast, AST_INDEX)
            If arg0 < 0 Then Exit Function
            nodes = ast->nodes
            nodes[arg0].left = n
            nodes[arg0].right = e
            nodes[arg0].num = 1
            n = arg0
        Else
            Exit Do
        End If
    Loop
    ParsePostfixMemIdx = n
End Function

Function ParseMemberCall(p As *Parser, n As Long) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim name(63) As Byte
    Dim arg0 As Long
    Dim nArgs As Long
    Dim rec As Long

    ParseMemberCall = n
    If ParseTokKind(p) <> TK_LPAREN Then Exit Function
    ast = p->ast
    nodes = ast->nodes
    If nodes[n].kind <> AST_MEMBER Then Exit Function
    AstCopyStr(ast, n, VarPtr(name))
    rec = nodes[n].left
    p->pos = p->pos + 1
    If ParseArgList(p, arg0, nArgs) = 0 Then
        ParseMemberCall = -1
        Exit Function
    End If
    n = AstAddNode(ast, AST_CALL)
    If n < 0 Then
        ParseMemberCall = -1
        Exit Function
    End If
    AstSetStr(ast, n, VarPtr(name))
    nodes = ast->nodes
    nodes[n].left = arg0
    nodes[n].right = rec
    nodes[n].extra = -3
    nodes[n].num = nArgs
    ParseMemberCall = n
End Function

