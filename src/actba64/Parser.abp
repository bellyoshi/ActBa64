' ===================================================
'  Parser - tokens -> AST
'  Dim / assign / expr / If / While / For / ExitProcess / Print / End
' ===================================================

Type Parser
    lx As *Lexer
    ast As *Ast
    pos As Long
    err As Long
End Type

Function ParseToLower(c As Long) As Long
    If c >= 65 And c <= 90 Then
        ParseToLower = c + 32
    Else
        ParseToLower = c
    End If
End Function

Function ParseTokKind(p As *Parser) As Long
    Dim lx As *Lexer
    Dim toks As *Tok
    Dim i As Long
    lx = p.lx
    toks = lx.toks
    i = p.pos
    ParseTokKind = toks[i].kind
End Function

Function ParseTokKindAt(p As *Parser, pos As Long) As Long
    Dim lx As *Lexer
    Dim toks As *Tok
    ParseTokKindAt = TK_EOF
    lx = p.lx
    toks = lx.toks
    If pos < 0 Then Exit Function
    If pos >= lx.count Then Exit Function
    ParseTokKindAt = toks[pos].kind
End Function

Function ParseTokNum(p As *Parser) As Long
    Dim lx As *Lexer
    Dim toks As *Tok
    Dim i As Long
    lx = p.lx
    toks = lx.toks
    i = p.pos
    ParseTokNum = toks[i].num
End Function

Function ParseTokLine(p As *Parser) As Long
    Dim lx As *Lexer
    Dim toks As *Tok
    Dim i As Long
    lx = p.lx
    toks = lx.toks
    i = p.pos
    ParseTokLine = toks[i].line
End Function

Function ParseExpect(p As *Parser, kind As Long) As Long
    ParseExpect = 0
    If ParseTokKind(p) <> kind Then
        p.err = 1
        Exit Function
    End If
    p.pos = p.pos + 1
    ParseExpect = 1
End Function

Function ParseIdentIsAt(p As *Parser, pos As Long, name As *Byte) As Long
    Dim lx As *Lexer
    Dim toks As *Tok
    Dim tmp(63) As Byte
    Dim j As Long

    ParseIdentIsAt = 0
    lx = p.lx
    toks = lx.toks
    If pos < 0 Or pos >= lx.count Then Exit Function
    If toks[pos].kind <> TK_IDENT Then Exit Function
    LexCopyText(lx, toks[pos].textOff, VarPtr(tmp))
    j = 0
    Do
        If ParseToLower(tmp[j]) <> ParseToLower(name[j]) Then Exit Function
        If tmp[j] = 0 Then
            ParseIdentIsAt = 1
            Exit Function
        End If
        j = j + 1
    Loop
End Function

Function ParseIdentIs(p As *Parser, name As *Byte) As Long
    ParseIdentIs = ParseIdentIsAt(p, p.pos, name)
End Function

' End / End Sub の衝突回避: stop は "End" + second（sub/function/if 等）の組のみ
Function ParseStmtListUntilEndPair(p As *Parser, second As *Byte) As Long
    Dim nFirst As Long
    Dim nPrev As Long
    Dim nStmt As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim kEnd(7) As Byte

    ParseStmtListUntilEndPair = -1
    ast = p.ast
    nFirst = -1
    nPrev = -1
    lstrcpy(VarPtr(kEnd), "end")

    While ParseTokKind(p) <> TK_EOF
        If ParseIdentIs(p, VarPtr(kEnd)) <> 0 Then
            If ParseIdentIsAt(p, p.pos + 1, second) <> 0 Then
                ParseStmtListUntilEndPair = nFirst
                Exit Function
            End If
        End If
        nStmt = ParseStmt(p)
        If nStmt < 0 Or p.err <> 0 Then Exit Function
        If nFirst < 0 Then
            nFirst = nStmt
        Else
            nodes = ast.nodes
            nodes[nPrev].nxt = nStmt
        End If
        nPrev = nStmt
        nodes = ast.nodes
        While nodes[nPrev].nxt >= 0
            nPrev = nodes[nPrev].nxt
        Wend
    Wend
    ParseStmtListUntilEndPair = nFirst
End Function

Function ParseCopyIdent(p As *Parser, dst As *Byte) As Long
    Dim lx As *Lexer
    Dim toks As *Tok
    Dim i As Long
    ParseCopyIdent = 0
    lx = p.lx
    toks = lx.toks
    i = p.pos
    If toks[i].kind <> TK_IDENT Then
        p.err = 1
        Exit Function
    End If
    LexCopyText(lx, toks[i].textOff, dst)
    p.pos = p.pos + 1
    ParseCopyIdent = 1
End Function

' dword/word/byte/handle/hwnd/integer → Long 相当（仮引数・戻り値）。一致で pos を進める
Function ParseEatLongAlias(p As *Parser) As Long
    Dim k(31) As Byte

    ParseEatLongAlias = 0
    lstrcpy(VarPtr(k), "dword")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p.pos = p.pos + 1
        ParseEatLongAlias = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "word")
