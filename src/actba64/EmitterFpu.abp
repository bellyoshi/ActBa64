' EmitterFpu - SSE スカラー変換と演算

' cvtsi2ss xmm0, eax / movd eax, xmm0 ― int32 → IEEE Single bits in eax
Sub EmitCvtI32ToSs(cb As *CodeBuffer)
    EmitByte(cb, &HF3)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H2A)
    EmitByte(cb, &HC0)
    EmitByte(cb, &H66)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H7E)
    EmitByte(cb, &HC0)
End Sub

' movq xmm0, rax
Sub EmitMovqXmm0Rax(cb As *CodeBuffer)
    EmitByte(cb, &H66)
    EmitByte(cb, &H48)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H6E)
    EmitByte(cb, &HC0)
End Sub

' movq xmm0, rcx
Sub EmitMovqXmm0Rcx(cb As *CodeBuffer)
    EmitByte(cb, &H66)
    EmitByte(cb, &H48)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H6E)
    EmitByte(cb, &HC1)
End Sub

' movq xmm1, rax
Sub EmitMovqXmm1Rax(cb As *CodeBuffer)
    EmitByte(cb, &H66)
    EmitByte(cb, &H48)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H6E)
    EmitByte(cb, &HC8)
End Sub

' movq rax, xmm0
' movd eax, xmm0
Sub EmitMovdEaxXmm0(cb As *CodeBuffer)
    EmitByte(cb, &H66)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H7E)
    EmitByte(cb, &HC0)
End Sub

Sub EmitMovqRaxXmm0(cb As *CodeBuffer)
    EmitByte(cb, &H66)
    EmitByte(cb, &H48)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H7E)
    EmitByte(cb, &HC0)
End Sub

' movabs rax, imm64（lo, hi は IEEE Double ビット）
Sub EmitMovRaxImm64(cb As *CodeBuffer, lo As DWord, hi As DWord)
    EmitByte(cb, &H48)
    EmitByte(cb, &HB8)
    EmitDword(cb, lo)
    EmitDword(cb, hi)
End Sub

' cvtsd2ss xmm0,xmm0 / movd eax,xmm0（rax に Double → eax に Single）
Sub EmitCvtSdToSs(cb As *CodeBuffer)
    EmitMovqXmm0Rax(cb)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H5A)
    EmitByte(cb, &HC0)
    EmitByte(cb, &H66)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H7E)
    EmitByte(cb, &HC0)
End Sub

' cvtsi2sd xmm0, eax / movq rax, xmm0
Sub EmitCvtI32ToSd(cb As *CodeBuffer)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H2A)
    EmitByte(cb, &HC0)
    EmitMovqRaxXmm0(cb)
End Sub

' cvtsi2sd xmm0, rax / movq rax, xmm0（Int64 → Double）
Sub EmitCvtI64ToSd(cb As *CodeBuffer)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H48)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H2A)
    EmitByte(cb, &HC0)
    EmitMovqRaxXmm0(cb)
End Sub

' QWord → Double。最上位ビットが立っていれば (rax >> 1) Or (rax And 1) を変換して 2 倍する
'   test rax, rax / js NEG / cvtsi2sd xmm0, rax / jmp END
'   NEG: mov rcx, rax / shr rcx, 1 / and eax, 1 / or rcx, rax / cvtsi2sd xmm0, rcx / addsd xmm0, xmm0
'   END: movq rax, xmm0
Sub EmitCvtU64ToSd(cb As *CodeBuffer)
    EmitByte(cb, &H48)
    EmitByte(cb, &H85)
    EmitByte(cb, &HC0)
    EmitByte(cb, &H78)
    EmitByte(cb, 7)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H48)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H2A)
    EmitByte(cb, &HC0)
    EmitByte(cb, &HEB)
    EmitByte(cb, 21)
    EmitByte(cb, &H48)
    EmitByte(cb, &H89)
    EmitByte(cb, &HC1)
    EmitByte(cb, &H48)
    EmitByte(cb, &HD1)
    EmitByte(cb, &HE9)
    EmitByte(cb, &H83)
    EmitByte(cb, &HE0)
    EmitByte(cb, 1)
    EmitByte(cb, &H48)
    EmitByte(cb, &H09)
    EmitByte(cb, &HC1)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H48)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H2A)
    EmitByte(cb, &HC1)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H58)
    EmitByte(cb, &HC0)
    EmitMovqRaxXmm0(cb)
End Sub

' Double → QWord。2^63 以上なら 2^63 を引いて変換し、最上位ビットを立てる
'   movq xmm0, rax / mov rcx, 2^63 (Double) / movq xmm1, rcx / comisd xmm0, xmm1 / jae BIG
'   cvttsd2si rax, xmm0 / jmp END
'   BIG: subsd xmm0, xmm1 / cvttsd2si rax, xmm0 / btc rax, 63
Sub EmitCvtSdToU64(cb As *CodeBuffer)
    EmitMovqXmm0Rax(cb)
    EmitByte(cb, &H48)
    EmitByte(cb, &HB9)
    EmitDword(cb, 0)
    EmitDword(cb, &H43E00000)
    EmitByte(cb, &H66)
    EmitByte(cb, &H48)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H6E)
    EmitByte(cb, &HC9)
    EmitByte(cb, &H66)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H2F)
    EmitByte(cb, &HC1)
    EmitByte(cb, &H73)
    EmitByte(cb, 7)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H48)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H2C)
    EmitByte(cb, &HC0)
    EmitByte(cb, &HEB)
    EmitByte(cb, 14)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H5C)
    EmitByte(cb, &HC1)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H48)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H2C)
    EmitByte(cb, &HC0)
    EmitByte(cb, &H48)
    EmitByte(cb, &H0F)
    EmitByte(cb, &HBA)
    EmitByte(cb, &HF8)
    EmitByte(cb, 63)
End Sub

' movq xmm0, rax / cvttsd2si rax, xmm0（Double → Int64）
Sub EmitCvtSdToI64(cb As *CodeBuffer)
    EmitMovqXmm0Rax(cb)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H48)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H2C)
    EmitByte(cb, &HC0)
End Sub

' mov eax, eax（上位を 0 に）/ cvtsi2sd xmm0, rax / movq rax, xmm0
Sub EmitCvtU32ToSd(cb As *CodeBuffer)
    EmitByte(cb, &H89)
    EmitByte(cb, &HC0)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H48)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H2A)
    EmitByte(cb, &HC0)
    EmitMovqRaxXmm0(cb)
End Sub

' movd xmm0, eax / cvtss2sd xmm0, xmm0 / movq rax, xmm0
Sub EmitCvtSsToSd(cb As *CodeBuffer)
    EmitByte(cb, &H66)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H6E)
    EmitByte(cb, &HC0)
    EmitByte(cb, &HF3)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H5A)
    EmitByte(cb, &HC0)
    EmitMovqRaxXmm0(cb)
End Sub

' addsd xmm0, xmm1 / movq rax, xmm0  (rcx=left, rax=right)
Sub EmitAddSd(cb As *CodeBuffer)
    EmitMovqXmm0Rcx(cb)
    EmitMovqXmm1Rax(cb)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H58)
    EmitByte(cb, &HC1)
    EmitMovqRaxXmm0(cb)
End Sub

Sub EmitSubSd(cb As *CodeBuffer)
    EmitMovqXmm0Rcx(cb)
    EmitMovqXmm1Rax(cb)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H5C)
    EmitByte(cb, &HC1)
    EmitMovqRaxXmm0(cb)
End Sub

Sub EmitMulSd(cb As *CodeBuffer)
    EmitMovqXmm0Rcx(cb)
    EmitMovqXmm1Rax(cb)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H59)
    EmitByte(cb, &HC1)
    EmitMovqRaxXmm0(cb)
End Sub

Sub EmitDivSd(cb As *CodeBuffer)
    EmitMovqXmm0Rcx(cb)
    EmitMovqXmm1Rax(cb)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H5E)
    EmitByte(cb, &HC1)
    EmitMovqRaxXmm0(cb)
End Sub

' ucomisd xmm0, xmm1 (rcx=left, rax=right)
Sub EmitUcomisd(cb As *CodeBuffer)
    EmitMovqXmm0Rcx(cb)
    EmitMovqXmm1Rax(cb)
    EmitByte(cb, &H66)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H2E)
    EmitByte(cb, &HC1)
End Sub

' 0.0 - x  (rax → rax)
Sub EmitNegSd(cb As *CodeBuffer)
    EmitMovqXmm1Rax(cb)
    EmitByte(cb, &H31)
    EmitByte(cb, &HC0)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H2A)
    EmitByte(cb, &HC0)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H5C)
    EmitByte(cb, &HC1)
    EmitMovqRaxXmm0(cb)
End Sub

' cvttsd2si eax, xmm0 (rax in → eax out)
Sub EmitCvtSdToI32(cb As *CodeBuffer)
    EmitMovqXmm0Rax(cb)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H2C)
    EmitByte(cb, &HC0)
End Sub
