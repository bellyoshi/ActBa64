' EmitterFpu - SSE スカラー変換と演算

' cvtsi2ss xmm0, eax / movd eax, xmm0 ― int32 → IEEE Single bits in eax
Sub EmitCvtI32ToSs(cb As *CodeBuffer)
    EmitByte(cb, &HF3)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H2A)
    EmitByte(cb, &HC0)
    EmitByte(cb, &H66)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H7E)
    EmitByte(cb, &HC0)
End Sub

' movq xmm0, rax
Sub EmitMovqXmm0Rax(cb As *CodeBuffer)
    EmitByte(cb, &H66)
    EmitByte(cb, &H48)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H6E)
    EmitByte(cb, &HC0)
End Sub

' movq xmm0, rcx
Sub EmitMovqXmm0Rcx(cb As *CodeBuffer)
    EmitByte(cb, &H66)
    EmitByte(cb, &H48)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H6E)
    EmitByte(cb, &HC1)
End Sub

' movq xmm1, rax
Sub EmitMovqXmm1Rax(cb As *CodeBuffer)
    EmitByte(cb, &H66)
    EmitByte(cb, &H48)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H6E)
    EmitByte(cb, &HC8)
End Sub

' movq rax, xmm0
Sub EmitMovqRaxXmm0(cb As *CodeBuffer)
    EmitByte(cb, &H66)
    EmitByte(cb, &H48)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H7E)
    EmitByte(cb, &HC0)
End Sub

' movabs rax, imm64（lo, hi は IEEE Double ビット）
Sub EmitMovRaxImm64(cb As *CodeBuffer, lo As DWord, hi As DWord)
    EmitByte(cb, &H48)
    EmitByte(cb, &HB8)
    EmitDword(cb, lo)
    EmitDword(cb, hi)
End Sub

' cvtsd2ss xmm0,xmm0 / movd eax,xmm0（rax に Double → eax に Single）
Sub EmitCvtSdToSs(cb As *CodeBuffer)
    EmitMovqXmm0Rax(cb)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H5A)
    EmitByte(cb, &HC0)
    EmitByte(cb, &H66)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H7E)
    EmitByte(cb, &HC0)
End Sub

' cvtsi2sd xmm0, eax / movq rax, xmm0
Sub EmitCvtI32ToSd(cb As *CodeBuffer)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H2A)
    EmitByte(cb, &HC0)
    EmitMovqRaxXmm0(cb)
End Sub

' movd xmm0, eax / cvtss2sd xmm0, xmm0 / movq rax, xmm0
Sub EmitCvtSsToSd(cb As *CodeBuffer)
    EmitByte(cb, &H66)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H6E)
    EmitByte(cb, &HC0)
    EmitByte(cb, &HF3)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H5A)
    EmitByte(cb, &HC0)
    EmitMovqRaxXmm0(cb)
End Sub

' addsd xmm0, xmm1 / movq rax, xmm0  (rcx=left, rax=right)
Sub EmitAddSd(cb As *CodeBuffer)
    EmitMovqXmm0Rcx(cb)
    EmitMovqXmm1Rax(cb)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H58)
    EmitByte(cb, &HC1)
    EmitMovqRaxXmm0(cb)
End Sub

Sub EmitSubSd(cb As *CodeBuffer)
    EmitMovqXmm0Rcx(cb)
    EmitMovqXmm1Rax(cb)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H5C)
    EmitByte(cb, &HC1)
    EmitMovqRaxXmm0(cb)
End Sub

Sub EmitMulSd(cb As *CodeBuffer)
    EmitMovqXmm0Rcx(cb)
    EmitMovqXmm1Rax(cb)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H59)
    EmitByte(cb, &HC1)
    EmitMovqRaxXmm0(cb)
End Sub

Sub EmitDivSd(cb As *CodeBuffer)
    EmitMovqXmm0Rcx(cb)
    EmitMovqXmm1Rax(cb)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H5E)
    EmitByte(cb, &HC1)
    EmitMovqRaxXmm0(cb)
End Sub

' ucomisd xmm0, xmm1 (rcx=left, rax=right)
Sub EmitUcomisd(cb As *CodeBuffer)
    EmitMovqXmm0Rcx(cb)
    EmitMovqXmm1Rax(cb)
    EmitByte(cb, &H66)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H2E)
    EmitByte(cb, &HC1)
End Sub

' 0.0 - x  (rax → rax)
Sub EmitNegSd(cb As *CodeBuffer)
    EmitMovqXmm1Rax(cb)
    EmitByte(cb, &H31)
    EmitByte(cb, &HC0)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H2A)
    EmitByte(cb, &HC0)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H5C)
    EmitByte(cb, &HC1)
    EmitMovqRaxXmm0(cb)
End Sub

' cvttsd2si eax, xmm0 (rax in → eax out)
Sub EmitCvtSdToI32(cb As *CodeBuffer)
    EmitMovqXmm0Rax(cb)
    EmitByte(cb, &HF2)
    EmitByte(cb, &H0F)
    EmitByte(cb, &H2C)
    EmitByte(cb, &HC0)
End Sub
