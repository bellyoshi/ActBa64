' BytePtr → バイトポインタ型（Long 別名ではない）
Function ParseEatBytePtrAlias(p As *Parser) As Long
    Dim k(15) As Byte

    ParseEatBytePtrAlias = 0
    lstrcpy(VarPtr(k), "byteptr")
    If ParseEatAliasIf(p, VarPtr(k)) <> 0 Then
        ParseEatBytePtrAlias = 1
    End If
End Function

' dword/word/byte/handle/hwnd/integer → Long 相当（仮引数・戻り値）。一致で pos を進める
Function ParseEatLongAlias(p As *Parser) As Long
    ParseEatLongAlias = 0
    If ParseEatLongAliasA(p) <> 0 Then
        ParseEatLongAlias = 1
        Exit Function
    End If
    If ParseEatLongAliasB(p) <> 0 Then
        ParseEatLongAlias = 1
    End If
End Function

' As キャスト: mask（0=変換なし）。-1=失敗、-2=String 禁止
Function ParseCastMask(p As *Parser) As Long
    Dim k(31) As Byte
    Dim name(63) As Byte

    ParseCastMask = -1
    lstrcpy(VarPtr(k), "string")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        ParseCastMask = -2
        Exit Function
    End If
    lstrcpy(VarPtr(k), "byte")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p->pos = p->pos + 1
        ParseCastMask = 255
        Exit Function
    End If
    lstrcpy(VarPtr(k), "char")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p->pos = p->pos + 1
        ParseCastMask = 255
        Exit Function
    End If
    lstrcpy(VarPtr(k), "word")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p->pos = p->pos + 1
        ParseCastMask = 65535
        Exit Function
    End If
    lstrcpy(VarPtr(k), "long")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p->pos = p->pos + 1
        ParseCastMask = 0
        Exit Function
    End If
    lstrcpy(VarPtr(k), "dword")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p->pos = p->pos + 1
        ParseCastMask = 0
        Exit Function
    End If
    lstrcpy(VarPtr(k), "integer")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p->pos = p->pos + 1
        ParseCastMask = 0
        Exit Function
    End If
    lstrcpy(VarPtr(k), "single")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p->pos = p->pos + 1
        ParseCastMask = 0
        Exit Function
    End If
    lstrcpy(VarPtr(k), "double")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p->pos = p->pos + 1
        ParseCastMask = 0
        Exit Function
    End If
    lstrcpy(VarPtr(k), "int64")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p->pos = p->pos + 1
        ParseCastMask = 0
        Exit Function
    End If
    lstrcpy(VarPtr(k), "qword")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p->pos = p->pos + 1
        ParseCastMask = 0
        Exit Function
    End If
    ' ハンドル・ポインタ別名は幅変換なし
    If ParseEatLongAlias(p) <> 0 Then
        ParseCastMask = 0
        Exit Function
    End If
    If ParseCopyIdent(p, VarPtr(name)) = 0 Then Exit Function
    ParseCastMask = 0
End Function

' expression As type（失敗時 -1）
Function ParseApplyAs(p As *Parser, e As Long) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim n As Long
    Dim mask As Long
    Dim sawStar As Long
    Dim k(7) As Byte

    ParseApplyAs = e
    If e < 0 Then
        ParseApplyAs = -1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "as")
    If ParseIdentIs(p, VarPtr(k)) = 0 Then Exit Function
    p->pos = p->pos + 1
    sawStar = 0
    If ParseTokKind(p) = TK_STAR Then
        p->pos = p->pos + 1
        sawStar = 1
    End If
    mask = ParseCastMask(p)
    If mask = -2 Then
        Print "error: cannot cast to/from String"
        p->err = 1
        ParseApplyAs = -1
        Exit Function
    End If
    If mask < 0 Then
        p->err = 1
        ParseApplyAs = -1
        Exit Function
    End If
    ' *Byte などはポインタ再解釈。Byte の 255 マスクを掛けない
    If sawStar <> 0 Then mask = 0
    ast = p->ast
    n = AstAddNode(ast, AST_CAST)
    If n < 0 Then
        ParseApplyAs = -1
        Exit Function
    End If
    nodes = ast->nodes
    nodes[n].left = e
    nodes[n].num = mask
    ParseApplyAs = n
End Function

' 次が代入演算子か（= / += / ++ / Mod= 等）
Function ParseIsAssignOpAhead(p As *Parser) As Long
    Dim k(7) As Byte
    Dim t As Long

    ParseIsAssignOpAhead = 0
    t = ParseTokKind(p)
    If t = TK_EQ Then
        ParseIsAssignOpAhead = 1
        Exit Function
    End If
    If t = TK_PLUS Then
        If ParseTokKindAt(p, p->pos + 1) = TK_PLUS Or ParseTokKindAt(p, p->pos + 1) = TK_EQ Then
            ParseIsAssignOpAhead = 1
        End If
        Exit Function
    End If
    If t = TK_MINUS Then
        If ParseTokKindAt(p, p->pos + 1) = TK_MINUS Or ParseTokKindAt(p, p->pos + 1) = TK_EQ Then
            ParseIsAssignOpAhead = 1
        End If
        Exit Function
    End If
    If t = TK_STAR Or t = TK_SLASH Or t = TK_BACKSLASH Or t = TK_SHL Or t = TK_SHR Then
        If ParseTokKindAt(p, p->pos + 1) = TK_EQ Then
            ParseIsAssignOpAhead = 1
        End If
        Exit Function
    End If
    lstrcpy(VarPtr(k), "mod")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        If ParseTokKindAt(p, p->pos + 1) = TK_EQ Then ParseIsAssignOpAhead = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "and")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        If ParseTokKindAt(p, p->pos + 1) = TK_EQ Then ParseIsAssignOpAhead = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "or")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        If ParseTokKindAt(p, p->pos + 1) = TK_EQ Then ParseIsAssignOpAhead = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "xor")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        If ParseTokKindAt(p, p->pos + 1) = TK_EQ Then ParseIsAssignOpAhead = 1
    End If
End Function

Function ParseMakeAssignBin(p As *Parser, left As Long, op As Long, right As Long) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nBin As Long
    Dim nAsg As Long

    ParseMakeAssignBin = -1
    If left < 0 Or right < 0 Then Exit Function
    ast = p->ast
    nBin = AstAddNode(ast, AST_BINOP)
    If nBin < 0 Then Exit Function
    nodes = ast->nodes
    nodes[nBin].num = op
    nodes[nBin].left = left
    nodes[nBin].right = right
    nAsg = AstAddNode(ast, AST_ASSIGN)
    If nAsg < 0 Then Exit Function
    nodes = ast->nodes
    nodes[nAsg].left = left
    nodes[nAsg].right = nBin
    ParseMakeAssignBin = nAsg
End Function

' lvalue の後の = / += / ++ など
Function ParseAssignIncDec(p As *Parser, left As Long) As Long
    Dim nOne As Long
    Dim ast As *Ast
    Dim nodes As *AstNode

    ParseAssignIncDec = -2
    ast = p->ast
    If ParseTokKind(p) = TK_PLUS Then
        If ParseTokKindAt(p, p->pos + 1) = TK_PLUS Then
            p->pos = p->pos + 2
            nOne = AstAddNode(ast, AST_NUM)
            If nOne < 0 Then
                ParseAssignIncDec = -1
                Exit Function
            End If
            nodes = ast->nodes
            nodes[nOne].num = 1
            ParseAssignIncDec = ParseMakeAssignBin(p, left, BOP_ADD, nOne)
            Exit Function
        End If
    End If
    If ParseTokKind(p) = TK_MINUS Then
        If ParseTokKindAt(p, p->pos + 1) = TK_MINUS Then
            p->pos = p->pos + 2
            nOne = AstAddNode(ast, AST_NUM)
            If nOne < 0 Then
                ParseAssignIncDec = -1
                Exit Function
            End If
            nodes = ast->nodes
            nodes[nOne].num = 1
            ParseAssignIncDec = ParseMakeAssignBin(p, left, BOP_SUB, nOne)
        End If
    End If
End Function
