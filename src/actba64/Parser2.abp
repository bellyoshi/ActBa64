' --- split from Parser.abp (part 2) ---
Function ParseEatLongAliasA(p As *Parser) As Long
    Dim k(31) As Byte

    ParseEatLongAliasA = 0
    lstrcpy(VarPtr(k), "dword")
    If ParseEatAliasIf(p, VarPtr(k)) <> 0 Then
        ParseEatLongAliasA = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "word")
    If ParseEatAliasIf(p, VarPtr(k)) <> 0 Then
        ParseEatLongAliasA = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "byte")
    If ParseEatAliasIf(p, VarPtr(k)) <> 0 Then
        ParseEatLongAliasA = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "handle")
    If ParseEatAliasIf(p, VarPtr(k)) <> 0 Then
        ParseEatLongAliasA = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "hdrop")
    If ParseEatAliasIf(p, VarPtr(k)) <> 0 Then
        ParseEatLongAliasA = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "hwnd")
    If ParseEatAliasIf(p, VarPtr(k)) <> 0 Then
        ParseEatLongAliasA = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "integer")
    If ParseEatAliasIf(p, VarPtr(k)) <> 0 Then
        ParseEatLongAliasA = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "hdc")
    If ParseEatAliasIf(p, VarPtr(k)) <> 0 Then
        ParseEatLongAliasA = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "hfont")
    If ParseEatAliasIf(p, VarPtr(k)) <> 0 Then
        ParseEatLongAliasA = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "hmenu")
    If ParseEatAliasIf(p, VarPtr(k)) <> 0 Then
        ParseEatLongAliasA = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "hbrush")
    If ParseEatAliasIf(p, VarPtr(k)) <> 0 Then
        ParseEatLongAliasA = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "hicon")
    If ParseEatAliasIf(p, VarPtr(k)) <> 0 Then
        ParseEatLongAliasA = 1
    End If
End Function

