' AstLowerExprLeaf - リテラル、変数、メンバ、添字

Function LowExprNum(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(LOW_STACK_PAD - 1) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim offs As *Long
    Dim types As *Long
    Dim list As *IrList
    Dim typeTable As *TypeTable
    Dim typeIdxs As *Long
    Dim byRefs As *Long

    LowExprNum = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    typeTable = ast->types
    offs = ctx->offs
    types = ctx->types
    typeIdxs = ctx->typeIdxs
    byRefs = ctx->byRefs

    If nodes[idx].extra = AST_NUM_EXTRA_SINGLE Then
        IrEmit(list, OP_MOV_EAX_IMM, nodes[idx].num, 0)
    ElseIf nodes[idx].extra = AST_NUM_EXTRA_DOUBLE Then
        IrEmit(list, OP_MOV_RAX_IMM64, nodes[idx].num, nodes[idx].left)
    Else
        IrEmit(list, OP_MOV_EAX_IMM, nodes[idx].num, 0)
    End If
    LowExprNum = 1
End Function

Function LowExprString(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(LOW_STACK_PAD - 1) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim buf(TEXT_LEN - 1) As Byte
    Dim offs As *Long
    Dim types As *Long
    Dim list As *IrList
    Dim typeTable As *TypeTable
    Dim typeIdxs As *Long
    Dim byRefs As *Long
    Dim slen As Long
    Dim strs As *Byte
    Dim stOff As Long
    Dim j As Long
    Dim irIdx As Long

    LowExprString = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    typeTable = ast->types
    offs = ctx->offs
    types = ctx->types
    typeIdxs = ctx->typeIdxs
    byRefs = ctx->byRefs

    slen = AstStrByteLen(ast, idx)
    If slen <= 0 Then
        AstCopyStr(ast, idx, VarPtr(buf))
        slen = 0
        While buf[slen] <> 0
            slen = slen + 1
        Wend
    Else
        AstCopyStrTo(ast, idx, VarPtr(buf), slen)
    End If
    irIdx = IrEmit(list, OP_LEA_RAX_STR, 0, slen)
    If irIdx < 0 Then Exit Function
    IrSetStrAtN(list, irIdx, VarPtr(buf), slen)
    LowExprString = 1
End Function

Sub LowEmitConstNum(list As *IrList, ci As Long, v As Long)
    If g_constIsDbl[ci] <> 0 Then
        IrEmit(list, OP_MOV_RAX_IMM64, v, g_constHi[ci])
    Else
        IrEmit(list, OP_MOV_EAX_IMM, v, 0)
    End If
End Sub

' 定数（数値／文字列）なら rax へ積んで 1 を返す
' 戻り値 true : 正常終了  false : エラーあり
Function LowExprVarConst(ctx As *LowerCtx, name As *Byte) As boolean
    Dim list As *IrList
    Dim ci As Long
    Dim vals As *Long
    Dim strs As *Byte

    LowExprVarConst = false
    list = ctx->list
    ci = LowFindConst(ctx, name)
    If ci >= 0 Then
        vals = ctx->constVals
        LowEmitConstNum(list, ci, vals[ci])
        LowExprVarConst = true
        Exit Function
    End If
    ci = LowFindStrConst(ctx, name)
    If ci >= 0 Then
        strs = ctx->constStrVals
        IrEmitStr(list, OP_LEA_RAX_STR, 0, VarPtr(strs[ci * AST_STR_LEN]))
        LowExprVarConst = true
    End If
End Function

Function LowExprVar(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(LOW_STACK_PAD - 1) As Byte
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim ast As *Ast
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim list As *IrList

    LowExprVar = 0
    ast = ctx->ast
    list = ctx->list

    AstCopyStr(ast, idx, VarPtr(name))
    If LowExprVarConst(ctx, VarPtr(name)) Then
        LowExprVar = 1
        Exit Function
    End If
    If Not LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) Then
        LowerDiagError(ctx, idx, LowUndefMsg$(VarPtr(name)))
        Exit Function
    End If
    ' 配列名は値として使うと先頭アドレス（ofn.lpstrFile = b など）
    If LowIsArrTy(vTy) Then
        LowExprVar = LowAddr(ctx, idx)
        Exit Function
    End If
    ' ByRef の整数は宣言の幅で読む（Long は 4 バイト。64bit でも隣の要素を読まない）
    If vByRef <> 0 And LowByRefWidth(vTy, vTypeIdx) < 8 Then
        LowEmitLoadOff(list, vOff, vGlob)
        LowLoadSized(list, LowByRefWidth(vTy, vTypeIdx))
        LowExprVar = 1
        Exit Function
    End If
    LowEmitLoadVarVal(list, vOff, vTy, vByRef, vGlob)
    LowExprVar = 1
End Function

Function LowExprMember(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(LOW_STACK_PAD - 1) As Byte
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim ast As *Ast
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim buf(TEXT_LEN - 1) As Byte
    Dim list As *IrList
    Dim typeTable As *TypeTable
    Dim fieldOff As Long
    Dim fieldSize As Long
    Dim fieldCount As Long
    Dim typeIdx As Long

    LowExprMember = 0
    ast = ctx->ast
    list = ctx->list
    typeTable = ast->types

    If LowAddr(ctx, idx) = 0 Then Exit Function
    ' 配列のフィールドは配列名と同じく先頭アドレスを値にする（lstrcpy(t.buf, ...) など）
    If LowMemberIsArr(ctx, idx) <> 0 Then
        LowExprMember = 1
        Exit Function
    End If
    AstCopyStr(ast, idx, VarPtr(name))
    If Not LowMemberBaseName(ctx, idx, VarPtr(buf)) Then
        LowExprMember = LowExprMemSized(ctx, idx, list)
        Exit Function
    End If
    If Not LowLookupVar(ctx, VarPtr(buf), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) Then
        ctx->err = 1
        Exit Function
    End If
    typeIdx = vTypeIdx
    If TyFindField(typeTable, typeIdx, VarPtr(name), fieldOff, fieldSize, fieldCount) = 0 Then
        LowLoadSized(list, LowTyNbytes(vTy))
        LowExprMember = 1
        Exit Function
    End If
    LowLoadSized(list, fieldSize)
    LowExprMember = 1
End Function

' base が AST_MEMBER の添字（UDT 配列フィールド / ポインタフィールド）
Function LowExprIndexMember(ctx As *LowerCtx, idx As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim buf(TEXT_LEN - 1) As Byte
    Dim list As *IrList
    Dim typeTable As *TypeTable
    Dim fieldOff As Long
    Dim fieldSize As Long
    Dim fieldCount As Long
    Dim fieldTy As Long
    Dim typeIdx As Long
    Dim base As Long

    LowExprIndexMember = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    typeTable = ast->types
    base = nodes[idx].left
    If LowAddr(ctx, idx) = 0 Then Exit Function
    AstCopyStr(ast, base, VarPtr(name))
    ' ネストしたメンバ（h.Raw.GameID[3]）や *T の -> もたどる
    If Not LowResolveMemberField(ctx, base, fieldOff, fieldSize, fieldCount, fieldTy) Then
        ctx->err = 1
        Exit Function
    End If
    If fieldCount > 1 Then
        LowLoadSized(list, fieldSize)
    ElseIf fieldSize = TyPtrSize() Then
        LowLoadSized(list, LowPtrFieldElemSize(fieldTy))
    Else
        ctx->err = 1
        Exit Function
    End If
    LowExprIndexMember = 1
End Function

' base が単純変数／ポインタの添字
Function LowExprIndexBase(ctx As *LowerCtx, idx As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim buf(TEXT_LEN - 1) As Byte
    Dim list As *IrList
    Dim base As Long

    LowExprIndexBase = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    base = nodes[idx].left
    If LowAddr(ctx, idx) = 0 Then Exit Function
    AstCopyStr(ast, base, VarPtr(buf))
    If LowLookupVar(ctx, VarPtr(buf), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) Then
        vTy = LowElemTyOf(vTy, vTypeIdx)
        If vTy = TY_PTR_LONG Or vTy = TY_LONG_ARR Then
            LowLoadSized(list, 4)
        ElseIf vTy = TY_WORD_ARR Then
            LowLoadSized(list, 2)
        ElseIf vTy = TY_PTR_BYTE Then
            IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
        ElseIf LowIsPtrSlot(vTy) <> 0 Then
            IrEmit(list, OP_LOAD_PTR, 0, 0)
        ElseIf vTy = TY_DOUBLE_ARR Then
            LowLoadWide(list)
        ElseIf vTy = TY_SINGLE_ARR Then
            LowLoadSized(list, 4)
        ElseIf vTy = TY_UDT_ARR Then
            ' 要素全体の値ロードはしない（メンバアクセス経由）
            ctx->err = 1
            Exit Function
        Else
            IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
        End If
    Else
        IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
    End If
    LowExprIndexBase = 1
End Function

Function LowExprIndex(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(LOW_STACK_PAD - 1) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim base As Long

    ast = ctx->ast
    nodes = ast->nodes
    base = nodes[idx].left
    If nodes[base].kind = AST_MEMBER Then
        LowExprIndex = LowExprIndexMember(ctx, idx)
    Else
        LowExprIndex = LowExprIndexBase(ctx, idx)
    End If
End Function
