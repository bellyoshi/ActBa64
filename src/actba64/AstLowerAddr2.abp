' --- split from AstLowerAddr.abp (part 2) ---
Function LowMemberFieldSize(ctx As *LowerCtx, idx As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim tt As *TypeTable
    Dim base As Long
    Dim name(63) As Byte
    Dim fname(63) As Byte
    Dim ti As Long
    Dim foff As Long
    Dim fsz As Long
    Dim fcnt As Long
    Dim fieldTy As Long

    LowMemberFieldSize = 0
    If idx < 0 Then Exit Function
    ast = ctx->ast
    nodes = ast->nodes
    If nodes[idx].kind <> AST_MEMBER Then Exit Function
    tt = ast->types
    base = nodes[idx].left
    AstCopyStr(ast, idx, VarPtr(fname))
    If nodes[base].kind = AST_MEMBER Then
        ti = LowMemberFieldType(ctx, base)
    ElseIf nodes[base].kind = AST_VAR Then
        AstCopyStr(ast, base, VarPtr(name))
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then Exit Function
        ti = vTypeIdx
    ElseIf nodes[base].kind = AST_INDEX Then
        AstCopyStr(ast, nodes[base].left, VarPtr(name))
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then Exit Function
        ti = vTypeIdx
    Else
        Exit Function
    End If
    If ti < 0 Then Exit Function
    If TyFindFieldEx(tt, ti, VarPtr(fname), foff, fsz, fcnt, fieldTy) = 0 Then Exit Function
    LowMemberFieldSize = fsz
End Function

Function LowAddrVar(ctx As *LowerCtx, idx As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList
    Dim name(63) As Byte

    LowAddrVar = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    AstCopyStr(ast, idx, VarPtr(name))
    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
        ctx->err = 1
        Exit Function
    End If
    If vByRef <> 0 Then
        LowEmitLoadOff(list, vOff, vGlob)
    Else
        LowEmitLeaOff(list, vOff, vGlob)
    End If
    LowAddrVar = 1
End Function

' AST_INDEX を基底に持つメンバの基底アドレスを出力し、UDT 型を tiOut へ返す
Function LowAddrMemberIdxBase(ctx As *LowerCtx, base As Long, ByRef tiOut As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte

    LowAddrMemberIdxBase = 0
    tiOut = -1
    ast = ctx->ast
    nodes = ast->nodes
    If LowAddr(ctx, base) = 0 Then Exit Function
    AstCopyStr(ast, nodes[base].left, VarPtr(name))
    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
        ctx->err = 1
        Exit Function
    End If
    tiOut = vTypeIdx
    LowAddrMemberIdxBase = 1
End Function

' AST_VAR を基底に持つメンバの基底アドレスを出力し、UDT 型を tiOut へ返す
Function LowAddrMemberVarBase(ctx As *LowerCtx, idx As Long, base As Long, ByRef tiOut As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList
    Dim name(63) As Byte

    LowAddrMemberVarBase = 0
    tiOut = -1
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    AstCopyStr(ast, base, VarPtr(name))
    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
        ctx->err = 1
        Exit Function
    End If
    tiOut = vTypeIdx
    If nodes[idx].num <> 0 Then
        LowEmitLoadOff(list, vOff, vGlob)
    ElseIf vTy = TY_PTR_UDT Then
        LowEmitLoadOff(list, vOff, vGlob)
    Else
        LowEmitLeaOff(list, vOff, vGlob)
    End If
    LowAddrMemberVarBase = 1
End Function

Function LowAddrMember(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList
    Dim fname(63) As Byte
    Dim base As Long
    Dim tt As *TypeTable
    Dim foff As Long
    Dim fsz As Long
    Dim fcnt As Long
    Dim ti As Long

    LowAddrMember = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    tt = ast->types
    base = nodes[idx].left
    AstCopyStr(ast, idx, VarPtr(fname))
    If nodes[base].kind = AST_MEMBER Then
        ' nested: a.b.c — address of a.b then + offset(c)
        If LowAddr(ctx, base) = 0 Then Exit Function
        ti = LowMemberFieldType(ctx, base)
        If ti < 0 Then
            ctx->err = 1
            Exit Function
        End If
    ElseIf nodes[base].kind = AST_INDEX Then
        If LowAddrMemberIdxBase(ctx, base, ti) = 0 Then Exit Function
    ElseIf nodes[base].kind = AST_VAR Then
        If LowAddrMemberVarBase(ctx, idx, base, ti) = 0 Then Exit Function
    Else
        ctx->err = 1
        Exit Function
    End If
    If TyFindField(tt, ti, VarPtr(fname), foff, fsz, fcnt) = 0 Then
        ' With 対象が UDT でないとき .x は基底のまま（p.x → p）
        LowAddrMember = 1
        Exit Function
    End If
    If foff <> 0 Then
        IrEmit(list, OP_ADD_RAX_IMM, foff, 0)
    End If
    LowAddrMember = 1
End Function

Function LowIsArrTy(ty As Long) As Long
    LowIsArrTy = 0
    If ty = TY_BYTE_ARR Or ty = TY_LONG_ARR Or ty = TY_STRING_ARR Then
        LowIsArrTy = 1
    ElseIf ty = TY_DOUBLE_ARR Or ty = TY_SINGLE_ARR Or ty = TY_UDT_ARR Then
        LowIsArrTy = 1
    End If
End Function

' rax = 配列先頭, rcx = 添字 → rax = 要素アドレス
Function LowAddrArrayCallScale(ctx As *LowerCtx, list As *IrList, tt As *TypeTable, vTy As Long, vTypeIdx As Long) As Long
    Dim ti As Long
    Dim esz As Long
    Dim tsizes As *Long

    LowAddrArrayCallScale = 0
    If vTy = TY_STRING_ARR Then
        LowEmitScalePtr(list)
        IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
    ElseIf vTy = TY_DOUBLE_ARR Then
        IrEmit(list, OP_SHL_ECX_3, 0, 0)
        IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
    ElseIf vTy = TY_LONG_ARR Or vTy = TY_SINGLE_ARR Then
        ' Long/DWord/Single = 4 bytes（WinAPI の UINT* 等と互換）
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
        IrEmit(list, OP_MOV_ECX, 4, 0)
        IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
        IrEmit(list, OP_POP_RCX, 0, 0)
        IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
    ElseIf vTy = TY_UDT_ARR Then
        ti = vTypeIdx
        tsizes = tt->typeSizes
        esz = tsizes[ti]
        If esz <= 0 Then
            ctx->err = 1
            Exit Function
        End If
        If esz = 1 Then
            IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
        Else
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
            IrEmit(list, OP_MOV_ECX, esz, 0)
            IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
            IrEmit(list, OP_POP_RCX, 0, 0)
            IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
        End If
    Else
        IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
    End If
    LowAddrArrayCallScale = 1
End Function

Function LowAddrArrayCall(ctx As *LowerCtx, idx As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList
    Dim name(63) As Byte
    Dim nArgs As Long
    Dim tt As *TypeTable
    Dim ix As Long

    LowAddrArrayCall = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    tt = ast->types
    nArgs = nodes[idx].num
    If nArgs <> 1 Then
        ctx->err = 1
        Exit Function
    End If
    AstCopyStr(ast, idx, VarPtr(name))
    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
        ctx->err = 1
        Exit Function
    End If
    If LowIsArrTy(vTy) = 0 Then
        ctx->err = 1
        Exit Function
    End If
    ' index expr is left of CALL (AST_ARG wrapper)
    ix = nodes[idx].left
    If ix >= 0 Then
        If nodes[ix].kind = AST_ARG Then ix = nodes[ix].left
    End If
    If LowExpr(ctx, ix) = 0 Then Exit Function
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    LowEmitLeaOff(list, vOff, vGlob)
    IrEmit(list, OP_POP_RCX, 0, 0)
    LowAddrArrayCall = LowAddrArrayCallScale(ctx, list, tt, vTy, vTypeIdx)
End Function

' AST_MEMBER ノードの基底（AST_INDEX / AST_VAR）の変数名を dst へ取り出す
Function LowMemberBaseName(ctx As *LowerCtx, memIdx As Long, dst As *Byte) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim b As Long

    LowMemberBaseName = 0
    ast = ctx->ast
    nodes = ast->nodes
    b = nodes[memIdx].left
    If nodes[b].kind = AST_INDEX Then
        AstCopyStr(ast, nodes[b].left, dst)
    ElseIf nodes[b].kind = AST_VAR Then
        AstCopyStr(ast, b, dst)
    Else
        Exit Function
    End If
    LowMemberBaseName = 1
End Function

' UDT 配列フィールド: &field[0] + index * elemSize
Function LowAddrIndexMemberArr(ctx As *LowerCtx, list As *IrList, idx As Long, base As Long, esz As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast

    LowAddrIndexMemberArr = 0
    ast = ctx->ast
    nodes = ast->nodes
    If esz <= 0 Then
        ctx->err = 1
        Exit Function
    End If
    If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
    LowEmitZxEax(list)
    If esz <> 1 Then
        IrEmit(list, OP_MOV_ECX, esz, 0)
        IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
    End If
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    If LowAddr(ctx, base) = 0 Then Exit Function
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
    LowAddrIndexMemberArr = 1
End Function

' ポインタフィールド: *Long は index*4、それ以外（*Byte 等）はバイト添字
Function LowAddrIndexMemberPtr(ctx As *LowerCtx, list As *IrList, idx As Long, base As Long, fieldTy As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim esz As Long

    LowAddrIndexMemberPtr = 0
    ast = ctx->ast
    nodes = ast->nodes
    esz = LowPtrFieldElemSize(fieldTy)
    If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
    LowEmitZxEax(list)
    If esz <> 1 Then
        IrEmit(list, OP_MOV_ECX, esz, 0)
        IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
    End If
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    If LowExpr(ctx, base) = 0 Then Exit Function
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
    LowAddrIndexMemberPtr = 1
End Function

Function LowAddrIndexMember(ctx As *LowerCtx, idx As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList
    Dim name(63) As Byte
    Dim fname(63) As Byte
    Dim base As Long
    Dim tt As *TypeTable
    Dim foff As Long
    Dim fsz As Long
    Dim fcnt As Long
    Dim fieldTy As Long
    Dim ti As Long

    LowAddrIndexMember = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    tt = ast->types
    base = nodes[idx].left
    AstCopyStr(ast, base, VarPtr(fname))
    If LowMemberBaseName(ctx, base, VarPtr(name)) = 0 Then
        ctx->err = 1
        Exit Function
    End If
    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
        ctx->err = 1
        Exit Function
    End If
    ti = vTypeIdx
    If TyFindFieldEx(tt, ti, VarPtr(fname), foff, fsz, fcnt, fieldTy) = 0 Then
        ctx->err = 1
        Exit Function
    End If
    If fcnt > 1 Then
        LowAddrIndexMember = LowAddrIndexMemberArr(ctx, list, idx, base, fsz)
    ElseIf fsz = TyPtrSize() Then
        LowAddrIndexMember = LowAddrIndexMemberPtr(ctx, list, idx, base, fieldTy)
    Else
        ctx->err = 1
    End If
End Function

' UDT 配列: スタックトップの添字を要素サイズ倍して先頭アドレスへ加算
