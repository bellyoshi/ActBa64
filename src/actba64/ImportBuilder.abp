' ===================================================
'  ImportBuilder - dynamic .idata / string pool builder
'  (heap tables in module Dims: stage0 Type field limit)
' ===================================================

Const IB_NAME_LEN = 64
Const IB_STR_LEN = 256

Type ImportBuilder
    dllCount As Long
    stringCount As Long
    dllCap As Long
    funcCapPerDll As Long
    stringCap As Long
    iatRva As DWord
    iatSize As DWord
    idtRva As DWord
    idtSize As DWord
    totalSize As DWord
End Type

Dim g_ibFuncCount As *Long
Dim g_ibDllNames As *Byte
Dim g_ibFuncNames As *Byte
Dim g_ibStrValues As *Byte
Dim g_ibFuncIatRva As *DWord
Dim g_ibFuncHintRva As *DWord
Dim g_ibDllIatRva As *DWord
Dim g_ibDllIltRva As *DWord
Dim g_ibDllNameRva As *DWord
Dim g_ibStrRva As *DWord

Function IbStrLen(s As *Byte) As Long
    Dim n As Long
    n = 0
    While s[n] <> 0
        n = n + 1
    Wend
    IbStrLen = n
End Function

Function IbStrEq(a As *Byte, b As *Byte) As Long
    Dim i As Long
    i = 0
    Do
        If a[i] <> b[i] Then
            IbStrEq = 0
            Exit Function
        End If
        If a[i] = 0 Then
            IbStrEq = 1
            Exit Function
        End If
        i = i + 1
    Loop
End Function

Sub IbStrCpy(dst As *Byte, src As *Byte, maxLen As Long)
    Dim i As Long
    i = 0
    While src[i] <> 0 And i < maxLen - 1
        dst[i] = src[i]
        i = i + 1
    Wend
    dst[i] = 0
End Sub

Function IbAlign2(v As DWord) As DWord
    IbAlign2 = (v + 1) And &HFFFFFFFE
End Function

Function IbFuncSlot(builder As *ImportBuilder, dIdx As Long, fIdx As Long) As Long
    IbFuncSlot = dIdx * builder->funcCapPerDll + fIdx
End Function

Function IbFuncSlots(builder As *ImportBuilder) As Long
    IbFuncSlots = builder->dllCap * builder->funcCapPerDll
End Function

Sub IbCopyBytes(dst As *Byte, baseOff As Long, src As *Byte, maxLen As Long)
    Dim i As Long
    i = 0
    While src[i] <> 0 And i < maxLen - 1
        dst[baseOff + i] = src[i]
        i = i + 1
    Wend
    dst[baseOff + i] = 0
End Sub

Function IbNameEqAt(buf As *Byte, baseOff As Long, name As *Byte) As Long
    Dim i As Long
    i = 0
    Do
        If buf[baseOff + i] <> name[i] Then
            IbNameEqAt = 0
            Exit Function
        End If
        If buf[baseOff + i] = 0 Then
            IbNameEqAt = 1
            Exit Function
        End If
        i = i + 1
    Loop
End Function

Function IbNameLenAt(buf As *Byte, baseOff As Long) As Long
    Dim n As Long
    n = 0
    While buf[baseOff + n] <> 0
        n = n + 1
    Wend
    IbNameLenAt = n
End Function

Function IbDllNameEq(builder As *ImportBuilder, dIdx As Long, name As *Byte) As Long
    IbDllNameEq = IbNameEqAt(g_ibDllNames, dIdx * IB_NAME_LEN, name)
End Function

Function IbFuncNameEq(builder As *ImportBuilder, dIdx As Long, fIdx As Long, name As *Byte) As Long
    IbFuncNameEq = IbNameEqAt(g_ibFuncNames, IbFuncSlot(builder, dIdx, fIdx) * IB_NAME_LEN, name)
End Function

Function IbStrValueEq(builder As *ImportBuilder, sIdx As Long, name As *Byte) As Long
    IbStrValueEq = IbNameEqAt(g_ibStrValues, sIdx * IB_STR_LEN, name)
End Function

Function IbDllNameLen(builder As *ImportBuilder, dIdx As Long) As Long
    IbDllNameLen = IbNameLenAt(g_ibDllNames, dIdx * IB_NAME_LEN)
End Function

Function IbFuncNameLen(builder As *ImportBuilder, dIdx As Long, fIdx As Long) As Long
    IbFuncNameLen = IbNameLenAt(g_ibFuncNames, IbFuncSlot(builder, dIdx, fIdx) * IB_NAME_LEN)
End Function

Function IbStrValueLen(builder As *ImportBuilder, sIdx As Long) As Long
    IbStrValueLen = IbNameLenAt(g_ibStrValues, sIdx * IB_STR_LEN)
End Function

Sub IbFreeHeaps()
    If g_ibFuncCount <> NULL Then free(g_ibFuncCount)
    If g_ibDllNames <> NULL Then free(g_ibDllNames)
    If g_ibFuncNames <> NULL Then free(g_ibFuncNames)
    If g_ibStrValues <> NULL Then free(g_ibStrValues)
    If g_ibFuncIatRva <> NULL Then free(g_ibFuncIatRva)
    If g_ibFuncHintRva <> NULL Then free(g_ibFuncHintRva)
    If g_ibDllIatRva <> NULL Then free(g_ibDllIatRva)
    If g_ibDllIltRva <> NULL Then free(g_ibDllIltRva)
    If g_ibDllNameRva <> NULL Then free(g_ibDllNameRva)
    If g_ibStrRva <> NULL Then free(g_ibStrRva)
    g_ibFuncCount = NULL
    g_ibDllNames = NULL
    g_ibFuncNames = NULL
    g_ibStrValues = NULL
    g_ibFuncIatRva = NULL
    g_ibFuncHintRva = NULL
    g_ibDllIatRva = NULL
    g_ibDllIltRva = NULL
    g_ibDllNameRva = NULL
    g_ibStrRva = NULL
End Sub

Sub IbFree(builder As *ImportBuilder)
    IbFreeHeaps()
    If builder <> NULL Then free(builder)
End Sub

Function IbAllocTables(builder As *ImportBuilder) As Long
    Dim slots As Long
    IbAllocTables = 0
    slots = IbFuncSlots(builder)
    g_ibFuncCount = calloc(BytesN(builder->dllCap, SizeOf(Long)))
    g_ibDllNames = calloc(BytesN(builder->dllCap, IB_NAME_LEN))
    g_ibFuncNames = calloc(BytesN(slots, IB_NAME_LEN))
    g_ibStrValues = calloc(BytesN(builder->stringCap, IB_STR_LEN))
    g_ibFuncIatRva = calloc(BytesN(slots, SizeOf(DWord)))
    g_ibFuncHintRva = calloc(BytesN(slots, SizeOf(DWord)))
    g_ibDllIatRva = calloc(BytesN(builder->dllCap, SizeOf(DWord)))
    g_ibDllIltRva = calloc(BytesN(builder->dllCap, SizeOf(DWord)))
    g_ibDllNameRva = calloc(BytesN(builder->dllCap, SizeOf(DWord)))
    g_ibStrRva = calloc(BytesN(builder->stringCap, SizeOf(DWord)))
    If g_ibFuncCount = NULL Or g_ibDllNames = NULL Or g_ibFuncNames = NULL Or g_ibStrValues = NULL Or g_ibFuncIatRva = NULL Or g_ibFuncHintRva = NULL Or g_ibDllIatRva = NULL Or g_ibDllIltRva = NULL Or g_ibDllNameRva = NULL Or g_ibStrRva = NULL Then
        IbFreeHeaps()
        Exit Function
    End If
    IbAllocTables = 1
End Function

Sub IbInit(builder As *ImportBuilder)
    ZeroMem(builder, SizeOf(ImportBuilder))
    IbFreeHeaps()
    builder->dllCap = DYN_INIT
    builder->funcCapPerDll = DYN_INIT
    builder->stringCap = DYN_INIT
    If IbAllocTables(builder) = 0 Then
        Print "error: out of memory (ImportBuilder)"
    End If
End Sub

Function IbGrowDllCap(builder As *ImportBuilder) As Long
    Dim newCap As Long
    Dim oldCap As Long
    Dim oldSlots As Long
    Dim newSlots As Long
    Dim p As *Byte

    IbGrowDllCap = 0
    oldCap = builder->dllCap
    newCap = oldCap * 2
    If newCap <= oldCap Then Exit Function
    oldSlots = oldCap * builder->funcCapPerDll
    newSlots = newCap * builder->funcCapPerDll

    p = MemGrow(g_ibFuncCount, BytesN(oldCap, SizeOf(Long)), BytesN(newCap, SizeOf(Long)))
    If p = NULL Then Exit Function
    g_ibFuncCount = p
    p = MemGrow(g_ibDllNames, BytesN(oldCap, IB_NAME_LEN), BytesN(newCap, IB_NAME_LEN))
    If p = NULL Then Exit Function
    g_ibDllNames = p
    p = MemGrow(g_ibDllIatRva, BytesN(oldCap, SizeOf(DWord)), BytesN(newCap, SizeOf(DWord)))
    If p = NULL Then Exit Function
    g_ibDllIatRva = p
    p = MemGrow(g_ibDllIltRva, BytesN(oldCap, SizeOf(DWord)), BytesN(newCap, SizeOf(DWord)))
    If p = NULL Then Exit Function
    g_ibDllIltRva = p
    p = MemGrow(g_ibDllNameRva, BytesN(oldCap, SizeOf(DWord)), BytesN(newCap, SizeOf(DWord)))
    If p = NULL Then Exit Function
    g_ibDllNameRva = p
    p = MemGrow(g_ibFuncNames, BytesN(oldSlots, IB_NAME_LEN), BytesN(newSlots, IB_NAME_LEN))
    If p = NULL Then Exit Function
    g_ibFuncNames = p
    p = MemGrow(g_ibFuncIatRva, BytesN(oldSlots, SizeOf(DWord)), BytesN(newSlots, SizeOf(DWord)))
    If p = NULL Then Exit Function
    g_ibFuncIatRva = p
    p = MemGrow(g_ibFuncHintRva, BytesN(oldSlots, SizeOf(DWord)), BytesN(newSlots, SizeOf(DWord)))
    If p = NULL Then Exit Function
    g_ibFuncHintRva = p
    builder->dllCap = newCap
    IbGrowDllCap = 1
End Function

Function IbGrowFuncCap(builder As *ImportBuilder) As Long
    Dim oldPer As Long
    Dim newPer As Long
    Dim newSlots As Long
    Dim p As *Byte
    Dim d As Long
    Dim f As Long
    Dim oldOff As Long
    Dim newOff As Long
    Dim k As Long
    Dim oldNames As *Byte
    Dim oldIat As *DWord
    Dim oldHint As *DWord
    Dim fc As *Long
    Dim oldFc As Long

    IbGrowFuncCap = 0
    oldPer = builder->funcCapPerDll
    newPer = oldPer * 2
    If newPer <= oldPer Then Exit Function
    newSlots = builder->dllCap * newPer

    oldNames = g_ibFuncNames
    oldIat = g_ibFuncIatRva
    oldHint = g_ibFuncHintRva
    p = calloc(BytesN(newSlots, IB_NAME_LEN))
    If p = NULL Then Exit Function
    g_ibFuncNames = p
    p = calloc(BytesN(newSlots, SizeOf(DWord)))
    If p = NULL Then Exit Function
    g_ibFuncIatRva = p
    p = calloc(BytesN(newSlots, SizeOf(DWord)))
    If p = NULL Then Exit Function
    g_ibFuncHintRva = p

    fc = g_ibFuncCount
    d = 0
    While d < builder->dllCount
        oldFc = fc[d]
        f = 0
        While f < oldFc
            oldOff = (d * oldPer + f) * IB_NAME_LEN
            newOff = (d * newPer + f) * IB_NAME_LEN
            k = 0
            While k < IB_NAME_LEN
                g_ibFuncNames[newOff + k] = oldNames[oldOff + k]
                k = k + 1
            Wend
            g_ibFuncIatRva[d * newPer + f] = oldIat[d * oldPer + f]
            g_ibFuncHintRva[d * newPer + f] = oldHint[d * oldPer + f]
            f = f + 1
        Wend
        d = d + 1
    Wend
    free(oldNames)
    free(oldIat)
    free(oldHint)
    builder->funcCapPerDll = newPer
    IbGrowFuncCap = 1
End Function

Function IbGrowStringCap(builder As *ImportBuilder) As Long
    Dim newCap As Long
    Dim p As *Byte
    IbGrowStringCap = 0
    newCap = builder->stringCap * 2
    If newCap <= builder->stringCap Then Exit Function
    p = MemGrow(g_ibStrValues, BytesN(builder->stringCap, IB_STR_LEN), BytesN(newCap, IB_STR_LEN))
    If p = NULL Then Exit Function
    g_ibStrValues = p
    p = MemGrow(g_ibStrRva, BytesN(builder->stringCap, SizeOf(DWord)), BytesN(newCap, SizeOf(DWord)))
    If p = NULL Then Exit Function
    g_ibStrRva = p
    builder->stringCap = newCap
    IbGrowStringCap = 1
End Function

Function IbAddImport(builder As *ImportBuilder, dllName As *Byte, funcName As *Byte) As Long
    Dim i As Long
    Dim j As Long
    Dim dIdx As Long
    Dim fIdx As Long
    Dim gIdx As Long
    Dim off As Long
    Dim fc As *Long

    IbAddImport = -1
    fc = g_ibFuncCount
    If fc = NULL Then Exit Function
    gIdx = 0
    For i = 0 To builder->dllCount - 1
        If IbDllNameEq(builder, i, dllName) <> 0 Then
            For j = 0 To fc[i] - 1
                If IbFuncNameEq(builder, i, j, funcName) <> 0 Then
                    IbAddImport = gIdx + j
                    Exit Function
                End If
            Next
            If fc[i] >= builder->funcCapPerDll Then
                If IbGrowFuncCap(builder) = 0 Then Exit Function
                fc = g_ibFuncCount
            End If
            fIdx = fc[i]
            off = IbFuncSlot(builder, i, fIdx) * IB_NAME_LEN
            IbCopyBytes(g_ibFuncNames, off, funcName, IB_NAME_LEN)
            fc[i] = fIdx + 1
            IbAddImport = gIdx + fIdx
            Exit Function
        End If
        gIdx = gIdx + fc[i]
    Next

    If builder->dllCount >= builder->dllCap Then
        If IbGrowDllCap(builder) = 0 Then Exit Function
        fc = g_ibFuncCount
    End If
    dIdx = builder->dllCount
    IbCopyBytes(g_ibDllNames, dIdx * IB_NAME_LEN, dllName, IB_NAME_LEN)
    IbCopyBytes(g_ibFuncNames, IbFuncSlot(builder, dIdx, 0) * IB_NAME_LEN, funcName, IB_NAME_LEN)
    fc[dIdx] = 1
    builder->dllCount = dIdx + 1
    IbAddImport = gIdx
End Function

Function IbAddString(builder As *ImportBuilder, strVal As *Byte) As Long
    Dim i As Long
    Dim sIdx As Long

    For i = 0 To builder->stringCount - 1
        If IbStrValueEq(builder, i, strVal) <> 0 Then
            IbAddString = i
            Exit Function
        End If
    Next

    IbAddString = -1
    If builder->stringCount >= builder->stringCap Then
        If IbGrowStringCap(builder) = 0 Then Exit Function
    End If
    sIdx = builder->stringCount
    IbCopyBytes(g_ibStrValues, sIdx * IB_STR_LEN, strVal, IB_STR_LEN)
    builder->stringCount = sIdx + 1
    IbAddString = sIdx
End Function

Function IbGetIatRva(builder As *ImportBuilder, dllName As *Byte, funcName As *Byte) As DWord
    Dim i As Long
    Dim j As Long
    Dim slot As Long
    Dim fc As *Long

    IbGetIatRva = 0
    fc = g_ibFuncCount
    For i = 0 To builder->dllCount - 1
        If IbDllNameEq(builder, i, dllName) <> 0 Then
            For j = 0 To fc[i] - 1
                If IbFuncNameEq(builder, i, j, funcName) <> 0 Then
                    slot = IbFuncSlot(builder, i, j)
                    IbGetIatRva = g_ibFuncIatRva[slot]
                    Exit Function
                End If
            Next
            Exit Function
        End If
    Next
End Function

Function IbGetStringRva(builder As *ImportBuilder, strId As Long) As DWord
    IbGetStringRva = 0
    If strId < 0 Or strId >= builder->stringCount Then Exit Function
    IbGetStringRva = g_ibStrRva[strId]
End Function

Sub IbWriteNameBytes(outBuf As *Byte, dstOff As DWord, builder As *ImportBuilder, srcKind As Long, idx1 As Long, idx2 As Long)
    Dim i As Long
    Dim off As Long
    Dim b As Byte
    Dim src As *Byte
    If srcKind = 0 Then
        src = g_ibDllNames
        off = idx1 * IB_NAME_LEN
    ElseIf srcKind = 1 Then
        src = g_ibFuncNames
        off = IbFuncSlot(builder, idx1, idx2) * IB_NAME_LEN
    Else
        src = g_ibStrValues
        off = idx1 * IB_STR_LEN
    End If
    i = 0
    Do
        b = src[off + i]
        outBuf[dstOff + i] = b
        If b = 0 Then Exit Sub
        i = i + 1
    Loop
End Sub

Sub IbFinalize(builder As *ImportBuilder, baseRva As DWord, outBuf As *Byte, ByRef totalSize As DWord)
    Dim cur As DWord
    Dim i As Long
    Dim j As Long
    Dim n As Long
    Dim hintSz As DWord
    Dim idtOff As DWord
    Dim iltOff As DWord
    Dim nameOff As DWord
    Dim slot As Long
    Dim slotW As Long
    Dim fc As *Long

    cur = 0
    slotW = TyPtrSize()
    fc = g_ibFuncCount

    builder->iatRva = baseRva
    For i = 0 To builder->dllCount - 1
        g_ibDllIatRva[i] = baseRva + cur
        For j = 0 To fc[i] - 1
            slot = IbFuncSlot(builder, i, j)
            g_ibFuncIatRva[slot] = baseRva + cur
            cur = cur + slotW
        Next
        cur = cur + slotW
    Next
    builder->iatSize = cur

    builder->idtRva = baseRva + cur
    builder->idtSize = (builder->dllCount + 1) * 20
    idtOff = cur
    cur = cur + builder->idtSize

    For i = 0 To builder->dllCount - 1
        g_ibDllIltRva[i] = baseRva + cur
        cur = cur + (fc[i] + 1) * slotW
    Next

    For i = 0 To builder->dllCount - 1
        For j = 0 To fc[i] - 1
            cur = IbAlign2(cur)
            slot = IbFuncSlot(builder, i, j)
            g_ibFuncHintRva[slot] = baseRva + cur
            n = IbFuncNameLen(builder, i, j)
            hintSz = 2 + n + 1
            cur = cur + hintSz
        Next
    Next

    For i = 0 To builder->dllCount - 1
        cur = IbAlign2(cur)
        g_ibDllNameRva[i] = baseRva + cur
        n = IbDllNameLen(builder, i)
        cur = cur + n + 1
    Next

    For i = 0 To builder->stringCount - 1
        g_ibStrRva[i] = baseRva + cur + 4
        n = IbStrValueLen(builder, i)
        cur = cur + 4 + n + 1
    Next

    builder->totalSize = cur
    totalSize = cur
    ZeroMem(outBuf, cur)

    For i = 0 To builder->dllCount - 1
        For j = 0 To fc[i] - 1
            slot = IbFuncSlot(builder, i, j)
            PutDword(outBuf, g_ibFuncIatRva[slot] - baseRva, g_ibFuncHintRva[slot])
        Next
    Next

    For i = 0 To builder->dllCount - 1
        nameOff = idtOff + i * 20
        PutDword(outBuf, nameOff + 0, g_ibDllIltRva[i])
        PutDword(outBuf, nameOff + 12, g_ibDllNameRva[i])
        PutDword(outBuf, nameOff + 16, g_ibDllIatRva[i])
    Next

    For i = 0 To builder->dllCount - 1
        iltOff = g_ibDllIltRva[i] - baseRva
        For j = 0 To fc[i] - 1
            slot = IbFuncSlot(builder, i, j)
            PutDword(outBuf, iltOff + j * slotW, g_ibFuncHintRva[slot])
        Next
    Next

    For i = 0 To builder->dllCount - 1
        For j = 0 To fc[i] - 1
            slot = IbFuncSlot(builder, i, j)
            nameOff = g_ibFuncHintRva[slot] - baseRva
            PutWord(outBuf, nameOff, 0)
            IbWriteNameBytes(outBuf, nameOff + 2, builder, 1, i, j)
        Next
    Next

    For i = 0 To builder->dllCount - 1
        nameOff = g_ibDllNameRva[i] - baseRva
        IbWriteNameBytes(outBuf, nameOff, builder, 0, i, 0)
    Next

    For i = 0 To builder->stringCount - 1
        nameOff = g_ibStrRva[i] - baseRva - 4
        n = IbStrValueLen(builder, i)
        PutDword(outBuf, nameOff, n)
        IbWriteNameBytes(outBuf, nameOff + 4, builder, 2, i, 0)
    Next
End Sub
