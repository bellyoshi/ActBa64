' ===================================================
'  ImportBuilder - dynamic .idata / string pool builder
'  (heap tables in module Dims: stage0 Type field limit)
' ===================================================

Const IB_NAME_LEN = 64
Const IB_STR_LEN = 256

Type ImportBuilder
    dllCount As Long
    stringCount As Long
    dllCap As Long
    funcCapPerDll As Long
    stringCap As Long
    iatRva As DWord
    iatSize As DWord
    idtRva As DWord
    idtSize As DWord
    totalSize As DWord
End Type

Dim g_ibFuncCount As *Long
Dim g_ibDllNames As *Byte
Dim g_ibFuncNames As *Byte
Dim g_ibStrValues As *Byte
Dim g_ibFuncIatRva As *DWord
Dim g_ibFuncHintRva As *DWord
Dim g_ibDllIatRva As *DWord
Dim g_ibDllIltRva As *DWord
Dim g_ibDllNameRva As *DWord
Dim g_ibStrRva As *DWord
Dim g_ibStrLens As *Long

Function IbStrLen(s As *Byte) As Long
    Dim n As Long
    n = 0
    While s[n] <> 0
        n = n + 1
    Wend
    IbStrLen = n
End Function

Function IbStrEq(a As *Byte, b As *Byte) As Long
    Dim i As Long
    i = 0
    Do
        If a[i] <> b[i] Then
            IbStrEq = 0
            Exit Function
        End If
        If a[i] = 0 Then
            IbStrEq = 1
            Exit Function
        End If
        i = i + 1
    Loop
End Function

Sub IbStrCpy(dst As *Byte, src As *Byte, maxLen As Long)
    Dim i As Long
    i = 0
    While src[i] <> 0 And i < maxLen - 1
        dst[i] = src[i]
        i = i + 1
    Wend
    dst[i] = 0
End Sub

Function IbAlign2(v As DWord) As DWord
    IbAlign2 = (v + 1) And &HFFFFFFFE
End Function

Function IbFuncSlot(builder As *ImportBuilder, dIdx As Long, fIdx As Long) As Long
    IbFuncSlot = dIdx * builder->funcCapPerDll + fIdx
End Function

Function IbFuncSlots(builder As *ImportBuilder) As Long
    IbFuncSlots = builder->dllCap * builder->funcCapPerDll
End Function

Sub IbCopyBytes(dst As *Byte, baseOff As Long, src As *Byte, maxLen As Long)
    Dim i As Long
    i = 0
    While src[i] <> 0 And i < maxLen - 1
        dst[baseOff + i] = src[i]
        i = i + 1
    Wend
    dst[baseOff + i] = 0
End Sub

Sub IbCopyBytesN(dst As *Byte, baseOff As Long, src As *Byte, n As Long, maxLen As Long)
    Dim i As Long
    If n < 0 Then n = 0
    If n > maxLen - 1 Then n = maxLen - 1
    i = 0
    While i < n
        dst[baseOff + i] = src[i]
        i = i + 1
    Wend
    dst[baseOff + i] = 0
End Sub

Function IbNameEqAt(buf As *Byte, baseOff As Long, name As *Byte) As Long
    Dim i As Long
    i = 0
    Do
        If buf[baseOff + i] <> name[i] Then
            IbNameEqAt = 0
            Exit Function
        End If
        If buf[baseOff + i] = 0 Then
            IbNameEqAt = 1
            Exit Function
        End If
        i = i + 1
    Loop
End Function

Function IbNameLenAt(buf As *Byte, baseOff As Long) As Long
    Dim n As Long
    n = 0
    While buf[baseOff + n] <> 0
        n = n + 1
    Wend
    IbNameLenAt = n
End Function

Function IbDllNameEq(builder As *ImportBuilder, dIdx As Long, name As *Byte) As Long
    IbDllNameEq = IbNameEqAt(g_ibDllNames, dIdx * IB_NAME_LEN, name)
End Function

Function IbFuncNameEq(builder As *ImportBuilder, dIdx As Long, fIdx As Long, name As *Byte) As Long
    IbFuncNameEq = IbNameEqAt(g_ibFuncNames, IbFuncSlot(builder, dIdx, fIdx) * IB_NAME_LEN, name)
End Function

Function IbStrValueEq(builder As *ImportBuilder, sIdx As Long, name As *Byte) As Long
    IbStrValueEq = IbStrValueEqLen(builder, sIdx, name, -1)
End Function

Function IbStrValueEqLen(builder As *ImportBuilder, sIdx As Long, name As *Byte, nameLen As Long) As Long
    Dim off As Long
    Dim n As Long
    Dim i As Long
    IbStrValueEqLen = 0
    off = sIdx * IB_STR_LEN
    n = g_ibStrLens[sIdx]
    If n <= 0 Then
        IbStrValueEqLen = IbNameEqAt(g_ibStrValues, off, name)
        Exit Function
    End If
    If nameLen >= 0 Then
        If nameLen <> n Then Exit Function
    Else
        i = 0
        While name[i] <> 0
            i = i + 1
        Wend
        If i <> n Then Exit Function
    End If
    i = 0
    While i < n
        If g_ibStrValues[off + i] <> name[i] Then Exit Function
        i = i + 1
    Wend
    IbStrValueEqLen = 1
End Function

Function IbDllNameLen(builder As *ImportBuilder, dIdx As Long) As Long
    IbDllNameLen = IbNameLenAt(g_ibDllNames, dIdx * IB_NAME_LEN)
End Function

Function IbFuncNameLen(builder As *ImportBuilder, dIdx As Long, fIdx As Long) As Long
    IbFuncNameLen = IbNameLenAt(g_ibFuncNames, IbFuncSlot(builder, dIdx, fIdx) * IB_NAME_LEN)
End Function

Function IbStrValueLen(builder As *ImportBuilder, sIdx As Long) As Long
    If g_ibStrLens[sIdx] > 0 Then
        IbStrValueLen = g_ibStrLens[sIdx]
    Else
        IbStrValueLen = IbNameLenAt(g_ibStrValues, sIdx * IB_STR_LEN)
    End If
End Function

Sub IbFreeHeaps()
    If g_ibFuncCount <> NULL Then free(g_ibFuncCount)
    If g_ibDllNames <> NULL Then free(g_ibDllNames)
    If g_ibFuncNames <> NULL Then free(g_ibFuncNames)
    If g_ibStrValues <> NULL Then free(g_ibStrValues)
    If g_ibFuncIatRva <> NULL Then free(g_ibFuncIatRva)
    If g_ibFuncHintRva <> NULL Then free(g_ibFuncHintRva)
    If g_ibDllIatRva <> NULL Then free(g_ibDllIatRva)
    If g_ibDllIltRva <> NULL Then free(g_ibDllIltRva)
    If g_ibDllNameRva <> NULL Then free(g_ibDllNameRva)
    If g_ibStrRva <> NULL Then free(g_ibStrRva)
    If g_ibStrLens <> NULL Then free(g_ibStrLens)
    g_ibFuncCount = NULL
    g_ibDllNames = NULL
    g_ibFuncNames = NULL
    g_ibStrValues = NULL
    g_ibFuncIatRva = NULL
    g_ibFuncHintRva = NULL
    g_ibDllIatRva = NULL
    g_ibDllIltRva = NULL
    g_ibDllNameRva = NULL
    g_ibStrRva = NULL
    g_ibStrLens = NULL
End Sub

Sub IbFree(builder As *ImportBuilder)
    IbFreeHeaps()
    If builder <> NULL Then free(builder)
End Sub

Function IbAllocTables(builder As *ImportBuilder) As Long
    Dim slots As Long
    IbAllocTables = 0
    slots = IbFuncSlots(builder)
    g_ibFuncCount = calloc(BytesN(builder->dllCap, SizeOf(Long)))
    g_ibDllNames = calloc(BytesN(builder->dllCap, IB_NAME_LEN))
    g_ibFuncNames = calloc(BytesN(slots, IB_NAME_LEN))
    g_ibStrValues = calloc(BytesN(builder->stringCap, IB_STR_LEN))
    g_ibFuncIatRva = calloc(BytesN(slots, SizeOf(DWord)))
    g_ibFuncHintRva = calloc(BytesN(slots, SizeOf(DWord)))
    g_ibDllIatRva = calloc(BytesN(builder->dllCap, SizeOf(DWord)))
    g_ibDllIltRva = calloc(BytesN(builder->dllCap, SizeOf(DWord)))
    g_ibDllNameRva = calloc(BytesN(builder->dllCap, SizeOf(DWord)))
    g_ibStrRva = calloc(BytesN(builder->stringCap, SizeOf(DWord)))
    g_ibStrLens = calloc(BytesN(builder->stringCap, SizeOf(Long)))
    If g_ibFuncCount = NULL Or g_ibDllNames = NULL Or g_ibFuncNames = NULL Or g_ibStrValues = NULL Or g_ibFuncIatRva = NULL Or g_ibFuncHintRva = NULL Or g_ibDllIatRva = NULL Or g_ibDllIltRva = NULL Or g_ibDllNameRva = NULL Or g_ibStrRva = NULL Or g_ibStrLens = NULL Then
        IbFreeHeaps()
        Exit Function
    End If
    IbAllocTables = 1
End Function

Sub IbInit(builder As *ImportBuilder)
    ZeroMem(builder As BytePtr, SizeOf(ImportBuilder))
    IbFreeHeaps()
    builder->dllCap = DYN_INIT
    builder->funcCapPerDll = DYN_INIT
    builder->stringCap = DYN_INIT
    If IbAllocTables(builder) = 0 Then
        Print "error: out of memory (ImportBuilder)"
    End If
End Sub

Function IbGrowDllCap(builder As *ImportBuilder) As Long
    Dim newCap As Long
    Dim oldCap As Long
    Dim oldSlots As Long
    Dim newSlots As Long
    Dim p As *Byte

    IbGrowDllCap = 0
    oldCap = builder->dllCap
    newCap = oldCap * 2
    If newCap <= oldCap Then Exit Function
    oldSlots = oldCap * builder->funcCapPerDll
    newSlots = newCap * builder->funcCapPerDll

    p = MemGrow(g_ibFuncCount As BytePtr, BytesN(oldCap, SizeOf(Long)), BytesN(newCap, SizeOf(Long)))
    If p = NULL Then Exit Function
    g_ibFuncCount = p As *Long
    p = MemGrow(g_ibDllNames, BytesN(oldCap, IB_NAME_LEN), BytesN(newCap, IB_NAME_LEN))
    If p = NULL Then Exit Function
    g_ibDllNames = p
    p = MemGrow(g_ibDllIatRva As BytePtr, BytesN(oldCap, SizeOf(DWord)), BytesN(newCap, SizeOf(DWord)))
    If p = NULL Then Exit Function
    g_ibDllIatRva = p As *DWord
    p = MemGrow(g_ibDllIltRva As BytePtr, BytesN(oldCap, SizeOf(DWord)), BytesN(newCap, SizeOf(DWord)))
    If p = NULL Then Exit Function
    g_ibDllIltRva = p As *DWord
    p = MemGrow(g_ibDllNameRva As BytePtr, BytesN(oldCap, SizeOf(DWord)), BytesN(newCap, SizeOf(DWord)))
    If p = NULL Then Exit Function
    g_ibDllNameRva = p As *DWord
    p = MemGrow(g_ibFuncNames, BytesN(oldSlots, IB_NAME_LEN), BytesN(newSlots, IB_NAME_LEN))
    If p = NULL Then Exit Function
    g_ibFuncNames = p
    p = MemGrow(g_ibFuncIatRva As BytePtr, BytesN(oldSlots, SizeOf(DWord)), BytesN(newSlots, SizeOf(DWord)))
    If p = NULL Then Exit Function
    g_ibFuncIatRva = p As *DWord
    p = MemGrow(g_ibFuncHintRva As BytePtr, BytesN(oldSlots, SizeOf(DWord)), BytesN(newSlots, SizeOf(DWord)))
    If p = NULL Then Exit Function
    g_ibFuncHintRva = p As *DWord
    builder->dllCap = newCap
    IbGrowDllCap = 1
End Function

Function IbAllocFuncArrays(newSlots As Long) As Long
    Dim p As *Byte
    IbAllocFuncArrays = 0
    p = calloc(BytesN(newSlots, IB_NAME_LEN))
    If p = NULL Then Exit Function
    g_ibFuncNames = p
    p = calloc(BytesN(newSlots, SizeOf(DWord)))
    If p = NULL Then Exit Function
    g_ibFuncIatRva = p As *DWord
    p = calloc(BytesN(newSlots, SizeOf(DWord)))
    If p = NULL Then Exit Function
    g_ibFuncHintRva = p As *DWord
    IbAllocFuncArrays = 1
End Function

' *DWord params are not accepted by ParseParamType (*Byte / *UDT only).
Sub IbCopyFuncSlots(builder As *ImportBuilder, oldPer As Long, newPer As Long, oldNames As *Byte, oldIat As *Byte, oldHint As *Byte)
    Dim d As Long
    Dim f As Long
    Dim k As Long
    Dim oldOff As Long
    Dim newOff As Long
    Dim fc As *Long
    Dim oldFc As Long
    Dim oldIatDw As *DWord
    Dim oldHintDw As *DWord
    oldIatDw = oldIat As *DWord
    oldHintDw = oldHint As *DWord
    fc = g_ibFuncCount
    d = 0
    While d < builder->dllCount
        oldFc = fc[d]
        f = 0
        While f < oldFc
            oldOff = (d * oldPer + f) * IB_NAME_LEN
            newOff = (d * newPer + f) * IB_NAME_LEN
            k = 0
            While k < IB_NAME_LEN
                g_ibFuncNames[newOff + k] = oldNames[oldOff + k]
                k = k + 1
            Wend
            g_ibFuncIatRva[d * newPer + f] = oldIatDw[d * oldPer + f]
            g_ibFuncHintRva[d * newPer + f] = oldHintDw[d * oldPer + f]
            f = f + 1
        Wend
        d = d + 1
    Wend
End Sub

Function IbGrowFuncCap(builder As *ImportBuilder) As Long
    Dim oldPer As Long
    Dim newPer As Long
    Dim newSlots As Long
    Dim oldNames As *Byte
    Dim oldIat As *Byte
    Dim oldHint As *Byte

    IbGrowFuncCap = 0
    oldPer = builder->funcCapPerDll
    newPer = oldPer * 2
    If newPer <= oldPer Then Exit Function
    newSlots = builder->dllCap * newPer

    oldNames = g_ibFuncNames
    oldIat = g_ibFuncIatRva As *Byte
    oldHint = g_ibFuncHintRva As *Byte
    If IbAllocFuncArrays(newSlots) = 0 Then Exit Function

    IbCopyFuncSlots(builder, oldPer, newPer, oldNames, oldIat, oldHint)
    free(oldNames)
    free(oldIat)
    free(oldHint)
    builder->funcCapPerDll = newPer
    IbGrowFuncCap = 1
End Function

Function IbGrowStringCap(builder As *ImportBuilder) As Long
    Dim newCap As Long
    Dim p As *Byte
    IbGrowStringCap = 0
    newCap = builder->stringCap * 2
    If newCap <= builder->stringCap Then Exit Function
    p = MemGrow(g_ibStrValues, BytesN(builder->stringCap, IB_STR_LEN), BytesN(newCap, IB_STR_LEN))
    If p = NULL Then Exit Function
    g_ibStrValues = p
    p = MemGrow(g_ibStrRva As BytePtr, BytesN(builder->stringCap, SizeOf(DWord)), BytesN(newCap, SizeOf(DWord)))
    If p = NULL Then Exit Function
    g_ibStrRva = p As *DWord
    p = MemGrow(g_ibStrLens As BytePtr, BytesN(builder->stringCap, SizeOf(Long)), BytesN(newCap, SizeOf(Long)))
    If p = NULL Then Exit Function
    g_ibStrLens = p As *Long
    builder->stringCap = newCap
    IbGrowStringCap = 1
End Function
