' AstLowerStrQuery - 文字列式の判定と GC ルート

Function LowIsStringExprOp(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim kind As Long
    Dim bi As Long

    LowIsStringExprOp = 0
    ast = ctx->ast
    nodes = ast->nodes
    kind = nodes[idx].kind
    If kind = AST_BINOP Then
        If nodes[idx].num = BOP_ADD Or nodes[idx].num = BOP_CAT Then
            If LowIsStringExpr(ctx, nodes[idx].left) <> 0 Then
                LowIsStringExprOp = 1
                Exit Function
            End If
            If LowIsStringExpr(ctx, nodes[idx].right) <> 0 Then
                LowIsStringExprOp = 1
                Exit Function
            End If
        End If
        Exit Function
    End If
    bi = nodes[idx].num
    If bi = BI_LEFT Or bi = BI_MID Or bi = BI_RIGHT Then
        LowIsStringExprOp = 1
    End If
    If bi = BI_CHR Then
        LowIsStringExprOp = 1
    End If
    If bi = BI_STR Then
        LowIsStringExprOp = 1
    End If
    If bi = BI_MAKESTR Then
        LowIsStringExprOp = 1
    End If
End Function

Function LowIsStringExprName(ctx As *LowerCtx, idx As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim kind As Long
    Dim si As Long
    Dim name(63) As Byte

    LowIsStringExprName = 0
    ast = ctx->ast
    nodes = ast->nodes
    kind = nodes[idx].kind
    AstCopyStr(ast, idx, VarPtr(name))
    If kind = AST_VAR Then
        If LowFindStrConst(ctx, VarPtr(name)) >= 0 Then
            LowIsStringExprName = 1
            Exit Function
        End If
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
            If vTy = TY_STRING Then LowIsStringExprName = 1
        End If
        Exit Function
    End If
    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
        If vTy = TY_STRING_ARR Then
            If nodes[idx].num = 1 Then LowIsStringExprName = 1
        End If
    Else
        If LowFindFunc(ctx, VarPtr(name)) >= 0 Then
            si = 0
            While name[si] <> 0
                si = si + 1
            Wend
            If si > 0 Then
                If name[si - 1] = 36 Then LowIsStringExprName = 1
            End If
        End If
    End If
End Function

Function LowIsStringExpr(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim kind As Long

    LowIsStringExpr = 0
    If idx < 0 Then Exit Function
    ast = ctx->ast
    nodes = ast->nodes
    kind = nodes[idx].kind
    If kind = AST_STRING Then
        LowIsStringExpr = 1
        Exit Function
    End If
    If kind = AST_BINOP Then
        LowIsStringExpr = LowIsStringExprOp(ctx, idx)
        Exit Function
    End If
    If kind = AST_BUILTIN Then
        LowIsStringExpr = LowIsStringExprOp(ctx, idx)
        Exit Function
    End If
    If kind = AST_VAR Then
        LowIsStringExpr = LowIsStringExprName(ctx, idx)
        Exit Function
    End If
    If kind = AST_CALL Then
        LowIsStringExpr = LowIsStringExprName(ctx, idx)
    End If
End Function

Function LowEnsureRtCat(ctx As *LowerCtx) As Long
    If g_rtCatLab < 0 Then
        g_rtCatLab = LowNewLabel(ctx)
    End If
    LowEnsureRtCat = g_rtCatLab
End Function

