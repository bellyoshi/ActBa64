' AstLowerStrQuery - 文字列式の判定と GC ルート

Function LowIsStringExprOp(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim kind As Long
    Dim bi As Long

    LowIsStringExprOp = 0
    ast = ctx->ast
    nodes = ast->nodes
    kind = nodes[idx].kind
    If kind = AST_BINOP Then
        If nodes[idx].num = BOP_ADD Or nodes[idx].num = BOP_CAT Then
            If LowIsStringExpr(ctx, nodes[idx].left) <> 0 Then
                LowIsStringExprOp = 1
                Exit Function
            End If
            If LowIsStringExpr(ctx, nodes[idx].right) <> 0 Then
                LowIsStringExprOp = 1
                Exit Function
            End If
        End If
        Exit Function
    End If
    bi = nodes[idx].num
    If bi = BIK_LEFT Or bi = BIK_MID Or bi = BIK_RIGHT Then
        LowIsStringExprOp = 1
    End If
    If bi = BIK_CHR Then
        LowIsStringExprOp = 1
    End If
    If bi = BIK_STR Then
        LowIsStringExprOp = 1
    End If
    If bi = BIK_MAKESTR Then
        LowIsStringExprOp = 1
    End If
End Function

Function LowIsStringExprName(ctx As *LowerCtx, idx As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim kind As Long
    Dim si As Long
    Dim name(63) As Byte

    LowIsStringExprName = 0
    ast = ctx->ast
    nodes = ast->nodes
    kind = nodes[idx].kind
    AstCopyStr(ast, idx, VarPtr(name))
    If kind = AST_VAR Then
        If LowFindStrConst(ctx, VarPtr(name)) >= 0 Then
            LowIsStringExprName = 1
            Exit Function
        End If
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
            If vTy = TY_STRING Then LowIsStringExprName = 1
        End If
        Exit Function
    End If
    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
        If vTy = TY_STRING_ARR Then
            If nodes[idx].num = 1 Then LowIsStringExprName = 1
        End If
    Else
        If LowFindFunc(ctx, VarPtr(name)) >= 0 Then
            si = 0
            While name[si] <> 0
                si = si + 1
            Wend
            If si > 0 Then
                If name[si - 1] = CH_DOLLAR Then LowIsStringExprName = 1
            End If
        End If
    End If
End Function

Function LowIsStringExpr(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim kind As Long

    LowIsStringExpr = 0
    If idx < 0 Then Exit Function
    ast = ctx->ast
    nodes = ast->nodes
    kind = nodes[idx].kind
    If kind = AST_STRING Then
        LowIsStringExpr = 1
        Exit Function
    End If
    If kind = AST_BINOP Then
        LowIsStringExpr = LowIsStringExprOp(ctx, idx)
        Exit Function
    End If
    If kind = AST_BUILTIN Then
        LowIsStringExpr = LowIsStringExprOp(ctx, idx)
        Exit Function
    End If
    If kind = AST_VAR Then
        LowIsStringExpr = LowIsStringExprName(ctx, idx)
        Exit Function
    End If
    If kind = AST_CALL Then
        LowIsStringExpr = LowIsStringExprName(ctx, idx)
    End If
End Function

Function LowEnsureLab(ctx As *LowerCtx, ByRef lab As Long) As Long
    If lab < 0 Then
        lab = LowNewLabel(ctx)
    End If
    LowEnsureLab = lab
End Function

Function LowEnsureRtCat(ctx As *LowerCtx) As Long
    LowEnsureRtCat = LowEnsureLab(ctx, g_rtCatLab)
End Function

Function LowEnsureRtMid(ctx As *LowerCtx) As Long
    LowEnsureRtMid = LowEnsureLab(ctx, g_rtMidLab)
End Function

Function LowEnsureRtStr(ctx As *LowerCtx) As Long
    LowEnsureRtStr = LowEnsureLab(ctx, g_rtStrLab)
End Function

Function LowEnsureRtPrint(ctx As *LowerCtx) As Long
    LowEnsureRtPrint = LowEnsureLab(ctx, g_rtPrintLab)
End Function

Function LowEnsureRtInput(ctx As *LowerCtx) As Long
    LowEnsureRtInput = LowEnsureLab(ctx, g_rtInputLab)
End Function

Function LowEnsureRtVal(ctx As *LowerCtx) As Long
    LowEnsureRtVal = LowEnsureLab(ctx, g_rtValLab)
End Function

Function LowEnsureRtValDouble(ctx As *LowerCtx) As Long
    LowEnsureRtValDouble = LowEnsureLab(ctx, g_rtValDoubleLab)
End Function

Function LowEnsureRtMakeStr(ctx As *LowerCtx) As Long
    LowEnsureRtMakeStr = LowEnsureLab(ctx, g_rtMakeStrLab)
End Function

Function LowEnsureRtStrCmp(ctx As *LowerCtx) As Long
    LowEnsureRtStrCmp = LowEnsureLab(ctx, g_rtStrCmpLab)
End Function

Function LowEnsureRtStrFree(ctx As *LowerCtx) As Long
    LowEnsureRtStrFree = LowEnsureLab(ctx, g_rtStrFreeLab)
End Function

Sub LowResetFnPreciseRoots()
    g_fnPreciseRootCount = 0
End Sub

Sub LowAppendPreciseRootTo(roots As *Long, ByRef count As Long, off As Long)
    If roots = NULL Then Exit Sub
    If count >= GC_MAX_PRECISE Then Exit Sub
    roots[count] = off
    count = count + 1
End Sub

Sub LowAppendPreciseStringArrTo(roots As *Long, ByRef count As Long, baseOff As Long, nbytes As Long)
    Dim j As Long
    Dim n As Long
    n = nbytes \ TyPtrSize()
    j = 0
    While j < n
        LowAppendPreciseRootTo(roots, count, baseOff + j * TyPtrSize())
        j = j + 1
    Wend
End Sub

Sub LowAppendFnPreciseRoot(off As Long)
    LowAppendPreciseRootTo(g_fnPreciseRoots, g_fnPreciseRootCount, off)
End Sub

Sub LowRetargetFnPreciseRoot(oldOff As Long, newOff As Long)
    Dim i As Long
    If g_fnPreciseRoots = NULL Then Exit Sub
    i = 0
    While i < g_fnPreciseRootCount
        If g_fnPreciseRoots[i] = oldOff Then
            g_fnPreciseRoots[i] = newOff
        End If
        i = i + 1
    Wend
End Sub

Sub LowAppendFnPreciseStringArr(baseOff As Long, nbytes As Long)
    LowAppendPreciseStringArrTo(g_fnPreciseRoots, g_fnPreciseRootCount, baseOff, nbytes)
End Sub

Sub LowAppendPreciseGlobRoot(off As Long)
    LowAppendPreciseRootTo(g_preciseRoots, g_preciseRootCount, off)
End Sub

Sub LowAppendPreciseGlobStringArr(baseOff As Long, nbytes As Long)
    LowAppendPreciseStringArrTo(g_preciseRoots, g_preciseRootCount, baseOff, nbytes)
End Sub

Sub LowCollectPreciseGlobRoots()
    Dim i As Long
    Dim typeKind As Long
    Dim off As Long
    Dim sz As Long
    Dim types As *Long
    Dim offs As *Long
    Dim nb As *Long
    types = g_globTypes As *Long
    offs = g_globOffs As *Long
    nb = g_globNbytes
    g_preciseRootCount = 0
    i = 0
    While i < g_globCount
        typeKind = types[i]
        off = offs[i]
        sz = nb[i]
        If typeKind = TY_STRING Then
            LowAppendPreciseGlobRoot(off)
        ElseIf typeKind = TY_STRING_ARR Then
            LowAppendPreciseGlobStringArr(off, sz)
        End If
        i = i + 1
    Wend
End Sub
