Sub LowResetFnPreciseRoots()
    g_fnPreciseRootCount = 0
End Sub

Sub LowAppendFnPreciseRoot(off As Long)
    If g_fnPreciseRoots = NULL Then Exit Sub
    If g_fnPreciseRootCount >= GC_MAX_PRECISE Then Exit Sub
    g_fnPreciseRoots[g_fnPreciseRootCount] = off
    g_fnPreciseRootCount = g_fnPreciseRootCount + 1
End Sub

Sub LowRetargetFnPreciseRoot(oldOff As Long, newOff As Long)
    Dim i As Long
    If g_fnPreciseRoots = NULL Then Exit Sub
    i = 0
    While i < g_fnPreciseRootCount
        If g_fnPreciseRoots[i] = oldOff Then
            g_fnPreciseRoots[i] = newOff
        End If
        i = i + 1
    Wend
End Sub

Sub LowAppendFnPreciseStringArr(baseOff As Long, nbytes As Long)
    Dim j As Long
    Dim n As Long
    n = nbytes \ TyPtrSize()
    j = 0
    While j < n
        LowAppendFnPreciseRoot(baseOff + j * TyPtrSize())
        j = j + 1
    Wend
End Sub

Sub LowAppendPreciseGlobRoot(off As Long)
    If g_preciseRoots = NULL Then Exit Sub
    If g_preciseRootCount >= GC_MAX_PRECISE Then Exit Sub
    g_preciseRoots[g_preciseRootCount] = off
    g_preciseRootCount = g_preciseRootCount + 1
End Sub

Sub LowAppendPreciseGlobStringArr(baseOff As Long, nbytes As Long)
    Dim j As Long
    Dim n As Long
    n = nbytes \ TyPtrSize()
    j = 0
    While j < n
        LowAppendPreciseGlobRoot(baseOff + j * TyPtrSize())
        j = j + 1
    Wend
End Sub

Sub LowCollectPreciseGlobRoots()
    Dim i As Long
    Dim ty As Long
    Dim off As Long
    Dim sz As Long
    Dim types As *Long
    Dim offs As *Long
    Dim nb As *Long
    types = g_globTypes As *Long
    offs = g_globOffs As *Long
    nb = g_globNbytes
    g_preciseRootCount = 0
    i = 0
    While i < g_globCount
        ty = types[i]
        off = offs[i]
        sz = nb[i]
        If ty = TY_STRING Then
            LowAppendPreciseGlobRoot(off)
        ElseIf ty = TY_STRING_ARR Then
            LowAppendPreciseGlobStringArr(off, sz)
        End If
        i = i + 1
    Wend
End Sub
