' Expect: 0
' Target: actba64
#console

' 基底クラスのポインタで Delete しても、New した実体のクラスの Dtor が呼ばれる（子 → 親の順）。
' 配列の New / Delete は要素ごとに Dtor を呼ぶ。

Dim g_log As Long

Class Base
Public
    b As Long
    Sub ~Base()
        g_log = g_log * 10 + 1
    End Sub
End Class

Class Derived
    Inherits Base
Public
    d1 As Long
    d2 As Long
    Sub ~Derived()
        g_log = g_log * 10 + 2
    End Sub
End Class

Dim pb As *Base
Dim pd As *Derived

pb = New Derived
Delete pb
If g_log <> 21 Then ExitProcess(1)

g_log = 0
pd = New [3] Derived
pd->d2 = 5
Delete pd
If g_log <> 212121 Then ExitProcess(2)

g_log = 0
pb = New Base
Delete pb
If g_log <> 1 Then ExitProcess(3)
ExitProcess(0)
