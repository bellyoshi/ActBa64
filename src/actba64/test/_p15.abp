' Expect: 85
' Target: actba64
#console
#include "..\CharUtils.abp"
#include "..\StrUtils.abp"
Dim tmp As String
Dim eq As Long
Dim n As Long
Dim mid As String
Dim key As String
tmp = "#PLATFORM=32"
eq = InStr(1, tmp, "=")
n = eq - 1
mid = Mid$(tmp, 1, n)
key = Lower$(mid)
If key <> "#platform" Then ExitProcess(3)
ExitProcess(85)
End
