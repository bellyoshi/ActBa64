' Expect: 15
' Target: actba64
' strstr は ActiveBasic と同じく宣言なしで使える
#console
Dim b[31] As Byte
Dim p As *Byte
Dim r As Long
lstrcpy(b, "44100Hz, 16Bit, 2ch")
p = strstr(b, ",") + 1
r = 0
If Val(p) = 16 Then r = r + 1
p = strstr(p, ",") + 1
If Val(p) = 2 Then r = r + 2
If strstr(b, "zz") = NULL Then r = r + 4
If strstr(b, "") = VarPtr(b[0]) Then r = r + 8
ExitProcess(r)
