' Expect: 11111
' Target: actba64
' Forms.sbp の EditBox: AddControl した EditBox は子窓（EDIT）になる
' → Caption が初めの文字になり、窓の文字を変えると EN_CHANGE が届いて GetText で読め、
'   SetText で窓の文字と Caption が変わる（日本語は UTF-8 のまま）

#include <Forms.sbp>

Dim g_cls(15) As Byte
Dim g_changed As Long

Class Form1
    Inherits Form
Public
    EditBox1 As EditBox

    Override Function WndProc(msg As DWord, wParam As WPARAM, lParam As LPARAM) As LRESULT
        If msg = WM_COMMAND Then
            If HIWORD(wParam) = EN_CHANGE And lParam = EditBox1.Handle Then g_changed = g_changed + 1
        End If
        WndProc = Super.WndProc(msg, wParam, lParam)
    End Function

Private
    Override Sub InitializeComponent()
        Width = 200
        Height = 120
        Caption = "テスト"

        EditBox1.Left = 8
        EditBox1.Top = 8
        EditBox1.Width = 120
        EditBox1.Height = 24
        EditBox1.Caption = "はじめ"
        AddControl(EditBox1)
    End Sub
End Class

Dim mainForm As Form1
Dim r As Long

mainForm.Show()
r = 0
GetClassName(mainForm.EditBox1.Handle, VarPtr(g_cls), 16)
If lstrcmpi(VarPtr(g_cls), "Edit") = 0 And GetParent(mainForm.EditBox1.Handle) = mainForm.Handle Then r = r + 10000
If mainForm.EditBox1.GetText() = "はじめ" Then r = r + 1000
g_changed = 0
SetWindowText(mainForm.EditBox1.Handle, "打った字")
If mainForm.EditBox1.GetText() = "打った字" And mainForm.EditBox1.Caption = "はじめ" Then r = r + 100
If g_changed = 1 Then r = r + 10
mainForm.EditBox1.SetText("")
If mainForm.EditBox1.GetText() = "" And mainForm.EditBox1.Caption = "" And g_changed = 2 Then r = r + 1
PostMessage(mainForm.Handle, WM_CLOSE, 0, 0)
Application.Initialize()
Application.Run(mainForm)
ExitProcess(r)
