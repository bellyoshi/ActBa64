' Expect: 0
' Target: actba64
' Option: -pAB2
' -pAB2: Field #n,長さ As 変数 で変数をバッファにし、Get #n,rec / Put #n,rec で読み書きする
#console
Dim T$ As String
Dim U$ As String
Open "bin/test_out/t_ab2_field.txt" For Output As #1
Close #1
Open "bin/test_out/t_ab2_field.txt" As #1
T$="hello"
Field #1,5 As T$
Put #1,1
Close #1
Open "bin/test_out/t_ab2_field.txt" As #2
Field #2,Lof(2) As U$
Get #2,1
Close #2
If U$<>"hello" Then ExitProcess(1)
ExitProcess(0)
