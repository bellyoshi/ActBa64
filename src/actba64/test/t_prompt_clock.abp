' Expect: 0
' Target: actba64
' 5.abp: Double の Const、LINE の BF の後の style、_PromptSys_hWnd
#N88BASIC
Const PAI=3.14159265358979323846264
Dim rc As RECT
Dim x As Double
x = PAI
GetClientRect(_PromptSys_hWnd, rc)
If rc.right < 100 Then ExitProcess(3)
Line(0,0)-(10,10),0,Bf,0
If x < 3.1 Then ExitProcess(1)
If x > 3.2 Then ExitProcess(2)
ExitProcess(0)
