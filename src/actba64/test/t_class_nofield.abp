' Expect: 42
' Target: actba64
#console
' フィールドの無い Class も Dim / New でき、メソッドを呼べる

Dim g As Long

Class App
    Public
    Sub App()
        g = g + 1
    End Sub
    Function Run(n As Long) As Long
        Run = n + g
    End Function
End Class

Class Empty2
    Inherits App
End Class

Dim Application As App
Dim e As Empty2
Dim p As *App
p = New App
ExitProcess(Application.Run(39) + SizeOf(App) - 1 + (p->Run(0) - 3))
