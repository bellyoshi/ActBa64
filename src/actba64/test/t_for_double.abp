' Expect: 0
' Target: actba64
' Double の For。0.1 は IEEE で誤差が出るが、終値ちょうどは含み、StrD$ は 6 桁丸め。
Dim i As Double
Dim n As Long
Dim s As String

n = 0
For i = 0.0 To 1 Step 0.1
    s = StrD$(i)
    If n = 0 And s <> "0" Then ExitProcess(10)
    If n = 1 And s <> "0.1" Then ExitProcess(11)
    If n = 2 And s <> "0.2" Then ExitProcess(12)
    If n = 3 And s <> "0.3" Then ExitProcess(13)
    If n = 4 And s <> "0.4" Then ExitProcess(14)
    If n = 5 And s <> "0.5" Then ExitProcess(15)
    If n = 6 And s <> "0.6" Then ExitProcess(16)
    If n = 7 And s <> "0.7" Then ExitProcess(17)
    If n = 8 And s <> "0.8" Then ExitProcess(18)
    If n = 9 And s <> "0.9" Then ExitProcess(19)
    If n = 10 And s <> "1" Then ExitProcess(20)
    n = n + 1
Next
If n <> 11 Then ExitProcess(1)

n = 0
For i = 1 To 0 Step -0.1
    s = StrD$(i)
    If n = 0 And s <> "1" Then ExitProcess(21)
    If n = 10 And s <> "0" Then ExitProcess(22)
    n = n + 1
Next
If n <> 11 Then ExitProcess(2)

n = 0
For i = 0.0 To 2
    s = StrD$(i)
    If n = 0 And s <> "0" Then ExitProcess(30)
    If n = 1 And s <> "1" Then ExitProcess(31)
    If n = 2 And s <> "2" Then ExitProcess(32)
    n = n + 1
Next
If n <> 3 Then ExitProcess(3)

ExitProcess(0)
