' Expect: 0
' Target: actba64
' AB 4 のクラス: 後ろで定義するクラスを値で持つフィールド、Double の引数と戻り値のメソッド、
' Get / Set という名前のメソッド、フィールドのオブジェクトのメソッド、ポインタのフィールドの添字、
' VarPtr(戻り値)、メソッド・コンストラクタ・関数のオーバーロード
#console

Class Holder
Public
    inner As Inner
    tbl As *DWord
    Sub Holder()
        tbl = calloc(16)
    End Sub
    Sub Fill(v As Long)
        inner.SetV(v)
        tbl[2] = inner.GetV() * 2
    End Sub
    Function Peek() As Long
        Peek = tbl[2]
    End Function
    Function Raw() As Long
        RtlMoveMemory(VarPtr(Raw), tbl + 8, 4)
    End Function
End Class

Class Inner
Public
    v As Long
    d As Double
    Sub SetV(a As Long)
        v = a
    End Sub
    Function GetV() As Long
        GetV = v
    End Function
    Sub Set(x As Double, k As Long)
        d = x * k
    End Sub
    Function Get(m As Double) As Double
        Get = d * m
    End Function
End Class

Class Lock
Public
    hits As Long
    Sub Lock(ByRef o As Inner)
        hits = o.v
    End Sub
    Sub Lock(p As *Inner)
        hits = p->v + 100
    End Sub
    Function K(a As Long) As Long
        K = a
    End Function
    Function K(a As Long, b As Long) As Long
        K = a + b + K(1)
    End Function
End Class

Function F() As Long
    F = 1
End Function
Function F(a As Long) As Long
    F = a + 1
End Function

Dim h As Holder
h.Fill(21)
If h.Peek() <> 42 Or h.Raw() <> 42 Or h.inner.GetV() <> 21 Then ExitProcess(1)

Dim n As Inner
n.Set(1.5, 3)
If n.Get(2) <> 9 Then ExitProcess(2)

n.v = 7
Dim l1 As Lock(n)
Dim l2 As Lock(VarPtr(n))
If l1.hits <> 7 Or l2.hits <> 107 Then ExitProcess(3)
If l1.K(5) <> 5 Or l1.K(5, 6) <> 12 Then ExitProcess(4)
If F() <> 1 Or F(4) <> 5 Then ExitProcess(5)
ExitProcess(0)
