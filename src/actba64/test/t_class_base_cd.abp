' Expect: 1264714
' Target: actba64
#console
' 基底 Class の ctor / dtor は自動で呼ばれる。
' ctor: 基底 → 派生、dtor: 派生 → 基底。
' Super.Parent() / Super.~Parent() を書いたときは自動では呼ばない（二重に呼ばない）

Dim g As Long

Sub Note(k As Long)
    g = g * 10 + k
End Sub

Class A
    Public
    x As Long

    Sub A()
        Note(1)
    End Sub

    Sub ~A()
        Note(4)
    End Sub
End Class

Class B
    Inherits A
    Public
    Sub B()
        Note(2)
    End Sub
End Class

Class C
    Inherits B
    Public
    Sub ~C()
        Note(6)
    End Sub
End Class

Class D
    Inherits A
    Public
    Sub D()
        Note(7)
        Super.A()
    End Sub

    Sub ~D()
        Super.~A()
    End Sub
End Class

Sub RunC()
    Dim c As C
End Sub

Sub RunD()
    Dim d As D
End Sub

g = 0
RunC()
RunD()
ExitProcess(g)
