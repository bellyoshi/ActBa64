' Expect: 11111
' Target: actba64
' Forms.sbp の RadioButton: AddControl した RadioButton は子窓（BUTTON の BS_AUTORADIOBUTTON）になる
' → InitializeComponent の Checked = True で Radio1 に印が付いて作られ、Radio2 を押すと
'   Radio2 に印が移って BN_CLICKED が届き、SetChecked(True) で Radio1 に印が戻る（Radio2 は外れる）

#include <Forms.sbp>

Dim g_cls(15) As Byte
Dim g_clicked As Long

Class Form1
    Inherits Form
Public
    Radio1 As RadioButton
    Radio2 As RadioButton

    Override Function WndProc(msg As DWord, wParam As WPARAM, lParam As LPARAM) As LRESULT
        If msg = WM_COMMAND Then
            If HIWORD(wParam) = BN_CLICKED And lParam = Radio2.Handle Then g_clicked = g_clicked + 1
        End If
        WndProc = Super.WndProc(msg, wParam, lParam)
    End Function

Private
    Override Sub InitializeComponent()
        Width = 200
        Height = 120
        Caption = "テスト"

        Radio1.Left = 8
        Radio1.Top = 8
        Radio1.Width = 100
        Radio1.Height = 20
        Radio1.Caption = "一"
        Radio1.Checked = True
        AddControl(Radio1)

        Radio2.Left = 8
        Radio2.Top = 32
        Radio2.Width = 100
        Radio2.Height = 20
        Radio2.Caption = "二"
        AddControl(Radio2)
    End Sub
End Class

Dim mainForm As Form1
Dim r As Long

mainForm.Show()
r = 0
GetClassName(mainForm.Radio1.Handle, VarPtr(g_cls), 16)
If lstrcmpi(VarPtr(g_cls), "Button") = 0 And (GetWindowLong(mainForm.Radio1.Handle, GWL_STYLE) And &HF) = BS_AUTORADIOBUTTON Then r = r + 10000
If mainForm.Radio1.GetChecked() = True And mainForm.Radio2.GetChecked() = False Then r = r + 1000
SendMessage(mainForm.Radio2.Handle, BM_CLICK, 0, 0)
If mainForm.Radio1.GetChecked() = False And mainForm.Radio2.GetChecked() = True Then r = r + 100
If g_clicked = 1 Then r = r + 10
mainForm.Radio1.SetChecked(True)
If mainForm.Radio1.GetChecked() = True And mainForm.Radio2.GetChecked() = False Then r = r + 1
PostMessage(mainForm.Handle, WM_CLOSE, 0, 0)
Application.Initialize()
Application.Run(mainForm)
ExitProcess(r)
