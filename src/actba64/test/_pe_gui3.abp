' Target: actba64
' Expect: 0
#console

Function SelWndProc(hWnd As HWND, message As DWord, wParam As WPARAM, lParam As LPARAM) As LRESULT
    Select Case message
        Case WM_DESTROY
            PostQuitMessage(0)
        Case WM_DROPFILES
        Case WM_CREATE
        Case WM_CLOSE
            DestroyWindow(hWnd)
        Case WM_COMMAND
        Case Else
            SelWndProc = DefWindowProc(hWnd, message, wParam, lParam)
            Exit Function
    End Select
    SelWndProc = 0
End Function

Dim wc As WNDCLASSEX
FillMemory(VarPtr(wc), Len(wc), 0)
wc.cbSize = Len(wc)
wc.hInstance = GetModuleHandle(0)
wc.style = CS_HREDRAW Or CS_VREDRAW Or CS_DBLCLKS
wc.hCursor = LoadCursor(NULL, MAKEINTRESOURCE(IDC_ARROW))
wc.hIcon = LoadIcon(NULL, MAKEINTRESOURCE(IDI_APPLICATION))
wc.hIconSm = LoadIcon(NULL, MAKEINTRESOURCE(IDI_WINLOGO))
wc.lpszClassName = "NORMAL0"
wc.lpfnWndProc = AddressOf(SelWndProc)
wc.hbrBackground = CreateSolidBrush(GetSysColor(COLOR_3DFACE))
Print "RegisterClassEx"
Print RegisterClassEx(wc)

Dim h As HWND
h = CreateWindowEx(&H00000000, "NORMAL0", "editor", &H10cf0000, -2147483648, -2147483648, 495, 367, 0, 0, GetModuleHandle(0), 0)
Print "hwnd"
Print h As Long
If h <> 0 Then
    DestroyWindow(h)
    ExitProcess(0)
End If
ExitProcess(1)
