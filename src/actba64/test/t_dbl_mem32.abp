' Expect: 0
' Target: actba64
#console

Type Box
    n As Long
    d As Double
End Type

Function Twice(x As Double) As Double
    Twice = x + x
End Function

Dim a(2) As Double
Dim b As Box
Dim c As Double

a(0) = 1.5
a(1) = 2.5
a(2) = a(0) + a(1)
If a(2) < 3.9 Then ExitProcess(1)
If a(2) > 4.1 Then ExitProcess(2)

c = Twice(a(0))
If c < 2.9 Then ExitProcess(3)
If c > 3.1 Then ExitProcess(4)

b.n = 7
b.d = 8.5
If b.n <> 7 Then ExitProcess(5)
If b.d < 8.4 Then ExitProcess(6)
If b.d > 8.6 Then ExitProcess(7)

b.d = a(1)
If b.d < 2.4 Then ExitProcess(8)
If b.d > 2.6 Then ExitProcess(9)
ExitProcess(0)
