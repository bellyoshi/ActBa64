' Expect: 42
' Target: actba64
#console

Class Counter
    Public
    value As Long
    Sub Counter(v As Long)
        value = v
    End Sub
    Sub Add(n As Long)
        value = value + n
    End Sub
    Function GetValue() As Long
        GetValue = value
    End Function
End Class

Dim p As *Counter
p = New Counter(10)
p->Add(32)
ExitProcess(p->GetValue())
