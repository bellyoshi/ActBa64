' Expect: 0
' Target: actba64
#console
' ldexp / frexp / ipow / pow / rand / CDWord / String$ / GetBasicColor / Val / Using$

Dim m As Double
Dim d As Double
Dim n As Long
Dim s As String
Dim r As Long

d = ldexp(1.5, 2)
If d < 5.9 Or d > 6.1 Then ExitProcess(1)
d = ldexp(4, 0 - 1)
If d < 1.9 Or d > 2.1 Then ExitProcess(2)

d = ipow(2, 10)
If d <> 1024 Then ExitProcess(3)
d = ipow(2, 0 - 1)
If d < 0.49 Or d > 0.51 Then ExitProcess(4)
d = ipow(0 - 2, 3)
If d <> 0 - 8 Then ExitProcess(5)

d = pow(2, 3)
If d <> 8 Then ExitProcess(6)
d = pow(4, 0.5)
If d < 1.9 Or d > 2.1 Then ExitProcess(7)
d = pow(0 - 2, 0.5)
If d <> 0 Then ExitProcess(8)

m = frexp(8, n)
If n <> 4 Then ExitProcess(9)
If m < 0.49 Or m > 0.51 Then ExitProcess(10)
m = frexp(0, n)
If m <> 0 Or n <> 0 Then ExitProcess(11)

srand(1)
r = rand()
If r <> 16838 Then ExitProcess(12)
r = rand()
If r <> 5758 Then ExitProcess(13)
r = rand()
If r <> 10113 Then ExitProcess(14)

n = CDWord(3.9)
If n <> 3 Then ExitProcess(15)

s = String$(3, "ab")
If s <> "ababab" Then ExitProcess(16)
s = String$(0, "ab")
If s <> "" Then ExitProcess(17)

If GetBasicColor(0) <> 0 Then ExitProcess(18)
If GetBasicColor(1) <> 16711680 Then ExitProcess(19)
If GetBasicColor(4) <> 65280 Then ExitProcess(20)
If GetBasicColor(7) <> 16777215 Then ExitProcess(21)

d = Val(" 12.5")
If d < 12.4 Or d > 12.6 Then ExitProcess(22)
d = Val("-2.25")
If d < 0 - 2.3 Or d > 0 - 2.2 Then ExitProcess(23)
d = Val("&H10")
If d <> 16 Then ExitProcess(24)
d = Val("&O10")
If d <> 8 Then ExitProcess(25)
d = Val("12abc")
If d <> 12 Then ExitProcess(26)
d = Val("&hff")
If d <> 255 Then ExitProcess(27)

s = Using$("###.##", 12.5)
If s <> " 12.50" Then ExitProcess(28)
s = Using$("##.#", 0 - 1.5)
If s <> "-1.5" Then ExitProcess(29)
s = Using$("#", 99)
If s <> "#" Then ExitProcess(30)
s = UsingStr$("@", "ab")
If s <> "ab" Then ExitProcess(31)
s = UsingStr$("&  &", "ab")
If s <> "ab  " Then ExitProcess(32)
s = UsingStr$("& &", "abcd")
If s <> "abc" Then ExitProcess(33)

Print Using "###.##"; 12.5
Print Using "@"; "ok"

ExitProcess(0)
