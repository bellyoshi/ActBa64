#console
Type T
    dllNames(15) As Byte
End Type
Sub F(builder As *T, baseOff As Long, src As *Byte, maxLen As Long)
    Dim i As Long
    Dim c As Long
    i = 0
    c = src[i]
    While c <> 0
        If i >= maxLen - 1 Then
            c = 0
        Else
            builder.dllNames[baseOff + i] = c
            i = i + 1
            c = src[i]
        End If
    Wend
    builder.dllNames[baseOff + i] = 0
End Sub
ExitProcess(0)
