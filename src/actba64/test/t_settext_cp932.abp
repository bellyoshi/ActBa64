' Expect: 7
' Target: actba64
' SetWindowText / SetDlgItemText に UTF-8 でないバイト列（ファイルから読んだ Shift-JIS）を渡すと CP932 とみて表示する
#console
Declare Function TGetW Lib "user32.dll" Alias "GetWindowTextW" (ByVal hWnd As HWND, ByVal p As *Byte, ByVal n As Long) As Long

Function WAt(p As *Byte, i As Long) As Long
    WAt = GetWord(p + i * 2)
End Function

Dim hp As HWND
Dim he As HWND
Dim sj[7] As Byte
Dim w[63] As Byte
Dim r As Long
r = 0
hp = CreateWindowEx(0, "STATIC", "", 0, 0, 0, 300, 200, 0, 0, GetModuleHandle(0), 0)
he = CreateWindowEx(0, "EDIT", "", &H40000000, 0, 0, 300, 20, hp, 100 As HMENU, GetModuleHandle(0), 0)
' 「日本」の CP932
sj[0] = &H93 : sj[1] = &HFA : sj[2] = &H96 : sj[3] = &H7B : sj[4] = 0
SetDlgItemText(hp, 100, VarPtr(sj))
If TGetW(he, VarPtr(w), 32) = 2 Then r = r + 1
If WAt(VarPtr(w), 0) = &H65E5 And WAt(VarPtr(w), 1) = &H672C Then r = r + 2
' UTF-8 はそのまま
SetWindowText(he, "語")
If TGetW(he, VarPtr(w), 32) = 1 And WAt(VarPtr(w), 0) = &H8A9E Then r = r + 4
DestroyWindow(hp)
ExitProcess(r)
