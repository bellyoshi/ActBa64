' Expect: 0
' Target: actba64
' Skip32: 1
' Int64 / QWord のスカラー: 8 バイトの格納、Long・Double との変換、Type メンバ、
' 仮引数（値・ByRef・メソッド）、SizeOf、Str$（64bit 出力。算術はまだ 32bit）
#console
Type tW
    a As Long
    q As Int64
    u As QWord
End Type

Class C
Public
    Function Twice$(v As Int64) As String
        Twice$ = Str$(v) + Str$(v)
    End Function
End Class

Function ShowI$(v As Int64) As String
    ShowI$ = Str$(v)
End Function

Sub SetRef(ByRef v As Int64)
    v = -1
End Sub

Function Check(cond As Long, code As Long) As Long
    Check = 0
    If cond = 0 Then
        Print "fail "; code
        Check = 1
    End If
End Function

Dim x As Int64, y As Int64, u As QWord
Dim l As Long, d As Double
Dim w As tW
Dim c As C
Dim bad As Long

bad = 0
x = 3000000000
bad = bad + Check(Str$(x) = "3000000000", 1)
x = -5
bad = bad + Check(Str$(x) = "-5", 2)
l = -7
x = l
bad = bad + Check(Str$(x) = "-7", 3)
d = 1.5e15
x = d
bad = bad + Check(Str$(x) = "1500000000000000", 4)
d = 0
d = x
bad = bad + Check(d = 1.5e15, 5)
y = x
bad = bad + Check(Str$(y) = "1500000000000000", 6)
' Long へは下位 32 ビット
l = y
bad = bad + Check(l = -148258816, 7)
w.q = -123456789
bad = bad + Check(Str$(w.q) = "-123456789", 8)
w.u = 4000000000
bad = bad + Check(Str$(w.u) = "4000000000", 9)
bad = bad + Check(SizeOf(Int64) = 8 And SizeOf(QWord) = 8, 10)
bad = bad + Check(SizeOf(tW) = 24, 11)
x = 9.2e18
bad = bad + Check(Str$(x) = "9200000000000000000", 12)
x = -9.2e18
bad = bad + Check(Str$(x) = "-9200000000000000000", 13)
l = -9
bad = bad + Check(ShowI$(l) = "-9", 14)
bad = bad + Check(ShowI$(3000000000) = "3000000000", 15)
bad = bad + Check(c.Twice$(l) = "-9-9", 16)
SetRef(x)
bad = bad + Check(Str$(x) = "-1", 17)
u = 4000000000
bad = bad + Check(Str$(u) = "4000000000", 18)
Dim z As Int64 = 42
bad = bad + Check(Str$(z) = "42", 19)
If bad = 0 Then Print "ok"
ExitProcess(bad)
