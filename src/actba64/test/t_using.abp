' Expect: 0
' Target: actba64
#console
' Print Using: 複数の値・書式の繰り返し・+ - ** \\ , ^^^^ ! & @ _ %・全角

Dim s As String
Dim a As Long
Dim d As Double
Dim t As String

Function U2(f As String, x As Double, y As Double) As String
    Dim r As String
    r = PuUseBeg$(f)
    r = PuUseVal$(r, x)
    r = PuUseVal$(r, y)
    U2 = PuUseEnd$(r)
End Function

s = U2("[##][##]", 1, 23)
If s <> "[ 1][23]" Then ExitProcess(1)
s = U2("<##>", 1, 2)
If s <> "< 1>< 2>" Then ExitProcess(2)
s = Using$("+##", 5)
If s <> " +5" Then ExitProcess(3)
s = Using$("+##", 0 - 5)
If s <> " -5" Then ExitProcess(4)
s = Using$("##-", 0 - 5)
If s <> " 5-" Then ExitProcess(5)
s = Using$("##-", 5)
If s <> " 5 " Then ExitProcess(6)
s = Using$("##+", 5)
If s <> " 5+" Then ExitProcess(7)
s = Using$("**###", 12)
If s <> "***12" Then ExitProcess(8)
s = Using$("\\###", 2500)
If s <> "\2500" Then ExitProcess(9)
s = Using$("**\###", 12)
If s <> "***\12" Then ExitProcess(10)
s = Using$("#########,", 1234567)
If s <> " 1,234,567" Then ExitProcess(11)
s = Using$("##.##^^^^", 234.56)
If s <> " 2.35E+02" Then ExitProcess(12)
s = Using$("##.##^^^^", 0 - 0.0123)
If s <> "-1.23E-02" Then ExitProcess(13)
s = Using$("##", 123)
If s <> "%123" Then ExitProcess(14)
s = Using$("#.##", 0.5)
If s <> "0.50" Then ExitProcess(15)
s = Using$("#.##", 0 - 0.5)
If s <> "-.50" Then ExitProcess(16)
s = Using$("_###", 7)
If s <> "# 7" Then ExitProcess(17)
s = UsingStr$("!", "xyz")
If s <> "x" Then ExitProcess(18)
s = UsingStr$("(@)", "ab")
If s <> "(ab)" Then ExitProcess(19)
s = Using$("##.#", 9.96)
If s <> "10.0" Then ExitProcess(20)

' 値の型で呼び分け（Long / Double / String 変数）
a = 42
d = 1.5
t = "hi"
s = PuUseBeg$("@=## #.#")
s = PuUseVal$(s, t)
s = PuUseVal$(s, a)
s = PuUseVal$(s, d)
s = PuUseEnd$(s)
If s <> "hi=42 1.5" Then ExitProcess(21)

' 全角（文字列は UTF-8）。_ のあとの全角は 1 文字ぶんそのまま
s = U2("┃##┃", 1, 15)
If s <> "┃ 1┃┃15┃" Then ExitProcess(22)
s = Using$("_あ##", 5)
If s <> "あ 5" Then ExitProcess(24)

' 欄のあとの文字は次の欄の手前まで
s = Using$("#|#|", 3)
If s <> "3|" Then ExitProcess(23)

Print Using "|##|##|##|##|"; 1, 2, 3, 15
Print Using "@ & &!"; "a", "bcd", "ef";
Print
a = 7
Print Using "##"; a; a
ExitProcess(0)
