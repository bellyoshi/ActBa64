' Expect: 37
' Target: actba64
#console

' メソッドの中から同じクラスのメソッドを This. なしで呼ぶ（ActiveBasic と同じ）。
' 非公開の Function / Sub、後ろで定義したメソッド、継承元のメソッド、引数つき、式の中を確かめる。

Class Base
    Public
    b As Long

    Sub AddB(n As Long)
        b = b + n
    End Sub
End Class

Class Calc
    Inherits Base
    v As Long

    Function Twice() As Long
        Twice = v * 2
    End Function

    Sub Bump()
        v = v + 1
    End Sub

Public
    Sub Calc(n As Long)
        v = n
        b = 0
    End Sub

    Function Run() As Long
        Bump()
        AddB(Later(3))
        Run = Twice() + b + This.Twice()
    End Function

    Function Later(k As Long) As Long
        Later = k + v
    End Function
End Class

' c.Run: Bump で v = 4、Later(3) = 7 なので b = 7、Twice() + b + This.Twice() = 8 + 7 + 8 = 23
' d.Later(7) = 14（v = 7）。合計 37
Dim c As Calc(3)
Dim d As Calc(7)
ExitProcess(c.Run() + d.Later(7))
