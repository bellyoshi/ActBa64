' Expect: -1073741819
' Target: actba64
' 入れ子の Sub で NULL を参照したら、デバッガー無しでも c0000005 で終わること。
' 64bit の exe に .pdata が無いと、新しい Windows（CI の Windows Server など）は例外を配る途中で
' 呼び出し履歴をたどれず fail fast（c0000409）にすることがあった
' SetErrorMode で WER の窓を出さない（テストが止まらないように）
#console
Declare Function SetErrorMode Lib "kernel32.dll" (ByVal mode As DWord) As DWord

Sub Poke(p As *Long)
    p[0] = 5
End Sub

Sub Outer()
    Dim q As *Long
    q = 0
    Poke(q)
End Sub

SetErrorMode(&H8003)
Outer()
ExitProcess(1)
