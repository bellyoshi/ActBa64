' Expect: 5
' Target: actba64
#console

' 呼ばれない Function / Sub の構文エラーは報告しない（ActiveBasic 4.20 は呼ばれない手続きをコンパイルしない）。
Sub LazyUnused(hwnd As Long, iZoom)
    SendMessage(hwnd, 0, 0, (UINT)(iZoom))
End Sub

Function LazyUnused2() As Long
    LazyUnused2 = SendMessage(0, 0, 0, 0L)
End Function

Function LazyOk(n As Long) As Long
    LazyOk = n + 2
End Function

ExitProcess(LazyOk(3))
