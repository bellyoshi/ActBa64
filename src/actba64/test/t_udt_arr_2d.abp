' Expect: 0
' Target: actba64
' 多次元 UDT 配列のメンバ a(i, j).x / a[i, j].x（大域・局所・3 次元・並び）
#console
Type tP
    x As Long
    y As Long
End Type
Type tA
    fb As Long
    d As Double
    s As String
    p As tP
End Type

Dim g(1, 2) As tA
Dim g3(1, 2, 3) As tP

Function Check(cond As Long, code As Long) As Long
    Check = 0
    If cond = 0 Then
        Print "fail "; code
        Check = 1
    End If
End Function

Function LocalTest() As Long
    Dim a(2, 1) As tA
    Dim i As Long, j As Long, bad As Long
    For i = 0 To 2
        For j = 0 To 1
            a(i, j).fb = i * 10 + j
            a[i, j].d = i + j / 4
        Next
    Next
    bad = 0
    bad = bad + Check(a(2, 1).fb = 21, 101)
    bad = bad + Check(a[1, 0].fb = 10, 102)
    bad = bad + Check(a(1, 1).d = 1.25, 103)
    a(0, 1).fb += 5
    bad = bad + Check(a[0, 1].fb = 6, 104)
    LocalTest = bad
End Function

Dim bad As Long
Dim i As Long, j As Long, k As Long
Dim q As *tA

bad = 0
g(1, 2).fb = 10
bad = bad + Check(g[1, 2].fb = 10, 1)
g[0, 1].s = "hi"
bad = bad + Check(g(0, 1).s = "hi", 2)
g(1, 0).p.x = 7
bad = bad + Check(g(1, 0).p.x = 7, 3)
' 最後の添字が連続: g(1, 0) の次は g(1, 1)
q = VarPtr(g(1, 0))
bad = bad + Check(q[1].fb = 0, 4)
g(1, 1).fb = 42
bad = bad + Check(q[1].fb = 42, 5)
bad = bad + Check(q[2].fb = 10, 6)
With g(0, 2)
    .fb = 3
End With
bad = bad + Check(g[0, 2].fb = 3, 7)

For i = 0 To 1
    For j = 0 To 2
        For k = 0 To 3
            g3(i, j, k).x = i * 100 + j * 10 + k
        Next
    Next
Next
bad = bad + Check(g3(1, 2, 3).x = 123, 8)
bad = bad + Check(g3[0, 1, 2].x = 12, 9)
bad = bad + Check(g3(1, 0, 0).x = 100, 10)

bad = bad + LocalTest()
If bad = 0 Then Print "ok"
ExitProcess(bad)
