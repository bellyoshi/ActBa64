' Expect: 0
' Target: actba64
' String を返す関数の戻りが、先行する Cat で有効化された StrCollect に潰されないこと
#console

Function Init$() As String
    Init$ = "a" + "b"
End Function

Function F$() As String
    F$ = "hello"
End Function

Function G() As Long
    G = 42
End Function

Dim dummy As String
dummy = Init$()
If F$() <> "hello" Then
    Print "fail F$"
    ExitProcess(1)
End If
If G() <> 42 Then
    Print "fail G"
    ExitProcess(2)
End If
Print "ok"
ExitProcess(0)
End
