' Expect: 7
' Target: actba64
#console
' メソッドの中で *Class のフィールドの先の *Class のフィールドのメソッドを呼ぶ: a->b->M()

Class Leaf
Public
    Function Value(x As Long) As Long
        Value = x + 4
    End Function
End Class

Class Mid
Public
    b As *Leaf
    Sub Mid()
        b = New Leaf
    End Sub
End Class

Class Top
Private
    a As *Mid
Public
    Sub Top(p As *Mid)
        a = p
    End Sub
    Function Run() As Long
        Run = a->b->Value(3)
    End Function
End Class

Dim m As *Mid
Dim t As *Top
m = New Mid
t = New Top(m)
ExitProcess(t->Run())
