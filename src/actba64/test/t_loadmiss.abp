' Expect: 0
' Target: actba64
' 存在しないファイルの LoadTextFile 相当: CreateFile 失敗後に Len("") できること
#console

Function LoadMiss$(path As String) As String
    Dim hFile As HANDLE
    LoadMiss$ = ""
    hFile = CreateFile(StrPtr(path), GENERIC_READ, FILE_SHARE_READ, ByVal NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL)
    If hFile = INVALID_HANDLE_VALUE Then Exit Function
    CloseHandle(hFile)
    LoadMiss$ = "hit"
End Function

Function TargetPath$() As String
    Dim dir As String
    Dim buf As *Byte
    Dim n As Long
    Dim i As Long
    Dim lastSlash As Long
    Dim tmp As Long
    Dim bp As *Byte
    dir = ""
    buf = malloc(260)
    If buf = 0 Then
        TargetPath$ = "editor.target"
        Exit Function
    End If
    n = GetModuleFileName(NULL, buf, 260)
    If n <= 0 Then
        free(buf)
        TargetPath$ = "editor.target"
        Exit Function
    End If
    lastSlash = -1
    bp = VarPtr(tmp)
    For i = 0 To n - 1
        bp[0] = buf[i]
        tmp = tmp And &HFF
        If tmp = 92 Or tmp = 47 Then lastSlash = i
    Next
    If lastSlash >= 0 Then
        buf[lastSlash + 1] = 0
        dir = MakeStr(buf)
        dir = Mid$(dir, 1, lastSlash + 1)
        TargetPath$ = dir + "no_such_editor.target"
    Else
        TargetPath$ = "editor.target"
    End If
    free(buf)
End Function

Dim s As String
Dim n As Long
s = LoadMiss$(TargetPath$())
n = Len(s)
If n <> 0 Then
    Print "fail n"
    ExitProcess(1)
End If
Print "ok"
ExitProcess(0)
End
