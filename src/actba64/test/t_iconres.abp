' Expect: 1
' Target: actba64
' #resource の .rc を隣の rc.exe が RT_GROUP_ICON にする
#console
Declare Function GetModuleHandleA Lib "kernel32" (lpModuleName As Long) As Long
Declare Function FindResourceA Lib "kernel32" (hModule As Long, lpName As Long, lpType As Long) As Long

#resource "fixtures\t_icon.rc"

Const RT_GROUP_ICON = 14

Dim hMod As Long
Dim hRes As Long
hMod = GetModuleHandleA(0)
hRes = FindResourceA(hMod, MAKEINTRESOURCE(101), MAKEINTRESOURCE(RT_GROUP_ICON))
If hRes = 0 Then
    ExitProcess(0)
End If
ExitProcess(1)
