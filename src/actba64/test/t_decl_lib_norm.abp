' Expect: 0
' Target: actba64
#console
' Lib 拡張子なし → .dll 付与。既知 DLL の Alias 呼び出し
Declare Function TickNoExt Lib "kernel32" Alias "GetTickCount" () As DWord
Declare Function TickWithExt Lib "kernel32.dll" Alias "GetTickCount" () As DWord
Dim a As DWord
Dim b As DWord
a = TickNoExt()
b = TickWithExt()
If a = 0 And b = 0 Then
    ExitProcess(1)
End If
ExitProcess(0)
