' Expect: 0
' Target: actba64
' Stdin: -9223372036854775807
' Int64 / QWord: Const、キャスト、Hex$ / Oct$、ポインタ、QWord の For、Input、Print # / Write #、Print Using（64bit 出力と -actba32）
#console
Const BIG = 5000000000
Const NEGB = &HFFFFFFFFFFFFFFFF

Function Check(cond As Long, code As Long) As Long
    Check = 0
    If cond = 0 Then
        Print "fail "; code
        Check = 1
    End If
End Function

Dim x As Int64, d As Double, s As Single, l As Long, u As QWord, p As *Byte, buf(3) As Byte
Dim t As String
Dim bad As Long
bad = 0
bad = bad + Check(Str$(BIG) = "5000000000" And Str$(BIG + 1) = "5000000001" And Str$(NEGB) = "-1", 1)
x = BIG
d = x As Double
bad = bad + Check(d = 5000000000.0, 2)
s = x As Single
bad = bad + Check(s > 4.9e9 And s < 5.1e9, 3)
l = x As Long
bad = bad + Check(l = 705032704, 4)
bad = bad + Check(Hex$(&H123456789) = "123456789" And Hex$(255) = "ff" And Hex$(-1) = "ffffffff", 5)
bad = bad + Check(Oct$(&H8000000000000000) = "1000000000000000000000", 6)
u = &HFFFFFFFFFFFFFFFF
bad = bad + Check(Hex$(u) = "ffffffffffffffff", 7)
p = VarPtr(buf)
x = p
bad = bad + Check(x = p, 8)
t = ""
For u = &H7FFFFFFFFFFFFFFE To &H8000000000000001
    t = t + Hex$(u) + ","
Next
bad = bad + Check(t = "7ffffffffffffffe,7fffffffffffffff,8000000000000000,8000000000000001,", 9)
Input "n"; x
bad = bad + Check(Str$(x) = "-9223372036854775807", 10)
x = 5000000000
Open "t_int64_fix.tmp" For Output As #1
Write #1, x
Close #1
Open "t_int64_fix.tmp" For Input As #1
x = 0
Input #1, x
Close #1
bad = bad + Check(Str$(x) = "5000000000", 11)
Kill "t_int64_fix.tmp"
If bad = 0 Then Print "ok"
ExitProcess(bad)
