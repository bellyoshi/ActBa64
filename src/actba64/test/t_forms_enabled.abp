' Expect: 1111
' Target: actba64
' Forms.sbp の Enabled / SetEnabled と、InitializeComponent を呼ぶ時期:
' 部品の Enabled は初め True（Control の ctor）。InitializeComponent は最初の Show で呼ばれるので、
' そこで入れた Enabled = False が部品の ctor に上書きされない → 窓は使えない。SetEnabled で切り替わる

#include <Forms.sbp>

Class Form1
    Inherits Form
Public
    Button2 As Button
    Button3 As Button

Private
    Override Sub InitializeComponent()
        Width = 200
        Height = 120
        Caption = "テスト"

        Button2.Left = 8
        Button2.Top = 8
        Button2.Width = 60
        Button2.Height = 30
        Button2.Caption = "前へ"
        Button2.Enabled = False
        AddControl(Button2)

        Button3.Left = 80
        Button3.Top = 8
        Button3.Width = 60
        Button3.Height = 30
        Button3.Caption = "次へ"
        AddControl(Button3)
    End Sub
End Class

Dim mainForm As Form1
Dim r As Long

mainForm.Show()
r = 0
If IsWindowEnabled(mainForm.Button2.Handle) = 0 And mainForm.Button2.Enabled = False Then r = r + 1000
If IsWindowEnabled(mainForm.Button3.Handle) <> 0 And mainForm.Button3.Enabled <> False Then r = r + 100
mainForm.Button2.SetEnabled(1 > 0)
mainForm.Button3.SetEnabled(1 < 0)
If IsWindowEnabled(mainForm.Button2.Handle) <> 0 And IsWindowEnabled(mainForm.Button3.Handle) = 0 Then r = r + 10
If mainForm.Button3.Enabled = False Then r = r + 1
PostMessage(mainForm.Handle, WM_CLOSE, 0, 0)
Application.Initialize()
Application.Run(mainForm)
ExitProcess(r)
