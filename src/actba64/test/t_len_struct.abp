' Expect: 0
' Target: actba64
' Len(構造体) / MAKEINTRESOURCE / FillMemory
#console
Type T
    a As Long
    b As Long
End Type
Dim x As T
FillMemory(VarPtr(x), Len(x), 0)
x.a = MAKEINTRESOURCE(32512)
If Len(x) <> 8 Then
    ExitProcess(1)
End If
If x.a <> 32512 Then
    ExitProcess(2)
End If
If x.b <> 0 Then
    ExitProcess(3)
End If
ExitProcess(0)
