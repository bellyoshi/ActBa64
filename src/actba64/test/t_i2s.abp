' Expect: 0
' Target: actba64
' Integer → Single numeric conversion on assign
#console
Dim s As Single
Dim a(1) As Single
Dim n As Long
Dim bits As Long

n = 2
s = n
memcpy(VarPtr(bits), VarPtr(s), 4)
' 2.0f = 0x40000000
If bits <> &H40000000 Then
    ExitProcess(1)
End If

a[0] = 800
memcpy(VarPtr(bits), VarPtr(a[0]), 4)
' 800.0f = 0x44480000
If bits <> &H44480000 Then
    ExitProcess(2)
End If

s = 0.5
memcpy(VarPtr(bits), VarPtr(s), 4)
' 0.5f = 0x3F000000 (float lit must stay bits, not cvt)
If bits <> &H3F000000 Then
    ExitProcess(3)
End If

ExitProcess(0)
End
