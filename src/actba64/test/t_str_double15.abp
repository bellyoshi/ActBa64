' Expect: 0
' Target: actba64
' Double の Str$ / Print は ActiveBasic と同じ有効 15 桁（AB4.20 の Print Sqr(5) は 2.23606797749979）
#console
Dim d As Double
d = 5
If Str$(Sqr(d)) <> "2.23606797749979" Then ExitProcess(1)
If Str$(Sqr(5 As Single)) <> "2.23606797749979" Then ExitProcess(2)
d = 1
If Str$(d / 3) <> "0.333333333333333" Then ExitProcess(3)
If Str$(-d / 7) <> "-0.142857142857143" Then ExitProcess(4)
If Str$(0.1 + 0.2) <> "0.3" Then ExitProcess(5)
If Str$(123456789012345.0) <> "123456789012345" Then ExitProcess(6)
If Str$(1234567890123456.0) <> "1.23456789012346E+15" Then ExitProcess(7)
If Str$(1.5e20) <> "1.5E+20" Then ExitProcess(8)
If Str$(0.0001) <> "0.0001" Then ExitProcess(9)
If Str$(0.00001234) <> "1.234E-5" Then ExitProcess(10)
If Str$(999999999999999.9) <> "1E+15" Then ExitProcess(11)
d = 0
If Str$(d) <> "0" Then ExitProcess(12)
ExitProcess(0)
