' Expect: 63
' Target: actba64
' Type X Pack(n) はフィールドの整列を n までに抑える（#pragma pack と同じ）。MCI の構造体は Windows と同じ Pack(1)
#console
#include <api_mmsys.sbp>
Type P1 Pack(1)
    a As Byte
    b As Long
    c As Word
End Type

Type P2 Pack(2)
    a As Byte
    b As Long
End Type

Dim p As P1
Dim q As P2
Dim m As MCI_OPEN_PARMS
Dim w As WAVEFORMATEX
Dim r As Long
r = 0
If VarPtr(p.b) - VarPtr(p) = 1 And VarPtr(p.c) - VarPtr(p) = 5 Then r = r + 1
If SizeOf(P1) = 7 Then r = r + 2
If VarPtr(q.b) - VarPtr(q) = 2 And SizeOf(P2) = 6 Then r = r + 4
If VarPtr(m.lpstrDeviceType) - VarPtr(m) = SizeOf(DWORD_PTR) + 4 Then r = r + 8
If SizeOf(MCI_OPEN_PARMS) = SizeOf(DWORD_PTR) * 4 + 4 Then r = r + 16
If SizeOf(WAVEFORMATEX) = 18 Then r = r + 32
ExitProcess(r)
