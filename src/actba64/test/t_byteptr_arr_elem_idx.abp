' Expect: 0
' Target: actba64
#console
' BytePtr の配列の要素の先を添字で読む: LBL[i*2][0]（大域・局所、手続きの中でも）

Dim LBL[3] = ["J", "Japan", "E", "USA"] AS BytePtr
Dim r As Long

Function FindId(letter As Byte) As Long
    Dim i As Long
    FindId = -1
    For i = 0 To 1
        If letter = LBL[i * 2][0] Then
            FindId = i
            ExitFor
        End If
    Next
End Function

Function LocalElem() As Long
    Dim L[1] = ["J", "USA"] AS BytePtr
    LocalElem = L[1][2]
End Function

r = 0
If FindId(&H45) <> 1 Then r = r + 1
If FindId(&H58) <> -1 Then r = r + 2
If LBL[3][1] <> &H53 Then r = r + 4
If LocalElem() <> &H41 Then r = r + 8
ExitProcess(r)
