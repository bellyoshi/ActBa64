' Target: actba64
' Expect: 0
#console

Dim path As String
Dim drive(8) As Byte
Dim dir(64) As Byte
Dim fname(64) As Byte
Dim ext(16) As Byte
Dim slash As String

slash = Chr$(92)
path = "C:" + slash + "dir1" + slash + "dir2" + slash + "filename.txt"
_splitpath(StrPtr(path), VarPtr(drive), VarPtr(dir), VarPtr(fname), VarPtr(ext))
If MakeStr(VarPtr(drive)) <> "C:" Then ExitProcess(1)
If MakeStr(VarPtr(dir)) <> slash + "dir1" + slash + "dir2" + slash Then ExitProcess(2)
If MakeStr(VarPtr(fname)) <> "filename" Then ExitProcess(3)
If MakeStr(VarPtr(ext)) <> ".txt" Then ExitProcess(4)

path = "C:" + slash + "file.name.txt"
_splitpath(StrPtr(path), VarPtr(drive), VarPtr(dir), VarPtr(fname), VarPtr(ext))
If MakeStr(VarPtr(dir)) <> slash Then ExitProcess(5)
If MakeStr(VarPtr(fname)) <> "file.name" Then ExitProcess(6)
If MakeStr(VarPtr(ext)) <> ".txt" Then ExitProcess(7)

path = "C:" + slash + "file"
_splitpath(StrPtr(path), VarPtr(drive), 0, VarPtr(fname), VarPtr(ext))
If MakeStr(VarPtr(fname)) <> "file" Then ExitProcess(8)
If MakeStr(VarPtr(ext)) <> "" Then ExitProcess(9)
If MakeStr(VarPtr(dir)) <> slash Then ExitProcess(10)

drive[0] = Asc("Z")
drive[1] = 0
path = "file.txt"
_splitpath(StrPtr(path), VarPtr(drive), VarPtr(dir), VarPtr(fname), VarPtr(ext))
If drive[0] <> Asc("Z") Then ExitProcess(11)
ExitProcess(0)
