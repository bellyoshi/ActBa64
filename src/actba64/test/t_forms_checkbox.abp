' Expect: 11111
' Target: actba64
' Forms.sbp の CheckBox: AddControl した CheckBox は子窓（BUTTON の BS_AUTOCHECKBOX）になる
' → InitializeComponent の Checked = True で印が付いて作られ、押すと印が外れて BN_CLICKED が届き、
'   SetChecked で印を付け直せる

#include <Forms.sbp>

Dim g_cls(15) As Byte
Dim g_clicked As Long

Class Form1
    Inherits Form
Public
    CheckBox1 As CheckBox

    Override Function WndProc(msg As DWord, wParam As WPARAM, lParam As LPARAM) As LRESULT
        If msg = WM_COMMAND Then
            If HIWORD(wParam) = BN_CLICKED And lParam = CheckBox1.Handle Then g_clicked = g_clicked + 1
        End If
        WndProc = Super.WndProc(msg, wParam, lParam)
    End Function

Private
    Override Sub InitializeComponent()
        Width = 200
        Height = 120
        Caption = "テスト"

        CheckBox1.Left = 8
        CheckBox1.Top = 8
        CheckBox1.Width = 100
        CheckBox1.Height = 20
        CheckBox1.Caption = "印"
        CheckBox1.Checked = True
        AddControl(CheckBox1)
    End Sub
End Class

Dim mainForm As Form1
Dim r As Long

mainForm.Show()
r = 0
GetClassName(mainForm.CheckBox1.Handle, VarPtr(g_cls), 16)
If lstrcmpi(VarPtr(g_cls), "Button") = 0 And (GetWindowLong(mainForm.CheckBox1.Handle, GWL_STYLE) And &HF) = BS_AUTOCHECKBOX Then r = r + 10000
If mainForm.CheckBox1.GetChecked() = True Then r = r + 1000
SendMessage(mainForm.CheckBox1.Handle, BM_CLICK, 0, 0)
If mainForm.CheckBox1.GetChecked() = False Then r = r + 100
If g_clicked = 1 Then r = r + 10
mainForm.CheckBox1.SetChecked(True)
If SendMessage(mainForm.CheckBox1.Handle, BM_GETCHECK, 0, 0) = BST_CHECKED And mainForm.CheckBox1.GetChecked() = True Then r = r + 1
PostMessage(mainForm.Handle, WM_CLOSE, 0, 0)
Application.Initialize()
Application.Run(mainForm)
ExitProcess(r)
