' Expect: 15
' Target: actba64
' 多次元配列は最後の添字が連続（ActiveBasic と同じ）。VarPtr(a[i, 0]) から a[i, 0..M] を読む
#console
Dim a[2, 3] As Long
Dim b[1, 2, 3] As Long
Dim p As *Long
Dim r As Long
a[1, 1] = 7
b[1, 0, 1] = 9
b[0, 2, 0] = 4
r = 0
p = VarPtr(a[1, 0])
If p[1] = 7 Then r = r + 1
p = VarPtr(a)
If p[5] = 7 Then r = r + 2
p = VarPtr(b)
If p[13] = 9 Then r = r + 4
If p[8] = 4 Then r = r + 8
ExitProcess(r)
