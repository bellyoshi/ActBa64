' Expect: 45
' Target: actba64
#console
Type tast
    name As String
    Token As Long
End Type

Dim dast As *tast

dast = malloc(SizeOf(tast) * 10)
Dim i As Long
For i = 0 To 9
    dast[i].name = "a"
    dast[i].Token = i
Next
Dim sum As Long
sum = 0
For i = 0 To 9
    sum = sum + dast[i].Token
Next

free(dast)
ExitProcess(sum)
