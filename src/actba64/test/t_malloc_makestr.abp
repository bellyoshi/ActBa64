' malloc バッファを MakeStr する（lstrlenA）。ヒープが高位でも生き残ること。
' Expect: 0
' Target: actba64
#console

Type TB
    buffer As *Byte
    n As Long
End Type

Function FillAndDup$(ByVal p As *Byte, ByVal n As Long) As String
    Dim i As Long
    Dim s As String
    FillAndDup$ = ""
    If p = 0 Then Exit Function
    i = 0
    While i < n
        p[i] = 65 + (i Mod 26)
        i = i + 1
    Wend
    p[n] = 0
    s = MakeStr(p)
    FillAndDup$ = Mid$(s, 1, n)
End Function

Dim t As TB
Dim s As String
Dim keep As String
Dim i As Long
Dim n As Long

keep = "ABC"
i = 0
While i < 80
    n = 1 + (i Mod 7)
    t.buffer = malloc(n + 1)
    t.n = n
    s = FillAndDup$(t.buffer, t.n)
    If Len(s) <> n Then
        ExitProcess(10 + n)
    End If
    free(t.buffer)
    i = i + 1
Wend

If keep <> "ABC" Then
    ExitProcess(1)
End If
If Len(s) < 1 Then
    ExitProcess(2)
End If
ExitProcess(0)
