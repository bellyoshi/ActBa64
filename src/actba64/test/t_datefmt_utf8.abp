' Expect: 7
' Target: actba64
' GetDateFormat / GetTimeFormat の書式に日本語を入れても崩れない（A 版に UTF-8 を渡していた）
#console
Dim buffer[255] As Byte
Dim st As SYSTEMTIME
Dim n As Long, ok As Long
ok = 0
st.wYear = 2024
st.wMonth = 2
st.wDay = 29
n = GetDateFormat(LOCALE_USER_DEFAULT, 0, st, "yyyy'年'M'月'd'日'", buffer, 255)
If lstrcmp(buffer, "2024年2月29日") = 0 Then ok = ok Or 1
st.wHour = 9
st.wMinute = 5
st.wSecond = 7
GetTimeFormat(LOCALE_USER_DEFAULT, 0, st, "HH'時'mm'分'ss'秒'", buffer, 255)
If lstrcmp(buffer, "09時05分07秒") = 0 Then ok = ok Or 2
n = GetDateFormat(LOCALE_USER_DEFAULT, 0, ByVal 0, "yyyy'年'", buffer, 255)
If n = lstrlen(buffer) + 1 And n > 4 Then ok = ok Or 4
ExitProcess(ok)
