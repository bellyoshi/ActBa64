' Expect: 0
' Target: actba64
' 大文字小文字だけ違う Const は、同じ名前のローカル・引数に負ける。
' 以前は Const N = 4 があると、Include を含むすべての手続きの n が 4 と読まれ、String GC の表の掃除が壊れた
#console
Const N = 4

Function ArgN(n As Long) As Long
    ArgN = n
End Function

Function LocalN() As Long
    Dim n As Long
    n = 9
    LocalN = n
End Function

Dim i As Long
If ArgN(7) <> 7 Then ExitProcess(1)
If LocalN() <> 9 Then ExitProcess(2)
If N <> 4 Then ExitProcess(3)
i = 0
While i < N
    i = i + 1
Wend
If i <> 4 Then ExitProcess(4)
ExitProcess(0)
