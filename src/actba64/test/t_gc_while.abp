' While 内の Cat で GC しても生きている String を残す
' Expect: 0
' Target: actba64
#console
Dim keep As String
Dim t As String
Dim i As Long

keep = "ABC"
i = 0
While i < 120
    t = "x" + Str$(i)
    i = i + 1
Wend
If keep <> "ABC" Then
    Print "fail keep"
    ExitProcess(1)
End If
If Len(keep) <> 3 Then
    Print "fail len"
    ExitProcess(2)
End If
If Len(t) < 2 Then
    Print "fail last"
    ExitProcess(3)
End If
Print "ok"
ExitProcess(0)
End
