' Expect: 42
' Target: actba64
#console

Class Counter
    Public
    value As Long

    Sub Counter(v As Long)
        value = v
    End Sub

    Sub ~Counter()
        value = 0
    End Sub

    Sub Add(n As Long)
        value = value + n
    End Sub

    Function GetValue() As Long
        GetValue = value
    End Function
End Class

Dim c As Counter(10)
c.Add(32)
ExitProcess(c.GetValue())
