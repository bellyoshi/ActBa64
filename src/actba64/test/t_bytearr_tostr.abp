' Expect: 0
' Target: actba64
' Byte 配列を String 引数・String 変数へ渡すと C 文字列として複製する（FileDivider の Val(temporary)）
#console
Function StrLen(s As String) As Long
    StrLen = Len(s)
End Function

Dim temporary[255] As Byte
Dim s As String
lstrcpy(temporary, "1024")
If StrLen(temporary) <> 4 Then ExitProcess(1)
If Val(temporary) <> 1024 Then ExitProcess(2)
s = temporary
If s <> "1024" Then ExitProcess(3)
ExitProcess(0)
