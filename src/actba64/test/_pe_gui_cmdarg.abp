' Target: actba64
' GUI: EditorDoc_CmdArg$ 相当を WM_CREATE で実行
#USEWINDOW=1

Function CmdArg$(ByVal index As Long) As String
    Dim cmd As *Byte
    Dim i As Long
    Dim n As Long
    Dim c As Byte
    Dim argi As Long
    Dim out As *Byte
    Dim m As Long
    Dim inQuote As Long

    CmdArg$ = ""
    cmd = GetCommandLine()
    If cmd = 0 Then Exit Function
    n = lstrlen(cmd)
    If n <= 0 Then Exit Function
    out = malloc(n + 1)
    If out = 0 Then Exit Function

    i = 0
    argi = 0
    While i < n
        While i < n
            c = cmd[i]
            If c <> 32 And c <> 9 Then Exit While
            i = i + 1
        Wend
        If i >= n Then Exit While

        m = 0
        inQuote = 0
        If cmd[i] = 34 Then
            inQuote = 1
            i = i + 1
        End If
        While i < n
            c = cmd[i]
            If inQuote <> 0 Then
                If c = 34 Then
                    i = i + 1
                    Exit While
                End If
            Else
                If c = 32 Or c = 9 Then Exit While
            End If
            out[m] = c
            m = m + 1
            i = i + 1
        Wend
        out[m] = 0
        If argi = index Then
            CmdArg$ = Enc_DupCStr$(out, m)
            free(out)
            Exit Function
        End If
        argi = argi + 1
    Wend
    free(out)
End Function

Function Enc_DupCStr$(ByVal p As *Byte, ByVal n As Long) As String
    Dim s As String
    Enc_DupCStr$ = ""
    If p = 0 Then Exit Function
    If n <= 0 Then Exit Function
    s = MakeStr(p)
    Enc_DupCStr$ = Mid$(s, 1, n)
End Function

Function WndProc(hWnd As HWND, message As DWord, wParam As WPARAM, lParam As LPARAM) As LRESULT
    Select Case message
        Case WM_CREATE
            SetWindowText(hWnd, "editor - (untitled) [64bit, UTF-8]")
            Dim path As String
            path = CmdArg$(1)
            If Len(path) = 0 Then
                SetWindowText(hWnd, "editor - cmd empty")
            Else
                SetWindowText(hWnd, "editor - cmd has arg")
            End If
        Case WM_DESTROY
            PostQuitMessage(0)
        Case Else
            WndProc = DefWindowProc(hWnd, message, wParam, lParam)
            Exit Function
    End Select
    WndProc = 0
End Function

Dim wc As WNDCLASSEX
FillMemory(VarPtr(wc), Len(wc), 0)
wc.cbSize = Len(wc)
wc.hInstance = GetModuleHandle(0)
wc.style = CS_HREDRAW Or CS_VREDRAW
wc.hCursor = LoadCursor(NULL, MAKEINTRESOURCE(IDC_ARROW))
wc.lpszClassName = "NORMAL0"
wc.lpfnWndProc = AddressOf(WndProc)
wc.hbrBackground = CreateSolidBrush(GetSysColor(COLOR_3DFACE))
RegisterClassEx(wc)

CreateWindowEx(&H00000000, "NORMAL0", "editor", &H10cf0000, -2147483648, -2147483648, 495, 367, 0, 0, GetModuleHandle(0), 0)

Dim msg As MSG
Dim r As Long
Do
    r = GetMessage(msg, 0, 0, 0)
    If r = 0 Then Exit Do
    If r = -1 Then Exit Do
    TranslateMessage(msg)
    DispatchMessage(msg)
Loop
End
