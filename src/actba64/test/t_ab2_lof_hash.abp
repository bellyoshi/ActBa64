' Expect: 0
' Target: actba64
' Option: -pAB2
' -pAB2: Lof(#1) のように関数の引数にファイル番号の # を付けられる
#console
' （-pAB2 では引数が既定で ByRef なので、AB4 の FileIO.abp は使わず Print # で作る）
Open "bin/test_out/t_ab2_lof.txt" For Output As #1
Print #1, "abc";
Close #1
Open "bin/test_out/t_ab2_lof.txt" As #1
If Lof(#1)<>3 Then ExitProcess(1)
Close #1
ExitProcess(0)
