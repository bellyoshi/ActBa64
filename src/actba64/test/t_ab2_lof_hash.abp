' Expect: 0
' Target: actba64
' Option: -pAB2
' -pAB2: Lof(#1) のように関数の引数にファイル番号の # を付けられる
#console
#include "../FileIO.abp"
If WriteTextFile("bin/test_out/t_ab2_lof.txt", "abc") = 0 Then ExitProcess(9)
Open "bin/test_out/t_ab2_lof.txt" As #1
If Lof(#1)<>3 Then ExitProcess(1)
Close #1
ExitProcess(0)
