' Expect: 15
' Target: actba64
' .rc の BITMAP を RT_BITMAP として埋め込む。ID は .rc と同じフォルダの resource.sbp の Const から取る（ActiveBasic と同じ）。
#console
#resource "fixtures\bmpres\t_bmpres.rc"

Dim hInst As HINSTANCE, hBmp As HBITMAP, bm As BITMAP, r As Long
hInst = GetModuleHandle(0)
hBmp = LoadBitmap(hInst, MAKEINTRESOURCE(101))
If hBmp <> 0 Then r = r + 1
If GetObject(hBmp, SizeOf(BITMAP), VarPtr(bm)) <> 0 Then
    If bm.bmWidth = 2 And bm.bmHeight = 2 Then r = r + 2
End If
If LoadBitmap(hInst, MAKEINTRESOURCE(102)) <> 0 Then r = r + 4
If LoadIcon(hInst, MAKEINTRESOURCE(107)) <> 0 Then r = r + 8
ExitProcess(r)
