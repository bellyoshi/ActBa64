' Expect: 0
' Target: actba64
' Skip32: 1
' QWord の符号なしの規則（両辺とも符号なしなら \ Mod 比較が符号なし、QWord の >> は論理シフト、
' Double との変換は 2^63 以上も）。64bit 出力
#console
Function Check(cond As Long, code As Long) As Long
    Check = 0
    If cond = 0 Then
        Print "fail "; code
        Check = 1
    End If
End Function

Dim u As QWord, v As QWord, d As Double, x As Int64, dw As DWord
Dim bad As Long
bad = 0
u = &HFFFFFFFFFFFFFFFF
v = 10
bad = bad + Check(Str$(u \ v) = "1844674407370955161" And Str$(u Mod v) = "5", 1)
bad = bad + Check(Str$(u >> 60) = "15", 2)
x = -16
bad = bad + Check(Str$(x >> 2) = "-4", 3)
bad = bad + Check(u > v, 4)
bad = bad + Check(u > 5, 5)
' Int64 との比較は符号つき（-1 > -16）
bad = bad + Check(u > x, 6)
d = u
bad = bad + Check(d = 18446744073709551615.0, 7)
u = &H8000000000000000
d = u
bad = bad + Check(d = 9223372036854775808.0, 8)
d = 1.5e19
u = d
bad = bad + Check(Str$(u) = "15000000000000000000", 9)
d = 123.9
u = d
bad = bad + Check(Str$(u) = "123", 10)
dw = 4000000000
u = dw
bad = bad + Check(Str$(u) = "4000000000", 11)
bad = bad + Check((u > dw) = 0, 12)
x = -7
bad = bad + Check(Str$(x \ 2) = "-3" And Str$(x Mod 2) = "-1", 13)
If bad = 0 Then Print "ok"
ExitProcess(bad)
