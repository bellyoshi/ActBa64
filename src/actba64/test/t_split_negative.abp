' Expect: 15
' Target: actba64
' 負の値のバイト分解（Hex$ / SetWord / SetDWord）は最上位ビットが立っていても正しい
#console
Dim b[7] As Byte
Dim r As Long
r = 0
If Hex$(-1) = "ffffffff" Or Hex$(-1) = "FFFFFFFF" Then r = r + 1
SetWord(VarPtr(b[0]), -2)
If b[0] = &HFE And b[1] = &HFF Then r = r + 2
SetDWord(VarPtr(b[4]), -2)
If b[4] = &HFE And b[5] = &HFF And b[6] = &HFF And b[7] = &HFF Then r = r + 4
SetDWord(VarPtr(b[4]), &H80000010)
If b[4] = &H10 And b[5] = 0 And b[6] = 0 And b[7] = &H80 Then r = r + 8
ExitProcess(r)
