' Expect: 1
' Target: actba64
' Lower$ の戻り同士の = は文字列比較（ポインタ比較であってはならない）
#console
Function Lower$(s As String) As String
    Dim p As *Byte
    Dim i As Long
    Dim n As Long
    Dim c As Long
    Dim r As String
    n = Len(s)
    If n = 0 Then
        Lower$ = ""
        Exit Function
    End If
    r = Mid$(s, 1, n)
    p = StrPtr(r)
    For i = 0 To n - 1
        c = p[i]
        If c >= Asc("A") And c <= Asc("Z") Then p[i] = c + 32
    Next
    Lower$ = r
End Function

Dim a As String
Dim b As String
a = "Foo"
b = "FOO"
If Lower$(a) = Lower$(b) Then
    ExitProcess(1)
End If
ExitProcess(0)
