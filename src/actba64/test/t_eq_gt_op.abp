' Expect: 15
' Target: actba64
#console

' => は >=、=< は <= と同じ（ActiveBasic と同じ）。
Dim t As Long, r As Long
t = 5
If t=>5 Then r = r + 1
If t =< 5 Then r = r + 2
If t=>6 Then r = r + 100
If t=<4 Then r = r + 100
t = 0
Do
    t = t + 1
Loop Until t=>3
If t = 3 Then r = r + 4
r = r + (2 =< 3) * -8
ExitProcess(r)
