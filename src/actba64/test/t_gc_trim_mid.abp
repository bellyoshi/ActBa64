' Expect: 0
' Target: actba64
' Chr$ pressure + TrimCode + Mid$ arg — GC must keep Mid$ result
#console

Function TrimCode$(s As String) As String
    Dim t As String
    Dim c As String
    t = s
    While Len(t) > 0
        c = Left$(t, 1)
        If c <> " " And c <> Chr$(9) Then Exit While
        t = Mid$(t, 2)
    Wend
    While Len(t) > 0
        c = Right$(t, 1)
        If c <> " " And c <> Chr$(9) Then Exit While
        t = Left$(t, Len(t) - 1)
    Wend
    TrimCode$ = t
End Function

Dim i As Long
Dim r As String
Dim junk As String
Dim line As String
Dim t As String

line = "Language=ja"
junk = "pad"
For i = 1 To 5000
    junk = junk + Str$(i)
    If Len(junk) > 100 Then junk = Mid$(junk, 1, 50)
    t = TrimCode$(line)
    r = TrimCode$(Mid$(t, 10))
    If r <> "ja" Then
        Print "fail"
        Print r
        Print Str$(i)
        ExitProcess(1)
    End If
Next
Print "ok"
ExitProcess(0)
End
