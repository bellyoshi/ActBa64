' Expect: 7
' Target: actba64
' Type のフィールド（クラスのフィールドや入れ子の Type）を値として渡すと、変数と同じく先頭アドレスになる
' mciSendCommand(..., mop) のように ByVal VoidPtr の引数へ渡す
#console
Declare Function TLen Lib "kernel32" Alias "lstrlenA" (ByVal p As VoidPtr) As Long

Type T
    a As Long
    b As Long
End Type

Type O
    x As Long
    t As T
End Type

Class C
Public
    x As Long
    t As T
    Function Go() As Long
        t.a = &H636261
        Go = TLen(t)
    End Function
End Class

Dim c As C
Dim o As O
Dim v As T
Dim r As Long
r = 0
If c.Go() = 3 Then r = r + 1
o.t.a = &H6261
If TLen(o.t) = 2 Then r = r + 2
v.a = &H61
If TLen(v) = 1 Then r = r + 4
ExitProcess(r)
