' Expect: 0
' Target: actba64
' Str$ の引数が Double / Single なら実数の文字列（Print と同じ整形）。整数はこれまでどおり
#console
Dim d As Double
Dim f As Single
Dim i As Long
d = 0.1
f = 2.5
i = 7
If Str$(d) <> "0.1" Then ExitProcess(1)
If Str$(1.5) <> "1.5" Then ExitProcess(2)
If Str$(d*2) <> "0.2" Then ExitProcess(3)
If Str$(f) <> "2.5" Then ExitProcess(4)
If Str$(i) <> "7" Then ExitProcess(5)
If Str$(-3) <> "-3" Then ExitProcess(6)
If Str$(Int(d*25)) <> "2" Then ExitProcess(7)
ExitProcess(0)
