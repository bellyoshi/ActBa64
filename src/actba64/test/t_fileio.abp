' Expect: 0
' Target: actba64
#console
#include "..\FileIO.abp"

Dim path As String
Dim t As String

path = "bin/test_out/t_fileio_data.txt"

If WriteTextFile(path, "hello-fio") = 0 Then
    ExitProcess(1)
End If
If FileExists(path) = 0 Then
    ExitProcess(2)
End If
t = LoadTextFile$(path)
If t <> "hello-fio" Then
    ExitProcess(3)
End If
If Len(t) <> 9 Then
    ExitProcess(4)
End If
If WriteTextFile(path, "") = 0 Then
    ExitProcess(5)
End If
t = LoadTextFile$(path)
If t <> "" Then
    ExitProcess(6)
End If
If FileExists("bin/test_out/no_such_fileio_xyz.txt") <> 0 Then
    ExitProcess(7)
End If
ExitProcess(0)
