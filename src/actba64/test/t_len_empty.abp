' Expect: 0
' Target: actba64
' String 関数が "" を返したあと Len / 比較が壊れないこと
#console

Function EmptyRet$() As String
    EmptyRet$ = ""
End Function

Function EmptyExit$() As String
    EmptyExit$ = ""
    Exit Function
End Function

Function Filled$() As String
    Filled$ = "ab"
End Function

If Len(EmptyRet$()) <> 0 Then
    Print "fail empty len"
    ExitProcess(1)
End If
If Len(EmptyExit$()) <> 0 Then
    Print "fail empty exit len"
    ExitProcess(2)
End If
If EmptyRet$() <> "" Then
    Print "fail empty cmp"
    ExitProcess(3)
End If
If Len(Filled$()) <> 2 Then
    Print "fail filled len"
    ExitProcess(4)
End If
Print "ok"
ExitProcess(0)
End
