' Expect: 63
' Target: actba64
' 仮引数の DWordPtr（TypeDef の *DWord）に添字で書く。実数の右辺は Long / Word / Byte の要素へ切り捨てて入れる
#console
Dim k[3, 1] As Long
Dim w(3) As Word
Dim b(3) As Byte
Dim d As Double
Dim r As Long
Sub Fill(ByVal s As String, ByVal a As DWordPtr)
    Dim i As Long
    For i = 0 To 7
        a[i] = Val(Mid$(s, i + 1, 1))
    Next
End Sub
r = 0
Fill("00100111", k)
If k[1, 0] = 1 And k[1, 1] = 0 And k[2, 1] = 1 And k[3, 0] = 1 Then r = r Or 1
d = 5.7
k[0, 0] = d
If k[0, 0] = 5 Then r = r Or 2
k(0, 1) = d
If k(0, 1) = 5 Then r = r Or 4
w(1) = d
If w(1) = 5 Then r = r Or 8
b(1) = d
If b(1) = 5 Then r = r Or 16
Dim p As *Long
p = VarPtr(k)
p[2] = d
If k[1, 0] = 5 Then r = r Or 32
ExitProcess(r)
