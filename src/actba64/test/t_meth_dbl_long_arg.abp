' Expect: 0
' Target: actba64
' Double の式を Long の仮引数へ渡すと、代入と同じく 0 方向へ切り捨てて渡す
' （p->M / obj.M / This なしの M / New K(...) のどれでも。以前は 0 やビット列のまま渡っていた）
#console
Class K
Public
    v As Long
    Sub K(i As Long)
        v = i
    End Sub
    Sub SetV(i As Long)
        v = i
    End Sub
    Sub SetSelf(d As Double)
        SetV(d * 2)
    End Sub
End Class
Dim n As Double, p As *K, q As K
n = 2
p = New K(n + 0.9)
If p->v <> 2 Then ExitProcess(1)
p->SetV(n - 1)
If p->v <> 1 Then ExitProcess(2)
q.SetV(n - 4.7)
If q.v <> -2 Then ExitProcess(3)
q.SetSelf(1.75)
If q.v <> 3 Then ExitProcess(4)
p->SetV(7)
If p->v <> 7 Then ExitProcess(5)
ExitProcess(0)
