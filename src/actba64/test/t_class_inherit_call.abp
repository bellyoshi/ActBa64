' Expect: 7
' Target: actba64
#console

' 継承元で定義した（仮想でない）メソッドを、子クラスのオブジェクトと This から呼ぶ。

Class Base
    Public
    b As Long
    Sub AddB(n As Long)
        b = b + n
    End Sub
End Class
Class Kid
    Inherits Base
Public
    Sub Go()
        This.AddB(2)
    End Sub
End Class
Dim k As Kid
k.AddB(5)
k.Go()
ExitProcess(k.b)
