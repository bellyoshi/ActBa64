' Expect: 42
' Target: actba64
#console
Dim a As Long
Dim b As Long
Dim c As Long

' / \ Mod
a = 17 / 3
b = 17 \ 3
c = 17 Mod 5
If a <> 5 Then ExitProcess(1)
If b <> 5 Then ExitProcess(2)
If c <> 2 Then ExitProcess(3)

' << >> ^
If (1 << 4) <> 16 Then ExitProcess(4)
If (32 >> 2) <> 8 Then ExitProcess(5)
If (2 ^ 5) <> 32 Then ExitProcess(6)
If (-2 ^ 3) <> -8 Then ExitProcess(7)

' Xor Not
If (7 Xor 3) <> 4 Then ExitProcess(8)
If (Not 0) <> -1 Then ExitProcess(9)
If (Not -1) <> 0 Then ExitProcess(10)

' >< と関係演算の値（真=-1）
If (3 >< 4) <> -1 Then ExitProcess(11)
If (3 <> 3) <> 0 Then ExitProcess(12)
a = (2 < 5)
If a <> -1 Then ExitProcess(13)

' 優先: * / 同列、And より比較が上
If (1 + 2 * 3) <> 7 Then ExitProcess(14)
If Not (1 = 0) And (2 = 2) Then
    ' ok
Else
    ExitProcess(15)
End If

ExitProcess(42)
