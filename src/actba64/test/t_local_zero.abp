' Expect: 15
' Target: actba64
' ローカルの Type と配列は Dim で 0 になる（ActiveBasic と同じ）。前の呼び出しのスタックの残りが入らない
#console
Type P
    a As Long
    b As VoidPtr
End Type

Sub Dirty()
    Dim z[600] As Byte
    FillMemory(VarPtr(z[0]), 600, &HCC)
End Sub

Function Check() As Long
    Dim ofn As OPENFILENAME
    Dim b[300] As Byte
    Dim l[9] As Long
    Dim ps[3] As P
    Dim r As Long
    r = 0
    If ofn.Flags = 0 And ofn.lpfnHook = 0 And ofn.hInstance = 0 And ofn.lpTemplateName = 0 Then r = r + 1
    If b[0] = 0 And b[150] = 0 And b[300] = 0 Then r = r + 2
    If l[0] = 0 And l[9] = 0 Then r = r + 4
    If ps[3].a = 0 And ps[3].b = 0 Then r = r + 8
    Check = r
End Function

Dirty()
ExitProcess(Check())
