' Expect: 7
' Target: actba64
' Dim x As DWordPtr / WordPtr は *DWord / *Word と同じ（x[i] で要素を読む）。RAND_MAX
#console
Dim d[3] As DWord
Dim w[3] As Word
Dim pd As DWordPtr
Dim pw As WordPtr
Dim t As Long, r As Long
d[2] = 1
w[2] = 2
pd = VarPtr(d)
pw = VarPtr(w)
t = pd[2]
r = t + pw[2]
pd[3] = 4
r = r + d[3]
If RAND_MAX <> 32767 Then r = 0
ExitProcess(r)
