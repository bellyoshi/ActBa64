' Expect: 0
' Target: actba64
' Declare ... cdecl は呼び出し側が引数を片付ける（-actba32。x64 は同じ呼び方）
' 何十万回も呼んでスタックがずれないこと、可変個引数の結果
#console
Declare Function wsprintfX cdecl Lib "user32.dll" Alias "wsprintfA" (lpText As BytePtr, lpFormat As BytePtr, ...) As Long

Function Run() As Long
    Dim buf[63] As Byte
    Dim i As Long
    Dim n As Long
    Run = 0
    For i = 1 To 400000
        n = wsprintfX(buf, "%d-%d", i, 7)
    Next
    If lstrcmp(buf, "400000-7") <> 0 Then Run = 1
    If n <> 8 Then Run = 2
    wsprintfX(buf, "%s/%d/%d", "ab", 3, 4)
    If lstrcmp(buf, "ab/3/4") <> 0 Then Run = 3
End Function

ExitProcess(Run())
