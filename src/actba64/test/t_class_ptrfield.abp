' Expect: 4421
' Target: actba64
#console
' メソッドの中で *Class のフィールドを使う: p->M()、Virtual の s->M()、継承したフィールド、Delete p。
' フィールドの型の印は *Byte と同じなので、クラスは ClassPtrField の表から引く。

Dim g_dtor As Long

Class Inner
Public
    v As Long
    Sub Inner()
        v = 41
    End Sub
    Sub ~Inner()
        g_dtor = g_dtor + 1
    End Sub
    Function Value() As Long
        Value = v + 1
    End Function
    Sub SetV(x As Long)
        v = x
    End Sub
End Class

Class Shape
Public
    Virtual Function Which() As Long
        Which = 1
    End Function
End Class

Class Circle
    Inherits Shape
Public
    Override Function Which() As Long
        Which = 2
    End Function
End Class

Class Outer
Public
    p As *Inner
    s As *Shape
    Sub Outer()
        p = New Inner()
        s = New Circle()
    End Sub
    ' 引数の中の p->Value() も、受け手の p も、フィールドの値（ポインタ）を使う
    Function F() As Long
        p->SetV(p->Value() + 1)
        F = p->Value() * 10 + s->Which()
    End Function
    Sub Drop()
        Delete p
        p = 0
    End Sub
End Class

Class OuterKid
    Inherits Outer
Public
    Function G() As Long
        G = p->Value()
    End Function
End Class

Dim o As OuterKid
Dim r As Long
r = o.F() * 10                      ' 4420
If o.G() <> 44 Then r = r + 100
o.Drop()
r = r + g_dtor                      ' 1
ExitProcess(r)
