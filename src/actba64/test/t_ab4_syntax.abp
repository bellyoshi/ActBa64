' Expect: 0
' Target: actba64
' AB 4 の書き方: Else If、文末の ;、ExitDo / ExitFor、Debug、x As T * y（As は x だけ）、
' Double As Long の値の変換、配列の初期化子（DWord / Word / Byte / BytePtr、最後の ,）、手続きの中の Const
#console

Function Pick(a As Long) As Long
    If a = 1 Then
        Pick = 10
    Else If a = 2 then
        Pick = 20
    else
        Pick = 30
    EndIf
End Function

Function Table(i As Long) As Long
    Const TBL_N = 3
    Dim t[TBL_N] = [
        100, /* 0 */
        200,
        300,
        400,
    ] As DWord
    Table = t[i] + TBL_N
End Function

Dim i As Long
i = 1;
If Pick(1) + Pick(2) + Pick(3) <> 60 Then ExitProcess(1)

Do
    i = i + 1
    If i >= 5 Then ExitDo
Loop
If i <> 5 Then ExitProcess(2)
For i = 0 To 9
    If i = 3 Then ExitFor
Next
If i <> 3 Then ExitProcess(3)

Debug

Dim o As DWord, s As DWord, x As Double
o = 5: s = 10
If (o As DWord * 10000) / s <> 5000 Then ExitProcess(4)
If ((o * 3) / s) As DWord <> 1 Then ExitProcess(5)
x = 2.75
If x As Long <> 2 Then ExitProcess(6)
If (o As Double) / 2 <> 2.5 Then ExitProcess(7)

Dim bt[3] As Byte
bt[2] = &HFE
If (bt[2] << 24) As Long >> 24 <> -2 Then ExitProcess(8)

If Table(3) <> 403 Then ExitProcess(9)
Dim w[2] = [1, 2, 3] As Word
Dim names[2] = ["a", "bb", "ccc",] As BytePtr
If w[2] <> 3 Or lstrlen(names[2]) <> 3 Then ExitProcess(10)
ExitProcess(0)
