' Expect: 0
' Target: actba64
' Option: -pAB2
' -pAB2: ByVal / ByRef を書かない引数は ByRef（AB2 の既定。Type も渡せる）。数値の後ろの # は Double の印
#console
Sub Split2(r As Double, d As Double, m As Double)
    d = Int(r)
    m = (r - d) * 60#
End Sub
Sub Keep(ByVal v As Long)
    v = 9
End Sub
Sub SetRect1(rc As RECT)
    rc.right = 4
End Sub
Dim r As Double
Dim d As Double
Dim m As Double
Dim v As Long
Dim rc As RECT
r = 1.5#
Split2(r, d, m)
If d <> 1# Then ExitProcess(1)
If m <> 30 Then ExitProcess(2)
v = 3
Keep(v)
If v <> 3 Then ExitProcess(3)
SetRect1(rc)
If rc.right <> 4 Then ExitProcess(4)
If 1 / 4# <> 0.25 Then ExitProcess(5)
If Str$(Len(Str$(2#))) <> "1" Then ExitProcess(6)
ExitProcess(0)
