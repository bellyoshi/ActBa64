' UDT メンバ As *Long の添字は 4 バイト要素
' Expect: 0
' Target: actba64
#console

Type OffTab
    offsets As *Long
End Type

Dim t As OffTab
Dim buf[3] As Long

buf[0] = 0
buf[1] = 0
buf[2] = 0
t.offsets = VarPtr(buf)
t.offsets[0] = 100
t.offsets[1] = 200

If buf[0] <> 100 Then
    ExitProcess(1)
End If
If buf[1] <> 200 Then
    ExitProcess(2)
End If
If t.offsets[0] <> 100 Then
    ExitProcess(3)
End If
If t.offsets[1] <> 200 Then
    ExitProcess(4)
End If
ExitProcess(0)
