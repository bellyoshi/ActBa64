' Expect: 0
' Target: actba64
' AB 4 の型まわり: 後ろの TypeDef / Enum、TypeDef 別名の値渡し、Const As 型、&H1&、
' Type のフィールド要素数の定数式、Type Align(n) Name、型名の大文字小文字、Char、EndType、Enum の , 、QWord
#console

' 後ろで TypeDef する型を Declare の仮引数に使う。別名の変数は値で渡る
Declare Function MulDivH Lib "kernel32" Alias "MulDiv" (a As MY_H, b As Long, c As Long) As Long
Declare Sub CopyAny Lib "kernel32" Alias "RtlMoveMemory" (ByRef d As Any, ByRef s As Any, n As Long)

Const CNT As Long = 3
Const BIG As DWord = &H10&
Const N_TITLE = 20

TypeDef MY_H = Long

Type RAW
    Version As Byte
    GameID[CNT] As Byte
    Title[N_TITLE - 1] As Byte
EndType

Type Align(1) PACKED
    id As Word
    status As Byte
End Type

Enum COLORS
    C_RED,
    C_GREEN,
    C_BLUE
End Enum

Function MakeColor() As COLORS2
    MakeColor = C2_B
End Function

Enum COLORS2
    C2_A = 5
    C2_B
End Enum

Dim h As MY_H
h = 6
If MulDivH(h, 2, 3) <> 4 Then ExitProcess(1)
If CNT + BIG <> 19 Then ExitProcess(2)
If SizeOf(RAW) <> 1 + 4 + 20 Then ExitProcess(3)
If SizeOf(PACKED) <> 3 Then ExitProcess(4)
If C_BLUE <> 3 Then ExitProcess(5)
If MakeColor() <> 6 Then ExitProcess(6)

' 型名は大文字小文字を区別しない
Dim r As Rect
r.left = 7
If r.Left <> 7 Then ExitProcess(7)

' 型の位置の Char は Byte。変数名の char はそのまま
Dim char As Char
char = 65
If char <> 65 Or SizeOf(Char) <> 1 Then ExitProcess(8)

' ByRef As Any はアドレスで渡す
Dim a As RAW, b As RAW, c As Long, d As Long
b.GameID[2] = 9
CopyAny(a, b, SizeOf(RAW))
c = 77
CopyAny(d, c, 4)
If a.GameID[2] <> 9 Or d <> 77 Then ExitProcess(9)

' QWord / Int64 は 32bit として読む（警告）
Dim q As QWord
q = 5
If q * 2 <> 10 Then ExitProcess(10)
ExitProcess(0)
