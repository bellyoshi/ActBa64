' Expect: 0
' Target: actba64
' Skip32: 1
#console
' Log（自然対数・IEEE Double）
Dim v As Double
Dim e As Double

v = Log(1)
If v < 0 - 0.01 Then ExitProcess(1)
If v > 0.01 Then ExitProcess(2)

e = MathE()
v = Log(e)
If v < 0.95 Then ExitProcess(3)
If v > 1.05 Then ExitProcess(4)

v = Log(2)
If v < 0.66 Then ExitProcess(5)
If v > 0.73 Then ExitProcess(6)

v = Log(0)
If v <> 0 Then ExitProcess(7)
v = Log(0 - 1)
If v <> 0 Then ExitProcess(8)

ExitProcess(0)
