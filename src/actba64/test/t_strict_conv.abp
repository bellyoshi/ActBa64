' Expect: 65
' Target: actba64
' #strict: Long->Byte, String->VoidPtr, VoidPtr->Long
#console
#strict

Function SrcLong() As Long
    SrcLong = 65
End Function

Function AsByte() As Byte
    AsByte = SrcLong()
End Function

Sub TakePtr(p As VoidPtr)
End Sub

Sub TakeLong(n As Long)
End Sub

Dim s As String
s = "ab"
TakePtr(s)
TakeLong(VarPtr(s))
memcpy(s, VarPtr(s), 1)
ExitProcess(AsByte())
