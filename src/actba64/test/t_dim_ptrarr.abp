' Expect: 0
' Target: actba64
' Dim name[n] = [ ... ] As *Byte は C 文字列のポインタ配列。0 は NULL。
#console
Dim Q[2] = ["ab", 0] As *Byte
Dim R[3] = [
"ab",
"cd",
0] As *Byte
Dim longQ[1] = ["0123456789012345678901234567890123456789012345678901234567890123456789"] As *Byte
If Q[1] <> 0 Then ExitProcess(1)
If lstrcmp(Q[0], "ab") <> 0 Then ExitProcess(2)
If R[2] <> 0 Then ExitProcess(3)
If lstrcmp(R[0], "ab") <> 0 Then ExitProcess(4)
If lstrcmp(R[1], "cd") <> 0 Then ExitProcess(5)
If lstrcmp(longQ[0], "0123456789012345678901234567890123456789012345678901234567890123456789") <> 0 Then ExitProcess(6)
Dim many[9] = ["a", "b", "c", "d", "e", "f", "g", "h", "i", 0] As *Byte
If lstrcmp(many[8], "i") <> 0 Then ExitProcess(7)
If many[9] <> 0 Then ExitProcess(8)
ExitProcess(0)
