' Expect: 0
' Target: actba64
#console
#include "../FileIO.abp"

Dim path As String
Dim n As Long
Dim b As Byte
Dim d As Single
Dim s As String
Dim bits As Long

path = "bin/test_out/t_input_hash_types.txt"
If WriteTextFile(path, "-123,+42,7,hello") = 0 Then
    ExitProcess(9)
End If

Open path For Input As 1
Input #1, n, b, d, s
Close 1

If n <> -123 Then
    ExitProcess(1)
End If
If b <> 42 Then
    ExitProcess(2)
End If
memcpy(VarPtr(bits), VarPtr(d), 4)
If bits <> &H40E00000 Then
    ExitProcess(3)
End If
If s <> "hello" Then
    ExitProcess(4)
End If
ExitProcess(0)
