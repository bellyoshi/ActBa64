' Expect: 42
' Target: actba64
' 実数リテラルは Double の精度で読む（小数部 9 桁で打ち切らない）。実行時の計算結果と比べる。
#console
Dim d As Double
If Not (0.0000000001 > 0) Then ExitProcess(1)
If Not (3.141592653589793 - 3.14159265 > 0) Then ExitProcess(2)
If 0.1 <> 1 / 10 Then ExitProcess(3)
If 0.3 <> 3 / 10 Then ExitProcess(4)
If 0.1 + 0.2 <> 0.30000000000000004 Then ExitProcess(5)
If 0.000000000931322574615478515625 <> 1 / 1073741824 Then ExitProcess(6)
d = 0.0000000001
If d * 10000000000.0 <> 1 Then ExitProcess(7)
If 0.1 * 3 = 0.3 Then ExitProcess(8)
ExitProcess(42)
End
