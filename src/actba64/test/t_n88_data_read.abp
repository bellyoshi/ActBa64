' Expect: 0
' Target: actba64
' Option: -pN88
' -pN88: READ / DATA。DATA は READ より前でも後ろでもよい。&H / &h、文字列、READ A,B$ の並び
10 DATA 0,&HFF,&h3c
20 S$=""
30 FOR I=1 TO 3
40   READ M
50   S$=S$+CHR$ (M)
60 NEXT I
70 IF LEN(S$)<>3 THEN EXITPROCESS 1
80 IF ASC(MID$(S$,2,1))<>255 THEN EXITPROCESS 2
90 IF ASC(MID$(S$,3,1))<>60 THEN EXITPROCESS 3
100 READ A,B$
110 IF A<>-5 THEN EXITPROCESS 4
120 IF B$<>"xy" THEN EXITPROCESS 5
130 READ C
140 IF C<>0 THEN EXITPROCESS 6
150 EXITPROCESS 0
160 DATA -5,"xy"
