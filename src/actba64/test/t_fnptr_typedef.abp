' Expect: 1
' Target: actba64
' TypeDef した *Function / *Sub
#console
TypeDef PADD = *Function(a As Long, b As Long) As Long
TypeDef PSHOW = *Sub(n As Long)

Function Add(a As Long, b As Long) As Long
    Add = a + b
End Function

Sub Show(n As Long)
    ' no-op; 間接呼び出しが到達すれば成功
End Sub

Dim p As PADD
Dim s As PSHOW
Dim r As Long
p = AddressOf(Add)
s = AddressOf(Show)
r = p(10, 20)
s(r)
If r <> 30 Then
    ExitProcess(0)
End If
ExitProcess(1)
