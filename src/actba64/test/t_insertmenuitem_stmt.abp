' Expect: 0
' Target: actba64
' AB3 の RAD が出す括弧なしの InsertMenuItem 文（InsMenu と同じ）。括弧付きは Win32 API のまま
#console
Declare Function GetMenuItemCount Lib "user32.dll" (ByVal hMenu As HMENU) As Long

Dim h As HMENU
Dim subm As HMENU
Dim mii As MENUITEMINFO
Dim n As Long

h = CreateMenu()
If h = 0 Then ExitProcess(1)
subm = CreatePopupMenu()
If subm = 0 Then ExitProcess(2)
InsertMenuItem subm,0,MF_BYPOSITION,Ex"開く(&O)",100,0,0
InsertMenuItem subm,0,MF_BYPOSITION
InsertMenuItem h,0,MF_BYPOSITION,Ex"ファイル(&F)",0,subm,0
If GetMenuItemCount(subm) <> 2 Then ExitProcess(10 + GetMenuItemCount(subm))
If GetMenuItemCount(h) <> 1 Then ExitProcess(20 + GetMenuItemCount(h))
FillMemory(VarPtr(mii), Len(mii), 0)
mii.cbSize = Len(mii)
mii.fMask = MIIM_STRING Or MIIM_ID
mii.wID = 200
mii.dwTypeData = "編集"
InsertMenuItem(h, 1, TRUE, mii)
n = GetMenuItemCount(h)
If n <> 2 Then ExitProcess(30 + n)
ExitProcess(0)
