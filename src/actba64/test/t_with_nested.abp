' Expect: 119
' Target: actba64
Type Pair
    a As Long
    b As Long
End Type

Dim outer As Pair
Dim inner As Pair
outer.a = 1
outer.b = 2
inner.a = 10
inner.b = 20

With outer
    .a = .a + 1
    With inner
        .b = .b + 79
    End With
    .b = .b + 20
End With

ExitProcess(outer.a * 10 + inner.b)
