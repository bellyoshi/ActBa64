#console
#include "..\CharUtils.abp"
#include "..\StrUtils.abp"
Function LCase$(s As String) As String
    Dim p As *Byte
    Dim i As Long
    Dim n As Long
    Dim c As Long
    Dim r As String
    n = Len(s)
    If n = 0 Then
        LCase$ = ""
        Exit Function
    End If
    r = Mid$(s, 1, n)
    p = StrPtr(r)
    For i = 0 To n - 1
        c = p[i]
        If c >= Asc("A") And c <= Asc("Z") Then p[i] = c + 32
    Next
    LCase$ = r
End Function
If InStr(1, "foo#bar", "#") <> 4 Then ExitProcess(3)
ExitProcess(Len(LCase$("Ab")))
End
