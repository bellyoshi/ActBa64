' Target: actba64
' GUI: SetMenu + MainWndProc 相当の WM_SIZE / WM_PAINT
#USEWINDOW=1

Const IDM_FILENEW=1001

Dim hMenu_M_MAIN As HMENU
hMenu_M_MAIN=CreateMenu()
Dim hMenu_M_MAIN_0 As HMENU
hMenu_M_MAIN_0=CreatePopupMenu()
InsMenu hMenu_M_MAIN_0,0,MF_BYPOSITION,Ex"New(&N)",IDM_FILENEW,0,0
InsMenu hMenu_M_MAIN,0,MF_BYPOSITION,Ex"File(&F)",0,hMenu_M_MAIN_0,0

Function WndProc(hWnd As HWND, message As DWord, wParam As WPARAM, lParam As LPARAM) As DWord
    Select Case message
        Case WM_PAINT
            Dim ps As PAINTSTRUCT
            Dim hDC As HDC
            hDC = BeginPaint(hWnd, ps)
            EndPaint(hWnd, ps)
        Case WM_SIZE
            Dim rc As RECT
            GetClientRect(hWnd, rc)
            InvalidateRect(hWnd, ByVal 0, TRUE)
        Case WM_SETFOCUS
            CreateCaret(hWnd, NULL, 2, 16)
        Case WM_KILLFOCUS
            DestroyCaret()
        Case WM_DESTROY
            PostQuitMessage(0)
            WndProc = 0
            Exit Function
    End Select
    Select Case message
        Case WM_CREATE
            SetMenu(hWnd, hMenu_M_MAIN)
            SetWindowText(hWnd, "editor - sizepaint")
        Case Else
            WndProc = DefWindowProc(hWnd, message, wParam, lParam)
            Exit Function
    End Select
    WndProc = 0
End Function

Dim wc As WNDCLASSEX
FillMemory(VarPtr(wc), Len(wc), 0)
wc.cbSize = Len(wc)
wc.hInstance = GetModuleHandle(0)
wc.style = CS_HREDRAW Or CS_VREDRAW
wc.hCursor = LoadCursor(NULL, MAKEINTRESOURCE(IDC_ARROW))
wc.lpszClassName = "NORMAL0"
wc.lpfnWndProc = AddressOf(WndProc)
wc.hbrBackground = CreateSolidBrush(GetSysColor(COLOR_3DFACE))
RegisterClassEx(wc)

CreateWindowEx(&H00000000, "NORMAL0", "editor", &H10cf0000, -2147483648, -2147483648, 495, 367, 0, 0, GetModuleHandle(0), 0)

Dim msg As MSG
Dim r As Long
Do
    r = GetMessage(msg, 0, 0, 0)
    If r = 0 Then Exit Do
    If r = -1 Then Exit Do
    TranslateMessage(msg)
    DispatchMessage(msg)
Loop
End
