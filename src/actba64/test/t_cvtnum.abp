' Expect: 0
' Target: actba64
#console
' CDbl / CSng / CInt（CvtNum.abp）

Dim d As Double
Dim s As Single
Dim n As Long
Dim bits As Long
Dim got As Long

d = CDbl(1.25)
If d < 1.2 Or d > 1.3 Then ExitProcess(1)
n = 4
d = CDbl(n)
If d <> 4 Then ExitProcess(2)

s = CSng(0.5)
memcpy(VarPtr(bits), VarPtr(s), 4)
If bits <> &H3F000000 Then ExitProcess(3)
s = CSng(1.5)
d = s
If d < 1.4 Or d > 1.6 Then ExitProcess(4)
n = 2
s = CSng(n)
d = s
If d < 1.9 Or d > 2.1 Then ExitProcess(5)
s = CSng(0 - 1.5)
d = s
If d > 0 - 1.4 Or d < 0 - 1.6 Then ExitProcess(6)

got = CInt(1.4)
If got <> 1 Then ExitProcess(7)
got = CInt(1.5)
If got <> 2 Then ExitProcess(8)
got = CInt(2.5)
If got <> 3 Then ExitProcess(9)
got = CInt(0 - 1.4)
If got <> 0 - 1 Then ExitProcess(10)
got = CInt(0 - 1.5)
If got <> 0 - 2 Then ExitProcess(11)
got = CInt(0 - 2.5)
If got <> 0 - 3 Then ExitProcess(12)
got = CInt(0.4)
If got <> 0 Then ExitProcess(13)
got = CInt(0 - 0.4)
If got <> 0 Then ExitProcess(14)
got = CInt(3)
If got <> 3 Then ExitProcess(15)

ExitProcess(0)
