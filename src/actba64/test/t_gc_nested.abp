' 描画経路に近い入れ子: While 内 Mid$ + バイト走査 For（確保なし）のあと
' 元の行が残ること。Expect: 0
' Target: actba64
#console

Function LowerCopy$(s As String) As String
    Dim n As Long
    Dim i As Long
    Dim p As *Byte
    Dim ch As Byte
    Dim r As String

    LowerCopy$ = ""
    n = Len(s)
    If n <= 0 Then Exit Function
    r = Mid$(s, 1, n)
    p = StrPtr(r)
    For i = 0 To n - 1
        ch = p[i]
        If ch >= 65 And ch <= 90 Then
            ch = ch + 32
        End If
        p[i] = ch
    Next
    LowerCopy$ = r
End Function

Function DrawLine(lineStr As String) As Long
    Dim n As Long
    Dim i As Long
    Dim word As String
    Dim p As *Byte
    Dim tmp As Long
    Dim bp As *Byte
    Dim b As Long

    DrawLine = 0
    n = Len(lineStr)
    If n <= 0 Then Exit Function
    p = StrPtr(lineStr)
    bp = VarPtr(tmp)
    i = 0
    While i < n
        bp[0] = p[i]
        b = tmp And &HFF
        word = Mid$(lineStr, i + 1, 1)
        word = LowerCopy$(word)
        If Len(word) <> 1 Then
            DrawLine = -1
            Exit Function
        End If
        i = i + 1
    Wend
    If Len(lineStr) <> n Then
        DrawLine = -2
        Exit Function
    End If
    bp[0] = p[0]
    DrawLine = tmp And &HFF
End Function

Dim keep As String
Dim line As String
Dim i As Long
Dim r As Long

keep = "ABC"
line = "Hello"
i = 0
While i < 40
    r = DrawLine(line)
    If r <> 72 Then
        Print "fail draw"
        ExitProcess(1)
    End If
    If line <> "Hello" Then
        Print "fail line"
        ExitProcess(2)
    End If
    If keep <> "ABC" Then
        Print "fail keep"
        ExitProcess(3)
    End If
    i = i + 1
Wend
If LowerCopy$("AbC") <> "abc" Then
    Print "fail lower"
    ExitProcess(4)
End If
Print "ok"
ExitProcess(0)
End
