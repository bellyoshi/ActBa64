' Expect: 0
' Target: actba64
' Mid$ 2-arg + nested For Asc (UiLang_IsValidCode pattern) under GC pressure
#console

Function IsValid(code As String) As Long
    Dim i As Long
    Dim n As Long
    Dim a As Long
    IsValid = 0
    n = Len(code)
    If n < 1 Then Exit Function
    For i = 1 To n
        a = Asc(Mid$(code, i, 1))
        If a < 97 Then Exit Function
        If a > 122 Then Exit Function
    Next
    IsValid = 1
End Function

Function Extract2$(line As String) As String
    Dim code As String
    Extract2$ = ""
    code = Mid$(line, 10)
    If IsValid(code) = 0 Then Exit Function
    Extract2$ = code
End Function

Function Extract3$(line As String) As String
    Dim code As String
    Dim n As Long
    Extract3$ = ""
    n = Len(line)
    code = Mid$(line, 10, n - 9)
    If IsValid(code) = 0 Then Exit Function
    Extract3$ = code
End Function

Dim i As Long
Dim r As String
Dim junk As String

junk = "pad"
For i = 1 To 3000
    junk = junk + Str$(i)
    If Len(junk) > 80 Then junk = Mid$(junk, 1, 40)
    r = Mid$("Language=ja", 10)
    If r <> "ja" Then
        Print "fail mid2"
        ExitProcess(1)
    End If
    r = Extract2$("Language=ja")
    If r <> "ja" Then
        Print "fail ex2"
        ExitProcess(2)
    End If
    r = Extract3$("Language=ja")
    If r <> "ja" Then
        Print "fail ex3"
        ExitProcess(3)
    End If
Next
Print "ok"
ExitProcess(0)
End
