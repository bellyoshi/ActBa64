' Expect: 6
' Target: actba64
' FizzBuzz 1..100: FizzBuzz 回数 (15 の倍数) = 6
#console

Function IsMod0(n As Long, m As Long) As Long
    Dim r As Long
    r = n
    While r >= m
        r = r - m
    Wend
    If r = 0 Then
        IsMod0 = 1
    Else
        IsMod0 = 0
    End If
End Function

Dim i As Long
Dim n As Long
Dim r As Long
n = 0
For i = 1 To 100
    r = i
    If IsMod0(r, 15) <> 0 Then
        n = n + 1
    End If
Next
' Str$ check: "6" has length 1
If Len(Str$(n)) <> 1 Then
    ExitProcess(0)
End If
ExitProcess(n)
