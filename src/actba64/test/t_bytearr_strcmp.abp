' Expect: 0
' Target: actba64
' Byte 配列と文字列の比較は先頭アドレスの C 文字列として lstrcmp（BmpViewer の If FileName="" Then）
#console
Type FN
    s[15] As Byte
End Type

Dim g[259] As Byte
Dim u As FN

Function LocalEmpty() As Long
    Dim b[9] As Byte
    LocalEmpty = 0
    If b = "" Then LocalEmpty = 1
End Function

If g <> "" Then ExitProcess(1)
If Not (g = "") Then ExitProcess(2)
lstrcpy(g, "abc")
If g <> "abc" Then ExitProcess(3)
If g = "" Then ExitProcess(4)
If LocalEmpty() <> 1 Then ExitProcess(5)
If u.s <> "" Then ExitProcess(6)
lstrcpy(u.s, "xy")
If u.s <> "xy" Then ExitProcess(7)
ExitProcess(0)
