' Expect: 1
' Target: actba64
' #resource で埋め込んだ RCDATA(1) を FindResource で取得
#console
Declare Function GetModuleHandleA Lib "kernel32" (lpModuleName As Long) As Long
Declare Function FindResourceA Lib "kernel32" (hModule As Long, lpName As Long, lpType As Long) As Long

#resource "fixtures\t_resource.bin"

Const RT_RCDATA = 10

Dim hMod As Long
Dim hRes As Long
hMod = GetModuleHandleA(0)
hRes = FindResourceA(hMod, MAKEINTRESOURCE(1), MAKEINTRESOURCE(RT_RCDATA))
If hRes = 0 Then
    ExitProcess(0)
End If
ExitProcess(1)
