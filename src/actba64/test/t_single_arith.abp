' Expect: 0
' Target: actba64
' Single の + - * / と符号反転（Double で計算して Single へ戻す）。Single どうしの / は Single
#console
Dim A As Single, B As Single, C As Single, L As Long, d As Double
A = 80
B = 60
L = A + B
If L <> 140 Then ExitProcess(1)
L = A - B
If L <> 20 Then ExitProcess(2)
L = A * B
If L <> 4800 Then ExitProcess(3)
C = A / B * 3
L = C
If L <> 4 Then ExitProcess(4)
L = -A
If L <> -80 Then ExitProcess(5)
d = A / 8
If d <> 10 Then ExitProcess(6)
If StrS$(A / B) <> " 1.33333" And StrS$(A / B) <> "1.33333" Then ExitProcess(7)
ExitProcess(0)
