' Expect: 63
' Target: actba64
#console

' Double / Single の式を整数のメンバへ入れると整数へ変換する（ローカル Long と同じく切り捨て）。
' Single のメンバへ Single を入れるときはビットのまま。
Type MemDbl
    x As Long
    w As Word
    b As Byte
    f As Single
End Type
Dim p As POINTAPI
Dim r As RECT
Dim m As MemDbl
Dim pm As *MemDbl
Dim d As Double
Dim s As Single, s2 As Single
Dim ok As Long
r.right = 640
p.x = r.right / 2
If p.x = 320 Then ok = ok + 1
d = 198.75
p.y = d
If p.y = 198 Then ok = ok + 2
m.w = d * 2
If m.w = 397 Then ok = ok + 4
m.b = 7.9
If m.b = 7 Then ok = ok + 8
pm = VarPtr(m)
pm->x = 0.5 * 9
If m.x = 4 Then ok = ok + 16
s = 1.5
m.f = s
s2 = m.f
If s2 = s Then ok = ok + 32
ExitProcess(ok)
