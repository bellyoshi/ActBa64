' Expect: 31
' Target: actba64
' リストビューの LVCOLUMN / LVITEM の文字列（UTF-8）を SendDlgItemMessage でもワイドにして渡す。GetModuleFileName は UTF-8 で返す
#console
Declare Function TSendW Lib "user32.dll" Alias "SendMessageW" (ByVal hWnd As HWND, ByVal Msg As DWord, ByVal wParam As WPARAM, ByVal lParam As LPARAM) As LRESULT

Function WAt(p As *Byte, i As Long) As Long
    WAt = GetWord(p + i * 2)
End Function

Dim ic As INITCOMMONCONTROLSEX
Dim hp As HWND
Dim hl As HWND
Dim lc As LVCOLUMN
Dim li As LVITEM
Dim w[127] As Byte
Dim path[519] As Byte
Dim n As Long
Dim r As Long
r = 0
ic.dwSize = Len(ic)
ic.dwICC = 1
InitCommonControlsEx(ic)
hp = CreateWindowEx(0, "STATIC", "", 0, 0, 0, 300, 200, 0, 0, GetModuleHandle(0), 0)
hl = CreateWindowEx(0, "SysListView32", "", &H40000001, 0, 0, 300, 200, hp, 100 As HMENU, GetModuleHandle(0), 0)
lc.mask = 4 Or 2
lc.cx = 100
lc.pszText = "日本語"
SendDlgItemMessage(hp, 100, LVM_INSERTCOLUMN, 0, VarPtr(lc))
lc.mask = 4
lc.pszText = w
lc.cchTextMax = 60
TSendW(hl, &H105F, 0, VarPtr(lc) As LPARAM)
If WAt(w, 0) = &H65E5 And WAt(w, 1) = &H672C And WAt(w, 2) = &H8A9E And WAt(w, 3) = 0 Then r = r + 1
li.mask = 1
li.iItem = 0
li.pszText = "表"
SendDlgItemMessage(hp, 100, LVM_INSERTITEM, 0, VarPtr(li))
li.iSubItem = 0
li.pszText = w
li.cchTextMax = 60
TSendW(hl, &H1073, 0, VarPtr(li) As LPARAM)
If WAt(w, 0) = &H8868 And WAt(w, 1) = 0 Then r = r + 2
li.pszText = "abc"
SendMessage(hl, LVM_SETITEMTEXT, 0, VarPtr(li))
li.pszText = w
TSendW(hl, &H1073, 0, VarPtr(li) As LPARAM)
If WAt(w, 0) = &H61 And WAt(w, 2) = &H63 Then r = r + 4
n = GetModuleFileName(GetModuleHandle(0), path, 520)
If n = lstrlen(path) And n > 4 Then r = r + 8
If lstrcmpi(VarPtr(path[n - 4]), ".exe") = 0 Then r = r + 16
DestroyWindow(hp)
ExitProcess(r)
