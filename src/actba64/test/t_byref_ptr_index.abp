' Expect: 63
' Target: actba64
' ByRef のポインタ引数に添字を付けたとき、引数の場所ではなくポインタの指す先を使う
#console
Sub Walk(ByRef q As *Byte)
    q = VarPtr(q[300])
End Sub
Sub PutB(ByRef q As *Byte)
    q[2] = 77
End Sub
Function GetB(ByRef q As *Byte) As Long
    GetB = q[2]
End Function
Sub PutL(ByRef q As *Long)
    q[1] = 123456
End Sub
Function GetL(ByRef q As *Long) As Long
    GetL = q[1]
End Function
Function AddrL(ByRef q As *Long) As *Byte
    AddrL = VarPtr(q[2])
End Function
Dim t As *Byte, q As *Byte, pl As *Long, r As Long
t = calloc(400)
r = 0
q = t
Walk(q)
If q - t = 300 Then r = r Or 1
q = t
PutB(q)
If t[2] = 77 Then r = r Or 2
If GetB(q) = 77 Then r = r Or 4
pl = t As *Long
PutL(pl)
If GetDWord(t + 4) = 123456 Then r = r Or 8
If GetL(pl) = 123456 Then r = r Or 16
If AddrL(pl) - t = 8 Then r = r Or 32
free(t)
ExitProcess(r)
