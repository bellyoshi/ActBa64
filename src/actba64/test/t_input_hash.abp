' Expect: 0
' Target: actba64
#console
#include "../FileIO.abp"

Dim path As String
Dim s As String
Dim n As Long
Dim m As Long

path = "bin/test_out/t_input_hash.txt"
If WriteTextFile(path, "hello,42,7") = 0 Then
    ExitProcess(9)
End If

Open path For Input As 1
Input #1, s
If s <> "hello" Then
    ExitProcess(1)
End If
Input #1, n
If n <> 42 Then
    ExitProcess(2)
End If
Input #1, m
If m <> 7 Then
    ExitProcess(3)
End If
Close 1
ExitProcess(0)
