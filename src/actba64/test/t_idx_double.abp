' Expect: 63
' Target: actba64
' Double / Single の添字は Long に変換する（(i + j) / 2 など）
#console
Dim a[5] As Byte
Dim m[5, 5] As Byte
Dim b[5] As Long
Dim i As Long, j As Long, d As Double, s As Single, r As Long
Dim pb As *Long
i = 2: j = 4: d = 3: s = 4
a[(i + j) / 2] = 1
m[(i + j) / 2, (i + j) / 2] = 2
b[d] = 4
b[s] = 8
pb = VarPtr(b[0])
pb[(i + j) / 2] = pb[(i + j) / 2] + 16
r = a[3] + m[3, 3] + b[3] + b[4]
If a[d] = 1 And m[d, s - 1] = 2 Then r = r + 32
ExitProcess(r)
