' Expect: 0
' Target: actba64
#console

#include "..\..\projecteditor\EditorApi.sbp"
#include "..\..\projecteditor\EncodingUtil.sbp"

Dim wide As *Byte
Dim chars As Long
Dim text As String
Dim sz As SIZE
Dim hdc As HDC

wide = Enc_Utf8ToWide("abc", chars)
If wide = 0 Then ExitProcess(1)
If chars <> 3 Then ExitProcess(2)
If wide[0] <> 97 Or wide[1] <> 0 Then ExitProcess(3)
free(wide)

wide = Enc_Utf8ToWide("日本語", chars)
If wide = 0 Then ExitProcess(4)
If chars <> 3 Then ExitProcess(5)
text = Enc_WideToUtf8$(wide, chars)
free(wide)
If text <> "日本語" Then ExitProcess(6)

hdc = CreateCompatibleDC(0)
If hdc = 0 Then ExitProcess(7)
If Enc_TextExtentUtf8(hdc, "abc", sz) = 0 Then ExitProcess(8)
If sz.cx <= 0 Then ExitProcess(9)
DeleteDC(hdc)

ExitProcess(0)
