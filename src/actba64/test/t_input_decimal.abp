' Expect: 0
' Target: actba64
' Skip32: 1
' Double IEEE 比較は 32bit では SSE REX 未対応（t_double* と同様）
' Stdin: 3.14
' Stdin: 2.5
' Stdin: -0.5
#console

Dim s As Single
Dim d As Double
Dim n As Long
Dim bits As Long

Input s
memcpy(VarPtr(bits), VarPtr(s), 4)
' 3.14f ≈ 0x4048F5C3（IEEE）。milli 変換の近似も 0x4048xxxx 帯
If bits < &H40480000 Then ExitProcess(1)
If bits > &H4049FFFF Then ExitProcess(1)

Input d
' Double は IEEE754（2.5）
If d < 2.4 Or d > 2.6 Then ExitProcess(2)

Input n
' Long は小数点以前のみ（-0.5 → 0）
If n <> 0 Then ExitProcess(3)

ExitProcess(0)
End
