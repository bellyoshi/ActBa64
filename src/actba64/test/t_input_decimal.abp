' Expect: 0
' Target: actba64
' Stdin: 3.14
' Stdin: 2.5
' Stdin: -0.5
#console

Dim s As Single
Dim d As Double
Dim n As Long
Dim bits As Long

Input s
memcpy(VarPtr(bits), VarPtr(s), 4)
' 3.14f (milli=3140)
If bits <> &H40076C8B Then ExitProcess(1)

Input d
' Double は IEEE754（2.5）
If d < 2.4 Or d > 2.6 Then ExitProcess(2)

Input n
' Long は小数点以前のみ（-0.5 → 0）
If n <> 0 Then ExitProcess(3)

ExitProcess(0)
End
