' Expect: 15
' Target: actba64
' Function の As 型を省いたら Double（ActiveBasic の既定の型）。戻り値に代入しなければ 0
#console
Function NoRet()
End Function

Function Half(n As Long)
    Half = n / 2
End Function

Dim d As Double
Dim r As Long
r = 0
d = NoRet()
If d = 0 Then r = r + 1
d = Half(3)
If d = 1.5 Then r = r + 2
If Half(5) + 0.5 = 3 Then r = r + 4
If Half(4) = 2 Then r = r + 8
ExitProcess(r)
