' Expect: 0
' Target: actba64
' Skip32: 1
' String GC: 4096 個を超える文字列も GC の表に載る（以前は 4096 個を超えた分が表に載らず、二度と解放されなかった）。
' 手続きの中では回収しないので、手続きで 5000 個の一時文字列を作って数を見る。
' MAIN のループで回収したあと、表が縮み、生きている文字列（大域の配列）が壊れていないか見る
#console
Const N_KEEP = 300
Const N_TEMP = 5000
Dim keep(N_KEEP) As String

Function Fill() As Long
    Dim i As Long
    Dim t As String
    For i = 1 To N_KEEP
        keep(i) = "v" + Str$(i)
    Next
    For i = 1 To N_TEMP
        t = "x" + Str$(i)
    Next
    Fill = StrGcGetCount()
End Function

Function Check() As Long
    Dim i As Long
    Check = 0
    For i = 1 To N_KEEP
        If keep(i) <> "v" + Str$(i) Then Check = i
        If Check <> 0 Then Exit Function
    Next
End Function

Dim n As Long
Dim k As Long
Dim t As String
n = Fill()
If n < N_TEMP Then ExitProcess(1)
For k = 1 To 3
    t = "a" + Str$(k)
Next
If StrGcGetCount() > N_KEEP + 100 Then ExitProcess(2)
If Check() <> 0 Then ExitProcess(3)
ExitProcess(0)
