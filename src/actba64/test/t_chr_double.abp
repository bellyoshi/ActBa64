' Expect: 0
' Target: actba64
' Chr$ の引数が Double の式（Int(x) / 実数の変数）でも、その値の文字になる
#console
Dim d As Double
Dim s As String
d = 400
If Asc(Chr$(Int(d*2/256))) <> 3 Then ExitProcess(1)
d = 65
If Chr$(d) <> "A" Then ExitProcess(2)
s = Chr$(d*2 Mod 256)+Chr$(Int(d/10))
If Asc(Mid$(s,2,1)) <> 6 Then ExitProcess(3)
If Asc(Chr$(66)) <> 66 Then ExitProcess(4)
ExitProcess(0)
