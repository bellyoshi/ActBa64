' Expect: 0
' Target: actba64
' #strict: *Byte passed to *Word should warn but still convert
#console
#strict
Dim raw As *Byte
Dim wide As *Byte
Dim n As Long
raw = malloc(4)
wide = malloc(4)
raw[0] = 65
n = MultiByteToWideChar(932, 0, raw, 1, wide, 2)
If n <> 1 Then ExitProcess(1)
If wide[0] <> 65 Then ExitProcess(2)
If wide[1] <> 0 Then ExitProcess(3)
n = WideCharToMultiByte(65001, 0, wide, 1, 0, 0, 0, 0)
If n <> 1 Then ExitProcess(4)
n = WideCharToMultiByte(65001, 0, wide, 1, raw, 2, 0, 0)
If n <> 1 Then ExitProcess(5)
If raw[0] <> 65 Then ExitProcess(6)
ExitProcess(0)
