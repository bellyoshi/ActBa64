' Expect: 0
' Target: actba64
#console
#include "..\..\common\bool.abp"
#include "..\..\common\ByteCharUtils.abp"
#include "..\..\common\ByteStringUtils.abp"

Dim buf(15) As Byte
Dim s As String

lstrcpy(VarPtr(buf), "Hello")
If Not ByteStrEq("Hello", VarPtr(buf)) Then ExitProcess(1)
If ByteStrEq("hello", VarPtr(buf)) Then ExitProcess(2)
If Not ByteStrEqCI("hello", VarPtr(buf)) Then ExitProcess(3)
If Not ByteStrEqCI("HELLO", VarPtr(buf)) Then ExitProcess(4)
If ByteStrEqCI("Hell", VarPtr(buf)) Then ExitProcess(5)

s = "AbC"
lstrcpy(VarPtr(buf), "abc")
If ByteStrEq(s, VarPtr(buf)) Then ExitProcess(6)
If Not ByteStrEqCI(s, VarPtr(buf)) Then ExitProcess(7)

lstrcpy(VarPtr(buf), "HelloWorld")
If Not ByteStrStartsWith(VarPtr(buf), "Hello") Then ExitProcess(8)
If ByteStrStartsWith(VarPtr(buf), "Helo") Then ExitProcess(9)
If ByteStrStartsWith(VarPtr(buf), "hello") Then ExitProcess(10)
If Not ByteStrStartsWithCI(VarPtr(buf), "hello") Then ExitProcess(11)
If ByteStrStartsWith(VarPtr(buf), "HelloWorld!") Then ExitProcess(12)

ExitProcess(0)
