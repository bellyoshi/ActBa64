' Expect: 0
' Target: actba64
#console
#include "..\ByteCharUtils.abp"
#include "..\ByteStringUtils.abp"

Dim buf(15) As Byte
Dim s As String

lstrcpy(VarPtr(buf), "Hello")
If ByteStrEq("Hello", VarPtr(buf)) = 0 Then ExitProcess(1)
If ByteStrEq("hello", VarPtr(buf)) <> 0 Then ExitProcess(2)
If ByteStrEqCI("hello", VarPtr(buf)) = 0 Then ExitProcess(3)
If ByteStrEqCI("HELLO", VarPtr(buf)) = 0 Then ExitProcess(4)
If ByteStrEqCI("Hell", VarPtr(buf)) <> 0 Then ExitProcess(5)

s = "AbC"
lstrcpy(VarPtr(buf), "abc")
If ByteStrEq(s, VarPtr(buf)) <> 0 Then ExitProcess(6)
If ByteStrEqCI(s, VarPtr(buf)) = 0 Then ExitProcess(7)

lstrcpy(VarPtr(buf), "HelloWorld")
If ByteStrStartsWith(VarPtr(buf), "Hello") = 0 Then ExitProcess(8)
If ByteStrStartsWith(VarPtr(buf), "Helo") <> 0 Then ExitProcess(9)
If ByteStrStartsWith(VarPtr(buf), "hello") <> 0 Then ExitProcess(10)
If ByteStrStartsWithCI(VarPtr(buf), "hello") = 0 Then ExitProcess(11)
If ByteStrStartsWith(VarPtr(buf), "HelloWorld!") <> 0 Then ExitProcess(12)

ExitProcess(0)
