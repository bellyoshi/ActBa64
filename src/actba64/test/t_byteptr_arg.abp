' BytePtr 引数は TY_LONG 別名でも 64bit のまま渡る（入口 ZX で切らない）
' Expect: 0
' Target: actba64
#console

Declare Function lstrlenA Lib "kernel32" (lp As BytePtr) As Long

Function HeapStrLen(p As BytePtr) As Long
    HeapStrLen = 0
    If p = 0 Then Exit Function
    HeapStrLen = lstrlenA(p)
End Function

Dim s As String
Dim n As Long

s = "A"
s = s + "BC"
n = HeapStrLen(StrPtr(s))
If n <> 3 Then
    ExitProcess(1)
End If
If s <> "ABC" Then
    ExitProcess(2)
End If
ExitProcess(0)
