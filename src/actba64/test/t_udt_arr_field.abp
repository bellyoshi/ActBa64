' Target: actba64
' Expect: 0
Type T
    a(3) As Byte
    n(1) As Long
End Type

Dim t As T
Dim p As *T

p = VarPtr(t)
p->a[0] = 65
p->a[1] = 66
p->a[2] = 0
p->n[0] = 7
p->n[1] = 9

If p->a[0] <> 65 Then
    ExitProcess(1)
End If
If p->a[1] <> 66 Then
    ExitProcess(2)
End If
If p->n[0] <> 7 Then
    ExitProcess(3)
End If
If p->n[1] <> 9 Then
    ExitProcess(4)
End If

ExitProcess(0)
