' Expect: 0
' Target: actba64
' Int64 / QWord の算術・比較・リテラル（64bit 出力と -actba32）
#console
Function Check(cond As Long, code As Long) As Long
    Check = 0
    If cond = 0 Then
        Print "fail "; code
        Check = 1
    End If
End Function

Dim x As Int64, y As Int64, i As Int64, u As QWord, v As QWord
Dim l As Long, d As Double
Dim bad As Long

bad = 0
x = 3000000000
y = x + x
bad = bad + Check(Str$(y) = "6000000000", 1)
bad = bad + Check(Str$(x * 4) = "12000000000", 2)
bad = bad + Check(Str$(x * x) = "9000000000000000000", 3)
bad = bad + Check(Str$(9223372036854775807) = "9223372036854775807", 4)
bad = bad + Check(Str$(&H7FFFFFFFFFFFFFFF) = "9223372036854775807", 5)
bad = bad + Check(Str$(&HFFFFFFFFFFFFFFFF) = "-1", 6)
bad = bad + Check(Str$(&H123456789ABCDEF0) = "1311768467463790320", 7)
bad = bad + Check(Str$(-x) = "-3000000000", 8)
bad = bad + Check(Str$(Not x) = "-3000000001", 9)
y = 10000000000
bad = bad + Check(Str$(y \ 7) = "1428571428" And Str$(y Mod 7) = "4", 10)
bad = bad + Check(Str$(-y \ 7) = "-1428571428" And Str$(-y Mod 7) = "-4", 11)
bad = bad + Check(Str$(x << 4) = "48000000000" And Str$(y >> 3) = "1250000000", 12)
l = 5
bad = bad + Check(Str$(x - l) = "2999999995" And Str$(l - x) = "-2999999995", 13)
bad = bad + Check(x > l, 14)
bad = bad + Check(y > x, 15)
bad = bad + Check(x = 3000000000, 16)
bad = bad + Check((x < y) = -1 And (x >= y) = 0, 17)
x += 1
bad = bad + Check(Str$(x) = "3000000001", 18)
u = &H8000000000000000
v = 1
bad = bad + Check(u > v, 19)
d = x + 0.5
bad = bad + Check(d = 3000000001.5, 20)
i = 1
For l = 1 To 62
    i = i * 2
Next
bad = bad + Check(Str$(i) = "4611686018427387904", 21)
bad = bad + Check(Str$(i - 1 + i) = "9223372036854775807", 22)
' If x Then は 64 ビットで見る
x = &H100000000
l = 0
If x Then l = 1
bad = bad + Check(l = 1, 23)
' Long へは下位 32 ビット
l = x + 7
bad = bad + Check(l = 7, 24)
' 回り込み
x = 9223372036854775807
x = x + 1
bad = bad + Check(Str$(x) = "-9223372036854775808", 25)
If bad = 0 Then Print "ok"
ExitProcess(bad)
