' Expect: 2
' Target: actba64

' Print # はファイル出力なのでコンソールにしない（GUI = 2）。
Dim base As *Byte
Dim lf As Long
Dim path As String
path = "t_subsys_fprint.tmp"
Open path For Output As #1
Print #1, "x"
Close #1
Kill path
base = GetModuleHandle(0) As *Byte
lf = GetDWord(VarPtr(base[&H3C]))
ExitProcess(GetWord(VarPtr(base[lf + 24 + 68])))
