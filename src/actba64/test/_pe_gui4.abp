' Target: actba64
' Expect: 0
#console

Declare Function IsWindowVisible Lib "user32.dll" (ByVal hWnd As HWND) As Long

Function DummyProc(hWnd As HWND, message As DWord, wParam As WPARAM, lParam As LPARAM) As LRESULT
    DummyProc = DefWindowProc(hWnd, message, wParam, lParam)
End Function

Dim wc As WNDCLASSEX
FillMemory(VarPtr(wc), Len(wc), 0)
wc.cbSize = Len(wc)
wc.hInstance = GetModuleHandle(0)
wc.style = CS_HREDRAW Or CS_VREDRAW Or CS_DBLCLKS
wc.hCursor = LoadCursor(NULL, MAKEINTRESOURCE(IDC_ARROW))
wc.lpszClassName = "NORMAL0"
wc.lpfnWndProc = AddressOf(DummyProc)
wc.hbrBackground = CreateSolidBrush(GetSysColor(COLOR_3DFACE))
RegisterClassEx(wc)

Dim h As HWND
h = CreateWindowEx(&H00000000, "NORMAL0", "editor", &H10cf0000, -2147483648, -2147483648, 495, 367, 0, 0, GetModuleHandle(0), 0)
Print "hwnd"
Print h As Long
Print "visible after create"
Print IsWindowVisible(h)
ShowWindow(h, SW_SHOW)
Print "visible after ShowWindow"
Print IsWindowVisible(h)
Dim vis As Long
vis = IsWindowVisible(h)
If h <> 0 Then DestroyWindow(h)
If vis <> 0 Then
    ExitProcess(0)
End If
ExitProcess(1)
