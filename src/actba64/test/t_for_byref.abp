' Expect: 127
' Target: actba64
' For の制御変数が ByRef 引数のとき、指す先を宣言の幅で読み書きする（以前は引数の場所そのものに書いて落ちた）
#console
Dim t[3] As Long
Dim w[3] As Word

Function SumTo(ByRef c As Long) As Long
    SumTo = 0
    For c = 0 To 2
        SumTo = SumTo + c
    Next
End Function

Function SumStep(ByRef c As Long) As Long
    SumStep = 0
    For c = 10 To 1 Step -3
        SumStep = SumStep + c
    Next
End Function

Function SumWide(ByRef c As Int64) As Long
    SumWide = 0
    For c = 1 To 4 Step 2
        SumWide = SumWide + c
    Next
End Function

Function SumWord(ByRef c As Word, ByRef d As Long) As Long
    SumWord = 0
    For c = 1 To 3
        For d = 1 To c
            SumWord = SumWord + d
        Next
    Next
End Function

Dim k As Long
Dim q As Int64
Dim r As Long
t[0] = 7 : t[1] = 8 : t[2] = 9
w[0] = 5 : w[1] = 6 : w[2] = 7
r = 0
If SumTo(k) = 3 And k = 3 Then r = r + 1
If SumStep(k) = 22 And k = -2 Then r = r + 2
If SumWide(q) = 4 And q = 5 Then r = r + 4
If SumTo(t[1]) = 3 And t[1] = 3 And t[0] = 7 And t[2] = 9 Then r = r + 8
If SumWord(w[1], k) = 10 And w[1] = 4 And k = 4 Then r = r + 16
If w[0] = 5 And w[2] = 7 Then r = r + 32
If SumStep(t[2]) = 22 And t[2] = -2 And t[1] = 3 Then r = r + 64
ExitProcess(r)
