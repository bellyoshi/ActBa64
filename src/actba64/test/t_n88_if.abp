' Expect: 7
' Target: actba64
' Option: -pN88
' -pN88: 1 行の IF。IF 条件 THEN 文:文 ELSE 文 / IF 条件 THEN 行番号 / IF 条件 GOTO 行番号。小文字も可
A=3
IF A=3 THEN B=4:C=1 ELSE B=0
IF A<>3 THEN B=100
if b>=4 then e=1 else e=2
IF B=4 GOTO 100
B=0
100 IF C=1 THEN 200 ELSE 300
200 D=B+A:GOTO 400
300 D=0
400 IF E<>1 THEN D=99
EXITPROCESS D
