' UDT String メンバは precise 未登録。BSS/スタック conservative で生き残ること
' Expect: 0
' Target: actba64
#console

Type Rec
    name As String
End Type

Dim g As Rec
Dim loc As Rec
Dim i As Long
Dim t As String

g.name = "gkeep"
loc.name = "lkeep"
For i = 1 To 800
    t = "tmp" + Str$(i)
Next
If g.name <> "gkeep" Then
    Print "fail global udt"
    ExitProcess(1)
End If
If loc.name <> "lkeep" Then
    Print "fail local udt"
    ExitProcess(2)
End If
If Len(t) < 3 Then
    Print "fail last"
    ExitProcess(3)
End If
Print "ok"
ExitProcess(0)
End
