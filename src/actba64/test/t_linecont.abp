' Expect: 6
' Target: actba64
' _ 行継続と /* */ コメント
#console

Dim a As Long
Dim b As Long
Dim c As Long
Dim n As Long
Dim m As Long

a = 1
b = 2
c = 3

' 行継続 _
n = a +_
    b +_
    c

' 括弧内のパラメータ改行 + 行継続
m = Max(_
    n, _
    0 _
)

/* ブロックコメント
   複数行 */
n = m

n = n + /* 途中コメント */ 0

' 行末コメント付き継続（+0）
n = n +_
    0  ' still 6

ExitProcess(n)
