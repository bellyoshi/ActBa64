#console
#include "..\CharUtils.abp"
#include "..\StrUtils.abp"
Dim text As String
Dim oneLine As String
Dim eq As Long
Dim value As String
Dim key As String
Dim tmp As String
Dim n As Long
text = "xx#PLATFORM=32yy"
eq = InStr(1, text, "#PLATFORM=")
If eq <= 0 Then ExitProcess(1)
oneLine = Mid$(text, eq, 12)
If oneLine <> "#PLATFORM=32" Then ExitProcess(2)
ExitProcess(10)
End
