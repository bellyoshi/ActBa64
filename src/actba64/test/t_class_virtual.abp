' Expect: 2229
' Target: actba64
#console
' 中身のある Virtual / Override（ユーザーの vtable）。
' 基底の ctor から呼んだ Virtual は、作っているオブジェクトの Class の Override を呼ぶ。
' Private の Override でも基底から呼べる。

Class Form
    Public
    w As Long
    h As Long

    Sub Form()
        w = 1
        InitializeComponent()
    End Sub

    Virtual Sub InitializeComponent()
        w = 2
    End Sub

    Virtual Function Area() As Long
        Area = w * h
    End Function
End Class

Class Form1
    Inherits Form
Private
    Override Sub InitializeComponent()
        w = 3
        h = 4
    End Sub
End Class

Class Form2
    Inherits Form1
Public
    Override Function Area() As Long
        Area = w + h + 100
    End Function
End Class

Class Holder
    Public
    f As Form1
    x As Long
End Class

Function AreaOf(p As *Form) As Long
    AreaOf = p->Area()
End Function

Dim a As Form
Dim b As Form1
Dim c As Form2
Dim pf As *Form
Dim hd As Holder
Dim r As Long

pf = New Form2
r = a.w * 1000
r = r + a.Area()
r = r + b.Area()
r = r + AreaOf(VarPtr(c))
r = r + pf->Area()
r = r + hd.f.w
Delete pf
ExitProcess(r)
