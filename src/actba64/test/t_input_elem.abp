' Expect: 63
' Target: actba64
' Stdin: 10, 20, 30
' Stdin: abc, 2.5, -7
' Stdin: 8
' Input / Input # の読み先に配列の要素（a[i] / a(i) / a[i, j]、String・Double・Byte の要素も）
#console
#include "../FileIO.abp"

Dim a[2] As Integer
Dim s[1] As String
Dim d(1) As Double
Dim b[1] As Byte
Dim m[1, 1] As Long
Dim f(1) As Long
Dim i As Long
Dim r As Long
Dim path As String

r = 0
Input a[0], a[1], a[2]
If a[0] = 10 And a[1] = 20 And a[2] = 30 Then r = r Or 1
Input s[1], d(1), b[0]
If s[1] = "abc" And Len(s[1]) = 3 Then r = r Or 2
If d(1) = 2.5 And b[0] = 249 Then r = r Or 4
i = 1
Input "m"; m[i, 0]
If m[1, 0] = 8 And m[0, 1] = 0 Then r = r Or 8

path = "bin/test_out/t_input_elem.txt"
If WriteTextFile(path, "5,hey,6") = 0 Then ExitProcess(99)
Open path For Input As 1
Input #1, f(0), s[0], f(1)
Close 1
If f(0) = 5 And f(1) = 6 Then r = r Or 16
If s[0] = "hey" Then r = r Or 32
ExitProcess(r)
