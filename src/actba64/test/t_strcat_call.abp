' Expect: 0
' Target: actba64
#console
' As String の関数（名前に $ なし）どうしの + / & は文字列の連結

Function A() As String
    A = "a"
End Function

Function W(s As String) As String
    W = "[" + s + "]"
End Function

Dim s As String
Dim t As String

s = A() + A()
If s <> "aa" Then ExitProcess(1)
s = A() & W("b")
If s <> "a[b]" Then ExitProcess(2)
s = W(W("x")) + W("y")
If s <> "[[x]][y]" Then ExitProcess(3)
t = "z"
s = W(t) + A() + W(t)
If s <> "[z]a[z]" Then ExitProcess(4)
If A() + A() <> "aa" Then ExitProcess(5)
ExitProcess(0)
