' Expect: 0
' Target: actba64
#console
#include "../FileIO.abp"

Dim path As String
Dim x As String
Dim y As String
Dim z As String

path = "bin/test_out/t_input_hash_multi.txt"
If WriteTextFile(path, "a,b,c") = 0 Then
    ExitProcess(9)
End If

Open path For Input As 1
Input #1, x, y, z
If x <> "a" Then
    ExitProcess(1)
End If
If y <> "b" Then
    ExitProcess(2)
End If
If z <> "c" Then
    ExitProcess(3)
End If
Close 1
ExitProcess(0)
