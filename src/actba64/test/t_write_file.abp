' Expect: 0
' Target: actba64
#console

Dim path As String
Dim s As String
Dim n As Long

path = "bin/test_out/t_write_file.txt"

Open path For Output As 1
Write #1, "hello", 42
Close 1

Open path For Input As 2
Input #2, s
If s <> "hello" Then
    ExitProcess(1)
End If
Input #2, n
If n <> 42 Then
    ExitProcess(2)
End If
Close 2
ExitProcess(0)
