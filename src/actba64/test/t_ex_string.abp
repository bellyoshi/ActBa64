' Expect: 0
' Target: actba64
#console

Dim s As String

s = Ex"line1\nline2"
If Len(s) <> 11 Then ExitProcess(1)
If InStr(1, s, Chr$(10)) <> 6 Then ExitProcess(2)

If Len(Ex"a\0b") <> 3 Then ExitProcess(3)

Dim p As *Byte
p = Ex"a\0b"
If p[1] <> 0 Then ExitProcess(4)
If p[2] <> Asc("b") Then ExitProcess(5)

' \q は "、\xhh は 16 進 2 桁の文字コード（AB 4.20 と同じ）
If Ex"a\qb" <> "a" + Chr$(34) + "b" Then ExitProcess(6)
If Ex"\x41\x7a" <> "Az" Then ExitProcess(7)
If Ex"\x4G" <> Chr$(4) + "G" Then ExitProcess(8)
If Ex"\xZ" <> "xZ" Then ExitProcess(9)
If Ex"\x414" <> "A4" Then ExitProcess(10)
If Ex"\t\\" <> Chr$(9) + Chr$(92) Then ExitProcess(11)
ExitProcess(0)
