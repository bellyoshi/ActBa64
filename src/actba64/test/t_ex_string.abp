' Expect: 0
' Target: actba64
#console

Dim s As String

s = Ex"line1\nline2"
If Len(s) <> 11 Then ExitProcess(1)
If InStr(1, s, Chr$(10)) <> 6 Then ExitProcess(2)

If Len(Ex"a\0b") <> 3 Then ExitProcess(3)

Dim p As *Byte
p = Ex"a\0b"
If p[1] <> 0 Then ExitProcess(4)
If p[2] <> Asc("b") Then ExitProcess(5)

ExitProcess(0)
