' Expect: 0
' Target: actba64
#console
Dim s As String

Open "t_lesson_ops.txt" For Output As 1
Print #1, 1 + 1 - 1
Print #1, 2 * 3 / 6
Print #1, 3.4 \ 1.5
Print #1, 3 * 2 - 2.5 * 2
Print #1, (2 ^ 8) Mod 85
Close 1

Open "t_lesson_ops.txt" For Input As 1
Input #1, s
If s <> "1" Then ExitProcess(1)
Input #1, s
If s <> "1" Then ExitProcess(2)
Input #1, s
If s <> "2" Then ExitProcess(3)
Input #1, s
If s <> "1" Then ExitProcess(4)
Input #1, s
If s <> "1" Then ExitProcess(5)
Close 1
ExitProcess(0)
