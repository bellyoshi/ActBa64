' Expect: 0
' Target: actba64
' Input "ab"; は窓に ab? を描いてから読む。待ち始めの桁は 4。
#n88basic
Dim g_askX As Long
Dim n As Double
Dim sa As SECURITY_ATTRIBUTES
Dim tid As DWord
Dim th As HANDLE

Function AskFeed(param As VoidPtr) As Long
    While g_n88InputOn = 0
        Sleep(1)
    Wend
    g_askX = g_n88CurX
    N88_OnEnter()
    If param = 0 Then AskFeed = 0
End Function

N88_ZeroSa(sa)
th = CreateThread(sa, 0, AddressOf(AskFeed), 0, 0, VarPtr(tid))
If th = 0 Then ExitProcess(2)
Input "ab"; n
If g_askX <> 4 Then ExitProcess(g_askX)
ExitProcess(0)
