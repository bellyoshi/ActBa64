' Expect: 63
' Target: actba64
' ByRef の整数は宣言の幅で読み書きする（64bit でも Long は 4 バイト。隣の要素を壊さない）
#console
Dim t[7] As Long
Dim w[7] As Word
Dim b[7] As Byte

Sub SwapL(ByRef a As Long, ByRef c As Long)
    Dim tmp As Long
    tmp = a
    a = c
    c = tmp
End Sub

Sub SwapW(ByRef a As Word, ByRef c As Word)
    Dim tmp As Long
    tmp = a
    a = c
    c = tmp
End Sub

Sub SwapB(ByRef a As Byte, ByRef c As Byte)
    Dim tmp As Long
    tmp = a
    a = c
    c = tmp
End Sub

Sub SetH(ByRef h As HWND, v As HWND)
    h = v
End Sub

Function GetP(ByRef p As VoidPtr) As VoidPtr
    GetP = p
End Function

Dim k As Long
Dim r As Long
Dim h As HWND
Dim vp As VoidPtr
For k = 0 To 7
    t[k] = k + 1
    w[k] = k + 1
    b[k] = k + 1
Next
SwapL(t[2], t[3])
SwapW(w[2], w[3])
SwapB(b[2], b[3])
r = 0
If t[2] = 4 And t[3] = 3 And t[4] = 5 And t[1] = 2 Then r = r + 1
If w[2] = 4 And w[3] = 3 And w[4] = 5 And w[1] = 2 Then r = r + 2
If b[2] = 4 And b[3] = 3 And b[4] = 5 And b[1] = 2 Then r = r + 4
SetH(h, GetModuleHandle(0))
If h = GetModuleHandle(0) Then r = r + 8
vp = VarPtr(t[0])
If GetP(vp) = VarPtr(t[0]) Then r = r + 16
k = -7
SwapL(k, t[0])
If k = 1 And t[0] = -7 And t[1] = 2 Then r = r + 32
ExitProcess(r)
