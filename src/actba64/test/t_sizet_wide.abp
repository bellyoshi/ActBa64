' Expect: 0
' Target: actba64
' Skip32: 1
' SIZE_T / DWORD_PTR も LONG_PTR / ULONG_PTR と同じポインタ幅の整数
' 配列の要素を読んでもコンパイルが止まらず（以前は codegen failed (AstToIr)）、64bit の値が切れない
#console

Function Check(cond As Long, code As Long) As Long
    Check = 0
    If cond = 0 Then
        Print "fail "; code
        Check = 1
    End If
End Function

Function Half(x As SIZE_T) As SIZE_T
    Half = x - 1
End Function

Dim sa[2] As SIZE_T
Dim da[2] As DWORD_PTR
Dim s As SIZE_T
Dim d As DWORD_PTR
Dim bad As Long
bad = 0

sa[0] = 1
sa[1] = &H123456789
bad = bad + Check(VarPtr(sa[1]) - VarPtr(sa[0]) = SizeOf(VoidPtr), 1)
bad = bad + Check(Hex$(sa[1] As QWord) = "123456789", 2)
bad = bad + Check(Str$(sa[1]) = "4886718345", 3)
bad = bad + Check(sa[0] = 1, 4)

da[1] = &H123456789
bad = bad + Check(Hex$(da[1] As QWord) = "123456789", 5)
bad = bad + Check(Str$(da[1]) = "4886718345", 6)

s = &H123456789
bad = bad + Check(Str$(s) = "4886718345", 7)
bad = bad + Check(Hex$(Half(s) As QWord) = "123456788", 8)
d = s
bad = bad + Check(Hex$(d As QWord) = "123456789", 9)

If bad = 0 Then Print "ok"
ExitProcess(bad)
