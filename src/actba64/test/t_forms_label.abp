' Expect: 111
' Target: actba64
' Forms.sbp の Label と SetCaption: AddControl した Label は子窓（STATIC）になる
' → ボタンを押すと SetCaption で Label の窓の文字が変わる（Caption も変わる）

#include <Forms.sbp>

Dim g_text(63) As Byte
Dim g_cls(15) As Byte

Class Form1
    Inherits Form
Public
    Button1 As Button
    Label1 As Label

    Override Function WndProc(msg As DWord, wParam As WPARAM, lParam As LPARAM) As LRESULT
        If msg = WM_COMMAND Then
            If HIWORD(wParam) = BN_CLICKED And lParam = Button1.Handle Then Label1.SetCaption("押した")
        End If
        WndProc = Super.WndProc(msg, wParam, lParam)
    End Function

Private
    Override Sub InitializeComponent()
        Width = 200
        Height = 120
        Caption = "テスト"

        Button1.Left = 8
        Button1.Top = 8
        Button1.Width = 100
        Button1.Height = 30
        Button1.Caption = "押す"
        AddControl(Button1)

        Label1.Left = 8
        Label1.Top = 50
        Label1.Width = 150
        Label1.Height = 20
        Label1.Caption = "まだ"
        AddControl(Label1)
    End Sub
End Class

Dim mainForm As Form1
Dim r As Long

mainForm.Show()
r = 0
GetClassName(mainForm.Label1.Handle, VarPtr(g_cls), 16)
If lstrcmpi(VarPtr(g_cls), "Static") = 0 And GetParent(mainForm.Label1.Handle) = mainForm.Handle Then r = r + 100
GetWindowText(mainForm.Label1.Handle, VarPtr(g_text), 64)
If lstrcmp(VarPtr(g_text), "まだ") = 0 Then r = r + 10
SendMessage(mainForm.Button1.Handle, BM_CLICK, 0, 0)
GetWindowText(mainForm.Label1.Handle, VarPtr(g_text), 64)
If lstrcmp(VarPtr(g_text), "押した") = 0 And mainForm.Label1.Caption = "押した" Then r = r + 1
PostMessage(mainForm.Handle, WM_CLOSE, 0, 0)
Application.Initialize()
Application.Run(mainForm)
ExitProcess(r)
