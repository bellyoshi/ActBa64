' Target: actba64
#console
' 親に Virtual が無いのに Override

Class Base
    Public
    x As Long
    Virtual Sub Draw()
        x = 1
    End Sub
End Class

Class Child
    Inherits Base
    Public
    Override Sub Paint()
        x = 2
    End Sub
End Class

Dim c As Child
ExitProcess(c.x)
