' Expect: 0
' Target: actba64
#console
Type T
    dllNames(15) As Byte
End Type
Sub F(builder As *T, baseOff As Long, src As *Byte, maxLen As Long)
    Dim i As Long
    i = 0
    While src[i] <> 0 And i < maxLen - 1
        builder.dllNames[baseOff + i] = src[i]
        i = i + 1
    Wend
    builder.dllNames[baseOff + i] = 0
End Sub
ExitProcess(0)
