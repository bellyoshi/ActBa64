' Target: actba64
' Expect: 0
#console

Dim s As Single
Dim got As Single
Dim buf(7) As Byte
Dim bits As Long

s = 0.5
memcpy(VarPtr(buf), VarPtr(s), 4)
got = GetSingle(VarPtr(buf))
memcpy(VarPtr(bits), VarPtr(got), 4)
If bits <> &H3F000000 Then ExitProcess(1)

SetDWord(VarPtr(buf), &H44480000)
got = GetSingle(VarPtr(buf))
memcpy(VarPtr(bits), VarPtr(got), 4)
If bits <> &H44480000 Then ExitProcess(2)

got = GetSingle(0)
memcpy(VarPtr(bits), VarPtr(got), 4)
If bits <> 0 Then ExitProcess(3)
ExitProcess(0)
