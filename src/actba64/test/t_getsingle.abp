' Target: actba64
' Expect: 0
#console

Dim s As Single
Dim got As Single
Dim d As Double
Dim gotd As Double
Dim buf(15) As Byte
Dim bits As Long

s = 0.5
buf[4] = 65
SetSingle(VarPtr(buf), s)
got = GetSingle(VarPtr(buf))
memcpy(VarPtr(bits), VarPtr(got), 4)
If bits <> &H3F000000 Then ExitProcess(1)
If buf[4] <> 65 Then ExitProcess(2)

d = 2.5
buf[8] = 66
SetDouble(VarPtr(buf), d)
gotd = GetDouble(VarPtr(buf))
If gotd < 2.4 Or gotd > 2.6 Then ExitProcess(3)
If buf[8] <> 66 Then ExitProcess(4)

SetSingle(0, s)
SetDouble(0, d)
got = GetSingle(0)
memcpy(VarPtr(bits), VarPtr(got), 4)
If bits <> 0 Then ExitProcess(5)
gotd = GetDouble(0)
If gotd <> 0 Then ExitProcess(6)
ExitProcess(0)
