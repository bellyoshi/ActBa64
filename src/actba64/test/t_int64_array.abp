' Expect: 0
' Target: actba64
' Skip32: 1
' Int64 / QWord の配列、For の制御変数、Select Case、Val（64bit 出力）
#console
Function Check(cond As Long, code As Long) As Long
    Check = 0
    If cond = 0 Then
        Print "fail "; code
        Check = 1
    End If
End Function

Dim a(4) As Int64
Dim m(2, 3) As Int64
Dim q[3] As QWord
Dim b[2] = [1, -2, 3000000000] As Int64
Dim i As Long, s As Int64, k As Int64, x As Int64
Dim t As String
Dim bad As Long

bad = 0
x = 3000000000
For i = 0 To 4
    a(i) = x * i
Next
bad = bad + Check(Str$(a(4)) = "12000000000" And Str$(a[3]) = "9000000000", 1)
a[1] = -7
bad = bad + Check(Str$(a(1)) = "-7", 2)
For i = 0 To 2
    m(i, 3) = i * 10000000000
Next
bad = bad + Check(Str$(m(2, 3)) = "20000000000" And Str$(m[1, 3]) = "10000000000", 3)
q(0) = &HFFFFFFFFFFFFFFFF
bad = bad + Check(Str$(q(0)) = "18446744073709551615", 4)
s = 0
For i = 0 To 4
    s = s + a(i)
Next
bad = bad + Check(Str$(s) = "26999999993", 5)
bad = bad + Check(Len(a) = 40, 6)
bad = bad + Check(Str$(b(0)) = "1" And Str$(b(1)) = "-2" And Str$(b(2)) = "3000000000", 7)
' For の制御変数が Int64
s = 0
For k = 4000000000 To 4000000005
    s = s + k
Next
bad = bad + Check(Str$(s) = "24000000015" And Str$(k) = "4000000006", 8)
t = ""
For k = 10 To 1 Step -3
    t = t + Str$(k) + ","
Next
bad = bad + Check(t = "10,7,4,1,", 9)
t = ""
For k = 0 To 20000000000 Step 10000000000
    t = t + Str$(k) + ","
Next
bad = bad + Check(t = "0,10000000000,20000000000,", 10)
' Select Case
i = 0
Select Case a(4)
    Case 12000000000
        i = 1
    Case Else
        i = 2
End Select
bad = bad + Check(i = 1, 11)
' Val は Double を経る（2^53 まで正確）
k = Val("123456789012")
bad = bad + Check(Str$(k) = "123456789012", 12)
If bad = 0 Then Print "ok"
ExitProcess(bad)
