#include "..\..\Include\d3d11\d3d11.sbp"

Dim g_pContext As *ID3D11DeviceContext
Dim g_pVB As *ID3D11Buffer
Dim g_pLayout As *ID3D11InputLayout

Sub dx_ReleaseAll()
	If g_pLayout Then
		g_pLayout->Release()
		g_pLayout = 0
	End If
	If g_pVB Then
		g_pVB->Release()
		g_pVB = 0
	End If
	If g_pContext Then
		g_pContext->Release()
		g_pContext = 0
	End If
End Sub

dx_ReleaseAll()
