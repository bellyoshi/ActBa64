' Target: actba64
' Expect: 0
#console
#include "..\..\Include\d3d11\dx_camera.sbp"

Function DxNear(a As Double, b As Double) As Long
	Dim d As Double
	d = a - b
	If d < 0 Then d = 0 - d
	DxNear = 0
	If d < 0.001 Then DxNear = 1
End Function

Function DxAt(i As Long) As Double
	DxAt = GetSingle(VarPtr(g_dxProj[i]))
End Function

Function DxViewAt(i As Long) As Double
	DxViewAt = GetSingle(VarPtr(g_dxView[i]))
End Function

Dim eye As D3DVECTOR
Dim at As D3DVECTOR
Dim up As D3DVECTOR
Dim s0 As Single
Dim s1 As Single
Dim sm5 As Single

dx_SetProjection(D3DX_PI / 2, 1, 1, 3)
If DxNear(DxAt(0), 1) = 0 Then ExitProcess(1)
If DxNear(DxAt(5), 1) = 0 Then ExitProcess(2)
If DxNear(DxAt(10), 1.5) = 0 Then ExitProcess(3)
If DxNear(DxAt(11), 1) = 0 Then ExitProcess(4)
If DxNear(DxAt(14), -1.5) = 0 Then ExitProcess(5)
If DxNear(DxAt(15), 0) = 0 Then ExitProcess(6)

dx_SetProjection(D3DX_PI / 2, 2, 1, 3)
If DxNear(DxAt(0), 0.5) = 0 Then ExitProcess(7)

s0 = 0
s1 = 1
sm5 = -5
eye.x = s0
eye.y = s0
eye.z = sm5
at.x = s0
at.y = s0
at.z = s0
up.x = s0
up.y = s1
up.z = s0
dx_SetCamera(VarPtr(eye), VarPtr(at), VarPtr(up))
If DxNear(DxViewAt(0), 1) = 0 Then ExitProcess(8)
If DxNear(DxViewAt(5), 1) = 0 Then ExitProcess(9)
If DxNear(DxViewAt(10), 1) = 0 Then ExitProcess(10)
If DxNear(DxViewAt(14), 5) = 0 Then ExitProcess(11)
If DxNear(DxViewAt(15), 1) = 0 Then ExitProcess(12)

dx_SetCamera(0, 0, 0)
If DxNear(DxViewAt(14), 5) = 0 Then ExitProcess(13)
ExitProcess(0)
