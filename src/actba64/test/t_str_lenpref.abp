' Target: actba64
' Length-prefixed String (AB4.20 compatible)
' Expect: 0
#console
Dim s As String
Dim t As String
Dim n As Long

s = Chr$(0)
n = Len(s)
If n <> 1 Then
    Print "fail Chr$(0) Len=" + Str$(n)
    ExitProcess(1)
End If

s = "Hello" + Chr$(0) + "World"
n = Len(s)
If n <> 11 Then
    Print "fail cat Len=" + Str$(n)
    ExitProcess(2)
End If

t = Left$(s, 5)
If t <> "Hello" Then
    Print "fail Left$"
    ExitProcess(3)
End If

t = Mid$(s, 7, 5)
If t <> "World" Then
    Print "fail Mid$"
    ExitProcess(4)
End If

If Asc(s) <> 72 Then
    Print "fail Asc"
    ExitProcess(5)
End If

s = ""
If Len(s) <> 0 Then
    Print "fail empty"
    ExitProcess(6)
End If

Print "ok"
ExitProcess(0)
End
