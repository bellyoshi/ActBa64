' Expect: 0
' Target: actba64
' Option: -pAB2
' -pAB2: SendWndMsg の戻り値（5 番目）と、文字列の変数を lParam にした WM_GETTEXT
Dim hMainWnd As Long
Dim hEditWnd As Long
Dim MaxBytes As Long
Dim Text$ As String
Dim s As Long
Dim e As Long
Window hMainWnd,OwnerWnd(),-1,-1,200,100,"t",WS_OVERLAPPEDWINDOW,"NORMAL"
Window hEditWnd,hMainWnd,0,0,100,20,"",WS_CHILD,"EDIT"
SendWndMsg hEditWnd,WM_SETTEXT,0,"SOS"
SendWndMsg hEditWnd,WM_GETTEXTLENGTH,0,0,MaxBytes
If MaxBytes<>3 Then ExitProcess(10+MaxBytes)
SendWndMsg hEditWnd,WM_GETTEXT,MaxBytes+1,Text$
If Text$<>"SOS" Then ExitProcess(2)
SendWndMsg hEditWnd,EM_SETSEL,1,2
SendWndMsg hEditWnd,EM_GETSEL,s,e
If s<>1 Or e<>2 Then ExitProcess(3)
ExitProcess(0)
