' CompileFail: 1
' Target: actba64
#console
' 親の Virtual と同じ名前の Sub には Override が要る

Class Base
    Public
    x As Long
    Virtual Sub Draw()
        x = 1
    End Sub
End Class

Class Child
    Inherits Base
    Public
    Sub Draw()
        x = 2
    End Sub
End Class

Dim c As Child
ExitProcess(c.x)
