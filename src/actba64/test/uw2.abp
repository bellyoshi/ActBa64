' Expect: 0
' Target: actba64
#console
#include "..\PE32PLUS.abp"
Const NULL = 0
Const GENERIC_WRITE = &H40000000
Const CREATE_ALWAYS = 2
Const FILE_ATTRIBUTE_NORMAL = 128
Const INVALID_HANDLE_VALUE = &HFFFFFFFF
Function WriteAll(path As *Byte, p As *Byte, size As Long) As Long
    Dim hFile As Long
    Dim nWritten As Long
    WriteAll = 0
    hFile = CreateFile(path, GENERIC_WRITE, 0, 0, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, 0)
    If hFile = INVALID_HANDLE_VALUE Then Exit Function
    WriteFile(hFile, p, size, VarPtr(nWritten), 0)
    CloseHandle(hFile)
    If nWritten = size Then WriteAll = 1
End Function
ExitProcess(0)
