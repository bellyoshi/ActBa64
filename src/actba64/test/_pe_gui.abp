' Target: actba64
' Expect: 0
#console

Declare Function GetLastError Lib "kernel32" () As DWord

Dim wc As WNDCLASSEX
Dim h As HWND
Dim atom As Long
Dim clsName As String
Dim title As String
Dim hInst As HINSTANCE
Dim hCur As HCURSOR
Dim hBr As HBRUSH
Dim pWnd As VoidPtr

clsName = "NORMAL0"
title = "editor"

Print "SizeOf WNDCLASSEX"
Print SizeOf(WNDCLASSEX)
Print "SizeOf MSG"
Print SizeOf(MSG)
Print "SizeOf CREATESTRUCT"
Print SizeOf(CREATESTRUCT)

hInst = GetModuleHandle(0)
Print "hInst"
Print hInst As Long

FillMemory(VarPtr(wc), SizeOf(WNDCLASSEX), 0)
wc.cbSize = SizeOf(WNDCLASSEX)
wc.hInstance = hInst
wc.style = CS_HREDRAW Or CS_VREDRAW Or CS_DBLCLKS
wc.hCursor = LoadCursor(NULL, MAKEINTRESOURCE(IDC_ARROW))
wc.hIcon = LoadIcon(NULL, MAKEINTRESOURCE(IDI_APPLICATION))
wc.hIconSm = LoadIcon(NULL, MAKEINTRESOURCE(IDI_WINLOGO))
wc.lpszClassName = StrPtr(clsName)
wc.lpfnWndProc = AddressOf(N88_DummyProc)
hBr = CreateSolidBrush(GetSysColor(COLOR_3DFACE))
wc.hbrBackground = hBr

Print "cbSize"
Print wc.cbSize
Print "lpfnWndProc"
Print wc.lpfnWndProc As Long
Print "lpszClassName"
Print wc.lpszClassName As Long
Print "hCursor"
Print wc.hCursor As Long

atom = RegisterClassEx(wc)
Print "RegisterClassEx"
Print atom
Print "GetLastError"
Print GetLastError()

h = CreateWindowEx(0, StrPtr(clsName), StrPtr(title), &H10CF0000, -2147483648, -2147483648, 495, 367, 0, 0, hInst, 0)
Print "CreateWindowEx hwnd"
Print h As Long
Print "GetLastError"
Print GetLastError()

If h <> 0 Then
    DestroyWindow(h)
End If
ExitProcess(0)

Function N88_DummyProc(hWnd As HWND, message As DWord, wParam As WPARAM, lParam As LPARAM) As LRESULT
    N88_DummyProc = DefWindowProc(hWnd, message, wParam, lParam)
End Function
