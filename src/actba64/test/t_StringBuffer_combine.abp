' Expect: 8
' Target: actba64
' StringBuffer as Class (self-contained, no #include)
#console

Sub ZeroMem(p As *Byte, n As Long)
    Dim i As Long
    Dim q As *Byte
    If n <= 0 Then Exit Sub
    q = p
    For i = 0 To n - 1
        q[i] = 0
    Next
End Sub

Const SB_INIT_CAP = 64

Class StringBuffer
    Public
    buf As *Byte
    nLen As Long
    nCap As Long

    Sub StringBuffer()
        buf = 0
        nLen = 0
        nCap = 0
    End Sub

    Sub ~StringBuffer()
        Me->Free()
    End Sub

    Sub Free()
        Dim bp As *Byte
        bp = buf
        If bp <> 0 Then
            free(bp)
        End If
        buf = 0
        nLen = 0
        nCap = 0
    End Sub

    Sub Clear()
        Dim bp As *Byte
        nLen = 0
        bp = buf
        If bp <> 0 Then
            bp[0] = 0
        End If
    End Sub

    Function Ensure(need As Long) As Long
        Dim np As *Byte
        Dim ncap As Long
        Dim op As *Byte
        Dim n As Long
        Ensure = 0
        If need <= nCap Then
            Ensure = 1
            Exit Function
        End If
        ncap = nCap
        If ncap <= 0 Then ncap = SB_INIT_CAP
        While ncap < need
            ncap = ncap * 2
        Wend
        np = malloc(ncap)
        If np = 0 Then
            ExitProcess(1)
        End If
        n = nLen
        op = buf
        If n > 0 Then
            If op <> 0 Then
                memcpy(np, op, n)
            End If
        End If
        If op <> 0 Then
            free(op)
        End If
        buf = np
        nCap = ncap
        Ensure = 1
    End Function

    Sub AppendBytes(src As *Byte, n As Long)
        Dim bp As *Byte
        Dim off As Long
        If n <= 0 Then Exit Sub
        If Me->Ensure(nLen + n + 1) = 0 Then
            ExitProcess(1)
        End If
        bp = buf
        off = nLen
        memcpy(VarPtr(bp[off]), src, n)
        off = off + n
        nLen = off
        bp[off] = 0
    End Sub

    Sub AppendStr(s As String)
        Dim n As Long
        n = Len(s)
        If n <= 0 Then Exit Sub
        Me->AppendBytes(StrPtr(s), n)
    End Sub

    Sub AppendCRLF()
        Dim crlf[2] As Byte
        crlf[0] = 13
        crlf[1] = 10
        Me->AppendBytes(VarPtr(crlf), 2)
    End Sub

    Sub AppendSb(src As *StringBuffer)
        Dim sp As *Byte
        Dim n As Long
        n = src->nLen
        If n <= 0 Then Exit Sub
        sp = src->buf
        Me->AppendBytes(sp, n)
    End Sub

    Sub AppendByte(b As Long)
        Dim bp As *Byte
        Dim off As Long
        If Me->Ensure(nLen + 2) = 0 Then
            ExitProcess(1)
        End If
        bp = buf
        off = nLen
        bp[off] = b And &HFF
        off = off + 1
        nLen = off
        bp[off] = 0
    End Sub

    Function GetLen() As Long
        GetLen = nLen
    End Function

    Function IsEmpty() As Long
        If nLen <= 0 Then
            IsEmpty = 1
        Else
            IsEmpty = 0
        End If
    End Function

    Function ToStr$() As String
        Dim bp As *Byte
        Dim n As Long
        bp = buf
        n = nLen
        If bp = 0 Then
            ToStr$ = ""
        Else
            If n <= 0 Then
                ToStr$ = ""
            Else
                bp[n] = 0
                ToStr$ = MakeStr(bp)
            End If
        End If
    End Function
End Class

Dim sb As StringBuffer
Dim other As StringBuffer
Dim s As String
Dim n As Long

If sb.IsEmpty() = 0 Then
    ExitProcess(1)
End If

sb.AppendStr("foo")
sb.AppendStr("bar")
sb.AppendCRLF()

sb.Clear()
sb.AppendStr("xy")
sb.AppendByte(Asc("z"))

other.AppendStr("!")
sb.AppendSb(VarPtr(other))

s = sb.ToStr$()
n = sb.GetLen()
n = n + Len(s)

other.Free()
sb.Free()

ExitProcess(n)
