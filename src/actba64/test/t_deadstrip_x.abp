' Expect: 137
' Target: actba64
' Option: -X
' -X: 呼ばれない関数を消しても、AddressOf で取った関数・Virtual の Override・
' 呼ばれる関数から呼ばれる関数は残る
#console

Function Add(a As Long, b As Long) As Long
    Add = a + b
End Function

Function Twice(a As Long) As Long
    Twice = Add(a, a)
End Function

Function NeverCalled() As Long
    NeverCalled = MessageBox(0, "never", "never", 0)
End Function

Sub AlsoUnused()
    Print NeverCalled()
End Sub

Class Shape
Public
    Virtual Function Area() As Long
        Area = 1
    End Function
End Class

Class Square
    Inherits Shape
Public
    Override Function Area() As Long
        Area = 100
    End Function
End Class

Dim p As *Function(a As Long, b As Long) As Long
Dim s As *Shape
Dim r As Long
p = AddressOf(Add)
s = New Square
r = p(30, 1) + Twice(3) + s->Area()
Delete s
ExitProcess(r)
