' Expect: 111
' Target: actba64
' Forms.sbp の Button: InitializeComponent で AddControl → 窓ができると子窓（BUTTON）
' → BM_CLICK で親の WndProc に WM_COMMAND / BN_CLICKED → WM_CLOSE で Run が戻る

#include <Forms.sbp>

Dim g_clicked As Long
Dim g_text(63) As Byte

Class Form1
    Inherits Form
Public
    Button1 As Button

    Override Function WndProc(msg As DWord, wParam As WPARAM, lParam As LPARAM) As LRESULT
        If msg = WM_COMMAND Then
            If HIWORD(wParam) = BN_CLICKED And lParam = Button1.Handle Then Button1Click()
        End If
        WndProc = Super.WndProc(msg, wParam, lParam)
    End Function

Private
    Sub Button1Click()
        g_clicked = g_clicked + 1
    End Sub

    Override Sub InitializeComponent()
        Left = 10
        Top = 10
        Width = 200
        Height = 100
        Caption = "テスト"

        Button1.Left = 8
        Button1.Top = 8
        Button1.Width = 100
        Button1.Height = 30
        Button1.Caption = "押す"
        AddControl(Button1)
    End Sub
End Class

Dim mainForm As Form1
Dim r As Long

mainForm.Show()
SendMessage(mainForm.Button1.Handle, BM_CLICK, 0, 0)
GetWindowText(mainForm.Button1.Handle, VarPtr(g_text), 64)
r = 0
If GetParent(mainForm.Button1.Handle) = mainForm.Handle Then r = r + 100
If g_clicked = 1 Then r = r + 10
If lstrcmp(VarPtr(g_text), "押す") = 0 Then r = r + 1
PostMessage(mainForm.Handle, WM_CLOSE, 0, 0)
Application.Initialize()
Application.Run(mainForm)
ExitProcess(r)
