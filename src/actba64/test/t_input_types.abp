' Expect: 0
' Target: actba64
' Stdin:   -123
' Stdin: +42
' Stdin: 7
' Stdin: hello
#console

Dim n As Long
Dim b As Byte
Dim d As Single
Dim s As String
Dim bits As Long

Input n
Input b
Input d
Input s

If n <> -123 Then ExitProcess(1)
If b <> 42 Then ExitProcess(2)
' 7.0f = 0x40E00000。d < 6.9 は Double 比較になり 32bit SSE 未対応
memcpy(VarPtr(bits), VarPtr(d), 4)
If bits <> &H40E00000 Then ExitProcess(3)
If s <> "hello" Then ExitProcess(4)
ExitProcess(0)
