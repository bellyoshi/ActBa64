' Expect: 0
' Target: actba64
' Stdin:   -123
' Stdin: +42
' Stdin: 7
' Stdin: hello
#console

Dim n As Long
Dim b As Byte
Dim d As Double
Dim s As String

Input n
Input b
Input d
Input s

If n <> -123 Then ExitProcess(1)
If b <> 42 Then ExitProcess(2)
If d <> 7 Then ExitProcess(3)
If s <> "hello" Then ExitProcess(4)
ExitProcess(0)
