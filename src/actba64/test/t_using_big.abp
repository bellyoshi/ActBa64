' Expect: 0
' Target: actba64
' Print Using で 2^31 以上の値（整数部を Fix で取っていたので -2147483648 に溢れていた）
#console
Function Fmt$(f As String, v As Double) As String
    Fmt$ = PuUseEnd$(PuUseVal$(PuUseBeg$(f), v))
End Function

Dim bad As Long
bad = 0
If Fmt$("##########", 5000000000.0) <> "5000000000" Then bad = bad + 1
If Fmt$("#############.##", 123456789012.346) <> " 123456789012.35" Then bad = bad + 2
If Fmt$("##,###,###,###", 9876543210.0) <> " 9,876,543,210" Then bad = bad + 4
If Fmt$("####.##", 12.345) <> "  12.35" Then bad = bad + 8
If Fmt$("######", -42) <> "   -42" Then bad = bad + 16
ExitProcess(bad)
