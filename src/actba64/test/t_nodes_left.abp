' Target: actba64
Type AstNode
    left As Long
    right As Long
    num As Long
End Type
Dim nodes As *AstNode
Dim n As Long
Dim left As Long
Dim right As Long
nodes = malloc(SizeOf(AstNode) * 4)
n = 0
left = 1
right = 2
nodes[n].num = 3
nodes[n].left = left
nodes[n].right = right
If nodes[n].left <> 1 Then
    ExitProcess(1)
End If
ExitProcess(0)