' Expect: 0
' Target: actba64
' Skip32: 1
' Int64 / QWord: Type メンバの配列、関数ポインタの戻り値、Long と Int64 の多重定義（64bit 出力）
#console
Type T
    a As Long
    v[2] As Int64
    q[1] As QWord
End Type

TypeDef FnBig = *Function(n As Long) As Int64

Function Mul(n As Long) As Int64
    Dim x As Int64
    x = n
    Mul = x * 3000000000
End Function

Function Kind$(a As Long) As String
    Kind$ = "Long"
End Function

Function Kind$(a As Int64) As String
    Kind$ = "Int64"
End Function

Function Kind$(a As Double) As String
    Kind$ = "Double"
End Function

Function Only(a As Int64) As Int64
    Only = a * 2
End Function

Function Check(cond As Long, code As Long) As Long
    Check = 0
    If cond = 0 Then
        Print "fail "; code
        Check = 1
    End If
End Function

Dim t As T, x As Int64, l As Long
Dim f As *Function(n As Long) As Int64
Dim g As FnBig
Dim bad As Long
bad = 0
l = -5
t.v[0] = l
t.v[2] = 9000000000
t.q[1] = &HFFFFFFFFFFFFFFFF
x = t.v[2] + 1
bad = bad + Check(Str$(t.v[0]) = "-5" And Str$(t.v[2]) = "9000000000", 1)
bad = bad + Check(Str$(x) = "9000000001", 2)
bad = bad + Check(Str$(t.q[1]) = "18446744073709551615", 3)
bad = bad + Check(SizeOf(T) = 48, 4)
bad = bad + Check(t.v[2] > t.v[0], 5)
f = AddressOf(Mul)
g = AddressOf(Mul)
bad = bad + Check(Str$(f(3)) = "9000000000" And Str$(g(4)) = "12000000000", 6)
bad = bad + Check(Str$(f(3) + 1) = "9000000001", 7)
l = 1
x = 5000000000
bad = bad + Check(Kind$(l) = "Long" And Kind$(x) = "Int64" And Kind$(1.5) = "Double", 8)
bad = bad + Check(Kind$(x + 1) = "Int64" And Kind$(7) = "Long", 9)
bad = bad + Check(Str$(Only(l)) = "2" And Str$(Only(x)) = "10000000000", 10)
If bad = 0 Then Print "ok"
ExitProcess(bad)
