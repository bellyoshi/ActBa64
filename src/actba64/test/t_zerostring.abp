' Target: actba64
' Expect: 0
#console

Dim s As String
Dim p As *Byte

s = ZeroString(3)
If Len(s) <> 3 Then ExitProcess(1)
p = StrPtr(s)
If GetByte(p) <> 0 Then ExitProcess(2)
If GetByte(p + 1) <> 0 Then ExitProcess(3)
If GetByte(p + 2) <> 0 Then ExitProcess(4)
If Len(ZeroString(0)) <> 0 Then ExitProcess(5)
If Len(ZeroString(-1)) <> 0 Then ExitProcess(6)
SetByte(p, Asc("A"))
If Asc(s) <> Asc("A") Then ExitProcess(7)
If Len(s) <> 3 Then ExitProcess(8)
ExitProcess(0)
