' Expect: 15
' Target: actba64
#console

Dim g As Long

Class Inner
    Public
    v As Long

    Sub Inner()
        v = 5
    End Sub

    Sub ~Inner()
        g = g + 10
    End Sub
End Class

Class Outer
    Public
    inn As Inner

    Sub Outer()
    End Sub
End Class

Sub Run()
    Dim o As Outer()
    g = o.inn.v
End Sub

Run()
ExitProcess(g)
