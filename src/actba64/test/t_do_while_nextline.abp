' Expect: 15
' Target: actba64
' Do / Loop の次の行の While ... Wend は別のループ（Do While / Loop Until は同じ行のときだけ）
#console
Dim m As Long
Dim n As Long
Dim r As Long
r = 0
m = 0
n = 0
Do
    While m < 3
        m = m + 1
    Wend
    n = n + 1
    If n = 2 Then Exit Do
Loop
If m = 3 And n = 2 Then r = r + 1
n = 0
Do While n < 5
    n = n + 1
Loop
If n = 5 Then r = r + 2
n = 0
Do
    n = n + 1
Loop Until n = 4
If n = 4 Then r = r + 4
m = 0
n = 0
Do
    n = n + 1
    If n = 1 Then Exit Do
Loop
While m < 2
    m = m + 1
Wend
If m = 2 And n = 1 Then r = r + 8
ExitProcess(r)
