' Expect: 0
' Target: actba64
#console
' Math.abp の Sin は include 内で引数が 0 になる既知の問題があるため、
' 同じマクローリンをテスト側に置いて sin(π/2) ≒ 1.0 を確認する。
Function MacSin(ang As Long) As Long
    Dim t As Long
    Dim s As Long
    Dim x2 As Long
    Dim k As Long
    Dim den As Long
    Dim u As Long
    Dim x As Long
    x = ang
    If x < 0 Then x = 0 - x
    If x > 1571 Then x = 3142 - x
    t = x
    s = x
    x2 = x * x
    x2 = MathDiv(x2, 1000)
    k = 1
    Do
        den = (k + k) * (k + k + 1)
        u = t * x2
        u = MathDiv(u, 1000)
        t = MathDiv(u, den)
        t = 0 - t
        If t = 0 Then Exit Do
        s = s + t
        k = k + 1
        If k > 16 Then Exit Do
    Loop
    If s > 1000 Then s = 1000
    MacSin = s
End Function
Dim v As Long
v = MacSin(1571)
If v < 990 Then ExitProcess(1)
ExitProcess(0)
End
