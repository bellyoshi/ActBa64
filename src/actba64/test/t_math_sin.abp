' Expect: 0
' Target: actba64
' Skip32: 1
#console
' Sin / Cos（ラジアン Double）
Dim v As Double
Dim hpi As Double

hpi = MathPi() / 2
v = Sin(hpi)
If v < 0.99 Then ExitProcess(1)
If v > 1.01 Then ExitProcess(2)

v = Cos(0)
If v < 0.99 Then ExitProcess(3)
If v > 1.01 Then ExitProcess(4)

v = SinDeg(30)
If v < 0.49 Then ExitProcess(5)
If v > 0.51 Then ExitProcess(6)

v = CosDeg(60)
If v < 0.49 Then ExitProcess(7)
If v > 0.51 Then ExitProcess(8)

ExitProcess(0)
