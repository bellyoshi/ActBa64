' Byte 戻り関数だけの For が呼び出し元の String を潰さないこと
' Expect: 0
' Target: actba64
#console

Function GetB(ByVal i As Long) As Byte
    GetB = 65 + (i And 3)
End Function

Function Scan(s As String) As Long
    Dim i As Long
    Dim n As Long
    Dim b As Byte
    Scan = 0
    n = Len(s)
    For i = 0 To n - 1
        b = GetB(i)
        If b < 65 Then
            Scan = -1
            Exit Function
        End If
    Next
    Scan = Len(s)
End Function

Dim line As String
Dim r As Long
Dim i As Long

line = "HelloWorld"
i = 0
While i < 80
    r = Scan(line)
    If r <> 10 Then
        ExitProcess(1)
    End If
    If line <> "HelloWorld" Then
        ExitProcess(2)
    End If
    i = i + 1
Wend
ExitProcess(0)
End
