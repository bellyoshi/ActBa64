' Expect: 0
' Target: actba64
#console
Declare Function GetMenuItemCount Lib "user32.dll" (ByVal hMenu As HMENU) As Long

Dim h As HMENU
Dim subm As HMENU
Dim n As Long

h = CreateMenu()
If h = 0 Then ExitProcess(1)
InsMenu h, 0, MF_SEPARATOR
InsMenu h, 0, MF_BYPOSITION, "A", 100
subm = CreatePopupMenu()
If subm = 0 Then ExitProcess(2)
InsMenu h, 0, MF_BYPOSITION, "Sub", 0, subm
n = GetMenuItemCount(h)
If n <> 3 Then ExitProcess(10 + n)
ExitProcess(0)
