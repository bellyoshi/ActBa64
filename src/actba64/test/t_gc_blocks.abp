' MAIN For のセーフポイントで掃き出しが効き、blocks 件数が膨らみ続けないこと
' Expect: 0
' Target: actba64
' Skip32: 1
#console

Dim s As String
Dim t As String
Dim i As Long
Dim n As Long

s = "keep"
For i = 1 To 3000
    t = "tmp" + Str$(i)
Next
n = StrGcGetCount()
If s <> "keep" Then
    Print "fail keep"
    ExitProcess(1)
End If
If Len(t) < 3 Then
    Print "fail last"
    ExitProcess(2)
End If
' Collect が効いていれば生きる塊はごく少数。上限 4096 に近づくのは失敗
If n > 64 Then
    Print "fail blocks"
    Print Str$(n)
    ExitProcess(3)
End If
Print "ok"
ExitProcess(0)
End
