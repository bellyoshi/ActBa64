' Expect: 0
' Target: actba64
' As String の Type メンバ（変数・ポインタ・Class）は Print・連結・比較で文字列として扱う
' 以前は Print sa.name が文字列のポインタを数で出し、sa.name + sa.name は数の足し算になっていた
#console
Type StrT
    name As String
    n As Long
End Type
Class StrC
Public
    s As String
End Class

Dim sa As StrT
Dim p As *StrT
Dim o As StrC
Dim r As Long
Dim t As String

sa.name = "Hello"
sa.n = 5
p = VarPtr(sa)
o.s = "cls"
Print sa.name
Print p->name; sa.n
Print o.s
t = sa.name + sa.name
If t <> "HelloHello" Then r = r + 1
If sa.name <> "Hello" Then r = r + 10
If p->name + "!" <> "Hello!" Then r = r + 100
If o.s + o.s <> "clscls" Then r = r + 1000
If Len(sa.name) <> 5 Then r = r + 10000
ExitProcess(r)
