' Expect: 0
' Target: actba64
#console
#include "../FileIO.abp"

Dim pathR As String
Dim pathW As String
Dim buffer As String

pathR = "bin/test_out/t_field_read.txt"
pathW = "bin/test_out/t_field_write.txt"

If WriteTextFile(pathR, "0123456789") = 0 Then
    ExitProcess(9)
End If
If WriteTextFile(pathW, "") = 0 Then
    ExitProcess(9)
End If

Open pathR As #1
Open pathW As #2
Field #1, 10
Field #2, 10
Get #1, 1, buffer
If buffer <> "0123456789" Then
    ExitProcess(1)
End If
Put #2, 1, buffer
Close #1
Close #2

Open pathW For Input As 3
Input #3, buffer
Close 3
If Left$(buffer, 10) <> "0123456789" Then
    ExitProcess(2)
End If
ExitProcess(0)
