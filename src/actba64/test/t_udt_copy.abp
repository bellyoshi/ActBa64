' Expect: 0
' Target: actba64
' Type の値どうしの代入はフィールドを丸ごと写す（配列の要素・入れ子のメンバ・変数・ByRef 引数）
' 以前は g[1] = m.rc にアドレスが入り、r = r2 は先頭 8 バイトだけ、r = g[1] はコンパイルできなかった
#console
Type MI
    a As Long
    rc As RECT
    d As Double
End Type
Dim g[3] As RECT
Class Mon
Public
    rc As RECT
    Function Take(i As Long) As Long
        Dim m As RECT
        m = g[i]
        rc = g[i]
        Take = m.left + m.bottom + rc.top
    End Function
End Class
Sub Fill(ByRef r As RECT, i As Long)
    r = g[i]
End Sub
Dim m As MI, n As MI, r As RECT, o As Mon, p As *Mon, i As Long
For i = 0 To 3
    g[i].left = i * 10 + 1 : g[i].top = i * 10 + 2 : g[i].right = i * 10 + 3 : g[i].bottom = i * 10 + 4
Next
m.rc.left = 5 : m.rc.top = 6 : m.rc.right = 7 : m.rc.bottom = 8
g[1] = m.rc
If g[1].left <> 5 Or g[1].top <> 6 Or g[1].right <> 7 Or g[1].bottom <> 8 Then ExitProcess(1)
If g[0].bottom <> 4 Or g[2].left <> 21 Then ExitProcess(2)
r = m.rc
If r.left <> 5 Or r.bottom <> 8 Then ExitProcess(3)
m.rc = g[2]
If m.rc.left <> 21 Or m.rc.bottom <> 24 Then ExitProcess(4)
If o.Take(3) <> 31 + 34 + 32 Then ExitProcess(5)
If o.rc.right <> 33 Then ExitProcess(6)
p = New Mon
p->rc = g[0]
r = p->rc
If r.left <> 1 Or r.bottom <> 4 Then ExitProcess(7)
Fill(r, 2)
If r.right <> 23 Then ExitProcess(8)
m.a = 9 : m.d = 2.5
n = m
If n.a <> 9 Or n.rc.top <> 22 Or n.d <> 2.5 Then ExitProcess(9)
ExitProcess(0)
