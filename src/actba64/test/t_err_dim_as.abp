' As を省いた Dim は Double。末尾 $ は String。配列も同じ。
#console
Dim n
Dim s$
Dim a(10)
Dim t As String

n = 1.5
If n <> 1.5 Then ExitProcess(1)
s$ = "ab"
If Len(s$) <> 2 Then ExitProcess(2)
a(1) = 1.5
If a(1) <> 1.5 Then ExitProcess(3)
t = StrD$(a(1))
If t <> "1.5" Then ExitProcess(4)
ExitProcess(0)
