' Expect: 111
' Target: actba64
' Forms.sbp の GroupBox: AddControl した GroupBox は子窓（BUTTON の BS_GROUPBOX）になる
' → 窓の文字は Caption で、SetCaption で変わる

#include <Forms.sbp>

Dim g_text(63) As Byte
Dim g_cls(15) As Byte

Class Form1
    Inherits Form
Public
    GroupBox1 As GroupBox

Private
    Override Sub InitializeComponent()
        Width = 240
        Height = 160
        Caption = "テスト"

        GroupBox1.Left = 8
        GroupBox1.Top = 8
        GroupBox1.Width = 200
        GroupBox1.Height = 100
        GroupBox1.Caption = "囲み"
        AddControl(GroupBox1)
    End Sub
End Class

Dim mainForm As Form1
Dim r As Long

mainForm.Show()
r = 0
GetClassName(mainForm.GroupBox1.Handle, VarPtr(g_cls), 16)
If lstrcmpi(VarPtr(g_cls), "Button") = 0 And (GetWindowLong(mainForm.GroupBox1.Handle, GWL_STYLE) And &HF) = BS_GROUPBOX Then r = r + 100
GetWindowText(mainForm.GroupBox1.Handle, VarPtr(g_text), 64)
If lstrcmp(VarPtr(g_text), "囲み") = 0 Then r = r + 10
mainForm.GroupBox1.SetCaption("変えた")
GetWindowText(mainForm.GroupBox1.Handle, VarPtr(g_text), 64)
If lstrcmp(VarPtr(g_text), "変えた") = 0 Then r = r + 1
PostMessage(mainForm.Handle, WM_CLOSE, 0, 0)
Application.Initialize()
Application.Run(mainForm)
ExitProcess(r)
