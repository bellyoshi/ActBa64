' Expect: 63
' Target: actba64
' クラスの関数ポインタのフィールド、AddressOf(メソッド)、name[n] の配列フィールド（値は先頭アドレス）、メソッド内の field.x = ...
#console
Type R
    a As Word
    b As Word
End Type

Dim g As Long

Sub Hit(n As Long)
    g = g + n
End Sub

Class K
Private
    r As R
    buf[15] As Byte
    cb As *Sub(n As Long)
    Sub Own(n As Long)
        g = g + 100
    End Sub
Public
    Sub K()
        cb = AddressOf(Hit)
        r.a = 3
        r.b = 5
        lstrcpy(buf, "abcdefghi")
    End Sub
    Sub Fire(n As Long)
        cb(n)
    End Sub
    Function OwnAddr() As Long
        OwnAddr = AddressOf(Own)
    End Function
    Function Sum() As Long
        Sum = r.a + r.b + lstrlen(buf)
    End Function
End Class

Dim k As K
Dim r As Long
r = 0
k.Fire(1)
If g = 1 Then r = r + 1
If k.Sum() = 17 Then r = r + 2
If k.OwnAddr() <> 0 Then r = r + 4
If SizeOf(K) >= 12 Then r = r + 8
k.Fire(15)
If g = 16 Then r = r + 16
r = r + 32
ExitProcess(r)
