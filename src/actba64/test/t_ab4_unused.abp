' Expect: 0
' Target: actba64
' 呼ばれない手続きの中の誤り（未定義の名前など）は報告しない（AB 4 は使わない手続きをコンパイルしない）。
' 関数名は大文字小文字を区別しない（printf も Printf で呼べる）
#console

Function NeverCalled() As Long
    NeverCalled = calloc2(3) + ProgramName
End Function

Function AlsoUnused() As Long
    AlsoUnused = NeverCalled() + undefinedThing(1)
End Function

Class Unused
Public
    v As Long
    Function Bad() As Long
        Bad = FASLE
    End Function
End Class

Function twice(a As Long) As Long
    twice = a * 2
End Function

If Twice(21) <> 42 Then ExitProcess(1)
If TWICE(1) <> 2 Then ExitProcess(2)
ExitProcess(0)
