' Expect: 42
' Target: actba64
#console
Dim a As Long
Dim s As String
Dim t As String

' As Word 切り捨て
a = &H12345678 As Word
If a <> &H5678 Then ExitProcess(1)

' 複合代入 / ++ / --
a = 10
a += 5
If a <> 15 Then ExitProcess(2)
a *= 2
If a <> 30 Then ExitProcess(3)
a \= 3
If a <> 10 Then ExitProcess(4)
a -= 1
If a <> 9 Then ExitProcess(5)
a++
If a <> 10 Then ExitProcess(6)
a--
If a <> 9 Then ExitProcess(7)
a And= 8
If a <> 8 Then ExitProcess(8)
a Or= 1
If a <> 9 Then ExitProcess(9)
a Xor= 1
If a <> 8 Then ExitProcess(10)
a <<= 1
If a <> 16 Then ExitProcess(11)
a >>= 2
If a <> 4 Then ExitProcess(12)
a Mod= 3
If a <> 1 Then ExitProcess(13)

' 文字列 + と &
s = "ab" + "cd"
t = "ab" & "cd"
If s <> t Then ExitProcess(14)
If s <> "abcd" Then ExitProcess(15)

' 辞書順比較（短い方が小さい）
If "abc" < "abd" Then
Else
    ExitProcess(16)
End If
If "ab" < "abc" Then
Else
    ExitProcess(17)
End If
If ("aa" > "a") <> -1 Then ExitProcess(18)

s += "!"
If s <> "abcd!" Then ExitProcess(19)

ExitProcess(42)
