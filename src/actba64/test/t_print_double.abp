' Expect: 0
' Target: actba64
' Skip32: 1
#console
Dim d As Double
Dim s As String

d = 1.5
s = StrD$(d)
If s <> "1.5" Then ExitProcess(1)

d = 2
s = StrD$(d)
If s <> "2" Then ExitProcess(2)

d = 0 - 3.25
s = StrD$(d)
If s <> "-3.25" Then ExitProcess(3)

d = 0
s = StrD$(d)
If s <> "0" Then ExitProcess(4)

' Print 経路（クラッシュしないこと）
Print d
ExitProcess(0)
