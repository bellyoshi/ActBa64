' Expect: 0
' Target: actba64
#console
Dim d As Double
Dim s As String

d = 1.5
s = StrD$(d)
If s <> "1.5" Then ExitProcess(1)

d = 2
s = StrD$(d)
If s <> "2" Then ExitProcess(2)

d = 0 - 3.25
s = StrD$(d)
If s <> "-3.25" Then ExitProcess(3)

d = 0
s = StrD$(d)
If s <> "0" Then ExitProcess(4)

d = 1.5
Open "t_print_double.txt" For Output As 1
Print #1, d
Close 1
Open "t_print_double.txt" For Input As 1
Input #1, s
If s <> "1.5" Then ExitProcess(5)
Close 1

Print d
ExitProcess(0)
