' Expect: 7
' Target: actba64
' Print # の Byte 配列と *Byte は数値ではなく中身の文字列を書く（ActiveBasic と同じ）
#console

Sub WriteLocal()
    Dim b[30] As Byte
    lstrcpy(b, "local")
    Open "t_print_file_cstr.txt" For Output As 2
    Print #2, b
    Close 2
End Sub

Dim g[30] As Byte
Dim p As *Byte
Dim s As String
Dim r As Long
r = 0
lstrcpy(g, "abc")
p = "xyz"
Open "t_print_file_cstr.txt" For Output As 2
Print #2, g
Print #2, p
Close 2
Open "t_print_file_cstr.txt" For Input As 2
Input #2, s
If s = "abc" Then r = r + 1
Input #2, s
If s = "xyz" Then r = r + 2
Close 2
WriteLocal()
Open "t_print_file_cstr.txt" For Input As 2
Input #2, s
If s = "local" Then r = r + 4
Close 2
Kill "t_print_file_cstr.txt"
ExitProcess(r)
