' Expect: 0
' Target: actba64
' ByVal String param must survive Collect inside callee
#console

Function Keep$(s As String) As String
    Dim i As Long
    Dim junk As String
    Keep$ = ""
    For i = 1 To 200
        junk = junk + Str$(i)
        If Len(junk) > 40 Then junk = Mid$(junk, 1, 20)
    Next
    Keep$ = s
End Function

Dim i As Long
Dim r As String
Dim pad As String

pad = "pad"
For i = 1 To 1000
    pad = pad + "y"
    If Len(pad) > 50 Then pad = Mid$(pad, 1, 25)
    r = Keep$(Mid$("Language=ja", 10))
    If r <> "ja" Then
        Print "fail"
        Print r
        Print Str$(i)
        ExitProcess(1)
    End If
Next
Print "ok"
ExitProcess(0)
End
