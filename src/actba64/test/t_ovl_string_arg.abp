' Expect: 0
' Target: actba64
' 重ねた定義（Long / String）は String の変数・式・配列の要素で String の方を選ぶ（ByVal / ByRef とも）
#console
Function OvA(lp As Long) As Long
    OvA = 1
End Function
Function OvA(s As String) As Long
    OvA = 2
End Function
Function OvB(ByRef lp As Long) As Long
    OvB = 1
End Function
Function OvB(ByRef s As String) As Long
    s = "set"
    OvB = 2
End Function
Dim s As String
Dim arr(2) As String
Dim n As Long
If OvA(n) <> 1 Then ExitProcess(1)
If OvA(s) <> 2 Then ExitProcess(2)
If OvA(s + "x") <> 2 Then ExitProcess(3)
If OvA(arr(1)) <> 2 Then ExitProcess(4)
If OvA(Left$(s, 1)) <> 2 Then ExitProcess(5)
If OvB(n) <> 1 Then ExitProcess(6)
If OvB(s) <> 2 Then ExitProcess(7)
If s <> "set" Then ExitProcess(8)
ExitProcess(0)
