' Expect: 0
' Target: actba64
' VoidPtr の C 文字列と String は中身で比べる。未選択の空文字はパスと一致しない。
#console

Dim buf(8) As Byte
Dim p As VoidPtr
Dim s As String
Dim name[1] As String
Type Box
    lpstrFile As VoidPtr
End Type
Dim box As Box

buf[0] = Asc("a")
buf[1] = 0
p = VarPtr(buf)
box.lpstrFile = p

s = ""
If p = s Then ExitProcess(1)
If s = p Then ExitProcess(2)
If box.lpstrFile = name[1] Then ExitProcess(3)

s = "a"
If p <> s Then ExitProcess(4)
If s <> p Then ExitProcess(5)

name[0] = box.lpstrFile
If name[0] <> box.lpstrFile Then ExitProcess(6)
buf[0] = Asc("b")
If name[0] <> "a" Then ExitProcess(7)
If name[0] = box.lpstrFile Then ExitProcess(8)

ExitProcess(0)
