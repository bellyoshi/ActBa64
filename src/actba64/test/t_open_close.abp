' Expect: 0
' Target: actba64
#console
#include "../FileIO.abp"

Dim path As String
Dim path2 As String

path = "bin/test_out/t_open_close.txt"
path2 = "bin/test_out/t_open_close2.txt"

If WriteTextFile(path, "x") = 0 Then
    ExitProcess(1)
End If
If WriteTextFile(path2, "y") = 0 Then
    ExitProcess(1)
End If

Open path For Input As 1
Close 1

Open path For Input As 1
Close 1

Open path2 For Input As #2
Close #2

Open path For Input As 1
Open path2 For Input As 2
Close

ExitProcess(0)
