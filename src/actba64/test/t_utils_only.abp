' Expect: 0
' Target: actba64
' StrUtils smoke (CharUtils required)
#console
#include "..\CharUtils.abp"
#include "..\StrUtils.abp"

Dim d As String

If Trim$("  ab  ") <> "ab" Then
    ExitProcess(1)
End If
If Lower$("AbC") <> "abc" Then
    ExitProcess(2)
End If
If InStr(1, "foo#bar", "#") <> 4 Then
    ExitProcess(3)
End If
If StrEqCI("Ab", "aB") = 0 Then
    ExitProcess(4)
End If
If StartsWith("foobar", "foo") = 0 Then
    ExitProcess(5)
End If
If StartsWithCI("Foobar", "foo") = 0 Then
    ExitProcess(6)
End If
If InStrCI("AbCdEf", "cde") <> 3 Then
    ExitProcess(7)
End If
If BaseName$("dir/name.abp") <> "dir/name" Then
    ExitProcess(8)
End If
d = DirOf$("dir/name.abp")
If d <> "dir/" Then
    ExitProcess(9)
End If
If FileNameOnly$("dir/name.abp") <> "name.abp" Then
    ExitProcess(10)
End If
If EndsWithExt("a.Abp", ".abp") = 0 Then
    ExitProcess(11)
End If
If ChangeExtension$("x.abp", ".asm") <> "x.asm" Then
    ExitProcess(12)
End If
ExitProcess(0)
