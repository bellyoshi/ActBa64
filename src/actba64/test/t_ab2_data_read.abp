' Expect: 0
' Target: actba64
' Option: -pAB2
' -pAB2: Data は後ろにあっても Read できる。Read 配列(i) / Read a$, b。On Error Goto は読み飛ばす。
' 括弧なしの CurDir$ / CmdLine$。KLen / KMid$ は文字単位
#console
On Error Goto *ErrorHappen
Dim A$ As String
Dim B As Long
Dim C$(2) As String
Dim I As Long
For I=0 To 1
    Read C$(I)
Next
Read A$, B
If C$(0)<>"x" Then ExitProcess(1)
If C$(1)<>"yy" Then ExitProcess(2)
If A$<>"z" Then ExitProcess(3)
If B<>-5 Then ExitProcess(4)
If Len(CurDir$)=0 Then ExitProcess(5)
If Right$(CurDir$,1)<>"\" Then ExitProcess(6)
If CmdLine$<>"" Then ExitProcess(7)
If KLen("aあb")<>3 Then ExitProcess(8)
If KMid$("aあb",2,1)<>"あ" Then ExitProcess(9)
If KMid$("aあb",3)<>"b" Then ExitProcess(10)
ExitProcess(0)
Data "x","yy"
Data "z",-5
*ErrorHappen
ExitProcess(99)
