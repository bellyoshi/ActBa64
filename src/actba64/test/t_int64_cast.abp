' Expect: 0
' Target: actba64
' 式の中の x As QWord / x As Int64（-actba32 も 64bit に広げる）
' DWord は 0 で、Long は符号で広げる。64bit どうしはそのまま。RGBALib の lengthQWord と同じ書き方
#console
Function Check(cond As Long, code As Long) As Long
    Check = 0
    If cond = 0 Then
        Print "fail "; code
        Check = 1
    End If
End Function

Function Join(lo As DWord, hi As DWord) As QWord
    Join = lo Or (hi As QWord) << 32
End Function

Dim lo As DWord, hi As DWord, dw As DWord
Dim l As Long
Dim u As QWord
Dim x As Int64
Dim d As Double
Dim bad As Long
bad = 0

lo = 5
hi = 3
u = lo Or (hi As QWord) << 32
bad = bad + Check(Str$(u) = "12884901893", 1)
bad = bad + Check(Str$(Join(&HFFFFFFFF, &HFFFFFFFF)) = "18446744073709551615", 2)
bad = bad + Check(Str$(Join(0, 1)) = "4294967296", 3)

' DWord は 0 で広げる
dw = &HFFFFFFFF
x = (dw As Int64) + 1
bad = bad + Check(Str$(x) = "4294967296", 4)

' Long は符号で広げる
l = -1
x = (l As Int64) * 4294967296
bad = bad + Check(Str$(x) = "-4294967296", 5)
u = (l As QWord)
bad = bad + Check(Str$(u) = "18446744073709551615", 6)

' 32bit どうしの積を 64bit で
l = 100000
x = (l As Int64) * l
bad = bad + Check(Str$(x) = "10000000000", 7)

' 比較
bad = bad + Check((hi As QWord) << 32 > &HFFFFFFFF, 8)

' 64bit どうし・実数との変換
x = -2
u = (x As QWord)
bad = bad + Check(Str$(u) = "18446744073709551614", 9)
d = (hi As QWord) << 32
bad = bad + Check(d = 12884901888.0, 10)

If bad = 0 Then Print "ok"
ExitProcess(bad)
