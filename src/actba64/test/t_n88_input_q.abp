' Expect: 0
' Target: actba64
' #n88basic: プロンプトの無い Input n は窓に "? " を出してから待つ（待ち始めの桁は 2）。
' 入力中は入力位置にキャレット（点滅するカーソル）を出し、Enter で消す。Input "x", n は "? " を出さない
#n88basic
Dim g_qX As Long
Dim g_qCaret As Long
Dim n As Double
Dim sa As SECURITY_ATTRIBUTES
Dim tid As DWord
Dim th As HANDLE

Sub QWaitInput()
    While g_n88InputOn = 0
        Sleep(1)
    Wend
End Sub

Function QFeed(param As VoidPtr) As Long
    Dim i As Long
    QWaitInput()
    i = 0
    While g_n88CaretOn = 0 And i < 2000
        Sleep(1)
        i = i + 1
    Wend
    g_qX = g_n88CurX
    g_qCaret = g_n88CaretOn
    N88_OnEnter()
    If param = 0 Then QFeed = 0
End Function

N88_ZeroSa(sa)
th = CreateThread(sa, 0, AddressOf(QFeed), 0, 0, VarPtr(tid))
If th = 0 Then ExitProcess(9)
Input n
If g_qX <> 2 Then ExitProcess(10 + g_qX)
If g_qCaret = 0 Then ExitProcess(3)
Sleep(200)
If g_n88CaretOn <> 0 Then ExitProcess(4)
th = CreateThread(sa, 0, AddressOf(QFeed), 0, 0, VarPtr(tid))
Input "x", n
If g_qX <> 1 Then ExitProcess(20 + g_qX)
ExitProcess(0)
