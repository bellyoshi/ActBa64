' Expect: 7
' Target: actba64
#console

Class Base
    Public
    x As Long

    Sub Base(n As Long)
        x = n
    End Sub

    Sub SetX(n As Long)
        x = n
    End Sub
End Class

Class Child
    Inherits Base
    Public

    Function GetX() As Long
        GetX = x
    End Function

    Sub Child(n As Long)
        Super.Base(0)
        Super.SetX(n)
    End Sub
End Class

Dim c As Child(7)
ExitProcess(c.GetX())
