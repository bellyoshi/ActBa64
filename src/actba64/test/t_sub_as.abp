' Expect: 5
' Target: actba64
' Sub の後ろの As 型と、呼び出しの末尾の空引数 f(a, b,) を ActiveBasic と同じく読み飛ばす
#console
Dim g As Long

Sub AddG(n As Long) As Long
    g = g + n
End Sub

Class C
Public
    v As Long
    Sub SetV(n As Long) As DWord
        v = n
    End Sub
End Class

Function Two(a As Long, b As Long) As Long
    Two = a + b
End Function

Dim c As C
AddG(1)
c.SetV(2,)
g = g + c.v
g = g + Two(1, 3,) - 3
ExitProcess(g + lstrlen("ab",) - 1)
