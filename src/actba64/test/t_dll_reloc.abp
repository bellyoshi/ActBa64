' Target: actba64
' Expect: 0
' Prebuild: t_dll_lib.pj
' 優先ベースを予約してから LoadLibrary し、.reloc で動くことを見る。
Declare Function RelLoad Lib "kernel32.dll" Alias "LoadLibraryA" (name As *Byte) As *Byte
Declare Function RelProc Lib "kernel32.dll" Alias "GetProcAddress" (h As *Byte, name As *Byte) As *Byte
Declare Function RelAlloc Lib "kernel32.dll" Alias "VirtualAlloc" (addr As *Byte, sz As DWord, typ As DWord, prot As DWord) As *Byte

Dim addr As *Byte
Dim raw(7) As Byte
Dim h As *Byte
Dim got As *Byte
Dim fp As *Function() As Long
Dim n As Long
Dim i As Long

i = 0
While i < 8
    raw[i] = 0
    i = i + 1
Wend
#ifdef _WIN64
raw[3] = &H80
raw[4] = 1
memcpy(VarPtr(addr), VarPtr(raw), 8)
#else
raw[3] = &H10
memcpy(VarPtr(addr), VarPtr(raw), 4)
#endif
If RelAlloc(addr, &H100000, &H2000, 1) = 0 Then ExitProcess(2)
h = RelLoad("t_dll_lib.dll")
If h = 0 Then ExitProcess(3)
got = RelProc(h, "SampleFuncName")
If got = 0 Then ExitProcess(4)
fp = got
n = fp()
If n <> 123456 Then ExitProcess(5)
ExitProcess(0)
