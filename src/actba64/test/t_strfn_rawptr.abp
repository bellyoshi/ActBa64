' Expect: 255
' Target: actba64
' Left$ / Mid$ / Right$ と文字列連結は API が返す生の文字列ポインタ（長さヘッダなし）も NUL までで扱う
#console
Dim b[32] As Byte
Dim i As Long
For i = 0 To 31
    b[i] = &HFF
Next
Dim p As BytePtr
p = VarPtr(b[8])
lstrcpy(p, "wxyz")
Dim r As Long
r = 0
If Right$(p, 2) = "yz" Then r = r + 1
If Left$(p, 2) = "wx" Then r = r + 2
If Mid$(p, 2, 2) = "xy" Then r = r + 4
If Mid$(p, 3) = "yz" Then r = r + 8
If Right$(p, 9) = "wxyz" Then r = r + 16
If Right$(GetCommandLine(), 1) <> "" Then r = r + 32
If p + "!" = "wxyz!" Then r = r + 64
If "<" + p = "<wxyz" Then r = r + 128
ExitProcess(r)
