' Expect: 63
' Target: actba64
' Double / Single の Mod は、両辺を整数に切り捨ててから余りを取る（ActiveBasic と同じ）。結果は整数
#console
Dim d As Double
Dim f As Single
Dim n As Long
Dim m As Long
Dim r As Long
r = 0
m = 1.5 Mod 2
If m = 1 Then r = r + 1
m = 0.5 Mod 2
If m = 0 Then r = r + 2
d = 7.9
m = d Mod 3
If m = 1 Then r = r + 4
n = 7
m = n Mod 2.9
If m = 1 Then r = r + 8
f = 10.5
m = f Mod 4
If m = 2 Then r = r + 16
d = 7.9
If d Mod 3 = 1 Then r = r + 32
ExitProcess(r)
