#console
Type D3D11_INPUT_ELEMENT_DESC
	SemanticName As BytePtr
	SemanticIndex As DWord
	Format As DWord
	InputSlot As DWord
	AlignedByteOffset As DWord
	InputSlotClass As DWord
	InstanceDataStepRate As DWord
End Type
Dim a[1] As D3D11_INPUT_ELEMENT_DESC
Dim p0 As Long
Dim p1 As Long
p0 = VarPtr(a[0])
p1 = VarPtr(a[1])
Print SizeOf(D3D11_INPUT_ELEMENT_DESC)
Print p1 - p0
ExitProcess(0)
