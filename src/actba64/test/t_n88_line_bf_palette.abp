' Expect: 0
' Target: actba64
' Option: -pN88
' -pN88: LINE ...,c1,BF,c2（枠 c1・中 c2）、COLOR = (p,&Hgrb)、既定のパレット 8〜15
10 COLOR = (10,&H8A0)
20 LINE(10,10)-(50,50),0,BF,7
30 LINE(60,10)-(100,50),1,BF,10
40 LINE(110,10)-(150,50),2,BF
50 PSET(200,200),11
60 LINE(210,10)-(250,50),4,BF,SHIBA$
70 IF GETPIXEL(G_N88MEMDC,30,30)<>&HFFFFFF THEN EXITPROCESS 1
80 IF GETPIXEL(G_N88MEMDC,10,30)<>0 THEN EXITPROCESS 2
90 IF GETPIXEL(G_N88MEMDC,80,30)<>&H0088AA THEN EXITPROCESS 3
100 IF GETPIXEL(G_N88MEMDC,60,30)<>&HFF0000 THEN EXITPROCESS 4
110 IF GETPIXEL(G_N88MEMDC,130,30)<>&H0000FF THEN EXITPROCESS 5
120 IF GETPIXEL(G_N88MEMDC,200,200)<>&HAA00AA THEN EXITPROCESS 6
130 IF GETPIXEL(G_N88MEMDC,230,30)<>&H00FF00 THEN EXITPROCESS 7
140 EXITPROCESS 0
