' Expect: 0
' Target: actba64
#console

Dim g_n As Long
Dim g_d As Long

Class Box
    Public
    n As Long
    Sub Box(v As Long)
        n = v
        g_n = g_n + 1
    End Sub
    Sub ~Box()
        g_d = g_d + 1
    End Sub
    Function GetN() As Long
        GetN = n
    End Function
End Class

Dim p As *Box
p = New Box(10)
If p->GetN() <> 10 Then ExitProcess(1)
Delete p
If g_n <> 1 Then ExitProcess(2)
If g_d <> 1 Then ExitProcess(3)

Dim q As *Box
q = New [3] Box(7)
If q->GetN() <> 7 Then ExitProcess(4)
Delete q
If g_n <> 4 Then ExitProcess(5)
If g_d <> 4 Then ExitProcess(6)

Dim z As *Box
z = 0
Delete z
ExitProcess(0)
