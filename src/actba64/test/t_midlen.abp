' Expect: 0
' Target: actba64
' Mid$ length after InStr (no file I/O)
#console
#include "..\ByteCharUtils.abp"
#include "..\StrUtils.abp"

Dim text As String
Dim oneLine As String
Dim eq As Long

text = "ab#PLATFORM=32!!!!!!!!zz"
eq = InStr(1, text, "#PLATFORM=")
If eq <= 0 Then
    ExitProcess(1)
End If
oneLine = Mid$(text, eq, 20)
If Len(oneLine) <> 20 Then
    ExitProcess(2)
End If
ExitProcess(0)
