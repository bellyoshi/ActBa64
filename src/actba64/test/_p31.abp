#console
' minimal InStr clone
Function MyInStr(start As Long, hay As String, needle As String) As Long
    Dim nh As Long
    Dim nn As Long
    MyInStr = 0
    nh = Len(hay)
    nn = Len(needle)
    If nh = 0 Then Exit Function
    If nn = 0 Then
        MyInStr = start
        Exit Function
    End If
    MyInStr = 1
End Function
Dim tmp As String
Dim eq As Long
tmp = "#PLATFORM=32"
eq = MyInStr(1, "xx#PLATFORM=32yy", "#PLATFORM=")
ExitProcess(Len(Lower$(tmp)))
End
