' Expect: 0
' Target: actba64
' PLATFORM key/value parse (no file I/O)
#console
#include "..\CharUtils.abp"
#include "..\StrUtils.abp"

Dim text As String
Dim oneLine As String
Dim eq As Long
Dim value As String
Dim key As String
Dim tmp As String
Dim n As Long

text = "xx#PLATFORM=32yy"
eq = InStr(1, text, "#PLATFORM=")
If eq <= 0 Then
    ExitProcess(1)
End If
oneLine = Mid$(text, eq, 12)
If oneLine <> "#PLATFORM=32" Then
    ExitProcess(2)
End If

tmp = "#PLATFORM=32"
eq = InStr(1, tmp, "=")
n = Len(tmp) - eq
value = Mid$(tmp, eq + 1, n)
If value <> "32" Then
    ExitProcess(4)
End If
n = eq - 1
key = Lower$(Mid$(tmp, 1, n))
If key <> "#platform" Then
    ExitProcess(3)
End If
ExitProcess(0)
