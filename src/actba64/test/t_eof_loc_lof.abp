' Expect: 0
' Target: actba64
#console

Dim s As String
Dim n As Long

Open "t_eof_in.txt" For Output As 1
Print #1, "ab";
Close 1

Open "t_eof_in.txt" For Input As 1
If Eof(1) = -1 Then ExitProcess(1)
Input #1, s
If s <> "ab" Then ExitProcess(2)
If Eof(1) <> -1 Then ExitProcess(3)
If Loc(1) <> 3 Then ExitProcess(4)
If Lof(1) <> 2 Then ExitProcess(5)
Close 1

ExitProcess(0)
