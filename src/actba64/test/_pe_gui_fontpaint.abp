' Target: actba64
' GUI: SetWindowText 後に本物に近い WM_PAINT（BeginPaint + AddFontResourceEx + CreateFont）
#USEWINDOW=1

Const FR_PRIVATE = &H10

Declare Function AddFontResourceExA Lib "gdi32.dll" (ByVal lpszFilename As String, ByVal fl As Long, ByVal pdv As Long) As Long

Function WndProc(hWnd As HWND, message As DWord, wParam As WPARAM, lParam As LPARAM) As DWord
    Select Case message
        Case WM_PAINT
            Dim ps As PAINTSTRUCT
            Dim hDC As HDC
            Dim hFont As HFONT
            Dim hOld As HFONT
            Dim rc As RECT
            hDC = BeginPaint(hWnd, ps)
            AddFontResourceExA("fonts\UDEVGothic-Regular.ttf", FR_PRIVATE, 0)
            hFont = CreateFont(-16,0,0,0,400,0,0,0,1,3,2,1,49,"Consolas")
            hOld = SelectObject(hDC, hFont)
            GetClientRect(hWnd, rc)
            SelectObject(hDC, hOld)
            DeleteObject(hFont)
            EndPaint(hWnd, ps)
        Case WM_SIZE
            InvalidateRect(hWnd, ByVal 0, TRUE)
        Case WM_DESTROY
            PostQuitMessage(0)
            WndProc = 0
            Exit Function
    End Select
    Select Case message
        Case WM_CREATE
            SetMenu(hWnd, CreateMenu())
            SetWindowText(hWnd, "editor - (untitled) [64bit, UTF-8]")
        Case Else
            WndProc = DefWindowProc(hWnd, message, wParam, lParam)
            Exit Function
    End Select
    WndProc = 0
End Function

Dim wc As WNDCLASSEX
FillMemory(VarPtr(wc), Len(wc), 0)
wc.cbSize = Len(wc)
wc.hInstance = GetModuleHandle(0)
wc.style = CS_HREDRAW Or CS_VREDRAW
wc.hCursor = LoadCursor(NULL, MAKEINTRESOURCE(IDC_ARROW))
wc.lpszClassName = "NORMAL0"
wc.lpfnWndProc = AddressOf(WndProc)
wc.hbrBackground = CreateSolidBrush(GetSysColor(COLOR_3DFACE))
RegisterClassEx(wc)

CreateWindowEx(&H00000000, "NORMAL0", "editor", &H10cf0000, -2147483648, -2147483648, 495, 367, 0, 0, GetModuleHandle(0), 0)

Dim msg As MSG
Dim r As Long
Do
    r = GetMessage(msg, 0, 0, 0)
    If r = 0 Then Exit Do
    If r = -1 Then Exit Do
    TranslateMessage(msg)
    DispatchMessage(msg)
Loop
End
