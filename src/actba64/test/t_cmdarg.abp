' Expect: 0
' Target: actba64
#console

Function CmdArg$(ByVal index As Long) As String
    Dim cmd As *Byte
    Dim i As Long
    Dim n As Long
    Dim c As Byte
    Dim argi As Long
    Dim out As *Byte
    Dim m As Long
    Dim inQuote As Long

    CmdArg$ = ""
    cmd = GetCommandLine()
    If cmd = 0 Then Exit Function
    n = lstrlen(cmd)
    If n <= 0 Then Exit Function
    out = malloc(n + 1)
    If out = 0 Then Exit Function

    i = 0
    argi = 0
    While i < n
        While i < n
            c = cmd[i]
            If c <> 32 And c <> 9 Then Exit While
            i = i + 1
        Wend
        If i >= n Then Exit While

        m = 0
        inQuote = 0
        If cmd[i] = 34 Then
            inQuote = 1
            i = i + 1
        End If
        While i < n
            c = cmd[i]
            If inQuote <> 0 Then
                If c = 34 Then
                    i = i + 1
                    Exit While
                End If
            Else
                If c = 32 Or c = 9 Then Exit While
            End If
            out[m] = c
            m = m + 1
            i = i + 1
        Wend
        out[m] = 0
        If argi = index Then
            CmdArg$ = Enc_DupCStr$(out, m)
            free(out)
            Exit Function
        End If
        argi = argi + 1
    Wend
    free(out)
End Function

Function Enc_DupCStr$(ByVal p As *Byte, ByVal n As Long) As String
    Dim s As String
    Enc_DupCStr$ = ""
    If p = 0 Then Exit Function
    If n <= 0 Then Exit Function
    s = MakeStr(p)
    Enc_DupCStr$ = Mid$(s, 1, n)
End Function

Dim a0 As String
Dim a1 As String
a0 = CmdArg$(0)
a1 = CmdArg$(1)
If Len(a0) = 0 Then
    ExitProcess(1)
End If
If Len(a1) <> 0 Then
    ExitProcess(2)
End If
ExitProcess(0)
End
