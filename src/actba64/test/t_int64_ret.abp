' Expect: 0
' Target: actba64
' Function / メソッド / Declare の As Int64 / As QWord の戻り値（64bit 出力と -actba32）
#console
Declare Function GetTickCount64 Lib "kernel32" () As QWord

Class C
Public
    Function Big() As Int64
        Big = 7000000000
    End Function
    Function Neg(v As Int64) As Int64
        Neg = -v
    End Function
End Class

Function F() As Int64
    F = 3000000000
End Function

Function G(n As Long) As Int64
    G = n
End Function

Function Fact(n As Long) As Int64
    If n <= 1 Then
        Fact = 1
    Else
        Fact = n * Fact(n - 1)
    End If
End Function

Function AllOnes() As QWord
    AllOnes = &HFFFFFFFFFFFFFFFF
End Function

Function Check(cond As Long, code As Long) As Long
    Check = 0
    If cond = 0 Then
        Print "fail "; code
        Check = 1
    End If
End Function

Dim c As C, x As Int64, l As Long, t As QWord, u As QWord
Dim bad As Long
bad = 0
bad = bad + Check(Str$(F()) = "3000000000", 1)
bad = bad + Check(Str$(F() * 2) = "6000000000", 2)
bad = bad + Check(Str$(G(-5)) = "-5", 3)
bad = bad + Check(Str$(Fact(20)) = "2432902008176640000", 4)
x = F() + c.Big()
bad = bad + Check(Str$(x) = "10000000000", 5)
bad = bad + Check(Str$(c.Neg(x)) = "-10000000000", 6)
l = F()
bad = bad + Check(l = -1294967296, 7)
bad = bad + Check(F() > 2147483647, 8)
u = 1
bad = bad + Check(AllOnes() > u, 9)
t = GetTickCount64()
bad = bad + Check(t > 0, 10)
If bad = 0 Then Print "ok"
ExitProcess(bad)
