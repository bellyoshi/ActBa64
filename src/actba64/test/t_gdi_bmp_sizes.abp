' Expect: 1111
' Target: actba64
' Skip32: 1
#console
' Win32 の構造体の 16bit のメンバは Word（Integer はこのコンパイラでは 4 バイト）。
' 大きさが Windows と違うと CreateDIBSection などが失敗する

Dim r As Long
Dim bi As BITMAPINFO
Dim bits As VoidPtr
Dim h As HBITMAP

If SizeOf(BITMAPINFOHEADER) = 40 Then r = r + 1000
If SizeOf(BITMAPFILEHEADER) = 14 Then r = r + 100
If SizeOf(BITMAP) = 32 Then r = r + 10          ' 64bit: Long x4 + Word x2 + 余白 4 + bmBits 8

bi.bmiHeader.biSize = SizeOf(BITMAPINFOHEADER)
bi.bmiHeader.biWidth = 4
bi.bmiHeader.biHeight = -2
bi.bmiHeader.biPlanes = 1
bi.bmiHeader.biBitCount = 32
bi.bmiHeader.biCompression = BI_RGB
h = CreateDIBSection(0, bi, DIB_RGB_COLORS, bits, 0, 0)
If h <> 0 And bits <> 0 Then r = r + 1
If h <> 0 Then DeleteObject(h)
ExitProcess(r)

Declare Function CreateDIBSection Lib "gdi32.dll" (hdc As HDC, ByRef pbmi As BITMAPINFO, usage As DWord, ByRef ppvBits As VoidPtr, hSection As HANDLE, offset As DWord) As HBITMAP
