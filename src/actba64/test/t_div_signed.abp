' Expect: 255
' Target: actba64
' Mod と \ は符号付きで割る（ActiveBasic と同じ）。商は 0 に向けて切り捨て、余りは割られる数と同じ符号
#console
Dim a As Long
Dim b As Long
Dim r As Long
r = 0
a = -7
b = 3
If a Mod b = -1 Then r = r + 1
b = 2
If a \ b = -3 Then r = r + 2
a = 7
b = -2
If a \ b = -3 Then r = r + 4
If a Mod b = 1 Then r = r + 8
a = -7
b = -2
If a \ b = 3 And a Mod b = -1 Then r = r + 16
If -7 Mod 3 = -1 Then r = r + 32
If -7 \ 2 = -3 Then r = r + 64
a = 7
b = 3
If a \ b = 2 And a Mod b = 1 Then r = r + 128
ExitProcess(r)
