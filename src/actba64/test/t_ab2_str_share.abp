' Expect: 0
' Target: actba64
' Option: -pAB2
' -pAB2: 代入で同じ文字列を持つ変数（a = PatNul）を API の書き込み先に渡しても、ほかの変数は変わらない（AB2 の代入は複製）
#console
Dim PatNul As String
Dim a As String
Dim b As String
Dim e1 As Long
Dim e2 As Long
PatNul = String$(10, Chr$(0))
a = PatNul
b = PatNul
lstrcpy(a, "35")
lstrcpy(b, "29")
If Val(a) <> 35 Then ExitProcess(1)
If Val(b) <> 29 Then ExitProcess(2)
If Asc(PatNul) <> 0 Then ExitProcess(3)
e1 = CreateWindowEx(0, "EDIT", "139", 0, 0, 0, 10, 10, 0, 0, 0, 0)
e2 = CreateWindowEx(0, "EDIT", "44", 0, 0, 0, 10, 10, 0, 0, 0, 0)
a = PatNul
b = PatNul
GetWindowText(e1, a, 10)
GetWindowText(e2, b, 10)
If Val(a) <> 139 Then ExitProcess(4)
If Val(b) <> 44 Then ExitProcess(5)
If Len(a) <> 10 Then ExitProcess(6)
ExitProcess(0)
