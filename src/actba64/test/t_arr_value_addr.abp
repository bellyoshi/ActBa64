' Expect: 63
' Target: actba64
' 配列名を値として使うと先頭アドレス（ActiveBasic と同じ）。VoidPtr やフィールドへの代入でも中身ではなくアドレスを入れる
#console
Type T
    v As Long
    f As VoidPtr
End Type

Dim b[30] As Byte
Dim l[3] As Long
Dim t As T
Dim p As VoidPtr
Dim q As *Byte
Dim n As Long
Dim r As Long
lstrcpy(b, "abc")
l[0] = 5
r = 0
p = b
If p = VarPtr(b[0]) Then r = r + 1
t.f = b
If t.f = VarPtr(b[0]) Then r = r + 2
q = b
If lstrlen(q) = 3 Then r = r + 4
p = l
If GetDWord(p) = 5 Then r = r + 8
If b = VarPtr(b[0]) Then r = r + 16
n = b[0]
If n = 97 Then r = r + 32
ExitProcess(r)
