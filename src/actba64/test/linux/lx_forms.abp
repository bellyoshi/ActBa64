' Target: actba64
' Forms.sbp の X11 版（libX11.so.6、動的リンク）: Dim で InitializeComponent → Show で窓
' → WM_CREATE → Close が WM_DELETE_WINDOW を自分へ送る → WM_CLOSE → WM_DESTROY → Run が戻る
' X サーバーが要る（WSLg の DISPLAY）
#include <Forms.sbp>

Dim g_log As String
Dim g_title(63) As Byte

Class Form1
    Inherits Form
Private
    Override Sub InitializeComponent()
        Left = 10
        Top = 10
        Width = 200
        Height = 100
        Caption = "テスト"
    End Sub
Public
    Override Function WndProc(msg As DWord, wParam As WPARAM, lParam As LPARAM) As LRESULT
        If msg = WM_CREATE Then
            g_log = g_log + "create "
            This.Close()
        End If
        If msg = WM_CLOSE Then g_log = g_log + "close "
        If msg = WM_DESTROY Then
            g_log = g_log + "destroy"
            FormsGetTitle(Handle, VarPtr(g_title), 64)
        End If
        WndProc = Super.WndProc(msg, wParam, lParam)
    End Function
End Class

Dim mainForm As Form1

Application.Initialize()
Application.Run(mainForm)
Print g_log
Print MakeStr(VarPtr(g_title))
If mainForm.Handle = 0 Then Print "handle cleared"
