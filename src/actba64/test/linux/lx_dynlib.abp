' Target: actba64
' Warn: 0
' Lib が .so の Declare は動的リンク（PT_INTERP / PT_DYNAMIC）。呼び出しは Win64 → SysV の踏み台を通る
' 整数は rdi, rsi, rdx, rcx, r8, r9 の後ろをスタックへ、Double は xmm0..（可変長引数の al も）
#console
Declare Function strlen Lib "libc.so.6" (s As BytePtr) As Long
Declare Function atoi Lib "libc.so.6" (s As BytePtr) As Long
Declare Function getpid Lib "libc.so.6" () As Long
' rand / srand は実行時ルーチンにもあるので Alias で別の名前にする
Declare Sub c_srand Lib "libc.so.6" Alias "srand" (seed As Long)
Declare Function c_rand Lib "libc.so.6" Alias "rand" () As Long
Declare Function snprintf Lib "libc.so.6" (buf As BytePtr, n As Long, fmt As BytePtr, a As Long, x As Double, b As Long, y As Double, c As Long, d As Long, e As Long, f As Long) As Long
Declare Function fmt1 Lib "libc.so.6" Alias "snprintf" (buf As BytePtr, n As Long, fmt As BytePtr, x As Double) As Long
Declare Function ilogb Lib "libm.so.6" (x As Double) As Long
Dim buf(127) As Byte
Dim i As Long, n As Long
Print strlen("hello")
Print atoi("1234") + 1
If getpid() <= 0 Then ExitProcess(1)
c_srand(1)
Print c_rand()
n = snprintf(VarPtr(buf(0)), 128, "%d %.2f %d %.1f %d %d %d %d", 1, 2.5, 3, 4.5, 5, 6, 7, 8)
Print MakeStr(VarPtr(buf(0)))
Print n
fmt1(VarPtr(buf(0)), 128, "%.1f", 3)
Print MakeStr(VarPtr(buf(0)))
For i = 1 To 3
    n = n + ilogb(1024)
Next
Print n
