' Target: actba64
' ファイル（CreateFileA / ReadFile / WriteFile / SetFilePointer / GetFileSize / CloseHandle / GetFileAttributesA）と
' Kill / MkDir / ChDir の Linux 版。行末は LF（Lof が CRLF より 1 行 1 バイト少ない）
#console
Dim s As String, n As Long, buf As String
Open "lx_file.dat" For Output As 1
Print #1, "hello"
Write #1, "abc", 42
Close 1
Open "lx_file.dat" For Append As 1
Print #1, "tail"
Close 1
Open "lx_file.dat" For Input As 2
Print Lof(2)
Input #2, s
Print s
Input #2, s
Input #2, n
Print s; n
Input #2, s
Print s
If Eof(2) <> -1 Then ExitProcess(1)
Close 2
Open "lx_rec.dat" As #3
Field #3, 4
Put #3, 1, "abcd"
Put #3, 3, "wxyz"
Get #3, 1, buf
Print buf
Get #3, 3, buf
Print buf; Lof(3)
Close #3
Kill "lx_file.dat"
Kill "lx_rec.dat"
If GetFileAttributes("lx_file.dat") <> &HFFFFFFFF Then ExitProcess(2)
MkDir "lx_dir"
If (GetFileAttributes("lx_dir") And &H10) = 0 Then ExitProcess(3)
ChDir "lx_dir"
Open "inner.txt" For Output As 1
Print #1, "x"
Close 1
ChDir ".."
If GetFileAttributes("lx_dir/inner.txt") = &HFFFFFFFF Then ExitProcess(4)
Kill "lx_dir/inner.txt"
If RemoveDirectory("lx_dir") = 0 Then ExitProcess(5)
If GetFileAttributes("lx_dir") <> &HFFFFFFFF Then ExitProcess(6)
Print "ok"
