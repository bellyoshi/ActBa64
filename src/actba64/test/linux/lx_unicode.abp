' Target: actba64
' MultiByteToWideChar / WideCharToMultiByte の Linux 版。コードページは何でも UTF-8（Linux に CP932 は無い）
' サロゲートペア、長さだけ数える呼び出し、MB_ERR_INVALID_CHARS
#console
Dim w(31) As Byte
Dim b(31) As Byte
Dim bad(3) As Byte
Dim n As Long

Function W16(i As Long) As Long
    W16 = w(i * 2) + w(i * 2 + 1) * 256
End Function

n = MultiByteToWideChar(65001, 0, "aé日😀", -1, VarPtr(w(0)), 16)
If n <> 6 Then ExitProcess(1)
If W16(0) <> &H61 Or W16(1) <> &HE9 Or W16(2) <> &H65E5 Then ExitProcess(2)
If W16(3) <> &HD83D Or W16(4) <> &HDE00 Or W16(5) <> 0 Then ExitProcess(3)
If MultiByteToWideChar(932, 0, "aé日😀", -1, 0, 0) <> 6 Then ExitProcess(4)
If MultiByteToWideChar(65001, 0, "aé日😀", -1, VarPtr(w(0)), 3) <> 0 Then ExitProcess(5)
n = WideCharToMultiByte(65001, 0, VarPtr(w(0)) As *Word, -1, VarPtr(b(0)), 32, 0, 0)
If n <> 11 Then ExitProcess(6)
If WideCharToMultiByte(932, 0, VarPtr(w(0)) As *Word, 5, 0, 0, 0, 0) <> 10 Then ExitProcess(7)
bad(0) = &H61
bad(1) = &HFF
If MultiByteToWideChar(65001, 8, VarPtr(bad(0)), 2, VarPtr(w(0)), 16) <> 0 Then ExitProcess(8)
If MultiByteToWideChar(65001, 0, VarPtr(bad(0)), 2, VarPtr(w(0)), 16) <> 2 Or W16(1) <> &HFFFD Then ExitProcess(9)
Print MakeStr(VarPtr(b(0)))
