' Target: actba64
' -linux の N88BASIC の X の窓（libX11.so.6、動的リンク）。描いた画素を N88_XPixel で読む
' X サーバーが要る（WSLg の DISPLAY）。最後の N88_WaitClose は閉じるまで待つので、その前に ExitProcess
#N88BASIC

Sub Say(s As String)
    Dim t As String
    t = s + Chr$(10)
    Lx_Syscall(LX_SYS_WRITE, 1, StrPtr(t), Len(t), 0, 0, 0)
End Sub

Sub Px(name As String, x As Long, y As Long)
    Say(name + Str$(N88_XPixel(x, y)))
End Sub

Function CellInk(cx As Long, cy As Long) As Long
    Dim x As Long
    Dim y As Long
    CellInk = 0
    For y = 0 To 15
        For x = 0 To 7
            If N88_XPixel(cx * 8 + x, cy * 16 + y) <> 0 Then CellInk = CellInk + 1
        Next
    Next
End Function

Line(10, 10)-(100, 10), 2
Line(20, 30)-(60, 70), 4, BF
Line(100, 100)-(200, 150), 1, B
Circle(300, 200), 50, 6
Paint(300, 200), 5, 6
PSet(5, 5), 7
Circle(500, 200), 40, 3, , , , F
Px("line", 50, 10)
Px("boxfill", 40, 50)
Px("box", 150, 100)
Px("box-in", 150, 125)
Px("paint", 300, 200)
Px("paint-out", 300, 300)
Px("pset", 5, 5)
Px("circle-f", 500, 200)
Locate 2, 20
Print "A"
Say("ink" + Str$(CellInk(2, 20) > 0))
Say("blank" + Str$(CellInk(3, 20)))
ExitProcess(0)
