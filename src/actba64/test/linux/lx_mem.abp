' Target: actba64
' lstrlenA / lstrcmpA / RtlMoveMemory / RtlFillMemory / lstrcpyA の Linux 版
#console
Dim buf(15) As Byte
If lstrlen("abc") <> 3 Then ExitProcess(1)
If lstrcmp("abc", "abc") <> 0 Then ExitProcess(2)
If lstrcmp("abc", "abd") >= 0 Then ExitProcess(3)
If lstrcmp("b", "a") <= 0 Then ExitProcess(4)
lstrcpy(VarPtr(buf(0)), "012345")
RtlMoveMemory(VarPtr(buf(1)), VarPtr(buf(0)), 4)
If lstrcmp(VarPtr(buf(0)), "001235") <> 0 Then ExitProcess(5)
RtlMoveMemory(VarPtr(buf(0)), VarPtr(buf(2)), 3)
If lstrcmp(VarPtr(buf(0)), "123235") <> 0 Then ExitProcess(6)
RtlFillMemory(VarPtr(buf(0)), 2, &H7A)
If lstrcmp(VarPtr(buf(0)), "zz3235") <> 0 Then ExitProcess(7)
Print "ok"
