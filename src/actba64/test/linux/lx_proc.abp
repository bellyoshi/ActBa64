' Target: actba64
' CreateProcessA（fork + execve。"" で囲めば空白を含む引数、\ は /）、WaitForSingleObject、GetExitCodeProcess
' 実行できないファイルなら CreateProcess は 0。プロセスのハンドルを CloseHandle しても fd は閉じない
#console
Function RunCmd(c As String) As Long
    Dim si As STARTUPINFO
    Dim pi As PROCESS_INFORMATION
    Dim code As DWord
    RunCmd = -1
    si.cb = SizeOf(STARTUPINFO)
    If CreateProcess(0, StrPtr(c), 0, 0, 0, 0, 0, 0, si, pi) = 0 Then Exit Function
    WaitForSingleObject(pi.hProcess, INFINITE)
    GetExitCodeProcess(pi.hProcess, code)
    CloseHandle(pi.hThread)
    CloseHandle(pi.hProcess)
    RunCmd = code
End Function
Print RunCmd("/bin/sh -c " + Chr$(34) + "exit 7" + Chr$(34))
Print RunCmd("\bin\echo hello " + Chr$(34) + "two words" + Chr$(34))
Print RunCmd("/nonexistent/prog")
Print "still open"
