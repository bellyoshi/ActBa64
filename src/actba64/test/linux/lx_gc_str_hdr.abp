' Target: actba64
' Str$ の塊の先頭のヘッダ（t_gc_str_hdr と同じ。Linux のヒープ LxHeap でも生きた String を掃き出さない）
#console

Dim nums(63) As String
Dim keep(63) As String
Dim junk As String
Dim i As Long
Dim k As Long

' 1. "Z" で埋めた塊を作って捨て、ヒープに 0x5A のゴミを残す
For k = 1 To 4
    For i = 0 To 63
        junk = "ZZZZZZZZZZZZZZZZ" & "ZZZZZZZZZZZZZZZZ" & Chr$(90)
    Next
Next
' 2. Str$ がそのゴミの上に塊を取る。あとに取った keep を、ゴミの長さが範囲に含める
For i = 0 To 63
    nums(i) = Str$(i)
    keep(i) = "keep" & nums(i)
Next
' 3. Collect（MAIN のループ先頭）を何度も回し、そのあいだに別の塊を作ってヒープを使い回す
For k = 1 To 200
    junk = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" & Str$(k)
Next
For i = 0 To 63
    If keep(i) <> "keep" & Str$(i) Then
        Print "fail"
        Print Str$(i)
        Print keep(i)
        ExitProcess(1)
    End If
Next
Print "ok"
ExitProcess(0)
End
