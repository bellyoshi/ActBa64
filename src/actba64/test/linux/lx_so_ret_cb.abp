' Target: actba64
' .so の Declare の Double / Single の戻り値（xmm0）、.so から BASIC へのコールバック（qsort / bsearch の比較関数）、
' 終わるときに C の stdio を書き出す（ExitProcess は libc の exit）
#console
Declare Function sqrt Lib "libm.so.6" (x As Double) As Double
Declare Function pow Lib "libm.so.6" (x As Double, y As Double) As Double
Declare Function sqrtf Lib "libm.so.6" (x As Single) As Single
Declare Function atof Lib "libc.so.6" (s As BytePtr) As Double
Declare Function printf Lib "libc.so.6" (fmt As BytePtr, n As Long) As Long
Declare Sub qsort Lib "libc.so.6" (base As VoidPtr, n As VoidPtr, size As VoidPtr, cmp As VoidPtr)
Declare Function bsearch Lib "libc.so.6" (key As VoidPtr, base As VoidPtr, n As VoidPtr, size As VoidPtr, cmp As VoidPtr) As VoidPtr

Function CmpLong(a As *Long, b As *Long) As Long
    CmpLong = 0
    If a[0] < b[0] Then CmpLong = -1
    If a[0] > b[0] Then CmpLong = 1
End Function

Dim v(7) As Long, i As Long, key As Long, p As *Long, s As Single, t As String
Print sqrt(2)
Print pow(2, 10) + 1
s = sqrtf(16)
Print s
Print atof("3.25") * 2
v(0) = 42: v(1) = -3: v(2) = 17: v(3) = 8: v(4) = 100: v(5) = 0: v(6) = 5: v(7) = -20
qsort(VarPtr(v(0)), 8, 4, AddressOf(CmpLong))
t = ""
For i = 0 To 7
    t = t + Str$(v(i)) + " "
Next
Print t
key = 17
p = bsearch(VarPtr(key), VarPtr(v(0)), 8, 4, AddressOf(CmpLong))
Print (p - VarPtr(v(0))) \ 4
' 改行の無い printf は exit が書き出す
printf("printf %d", 42)
