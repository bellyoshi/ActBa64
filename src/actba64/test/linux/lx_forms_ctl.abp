' Target: actba64
' Forms.sbp の X11 版の部品: WM_CREATE で自分の窓へ ButtonPress / ButtonRelease を送り、
' Button → BN_CLICKED、CheckBox → 印が付いて BN_CLICKED、RadioButton2 → 印が移って BN_CLICKED、
' 使えない Button の上 → フォームの WM_LBUTTONDOWN、EditBox.SetText → EN_CHANGE を確かめて閉じる
' X サーバーが要る（WSLg の DISPLAY）
#include <Forms.sbp>

Dim g_ev(191) As Byte

' 自分の窓へマウスのボタンの XEvent を送る（type 4 = ButtonPress、5 = ButtonRelease）
Sub SendButton(h As HWND, t As Long, x As Long, y As Long)
    Dim b As VoidPtr
    b = VarPtr(g_ev(0))
    RtlFillMemory(b, 192, 0)
    FormsSetL(b, 0, t)
    LxSetQ(b, 32, h As VoidPtr)     ' window
    FormsSetL(b, 64, x)
    FormsSetL(b, 68, y)
    FormsSetL(b, 84, 1)             ' button 1
    XSendEvent(g_formsDpy, h As VoidPtr, 0, 0, b)
End Sub

Sub ClickAt(h As HWND, x As Long, y As Long)
    SendButton(h, 4, x, y)
    SendButton(h, 5, x, y)
End Sub

Class Form1
    Inherits Form
Private
    Button1 As Button
    CheckBox1 As CheckBox
    RadioButton1 As RadioButton
    RadioButton2 As RadioButton
    EditBox1 As EditBox
    Button2 As Button
Public
    Override Function WndProc(msg As DWord, wParam As WPARAM, lParam As LPARAM) As LRESULT
        If msg = WM_CREATE Then
            EditBox1.SetText("hi")
            ClickAt(Handle, 20, 20)
            ClickAt(Handle, 20, 50)
            ClickAt(Handle, 20, 90)
            ClickAt(Handle, 150, 50)
            This.Close()
        End If
        If msg = WM_COMMAND Then
            If HIWORD(wParam) = BN_CLICKED Then
                If lParam = Button1.Handle Then Print "click Button1"
                If lParam = Button2.Handle Then Print "click Button2"
                If lParam = CheckBox1.Handle Then Print "check " + Str$(CheckBox1.GetChecked())
                If lParam = RadioButton2.Handle Then Print "radio1 " + Str$(RadioButton1.GetChecked()) + " radio2 " + Str$(RadioButton2.GetChecked())
            End If
            If HIWORD(wParam) = EN_CHANGE And lParam = EditBox1.Handle Then Print "edit " + EditBox1.GetText()
        End If
        If msg = WM_LBUTTONDOWN Then Print "form down"
        WndProc = Super.WndProc(msg, wParam, lParam)
    End Function
Private
    Override Sub InitializeComponent()
        Width = 240
        Height = 140
        Caption = "lx_forms_ctl"
        Button1.Left = 10 : Button1.Top = 10 : Button1.Width = 75 : Button1.Height = 25
        Button1.Caption = "Button1"
        AddControl(Button1)
        CheckBox1.Left = 10 : CheckBox1.Top = 40 : CheckBox1.Width = 100 : CheckBox1.Height = 20
        CheckBox1.Caption = "CheckBox1"
        AddControl(CheckBox1)
        RadioButton1.Left = 10 : RadioButton1.Top = 60 : RadioButton1.Width = 100 : RadioButton1.Height = 20
        RadioButton1.Caption = "RadioButton1"
        RadioButton1.Checked = True
        AddControl(RadioButton1)
        RadioButton2.Left = 10 : RadioButton2.Top = 80 : RadioButton2.Width = 100 : RadioButton2.Height = 20
        RadioButton2.Caption = "RadioButton2"
        AddControl(RadioButton2)
        EditBox1.Left = 120 : EditBox1.Top = 10 : EditBox1.Width = 100 : EditBox1.Height = 23
        AddControl(EditBox1)
        Button2.Left = 120 : Button2.Top = 40 : Button2.Width = 75 : Button2.Height = 25
        Button2.Caption = "Button2"
        Button2.Enabled = False
        AddControl(Button2)
    End Sub
End Class

Dim mainForm As Form1

Application.Initialize()
Application.Run(mainForm)
Print "done"
