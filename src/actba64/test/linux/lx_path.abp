' Target: actba64
' lstrcatA、GetFullPathNameA と、パスの \ を / として扱うこと（コンパイラは "Include\" のように組み立てる）
#console
Declare Function FullPathA Lib "kernel32.dll" Alias "GetFullPathNameA" (ByVal name As *Byte, ByVal n As DWord, ByVal buf As *Byte, ByVal part As Long) As DWord
Dim buf(511) As Byte
Dim s As String, n As Long
lstrcpy(VarPtr(buf(0)), "ab")
lstrcat(VarPtr(buf(0)), "cd")
Print MakeStr(VarPtr(buf(0)))
MkDir "lx_path_dir"
Open "lx_path_dir\f.txt" For Output As #1
Print #1, "inside"
Close #1
Open "lx_path_dir/f.txt" For Input As #1
Input #1, s
Close #1
Print s
Kill "lx_path_dir\f.txt"
RemoveDirectory("lx_path_dir")
n = FullPathA("sub\x.txt", 512, VarPtr(buf(0)), 0)
s = MakeStr(VarPtr(buf(0)))
If n <> Len(s) Then ExitProcess(1)
If Left$(s, 1) <> "/" Then ExitProcess(2)
Print Right$(s, 10)
n = FullPathA("/tmp\y", 512, VarPtr(buf(0)), 0)
Print MakeStr(VarPtr(buf(0)))
