' Target: actba64
' Date$ / Time$（GetLocalTime、今は UTC）と Sleep（GetTickCount / MsgWaitForMultipleObjects / PeekMessageA）の Linux 版
#console
Dim d As String, t As String
Dim t0 As DWord, el As Long
d = Date$()
t = Time$()
If Len(d) <> 10 Then ExitProcess(1)
If Mid$(d, 5, 1) <> "/" Or Mid$(d, 8, 1) <> "/" Then ExitProcess(2)
If Val(Left$(d, 4)) < 2025 Then ExitProcess(3)
If Len(t) <> 8 Then ExitProcess(4)
If Mid$(t, 3, 1) <> ":" Or Mid$(t, 6, 1) <> ":" Then ExitProcess(5)
t0 = GetTickCount()
Sleep(200)
el = GetTickCount() - t0
If el < 190 Or el > 2000 Then ExitProcess(6)
Print "ok"
