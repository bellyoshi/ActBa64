' Target: actba64
' Args: one "two words" 3
' GetCommandLineA（argv から組み立て、空白を含むものは "" で囲む）と GetModuleFileNameA の Linux 版
#console
Dim buf(511) As Byte
Dim n As Long, s As String
Print MakeStr(GetCommandLine())
n = GetModuleFileName(0, VarPtr(buf(0)), 512)
s = MakeStr(VarPtr(buf(0)))
If n <> Len(s) Then ExitProcess(1)
If Left$(s, 1) <> "/" Then ExitProcess(2)
Print Right$(s, 7)
