' Target: actba64
' ヒープ（GetProcessHeap / HeapAlloc / HeapFree / HeapReAlloc）の Linux 版。数値の Print、MakeStr、連結、calloc / realloc / free
#console
Dim s As String
Dim i As Long
Dim p As *Long
Dim q As *Byte
Print
Print 123; -45
Print 1.5
s = ""
For i = 1 To 3000
    s = s + Chr$(65 + (i Mod 26))
Next
If Len(s) <> 3000 Then ExitProcess(1)
If Mid$(s, 2999, 2) <> "JK" Then ExitProcess(2)
q = calloc(5001)
RtlFillMemory(q, 5000, &H78)
s = MakeStr(q)
free(q)
If Len(s) <> 5000 Then ExitProcess(3)
p = calloc(4000)
For i = 0 To 999
    If p[i] <> 0 Then ExitProcess(4)
    p[i] = i
Next
p = realloc(p, 400000)
For i = 0 To 999
    If p[i] <> i Then ExitProcess(5)
Next
free(p)
For i = 1 To 200
    q = calloc(i * 37)
    If q[i * 37 - 1] <> 0 Then ExitProcess(6)
    q[0] = 7
    q[i * 37 - 1] = 9
    free(q)
Next
q = calloc(3000000)
q[2999999] = 1
free(q)
Print "ok"; Len(s)
