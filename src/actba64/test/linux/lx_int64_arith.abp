' Target: actba64
' Int64 / QWord の算術・比較・リテラル（-linux）
#console
Dim x As Int64, y As Int64, l As Long, u As QWord, v As QWord
x = 3000000000
y = x + x
Print y
Print x * 4
Print x * x
Print 9223372036854775807
Print &H7FFFFFFFFFFFFFFF
Print &HFFFFFFFFFFFFFFFF
Print -x
Print Not x
y = 10000000000
Print y \ 7; y Mod 7
Print -y \ 7; -y Mod 7
Print x << 4; (y >> 3)
l = 5
Print x - l; l - x
If x > l Then Print "gt"
If y > x Then Print "gt2"
If x = 3000000000 Then Print "eq"
Print x < y, x >= y
x += 1
Print x
u = &H8000000000000000
v = 1
If u > v Then Print "u>v unsigned"
Print (x + 0.5)
Dim i As Int64
i = 1
For l = 1 To 62
    i = i * 2
Next
Print i
Print Str$(i - 1 + i)
