' Target: actba64
' Option: -pN88
' -pN88 の PRINT を端末なしで（パイプへ文字だけ）。; と , と数値の整形、LOCATE / COLOR はエスケープを出さない
' LINE は描かず、標準エラーに 1 回だけ知らせる
10 PRINT "HELLO"
20 A=1+2:PRINT A;"X",-5
30 PRINT "AB";
40 PRINT "CD"
50 COLOR 6:LOCATE 3,10:PRINT "Y"
60 LINE (0,0)-(10,10),7:PSET (1,1),2
70 CLS:PRINT "END"
80 END
