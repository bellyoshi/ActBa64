#include "..\..\Include\d3d11\d3d11.sbp"

Dim g_pContext As *ID3D11DeviceContext
Dim g_pDevice As *ID3D11Device
Dim g_pPS As *ID3D11PixelShader
Dim g_pVS As *ID3D11VertexShader
Dim g_pRTV As *ID3D11RenderTargetView
Dim g_pSwapChain As *IDXGISwapChain

Sub dx_ReleaseAll()
	If g_pPS Then
		g_pPS->Release()
		g_pPS = 0
	End If
	If g_pVS Then
		g_pVS->Release()
		g_pVS = 0
	End If
	If g_pRTV Then
		g_pRTV->Release()
		g_pRTV = 0
	End If
	If g_pContext Then
		g_pContext->Release()
		g_pContext = 0
	End If
	If g_pSwapChain Then
		g_pSwapChain->Release()
		g_pSwapChain = 0
	End If
	If g_pDevice Then
		g_pDevice->Release()
		g_pDevice = 0
	End If
End Sub

dx_ReleaseAll()
