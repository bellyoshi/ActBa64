' Expect: 0
' Target: actba64
' ByRef 構造体のフィールド代入は呼び出し元に残る
#console
Type Pair
    a As Long
    b As Long
End Type

Sub TouchFields(ByRef p As Pair)
    p.a = 11
    p.b = p.a + 11
End Sub

Dim r As Pair
r.a = 1
TouchFields(r)
If r.a <> 11 Then ExitProcess(1)
If r.b <> 22 Then ExitProcess(2)
ExitProcess(0)
