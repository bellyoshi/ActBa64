' Expect: 15
' Target: actba64
' 後ろで定義する Type / Class も Dim x As T で使える（ActiveBasic と同じ）
#console
Dim t As T
Dim c As C
t.v = 6
c.w = 4
ExitProcess(t.v + c.GetW() + 4)

Type T
    v As Long
End Type

Class C
Public
    w As Long
    Function GetW() As Long
        GetW = w + 1
    End Function
End Class
