' Expect: 0
' Target: actba64
' *Double / *Single / *Word / *BytePtr の添字（要素の大きさで進み、要素の型で読み書きする）、
' ネストしたメンバの配列 h.Raw.GameID[i]、-> 越しのメンバの配列
#console

Type RAW
    Version As Byte
    GameID[3] As Byte
End Type

Type HDR
    Raw As RAW
    Title[20] As Byte
    pd As *Double
End Type

Function Sum(a As *Double, n As Long) As Double
    Dim i As Long
    Sum = 0
    For i = 0 To n - 1
        Sum = Sum + a[i]
    Next
End Function

Sub SetReason(reason As *BytePtr)
    reason[0] = "detect"
End Sub

Function GameId(header As *HDR) As Long
    GameId = header->Raw.GameID[3]
End Function

Dim d[3] As Double, w[3] As Word
Dim pd As *Double, pw As *Word
d[0] = 1.5: d[1] = 2.25: d[2] = 3
w[0] = 5: w[1] = 9
pd = VarPtr(d[0])
pw = VarPtr(w[0])
If pd[1] <> 2.25 Or Sum(pd, 3) <> 6.75 Then ExitProcess(1)
pd[2] = 10
If d[2] <> 10 Or pw[1] <> 9 Then ExitProcess(2)

Dim h As HDR
h.pd = pd
h.pd[1] = 4
If d[1] <> 4 Or h.pd[0] <> 1.5 Then ExitProcess(3)

Dim r As BytePtr
SetReason(VarPtr(r))
If lstrlen(r) <> 6 Then ExitProcess(4)

h.Raw.GameID[3] = 69
If h.Raw.GameID[3] <> 69 Or GameId(VarPtr(h)) <> 69 Then ExitProcess(5)
ExitProcess(0)
