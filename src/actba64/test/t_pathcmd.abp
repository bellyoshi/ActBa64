' Expect: 0
' Target: actba64
#console

Declare Function RemoveDirectoryA Lib "kernel32.dll" (ByVal lpPathName As *Byte) As Long

MkDir "bin/test_out/actba64_cmd"
ChDir "bin/test_out/actba64_cmd"
Open "a.txt" For Output As 1
Print #1, "x"
Close #1
Kill "a.txt"
If GetFileAttributesA("a.txt") <> &HFFFFFFFF Then ExitProcess(1)
ChDir "..\..\.."
RemoveDirectoryA("bin/test_out/actba64_cmd")
ExitProcess(0)
