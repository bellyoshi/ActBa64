' Hybrid String GC: For で大量生成、precise ルートが生き残る
' Expect: 0
' Target: actba64
#console
Dim s As String
Dim t As String
Dim i As Long

s = "keep"
For i = 1 To 200
    t = "tmp" + Str$(i)
Next
If s <> "keep" Then
    Print "fail keep"
    ExitProcess(1)
End If
If Len(t) < 3 Then
    Print "fail last"
    ExitProcess(2)
End If
Print "ok"
ExitProcess(0)
End
