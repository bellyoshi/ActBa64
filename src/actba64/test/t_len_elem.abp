' Expect: 127
' Target: actba64
' Len(配列の要素) は要素 1 つのバイト数（Type 配列は Type の大きさ）
#console
Type T3
    a As Long
    b As Byte
    c As Long
End Type
Dim t[2] As T3
Dim l[3] As Long
Dim w[3] As Word
Dim d[3] As Double
Dim b[3] As Byte
Dim sa[2] As String
Dim r As Long
r = 0
If Len(t[0]) = SizeOf(T3) Then r = r + 1
If Len(l[1]) = 4 Then r = r + 2
If Len(w[2]) = 2 Then r = r + 4
If Len(d[0]) = 8 Then r = r + 8
If Len(b[0]) = 1 Then r = r + 16
If Len(t(1)) = SizeOf(T3) Then r = r + 32
sa[1] = "hello"
If Len(sa[1]) = 5 And Len(sa(1)) = 5 Then r = r + 64
ExitProcess(r)
