' Expect: 0
' Target: actba64
' String GC: 大域の String 配列は、precise ルートの上限（512）を超えた分も BSS の conservative 走査で生き残る。
' 以前は IR のマークのループが最初の比較で抜けていて、BSS とスタックの走査が何も印を付けず、
' keep(492) 以降が MAIN のループの回収で解放されていた
#console
Const N_KEEP = 1000
Dim keep(N_KEEP) As String

Sub Fill()
    Dim i As Long
    For i = 1 To N_KEEP
        keep(i) = "v" + Str$(i)
    Next
End Sub

Function Check() As Long
    Dim i As Long
    Check = 0
    For i = 1 To N_KEEP
        If keep(i) <> "v" + Str$(i) Then Check = i
        If Check <> 0 Then Exit Function
    Next
End Function

Dim k As Long
Dim t As String
Fill()
For k = 1 To 3
    t = "a" + Str$(k)
Next
If Check() <> 0 Then ExitProcess(1)
ExitProcess(0)
