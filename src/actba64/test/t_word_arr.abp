' Expect: 127
' Target: actba64
' Dim w[n] As Word は 2 バイトずつの配列（ActiveBasic と同じ）
#console
Declare Function TLenW Lib "kernel32.dll" Alias "lstrlenW" (ByVal s As VoidPtr) As Long
Dim w[3] As Word
Dim after[1] As Long
Dim m(2, 1) As Word
Dim r As Long
after[0] = 77
w[0] = &H65E5
w[1] = &H672C
w[3] = &H12345
r = 0
If GetWord(VarPtr(w[0]) + 2) = &H672C Then r = r + 1
If w[1] = &H672C And w[0] = &H65E5 Then r = r + 2
If w[3] = &H2345 Then r = r + 4
If Len(w) = 8 Then r = r + 8
If after[0] = 77 Then r = r + 16
m(2, 1) = 9
If GetWord(VarPtr(m) + 10) = 9 Then r = r + 32
If TLenW(w) = 2 Then r = r + 64
ExitProcess(r)
