#console

' ブロックの中の単独の End は文（プログラム終了）。End のあとに語が続くときだけ End If / End Select。
Dim r As Long, k As Long
k = 1
If k = 2 Then
    End
End If
r = r + 1
If k = 2 Then
    r = 100
Else
    r = r + 2
End If
Select Case k
    Case 2
        End
    Case 1
        r = r + 4
    Case Else
        End
End Select
ExitProcess(r)
