' Expect: 31
' Target: actba64
#console

' 行末の _ で継続した行は 1 行として扱う。単行 If の Then の後ろで継続しても単行 If のまま。
Dim a As Long, r As Long
Sub T(v As Long)
    If v > 1 Then _
        r = r + 1 : r = r + 1

    If v = 0 Then r = r + 100
End Sub
a = 2
T(a)
If a > 5 Then _
    r = r + 1000 _
    Else r = r + 4
If a = 2 _
    Then r = r + 8 : _
    r = r + 16
Print r; _
    ""
ExitProcess(r + 1)
