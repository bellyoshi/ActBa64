' Expect: 0
' Target: actba64
#console

Dim d As String
Dim t As String
d = Date$()
t = Time$()
If Len(d) <> 10 Then ExitProcess(1)
If Mid$(d, 5, 1) <> "/" Then ExitProcess(2)
If Mid$(d, 8, 1) <> "/" Then ExitProcess(3)
If Len(t) <> 8 Then ExitProcess(4)
If Mid$(t, 3, 1) <> ":" Then ExitProcess(5)
If Mid$(t, 6, 1) <> ":" Then ExitProcess(6)
ExitProcess(0)
