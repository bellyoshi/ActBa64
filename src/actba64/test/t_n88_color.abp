' Expect: 0
' Target: actba64
' Color 文とカラーコード関数
#n88basic

If ColorBlack() <> 0 Then ExitProcess(1)
If ColorBlue() <> 1 Then ExitProcess(2)
If ColorRed() <> 2 Then ExitProcess(3)
If ColorPurple() <> 3 Then ExitProcess(4)
If ColorGreen() <> 4 Then ExitProcess(5)
If ColorLightBlue() <> 5 Then ExitProcess(6)
If ColorYellow() <> 6 Then ExitProcess(7)
If ColorWhite() <> 7 Then ExitProcess(8)
If ColorCode(0) <> 0 Then ExitProcess(9)
If ColorCode(1) <> &HFF0000 Then ExitProcess(10)
If ColorCode(2) <> &H0000FF Then ExitProcess(11)
If ColorCode(3) <> &HFF00FF Then ExitProcess(12)
If ColorCode(4) <> &H00FF00 Then ExitProcess(13)
If ColorCode(5) <> &HFFFF00 Then ExitProcess(14)
If ColorCode(6) <> &H00FFFF Then ExitProcess(15)
If ColorCode(7) <> &HFFFFFF Then ExitProcess(16)
If ColorCode(ColorYellow()) <> &H00FFFF Then ExitProcess(17)
Color 6
Color 2, 1
Color 7, -1
Color(4)
Color(3, 0)
ExitProcess(0)
