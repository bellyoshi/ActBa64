' Expect: 111
' Target: actba64
' Forms.sbp: Dim で InitializeComponent → Show で窓 → Override WndProc がメッセージを受ける
' → WM_CLOSE で窓が壊れると Application.Run が戻る（窓は一瞬だけ出る）

#include <Forms.sbp>

Dim g_created As Long
Dim g_title(63) As Byte

Class Form1
    Inherits Form
Private
    Override Sub InitializeComponent()
        Left = 10
        Top = 10
        Width = 200
        Height = 100
        Caption = "テスト"
    End Sub
Public
    Override Function WndProc(msg As DWord, wParam As WPARAM, lParam As LPARAM) As LRESULT
        If msg = WM_CREATE Then g_created = g_created + 1
        WndProc = Super.WndProc(msg, wParam, lParam)
    End Function
End Class

Dim mainForm As Form1
Dim r As Long

mainForm.Show()
GetWindowText(mainForm.Handle, VarPtr(g_title), 64)
PostMessage(mainForm.Handle, WM_CLOSE, 0, 0)
Application.Initialize()
Application.Run(mainForm)

r = g_created * 100
If lstrcmp(VarPtr(g_title), "テスト") = 0 Then r = r + 10
If IsWindow(mainForm.Handle) = 0 Then r = r + 1
ExitProcess(r)
