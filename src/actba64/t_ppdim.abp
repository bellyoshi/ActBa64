#console
Declare Function ExitProcess Lib "kernel32.dll" (uExitCode As Long) As Long
Const PP_DEF_MAX = 64
Const PP_DEF_NAME = 32
Const PP_IF_MAX = 32
Dim g_ppDef(PP_DEF_MAX * PP_DEF_NAME - 1) As Byte
Dim g_ppDefCount As Long
Dim g_ppIfActive(PP_IF_MAX) As Long
Sub Seed()
    Dim i As Long
    ' fill def table completely
    i = 0
    While i <= PP_DEF_MAX * PP_DEF_NAME - 1
        g_ppDef[i] = 1
        i = i + 1
    Wend
    g_ppIfActive[0] = 1
End Sub
Sub Main()
    Dim n As Long
    Seed()
    ' if overflow corrupted ifActive, this fails
    If g_ppIfActive[0] <> 1 Then ExitProcess(1)
    n = PP_DEF_MAX * PP_DEF_NAME - 1
    If n <> 2047 Then ExitProcess(2)
    ' write last element
    g_ppDef[2047] = 42
    If g_ppDef[2047] <> 42 Then ExitProcess(3)
    If g_ppIfActive[0] <> 1 Then ExitProcess(4)
    ExitProcess(42)
End Sub
Main()
End
