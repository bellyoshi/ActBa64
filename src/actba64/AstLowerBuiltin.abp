' AstLowerBuiltin - メモリ、Len、Right、Mid

' left/right/extra の 3 引数を rcx, rdx, r8 へ積む
Function LowExprBuiltin3ToRcx(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList

    LowExprBuiltin3ToRcx = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    If nodes[idx].extra < 0 Then
        ctx->err = 1
        Exit Function
    End If
    If LowExpr(ctx, nodes[idx].extra) = 0 Then Exit Function
    IrEmit(list, OP_MOV_R8_RAX, 0, 0)
    IrEmit(list, OP_POP_RAX, 0, 0)
    IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    LowExprBuiltin3ToRcx = 1
End Function

Function LowExprBuiltinMem(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList
    Dim labZ As Long
    Dim labE As Long
    Dim apiName(15) As Byte

    LowExprBuiltinMem = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    If nodes[idx].num = BI_FILLMEMORY Then
        If LowExprBuiltin3ToRcx(ctx, idx) = 0 Then Exit Function
        lstrcpy(VarPtr(apiName), "RtlFillMemory")
        IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(apiName))
        LowExprBuiltinMem = 1
    ElseIf nodes[idx].num = BI_ASC Then
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        labZ = LowNewLab(ctx)
        labE = LowNewLab(ctx)
        IrEmit(list, OP_TEST_RAX, 0, 0)
        IrEmit(list, OP_JZ, labZ, 0)
        IrEmit(list, OP_MOVZX_EAX_BYTE, 0, 0)
        IrEmit(list, OP_JMP, labE, 0)
        IrEmit(list, OP_LABEL, labZ, 0)
        IrEmit(list, OP_XOR_EAX, 0, 0)
        IrEmit(list, OP_LABEL, labE, 0)
        LowExprBuiltinMem = 1
    ElseIf nodes[idx].num = BI_MEMCPY Then
        If LowExprBuiltin3ToRcx(ctx, idx) = 0 Then Exit Function
        lstrcpy(VarPtr(apiName), "RtlMoveMemory")
        IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(apiName))
        LowExprBuiltinMem = 1
    Else
        LowExprBuiltinMem = -1
    End If
End Function

Function LowExprBuiltinLen(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim list As *IrList
    Dim labZ As Long
    Dim labE As Long
    Dim tt As *TypeTable
    Dim ti As Long
    Dim sz As Long
    Dim tsizes As *Long

    LowExprBuiltinLen = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    tt = ast->types
    If nodes[nodes[idx].left].kind = AST_VAR Then
        AstCopyStr(ast, nodes[idx].left, VarPtr(name))
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
            If vTy = TY_UDT Then
                ti = vTypeIdx
                If ti >= 0 Then
                    tsizes = tt->typeSizes
                    sz = tsizes[ti]
                    If sz > 0 Then
                        IrEmit(list, OP_MOV_EAX_IMM, sz, 0)
                        LowExprBuiltinLen = 1
                        Exit Function
                    End If
                End If
            End If
        End If
    End If
    If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
    labZ = LowNewLab(ctx)
    labE = LowNewLab(ctx)
    LowEmitLoadStrLen(list, labZ, labE)
    LowExprBuiltinLen = 1
End Function

Function LowExprBuiltinSizeof(ctx As *LowerCtx, idx As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim list As *IrList
    Dim tt As *TypeTable
    Dim sz As Long

    LowExprBuiltinSizeof = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    tt = ast->types
    AstCopyStr(ast, nodes[idx].left, VarPtr(name))
    sz = TySizeOfName(tt, VarPtr(name))
    If sz <= 0 Then
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
            ctx->err = 1
            Exit Function
        End If
        ctx->err = 1
        Exit Function
    End If
    IrEmit(list, OP_MOV_EAX_IMM, sz, 0)
    LowExprBuiltinSizeof = 1
End Function

' ランタイム呼び出し系 / 素通し系の組み込み関数
Function LowExprBuiltinCore2(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList
    Dim lab As Long
    Dim n As Long

    LowExprBuiltinCore2 = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    n = nodes[idx].num
    If n = BI_MAKEINTRESOURCE Then
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        LowExprBuiltinCore2 = 1
    ElseIf n = BI_STRPTR Then
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        LowExprBuiltinCore2 = 1
    ElseIf n = BI_STR Then
        lab = LowEnsureRtStr(ctx)
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        LowEmitCall1Rax(list, 0, 0, 0, lab)
        LowExprBuiltinCore2 = 1
    ElseIf n = BI_MAKESTR Then
        lab = LowEnsureRtMakeStr(ctx)
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        LowEmitCall1Rax(list, 0, 0, 0, lab)
        LowExprBuiltinCore2 = 1
    Else
        LowExprBuiltinCore2 = -1
    End If
End Function

Function LowExprBuiltinCore(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim list As *IrList
    Dim lab As Long
    Dim n As Long

    LowExprBuiltinCore = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    n = nodes[idx].num

    If n = BI_SIZEOF Then
        LowExprBuiltinCore = LowExprBuiltinSizeof(ctx, idx)
    ElseIf n = BI_VARPTR Then
        If LowAddr(ctx, nodes[idx].left) = 0 Then Exit Function
        LowExprBuiltinCore = 1
    ElseIf n = BI_ADDRESSOF Then
        AstCopyStr(ast, idx, VarPtr(name))
        lab = LowFindFunc(ctx, VarPtr(name))
        If lab < 0 Then
            Print "error: AddressOf unknown function '" + MakeStr(VarPtr(name)) + "'"
            ctx->err = 1
            Exit Function
        End If
        IrEmit(list, OP_LEA_RAX_LAB, lab, 0)
        LowExprBuiltinCore = 1
    ElseIf n = BI_MALLOC Then
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        LowEmitHeapAllocRax(list, 0)
        LowExprBuiltinCore = 1
    ElseIf n = BI_FREE Then
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        LowEmitHeapFreeRax(list)
        LowExprBuiltinCore = 1
    ElseIf n = BI_LEN Then
        LowExprBuiltinCore = LowExprBuiltinLen(ctx, idx)
    Else
        LowExprBuiltinCore = LowExprBuiltinCore2(ctx, idx)
    End If
End Function

' stack: s, n → rax = Len(s)（s, n はスタックに残す）
Sub LowEmitRightLen(list As *IrList, labA As Long, labB As Long)
    ' stack: s, n  →  rax = s, rcx = n
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_POP_RAX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
    ' rax = s (stack: s, n) → rax = Len(s)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JZ, labA, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -4, 0)
    IrEmit(list, OP_LOAD_DWORD_RAX, 0, 0)
    IrEmit(list, OP_AND_EAX_IMM, 2147483647, 0)
    IrEmit(list, OP_JMP, labB, 0)
    IrEmit(list, OP_LABEL, labA, 0)
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_LABEL, labB, 0)
End Sub

Sub LowEmitRightStart(list As *IrList, labZ As Long)
    ' start = len - n + 1（n はスタックへ戻す）
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
    IrEmit(list, OP_SUB_EAX_ECX, 0, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    ' if start < 1 then start = 1
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 1, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JL, labZ, 0)
    IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
    IrEmit(list, OP_LABEL, labZ, 0)
End Sub

Function LowExprBuiltinRight(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList
    Dim lab As Long
    Dim labZ As Long
    Dim labA As Long
    Dim labB As Long

    LowExprBuiltinRight = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    ' Right$(s, n) => Mid$(s, len - n + 1, n)
    If nodes[idx].right < 0 Then
        ctx->err = 1
        Exit Function
    End If
    lab = LowEnsureRtMid(ctx)
    labA = LowNewLab(ctx)
    labB = LowNewLab(ctx)
    labZ = LowNewLab(ctx)
    If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    LowEmitRightLen(list, labA, labB)
    LowEmitRightStart(list, labZ)
    IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
    IrEmit(list, OP_POP_RAX, 0, 0)
    If TyIs32() <> 0 Then
        IrEmit(list, OP_POP_RCX, 0, 0)
    Else
        IrEmit(list, OP_MOV_R8_RAX, 0, 0)
        IrEmit(list, OP_POP_RCX, 0, 0)
    End If
    LowEmitCallLab3(list, lab)
    LowExprBuiltinRight = 1
End Function

Function LowExprBuiltinLeft(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList
    Dim lab As Long

    LowExprBuiltinLeft = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    lab = LowEnsureRtMid(ctx)
    If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
    If TyIs32() <> 0 Then
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        IrEmit(list, OP_MOV_EAX_IMM, 1, 0)
        IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
        IrEmit(list, OP_POP_RAX, 0, 0)
        IrEmit(list, OP_POP_RCX, 0, 0)
    Else
        IrEmit(list, OP_MOV_R8_RAX, 0, 0)
        IrEmit(list, OP_MOV_EAX_IMM, 1, 0)
        IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
        IrEmit(list, OP_POP_RCX, 0, 0)
    End If
    LowEmitCallLab3(list, lab)
    LowExprBuiltinLeft = 1
End Function

Function LowExprBuiltinMid(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList
    Dim lab As Long

    LowExprBuiltinMid = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    lab = LowEnsureRtMid(ctx)
    If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    If nodes[idx].extra >= 0 Then
        If LowExpr(ctx, nodes[idx].extra) = 0 Then Exit Function
    Else
        IrEmit(list, OP_MOV_EAX_IMM, -1, 0)
    End If
    If TyIs32() <> 0 Then
        IrEmit(list, OP_POP_RDX, 0, 0)
        IrEmit(list, OP_POP_RCX, 0, 0)
    Else
        IrEmit(list, OP_MOV_R8_RAX, 0, 0)
        IrEmit(list, OP_POP_RAX, 0, 0)
        IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
        IrEmit(list, OP_POP_RCX, 0, 0)
    End If
    LowEmitCallLab3(list, lab)
    LowExprBuiltinMid = 1
End Function
