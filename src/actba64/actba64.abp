#console

#include "actba64.idx"

' actba64 - ActiveBasic subset -> PE32+ (default) or PE32 (-actba32)
' modules: actba64.pj (#SOURCE). actba64.idx is for single-file host builds only.
' usage:
'   actba64 <src.abp|.pj> [-actba32] -o <out.exe>

Sub USAGE()
    Print "actba64 - ActiveBasic subset compiler"
    Print "usage: actba64 <src.abp|.pj> [-actba32] -o <out.exe>"
    End
End Sub

' -o / -O / /o
Function IsOptO(buf As *Byte) As Long
    If ByteStrEqCI("-o", buf) <> 0 Then
        IsOptO = 1
    ElseIf ByteStrEqCI("/o", buf) <> 0 Then
        IsOptO = 1
    Else
        IsOptO = 0
    End If
End Function

' -actba32 / /actba32
Function IsOptActba32(buf As *Byte) As Long
    If ByteStrEqCI("-actba32", buf) <> 0 Then
        IsOptActba32 = 1
    ElseIf ByteStrEqCI("/actba32", buf) <> 0 Then
        IsOptActba32 = 1
    Else
        IsOptActba32 = 0
    End If
End Function

Dim outName[MAX_PATH] As Byte
Dim srcName[MAX_PATH] As Byte
Dim arg[MAX_PATH] As Byte
Dim ok As Long
Dim i As Long
Dim haveOut As Long
Dim haveSrc As Long

haveOut = 0
haveSrc = 0
outName[0] = 0
srcName[0] = 0
TySetTarget32(0)

i = 1
While GetCmd(i, arg) <> 0
    If IsOptO(arg) <> 0 Then
        If GetCmd(i + 1, outName) = 0 Then
            Print "error: -o requires an output path"
            ExitProcess(1)
        End If
        haveOut = 1
        i = i + 2
    ElseIf IsOptActba32(arg) <> 0 Then
        TySetTarget32(1)
        i = i + 1
    Else
        If haveSrc <> 0 Then
            Print "error: unexpected argument"
            USAGE()
        End If
        lstrcpy(VarPtr(srcName), arg)
        haveSrc = 1
        i = i + 1
    End If
Wend

If haveSrc = 0 Or haveOut = 0 Then
    USAGE()
End If

ok = CompileInput(srcName, outName)
If ok = 0 Then
    ExitProcess(1)
End If
End
