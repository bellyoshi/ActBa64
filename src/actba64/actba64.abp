#console

#include "actba64.idx"

' actba64 - ActiveBasic subset -> PE32+ (default) or PE32 (-actba32)
' modules: actba64.pj (#SOURCE). actba64.idx is for single-file host builds only.
' usage:
'   actba64 <src.abp|.pj> [-actba32] -o <out.exe>

' -pN88 / /pN88 : N88-BASIC として読む（行番号は省略可）
' 戻り値 true : 成り立つ  false : 成り立たない
Function IsOptN88(buf As *Byte) As boolean
    IsOptN88 = false
    If ByteStrEqCI("-pN88", buf) Then IsOptN88 = true
    If ByteStrEqCI("/pN88", buf) Then IsOptN88 = true
End Function

' -pAB2 / /pAB2 : ActiveBasic 2.62 のソースとして読む
' 戻り値 true : 成り立つ  false : 成り立たない
Function IsOptAB2(buf As *Byte) As boolean
    IsOptAB2 = false
    If ByteStrEqCI("-pAB2", buf) Then IsOptAB2 = true
    If ByteStrEqCI("/pAB2", buf) Then IsOptAB2 = true
End Function

' -linux / /linux : x86-64 Linux の静的 ELF を出す
' 戻り値 true : 成り立つ  false : 成り立たない
Function IsOptLinux(buf As *Byte) As boolean
    IsOptLinux = false
    If ByteStrEqCI("-linux", buf) Then IsOptLinux = true
    If ByteStrEqCI("/linux", buf) Then IsOptLinux = true
End Function

' -X / /X : 呼ばれない関数を消して exe を小さくする（-linux は常に消す）
' 戻り値 true : 成り立つ  false : 成り立たない
Function IsOptDeadStrip(buf As *Byte) As boolean
    IsOptDeadStrip = false
    If ByteStrEqCI("-X", buf) Then IsOptDeadStrip = true
    If ByteStrEqCI("/X", buf) Then IsOptDeadStrip = true
End Function

Sub USAGE()
    Print "actba64 - ActiveBasic subset compiler"
    Print "usage: actba64 <src.abp|.pj> [-actba32] [-linux] [-X] [-pN88] [-pAB2] -o <out>"
    Print "  -linux write a static x86-64 Linux ELF"
    Print "  -X     drop procedures that are never called (always on with -linux)"
    Print "  -pN88 read the source as N88-BASIC (line numbers optional)"
    Print "  -pAB2 read the source as ActiveBasic 2.62"
    Print "  -o optional if .pj has #OUTPUT_RELEASE"
    End
End Sub

' -o / -O / /o
' 戻り値 true : 成り立つ  false : 成り立たない
Function IsOptO(buf As *Byte) As boolean
    If ByteStrEqCI("-o", buf) Then
        IsOptO = true
    ElseIf ByteStrEqCI("/o", buf) Then
        IsOptO = true
    Else
        IsOptO = false
    End If
End Function

' -actba32 / /actba32
' 戻り値 true : 成り立つ  false : 成り立たない
Function IsOptActba32(buf As *Byte) As boolean
    If ByteStrEqCI("-actba32", buf) Then
        IsOptActba32 = true
    ElseIf ByteStrEqCI("/actba32", buf) Then
        IsOptActba32 = true
    Else
        IsOptActba32 = false
    End If
End Function

' exe と同じ場所の actba_lang_ja.csv を読む。無ければ何もしない（英語のまま）。CP932 で保存した CSV も UTF-8 にして読む
Sub LangInit()
    Dim path(PP_ONCE_PATH - 1) As Byte
    Dim buf As *Byte
    Dim sz As Long
    If Not PpToolDir(VarPtr(path)) Then Exit Sub
    lstrcat(VarPtr(path), LANG_FILE)
    buf = LoadText(VarPtr(path), sz)
    If buf <> NULL Then LangLoadText(buf)
End Sub

Sub Main()
    Dim outName[MAX_PATH] As Byte
    Dim srcName[MAX_PATH] As Byte
    Dim arg[MAX_PATH] As Byte
    Dim ok As Long
    Dim i As Long
    Dim haveOut As Long
    Dim haveSrc As Long

    haveOut = 0
    haveSrc = 0
    outName[0] = 0
    srcName[0] = 0
    TySetTarget32(0)
    LangInit()

    i = 1
    While GetCmd(i, arg) <> 0
        If IsOptO(arg) Then
            If GetCmd(i + 1, outName) = 0 Then
                Print "error: " + Tr$(1171, "-o requires an output path")
                ExitProcess(1)
            End If
            haveOut = 1
            i = i + 2
        ElseIf IsOptActba32(arg) Then
            TySetTarget32(1)
            i = i + 1
        ElseIf IsOptLinux(arg) Then
            TySetLinux(1)
            i = i + 1
        ElseIf IsOptDeadStrip(arg) Then
            TySetDeadStrip(1)
            i = i + 1
        ElseIf IsOptN88(arg) Then
            CompSetN88(1)
            i = i + 1
        ElseIf IsOptAB2(arg) Then
            CompSetAB2(1)
            i = i + 1
        Else
            If haveSrc <> 0 Then
                Print "error: " + Tr$(1172, "unexpected argument")
                USAGE()
            End If
            lstrcpy(VarPtr(srcName), arg)
            haveSrc = 1
            i = i + 1
        End If
    Wend

    If haveSrc = 0 Then
        USAGE()
    End If
    If haveOut = 0 Then
        haveOut = PpResolvePjOut(VarPtr(srcName), VarPtr(outName))
    End If
    If haveOut = 0 Then
        USAGE()
    End If

    ok = CompileInput(srcName, outName)
    If ok = 0 Then
        ExitProcess(1)
    End If
End Sub

Main()
End
