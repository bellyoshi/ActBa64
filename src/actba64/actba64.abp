#console

#include "actba64.idx"

' actba64 - ActiveBasic subset -> PE32+ (default) or PE32 (-actba32)
' modules: actba64.pj (#SOURCE). actba64.idx is for single-file host builds only.
' usage:
'   actba64 <src.abp|.pj> [-actba32] -o <out.exe>

Sub USAGE()
    Print "actba64 - ActiveBasic subset compiler"
    Print "usage: actba64 <src.abp|.pj> [-actba32] -o <out>"
    Print "  -o optional if .pj has #OUTPUT_RELEASE"
    End
End Sub

' -o / -O / /o
' 戻り値 true : 成り立つ  false : 成り立たない
Function IsOptO(buf As *Byte) As boolean
    If ByteStrEqCI("-o", buf) Then
        IsOptO = true
    ElseIf ByteStrEqCI("/o", buf) Then
        IsOptO = true
    Else
        IsOptO = false
    End If
End Function

' -actba32 / /actba32
' 戻り値 true : 成り立つ  false : 成り立たない
Function IsOptActba32(buf As *Byte) As boolean
    If ByteStrEqCI("-actba32", buf) Then
        IsOptActba32 = true
    ElseIf ByteStrEqCI("/actba32", buf) Then
        IsOptActba32 = true
    Else
        IsOptActba32 = false
    End If
End Function

Sub Main()
    Dim outName[MAX_PATH] As Byte
    Dim srcName[MAX_PATH] As Byte
    Dim arg[MAX_PATH] As Byte
    Dim ok As Long
    Dim i As Long
    Dim haveOut As Long
    Dim haveSrc As Long

    haveOut = 0
    haveSrc = 0
    outName[0] = 0
    srcName[0] = 0
    TySetTarget32(0)

    i = 1
    While GetCmd(i, arg) <> 0
        If IsOptO(arg) Then
            If GetCmd(i + 1, outName) = 0 Then
                Print "error: -o requires an output path"
                ExitProcess(1)
            End If
            haveOut = 1
            i = i + 2
        ElseIf IsOptActba32(arg) Then
            TySetTarget32(1)
            i = i + 1
        Else
            If haveSrc <> 0 Then
                Print "error: unexpected argument"
                USAGE()
            End If
            lstrcpy(VarPtr(srcName), arg)
            haveSrc = 1
            i = i + 1
        End If
    Wend

    If haveSrc = 0 Then
        USAGE()
    End If
    If haveOut = 0 Then
        haveOut = PpResolvePjOut(VarPtr(srcName), VarPtr(outName))
    End If
    If haveOut = 0 Then
        USAGE()
    End If

    ok = CompileInput(srcName, outName)
    If ok = 0 Then
        ExitProcess(1)
    End If
End Sub

Main()
End
