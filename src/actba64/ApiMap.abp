    ApiMap_imm32 = 0
End Function

Sub ApiLowerName(name As *Byte, n As *Byte)
    Dim i As Long
    Dim c As Long
    i = 0
    While name[i] <> 0 And i < 63
        c = name[i]
        If c >= 65 And c <= 90 Then c = c + 32
        n[i] = c As Byte
        i = i + 1
    Wend
    n[i] = 0
End Sub

Function ApiMapKernel32(n As *Byte, ByRef dllKind As Long, apiOut As *Byte) As Long
    ApiMapKernel32 = 1
    If ApiMap_kernel321(n, dllKind, apiOut) <> 0 Then Exit Function
    If ApiMap_kernel322(n, dllKind, apiOut) <> 0 Then Exit Function
    ApiMapKernel32 = 0
End Function

Function ApiMapUser32(n As *Byte, ByRef dllKind As Long, apiOut As *Byte) As Long
    ApiMapUser32 = 1
    If ApiMap_user321(n, dllKind, apiOut) <> 0 Then Exit Function
    If ApiMap_user322(n, dllKind, apiOut) <> 0 Then Exit Function
    If ApiMap_user323(n, dllKind, apiOut) <> 0 Then Exit Function
    If ApiMap_user324(n, dllKind, apiOut) <> 0 Then Exit Function
    ApiMapUser32 = 0
End Function

Function ApiMapOther(n As *Byte, ByRef dllKind As Long, apiOut As *Byte) As Long
    ApiMapOther = 1
    If ApiMap_gdi321(n, dllKind, apiOut) <> 0 Then Exit Function
    If ApiMap_gdi322(n, dllKind, apiOut) <> 0 Then Exit Function
    If ApiMap_comdlg32(n, dllKind, apiOut) <> 0 Then Exit Function
    If ApiMap_shell32(n, dllKind, apiOut) <> 0 Then Exit Function
    If ApiMap_imm32(n, dllKind, apiOut) <> 0 Then Exit Function
    ApiMapOther = 0
End Function

Function LowMapWinApi(name As *Byte, ByRef dllKind As Long, apiOut As *Byte) As Long
    Dim n(63) As Byte

    LowMapWinApi = 0
    dllKind = 0
    apiOut[0] = 0
    ApiLowerName(name, VarPtr(n))

    If ApiMapKernel32(VarPtr(n), dllKind, apiOut) <> 0 Then
        LowMapWinApi = 1
        Exit Function
    End If
    If ApiMapUser32(VarPtr(n), dllKind, apiOut) <> 0 Then
        LowMapWinApi = 1
        Exit Function
    End If
    If ApiMapOther(VarPtr(n), dllKind, apiOut) <> 0 Then
        LowMapWinApi = 1
        Exit Function
    End If
End Function
