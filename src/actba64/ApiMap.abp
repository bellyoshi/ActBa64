' ===================================================
'  ApiMap - WinAPI name -> DLL kind + export name
' ===================================================

Function ApiCopy(dst As *Byte, s As *Byte) As Long
    lstrcpy(dst, s)
    ApiCopy = 1
End Function

Function ApiNameEq(a As *Byte, b As *Byte) As Long
    ApiNameEq = ByteNameEqCI(a, b)
End Function

' Lib "kernel32" / "kernel32.dll" -> IR_DLL_*
Function LowDllKindFromLib(libName As *Byte) As Long
    Dim k(63) As Byte
    Dim i As Long
    Dim j As Long
    Dim c As Long

    LowDllKindFromLib = 0
    i = 0
    j = 0
    While libName[i] <> 0 And j < 63
        c = libName[i]
        If c >= 65 And c <= 90 Then c = c + 32
        k[j] = c As Byte
        j = j + 1
        i = i + 1
    Wend
    k[j] = 0
    ' strip .dll
    i = 0
    While k[i] <> 0
        If k[i] = 46 Then
            If k[i + 1] = 100 And k[i + 2] = 108 And k[i + 3] = 108 Then
                k[i] = 0
            End If
            Exit While
        End If
        i = i + 1
    Wend
    lstrcpy(VarPtr(k), VarPtr(k))
    If ApiNameEq(VarPtr(k), "kernel32") <> 0 Then
        LowDllKindFromLib = IR_DLL_KERNEL32
    ElseIf ApiNameEq(VarPtr(k), "user32") <> 0 Then
        LowDllKindFromLib = IR_DLL_USER32
    ElseIf ApiNameEq(VarPtr(k), "gdi32") <> 0 Then
        LowDllKindFromLib = IR_DLL_GDI32
    ElseIf ApiNameEq(VarPtr(k), "imm32") <> 0 Then
        LowDllKindFromLib = IR_DLL_IMM32
    ElseIf ApiNameEq(VarPtr(k), "comdlg32") <> 0 Then
        LowDllKindFromLib = IR_DLL_COMDLG32
    ElseIf ApiNameEq(VarPtr(k), "shell32") <> 0 Then
        LowDllKindFromLib = IR_DLL_SHELL32
    ElseIf ApiNameEq(VarPtr(k), "ole32") <> 0 Then
        LowDllKindFromLib = IR_DLL_OLE32
    ElseIf ApiNameEq(VarPtr(k), "d3d11") <> 0 Then
        LowDllKindFromLib = IR_DLL_D3D11
    ElseIf ApiNameEq(VarPtr(k), "d3dcompiler_47") <> 0 Then
        LowDllKindFromLib = IR_DLL_D3DCOMPILER
    End If
End Function

' Map call name to dllKind + api export name. Returns 1 on success.
Function ApiHit1(n As *Byte, key As *Byte, dll As Long, expName As *Byte, ByRef dllKind As Long, apiOut As *Byte) As Long
    ApiHit1 = 0
    If ApiNameEq(n, key) = 0 Then Exit Function
    dllKind = dll
    ApiCopy(apiOut, expName)
    ApiHit1 = 1
End Function

Function ApiHit2(n As *Byte, key1 As *Byte, key2 As *Byte, dll As Long, expName As *Byte, ByRef dllKind As Long, apiOut As *Byte) As Long
    ApiHit2 = 0
    If ApiNameEq(n, key1) = 0 Then
        If ApiNameEq(n, key2) = 0 Then Exit Function
    End If
    dllKind = dll
    ApiCopy(apiOut, expName)
    ApiHit2 = 1
End Function

Function ApiMap_kernel321(n As *Byte, ByRef dllKind As Long, apiOut As *Byte) As Long
    ApiMap_kernel321 = 1
    If ApiHit1(n, "exitprocess", IR_DLL_KERNEL32, "ExitProcess", dllKind, apiOut) <> 0 Then Exit Function
    If ApiHit2(n, "createfile", "createfilea", IR_DLL_KERNEL32, "CreateFileA", dllKind, apiOut) <> 0 Then Exit Function
    If ApiHit1(n, "closehandle", IR_DLL_KERNEL32, "CloseHandle", dllKind, apiOut) <> 0 Then Exit Function
    If ApiHit1(n, "getfilesize", IR_DLL_KERNEL32, "GetFileSize", dllKind, apiOut) <> 0 Then Exit Function
    If ApiHit2(n, "setfilepointer", "setfilepointer", IR_DLL_KERNEL32, "SetFilePointer", dllKind, apiOut) <> 0 Then Exit Function
    If ApiHit1(n, "readfile", IR_DLL_KERNEL32, "ReadFile", dllKind, apiOut) <> 0 Then Exit Function
    If ApiHit1(n, "writefile", IR_DLL_KERNEL32, "WriteFile", dllKind, apiOut) <> 0 Then Exit Function
    If ApiHit2(n, "getfileattributes", "getfileattributesa", IR_DLL_KERNEL32, "GetFileAttributesA", dllKind, apiOut) <> 0 Then Exit Function
    If ApiHit2(n, "getcommandline", "getcommandlinea", IR_DLL_KERNEL32, "GetCommandLineA", dllKind, apiOut) <> 0 Then Exit Function
    If ApiHit2(n, "lstrlen", "lstrlena", IR_DLL_KERNEL32, "lstrlenA", dllKind, apiOut) <> 0 Then Exit Function
    If ApiHit2(n, "lstrcpy", "lstrcpya", IR_DLL_KERNEL32, "lstrcpyA", dllKind, apiOut) <> 0 Then Exit Function
    If ApiHit2(n, "lstrcat", "lstrcata", IR_DLL_KERNEL32, "lstrcatA", dllKind, apiOut) <> 0 Then Exit Function
    If ApiHit2(n, "lstrcmp", "lstrcmpa", IR_DLL_KERNEL32, "lstrcmpA", dllKind, apiOut) <> 0 Then Exit Function
    If ApiHit1(n, "getprocessheap", IR_DLL_KERNEL32, "GetProcessHeap", dllKind, apiOut) <> 0 Then Exit Function
    If ApiHit1(n, "heapalloc", IR_DLL_KERNEL32, "HeapAlloc", dllKind, apiOut) <> 0 Then Exit Function
    If ApiHit1(n, "heapfree", IR_DLL_KERNEL32, "HeapFree", dllKind, apiOut) <> 0 Then Exit Function
    If ApiHit1(n, "getstdhandle", IR_DLL_KERNEL32, "GetStdHandle", dllKind, apiOut) <> 0 Then Exit Function
    ApiMap_kernel321 = 0
End Function

Function ApiMap_kernel322(n As *Byte, ByRef dllKind As Long, apiOut As *Byte) As Long
    ApiMap_kernel322 = 1
    If ApiHit2(n, "getmodulehandle", "getmodulehandlea", IR_DLL_KERNEL32, "GetModuleHandleA", dllKind, apiOut) <> 0 Then Exit Function
    If ApiHit2(n, "getmodulefilename", "getmodulefilenamea", IR_DLL_KERNEL32, "GetModuleFileNameA", dllKind, apiOut) <> 0 Then Exit Function
    If ApiHit2(n, "createprocess", "createprocessa", IR_DLL_KERNEL32, "CreateProcessA", dllKind, apiOut) <> 0 Then Exit Function
    If ApiHit1(n, "waitforsingleobject", IR_DLL_KERNEL32, "WaitForSingleObject", dllKind, apiOut) <> 0 Then Exit Function
    If ApiHit1(n, "gettickcount", IR_DLL_KERNEL32, "GetTickCount", dllKind, apiOut) <> 0 Then Exit Function
    If ApiHit1(n, "multibytetowidechar", IR_DLL_KERNEL32, "MultiByteToWideChar", dllKind, apiOut) <> 0 Then Exit Function
    If ApiHit1(n, "widechartomultibyte", IR_DLL_KERNEL32, "WideCharToMultiByte", dllKind, apiOut) <> 0 Then Exit Function
    If ApiHit1(n, "getexitcodeprocess", IR_DLL_KERNEL32, "GetExitCodeProcess", dllKind, apiOut) <> 0 Then Exit Function
    If ApiHit1(n, "globalalloc", IR_DLL_KERNEL32, "GlobalAlloc", dllKind, apiOut) <> 0 Then Exit Function
    If ApiHit1(n, "globallock", IR_DLL_KERNEL32, "GlobalLock", dllKind, apiOut) <> 0 Then Exit Function
    If ApiHit1(n, "globalunlock", IR_DLL_KERNEL32, "GlobalUnlock", dllKind, apiOut) <> 0 Then Exit Function
    If ApiHit1(n, "rtlmovememory", IR_DLL_KERNEL32, "RtlMoveMemory", dllKind, apiOut) <> 0 Then Exit Function
    If ApiHit1(n, "rtlfillmemory", IR_DLL_KERNEL32, "RtlFillMemory", dllKind, apiOut) <> 0 Then Exit Function
    If ApiHit1(n, "createpipe", IR_DLL_KERNEL32, "CreatePipe", dllKind, apiOut) <> 0 Then Exit Function
    If ApiHit1(n, "sethandleinformation", IR_DLL_KERNEL32, "SetHandleInformation", dllKind, apiOut) <> 0 Then Exit Function
    ApiMap_kernel322 = 0
End Function

