' ===================================================
'  ApiMap - Declare Lib "dll" -> IR_DLL_*
' ===================================================

Function ApiNameEq(a As *Byte, b As *Byte) As Long
    ApiNameEq = ByteNameEqCI(a, b)
End Function

' Lib "kernel32" / "kernel32.dll" -> IR_DLL_*
Function LowDllKindFromLib(libName As *Byte) As Long
    Dim kw(63) As Byte
    Dim i As Long
    Dim j As Long
    Dim c As Long

    LowDllKindFromLib = 0
    i = 0
    j = 0
    While libName[i] <> 0 And j < 63
        c = libName[i]
        If c >= 65 And c <= 90 Then c = c + 32
        kw[j] = c As Byte
        j = j + 1
        i = i + 1
    Wend
    kw[j] = 0
    ' strip .dll
    i = 0
    While kw[i] <> 0
        If kw[i] = 46 Then
            If kw[i + 1] = 100 And kw[i + 2] = 108 And kw[i + 3] = 108 Then
                kw[i] = 0
            End If
            Exit While
        End If
        i = i + 1
    Wend
    If ApiNameEq(VarPtr(kw), "kernel32") <> 0 Then
        LowDllKindFromLib = IR_DLL_KERNEL32
    ElseIf ApiNameEq(VarPtr(kw), "user32") <> 0 Then
        LowDllKindFromLib = IR_DLL_USER32
    ElseIf ApiNameEq(VarPtr(kw), "gdi32") <> 0 Then
        LowDllKindFromLib = IR_DLL_GDI32
    ElseIf ApiNameEq(VarPtr(kw), "imm32") <> 0 Then
        LowDllKindFromLib = IR_DLL_IMM32
    ElseIf ApiNameEq(VarPtr(kw), "comdlg32") <> 0 Then
        LowDllKindFromLib = IR_DLL_COMDLG32
    ElseIf ApiNameEq(VarPtr(kw), "shell32") <> 0 Then
        LowDllKindFromLib = IR_DLL_SHELL32
    ElseIf ApiNameEq(VarPtr(kw), "ole32") <> 0 Then
        LowDllKindFromLib = IR_DLL_OLE32
    ElseIf ApiNameEq(VarPtr(kw), "d3d11") <> 0 Then
        LowDllKindFromLib = IR_DLL_D3D11
    ElseIf ApiNameEq(VarPtr(kw), "d3dcompiler_47") <> 0 Then
        LowDllKindFromLib = IR_DLL_D3DCOMPILER
    End If
End Function
