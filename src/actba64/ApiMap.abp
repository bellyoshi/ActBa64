    If ApiHit1(n, "immgetcompositionstringa", IR_DLL_IMM32, "ImmGetCompositionStringA", dllKind, apiOut) <> 0 Then Exit Function
    If ApiHit1(n, "immgetcompositionstringw", IR_DLL_IMM32, "ImmGetCompositionStringW", dllKind, apiOut) <> 0 Then Exit Function
