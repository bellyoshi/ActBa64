Function ApiMap_imm32(n As *Byte, ByRef dllKind As Long, apiOut As *Byte) As Long
    ApiMap_imm32 = 1
    If ApiHit1(n, "immgetcontext", IR_DLL_IMM32, "ImmGetContext", dllKind, apiOut) <> 0 Then Exit Function
