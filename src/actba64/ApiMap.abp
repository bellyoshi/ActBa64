' ===================================================
'  ApiMap - WinAPI name -> DLL kind + export name
' ===================================================

Function ApiCopy(dst As *Byte, s As *Byte) As Long
    lstrcpy(dst, s)
    ApiCopy = 1
End Function

Function ApiNameEq(a As *Byte, b As *Byte) As Long
    Dim i As Long
    Dim ca As Long
    Dim cb As Long
    ApiNameEq = 0
    i = 0
    Do
        ca = a[i]
        cb = b[i]
        If ca >= 65 And ca <= 90 Then ca = ca + 32
        If cb >= 65 And cb <= 90 Then cb = cb + 32
        If ca <> cb Then Exit Function
        If ca = 0 Then
            ApiNameEq = 1
            Exit Function
        End If
        i = i + 1
    Loop
End Function

' Lib "kernel32" / "kernel32.dll" -> IR_DLL_*
Function LowDllKindFromLib(libName As *Byte) As Long
    Dim k(63) As Byte
    Dim i As Long
    Dim j As Long
    Dim c As Long

    LowDllKindFromLib = 0
    i = 0
    j = 0
    While libName[i] <> 0 And j < 63
        c = libName[i]
        If c >= 65 And c <= 90 Then c = c + 32
        k[j] = c
        j = j + 1
        i = i + 1
    Wend
    k[j] = 0
    ' strip .dll
    i = 0
    While k[i] <> 0
        If k[i] = 46 Then
            If k[i + 1] = 100 And k[i + 2] = 108 And k[i + 3] = 108 Then
                k[i] = 0
            End If
            Exit While
        End If
        i = i + 1
    Wend
    lstrcpy(VarPtr(k), VarPtr(k))
    If ApiNameEq(VarPtr(k), "kernel32") <> 0 Then
        LowDllKindFromLib = IR_DLL_KERNEL32
    ElseIf ApiNameEq(VarPtr(k), "user32") <> 0 Then
        LowDllKindFromLib = IR_DLL_USER32
    ElseIf ApiNameEq(VarPtr(k), "gdi32") <> 0 Then
        LowDllKindFromLib = IR_DLL_GDI32
    ElseIf ApiNameEq(VarPtr(k), "imm32") <> 0 Then
        LowDllKindFromLib = IR_DLL_IMM32
    ElseIf ApiNameEq(VarPtr(k), "comdlg32") <> 0 Then
        LowDllKindFromLib = IR_DLL_COMDLG32
    ElseIf ApiNameEq(VarPtr(k), "shell32") <> 0 Then
        LowDllKindFromLib = IR_DLL_SHELL32
    End If
End Function

' Map call name to dllKind + api export name. Returns 1 on success.
Function LowMapWinApi(name As *Byte, ByRef dllKind As Long, apiOut As *Byte) As Long
    Dim n(63) As Byte
    Dim i As Long
    Dim c As Long

    LowMapWinApi = 0
    dllKind = 0
    apiOut[0] = 0
    i = 0
    While name[i] <> 0 And i < 63
        c = name[i]
        If c >= 65 And c <= 90 Then c = c + 32
        n[i] = c
        i = i + 1
    Wend
    n[i] = 0

    ' --- kernel32 ---
    If ApiNameEq(VarPtr(n), "exitprocess") <> 0 Then
        dllKind = IR_DLL_KERNEL32
        ApiCopy(apiOut, "ExitProcess")
        LowMapWinApi = 1
        Exit Function
    End If
    If ApiNameEq(VarPtr(n), "createfile") <> 0 Or ApiNameEq(VarPtr(n), "createfilea") <> 0 Then
        dllKind = IR_DLL_KERNEL32
        ApiCopy(apiOut, "CreateFileA")
        LowMapWinApi = 1
        Exit Function
    End If
    If ApiNameEq(VarPtr(n), "closehandle") <> 0 Then
        dllKind = IR_DLL_KERNEL32
        ApiCopy(apiOut, "CloseHandle")
        LowMapWinApi = 1
        Exit Function
    End If
    If ApiNameEq(VarPtr(n), "getfilesize") <> 0 Then
