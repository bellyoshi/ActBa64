#console
Declare Function ExitProcess Lib "kernel32.dll" (uExitCode As Long) As Long
Declare Function calloc Lib "msvcrt.dll" (n As Long) As *Byte
Type IrList
    count As Long
    capacity As Long
End Type
Function MakeList(ByRef list As *IrList) As Long
    Dim p As *Byte
    MakeList = 0
    p = calloc(SizeOf(IrList))
    If p = NULL Then Exit Function
    list = p As *IrList
    list->count = 0
    list->capacity = 262144
    MakeList = 1
End Function
Function UseList(list As *IrList) As Long
    UseList = 0
    If list = NULL Then Exit Function
    UseList = list->capacity
End Function
Sub Main()
    Dim list As *IrList
    Dim n As Long
    list = NULL
    If MakeList(list) = 0 Then ExitProcess(1)
    If list = NULL Then ExitProcess(2)
    n = UseList(list)
    If n <> 262144 Then ExitProcess(3)
    ExitProcess(42)
End Sub
Main()
End
