' ParserN88Paint - LOCATE と PAINT

' LOCATE x,y | LOCATE(x,y) → Locate(x,y)
Function ParseN88LocateStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nCall As Long
    Dim name(15) As Byte
    Dim e1 As Long
    Dim e2 As Long
    Dim arg0 As Long
    Dim nPrev As Long
    Dim nArgs As Long

    ParseN88LocateStmt = -1
    p->pos = p->pos + 1
    If ParseTokKind(p) = TK_LPAREN Then
        p->pos = p->pos + 1
        e1 = ParseExpr(p)
        If e1 < 0 Then Exit Function
        If ParseExpect(p, TK_COMMA) = 0 Then Exit Function
        e2 = ParseExpr(p)
        If e2 < 0 Then Exit Function
        If ParseExpect(p, TK_RPAREN) = 0 Then Exit Function
    Else
        e1 = ParseExpr(p)
        If e1 < 0 Then Exit Function
        If ParseExpect(p, TK_COMMA) = 0 Then Exit Function
        e2 = ParseExpr(p)
        If e2 < 0 Then Exit Function
    End If

    ast = p->ast
    arg0 = -1
    nPrev = -1
    nArgs = 0
    If ParseLinkArg(ast, arg0, nPrev, nArgs, e1) = 0 Then Exit Function
    If ParseLinkArg(ast, arg0, nPrev, nArgs, e2) = 0 Then Exit Function
    lstrcpy(VarPtr(name), "Locate")
    nCall = AstAddNode(ast, AST_CALL)
    If nCall < 0 Then Exit Function
    AstSetStr(ast, nCall, VarPtr(name))
    nodes = ast->nodes
    nodes[nCall].left = arg0
    nodes[nCall].right = -1
    nodes[nCall].num = nArgs
    ParseN88LocateStmt = nCall
End Function

Function ParseN88PaintCall(ast As *Ast, e1 As Long, e2 As Long, e3 As Long, e4 As Long) As Long
    Dim nodes As *AstNode
    Dim nCall As Long
    Dim name(15) As Byte
    Dim arg0 As Long
    Dim nPrev As Long
    Dim nArgs As Long

    ParseN88PaintCall = -1
    arg0 = -1
    nPrev = -1
    nArgs = 0
    If ParseLinkArg(ast, arg0, nPrev, nArgs, e1) = 0 Then Exit Function
    If ParseLinkArg(ast, arg0, nPrev, nArgs, e2) = 0 Then Exit Function
    If ParseLinkArg(ast, arg0, nPrev, nArgs, e3) = 0 Then Exit Function
    If ParseLinkArg(ast, arg0, nPrev, nArgs, e4) = 0 Then Exit Function
    lstrcpy(VarPtr(name), "Paint")
    nCall = AstAddNode(ast, AST_CALL)
    If nCall < 0 Then Exit Function
    AstSetStr(ast, nCall, VarPtr(name))
    nodes = ast->nodes
    nodes[nCall].left = arg0
    nodes[nCall].right = -1
    nodes[nCall].num = nArgs
    ParseN88PaintCall = nCall
End Function

' PAINT (x,y), color1 [, color2] → Paint(x,y,color1,color2)
Function ParseN88PaintStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim e1 As Long
    Dim e2 As Long
    Dim e3 As Long
    Dim e4 As Long

    ParseN88PaintStmt = -1
    p->pos = p->pos + 1
    If ParseExpect(p, TK_LPAREN) = 0 Then Exit Function
    e1 = ParseExpr(p)
    If e1 < 0 Then Exit Function
    If ParseExpect(p, TK_COMMA) = 0 Then Exit Function
    e2 = ParseExpr(p)
    If e2 < 0 Then Exit Function
    If ParseExpect(p, TK_RPAREN) = 0 Then Exit Function
    If ParseExpect(p, TK_COMMA) = 0 Then Exit Function
    e3 = ParseExpr(p)
    If e3 < 0 Then Exit Function
    e4 = -1
    If ParseTokKind(p) = TK_COMMA Then
        p->pos = p->pos + 1
        e4 = ParseExpr(p)
        If e4 < 0 Then Exit Function
    End If

    ast = p->ast
    If e4 < 0 Then
        e4 = e3
    End If
    ParseN88PaintStmt = ParseN88PaintCall(ast, e1, e2, e3, e4)
End Function
