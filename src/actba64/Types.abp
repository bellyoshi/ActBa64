' ===================================================
'  Types - user Type registry (Word/DWord packing)
' ===================================================

Const TYMAX_TYPES = 128
Const TYMAX_FIELDS = 512
Const TYMAX_VIRTS = 1024
Const TYNAME_LEN = 48

Type TypeTable
    nTypes As Long
    nFields As Long
    nVirts As Long
    typeNames As *Byte
    typeSizes As *Long
    typeFirst As *Long
    typeIsClass As *Long
    typeVirtFirst As *Long
    typeVirtCount As *Long
    fieldNames As *Byte
    fieldOffs As *Long
    fieldSizes As *Long
    fieldCounts As *Long
    fieldNext As *Long
    fieldTypeIdxs As *Long
    virtNames As *Byte
    virtNext As *Long
End Type

Function TyNameEq(a As *Byte, b As *Byte) As Long
    Dim i As Long
    Dim ca As Long
    Dim cb As Long
    TyNameEq = 0
    i = 0
    Do
        ca = a[i]
        cb = b[i]
        If ca >= 65 And ca <= 90 Then ca = ca + 32
        If cb >= 65 And cb <= 90 Then cb = cb + 32
        If ca <> cb Then Exit Function
        If ca = 0 Then
            TyNameEq = 1
            Exit Function
        End If
        i = i + 1
    Loop
End Function

Sub TyFree(t As *TypeTable)
    If t = NULL Then Exit Sub
    If t->typeNames <> NULL Then free(t->typeNames)
    If t->typeSizes <> NULL Then free(t->typeSizes)
    If t->typeFirst <> NULL Then free(t->typeFirst)
    If t->typeIsClass <> NULL Then free(t->typeIsClass)
    If t->typeVirtFirst <> NULL Then free(t->typeVirtFirst)
    If t->typeVirtCount <> NULL Then free(t->typeVirtCount)
    If t->fieldNames <> NULL Then free(t->fieldNames)
    If t->fieldOffs <> NULL Then free(t->fieldOffs)
    If t->fieldSizes <> NULL Then free(t->fieldSizes)
    If t->fieldCounts <> NULL Then free(t->fieldCounts)
    If t->fieldNext <> NULL Then free(t->fieldNext)
    If t->fieldTypeIdxs <> NULL Then free(t->fieldTypeIdxs)
    If t->virtNames <> NULL Then free(t->virtNames)
    If t->virtNext <> NULL Then free(t->virtNext)
    free(t)
End Sub

Function TyCreate() As *TypeTable
    Dim t As *TypeTable
    Dim i As Long
    TyCreate = NULL
    t = calloc(SizeOf(TypeTable))
    If t = NULL Then Exit Function
    t->typeNames = calloc(BytesN(TYMAX_TYPES, TYNAME_LEN))
    t->typeSizes = calloc(BytesN(TYMAX_TYPES, SizeOf(Long)))
    t->typeFirst = calloc(BytesN(TYMAX_TYPES, SizeOf(Long)))
    t->typeIsClass = calloc(BytesN(TYMAX_TYPES, SizeOf(Long)))
    t->typeVirtFirst = calloc(BytesN(TYMAX_TYPES, SizeOf(Long)))
    t->typeVirtCount = calloc(BytesN(TYMAX_TYPES, SizeOf(Long)))
    t->fieldNames = calloc(BytesN(TYMAX_FIELDS, TYNAME_LEN))
    t->fieldOffs = calloc(BytesN(TYMAX_FIELDS, SizeOf(Long)))
    t->fieldSizes = calloc(BytesN(TYMAX_FIELDS, SizeOf(Long)))
    t->fieldCounts = calloc(BytesN(TYMAX_FIELDS, SizeOf(Long)))
    t->fieldNext = calloc(BytesN(TYMAX_FIELDS, SizeOf(Long)))
    t->fieldTypeIdxs = calloc(BytesN(TYMAX_FIELDS, SizeOf(Long)))
    t->virtNames = calloc(BytesN(TYMAX_VIRTS, TYNAME_LEN))
    t->virtNext = calloc(BytesN(TYMAX_VIRTS, SizeOf(Long)))
    If t->typeNames = NULL Or t->typeSizes = NULL Or t->typeFirst = NULL Or t->typeIsClass = NULL Or t->typeVirtFirst = NULL Or t->typeVirtCount = NULL Or t->fieldNames = NULL Or t->fieldOffs = NULL Or t->fieldSizes = NULL Or t->fieldCounts = NULL Or t->fieldNext = NULL Or t->fieldTypeIdxs = NULL Or t->virtNames = NULL Or t->virtNext = NULL Then
        TyFree(t)
        Exit Function
    End If
    t->nTypes = 0
    t->nFields = 0
    t->nVirts = 0
    i = 0
    While i < TYMAX_TYPES
        t->typeVirtFirst[i] = -1
        t->typeVirtCount[i] = 0
        i = i + 1
    Wend
    TyCreate = t
End Function

Function TyPrimSize(name As *Byte) As Long
    Dim k(15) As Byte
    TyPrimSize = 0
    lstrcpy(VarPtr(k), "byte")
    If TyNameEq(name, VarPtr(k)) <> 0 Then
        TyPrimSize = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "word")
    If TyNameEq(name, VarPtr(k)) <> 0 Then
        TyPrimSize = 2
        Exit Function
    End If
    lstrcpy(VarPtr(k), "dword")
    If TyNameEq(name, VarPtr(k)) <> 0 Then
        TyPrimSize = 4
        Exit Function
    End If
    lstrcpy(VarPtr(k), "long")
    If TyNameEq(name, VarPtr(k)) <> 0 Then
        TyPrimSize = 4
        Exit Function
    End If
    lstrcpy(VarPtr(k), "double")
    If TyNameEq(name, VarPtr(k)) <> 0 Then
        TyPrimSize = 8
        Exit Function
    End If
    lstrcpy(VarPtr(k), "single")
    If TyNameEq(name, VarPtr(k)) <> 0 Then
        TyPrimSize = 4
        Exit Function
    End If
    lstrcpy(VarPtr(k), "string")
    If TyNameEq(name, VarPtr(k)) <> 0 Then
        TyPrimSize = TyPtrSize()
        Exit Function
    End If
    lstrcpy(VarPtr(k), "handle")
    If TyNameEq(name, VarPtr(k)) <> 0 Then
        TyPrimSize = TyPtrSize()
        Exit Function
    End If
End Function

Function TyFind(t As *TypeTable, name As *Byte) As Long
    Dim i As Long
    Dim names As *Byte
    Dim off As Long
    TyFind = -1
    If t = NULL Then Exit Function
    names = t->typeNames
    i = 0
    While i < t->nTypes
        off = i * TYNAME_LEN
        If TyNameEq(VarPtr(names[off]), name) <> 0 Then
            TyFind = i
            Exit Function
        End If
        i = i + 1
    Wend
End Function

Function TySizeOfName(t As *TypeTable, name As *Byte) As Long
    Dim sz As Long
    Dim ti As Long
    Dim sizes As *Long
    TySizeOfName = 0
    sz = TyPrimSize(name)
    If sz > 0 Then
        TySizeOfName = sz
        Exit Function
    End If
    ti = TyFind(t, name)
    If ti < 0 Then Exit Function
    sizes = t->typeSizes
    TySizeOfName = sizes[ti]
End Function

Function TyAdd(t As *TypeTable, name As *Byte) As Long
    Dim i As Long
    Dim names As *Byte
    Dim firsts As *Long
    Dim sizes As *Long
    Dim j As Long
    Dim off As Long

    TyAdd = -1
    If t = NULL Then Exit Function
    i = TyFind(t, name)
    If i >= 0 Then
        TyAdd = i
        Exit Function
    End If
    If t->nTypes >= TYMAX_TYPES Then Exit Function
    i = t->nTypes
    names = t->typeNames
    firsts = t->typeFirst
    sizes = t->typeSizes
    off = i * TYNAME_LEN
    j = 0
    While name[j] <> 0 And j < TYNAME_LEN - 1
        names[off + j] = name[j]
        j = j + 1
    Wend
    names[off + j] = 0
    sizes[i] = 0
    firsts[i] = -1
    t->typeIsClass[i] = 0
    t->typeVirtFirst[i] = -1
    t->typeVirtCount[i] = 0
    t->nTypes = i + 1
    TyAdd = i
End Function

Function TySetClass(t As *TypeTable, typeIdx As Long) As Long
    TySetClass = 0
    If t = NULL Then Exit Function
    If typeIdx < 0 Or typeIdx >= t->nTypes Then Exit Function
    t->typeIsClass[typeIdx] = 1
    TySetClass = 1
End Function

Function TyIsClass(t As *TypeTable, typeIdx As Long) As Long
    TyIsClass = 0
    If t = NULL Then Exit Function
    If typeIdx < 0 Or typeIdx >= t->nTypes Then Exit Function
    If t->typeIsClass[typeIdx] <> 0 Then TyIsClass = 1
End Function

' C 互換: 型のアラインメント（ネスト UDT は要素の最大整列。size 丸めではない）
Function TyAlignOf(t As *TypeTable, typeIdx As Long) As Long
    Dim fi As Long
    Dim nexts As *Long
    Dim firsts As *Long
    Dim sizes As *Long
    Dim tys As *Long
    Dim tsizes As *Long
    Dim a As Long
    Dim best As Long
    Dim esz As Long
    Dim fty As Long

    TyAlignOf = 1
    If t = NULL Then Exit Function
    If typeIdx < 0 Or typeIdx >= t->nTypes Then Exit Function
    firsts = t->typeFirst
    nexts = t->fieldNext
    sizes = t->fieldSizes
    tys = t->fieldTypeIdxs
    tsizes = t->typeSizes
    best = 1
    fi = firsts[typeIdx]
    If fi < 0 Then
        esz = tsizes[typeIdx]
        If esz >= 8 Then
            TyAlignOf = 8
        ElseIf esz >= 4 Then
            TyAlignOf = 4
        ElseIf esz >= 2 Then
            TyAlignOf = 2
        End If
        Exit Function
    End If
    While fi >= 0
        fty = tys[fi]
        esz = sizes[fi]
        If fty >= 0 Then
            a = TyAlignOf(t, fty)
        Else
            a = esz
            If a > 8 Then a = 8
            If a < 1 Then a = 1
        End If
        If a > best Then best = a
        fi = nexts[fi]
    Wend
    TyAlignOf = best
End Function

' End Type 時にサイズを型アラインへ切り上げ（MSVC 互換）
Sub TyFinalizeType(t As *TypeTable, typeIdx As Long)
    Dim tsizes As *Long
    Dim a As Long
    Dim sz As Long
    Dim remn As Long

    If t = NULL Then Exit Sub
    If typeIdx < 0 Or typeIdx >= t->nTypes Then Exit Sub
    a = TyAlignOf(t, typeIdx)
    If a < 1 Then Exit Sub
    tsizes = t->typeSizes
    sz = tsizes[typeIdx]
    remn = sz Mod a
    If remn <> 0 Then
        sz = sz + (a - remn)
        tsizes[typeIdx] = sz
    End If
End Sub

Function TyAddField(t As *TypeTable, typeIdx As Long, name As *Byte, elemSize As Long, count As Long, fieldTy As Long) As Long
    Dim fi As Long
    Dim names As *Byte
    Dim offs As *Long
    Dim sizes As *Long
    Dim counts As *Long
    Dim nexts As *Long
    Dim firsts As *Long
    Dim tys As *Long
    Dim tsizes As *Long
    Dim j As Long
    Dim off As Long
    Dim align As Long
    Dim cur As Long
    Dim last As Long

    TyAddField = 0
    If t = NULL Then Exit Function
    If typeIdx < 0 Or typeIdx >= t->nTypes Then Exit Function
    If elemSize <= 0 Or count <= 0 Then Exit Function
    If t->nFields >= TYMAX_FIELDS Then Exit Function

    ' ネスト UDT は「サイズ」ではなく「型のアライン」で整列（DXGI 等）
    If fieldTy >= 0 Then
        align = TyAlignOf(t, fieldTy)
    Else
        align = elemSize
    End If
    If align > 8 Then align = 8
    If align < 1 Then align = 1
    tsizes = t->typeSizes
    off = tsizes[typeIdx]
    cur = align - 1
    last = off And cur
    While last <> 0
        off = off + 1
        last = off And cur
    Wend

    fi = t->nFields
    names = t->fieldNames
    offs = t->fieldOffs
    sizes = t->fieldSizes
    counts = t->fieldCounts
    nexts = t->fieldNext
    firsts = t->typeFirst
    tys = t->fieldTypeIdxs

    j = 0
    cur = fi * TYNAME_LEN
    While name[j] <> 0 And j < TYNAME_LEN - 1
        names[cur + j] = name[j]
        j = j + 1
    Wend
    names[cur + j] = 0
    offs[fi] = off
    sizes[fi] = elemSize
    counts[fi] = count
    tys[fi] = fieldTy
    nexts[fi] = -1

    If firsts[typeIdx] < 0 Then
        firsts[typeIdx] = fi
    Else
        last = firsts[typeIdx]
        While nexts[last] >= 0
            last = nexts[last]
        Wend
        nexts[last] = fi
    End If

    tsizes[typeIdx] = off + elemSize * count
    t->nFields = fi + 1
    TyAddField = 1
End Function

Function TyFindField(t As *TypeTable, typeIdx As Long, name As *Byte, ByRef outOff As Long, ByRef outSize As Long, ByRef outCount As Long) As Long
    Dim fi As Long
    Dim names As *Byte
    Dim offs As *Long
    Dim sizes As *Long
    Dim counts As *Long
    Dim nexts As *Long
    Dim firsts As *Long
    Dim cur As Long

    TyFindField = 0
    outOff = 0
    outSize = 0
    outCount = 0
    If t = NULL Then Exit Function
    If typeIdx < 0 Or typeIdx >= t->nTypes Then Exit Function
    names = t->fieldNames
    offs = t->fieldOffs
    sizes = t->fieldSizes
    counts = t->fieldCounts
    nexts = t->fieldNext
    firsts = t->typeFirst
    fi = firsts[typeIdx]
    While fi >= 0
        cur = fi * TYNAME_LEN
        If TyNameEq(VarPtr(names[cur]), name) <> 0 Then
            outOff = offs[fi]
            outSize = sizes[fi]
            outCount = counts[fi]
            TyFindField = 1
            Exit Function
        End If
        fi = nexts[fi]
    Wend
End Function

Function TyFindFieldEx(t As *TypeTable, typeIdx As Long, name As *Byte, ByRef outOff As Long, ByRef outSize As Long, ByRef outCount As Long, ByRef outFieldTy As Long) As Long
    Dim fi As Long
    Dim names As *Byte
    Dim offs As *Long
    Dim sizes As *Long
    Dim counts As *Long
    Dim nexts As *Long
    Dim firsts As *Long
    Dim tys As *Long
    Dim cur As Long

    TyFindFieldEx = 0
    outOff = 0
    outSize = 0
    outCount = 0
    outFieldTy = -1
    If t = NULL Then Exit Function
    If typeIdx < 0 Or typeIdx >= t->nTypes Then Exit Function
    names = t->fieldNames
    offs = t->fieldOffs
    sizes = t->fieldSizes
    counts = t->fieldCounts
    nexts = t->fieldNext
    firsts = t->typeFirst
    tys = t->fieldTypeIdxs
    fi = firsts[typeIdx]
    While fi >= 0
        cur = fi * TYNAME_LEN
        If TyNameEq(VarPtr(names[cur]), name) <> 0 Then
            outOff = offs[fi]
            outSize = sizes[fi]
            outCount = counts[fi]
            outFieldTy = tys[fi]
            TyFindFieldEx = 1
            Exit Function
        End If
        fi = nexts[fi]
    Wend
End Function

' Virtual メソッドを追加。戻り値は vtable スロット番号（失敗時 -1）
' 各型のスロットは virtNames[typeVirtFirst .. + typeVirtCount) の連続領域
Function TyAddVirt(t As *TypeTable, typeIdx As Long, name As *Byte) As Long
    Dim vi As Long
    Dim names As *Byte
    Dim firsts As *Long
    Dim counts As *Long
    Dim j As Long
    Dim cur As Long
    Dim base As Long
    Dim cnt As Long

    TyAddVirt = -1
    If t = NULL Then Exit Function
    If typeIdx < 0 Or typeIdx >= t->nTypes Then Exit Function
    If t->nVirts >= TYMAX_VIRTS Then Exit Function

    firsts = t->typeVirtFirst
    counts = t->typeVirtCount
    names = t->virtNames
    cnt = counts[typeIdx]
    base = firsts[typeIdx]
    If cnt = 0 Or base < 0 Then
        base = t->nVirts
        firsts[typeIdx] = base
        counts[typeIdx] = 0
        cnt = 0
    Else
        ' 連続配置のため、末尾に足すのはこの型が最後に追加された場合のみ
        If base + cnt <> t->nVirts Then
            Print "error: Virtual slot packing"
            Exit Function
        End If
    End If

    vi = t->nVirts
    j = 0
    cur = vi * TYNAME_LEN
    While name[j] <> 0 And j < TYNAME_LEN - 1
        names[cur + j] = name[j]
        j = j + 1
    Wend
    names[cur + j] = 0

    TyAddVirt = cnt
    counts[typeIdx] = cnt + 1
    t->nVirts = vi + 1
End Function

' 名前から vtable スロットを探す。無ければ -1
Function TyFindVirt(t As *TypeTable, typeIdx As Long, name As *Byte) As Long
    Dim names As *Byte
    Dim firsts As *Long
    Dim counts As *Long
    Dim cur As Long
    Dim slot As Long
    Dim base As Long
    Dim cnt As Long

    TyFindVirt = -1
    If t = NULL Then Exit Function
    If typeIdx < 0 Or typeIdx >= t->nTypes Then Exit Function
    names = t->virtNames
    firsts = t->typeVirtFirst
    counts = t->typeVirtCount
    base = firsts[typeIdx]
    cnt = counts[typeIdx]
    If base < 0 Or cnt <= 0 Then Exit Function
    slot = 0
    While slot < cnt
        cur = (base + slot) * TYNAME_LEN
        If TyNameEq(VarPtr(names[cur]), name) <> 0 Then
            TyFindVirt = slot
            Exit Function
        End If
        slot = slot + 1
    Wend
End Function

' 親クラスの Virtual スロットを子へコピー（Inherits）
Function TyCopyVirts(t As *TypeTable, dstTi As Long, srcTi As Long) As Long
    Dim names As *Byte
    Dim firsts As *Long
    Dim counts As *Long
    Dim cur As Long
    Dim slot As Long
    Dim base As Long
    Dim cnt As Long
    Dim i As Long

    TyCopyVirts = 0
    If t = NULL Then Exit Function
    If dstTi < 0 Or dstTi >= t->nTypes Then Exit Function
    If srcTi < 0 Or srcTi >= t->nTypes Then Exit Function
    names = t->virtNames
    firsts = t->typeVirtFirst
    counts = t->typeVirtCount
    base = firsts[srcTi]
    cnt = counts[srcTi]
    If cnt <= 0 Or base < 0 Then
        TyCopyVirts = 1
        Exit Function
    End If
    i = 0
    While i < cnt
        cur = (base + i) * TYNAME_LEN
        slot = TyAddVirt(t, dstTi, VarPtr(names[cur]))
        If slot < 0 Then Exit Function
        i = i + 1
    Wend
    TyCopyVirts = 1
End Function