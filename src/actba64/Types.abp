' ===================================================
'  Types - user Type registry (Word/DWord packing)
' ===================================================

Const TYMAX_TYPES = 128
Const TYMAX_FIELDS = 512
Const TYNAME_LEN = 48

Type TypeTable
    nTypes As Long
    nFields As Long
    typeNames As *Byte
    typeSizes As *Long
    typeFirst As *Long
    fieldNames As *Byte
    fieldOffs As *Long
    fieldSizes As *Long
    fieldCounts As *Long
    fieldNext As *Long
End Type

Function TyNameEq(a As *Byte, b As *Byte) As Long
    Dim i As Long
    Dim ca As Long
    Dim cb As Long
    TyNameEq = 0
    i = 0
    Do
        ca = a[i]
        cb = b[i]
        If ca >= 65 And ca <= 90 Then ca = ca + 32
        If cb >= 65 And cb <= 90 Then cb = cb + 32
        If ca <> cb Then Exit Function
        If ca = 0 Then
            TyNameEq = 1
            Exit Function
        End If
        i = i + 1
    Loop
End Function

Sub TyFree(t As *TypeTable)
    If t = NULL Then Exit Sub
    If t.typeNames <> NULL Then free(t.typeNames)
    If t.typeSizes <> NULL Then free(t.typeSizes)
    If t.typeFirst <> NULL Then free(t.typeFirst)
    If t.fieldNames <> NULL Then free(t.fieldNames)
    If t.fieldOffs <> NULL Then free(t.fieldOffs)
    If t.fieldSizes <> NULL Then free(t.fieldSizes)
    If t.fieldCounts <> NULL Then free(t.fieldCounts)
    If t.fieldNext <> NULL Then free(t.fieldNext)
    free(t)
End Sub

Function TyCreate() As *TypeTable
    Dim t As *TypeTable
    TyCreate = NULL
    t = calloc(SizeOf(TypeTable))
    If t = NULL Then Exit Function
    t.typeNames = calloc(TYMAX_TYPES * TYNAME_LEN)
    t.typeSizes = calloc(SizeOf(Long) * TYMAX_TYPES)
    t.typeFirst = calloc(SizeOf(Long) * TYMAX_TYPES)
    t.fieldNames = calloc(TYMAX_FIELDS * TYNAME_LEN)
    t.fieldOffs = calloc(SizeOf(Long) * TYMAX_FIELDS)
    t.fieldSizes = calloc(SizeOf(Long) * TYMAX_FIELDS)
    t.fieldCounts = calloc(SizeOf(Long) * TYMAX_FIELDS)
    t.fieldNext = calloc(SizeOf(Long) * TYMAX_FIELDS)
    If t.typeNames = NULL Or t.typeSizes = NULL Or t.typeFirst = NULL Or t.fieldNames = NULL Or t.fieldOffs = NULL Or t.fieldSizes = NULL Or t.fieldCounts = NULL Or t.fieldNext = NULL Then
        TyFree(t)
        Exit Function
    End If
    t.nTypes = 0
    t.nFields = 0
    TyCreate = t
End Function

Function TyPrimSize(name As *Byte) As Long
    Dim k(15) As Byte
    TyPrimSize = 0
    lstrcpy(VarPtr(k), "byte")
    If TyNameEq(name, VarPtr(k)) <> 0 Then
        TyPrimSize = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "word")
    If TyNameEq(name, VarPtr(k)) <> 0 Then
        TyPrimSize = 2
        Exit Function
    End If
    lstrcpy(VarPtr(k), "dword")
    If TyNameEq(name, VarPtr(k)) <> 0 Then
        TyPrimSize = 4
        Exit Function
    End If
    lstrcpy(VarPtr(k), "long")
    If TyNameEq(name, VarPtr(k)) <> 0 Then
        TyPrimSize = 4
        Exit Function
    End If
    lstrcpy(VarPtr(k), "string")
    If TyNameEq(name, VarPtr(k)) <> 0 Then
        TyPrimSize = 8
        Exit Function
    End If
    lstrcpy(VarPtr(k), "handle")
    If TyNameEq(name, VarPtr(k)) <> 0 Then
        TyPrimSize = 8
        Exit Function
    End If
End Function

Function TyFind(t As *TypeTable, name As *Byte) As Long
    Dim i As Long
    Dim names As *Byte
    Dim off As Long
    TyFind = -1
    If t = NULL Then Exit Function
    names = t.typeNames
    i = 0
    While i < t.nTypes
        off = i * TYNAME_LEN
        If TyNameEq(VarPtr(names[off]), name) <> 0 Then
            TyFind = i
            Exit Function
        End If
        i = i + 1
    Wend
End Function

Function TySizeOfName(t As *TypeTable, name As *Byte) As Long
    Dim sz As Long
    Dim ti As Long
    Dim sizes As *Long
    TySizeOfName = 0
    sz = TyPrimSize(name)
    If sz > 0 Then
        TySizeOfName = sz
        Exit Function
    End If
    ti = TyFind(t, name)
    If ti < 0 Then Exit Function
    sizes = t.typeSizes
    TySizeOfName = sizes[ti]
End Function

Function TyAdd(t As *TypeTable, name As *Byte) As Long
    Dim i As Long
    Dim names As *Byte
    Dim firsts As *Long
    Dim sizes As *Long
    Dim j As Long
    Dim off As Long

    TyAdd = -1
    If t = NULL Then Exit Function
    i = TyFind(t, name)
    If i >= 0 Then
        TyAdd = i
        Exit Function
    End If
    If t.nTypes >= TYMAX_TYPES Then Exit Function
    i = t.nTypes
    names = t.typeNames
    firsts = t.typeFirst
    sizes = t.typeSizes
    off = i * TYNAME_LEN
    j = 0
    While name[j] <> 0 And j < TYNAME_LEN - 1
        names[off + j] = name[j]
        j = j + 1
    Wend
    names[off + j] = 0
    sizes[i] = 0
    firsts[i] = -1
    t.nTypes = i + 1
    TyAdd = i
End Function

Function TyAddField(t As *TypeTable, typeIdx As Long, name As *Byte, elemSize As Long, count As Long) As Long
    Dim fi As Long
    Dim names As *Byte
    Dim offs As *Long
    Dim sizes As *Long
    Dim counts As *Long
    Dim nexts As *Long
    Dim firsts As *Long
    Dim tsizes As *Long
    Dim j As Long
    Dim off As Long
    Dim align As Long
    Dim cur As Long
    Dim last As Long

    TyAddField = 0
    If t = NULL Then Exit Function
    If typeIdx < 0 Or typeIdx >= t.nTypes Then Exit Function
    If elemSize <= 0 Or count <= 0 Then Exit Function
    If t.nFields >= TYMAX_FIELDS Then Exit Function

    align = elemSize
    If align > 8 Then align = 8
    If align = 0 Then align = 1
    tsizes = t.typeSizes
    off = tsizes[typeIdx]
    cur = align - 1
    last = off And cur
    While last <> 0
        off = off + 1
        last = off And cur
    Wend

    fi = t.nFields
    names = t.fieldNames
    offs = t.fieldOffs
    sizes = t.fieldSizes
    counts = t.fieldCounts
    nexts = t.fieldNext
    firsts = t.typeFirst

    j = 0
    cur = fi * TYNAME_LEN
    While name[j] <> 0 And j < TYNAME_LEN - 1
        names[cur + j] = name[j]
        j = j + 1
    Wend
    names[cur + j] = 0
    offs[fi] = off
    sizes[fi] = elemSize
    counts[fi] = count
    nexts[fi] = -1

    If firsts[typeIdx] < 0 Then
        firsts[typeIdx] = fi
    Else
        last = firsts[typeIdx]
        While nexts[last] >= 0
            last = nexts[last]
        Wend
        nexts[last] = fi
    End If

    tsizes[typeIdx] = off + elemSize * count
    t.nFields = fi + 1
    TyAddField = 1
End Function

Function TyFindField(t As *TypeTable, typeIdx As Long, name As *Byte, ByRef outOff As Long, ByRef outSize As Long, ByRef outCount As Long) As Long
    Dim fi As Long
    Dim names As *Byte
    Dim offs As *Long
    Dim sizes As *Long
    Dim counts As *Long
    Dim nexts As *Long
    Dim firsts As *Long
    Dim cur As Long

    TyFindField = 0
    outOff = 0
    outSize = 0
    outCount = 0
    If t = NULL Then Exit Function
    If typeIdx < 0 Or typeIdx >= t.nTypes Then Exit Function
    names = t.fieldNames
    offs = t.fieldOffs
    sizes = t.fieldSizes
    counts = t.fieldCounts
    nexts = t.fieldNext
    firsts = t.typeFirst
    fi = firsts[typeIdx]
    While fi >= 0
        cur = fi * TYNAME_LEN
        If TyNameEq(VarPtr(names[cur]), name) <> 0 Then
            outOff = offs[fi]
            outSize = sizes[fi]
            outCount = counts[fi]
            TyFindField = 1
            Exit Function
        End If
        fi = nexts[fi]
    Wend
End Function
