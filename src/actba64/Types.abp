' ===================================================
'  Types - user Type registry (Word/DWord packing)
' ===================================================

Const TYNAME_LEN = 48
' Type メンバの *Byte / *Long（fieldTypeIdxs。UDT 型番号 >=0 と衝突させない）
Const FIELDTY_PTR_BYTE = -2
Const FIELDTY_PTR_LONG = -3

Type TypeTable
    nTypes As Long
    nFields As Long
    nVirts As Long
    typeCap As Long
    fieldCap As Long
    virtCap As Long
    typeNames As *Byte
    typeSizes As *Long
    typeFirst As *Long
    typeIsClass As *Long
    typeVirtFirst As *Long
    typeVirtCount As *Long
    typeExplicitAlign As *Long
    fieldNames As *Byte
    fieldOffs As *Long
    fieldSizes As *Long
    fieldCounts As *Long
    fieldNext As *Long
    fieldTypeIdxs As *Long
    virtNames As *Byte
    virtNext As *Long
End Type

Function TyNameEq(a As *Byte, b As *Byte) As Long
    TyNameEq = ByteNameEq(a, b)
End Function

Sub TyFree(t As *TypeTable)
    If t = NULL Then Exit Sub
    If t->typeNames <> NULL Then free(t->typeNames)
    If t->typeSizes <> NULL Then free(t->typeSizes)
    If t->typeFirst <> NULL Then free(t->typeFirst)
    If t->typeIsClass <> NULL Then free(t->typeIsClass)
    If t->typeVirtFirst <> NULL Then free(t->typeVirtFirst)
    If t->typeVirtCount <> NULL Then free(t->typeVirtCount)
    If t->typeExplicitAlign <> NULL Then free(t->typeExplicitAlign)
    If t->fieldNames <> NULL Then free(t->fieldNames)
    If t->fieldOffs <> NULL Then free(t->fieldOffs)
    If t->fieldSizes <> NULL Then free(t->fieldSizes)
    If t->fieldCounts <> NULL Then free(t->fieldCounts)
    If t->fieldNext <> NULL Then free(t->fieldNext)
    If t->fieldTypeIdxs <> NULL Then free(t->fieldTypeIdxs)
    If t->virtNames <> NULL Then free(t->virtNames)
    If t->virtNext <> NULL Then free(t->virtNext)
    free(t)
End Sub


Function TyEnsureTypeCap(t As *TypeTable) As Long
    Dim newCap As Long
    Dim p As *Byte
    Dim i As Long
    Dim oldCap As Long
    TyEnsureTypeCap = 0
    If t->nTypes < t->typeCap Then
        TyEnsureTypeCap = 1
        Exit Function
    End If
    oldCap = t->typeCap
    newCap = oldCap * 2
    If newCap <= oldCap Then Exit Function
    p = MemGrow(t->typeNames, BytesN(oldCap, TYNAME_LEN), BytesN(newCap, TYNAME_LEN))
    If p = NULL Then Exit Function
    t->typeNames = p
    p = MemGrow(t->typeSizes As BytePtr, BytesN(oldCap, SizeOf(Long)), BytesN(newCap, SizeOf(Long)))
    If p = NULL Then Exit Function
    t->typeSizes = p As *Long
    p = MemGrow(t->typeFirst As BytePtr, BytesN(oldCap, SizeOf(Long)), BytesN(newCap, SizeOf(Long)))
    If p = NULL Then Exit Function
    t->typeFirst = p As *Long
    p = MemGrow(t->typeIsClass As BytePtr, BytesN(oldCap, SizeOf(Long)), BytesN(newCap, SizeOf(Long)))
    If p = NULL Then Exit Function
    t->typeIsClass = p As *Long
    p = MemGrow(t->typeVirtFirst As BytePtr, BytesN(oldCap, SizeOf(Long)), BytesN(newCap, SizeOf(Long)))
    If p = NULL Then Exit Function
    t->typeVirtFirst = p As *Long
    p = MemGrow(t->typeVirtCount As BytePtr, BytesN(oldCap, SizeOf(Long)), BytesN(newCap, SizeOf(Long)))
    If p = NULL Then Exit Function
    t->typeVirtCount = p As *Long
    p = MemGrow(t->typeExplicitAlign As BytePtr, BytesN(oldCap, SizeOf(Long)), BytesN(newCap, SizeOf(Long)))
    If p = NULL Then Exit Function
    t->typeExplicitAlign = p As *Long
    i = oldCap
    While i < newCap
        t->typeVirtFirst[i] = -1
        t->typeVirtCount[i] = 0
        t->typeExplicitAlign[i] = 0
        i = i + 1
    Wend
    t->typeCap = newCap
    TyEnsureTypeCap = 1
End Function

Function TyEnsureFieldCap(t As *TypeTable) As Long
    Dim newCap As Long
    Dim p As *Byte
    Dim oldCap As Long
    TyEnsureFieldCap = 0
    If t->nFields < t->fieldCap Then
        TyEnsureFieldCap = 1
        Exit Function
    End If
    oldCap = t->fieldCap
    newCap = oldCap * 2
    If newCap <= oldCap Then Exit Function
    p = MemGrow(t->fieldNames, BytesN(oldCap, TYNAME_LEN), BytesN(newCap, TYNAME_LEN))
    If p = NULL Then Exit Function
    t->fieldNames = p
    p = MemGrow(t->fieldOffs As BytePtr, BytesN(oldCap, SizeOf(Long)), BytesN(newCap, SizeOf(Long)))
    If p = NULL Then Exit Function
    t->fieldOffs = p As *Long
    p = MemGrow(t->fieldSizes As BytePtr, BytesN(oldCap, SizeOf(Long)), BytesN(newCap, SizeOf(Long)))
    If p = NULL Then Exit Function
    t->fieldSizes = p As *Long
    p = MemGrow(t->fieldCounts As BytePtr, BytesN(oldCap, SizeOf(Long)), BytesN(newCap, SizeOf(Long)))
    If p = NULL Then Exit Function
    t->fieldCounts = p As *Long
    p = MemGrow(t->fieldNext As BytePtr, BytesN(oldCap, SizeOf(Long)), BytesN(newCap, SizeOf(Long)))
    If p = NULL Then Exit Function
    t->fieldNext = p As *Long
    p = MemGrow(t->fieldTypeIdxs As BytePtr, BytesN(oldCap, SizeOf(Long)), BytesN(newCap, SizeOf(Long)))
    If p = NULL Then Exit Function
    t->fieldTypeIdxs = p As *Long
    t->fieldCap = newCap
    TyEnsureFieldCap = 1
End Function

Function TyEnsureVirtCap(t As *TypeTable) As Long
    Dim newCap As Long
    Dim p As *Byte
    Dim oldCap As Long
    TyEnsureVirtCap = 0
    If t->nVirts < t->virtCap Then
        TyEnsureVirtCap = 1
        Exit Function
    End If
    oldCap = t->virtCap
    newCap = oldCap * 2
    If newCap <= oldCap Then Exit Function
    p = MemGrow(t->virtNames, BytesN(oldCap, TYNAME_LEN), BytesN(newCap, TYNAME_LEN))
    If p = NULL Then Exit Function
    t->virtNames = p
    p = MemGrow(t->virtNext As BytePtr, BytesN(oldCap, SizeOf(Long)), BytesN(newCap, SizeOf(Long)))
    If p = NULL Then Exit Function
    t->virtNext = p As *Long
    t->virtCap = newCap
    TyEnsureVirtCap = 1
End Function

Function TyCreate() As *TypeTable
    Dim t As *TypeTable
    Dim i As Long
    TyCreate = NULL
    t = calloc(SizeOf(TypeTable))
    If t = NULL Then Exit Function
    t->typeCap = DYN_INIT
    t->fieldCap = DYN_INIT
    t->virtCap = DYN_INIT
    t->typeNames = calloc(BytesN(t->typeCap, TYNAME_LEN))
    t->typeSizes = calloc(BytesN(t->typeCap, SizeOf(Long)))
    t->typeFirst = calloc(BytesN(t->typeCap, SizeOf(Long)))
    t->typeIsClass = calloc(BytesN(t->typeCap, SizeOf(Long)))
    t->typeVirtFirst = calloc(BytesN(t->typeCap, SizeOf(Long)))
    t->typeVirtCount = calloc(BytesN(t->typeCap, SizeOf(Long)))
    t->typeExplicitAlign = calloc(BytesN(t->typeCap, SizeOf(Long)))
    t->fieldNames = calloc(BytesN(t->fieldCap, TYNAME_LEN))
    t->fieldOffs = calloc(BytesN(t->fieldCap, SizeOf(Long)))
    t->fieldSizes = calloc(BytesN(t->fieldCap, SizeOf(Long)))
    t->fieldCounts = calloc(BytesN(t->fieldCap, SizeOf(Long)))
    t->fieldNext = calloc(BytesN(t->fieldCap, SizeOf(Long)))
    t->fieldTypeIdxs = calloc(BytesN(t->fieldCap, SizeOf(Long)))
    t->virtNames = calloc(BytesN(t->virtCap, TYNAME_LEN))
    t->virtNext = calloc(BytesN(t->virtCap, SizeOf(Long)))
    If t->typeNames = NULL Or t->typeSizes = NULL Or t->typeFirst = NULL Or t->typeIsClass = NULL Or t->typeVirtFirst = NULL Or t->typeVirtCount = NULL Or t->typeExplicitAlign = NULL Or t->fieldNames = NULL Or t->fieldOffs = NULL Or t->fieldSizes = NULL Or t->fieldCounts = NULL Or t->fieldNext = NULL Or t->fieldTypeIdxs = NULL Or t->virtNames = NULL Or t->virtNext = NULL Then
        TyFree(t)
        Exit Function
    End If
    t->nTypes = 0
    t->nFields = 0
    t->nVirts = 0
    i = 0
    While i < t->typeCap
        t->typeVirtFirst[i] = -1
        t->typeVirtCount[i] = 0
        i = i + 1
    Wend
    TyCreate = t
End Function

Function TyPrimSize(name As *Byte) As Long
    Dim k(15) As Byte
    TyPrimSize = 0
    lstrcpy(VarPtr(k), "byte")
    If ByteNameEqCI(name, VarPtr(k)) <> 0 Then
        TyPrimSize = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "word")
    If ByteNameEqCI(name, VarPtr(k)) <> 0 Then
        TyPrimSize = 2
        Exit Function
    End If
    lstrcpy(VarPtr(k), "dword")
    If ByteNameEqCI(name, VarPtr(k)) <> 0 Then
        TyPrimSize = 4
        Exit Function
    End If
    lstrcpy(VarPtr(k), "long")
    If ByteNameEqCI(name, VarPtr(k)) <> 0 Then
        TyPrimSize = 4
        Exit Function
    End If
    lstrcpy(VarPtr(k), "double")
    If ByteNameEqCI(name, VarPtr(k)) <> 0 Then
        TyPrimSize = 8
        Exit Function
    End If
    lstrcpy(VarPtr(k), "single")
    If ByteNameEqCI(name, VarPtr(k)) <> 0 Then
        TyPrimSize = 4
        Exit Function
    End If
    lstrcpy(VarPtr(k), "string")
    If ByteNameEqCI(name, VarPtr(k)) <> 0 Then
        TyPrimSize = TyPtrSize()
        Exit Function
    End If
    lstrcpy(VarPtr(k), "handle")
    If ByteNameEqCI(name, VarPtr(k)) <> 0 Then
        TyPrimSize = TyPtrSize()
        Exit Function
    End If
End Function

' Type メンバ `As *T` の要素サイズタグ（*Long/*DWord/*Integer は 4 バイト添字）
Function TyPtrFieldTag(name As *Byte) As Long
    Dim k(15) As Byte
    TyPtrFieldTag = FIELDTY_PTR_BYTE
    lstrcpy(VarPtr(k), "long")
    If ByteNameEqCI(name, VarPtr(k)) <> 0 Then
        TyPtrFieldTag = FIELDTY_PTR_LONG
        Exit Function
    End If
    lstrcpy(VarPtr(k), "dword")
    If ByteNameEqCI(name, VarPtr(k)) <> 0 Then
        TyPtrFieldTag = FIELDTY_PTR_LONG
        Exit Function
    End If
    lstrcpy(VarPtr(k), "integer")
    If ByteNameEqCI(name, VarPtr(k)) <> 0 Then
        TyPtrFieldTag = FIELDTY_PTR_LONG
        Exit Function
    End If
End Function
