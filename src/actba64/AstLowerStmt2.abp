' --- split from AstLowerStmt.abp (part 2) ---
Function LowStmtAssignIndexStore(ctx As *LowerCtx, leftIdx As Long, leftK As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim base As Long

    LowStmtAssignIndexStore = 0
    ast = ctx->ast
    nodes = ast->nodes
    If leftK = AST_CALL Then
        AstCopyStr(ast, leftIdx, VarPtr(name))
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
            LowStoreArrElem(ctx, vTy, 0)
        Else
            IrEmit(ctx->list, OP_STORE_BYTE_RAX_CL, 0, 0)
        End If
    Else
        base = nodes[leftIdx].left
        If nodes[base].kind = AST_MEMBER Then
            If LowStoreIndexMember(ctx, base) = 0 Then Exit Function
        Else
            AstCopyStr(ast, base, VarPtr(name))
            If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
                LowStoreArrElem(ctx, vTy, 1)
            Else
                IrEmit(ctx->list, OP_STORE_BYTE_RAX_CL, 0, 0)
            End If
        End If
    End If
    LowStmtAssignIndexStore = 1
End Function

Function LowStmtAssignIndex(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim leftK As Long
    Dim leftIdx As Long
    Dim base As Long

    LowStmtAssignIndex = 0
    ast = ctx->ast
    nodes = ast->nodes
    leftIdx = nodes[idx].left
    leftK = nodes[leftIdx].kind
    If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
    If leftK = AST_CALL Then
        AstCopyStr(ast, leftIdx, VarPtr(name))
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
            If vTy = TY_SINGLE_ARR Then
                LowEmitCvtToSingleIfNeeded(ctx, nodes[idx].right)
            ElseIf vTy = TY_DOUBLE_ARR Then
                LowEmitCvtToDoubleIfNeeded(ctx, nodes[idx].right)
            End If
        End If
    Else
        base = nodes[leftIdx].left
        If nodes[base].kind = AST_VAR Then
            AstCopyStr(ast, base, VarPtr(name))
            If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
                If vTy = TY_SINGLE_ARR Then
                    LowEmitCvtToSingleIfNeeded(ctx, nodes[idx].right)
                ElseIf vTy = TY_DOUBLE_ARR Then
                    LowEmitCvtToDoubleIfNeeded(ctx, nodes[idx].right)
                End If
            End If
        End If
    End If
    IrEmit(ctx->list, OP_PUSH_RAX, 0, 0)
    If LowAddr(ctx, nodes[idx].left) = 0 Then Exit Function
    IrEmit(ctx->list, OP_POP_RCX, 0, 0)
    If LowStmtAssignIndexStore(ctx, leftIdx, leftK) = 0 Then Exit Function
    LowStmtAssignIndex = 1
End Function

Function LowStmtAssignMember(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim leftIdx As Long
    Dim fsz As Long
    Dim base As Long

    LowStmtAssignMember = 0
    ast = ctx->ast
    nodes = ast->nodes
    leftIdx = nodes[idx].left
    If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
    IrEmit(ctx->list, OP_PUSH_RAX, 0, 0)
    If LowAddr(ctx, nodes[idx].left) = 0 Then Exit Function
    IrEmit(ctx->list, OP_POP_RCX, 0, 0)
    fsz = LowMemberFieldSize(ctx, leftIdx)
    If fsz <= 0 Then
        AstCopyStr(ast, leftIdx, VarPtr(name))
        base = nodes[leftIdx].left
        If nodes[base].kind = AST_VAR Then
            AstCopyStr(ast, base, VarPtr(name))
            If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
                fsz = LowTyNbytes(vTy)
            End If
        End If
    End If
    If fsz <= 0 Then
        AstCopyStr(ast, leftIdx, VarPtr(name))
        Print "error: bad member field '" + MakeStr(VarPtr(name)) + "'"
        ctx->err = 1
        Exit Function
    End If
    LowStoreSized(ctx->list, fsz)
    LowStmtAssignMember = 1
End Function

Function LowStmtAssignVar(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte

    LowStmtAssignVar = 0
    ast = ctx->ast
    nodes = ast->nodes
    If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
    AstCopyStr(ast, nodes[idx].left, VarPtr(name))
    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
        LowerDiagError(ctx, idx, "assign to undefined '" + MakeStr(VarPtr(name)) + "'")
        Exit Function
    End If
    LowStrictCheckAssign(ctx, idx, vTy, vTypeIdx, nodes[idx].right)
    If vTy = TY_SINGLE Then
        LowEmitCvtToSingleIfNeeded(ctx, nodes[idx].right)
    ElseIf vTy = TY_DOUBLE Then
        LowEmitCvtToDoubleIfNeeded(ctx, nodes[idx].right)
    Else
        LowEmitCvtToLongIfNeeded(ctx, nodes[idx].right, vTy)
    End If
    If vByRef <> 0 Then
        IrEmit(ctx->list, OP_PUSH_RAX, 0, 0)
        LowEmitLoadOff(ctx->list, vOff, vGlob)
        IrEmit(ctx->list, OP_POP_RCX, 0, 0)
        IrEmit(ctx->list, OP_STORE_PTR, 0, 0)
    ElseIf vTy = TY_STRING Then
        LowEmitStoreString(ctx, vOff, vGlob)
    Else
        LowEmitStoreOff(ctx->list, vOff, vGlob)
    End If
    LowStmtAssignVar = 1
End Function

Function LowStmtAssign(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim leftK As Long
    Dim leftIdx As Long

    LowStmtAssign = 0
    ast = ctx->ast
    nodes = ast->nodes
    leftIdx = nodes[idx].left
    leftK = nodes[leftIdx].kind
    If leftK = AST_INDEX Or leftK = AST_CALL Then
        LowStmtAssign = LowStmtAssignIndex(ctx, idx)
    ElseIf leftK = AST_MEMBER Then
        LowStmtAssign = LowStmtAssignMember(ctx, idx)
    ElseIf leftK = AST_VAR Then
        LowStmtAssign = LowStmtAssignVar(ctx, idx)
    Else
        ctx->err = 1
    End If
End Function


' AST_ARG チェーン n 番目の実引数式（無ければ -1）
Function LowArgExpr(ctx As *LowerCtx, idx As Long, n As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim argn As Long
    Dim i As Long

    LowArgExpr = -1
    ast = ctx->ast
    nodes = ast->nodes
    argn = nodes[idx].left
    i = 0
    While argn >= 0 And i < n
        argn = nodes[argn].nxt
        i = i + 1
    Wend
    If argn < 0 Then Exit Function
    LowArgExpr = nodes[argn].left
End Function

' lpNewItem（第5引数）を rsp+32 へ
Function LowEmitInsMenuItem(ctx As *LowerCtx, idx As Long, nArgs As Long) As Long
    Dim list As *IrList

    LowEmitInsMenuItem = 0
    list = ctx->list
    If nArgs >= 4 Then
        If LowExpr(ctx, LowArgExpr(ctx, idx, 3)) = 0 Then Exit Function
    Else
        IrEmit(list, OP_XOR_EAX, 0, 0)
    End If
    IrEmit(list, OP_STORE_RSP_RAX, 32, 0)
    LowEmitInsMenuItem = 1
End Function

' uIDNewItem を r9、flags を r8 へ
Function LowEmitInsMenuFlags(ctx As *LowerCtx, idx As Long, nArgs As Long) As Long
    Dim list As *IrList
    Dim labSub As Long
    Dim labDone As Long

    LowEmitInsMenuFlags = 0
    list = ctx->list
    If nArgs >= 6 Then
        ' hSubMenu <> 0 なら uIDNewItem = hSubMenu かつ MF_POPUP
        labSub = LowNewLab(ctx)
        labDone = LowNewLab(ctx)
        If LowExpr(ctx, LowArgExpr(ctx, idx, 5)) = 0 Then Exit Function
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        IrEmit(list, OP_TEST_RAX, 0, 0)
        IrEmit(list, OP_JNZ, labSub, 0)
        IrEmit(list, OP_POP_RAX, 0, 0)
        If LowExpr(ctx, LowArgExpr(ctx, idx, 4)) = 0 Then Exit Function
        IrEmit(list, OP_MOV_R9_RAX, 0, 0)
        If LowExpr(ctx, LowArgExpr(ctx, idx, 2)) = 0 Then Exit Function
        IrEmit(list, OP_MOV_R8_RAX, 0, 0)
        IrEmit(list, OP_JMP, labDone, 0)
        IrEmit(list, OP_LABEL, labSub, 0)
        IrEmit(list, OP_POP_RAX, 0, 0)
        IrEmit(list, OP_MOV_R9_RAX, 0, 0)
        If LowExpr(ctx, LowArgExpr(ctx, idx, 2)) = 0 Then Exit Function
        IrEmit(list, OP_MOV_ECX, LOW_MF_POPUP, 0)
        IrEmit(list, OP_OR_EAX_ECX, 0, 0)
        IrEmit(list, OP_MOV_R8_RAX, 0, 0)
        IrEmit(list, OP_LABEL, labDone, 0)
    Else
        If nArgs >= 5 Then
            If LowExpr(ctx, LowArgExpr(ctx, idx, 4)) = 0 Then Exit Function
        Else
            IrEmit(list, OP_XOR_EAX, 0, 0)
        End If
        IrEmit(list, OP_MOV_R9_RAX, 0, 0)
        If LowExpr(ctx, LowArgExpr(ctx, idx, 2)) = 0 Then Exit Function
        If nArgs = 3 Then
            IrEmit(list, OP_MOV_ECX, LOW_MF_SEPARATOR, 0)
            IrEmit(list, OP_OR_EAX_ECX, 0, 0)
        End If
        IrEmit(list, OP_MOV_R8_RAX, 0, 0)
    End If
    LowEmitInsMenuFlags = 1
End Function

Function LowStmtInsMenu(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim list As *IrList
    Dim nArgs As Long
    Dim stk As Long
    Dim sApi(31) As Byte

    LowStmtInsMenu = 0
    list = ctx->list
    ' InsertMenuA(hMenu, pos, flags, uIDNewItem, lpNewItem)
    nArgs = LowCountCallArgs(ctx, idx, 0)
    If nArgs < 0 Then
        ctx->err = 1
        Exit Function
    End If
    If nArgs < 3 Then
        ctx->err = 1
        Exit Function
    End If
    stk = 48
    IrEmit(list, OP_SUB_RSP, stk, 0)
    If LowEmitInsMenuItem(ctx, idx, nArgs) = 0 Then Exit Function
    If LowEmitInsMenuFlags(ctx, idx, nArgs) = 0 Then Exit Function
    If LowExpr(ctx, LowArgExpr(ctx, idx, 1)) = 0 Then Exit Function
    IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
    If LowExpr(ctx, LowArgExpr(ctx, idx, 0)) = 0 Then Exit Function
    IrEmit(list, OP_MOV_RCX_RAX, 0, 0)
    lstrcpy(VarPtr(sApi), "InsertMenuA")
    IrEmitStr(list, OP_CALL_API, IR_DLL_USER32, VarPtr(sApi))
    LowEmitCallFinish(list, stk)
    LowStmtInsMenu = 1
End Function

' Print 対象が単純変数のときその宣言型、それ以外／文字列式なら -1
Function LowPrintVarTy(ctx As *LowerCtx, exprIdx As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte

    LowPrintVarTy = -1
    ast = ctx->ast
    nodes = ast->nodes
    If LowIsStringExpr(ctx, exprIdx) <> 0 Then Exit Function
    If nodes[exprIdx].kind <> AST_VAR Then Exit Function
    AstCopyStr(ast, exprIdx, VarPtr(name))
    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then Exit Function
    LowPrintVarTy = vTy
End Function

' Print 対象を rax の文字列ポインタへ
Function LowEmitPrintValue(ctx As *LowerCtx, exprIdx As Long, vTy As Long) As Long
    Dim name(63) As Byte
    Dim lab As Long
    Dim labStr As Long
    Dim exprTy As Long

    LowEmitPrintValue = 0
    exprTy = LowExprType(ctx, exprIdx)
    If vTy = TY_BYTE_ARR Then
        If LowExprArg(ctx, exprIdx) = 0 Then Exit Function
    ElseIf vTy = TY_PTR_BYTE Then
        If LowExpr(ctx, exprIdx) = 0 Then Exit Function
    ElseIf LowIsStringExpr(ctx, exprIdx) = 0 And exprTy = TY_DOUBLE And TyIs32() = 0 Then
        lstrcpy(VarPtr(name), "StrD$")
        lab = LowFindFunc(ctx, VarPtr(name))
        If lab < 0 Then
            Print "error: missing 'StrD$' (Include\default\DoubleStr.abp)"
            ctx->err = 1
            Exit Function
        End If
        If LowExpr(ctx, exprIdx) = 0 Then Exit Function
        LowEmitCall1Rax(ctx->list, 0, 0, VarPtr(name), lab)
    ElseIf LowIsStringExpr(ctx, exprIdx) = 0 Then
        labStr = LowEnsureRtStr(ctx)
        If LowExpr(ctx, exprIdx) = 0 Then Exit Function
        LowEmitCall1Rax(ctx->list, 0, 0, VarPtr(name), labStr)
    Else
        If LowExpr(ctx, exprIdx) = 0 Then Exit Function
    End If
    LowEmitPrintValue = 1
End Function

' rax の文字列を出力（N88 モードは N88_Print へ）
Function LowEmitPrintCall(ctx As *LowerCtx, stay As Long) As Long
    Dim name(63) As Byte
    Dim lab As Long

    LowEmitPrintCall = 0
    If PpIsN88Basic() <> 0 Then
        lstrcpy(VarPtr(name), "N88_Print")
        If stay <> 0 Then
            lstrcpy(VarPtr(name), "N88_PrintStay")
        End If
        lab = LowFindFunc(ctx, VarPtr(name))
        If lab < 0 Then
            Print "error: missing '" + MakeStr(VarPtr(name)) + "'"
            ctx->err = 1
            Exit Function
        End If
        IrEmit(ctx->list, OP_SUB_RSP, LowCallStk(1), 0)
        IrEmit(ctx->list, OP_STORE_RSP_RAX, 0, 0)
        LowEmitLoadRegArgs(ctx->list, 1)
        IrEmit(ctx->list, OP_CALL_LAB, lab, 0)
        LowEmitCallFinish(ctx->list, LowCallStk(1))
    Else
        lab = LowEnsureRtPrint(ctx)
        LowEmitCall1Rax(ctx->list, 0, 0, VarPtr(name), lab)
    End If
    LowEmitPrintCall = 1
End Function
