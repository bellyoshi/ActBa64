' ParserN88Circle - CIRCLE

Function ParseN88CircleCenter(p As *Parser, ByRef e1 As Long, ByRef e2 As Long, ByRef flags As Long) As Long
    Dim kStep(7) As Byte

    ParseN88CircleCenter = 0
    lstrcpy(VarPtr(kStep), "step")
    If ParseIdentIs(p, VarPtr(kStep)) <> 0 Then
        p->pos = p->pos + 1
        flags = flags Or 8
        If ParseN88XyPair(p, e1, e2) = 0 Then Exit Function
    ElseIf ParseTokKind(p) = TK_LPAREN Then
        If ParseN88XyPair(p, e1, e2) = 0 Then Exit Function
    Else
        flags = flags Or 16
        e1 = ParseMakeNum(p->ast, 0)
        e2 = ParseMakeNum(p->ast, 0)
        If e1 < 0 Or e2 < 0 Then Exit Function
    End If
    ParseN88CircleCenter = 1
End Function

Function ParseN88CircleF(p As *Parser, ByRef flags As Long, ByRef circCol2 As Long) As Long
    Dim kF(3) As Byte

    ParseN88CircleF = 0
    lstrcpy(VarPtr(kF), "f")
    p->pos = p->pos + 1
    flags = flags Or 1
    If ParseTokKind(p) = TK_COMMA Then
        p->pos = p->pos + 1
        If ParseTokKind(p) = TK_STRING Then
            p->pos = p->pos + 1
        ElseIf ParseTokKind(p) = TK_COMMA Or ParseIdentIs(p, VarPtr(kF)) <> 0 Then
        ElseIf ParseTokKind(p) = TK_NUMBER Or ParseTokKind(p) = TK_MINUS Or ParseTokKind(p) = TK_LPAREN Or ParseTokKind(p) = TK_IDENT Then
            circCol2 = ParseExpr(p)
            If circCol2 < 0 Then Exit Function
        End If
    End If
    ParseN88CircleF = 1
End Function

Function ParseN88CircleAngSlot(p As *Parser, ByRef slot As Long, ByRef flags As Long, ByRef startD As Double, ByRef hasStart As Long, ByRef endD As Double, ByRef hasEnd As Long, ByRef aspectD As Double) As Long
    Dim mv As Double
    Dim neg As Long
    Dim r As Long
    Dim one As Double

    ParseN88CircleAngSlot = 0
    one = 1
    If slot = 1 Then
        r = ParseN88Double(p, mv, neg)
        If r <= 0 Then
            p->err = 1
            Exit Function
        End If
        startD = mv
        hasStart = 1
        If neg <> 0 Then flags = flags Or 2
        slot = 2
    ElseIf slot = 2 Then
        r = ParseN88Double(p, mv, neg)
        If r <= 0 Then
            p->err = 1
            Exit Function
        End If
        endD = mv
        hasEnd = 1
        If neg <> 0 Then flags = flags Or 4
        slot = 3
    ElseIf slot = 3 Then
        r = ParseN88Double(p, mv, neg)
        If r <= 0 Then
            p->err = 1
            Exit Function
        End If
        aspectD = mv
        If aspectD <= 0 Then aspectD = one
        slot = 4
    Else
        p->err = 1
        Exit Function
    End If
    ParseN88CircleAngSlot = 1
End Function

Function ParseN88CircleOpts(p As *Parser, ByRef flags As Long, ByRef circCol As Long, ByRef circCol2 As Long, ByRef startD As Double, ByRef endD As Double, ByRef aspectD As Double) As Long
    Dim kF(3) As Byte
    Dim slot As Long
    Dim hasStart As Long
    Dim hasEnd As Long

    ParseN88CircleOpts = 0
    lstrcpy(VarPtr(kF), "f")
    slot = 0
    hasStart = 0
    hasEnd = 0
    Do
        If ParseTokKind(p) <> TK_COMMA Then Exit Do
        p->pos = p->pos + 1
        If ParseIdentIs(p, VarPtr(kF)) <> 0 Then
            If ParseN88CircleF(p, flags, circCol2) = 0 Then Exit Function
            Exit Do
        End If
        If ParseTokKind(p) = TK_COMMA Then
            slot = slot + 1
        ElseIf slot = 0 Then
            If ParseTokKind(p) = TK_NUMBER Or ParseTokKind(p) = TK_MINUS Or ParseTokKind(p) = TK_LPAREN Or ParseTokKind(p) = TK_IDENT Then
                circCol = ParseExpr(p)
                If circCol < 0 Then Exit Function
                slot = 1
            Else
                slot = slot + 1
                Exit Do
            End If
        ElseIf ParseTokKind(p) = TK_NUMBER Or ParseTokKind(p) = TK_FLOAT Or ParseTokKind(p) = TK_MINUS Then
            If ParseN88CircleAngSlot(p, slot, flags, startD, hasStart, endD, hasEnd, aspectD) = 0 Then Exit Function
        Else
            slot = slot + 1
            Exit Do
        End If
    Loop
    If hasStart = 0 And hasEnd = 0 Then
        startD = 0
        endD = 0
    ElseIf hasStart <> 0 And hasEnd = 0 Then
        ' ≈ 2π（ホストに MathPi は無いので整数から）
        endD = 6283185
        endD = endD / 1000000
    ElseIf hasStart = 0 And hasEnd <> 0 Then
        startD = 0
    End If
    ParseN88CircleOpts = 1
End Function

Function ParseN88CircleExprs(ast As *Ast, circCol As Long, circCol2 As Long, startD As Double, endD As Double, aspectD As Double, ByRef e4 As Long, ByRef e5 As Long, ByRef e6 As Long, ByRef e7 As Long, ByRef e8 As Long) As Long
    ParseN88CircleExprs = 0
    If circCol < 0 Then
        e4 = ParseMakeNum(ast, 7)
    Else
        e4 = circCol
    End If
    If e4 < 0 Then Exit Function
    If circCol2 < 0 Then
        e8 = e4
    Else
        e8 = circCol2
    End If
    e5 = ParseMakeF64FromDouble(ast, startD)
    e6 = ParseMakeF64FromDouble(ast, endD)
    e7 = ParseMakeF64FromDouble(ast, aspectD)
    If e5 < 0 Or e6 < 0 Or e7 < 0 Then Exit Function
    ParseN88CircleExprs = 1
End Function

Function ParseN88CircleLink(ast As *Ast, e1 As Long, e2 As Long, e3 As Long, e4 As Long, e5 As Long, e6 As Long, e7 As Long, e8 As Long, flags As Long) As Long
    Dim nodes As *AstNode
    Dim nCall As Long
    Dim name(7) As Byte
    Dim arg0 As Long
    Dim nPrev As Long
    Dim nArgs As Long
    Dim eFlags As Long

    ParseN88CircleLink = -1
    arg0 = -1
    nPrev = -1
    nArgs = 0
    If ParseLinkArg(ast, arg0, nPrev, nArgs, e1) = 0 Then Exit Function
    If ParseLinkArg(ast, arg0, nPrev, nArgs, e2) = 0 Then Exit Function
    If ParseLinkArg(ast, arg0, nPrev, nArgs, e3) = 0 Then Exit Function
    If ParseLinkArg(ast, arg0, nPrev, nArgs, e4) = 0 Then Exit Function
    If ParseLinkArg(ast, arg0, nPrev, nArgs, e5) = 0 Then Exit Function
    If ParseLinkArg(ast, arg0, nPrev, nArgs, e6) = 0 Then Exit Function
    If ParseLinkArg(ast, arg0, nPrev, nArgs, e7) = 0 Then Exit Function
    eFlags = ParseMakeNum(ast, flags)
    If eFlags < 0 Then Exit Function
    If ParseLinkArg(ast, arg0, nPrev, nArgs, eFlags) = 0 Then Exit Function
    If ParseLinkArg(ast, arg0, nPrev, nArgs, e8) = 0 Then Exit Function
    lstrcpy(VarPtr(name), "Circle")
    nCall = AstAddNode(ast, AST_CALL)
    If nCall < 0 Then Exit Function
    AstSetStr(ast, nCall, VarPtr(name))
    nodes = ast->nodes
    nodes[nCall].left = arg0
    nodes[nCall].right = -1
    nodes[nCall].num = nArgs
    ParseN88CircleLink = nCall
End Function

' CIRCLE [[(x,y)]|[STEP(x,y)]] ,r [,color][,start][,end][,aspect][,F[,color2]]
' → Circle(cx,cy,r,color,start,end,aspect,flags,fillColor)  角度・aspect は Double
Function ParseN88CircleStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim e1 As Long
    Dim e2 As Long
    Dim e3 As Long
    Dim e4 As Long
    Dim e5 As Long
    Dim e6 As Long
    Dim e7 As Long
    Dim e8 As Long
    Dim flags As Long
    Dim circCol As Long
    Dim startD As Double
    Dim endD As Double
    Dim aspectD As Double
    Dim circCol2 As Long

    ParseN88CircleStmt = -1
    p->pos = p->pos + 1
    flags = 0
    e1 = -1
    e2 = -1
    circCol = -1
    startD = 0
    endD = 0
    aspectD = 0
    aspectD = aspectD + 1
    circCol2 = -1
    If ParseN88CircleCenter(p, e1, e2, flags) = 0 Then Exit Function
    If ParseExpect(p, TK_COMMA) = 0 Then Exit Function
    e3 = ParseExpr(p)
    If e3 < 0 Then Exit Function
    If ParseN88CircleOpts(p, flags, circCol, circCol2, startD, endD, aspectD) = 0 Then Exit Function
    ast = p->ast
    If ParseN88CircleExprs(ast, circCol, circCol2, startD, endD, aspectD, e4, e5, e6, e7, e8) = 0 Then Exit Function
    ParseN88CircleStmt = ParseN88CircleLink(ast, e1, e2, e3, e4, e5, e6, e7, e8, flags)
End Function

Function ParseN88CircleOrAssign(p As *Parser) As Long
    Dim save As Long
    Dim ok As Long
    Dim kStep(7) As Byte

    ParseN88CircleOrAssign = -1
    save = p->pos
    ok = 0
    p->pos = p->pos + 1
    lstrcpy(VarPtr(kStep), "step")
    If ParseIdentIs(p, VarPtr(kStep)) <> 0 Then
        ok = 1
    ElseIf ParseTokKind(p) = TK_COMMA Then
        ok = 1
    ElseIf ParseTokKind(p) = TK_LPAREN Then
        p->pos = p->pos + 1
        If ParseExpr(p) >= 0 Then
            If ParseTokKind(p) = TK_COMMA Then
                p->pos = p->pos + 1
                If ParseExpr(p) >= 0 Then
                    If ParseTokKind(p) = TK_RPAREN Then
                        p->pos = p->pos + 1
                        If ParseTokKind(p) = TK_COMMA Then
                            ok = 1
                        End If
                    End If
                End If
            End If
        End If
    End If
    p->pos = save
    p->err = 0
    If ok <> 0 Then
        ParseN88CircleOrAssign = ParseN88CircleStmt(p)
    Else
        ParseN88CircleOrAssign = ParseAssignStmt(p)
    End If
End Function
