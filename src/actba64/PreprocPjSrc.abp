' PreprocPjSrc - プロジェクトのソース結合

' 戻り値 true : 成り立つ  false : 成り立たない
Function PpPathEndsWithPj(path As *Byte) As boolean
    Dim n As Long
    Dim c0 As Long
    Dim c1 As Long
    Dim c2 As Long
    PpPathEndsWithPj = false
    n = lstrlen(path)
    If n < PP_EXT_PJ_LEN Then Exit Function
    c0 = path[n - PP_EXT_PJ_LEN]
    c1 = ToLowerChar(path[n - 2])
    c2 = ToLowerChar(path[n - 1])
    If c0 = CH_DOT And c1 = CH_Lp And c2 = CH_Lj Then
        PpPathEndsWithPj = true
    End If
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function PpLineIsSourceHeader(line As *Byte, n As Long) As boolean
    Dim i As Long
    Dim word(KW_LEN - 1) As Byte
    Dim k As Long
    Dim c As Long
    PpLineIsSourceHeader = false
    i = 0
    While i < n
        c = line[i]
        If Not IsHSpace(c) Then Exit While
        i = i + 1
    Wend
    If i >= n Then Exit Function
    If line[i] <> CH_HASH Then Exit Function
    i = i + 1
    lstrcpy(VarPtr(word), "source")
    k = 0
    While word[k] <> CH_NUL
        If i + k >= n Then Exit Function
        If ToLowerChar(line[i + k]) <> word[k] Then Exit Function
        k = k + 1
    Wend
    If i + k < n Then
        c = line[i + k]
        If Not IsHSpace(c) And c <> CH_NUL Then Exit Function
    End If
    PpLineIsSourceHeader = true
End Function

Function PpSkipWsAt(line As *Byte, n As Long, from As Long) As Long
    Dim i As Long
    Dim c As Long
    i = from
    While i < n
        c = line[i]
        If Not IsHSpace(c) Then Exit While
        i = i + 1
    Wend
    PpSkipWsAt = i
End Function

Function PpParseEqNumber(line As *Byte, n As Long, from As Long, ByRef valOut As Long) As Long
    Dim i As Long
    Dim c As Long
    Dim v As Long
    Dim got As Long
    PpParseEqNumber = 0
    i = from
    v = 0
    got = 0
    While i < n
        c = line[i]
        If IsDigit(c) Then
            v = v * 10 + DigitValue(c)
            got = 1
        ElseIf IsHSpace(c) Then
            If got <> 0 Then Exit While
        Else
            Exit While
        End If
        i = i + 1
    Wend
    If got = 0 Then Exit Function
    valOut = v
    PpParseEqNumber = 1
End Function

' #USEWINDOW=1 / #usewindow=0 （#SOURCE 節の外も含め全行を対象）
' 戻り値 true : 正常終了  false : エラーあり
Function PpLineUseWindow(line As *Byte, n As Long, ByRef valOut As Long) As boolean
    Dim i As Long
    Dim k As Long
    Dim word(KW_LEN - 1) As Byte

    PpLineUseWindow = false
    i = PpSkipWsAt(line, n, 0)
    If i >= n Then Exit Function
    If line[i] <> CH_HASH Then Exit Function
    i = i + 1
    lstrcpy(VarPtr(word), "usewindow")
    k = 0
    While word[k] <> CH_NUL
        If i + k >= n Then Exit Function
        If ToLowerChar(line[i + k]) <> word[k] Then Exit Function
        k = k + 1
    Wend
    i = PpSkipWsAt(line, n, i + k)
    If i >= n Then Exit Function
    If line[i] <> CH_EQ Then Exit Function
    If PpParseEqNumber(line, n, i + 1, valOut) = 0 Then Exit Function
    PpLineUseWindow = true
End Function

Function PpTrimCopy(line As *Byte, n As Long, dst As *Byte, dstMax As Long) As Long
    Dim i As Long
    Dim j As Long
    Dim c As Long
    PpTrimCopy = 0
    dst[0] = CH_NUL
    i = 0
    While i < n
        c = line[i]
        If Not IsHSpace(c) Then Exit While
        i = i + 1
    Wend
    If i < n And line[i] = CH_SQUOTE Then Exit Function
    j = 0
    While i < n And j < dstMax - 1
        c = line[i]
        If c = CH_SQUOTE Then Exit While
        dst[j] = c As Byte
        j = j + 1
        i = i + 1
    Wend
    While j > 0
        c = dst[j - 1]
        If Not IsHSpace(c) Then Exit While
        j = j - 1
    Wend
    dst[j] = CH_NUL
    PpTrimCopy = j
End Function

Sub PpJoinSrcPath(dir As *Byte, name As *Byte, full As *Byte)
    full[0] = CH_NUL
    If (name[1] = CH_COLON) Or (name[0] = CH_BSLASH) Or (name[0] = CH_SLASH) Then
        lstrcpy(full, name)
    Else
        lstrcpy(full, dir)
        lstrcat(full, name)
    End If
End Sub

' 戻り値 true : 正常終了  false : エラーあり
Function PpEmitSrcHeader(dst As *Byte, ByRef dstLen As Long, dstCap As Long, name As *Byte) As boolean
    Dim hdr(SYM_NAME_LEN - 1) As Byte
    PpEmitSrcHeader = false
    lstrcpy(VarPtr(hdr), "' ---- ")
    If Not PpAppend(dst, dstLen, dstCap, VarPtr(hdr), lstrlen(VarPtr(hdr))) Then Exit Function
    If Not PpAppend(dst, dstLen, dstCap, name, lstrlen(name)) Then Exit Function
    lstrcpy(VarPtr(hdr), " ----")
    hdr[5] = CH_CR
    hdr[6] = CH_NL
    hdr[7] = CH_NUL
    If Not PpAppend(dst, dstLen, dstCap, VarPtr(hdr), PP_FILE_MARK_TAIL) Then Exit Function
    PpEmitSrcHeader = true
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function PpAppendOneSource(dst As *Byte, ByRef dstLen As Long, dstCap As Long, dir As *Byte, name As *Byte) As boolean
    Dim full(PP_ONCE_PATH - 1) As Byte
    Dim src As *Byte
    Dim srcSize As Long
    Dim expanded As *Byte
    Dim expLen As Long
    Dim crlf(1) As Byte
    PpAppendOneSource = false
    PpJoinSrcPath(dir, name, VarPtr(full))
    If PpOnceHas(VarPtr(full)) Then
        PpAppendOneSource = true
        Exit Function
    End If
    src = LoadFile(VarPtr(full), srcSize)
    If src = NULL Then Exit Function
    PpOnceAdd(VarPtr(full))
    expanded = ExpandIncludes(src, srcSize, VarPtr(full))
    free(src)
    If expanded = NULL Then Exit Function
    If Not PpEmitSrcHeader(dst, dstLen, dstCap, name) Then
        free(expanded)
        Exit Function
    End If
    expLen = lstrlen(expanded)
    If Not PpAppend(dst, dstLen, dstCap, expanded, expLen) Then
        free(expanded)
        Exit Function
    End If
    crlf[0] = CH_CR
    crlf[1] = CH_NL
    If Not PpAppend(dst, dstLen, dstCap, VarPtr(crlf), 2) Then
        free(expanded)
        Exit Function
    End If
    free(expanded)
    PpAppendOneSource = true
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function PpHandleSourceLoop(line As *Byte, n As Long, ByRef inSource As Long, dst As *Byte, ByRef dstLen As Long, dstCap As Long, dir As *Byte, ByRef nSrc As Long) As boolean
    Dim j As Long
    Dim c As Long
    Dim name(PJ_PATH_LEN - 1) As Byte
    PpHandleSourceLoop = true
    If PpLineIsSourceHeader(line, n) Then
        inSource = 1
        Exit Function
    End If
    If inSource = 0 Then Exit Function
    j = 0
    While j < n
        c = line[j]
        If Not IsHSpace(c) Then Exit While
        j = j + 1
    Wend
    If j < n And line[j] = CH_HASH Then
        inSource = 0
        Exit Function
    End If
    If PpTrimCopy(line, n, VarPtr(name), PJ_PATH_LEN) > 0 Then
        If Not PpAppendOneSource(dst, dstLen, dstCap, dir, VarPtr(name)) Then
            PpHandleSourceLoop = false
            Exit Function
        End If
        nSrc = nSrc + 1
    End If
End Function

Function PpNextPjLine(pj As *Byte, pjSize As Long, ByRef i As Long, line As *Byte) As Long
    Dim start As Long
    Dim n As Long
    Dim c As Long
    Dim j As Long
    start = i
    While i < pjSize
        c = pj[i]
        If c = CH_NL Or c = CH_CR Then Exit While
        i = i + 1
    Wend
    n = i - start
    g_ppLastRawLen = n
    If n >= PP_LINE_MAX Then
        PpNextPjLine = -1
        Exit Function
    End If
    j = 0
    While j < n
        line[j] = pj[start + j]
        j = j + 1
    Wend
    line[n] = CH_NUL
    If i < pjSize And pj[i] = CH_CR Then i = i + 1
    If i < pjSize And pj[i] = CH_NL Then i = i + 1
    PpNextPjLine = n
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function PpPjProcessLine(line As *Byte, n As Long, ByRef inSource As Long, dst As *Byte, ByRef dstLen As Long, dstCap As Long, dir As *Byte, ByRef nSrc As Long) As boolean
    Dim uwVal As Long
    PpPjProcessLine = false
    PpApplyPjOpt(line, n)
    If PpLineUseWindow(line, n, uwVal) Then
        g_ppUseWindow = uwVal
    End If
    If Not PpHandleSourceLoop(line, n, inSource, dst, dstLen, dstCap, dir, nSrc) Then Exit Function
    PpPjProcessLine = true
End Function

Function CombinePjSources(pjPath As *Byte) As *Byte
    Dim pj As *Byte
    Dim pjSize As Long
    Dim i As Long
    Dim n As Long
    Dim line(PP_LINE_MAX - 1) As Byte
    Dim dir(PP_ONCE_PATH - 1) As Byte
    Dim inSource As Long
    Dim dst As *Byte
    Dim dstLen As Long
    Dim dstCap As Long
    Dim nSrc As Long
    Dim lineNo As Long

    CombinePjSources = NULL
    PpOnceReset()
    g_ppUseWindow = 0
    g_ppModuleDll = 0
    pj = LoadFile(pjPath, pjSize)
    If pj = NULL Then Exit Function
    PpDirOf(pjPath, VarPtr(dir))

    ' Full actba64.pj sources exceed 256KiB once headers are included.
    dstCap = PP_EXPAND_MIN
    dst = calloc(dstCap)
    If dst = NULL Then
        free(pj)
        Exit Function
    End If
    dstLen = 0
    dst[0] = CH_NUL
    inSource = 0
    nSrc = 0
    i = 0
    lineNo = 1
    While i < pjSize
        n = PpNextPjLine(pj, pjSize, i, VarPtr(line))
        If n < 0 Then
            PpErrorTooLongLine(pjPath, lineNo, g_ppLastRawLen)
            free(pj)
            free(dst)
            Exit Function
        End If
        If Not PpPjProcessLine(VarPtr(line), n, inSource, dst, dstLen, dstCap, VarPtr(dir), nSrc) Then
            free(pj)
            free(dst)
            Exit Function
        End If
        lineNo = lineNo + 1
    Wend
    free(pj)
    If nSrc <= 0 Then
        free(dst)
        Exit Function
    End If
    CombinePjSources = dst
End Function
