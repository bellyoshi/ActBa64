' PreprocPjSrc - プロジェクトのソース結合

Function PpPathEndsWithPj(path As *Byte) As Long
    Dim n As Long
    Dim c0 As Long
    Dim c1 As Long
    Dim c2 As Long
    PpPathEndsWithPj = 0
    n = lstrlen(path)
    If n < 3 Then Exit Function
    c0 = path[n - 3]
    c1 = PpToLower(path[n - 2])
    c2 = PpToLower(path[n - 1])
    If c0 = 46 And c1 = 112 And c2 = 106 Then
        PpPathEndsWithPj = 1
    End If
End Function

Function PpLineIsSourceHeader(line As *Byte, n As Long) As Long
    Dim i As Long
    Dim word(15) As Byte
    Dim k As Long
    Dim c As Long
    PpLineIsSourceHeader = 0
    i = 0
    While i < n
        c = line[i]
        If c <> 32 And c <> 9 Then Exit While
        i = i + 1
    Wend
    If i >= n Then Exit Function
    If line[i] <> 35 Then Exit Function
    i = i + 1
    lstrcpy(VarPtr(word), "source")
    k = 0
    While word[k] <> 0
        If i + k >= n Then Exit Function
        If PpToLower(line[i + k]) <> word[k] Then Exit Function
        k = k + 1
    Wend
    If i + k < n Then
        c = line[i + k]
        If c <> 32 And c <> 9 And c <> 0 Then Exit Function
    End If
    PpLineIsSourceHeader = 1
End Function

Function PpSkipWsAt(line As *Byte, n As Long, from As Long) As Long
    Dim i As Long
    Dim c As Long
    i = from
    While i < n
        c = line[i]
        If c <> 32 And c <> 9 Then Exit While
        i = i + 1
    Wend
    PpSkipWsAt = i
End Function

Function PpParseEqNumber(line As *Byte, n As Long, from As Long, ByRef valOut As Long) As Long
    Dim i As Long
    Dim c As Long
    Dim v As Long
    Dim got As Long
    PpParseEqNumber = 0
    i = from
    v = 0
    got = 0
    While i < n
        c = line[i]
        If c >= 48 And c <= 57 Then
            v = v * 10 + (c - 48)
            got = 1
        ElseIf c = 32 Or c = 9 Then
            If got <> 0 Then Exit While
        Else
            Exit While
        End If
        i = i + 1
    Wend
    If got = 0 Then Exit Function
    valOut = v
    PpParseEqNumber = 1
End Function

' #USEWINDOW=1 / #usewindow=0 （#SOURCE 節の外も含め全行を対象）
Function PpLineUseWindow(line As *Byte, n As Long, ByRef valOut As Long) As Long
    Dim i As Long
    Dim k As Long
    Dim word(15) As Byte

    PpLineUseWindow = 0
    i = PpSkipWsAt(line, n, 0)
    If i >= n Then Exit Function
    If line[i] <> 35 Then Exit Function
    i = i + 1
    lstrcpy(VarPtr(word), "usewindow")
    k = 0
    While word[k] <> 0
        If i + k >= n Then Exit Function
        If PpToLower(line[i + k]) <> word[k] Then Exit Function
        k = k + 1
    Wend
    i = PpSkipWsAt(line, n, i + k)
    If i >= n Then Exit Function
    If line[i] <> 61 Then Exit Function
    If PpParseEqNumber(line, n, i + 1, valOut) = 0 Then Exit Function
    PpLineUseWindow = 1
End Function

Function PpTrimCopy(line As *Byte, n As Long, dst As *Byte, dstMax As Long) As Long
    Dim i As Long
    Dim j As Long
    Dim c As Long
    PpTrimCopy = 0
    dst[0] = 0
    i = 0
    While i < n
        c = line[i]
        If c <> 32 And c <> 9 Then Exit While
        i = i + 1
    Wend
    If i < n And line[i] = 39 Then Exit Function
    j = 0
    While i < n And j < dstMax - 1
        c = line[i]
        If c = 39 Then Exit While
        dst[j] = c As Byte
        j = j + 1
        i = i + 1
    Wend
    While j > 0
        c = dst[j - 1]
        If c <> 32 And c <> 9 Then Exit While
        j = j - 1
    Wend
    dst[j] = 0
    PpTrimCopy = j
End Function

Sub PpJoinSrcPath(dir As *Byte, name As *Byte, full As *Byte)
    full[0] = 0
    If (name[1] = 58) Or (name[0] = 92) Or (name[0] = 47) Then
        lstrcpy(full, name)
    Else
        lstrcpy(full, dir)
        lstrcat(full, name)
    End If
End Sub

Function PpEmitSrcHeader(dst As *Byte, ByRef dstLen As Long, dstCap As Long, name As *Byte) As Long
    Dim hdr(63) As Byte
    PpEmitSrcHeader = 0
    lstrcpy(VarPtr(hdr), "' ---- ")
    If PpAppend(dst, dstLen, dstCap, VarPtr(hdr), lstrlen(VarPtr(hdr))) = 0 Then Exit Function
    If PpAppend(dst, dstLen, dstCap, name, lstrlen(name)) = 0 Then Exit Function
    lstrcpy(VarPtr(hdr), " ----")
    hdr[5] = 13
    hdr[6] = 10
    hdr[7] = 0
    If PpAppend(dst, dstLen, dstCap, VarPtr(hdr), 7) = 0 Then Exit Function
    PpEmitSrcHeader = 1
End Function

Function PpAppendOneSource(dst As *Byte, ByRef dstLen As Long, dstCap As Long, dir As *Byte, name As *Byte) As Long
    Dim full(511) As Byte
    Dim src As *Byte
    Dim srcSize As Long
    Dim expanded As *Byte
    Dim expLen As Long
    Dim crlf(3) As Byte
    PpAppendOneSource = 0
    PpJoinSrcPath(dir, name, VarPtr(full))
    If PpOnceHas(VarPtr(full)) <> 0 Then
        PpAppendOneSource = 1
        Exit Function
    End If
    src = LoadFile(VarPtr(full), srcSize)
    If src = NULL Then Exit Function
    PpOnceAdd(VarPtr(full))
    expanded = ExpandIncludes(src, srcSize, VarPtr(full))
    free(src)
    If expanded = NULL Then Exit Function
    If PpEmitSrcHeader(dst, dstLen, dstCap, name) = 0 Then
        free(expanded)
        Exit Function
    End If
    expLen = lstrlen(expanded)
    If PpAppend(dst, dstLen, dstCap, expanded, expLen) = 0 Then
        free(expanded)
        Exit Function
    End If
    crlf[0] = 13
    crlf[1] = 10
    If PpAppend(dst, dstLen, dstCap, VarPtr(crlf), 2) = 0 Then
        free(expanded)
        Exit Function
    End If
    free(expanded)
    PpAppendOneSource = 1
End Function

Function PpHandleSourceLoop(line As *Byte, n As Long, ByRef inSource As Long, dst As *Byte, ByRef dstLen As Long, dstCap As Long, dir As *Byte, ByRef nSrc As Long) As Long
    Dim j As Long
    Dim c As Long
    Dim name(259) As Byte
    PpHandleSourceLoop = 1
    If PpLineIsSourceHeader(line, n) <> 0 Then
        inSource = 1
        Exit Function
    End If
    If inSource = 0 Then Exit Function
    j = 0
    While j < n
        c = line[j]
        If c <> 32 And c <> 9 Then Exit While
        j = j + 1
    Wend
    If j < n And line[j] = 35 Then
        inSource = 0
        Exit Function
    End If
    If PpTrimCopy(line, n, VarPtr(name), PJ_PATH_LEN) > 0 Then
        If PpAppendOneSource(dst, dstLen, dstCap, dir, VarPtr(name)) = 0 Then
            PpHandleSourceLoop = 0
            Exit Function
        End If
        nSrc = nSrc + 1
    End If
End Function

Function PpNextPjLine(pj As *Byte, pjSize As Long, ByRef i As Long, line As *Byte) As Long
    Dim start As Long
    Dim n As Long
    Dim c As Long
    Dim j As Long
    start = i
    While i < pjSize
        c = pj[i]
        If c = 10 Or c = 13 Then Exit While
        i = i + 1
    Wend
    n = i - start
    g_ppLastRawLen = n
    If n >= PP_LINE_MAX Then
        PpNextPjLine = -1
        Exit Function
    End If
    j = 0
    While j < n
        line[j] = pj[start + j]
        j = j + 1
    Wend
    line[n] = 0
    If i < pjSize And pj[i] = 13 Then i = i + 1
    If i < pjSize And pj[i] = 10 Then i = i + 1
    PpNextPjLine = n
End Function

Function PpPjProcessLine(line As *Byte, n As Long, ByRef inSource As Long, dst As *Byte, ByRef dstLen As Long, dstCap As Long, dir As *Byte, ByRef nSrc As Long) As Long
    Dim uwVal As Long
    PpPjProcessLine = 0
    If PpLineUseWindow(line, n, uwVal) <> 0 Then
        g_ppUseWindow = uwVal
    End If
    If PpHandleSourceLoop(line, n, inSource, dst, dstLen, dstCap, dir, nSrc) = 0 Then Exit Function
    PpPjProcessLine = 1
End Function

Function CombinePjSources(pjPath As *Byte) As *Byte
    Dim pj As *Byte
    Dim pjSize As Long
    Dim i As Long
    Dim n As Long
    Dim line(1023) As Byte
    Dim dir(511) As Byte
    Dim inSource As Long
    Dim dst As *Byte
    Dim dstLen As Long
    Dim dstCap As Long
    Dim nSrc As Long
    Dim lineNo As Long

    CombinePjSources = NULL
    PpOnceReset()
    g_ppUseWindow = 0
    pj = LoadFile(pjPath, pjSize)
    If pj = NULL Then Exit Function
    PpDirOf(pjPath, VarPtr(dir))

    ' Full actba64.pj sources exceed 256KiB once headers are included.
    dstCap = 2097152
    dst = calloc(dstCap)
    If dst = NULL Then
        free(pj)
        Exit Function
    End If
    dstLen = 0
    dst[0] = 0
    inSource = 0
    nSrc = 0
    i = 0
    lineNo = 1
    While i < pjSize
        n = PpNextPjLine(pj, pjSize, i, VarPtr(line))
        If n < 0 Then
            PpErrorTooLongLine(pjPath, lineNo, g_ppLastRawLen)
            free(pj)
            free(dst)
            Exit Function
        End If
        If PpPjProcessLine(VarPtr(line), n, inSource, dst, dstLen, dstCap, VarPtr(dir), nSrc) = 0 Then
            free(pj)
            free(dst)
            Exit Function
        End If
        lineNo = lineNo + 1
    Wend
    free(pj)
    If nSrc <= 0 Then
        free(dst)
        Exit Function
    End If
    CombinePjSources = dst
End Function
