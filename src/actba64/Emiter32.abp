' ===================================================
'  x86 emitters (no REX, abs addressing for IAT/strings)
' ===================================================

Sub Emit32Enter(cb As *CodeBuffer, frameSize As DWord)
    EmitByte(cb, &H55)
    EmitByte(cb, &H89)
    EmitByte(cb, &HE5)
    EmitByte(cb, &H81)
    EmitByte(cb, &HEC)
    EmitDword(cb, frameSize)
End Sub

Sub Emit32LeaveRet(cb As *CodeBuffer, nPop As DWord)
    EmitByte(cb, &HC9)
    If nPop <> 0 Then
        EmitByte(cb, &HC2)
        EmitByte(cb, nPop And 255)
        EmitByte(cb, (nPop \ 256) And 255)
    Else
        EmitByte(cb, &HC3)
    End If
End Sub

Sub Emit32SubEsp(cb As *CodeBuffer, imm As DWord)
    If imm <= 127 Then
        EmitByte(cb, &H83)
        EmitByte(cb, &HEC)
        EmitByte(cb, imm)
    Else
        EmitByte(cb, &H81)
        EmitByte(cb, &HEC)
        EmitDword(cb, imm)
    End If
End Sub

Sub Emit32AddEsp(cb As *CodeBuffer, imm As DWord)
    If imm <= 127 Then
        EmitByte(cb, &H83)
        EmitByte(cb, &HC4)
        EmitByte(cb, imm)
    Else
        EmitByte(cb, &H81)
        EmitByte(cb, &HC4)
        EmitDword(cb, imm)
    End If
End Sub

Sub Emit32LoadLocal(cb As *CodeBuffer, disp As Long)
    EmitByte(cb, &H8B)
    EmitByte(cb, &H85)
    EmitDword(cb, disp)
End Sub

Sub Emit32StoreLocal(cb As *CodeBuffer, disp As Long)
    EmitByte(cb, &H89)
    EmitByte(cb, &H85)
    EmitDword(cb, disp)
End Sub

Sub Emit32StoreLocalEcx(cb As *CodeBuffer, disp As Long)
    EmitByte(cb, &H89)
    EmitByte(cb, &H8D)
    EmitDword(cb, disp)
End Sub

Sub Emit32StoreLocalEdx(cb As *CodeBuffer, disp As Long)
    EmitByte(cb, &H89)
    EmitByte(cb, &H95)
    EmitDword(cb, disp)
End Sub

Sub Emit32LeaLocal(cb As *CodeBuffer, disp As Long)
    EmitByte(cb, &H8D)
    EmitByte(cb, &H85)
    EmitDword(cb, disp)
End Sub

Sub Emit32IncLocal(cb As *CodeBuffer, disp As Long)
    EmitByte(cb, &HFF)
    EmitByte(cb, &H85)
    EmitDword(cb, disp)
End Sub

Sub Emit32MovAbsEax(cb As *CodeBuffer, absAddr As DWord)
    EmitByte(cb, &HB8)
    EmitDword(cb, absAddr)
End Sub

Sub Emit32CallIatAbs(cb As *CodeBuffer, absIat As DWord)
    EmitByte(cb, &HFF)
    EmitByte(cb, &H15)
    EmitDword(cb, absIat)
End Sub

Sub Emit32StoreEspEax(cb As *CodeBuffer, disp As Long)
    EmitByte(cb, &H89)
    EmitByte(cb, &H84)
    EmitByte(cb, &H24)
    EmitDword(cb, disp)
End Sub

Sub Emit32LoadEspEax(cb As *CodeBuffer, disp As Long)
    EmitByte(cb, &H8B)
    EmitByte(cb, &H84)
    EmitByte(cb, &H24)
    EmitDword(cb, disp)
End Sub

Sub Emit32LoadPtr(cb As *CodeBuffer)
    EmitByte(cb, &H8B)
    EmitByte(cb, &H00)
End Sub

Sub Emit32StorePtr(cb As *CodeBuffer)
    EmitByte(cb, &H89)
    EmitByte(cb, &H08)
End Sub

Sub Emit32MovEcxEax(cb As *CodeBuffer)
    EmitByte(cb, &H89)
    EmitByte(cb, &HC1)
End Sub

Sub Emit32MovEdxEax(cb As *CodeBuffer)
    EmitByte(cb, &H89)
    EmitByte(cb, &HC2)
End Sub

Sub Emit32ShlEcx2(cb As *CodeBuffer)
    EmitByte(cb, &HC1)
    EmitByte(cb, &HE1)
    EmitByte(cb, 2)
End Sub

Sub Emit32AddEaxEcx(cb As *CodeBuffer)
    EmitByte(cb, &H01)
    EmitByte(cb, &HC8)
End Sub

Function Emit32MovEaxImmFixup(cb As *CodeBuffer) As Long
    EmitByte(cb, &HB8)
    Emit32MovEaxImmFixup = cb->size
    EmitDword(cb, 0)
End Function

Sub Emit32MovEdxAbs(cb As *CodeBuffer, absAddr As DWord)
    EmitByte(cb, &HBA)
    EmitDword(cb, absAddr)
End Sub

Sub Emit32AddEaxImm(cb As *CodeBuffer, imm As Long)
    EmitByte(cb, &H05)
    EmitDword(cb, imm)
End Sub

Sub Emit32XchgEaxEcx(cb As *CodeBuffer)
    EmitByte(cb, &H91)
End Sub

' mov eax, fs:[4]  (TIB StackBase)
Sub Emit32FsStackBase(cb As *CodeBuffer)
    EmitByte(cb, &H64)
    EmitByte(cb, &HA1)
    EmitDword(cb, 4)
End Sub

Sub Emit32MovEcxEsp(cb As *CodeBuffer)
    EmitByte(cb, &H89)
    EmitByte(cb, &HE1)
End Sub

Sub Emit32AddEcxImm8(cb As *CodeBuffer, imm As Byte)
    EmitByte(cb, &H83)
    EmitByte(cb, &HC1)
    EmitByte(cb, imm)
End Sub

Sub Emit32CmpEcxEax(cb As *CodeBuffer)
    EmitByte(cb, &H39)
    EmitByte(cb, &HC1)
End Sub

Sub Emit32MovEaxEcx(cb As *CodeBuffer)
    EmitByte(cb, &H89)
    EmitByte(cb, &HC8)
End Sub
