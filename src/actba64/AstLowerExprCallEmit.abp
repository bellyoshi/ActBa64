' AstLowerExprCallEmit - 通常呼び出しの引数と発行

Sub LowEmitArgCvtFlt(ctx As *LowerCtx, expr As Long, ty As Long)
    If ty = TY_DOUBLE Then
        LowEmitCvtToDoubleIfNeeded(ctx, expr)
        Exit Sub
    End If
    If ty = TY_SINGLE Then LowEmitCvtToSingleIfNeeded(ctx, expr)
End Sub

Sub LowEmitArgCvt(ctx As *LowerCtx, expr As Long, name As *Byte, argIdx As Long)
    Dim ty As Long
    If LowFuncIndex(ctx, name) < 0 Then Exit Sub
    ty = LowFindFuncParamTy(ctx, name, argIdx)
    If ty = TY_DOUBLE Or ty = TY_SINGLE Then
        LowEmitArgCvtFlt(ctx, expr, ty)
        Exit Sub
    End If
    ' String の仮引数へ C 文字列（*Byte など）を渡すときは長さ付きの String に複製する（Val(p) など）
    If ty = TY_STRING Then
        LowStrArgToStr(ctx, expr)
        Exit Sub
    End If
    LowEmitCvtToLongIfNeeded(ctx, expr, ty)
End Sub

' Declare の整数の仮引数へ浮動小数を渡すときは切り捨てて整数にする。
' Double / Single の仮引数へはその型のビットにする（-linux の .so の踏み台が xmm へ移す）
Sub LowEmitApiArgCvt(ctx As *LowerCtx, expr As Long, name As *Byte, argIdx As Long)
    Dim pti As Long, ty As Long
    ty = LowStrictDeclScan(ctx, name, argIdx, pti)
    If ty = TY_DOUBLE Or ty = TY_SINGLE Then LowEmitArgCvtFlt(ctx, expr, ty)
    If ty <> TY_LONG Then Exit Sub
    LowEmitCvtToLongIfNeeded(ctx, expr, TY_LONG)
End Sub

' 実引数を rsp+0.. のホーム領域へ格納（ByRef ビット / 仮引数型変換つき）
' 戻り値 true : 正常終了  false : エラーあり
Function LowEmitCallArgHomes(ctx As *LowerCtx, idx As Long, nArgs As Long, byBits As Long, isApi As Long, name As *Byte) As boolean
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList
    Dim argIdx As Long
    Dim argNode As Long
    Dim j As Long
    Dim byRefBit As Long
    Dim useAddr As Long
    Dim home As Long
    Dim slot As Long

    LowEmitCallArgHomes = false
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    home = 0
    argIdx = 0
    argNode = nodes[idx].left
    While argIdx < nArgs
        byRefBit = 1
        j = 0
        While j < argIdx
            byRefBit = byRefBit * 2
            j = j + 1
        Wend
        useAddr = LowCallArgNeedsAddr(ctx, argNode, byBits, byRefBit, isApi)
        If useAddr <> 0 Then
            If LowAddr(ctx, nodes[argNode].left) = 0 Then Exit Function
        Else
            If LowExprArg(ctx, nodes[argNode].left) = 0 Then Exit Function
            If isApi = 0 Then LowEmitArgCvt(ctx, nodes[argNode].left, name, argIdx)
            If isApi <> 0 Then LowEmitApiArgCvt(ctx, nodes[argNode].left, name, argIdx)
        End If
        slot = LowNextArgBytes(ctx, name, argIdx, useAddr, isApi)
        LowEmitHomeStore(list, home, slot)
        home = home + slot
        argIdx = argIdx + 1
        argNode = nodes[argNode].nxt
    Wend
    LowEmitCallArgHomes = true
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function LowExprCallEmit(ctx As *LowerCtx, idx As Long, lab As Long, isApi As Long, dllKind As Long, byBits As Long, apiName As *Byte) As boolean
    Dim stackPad(LOW_STACK_PAD - 1) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim list As *IrList
    Dim nArgs As Long
    Dim argIdx As Long
    Dim callBytes As Long

    LowExprCallEmit = false
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    AstCopyStr(ast, idx, VarPtr(name))
    nArgs = nodes[idx].num
    If nArgs > LOW_MAX_ARGS Then
        LowPrintErr("error: too many call args (" + Str$(nArgs) + ") '" + MakeStr(VarPtr(name)) + "'")
        ctx->err = 1
        Exit Function
    End If
    argIdx = LowCountCallArgs(ctx, idx, 0)
    If argIdx < 0 Or argIdx <> nArgs Then
        ctx->err = 1
        Exit Function
    End If
    callBytes = LowEmitCallBytes(ctx, idx, nArgs, byBits, isApi, VarPtr(name))
    If callBytes > 1024 Then
        LowPrintErr("error: call stack too large (" + Str$(callBytes) + ") '" + MakeStr(VarPtr(name)) + "'")
        ctx->err = 1
        Exit Function
    End If
    If callBytes > 0 Then
        IrEmit(list, OP_SUB_RSP, callBytes, 0)
    End If
    If Not LowEmitCallArgHomes(ctx, idx, nArgs, byBits, isApi, VarPtr(name)) Then Exit Function
    LowEmitPadArgs(ctx, idx, nArgs, byBits, isApi, VarPtr(name))
    LowEmitLoadRegArgs(list, LowCallAllArgs(ctx, VarPtr(name), nArgs, isApi))
    If isApi <> 0 Then
        IrEmitStr(list, OP_CALL_API, dllKind, apiName)
    Else
        IrEmit(list, OP_CALL_LAB, lab, 0)
    End If
    LowEmitCallFinish(list, callBytes)
    LowExprCallEmit = true
End Function

' Decl 呼び出し用: "dll|api" を packed に組み立てる
' 戻り値 true : 正常終了  false : エラーあり
Function LowPackApiCall(dllName As *Byte, apiName As *Byte, packed As *Byte) As boolean
    Dim i As Long
    Dim j As Long
    LowPackApiCall = false
    i = 0
    While dllName[i] <> 0 And i < 120
        packed[i] = dllName[i]
        i = i + 1
    Wend
    If dllName[i] <> 0 Then Exit Function
    packed[i] = 124
    i = i + 1
    j = 0
    While apiName[j] <> 0 And i < 250
        packed[i] = apiName[j]
        i = i + 1
        j = j + 1
    Wend
    If apiName[j] <> 0 Then Exit Function
    packed[i] = 0
    LowPackApiCall = true
End Function

Function LowExprCallNormal(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(LOW_STACK_PAD - 1) As Byte
    Dim ast As *Ast
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim lab As Long
    Dim byBits As Long
    Dim apiName(SYM_NAME_LEN - 1) As Byte
    Dim dllName(SYM_NAME_LEN - 1) As Byte
    Dim packed(TEXT_LEN - 1) As Byte
    Dim isApi As Long
    Dim di As Long
    Dim bys As *Long

    LowExprCallNormal = 0
    ast = ctx->ast
    AstCopyStr(ast, idx, VarPtr(name))
    If LowExprCallArr(ctx, idx) <> 0 Then
        LowExprCallNormal = 1
        Exit Function
    End If
    If ctx->err <> 0 Then Exit Function
    lab = LowFindFunc(ctx, VarPtr(name))
    isApi = 0
    byBits = 0
    If lab >= 0 Then
        byBits = LowFindFuncByRefs(ctx, VarPtr(name))
        If Not LowExprCallEmit(ctx, idx, lab, 0, 0, byBits, VarPtr(apiName)) Then Exit Function
    Else
        di = LowFindDecl(ctx, VarPtr(name))
        If di < 0 Then
            ' メソッドの中なら同じクラスのメソッド（This. の省略）
            LowExprCallNormal = LowTrySelfCall(ctx, idx, VarPtr(name))
            If LowExprCallNormal >= 0 Then Exit Function
            ' 関数ポインタのフィールド（errorproc(...) のような呼び出し）
            LowExprCallNormal = LowTryFieldCall(ctx, idx, VarPtr(name))
            If LowExprCallNormal >= 0 Then Exit Function
            LowExprCallNormal = 0
            LowPrintErr("error: unknown API/call '" + MakeStr(VarPtr(name)) + "'")
            ctx->err = 1
            Exit Function
        End If
        LowDeclApiName(ctx, di, VarPtr(apiName))
        LowDeclDllName(ctx, di, VarPtr(dllName))
        LxSoCallName(ctx, di, VarPtr(dllName), VarPtr(apiName))
        bys = ctx->declByRefs
        byBits = bys[di]
        If Not LowPackApiCall(VarPtr(dllName), VarPtr(apiName), VarPtr(packed)) Then
            LowPrintErr("error: Declare name too long '" + MakeStr(VarPtr(name)) + "'")
            ctx->err = 1
            Exit Function
        End If
        isApi = 1
        If Not LowExprCallEmit(ctx, idx, lab, isApi, 0, byBits, VarPtr(packed)) Then Exit Function
    End If
    LowExprCallNormal = 1
End Function

Function LowExprCall(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim r As Long

    LowExprCall = 0
    OvlFixCall(ctx, idx)
    ast = ctx->ast
    nodes = ast->nodes
    If nodes[idx].extra = -4 Then
        LowExprCall = LowExprCallSuper(ctx, idx)
        Exit Function
    End If
    LowStrictCheckArgs(ctx, idx)
    If nodes[idx].extra = -3 Then
        LowExprCall = LowExprCallMethod(ctx, idx)
        Exit Function
    End If
    r = LowExprCallIntrin(ctx, idx)
    If ctx->err <> 0 Then Exit Function
    If r > 0 Then
        LowExprCall = r
        Exit Function
    End If
    LowExprCall = LowExprCallNormal(ctx, idx)
End Function

Function LowNextArgBytes(ctx As *LowerCtx, name As *Byte, argIdx As Long, useAddr As Long, isApi As Long) As Long
    Dim ty As Long
    LowNextArgBytes = TyPtrSize()
    If TyIs32() = 0 Or isApi <> 0 Or useAddr <> 0 Then Exit Function
    ty = LowFindFuncParamTy(ctx, name, argIdx)
    If ty = TY_DOUBLE Then LowNextArgBytes = 8
End Function

Sub LowEmitHomeStore(list As *IrList, disp As Long, slot As Long)
    If slot = 8 And TyIs32() <> 0 Then
        IrEmit(list, OP_STORE_RSP_DBL, disp, 0)
        Exit Sub
    End If
    IrEmit(list, OP_STORE_RSP_RAX, disp, 0)
End Sub

Function LowHomesStep(ctx As *LowerCtx, name As *Byte, argNode As Long, argIdx As Long, byBits As Long, bit As Long) As Long
    Dim useAddr As Long
    useAddr = LowCallArgNeedsAddr(ctx, argNode, byBits, bit, 0)
    LowHomesStep = LowNextArgBytes(ctx, name, argIdx, useAddr, 0)
End Function

Function LowStackHomes(ctx As *LowerCtx, idx As Long, nArgs As Long, byBits As Long, name As *Byte) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim argNode As Long
    Dim argIdx As Long
    Dim n As Long
    Dim bit As Long
    ast = ctx->ast
    nodes = ast->nodes
    n = 0
    bit = 1
    argIdx = 0
    argNode = nodes[idx].left
    While argIdx < nArgs
        n = n + LowHomesStep(ctx, name, argNode, argIdx, byBits, bit)
        bit = bit * 2
        argIdx = argIdx + 1
        argNode = nodes[argNode].nxt
    Wend
    LowStackHomes = n
End Function

Function LowEmitCallBytes(ctx As *LowerCtx, idx As Long, nArgs As Long, byBits As Long, isApi As Long, name As *Byte) As Long
    Dim nAll As Long
    nAll = LowCallAllArgs(ctx, name, nArgs, isApi)
    If TyIs32() <> 0 And isApi = 0 Then
        LowEmitCallBytes = LowStackHomes(ctx, idx, nArgs, byBits, name) + LowPadBytes(ctx, name, nArgs, nAll, byBits)
        Exit Function
    End If
    LowEmitCallBytes = LowCallBytes(nAll)
End Function

' 省略した引数も仮引数の数だけ渡す
Function LowCallAllArgs(ctx As *LowerCtx, name As *Byte, nArgs As Long, isApi As Long) As Long
    Dim i As Long
    LowCallAllArgs = nArgs
    If isApi <> 0 Then Exit Function
    i = LowFuncIndex(ctx, name)
    If i < 0 Then Exit Function
    If LowNargsAt(i) > nArgs Then LowCallAllArgs = LowNargsAt(i)
End Function

Function LowArgBit(argIdx As Long) As Long
    Dim j As Long
    LowArgBit = 1
    j = 0
    While j < argIdx
        LowArgBit = LowArgBit * 2
        j = j + 1
    Wend
End Function

Function LowPadSlot(ctx As *LowerCtx, name As *Byte, argIdx As Long, byBits As Long) As Long
    Dim useAddr As Long
    useAddr = 0
    If (byBits And LowArgBit(argIdx)) <> 0 Then useAddr = 1
    LowPadSlot = LowNextArgBytes(ctx, name, argIdx, useAddr, 0)
End Function

Function LowPadBytes(ctx As *LowerCtx, name As *Byte, nArgs As Long, nAll As Long, byBits As Long) As Long
    Dim k As Long
    LowPadBytes = 0
    For k = nArgs To nAll - 1
        LowPadBytes = LowPadBytes + LowPadSlot(ctx, name, k, byBits)
    Next
End Function

Function LowPadStart(ctx As *LowerCtx, idx As Long, nArgs As Long, byBits As Long, name As *Byte) As Long
    LowPadStart = nArgs * TyPtrSize()
    If TyIs32() <> 0 Then LowPadStart = LowStackHomes(ctx, idx, nArgs, byBits, name)
End Function

' 足りない引数の場所に 0 を置く。ByRef なら NULL。
Sub LowEmitPadArgs(ctx As *LowerCtx, idx As Long, nArgs As Long, byBits As Long, isApi As Long, name As *Byte)
    Dim k As Long, home As Long, slot As Long
    home = LowPadStart(ctx, idx, nArgs, byBits, name)
    For k = nArgs To LowCallAllArgs(ctx, name, nArgs, isApi) - 1
        slot = LowPadSlot(ctx, name, k, byBits)
        LowEmitPadZero(ctx->list, home, slot)
        home = home + slot
    Next
End Sub

Sub LowEmitPadZero(list As *IrList, home As Long, slot As Long)
    IrEmit(list, OP_MOV_EAX_IMM, 0, 0)
    IrEmit(list, OP_STORE_RSP_RAX, home, 0)
    If slot = 8 And TyIs32() <> 0 Then IrEmit(list, OP_STORE_RSP_RAX, home + 4, 0)
End Sub
