' AstLowerExprCallEmit - 通常呼び出しの引数と発行

' 実引数を rsp+0.. のホーム領域へ格納（ByRef ビット / 仮引数型変換つき）
Function LowEmitCallArgHomes(ctx As *LowerCtx, idx As Long, nArgs As Long, byBits As Long, isApi As Long, name As *Byte) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList
    Dim argIdx As Long
    Dim argNode As Long
    Dim j As Long
    Dim byRefBit As Long
    Dim useAddr As Long

    LowEmitCallArgHomes = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    argIdx = 0
    argNode = nodes[idx].left
    While argIdx < nArgs
        byRefBit = 1
        j = 0
        While j < argIdx
            byRefBit = byRefBit * 2
            j = j + 1
        Wend
        useAddr = LowCallArgNeedsAddr(ctx, argNode, byBits, byRefBit, isApi)
        If useAddr <> 0 Then
            If LowAddr(ctx, nodes[argNode].left) = 0 Then Exit Function
        Else
            If LowExprArg(ctx, nodes[argNode].left) = 0 Then Exit Function
            If isApi = 0 Then
                If LowFindFuncParamTy(ctx, name, argIdx) = TY_DOUBLE Then
                    LowEmitCvtToDoubleIfNeeded(ctx, nodes[argNode].left)
                ElseIf LowFindFuncParamTy(ctx, name, argIdx) = TY_SINGLE Then
                    LowEmitCvtToSingleIfNeeded(ctx, nodes[argNode].left)
                End If
            End If
        End If
        IrEmit(list, OP_STORE_RSP_RAX, argIdx * TyPtrSize(), 0)
        argIdx = argIdx + 1
        argNode = nodes[argNode].nxt
    Wend
    LowEmitCallArgHomes = 1
End Function

Function LowExprCallEmit(ctx As *LowerCtx, idx As Long, lab As Long, isApi As Long, dllKind As Long, byBits As Long, apiName As *Byte) As Long
    Dim stackPad(2047) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim list As *IrList
    Dim nArgs As Long
    Dim argIdx As Long
    Dim callBytes As Long

    LowExprCallEmit = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    AstCopyStr(ast, idx, VarPtr(name))
    nArgs = nodes[idx].num
    If nArgs > 16 Then
        Print "error: too many call args (" + Str$(nArgs) + ") '" + MakeStr(VarPtr(name)) + "'"
        ctx->err = 1
        Exit Function
    End If
    argIdx = LowCountCallArgs(ctx, idx, 0)
    If argIdx < 0 Or argIdx <> nArgs Then
        ctx->err = 1
        Exit Function
    End If
    callBytes = LowCallBytes(nArgs)
    If callBytes > 120 Then
        Print "error: call stack too large (" + Str$(callBytes) + ") '" + MakeStr(VarPtr(name)) + "'"
        ctx->err = 1
        Exit Function
    End If
    If callBytes > 0 Then
        IrEmit(list, OP_SUB_RSP, callBytes, 0)
    End If
    If LowEmitCallArgHomes(ctx, idx, nArgs, byBits, isApi, VarPtr(name)) = 0 Then Exit Function
    LowEmitLoadRegArgs(list, nArgs)
    If isApi <> 0 Then
        IrEmitStr(list, OP_CALL_API, dllKind, apiName)
    Else
        IrEmit(list, OP_CALL_LAB, lab, 0)
    End If
    LowEmitCallFinish(list, callBytes)
    LowExprCallEmit = 1
End Function

' Decl 呼び出し用: "dll|api" を packed に組み立てる
Function LowPackApiCall(dllName As *Byte, apiName As *Byte, packed As *Byte) As Long
    Dim i As Long
    Dim j As Long
    LowPackApiCall = 0
    i = 0
    While dllName[i] <> 0 And i < 120
        packed[i] = dllName[i]
        i = i + 1
    Wend
    If dllName[i] <> 0 Then Exit Function
    packed[i] = 124
    i = i + 1
    j = 0
    While apiName[j] <> 0 And i < 250
        packed[i] = apiName[j]
        i = i + 1
        j = j + 1
    Wend
    If apiName[j] <> 0 Then Exit Function
    packed[i] = 0
    LowPackApiCall = 1
End Function

Function LowExprCallNormal(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim lab As Long
    Dim byBits As Long
    Dim apiName(63) As Byte
    Dim dllName(63) As Byte
    Dim packed(255) As Byte
    Dim isApi As Long
    Dim di As Long
    Dim bys As *Long

    LowExprCallNormal = 0
    ast = ctx->ast
    AstCopyStr(ast, idx, VarPtr(name))
    If LowExprCallArr(ctx, idx) <> 0 Then
        LowExprCallNormal = 1
        Exit Function
    End If
    If ctx->err <> 0 Then Exit Function
    lab = LowFindFunc(ctx, VarPtr(name))
    isApi = 0
    byBits = 0
    If lab >= 0 Then
        byBits = LowFindFuncByRefs(ctx, VarPtr(name))
        If LowExprCallEmit(ctx, idx, lab, 0, 0, byBits, VarPtr(apiName)) = 0 Then Exit Function
    Else
        di = LowFindDecl(ctx, VarPtr(name))
        If di < 0 Then
            Print "error: unknown API/call '" + MakeStr(VarPtr(name)) + "'"
            ctx->err = 1
            Exit Function
        End If
        LowDeclApiName(ctx, di, VarPtr(apiName))
        LowDeclDllName(ctx, di, VarPtr(dllName))
        bys = ctx->declByRefs
        byBits = bys[di]
        If LowPackApiCall(VarPtr(dllName), VarPtr(apiName), VarPtr(packed)) = 0 Then
            Print "error: Declare name too long '" + MakeStr(VarPtr(name)) + "'"
            ctx->err = 1
            Exit Function
        End If
        isApi = 1
        If LowExprCallEmit(ctx, idx, lab, isApi, 0, byBits, VarPtr(packed)) = 0 Then Exit Function
    End If
    LowExprCallNormal = 1
End Function

Function LowExprCall(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim r As Long

    LowExprCall = 0
    ast = ctx->ast
    nodes = ast->nodes
    If nodes[idx].extra = -3 Then
        LowExprCall = LowExprCallMethod(ctx, idx)
        Exit Function
    End If
    r = LowExprCallIntrin(ctx, idx)
    If ctx->err <> 0 Then Exit Function
    If r > 0 Then
        LowExprCall = r
        Exit Function
    End If
    LowExprCall = LowExprCallNormal(ctx, idx)
End Function
