' AstLowerExprCallEmit - 通常呼び出しの引数と発行

' 実引数を rsp+0.. のホーム領域へ格納（ByRef ビット / 仮引数型変換つき）
Function LowEmitCallArgsHome(ctx As *LowerCtx, idx As Long, nArgs As Long, byBits As Long, isApi As Long, name As *Byte) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList
    Dim argi As Long
    Dim argNode As Long
    Dim j As Long
    Dim bbit As Long
    Dim useAddr As Long

    LowEmitCallArgsHome = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    argi = 0
    argNode = nodes[idx].left
    While argi < nArgs
        bbit = 1
        j = 0
        While j < argi
            bbit = bbit * 2
            j = j + 1
        Wend
        useAddr = LowCallUseAddr(ctx, argNode, byBits, bbit, isApi)
        If useAddr <> 0 Then
            If LowAddr(ctx, nodes[argNode].left) = 0 Then Exit Function
        Else
            If LowExprArg(ctx, nodes[argNode].left) = 0 Then Exit Function
            If isApi = 0 Then
                If LowFindFuncParamTy(ctx, name, argi) = TY_DOUBLE Then
                    LowEmitCvtToDoubleIfNeeded(ctx, nodes[argNode].left)
                ElseIf LowFindFuncParamTy(ctx, name, argi) = TY_SINGLE Then
                    LowEmitCvtToSingleIfNeeded(ctx, nodes[argNode].left)
                End If
            End If
        End If
        IrEmit(list, OP_STORE_RSP_RAX, argi * TyPtrSize(), 0)
        argi = argi + 1
        argNode = nodes[argNode].nxt
    Wend
    LowEmitCallArgsHome = 1
End Function

Function LowExprCallEmit(ctx As *LowerCtx, idx As Long, lab As Long, isApi As Long, dllKind As Long, byBits As Long, apiName As *Byte) As Long
    Dim stackPad(2047) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim list As *IrList
    Dim nArgs As Long
    Dim argi As Long
    Dim callBytes As Long

    LowExprCallEmit = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    AstCopyStr(ast, idx, VarPtr(name))
    nArgs = nodes[idx].num
    If nArgs > 16 Then
        Print "error: too many call args (" + Str$(nArgs) + ") '" + MakeStr(VarPtr(name)) + "'"
        ctx->err = 1
        Exit Function
    End If
    argi = LowCountCallArgs(ctx, idx, 0)
    If argi < 0 Or argi <> nArgs Then
        ctx->err = 1
        Exit Function
    End If
    callBytes = LowCallBytes(nArgs)
    If callBytes > 120 Then
        Print "error: call stack too large (" + Str$(callBytes) + ") '" + MakeStr(VarPtr(name)) + "'"
        ctx->err = 1
        Exit Function
    End If
    If callBytes > 0 Then
        IrEmit(list, OP_SUB_RSP, callBytes, 0)
    End If
    If LowEmitCallArgsHome(ctx, idx, nArgs, byBits, isApi, VarPtr(name)) = 0 Then Exit Function
    LowEmitLoadRegArgs(list, nArgs)
    If isApi <> 0 Then
        IrEmitStr(list, OP_CALL_API, dllKind, apiName)
    Else
        IrEmit(list, OP_CALL_LAB, lab, 0)
    End If
    LowEmitCallFinish(list, callBytes)
    LowExprCallEmit = 1
End Function

Function LowExprCallNormal(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim lab As Long
    Dim byBits As Long
    Dim apiName(63) As Byte
    Dim isApi As Long
    Dim di As Long
    Dim dllKind As Long
    Dim dlls As *Long
    Dim bys As *Long

    LowExprCallNormal = 0
    ast = ctx->ast
    AstCopyStr(ast, idx, VarPtr(name))
    If LowExprCallArr(ctx, idx) <> 0 Then
        LowExprCallNormal = 1
        Exit Function
    End If
    If ctx->err <> 0 Then Exit Function
    lab = LowFindFunc(ctx, VarPtr(name))
    isApi = 0
    dllKind = 0
    byBits = 0
    If lab >= 0 Then
        byBits = LowFindFuncByRefs(ctx, VarPtr(name))
    Else
        di = LowFindDecl(ctx, VarPtr(name))
        If di >= 0 Then
            LowDeclApiName(ctx, di, VarPtr(apiName))
            dlls = ctx->declDlls
            bys = ctx->declByRefs
            dllKind = dlls[di]
            byBits = bys[di]
            isApi = 1
        Else
            If LowMapWinApi(VarPtr(name), dllKind, VarPtr(apiName)) = 0 Then
                Print "error: unknown API/call '" + MakeStr(VarPtr(name)) + "'"
                ctx->err = 1
                Exit Function
            End If
            isApi = 1
        End If
    End If
    If isApi <> 0 And dllKind = 0 Then dllKind = IR_DLL_KERNEL32
    If LowExprCallEmit(ctx, idx, lab, isApi, dllKind, byBits, VarPtr(apiName)) = 0 Then Exit Function
    LowExprCallNormal = 1
End Function

Function LowExprCall(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim r As Long

    LowExprCall = 0
    ast = ctx->ast
    nodes = ast->nodes
    If nodes[idx].extra = -3 Then
        LowExprCall = LowExprCallMethod(ctx, idx)
        Exit Function
    End If
    r = LowExprCallIntrin(ctx, idx)
    If ctx->err <> 0 Then Exit Function
    If r > 0 Then
        LowExprCall = r
        Exit Function
    End If
    LowExprCall = LowExprCallNormal(ctx, idx)
End Function
