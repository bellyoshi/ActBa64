' ParserTypeEnum - Type と Enum

' 戻り値 true : 正常終了  false : エラーあり
Function ParseTypeAlign(p As *Parser, types As *TypeTable, ti As Long) As boolean
    Dim kAlign(KW_LEN - 1) As Byte
    Dim alignN As Long
    Dim sign As Long

    ParseTypeAlign = false
    sign = 1
    lstrcpy(VarPtr(kAlign), "pack")
    ' Pack(n) は負の値で持つ（ParseTypeAlign 参照）
    If ParseIdentIs(p, VarPtr(kAlign)) <> 0 Then sign = -1
    If sign > 0 Then lstrcpy(VarPtr(kAlign), "align")
    If ParseIdentIs(p, VarPtr(kAlign)) <> 0 Then
        p->pos = p->pos + 1
        If Not ParseExpect(p, TK_LPAREN) Then Exit Function
        If ParseTokKind(p) <> TK_NUMBER Then
            p->err = 1
            Exit Function
        End If
        alignN = ParseTokNum(p) * sign
        p->pos = p->pos + 1
        If Not ParseExpect(p, TK_RPAREN) Then Exit Function
        If Not TySetExplicitAlign(types, ti, alignN) Then
            p->err = 1
            Exit Function
        End If
    End If
    ParseTypeAlign = true
End Function

' Type Align(1) Name のように名前の前の Align / Pack なら、その位置を返して飛ばす。無ければ -1
Function ParseTypeLeadAlign(p As *Parser) As Long
    ParseTypeLeadAlign = -1
    If ParseTypeIsAlignAt(p, p->pos) = 0 Then Exit Function
    ParseTypeLeadAlign = p->pos
    p->pos = p->pos + 4
End Function

' at が Align( / Pack( なら 1
Function ParseTypeIsAlignAt(p As *Parser, at As Long) As Long
    Dim kw(KW_LEN - 1) As Byte
    ParseTypeIsAlignAt = 0
    If ParseTokKindAt(p, at + 1) <> TK_LPAREN Then Exit Function
    lstrcpy(VarPtr(kw), "align")
    If ParseIdentIsAt(p, at, VarPtr(kw)) <> 0 Then ParseTypeIsAlignAt = 1
    lstrcpy(VarPtr(kw), "pack")
    If ParseIdentIsAt(p, at, VarPtr(kw)) <> 0 Then ParseTypeIsAlignAt = 1
End Function

' 名前の前に Align があればそこで読み、名前の後ろへ戻る。無ければ名前の後ろで読む
' 前置きの Type Align(n) Name（ActiveBasic 4）はメンバを n バイトに詰める Pack(n) と同じ
Function ParseTypeAlignAt(p As *Parser, types As *TypeTable, ti As Long, alignAt As Long) As boolean
    Dim save As Long
    Dim a As Long
    If alignAt < 0 Then
        ParseTypeAlignAt = ParseTypeAlign(p, types, ti)
        Exit Function
    End If
    save = p->pos
    p->pos = alignAt
    ParseTypeAlignAt = ParseTypeAlign(p, types, ti)
    p->pos = save
    a = types->typeExplicitAlign[ti]
    If a > 0 Then TySetExplicitAlign(types, ti, 0 - a)
End Function

Function ParseTypeStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim types As *TypeTable
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim kEnd(KW_SHORT_LEN - 1) As Byte
    Dim kType(KW_SHORT_LEN - 1) As Byte
    Dim ti As Long
    Dim nType As Long
    Dim alignAt As Long

    ParseTypeStmt = -1
    p->pos = p->pos + 1
    alignAt = ParseTypeLeadAlign(p)
    If Not ParseCopyIdent(p, VarPtr(name)) Then Exit Function
    ast = p->ast
    types = ast->types
    ti = TyAdd(types, VarPtr(name))
    If ti < 0 Then
        p->err = 1
        Exit Function
    End If
    If Not ParseTypeAlignAt(p, types, ti, alignAt) Then Exit Function
    lstrcpy(VarPtr(kEnd), "end")
    lstrcpy(VarPtr(kType), "type")
    Do
        If ParseIdentIs(p, VarPtr(kEnd)) <> 0 Then
            p->pos = p->pos + 1
            If ParseIdentIs(p, VarPtr(kType)) = 0 Then
                p->err = 1
                Exit Function
            End If
            p->pos = p->pos + 1
            Exit Do
        End If
        If Not ParseClassField(p, ti, ACC_PUBLIC) Then Exit Function
    Loop
    TyFinalizeType(types, ti)
    nType = AstAddNode(ast, AST_TYPE)
    If nType < 0 Then Exit Function
    AstSetStr(ast, nType, VarPtr(name))
    ParseTypeStmt = nType
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function ParseEnumMem(p As *Parser, ast As *Ast, ByRef nFirst As Long, ByRef nPrev As Long) As boolean
    Dim nodes As *AstNode
    Dim mname(SYM_NAME_LEN - 1) As Byte
    Dim nMem As Long
    Dim e As Long

    ParseEnumMem = false
    If Not ParseCopyIdent(p, VarPtr(mname)) Then
        p->err = 1
        Exit Function
    End If
    e = -1
    If ParseTokKind(p) = TK_EQ Then
        p->pos = p->pos + 1
        e = ParseExpr(p)
        If e < 0 Or p->err <> 0 Then Exit Function
    End If
    ' A, B, C のように , で区切ってもよい
    If ParseTokKind(p) = TK_COMMA Then p->pos = p->pos + 1
    nMem = AstAddNode(ast, AST_ENUMMEM)
    If nMem < 0 Then Exit Function
    AstSetStr(ast, nMem, VarPtr(mname))
    nodes = ast->nodes
    nodes[nMem].left = e
    nodes[nMem].right = -1
    nodes[nMem].nxt = -1
    If nFirst < 0 Then
        nFirst = nMem
    Else
        nodes[nPrev].nxt = nMem
    End If
    nPrev = nMem
    ParseEnumMem = true
End Function

Function ParseEnumStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim types As *TypeTable
    Dim nodes As *AstNode
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim kEnd(KW_SHORT_LEN - 1) As Byte
    Dim kEnum(KW_SHORT_LEN - 1) As Byte
    Dim ti As Long
    Dim sizes As *Long
    Dim nEnum As Long
    Dim nFirst As Long
    Dim nPrev As Long

    ParseEnumStmt = -1
    p->pos = p->pos + 1
    If Not ParseCopyIdent(p, VarPtr(name)) Then Exit Function
    ast = p->ast
    types = ast->types
    ti = TyAdd(types, VarPtr(name))
    If ti < 0 Then
        p->err = 1
        Exit Function
    End If
    sizes = types->typeSizes
    sizes[ti] = 4
    TyFinalizeType(types, ti)
    lstrcpy(VarPtr(kEnd), "end")
    lstrcpy(VarPtr(kEnum), "enum")
    nFirst = -1
    nPrev = -1
    Do
        If ParseIdentIs(p, VarPtr(kEnd)) <> 0 Then
            p->pos = p->pos + 1
            If ParseIdentIs(p, VarPtr(kEnum)) = 0 Then
                p->err = 1
                Exit Function
            End If
            p->pos = p->pos + 1
            Exit Do
        End If
        If Not ParseEnumMem(p, ast, nFirst, nPrev) Then Exit Function
    Loop
    nEnum = AstAddNode(ast, AST_ENUM)
    If nEnum < 0 Then Exit Function
    AstSetStr(ast, nEnum, VarPtr(name))
    nodes = ast->nodes
    nodes[nEnum].left = nFirst
    nodes[nEnum].num = ti
    ParseEnumStmt = nEnum
End Function
