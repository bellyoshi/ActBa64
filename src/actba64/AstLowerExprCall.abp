' AstLowerExprCall - メソッド呼び出しと組み込み呼び出し

' ===================================================
'  AstLowerExprOps - call / binop / cast / cmp
' ===================================================

' AST_ARG チェーンの個数を base から数える。LOW_MAX_ARGS を超えたら -1
Function LowCountCallArgs(ctx As *LowerCtx, idx As Long, base As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim argIdx As Long
    Dim argNode As Long

    ast = ctx->ast
    nodes = ast->nodes
    argIdx = base
    argNode = nodes[idx].left
    While argNode >= 0
        If argIdx >= LOW_MAX_ARGS Then
            LowCountCallArgs = -1
            Exit Function
        End If
        argIdx = argIdx + 1
        argNode = nodes[argNode].nxt
    Wend
    LowCountCallArgs = argIdx
End Function

' メソッド呼び出しのユーザー引数を rsp+8.. のホーム領域へ
' 戻り値 true : 正常終了  false : エラーあり
' 呼ぶメソッドの関数名（Class_Method）。引数の型を引くのに使う。LowEmitMethodArgs が入口で写す
Dim g_methSig(MANGLED_LEN - 1) As Byte

' メソッド idx（クラス ti）の関数名を dst へ
Sub LowMethodSigTo(ctx As *LowerCtx, idx As Long, ti As Long, dst As *Byte)
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim off As Long
    Dim ast As *Ast
    Dim typeTable As *TypeTable
    Dim names As *Byte
    ast = ctx->ast
    typeTable = ast->types
    names = typeTable->typeNames
    AstCopyStr(ast, idx, VarPtr(name))
    off = LowMethodDefTi(ti, VarPtr(name)) * TYNAME_LEN
    LowMangleClass(VarPtr(names[off]), VarPtr(name), dst)
End Sub

Sub LowSetMethodSig(ctx As *LowerCtx, idx As Long, ti As Long)
    LowMethodSigTo(ctx, idx, ti, VarPtr(g_methSig))
End Sub

' obj.M(...) / This なしの M(...) なら呼ぶメソッドのクラス番号。メソッドでなければ -1
Function LowCallMethodTi(ctx As *LowerCtx, idx As Long) As Long
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim ast As *Ast
    Dim nodes As *AstNode
    ast = ctx->ast
    nodes = ast->nodes
    LowCallMethodTi = -1
    If nodes[idx].extra = -3 Then LowCallMethodTi = LowRecvClassTi(ctx, nodes[idx].right)
    If nodes[idx].extra = -3 Or nodes[idx].extra = -4 Then Exit Function
    AstCopyStr(ast, idx, VarPtr(name))
    If LowFuncIndex(ctx, VarPtr(name)) < 0 Then LowCallMethodTi = LowSelfMethodTi(ctx, VarPtr(name))
End Function

' メソッド呼び出しの戻り値の型。メソッドでなければ -1
Function LowMethodRetTy(ctx As *LowerCtx, idx As Long) As Long
    Dim sig(MANGLED_LEN - 1) As Byte
    Dim ti As Long
    LowMethodRetTy = -1
    ti = LowCallMethodTi(ctx, idx)
    If ti < 0 Then Exit Function
    LowMethodSigTo(ctx, idx, ti, VarPtr(sig))
    LowMethodRetTy = LowFindFuncRetTy(ctx, VarPtr(sig))
End Function

Function LowMethodCallBytes(ctx As *LowerCtx, idx As Long, nArgs As Long) As Long
    Dim nodes As *AstNode
    nodes = LowAstNodes(ctx)
    LowMethodCallBytes = LowMethodCallBytesFrom(ctx, nodes[idx].left, nArgs)
End Function

' 32bit は Double の引数を 8 バイトで積む。This を含めた積む大きさ（argNode から nArgs - 1 個）
Function LowMethodCallBytesFrom(ctx As *LowerCtx, argNode As Long, nArgs As Long) As Long
    Dim nodes As *AstNode
    Dim argIdx As Long
    Dim byBits As Long
    LowMethodCallBytesFrom = LowCallBytes(nArgs)
    If TyIs32() = 0 Then Exit Function
    nodes = LowAstNodes(ctx)
    byBits = LowFindFuncByRefs(ctx, VarPtr(g_methSig))
    LowMethodCallBytesFrom = TyPtrSize()
    For argIdx = 1 To nArgs - 1
        LowMethodCallBytesFrom = LowMethodCallBytesFrom + LowNextArgBytes(ctx, VarPtr(g_methSig), argIdx, LowCallArgNeedsAddr(ctx, argNode, byBits, LowArgBit(argIdx), 1), 0)
        argNode = nodes[argNode].nxt
    Next
End Function

' Double / Single の仮引数へ整数を渡すときは変換する
Sub LowEmitMethodArgCvt(ctx As *LowerCtx, expr As Long, sig As *Byte, argIdx As Long)
    Dim ty As Long
    If LowFuncIndex(ctx, sig) < 0 Then Exit Sub
    ty = LowFindFuncParamTy(ctx, sig, argIdx)
    If ty = TY_DOUBLE Or ty = TY_SINGLE Then LowEmitArgCvtFlt(ctx, expr, ty)
End Sub

Function LowEmitMethodArg(ctx As *LowerCtx, argNode As Long, sig As *Byte, argIdx As Long, ByRef home As Long) As boolean
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim useAddr As Long
    Dim slot As Long
    LowEmitMethodArg = false
    ast = ctx->ast
    nodes = ast->nodes
    useAddr = LowCallArgNeedsAddr(ctx, argNode, LowFindFuncByRefs(ctx, sig), LowArgBit(argIdx), 1)
    If useAddr <> 0 Then
        If LowAddr(ctx, nodes[argNode].left) = 0 Then Exit Function
    Else
        If LowExprArg(ctx, nodes[argNode].left) = 0 Then Exit Function
        LowEmitMethodArgCvt(ctx, nodes[argNode].left, sig, argIdx)
    End If
    slot = LowNextArgBytes(ctx, sig, argIdx, useAddr, 0)
    If TyIs32() = 0 Then home = argIdx * TyPtrSize()
    LowEmitHomeStore(ctx->list, home, slot)
    home = home + slot
    LowEmitMethodArg = true
End Function

Function LowEmitMethodArgs(ctx As *LowerCtx, idx As Long, nArgs As Long) As boolean
    Dim nodes As *AstNode
    nodes = LowAstNodes(ctx)
    LowEmitMethodArgs = LowEmitMethodArgsFrom(ctx, nodes[idx].left, nArgs)
End Function

' argNode から nArgs - 1 個の実引数を This の後ろへ積む（仮引数の型は g_methSig の定義）
Function LowEmitMethodArgsFrom(ctx As *LowerCtx, argNode As Long, nArgs As Long) As boolean
    Dim sig(MANGLED_LEN - 1) As Byte
    Dim nodes As *AstNode
    Dim argIdx As Long
    Dim home As Long

    LowEmitMethodArgsFrom = false
    lstrcpy(VarPtr(sig), VarPtr(g_methSig))
    nodes = LowAstNodes(ctx)
    argIdx = 1
    home = TyPtrSize()
    While argIdx < nArgs
        If Not LowEmitMethodArg(ctx, argNode, VarPtr(sig), argIdx, home) Then Exit Function
        argIdx = argIdx + 1
        argNode = nodes[argNode].nxt
    Wend
    LowEmitMethodArgsFrom = true
End Function

Sub LowEmitMethodRegArgs(list As *IrList, nArgs As Long)
    Dim ps As Long
    If TyIs32() <> 0 Then Exit Sub
    ps = ABI_SLOT
    If nArgs >= 4 Then
        IrEmit(list, OP_LOAD_RSP_RAX, 3 * ps, 0)
        IrEmit(list, OP_MOV_R9_RAX, 0, 0)
    End If
    If nArgs >= 3 Then
        IrEmit(list, OP_LOAD_RSP_RAX, 2 * ps, 0)
        IrEmit(list, OP_MOV_R8_RAX, 0, 0)
    End If
    If nArgs >= 2 Then
        IrEmit(list, OP_LOAD_RSP_RAX, 1 * ps, 0)
        IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
    End If
End Sub

' 戻り値 true : 正常終了  false : エラーあり
Function LowEmitMethodThis(ctx As *LowerCtx, idx As Long) As boolean
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList

    LowEmitMethodThis = false
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    ' This: 値クラスはアドレス、*Class はポインタ値
    If LowRecvIsPtr(ctx, nodes[idx].right) <> 0 Then
        If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
    Else
        If LowAddr(ctx, nodes[idx].right) = 0 Then Exit Function
    End If
    IrEmit(list, OP_STORE_RSP_RAX, 0, 0)
    If TyIs32() = 0 Then
        IrEmit(list, OP_MOV_RCX_RAX, 0, 0)
    End If
    LowEmitMethodThis = true
End Function

Function LowExprCallMethod(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(LOW_STACK_PAD - 1) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim list As *IrList
    Dim nArgs As Long
    Dim typeTable As *TypeTable
    Dim typeIdx As Long
    Dim argIdx As Long
    Dim callBytes As Long

    LowExprCallMethod = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    typeTable = ast->types
    AstCopyStr(ast, idx, VarPtr(name))
    ' obj.Method(...) / p->Method(...) — right=receiver, left=user args, str=short name
    typeIdx = LowRecvClassTi(ctx, nodes[idx].right)
    If typeIdx < 0 Then
        LowerDiagError(ctx, idx, "method call on non-class '" + MakeStr(VarPtr(name)) + "'")
        ctx->err = 1
        Exit Function
    End If
    If AccCheckMethod(ctx, idx, typeIdx, VarPtr(name)) = 0 Then Exit Function
    nArgs = nodes[idx].num + 1
    If nArgs > LOW_MAX_ARGS Then
        ctx->err = 1
        Exit Function
    End If
    argIdx = LowCountCallArgs(ctx, idx, 1)
    If argIdx < 0 Or argIdx <> nArgs Then
        ctx->err = 1
        Exit Function
    End If
    LowSetMethodSig(ctx, idx, typeIdx)
    callBytes = LowMethodCallBytes(ctx, idx, nArgs)
    IrEmit(list, OP_SUB_RSP, callBytes, 0)
    ' user args 1..n-1 into home/stack; this (rcx) set last
    If Not LowEmitMethodArgs(ctx, idx, nArgs) Then Exit Function
    LowEmitMethodRegArgs(list, nArgs)
    If Not LowEmitMethodThis(ctx, idx) Then Exit Function
    If Not LowExprCallMethodInvoke(ctx, idx, typeIdx, nArgs, callBytes) Then Exit Function
    LowExprCallMethod = 1
End Function

' memcpy / fillmemory 相当の 3 引数 API 呼び出し。成功 1 / エラー -1
Function LowEmitMemOp3(ctx As *LowerCtx, idx As Long, api As *Byte) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList
    Dim a0 As Long
    Dim a1 As Long
    Dim a2 As Long
    Dim argIdx As Long
    Dim callBytes As Long

    LowEmitMemOp3 = -1
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    argIdx = LowCountCallArgs(ctx, idx, 0)
    If argIdx < 0 Or argIdx <> 3 Then
        ctx->err = 1
        Exit Function
    End If
    a0 = nodes[idx].left
    a1 = nodes[a0].nxt
    a2 = nodes[a1].nxt
    callBytes = LowCallBytes(3)
    If callBytes > 0 Then
        IrEmit(list, OP_SUB_RSP, callBytes, 0)
    End If
    If LowExpr(ctx, nodes[a0].left) = 0 Then Exit Function
    IrEmit(list, OP_STORE_RSP_RAX, 0, 0)
    If LowExpr(ctx, nodes[a1].left) = 0 Then Exit Function
    IrEmit(list, OP_STORE_RSP_RAX, TyPtrSize(), 0)
    If LowExpr(ctx, nodes[a2].left) = 0 Then Exit Function
    IrEmit(list, OP_STORE_RSP_RAX, TyPtrSize() + TyPtrSize(), 0)
    LowEmitLoadRegArgs(list, 3)
    IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, api)
    LowEmitCallFinish(list, callBytes)
    LowEmitMemOp3 = 1
End Function

Function LowExprCallMemOp(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(LOW_STACK_PAD - 1) As Byte
    Dim ast As *Ast
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim buf(TEXT_LEN - 1) As Byte
    Dim apiName(KW_LEN - 1) As Byte

    LowExprCallMemOp = -1
    ast = ctx->ast
    AstCopyStr(ast, idx, VarPtr(name))
    lstrcpy(VarPtr(buf), "memcpy")
    If LowIntrinNameEq(VarPtr(name), VarPtr(buf)) <> 0 Then
        lstrcpy(VarPtr(apiName), "RtlMoveMemory")
        LowExprCallMemOp = LowEmitMemOp3(ctx, idx, VarPtr(apiName))
        Exit Function
    End If
    lstrcpy(VarPtr(buf), "fillmemory")
    If LowIntrinNameEq(VarPtr(name), VarPtr(buf)) <> 0 Then
        lstrcpy(VarPtr(apiName), "RtlFillMemory")
        LowExprCallMemOp = LowEmitMemOp3(ctx, idx, VarPtr(apiName))
    End If
End Function

' AST_ARG を剥がして単一引数を評価
Function LowExprIntrinArg1(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim argNode As Long

    ast = ctx->ast
    nodes = ast->nodes
    argNode = nodes[idx].left
    If argNode >= 0 Then
        If nodes[argNode].kind = AST_ARG Then argNode = nodes[argNode].left
    End If
    LowExprIntrinArg1 = LowExpr(ctx, argNode)
End Function

Function LowExprCallIntrin(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(LOW_STACK_PAD - 1) As Byte
    Dim ast As *Ast
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim buf(TEXT_LEN - 1) As Byte
    Dim list As *IrList
    Dim r As Long

    LowExprCallIntrin = -1
    ast = ctx->ast
    list = ctx->list
    AstCopyStr(ast, idx, VarPtr(name))
    lstrcpy(VarPtr(buf), "free")
    If LowIntrinNameEq(VarPtr(name), VarPtr(buf)) <> 0 Then
        If LowExprIntrinArg1(ctx, idx) = 0 Then Exit Function
        LowEmitHeapFreeRax(list)
        LowExprCallIntrin = 1
        Exit Function
    End If
    lstrcpy(VarPtr(buf), "malloc")
    If LowIntrinNameEq(VarPtr(name), VarPtr(buf)) <> 0 Then
        If LowExprIntrinArg1(ctx, idx) = 0 Then Exit Function
        LowEmitHeapAllocRax(list, 0)
        LowExprCallIntrin = 1
        Exit Function
    End If
    lstrcpy(VarPtr(buf), "calloc")
    If LowIntrinNameEq(VarPtr(name), VarPtr(buf)) <> 0 Then
        ' calloc(n) → HeapAlloc(heap, HEAP_ZERO_MEMORY, n)
        If LowExprIntrinArg1(ctx, idx) = 0 Then Exit Function
        LowEmitHeapAllocRax(list, LOW_HEAP_ZERO)
        LowExprCallIntrin = 1
        Exit Function
    End If
    lstrcpy(VarPtr(buf), "realloc")
    If LowIntrinNameEq(VarPtr(name), VarPtr(buf)) <> 0 Then
        LowExprCallIntrin = LowExprCallRealloc(ctx, idx)
        Exit Function
    End If
    r = LowExprCallMemOp(ctx, idx)
    If ctx->err <> 0 Then Exit Function
    If r > 0 Then
        LowExprCallIntrin = r
    End If
End Function


Function LowExprCallFnPtrEmit(ctx As *LowerCtx, idx As Long, vOff As Long, vGlob As Long, nArgs As Long) As Long
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim list As *IrList
    Dim callBytes As Long

    LowExprCallFnPtrEmit = 0
    list = ctx->list
    AstCopyStr(ctx->ast, idx, VarPtr(name))
    callBytes = LowCallBytes(nArgs)
    If callBytes > 0 Then IrEmit(list, OP_SUB_RSP, callBytes, 0)
    If Not LowEmitCallArgHomes(ctx, idx, nArgs, 0, 0, VarPtr(name)) Then Exit Function
    LowEmitLoadRegArgs(list, nArgs)
    LowEmitLoadOff(list, vOff, vGlob)
    IrEmit(list, OP_CALL_RAX, 0, 0)
    LowEmitCallFinish(list, callBytes)
    LowExprCallFnPtrEmit = 1
End Function

Function LowExprCallFnPtr(ctx As *LowerCtx, idx As Long, vOff As Long, vGlob As Long) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nArgs As Long

    LowExprCallFnPtr = 0
    ast = ctx->ast
    nodes = ast->nodes
    nArgs = nodes[idx].num
    If nArgs > LOW_MAX_ARGS Then
        ctx->err = 1
        Exit Function
    End If
    LowExprCallFnPtr = LowExprCallFnPtrEmit(ctx, idx, vOff, vGlob, nArgs)
End Function

Function LowExprCallArrLoad(ctx As *LowerCtx, idx As Long, vTy As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList

    LowExprCallArrLoad = 0
    ast = ctx->ast
    nodes = ast->nodes
    list = ctx->list
    If nodes[idx].num < 1 Or nodes[idx].num > ARR_RANK_MAX Then Exit Function
    If vTy = TY_BYTE_ARR Then
        If LowAddr(ctx, idx) = 0 Then Exit Function
        IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
        LowExprCallArrLoad = 1
    ElseIf vTy = TY_LONG_ARR Then
        If LowAddr(ctx, idx) = 0 Then Exit Function
        IrEmit(list, OP_LOAD_DWORD_RAX, 0, 0)
        LowExprCallArrLoad = 1
    ElseIf vTy = TY_WORD_ARR Then
        If LowAddr(ctx, idx) = 0 Then Exit Function
        IrEmit(list, OP_LOADZX_WORD_RAX, 0, 0)
        LowExprCallArrLoad = 1
    ElseIf vTy = TY_DOUBLE_ARR Then
        If LowAddr(ctx, idx) = 0 Then Exit Function
        LowLoadWide(list)
        LowExprCallArrLoad = 1
    ElseIf vTy = TY_SINGLE_ARR Then
        If LowAddr(ctx, idx) = 0 Then Exit Function
        IrEmit(list, OP_LOAD_DWORD_RAX, 0, 0)
        LowExprCallArrLoad = 1
    ElseIf LowIsPtrSlot(vTy) <> 0 Then
        If LowAddr(ctx, idx) = 0 Then Exit Function
        IrEmit(list, OP_LOAD_PTR, 0, 0)
        LowExprCallArrLoad = 1
    End If
End Function

Function LowExprCallArr(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(LOW_STACK_PAD - 1) As Byte
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim nArgs As Long

    LowExprCallArr = 0
    ast = ctx->ast
    nodes = ast->nodes
    nArgs = nodes[idx].num
    AstCopyStr(ast, idx, VarPtr(name))
    If Not LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) Then Exit Function
    If vTy = TY_PTR_FUNC Then
        LowExprCallArr = LowExprCallFnPtr(ctx, idx, vOff, vGlob)
        Exit Function
    End If
    If LowIsArrTy(vTy) Then
        If LowArrIdxOk(vTy, vTypeIdx, nArgs) = 0 Then
            LowerDiagError(ctx, idx, "bad array index count '" + MakeStr(VarPtr(name)) + "'")
            Exit Function
        End If
    End If
    LowExprCallArr = LowExprCallArrLoad(ctx, idx, vTy)
End Function



' 戻り値 true : 正常終了  false : エラーあり
' name を定義しているクラス（自分か継承元）。見つからなければ typeIdx のまま
Function LowMethodDefTi(typeIdx As Long, name As *Byte) As Long
    Dim acc As Long
    LowMethodDefTi = AccMethOwner(typeIdx, name, acc)
    If LowMethodDefTi < 0 Then LowMethodDefTi = typeIdx
End Function

Function LowExprCallMethodInvoke(ctx As *LowerCtx, idx As Long, typeIdx As Long, nArgs As Long, callBytes As Long) As boolean
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim buf(TEXT_LEN - 1) As Byte
    Dim list As *IrList
    Dim lab As Long
    Dim vals As *Long
    Dim typeTable As *TypeTable
    Dim j As Long
    Dim names As *Byte
    Dim ast As *Ast

    LowExprCallMethodInvoke = false
    ast = ctx->ast
    list = ctx->list
    typeTable = ast->types
    AstCopyStr(ast, idx, VarPtr(name))
    j = typeIdx * TYNAME_LEN
    names = typeTable->typeNames
    lab = -1
    vals = typeTable->typeVirtCount
    If vals[typeIdx] > 0 Then
        lab = TyFindVirt(typeTable, typeIdx, VarPtr(name))
    End If
    If lab >= 0 Then
        ' COM / Virtual: call [ [*this] + slot*8 ]
        IrEmit(list, OP_LOAD_PTR, 0, 0)
        If lab <> 0 Then
            IrEmit(list, OP_ADD_RAX_IMM, lab * TyPtrSize(), 0)
        End If
        IrEmit(list, OP_LOAD_PTR, 0, 0)
        IrEmit(list, OP_CALL_RAX, 0, 0)
    Else
        ' 継承元で定義したメソッドは、定義したクラスの名前で呼ぶ
        j = LowMethodDefTi(typeIdx, VarPtr(name)) * TYNAME_LEN
        LowMangleClass(VarPtr(names[j]), VarPtr(name), VarPtr(buf))
        lab = LowFindFunc(ctx, VarPtr(buf))
        If lab < 0 Then
            LowPrintErr("error: unknown method '" + MakeStr(VarPtr(buf)) + "'")
            ctx->err = 1
            Exit Function
        End If
        IrEmit(list, OP_CALL_LAB, lab, 0)
    End If
    LowEmitCallFinish(list, callBytes)

    LowExprCallMethodInvoke = true
End Function
