' ParserAssignStmt - Const と代入文

Function ParseConstString(p As *Parser, name As *Byte) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nConst As Long
    Dim nStr As Long
    Dim s(TEXT_LEN - 1) As Byte

    ParseConstString = -1
    ast = p->ast
    If Not ParseStringArg(p, VarPtr(s)) Then Exit Function
    nStr = AstAddNode(ast, AST_STRING)
    If nStr < 0 Then Exit Function
    AstSetStr(ast, nStr, VarPtr(s))
    nConst = AstAddNode(ast, AST_CONST)
    If nConst < 0 Then Exit Function
    AstSetStr(ast, nConst, name)
    nodes = ast->nodes
    nodes[nConst].num = 0
    nodes[nConst].left = nStr
    nodes[nConst].extra = 1
    ParseConstString = nConst
End Function

Function ParseConstExprFill(ast As *Ast, nConst As Long, name As *Byte, e As Long) As Long
    Dim nodes As *AstNode
    AstSetStr(ast, nConst, name)
    nodes = ast->nodes
    nodes[nConst].num = 0
    nodes[nConst].left = e
    nodes[nConst].extra = AST_CONST_EXTRA_EXPR
    ParseConstExprFill = nConst
End Function

Function ParseConstExprNode(p As *Parser, name As *Byte, e As Long) As Long
    Dim ast As *Ast
    Dim nConst As Long
    ParseConstExprNode = -1
    ast = p->ast
    nConst = AstAddNode(ast, AST_CONST)
    If nConst < 0 Then Exit Function
    ParseConstExprNode = ParseConstExprFill(ast, nConst, name, e)
End Function

Function ParseConstExpr(p As *Parser, name As *Byte) As Long
    Dim e As Long
    ParseConstExpr = -1
    e = ParseExprNoAs(p)
    If e < 0 Then Exit Function
    ParseConstExpr = ParseConstExprNode(p, name, e)
End Function

Function ParseConstRhs(p As *Parser, name As *Byte) As Long
    If ParseTokKind(p) = TK_STRING Then
        ParseConstRhs = ParseConstString(p, name)
        Exit Function
    End If
    ParseConstRhs = ParseConstExpr(p, name)
End Function

Function ParseConstHead(p As *Parser, name As *Byte) As Long
    ParseConstHead = 0
    p->pos = p->pos + 1
    If Not ParseCopyIdent(p, name) Then Exit Function
    ParseConstHead = 1
End Function

Function ParseConstEq(p As *Parser, name As *Byte) As Long
    ParseConstEq = -1
    If Not ParseExpect(p, TK_EQ) Then Exit Function
    ParseConstEq = ParseConstRhs(p, name)
End Function

Function ParseConstStmt(p As *Parser) As Long
    Dim name(SYM_NAME_LEN - 1) As Byte
    ParseConstStmt = -1
    If ParseConstHead(p, VarPtr(name)) = 0 Then Exit Function
    If ParseTokKind(p) <> TK_LPAREN Then ParseConstStmt = ParseConstEq(p, VarPtr(name))
    If ParseTokKind(p) = TK_LPAREN Then ParseConstStmt = ParseConstMacro(p, VarPtr(name))
End Function

Function ParseAssignWithDot(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nIdx As Long
    Dim nAsg As Long
    Dim e As Long

    ParseAssignWithDot = -1
    If p->withExprIdx < 0 Then
        p->err = 1
        Exit Function
    End If
    g_withSave = p->withExprIdx
    nIdx = ParseWithLval(p)
    p->withExprIdx = g_withSave
    If nIdx < 0 Then Exit Function
    ast = p->ast
    nodes = ast->nodes
    If nodes[nIdx].kind = AST_CALL Then
        ParseAssignWithDot = nIdx
        Exit Function
    End If
    If Not ParseExpect(p, TK_EQ) Then Exit Function
    e = ParseExpr(p)
    If e < 0 Then Exit Function
    nAsg = AstAddNode(ast, AST_ASSIGN)
    If nAsg < 0 Then Exit Function
    nodes = ast->nodes
    nodes[nAsg].left = nIdx
    nodes[nAsg].right = e
    ParseAssignWithDot = nAsg
End Function

Function ParseAssignMemberLhs(p As *Parser, name As *Byte) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nVar As Long
    Dim nIdx As Long
    Dim n As Long

    ParseAssignMemberLhs = -1
    ast = p->ast
    nVar = AstAddNode(ast, AST_VAR)
    If nVar < 0 Then Exit Function
    AstSetStr(ast, nVar, name)
    nIdx = ParsePostfixMemIdx(p, nVar)
    If nIdx < 0 Then Exit Function
    n = ParseMemberCall(p, nIdx)
    If n < 0 Then Exit Function
    nodes = ast->nodes
    If nodes[n].kind = AST_CALL Then
        ParseAssignMemberLhs = n
        Exit Function
    End If
    ParseAssignMemberLhs = ParseAssignOpRhs(p, n)
End Function

Function ParseAssignIndexLhs(p As *Parser, name As *Byte) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nVar As Long
    Dim nIdx As Long
    Dim nCall As Long
    Dim head As Long
    Dim nArgs As Long
    Dim idLine As Long
    Dim mem(SYM_NAME_LEN - 1) As Byte

    ParseAssignIndexLhs = -1
    ast = p->ast
    idLine = ParseTokLine(p)
    p->pos = p->pos + 1
    head = ParseIdxExprs(p, nArgs)
    If head < 0 Then Exit Function
    If Not ParseExpect(p, TK_RBRACK) Then Exit Function
    If nArgs >= 3 Then
        nIdx = ParseIdxCall(ast, name, head, nArgs)
        If nIdx < 0 Then Exit Function
    Else
        nVar = AstAddNode(ast, AST_VAR)
        If nVar < 0 Then Exit Function
        AstSetStr(ast, nVar, name)
        nIdx = AstAddNode(ast, AST_INDEX)
        If nIdx < 0 Then Exit Function
        nodes = ast->nodes
        nodes[nIdx].left = nVar
        nodes[nIdx].right = nodes[head].left
        nodes[nIdx].extra = -1
        If nArgs = 2 Then nodes[nIdx].extra = ParseIdxSecond(ast, head)
        nodes[nIdx].num = 1
    End If
    AstSetSrcLine(ast, nIdx, idLine)
    If ParseTokKind(p) = TK_DOT Then
        p->pos = p->pos + 1
        If Not ParseCopyIdent(p, VarPtr(mem)) Then Exit Function
        nCall = AstAddNode(ast, AST_MEMBER)
        If nCall < 0 Then Exit Function
        AstSetStr(ast, nCall, VarPtr(mem))
        nodes = ast->nodes
        nodes[nCall].left = nIdx
        nodes[nCall].num = 0
        AstSetSrcLine(ast, nCall, idLine)
        nIdx = nCall
    End If
    ParseAssignIndexLhs = ParseAssignOpRhs(p, nIdx)
End Function

Function ParseAssignParen(p As *Parser, name As *Byte) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nVar As Long
    Dim nIdx As Long
    Dim nCall As Long
    Dim arg0 As Long
    Dim nArgs As Long
    Dim idLine As Long

    ParseAssignParen = -1
    ast = p->ast
    idLine = ParseTokLine(p)
    p->pos = p->pos + 1
    If ParseArgList(p, arg0, nArgs) = 0 Then Exit Function
    If ParseIsAssignOpAhead(p) Then
        If nArgs < 1 Or nArgs > ARR_RANK_MAX Then
            If nArgs > ARR_RANK_MAX Then
                ParseFail(p, "array rank exceeds " + Str$(ARR_RANK_MAX))
            Else
                ParseFail(p, "bad array index count")
            End If
            Exit Function
        End If
        If nArgs >= 2 Then
            nCall = AstAddNode(ast, AST_CALL)
            If nCall < 0 Then Exit Function
            AstSetStr(ast, nCall, name)
            nodes = ast->nodes
            nodes[nCall].left = arg0
            nodes[nCall].right = -1
            nodes[nCall].extra = -1
            nodes[nCall].num = nArgs
            AstSetSrcLine(ast, nCall, idLine)
            ParseAssignParen = ParseAssignOpRhs(p, nCall)
            Exit Function
        End If
        nVar = AstAddNode(ast, AST_VAR)
        If nVar < 0 Then Exit Function
        AstSetStr(ast, nVar, name)
        nIdx = AstAddNode(ast, AST_INDEX)
        If nIdx < 0 Then Exit Function
        nodes = ast->nodes
        nodes[nIdx].left = nVar
        nodes[nIdx].right = nodes[arg0].left
        nodes[nIdx].num = 0
        AstSetSrcLine(ast, nIdx, idLine)
        ParseAssignParen = ParseAssignOpRhs(p, nIdx)
        Exit Function
    End If
    nCall = AstAddNode(ast, AST_CALL)
    If nCall < 0 Then Exit Function
    AstSetStr(ast, nCall, name)
    nodes = ast->nodes
    nodes[nCall].left = arg0
    nodes[nCall].right = -1
    nodes[nCall].num = nArgs
    AstSetSrcLine(ast, nCall, idLine)
    ParseAssignParen = nCall
End Function

Function ParseLetNext(p As *Parser) As Long
    Dim n As Long
    n = ParseTokKindAt(p, p->pos + 1)
    ParseLetNext = 0
    If n = TK_IDENT Or n = TK_DOT Then ParseLetNext = 1
End Function

Function ParseSkipLet(p As *Parser) As Long
    Dim k(KW_SHORT_LEN - 1) As Byte
    ParseSkipLet = 0
    lstrcpy(VarPtr(k), "let")
    If ParseIdentIs(p, VarPtr(k)) = 0 Then Exit Function
    If ParseLetNext(p) = 0 Then Exit Function
    p->pos = p->pos + 1
    ParseSkipLet = 1
End Function

Function ParsePrevLine(p As *Parser) As Long
    Dim lx As *Lexer
    Dim toks As *Tok
    lx = p->lx
    toks = lx->toks
    ParsePrevLine = toks[p->pos - 1].srcLine
End Function

Function ParseAssignIfOp(p As *Parser, name As *Byte) As Long
    Dim nVar As Long
    ParseAssignIfOp = -2
    If Not ParseIsAssignOpAhead(p) Then Exit Function
    nVar = ParseClassIdentExpr(p, name)
    ParseAssignIfOp = -1
    If nVar < 0 Then Exit Function
    ParseAssignIfOp = ParseAssignOpRhs(p, nVar)
End Function

Function ParseBareCall(p As *Parser, name As *Byte, srcLn As Long) As Long
    ParseBareCall = -1
    If ParseCmdGather(p, srcLn, 16) = 0 Then Exit Function
    lstrcpy(VarPtr(g_cmdFn), name)
    ParseBareCall = ParseCallFn(p)
End Function

Function ParseAssignOrCall(p As *Parser, name As *Byte) As Long
    ParseAssignOrCall = ParseAssignIfOp(p, name)
    If ParseAssignOrCall <> -2 Then Exit Function
    ParseAssignOrCall = ParseBareCall(p, name, ParsePrevLine(p))
End Function

Function ParseAssignMem(p As *Parser, name As *Byte) As Long
    ParseAssignMem = -2
    If ParseTokKind(p) <> TK_DOT And ParseTokKind(p) <> TK_ARROW Then Exit Function
    If ParseIsSuper(name) <> 0 And ParseTokKind(p) = TK_DOT Then
        ParseAssignMem = ParseSuperCall(p)
        Exit Function
    End If
    ParseAssignMem = ParseAssignMemberLhs(p, name)
End Function

Function ParseAssignBracket(p As *Parser, name As *Byte) As Long
    ParseAssignBracket = -2
    If ParseTokKind(p) = TK_LBRACK Then ParseAssignBracket = ParseAssignIndexLhs(p, name)
    If ParseAssignBracket <> -2 Then Exit Function
    If ParseTokKind(p) = TK_LPAREN Then ParseAssignBracket = ParseAssignParen(p, name)
End Function

Function ParseAssignIndexOr(p As *Parser, name As *Byte) As Long
    ParseAssignIndexOr = ParseAssignMem(p, name)
    If ParseAssignIndexOr <> -2 Then Exit Function
    ParseAssignIndexOr = ParseAssignBracket(p, name)
    If ParseAssignIndexOr <> -2 Then Exit Function
    ParseAssignIndexOr = ParseAssignOrCall(p, name)
End Function

' 文頭の予約語（Line など）。代入にはしない。
Function ParseHitKw(name As *Byte, lit As String) As Long
    ParseHitKw = 0
    If ByteStrEqCI(lit, name) Then ParseHitKw = 1
End Function

Function ParseIsReservedA(name As *Byte) As Long
    ParseIsReservedA = 1
    If ParseHitKw(name, "line") <> 0 Then Exit Function
    If ParseHitKw(name, "circle") <> 0 Then Exit Function
    If ParseHitKw(name, "paint") <> 0 Then Exit Function
    If ParseHitKw(name, "color") <> 0 Then Exit Function
    ParseIsReservedA = 0
End Function

Function ParseIsReservedB(name As *Byte) As Long
    ParseIsReservedB = 1
    If ParseHitKw(name, "locate") <> 0 Then Exit Function
    If ParseHitKw(name, "pset") <> 0 Then Exit Function
    If ParseHitKw(name, "beep") <> 0 Then Exit Function
    If ParseHitKw(name, "cls") <> 0 Then Exit Function
    If ParseHitKw(name, "preset") <> 0 Then Exit Function
    ParseIsReservedB = 0
End Function

Function ParseIsReservedCmd(name As *Byte) As Long
    ParseIsReservedCmd = ParseIsReservedA(name)
    If ParseIsReservedCmd <> 0 Then Exit Function
    ParseIsReservedCmd = ParseIsReservedB(name)
End Function

Sub ParseLowerWord(dst As *Byte)
    Dim i As Long
    Dim c As Long
    i = 0
    While dst[i] <> 0
        c = ToLowerChar(dst[i])
        dst[i] = c As Byte
        i = i + 1
    Wend
End Sub

Sub ParseCap0(dst As *Byte)
    Dim c As Long
    If dst[0] < CH_La Then Exit Sub
    If dst[0] > CH_Lz Then Exit Sub
    c = dst[0] - CH_La + CH_A
    dst[0] = c As Byte
End Sub

Sub ParseCanonKw(name As *Byte, dst As *Byte)
    lstrcpy(dst, name)
    ParseLowerWord(dst)
    ParseCap0(dst)
End Sub

Function ParseQuote$() As String
    Dim b(1) As Byte
    b[0] = CH_DQUOTE
    b[1] = CH_NUL
    ParseQuote$ = MakeStr(VarPtr(b))
End Function

Function ParseReservedMsg$(name As *Byte) As String
    Dim shown(KW_LEN - 1) As Byte
    Dim q As String
    ParseCanonKw(name, VarPtr(shown))
    q = ParseQuote$()
    ParseReservedMsg$ = q + MakeStr(VarPtr(shown)) + q + " のパラメータ指定が間違っています"
End Function

Function ParseReservedAsgn(p As *Parser, name As *Byte) As Long
    ParseReservedAsgn = 0
    If ParseTokKind(p) <> TK_EQ Then Exit Function
    If ParseIsReservedCmd(name) = 0 Then Exit Function
    ParseFail(p, ParseReservedMsg$(name))
    ParseReservedAsgn = 1
End Function

Function ParseAssignNamed(p As *Parser) As Long
    Dim name(SYM_NAME_LEN - 1) As Byte
    ParseAssignNamed = -1
    If Not ParseCopyIdent(p, VarPtr(name)) Then Exit Function
    If ParseReservedAsgn(p, VarPtr(name)) <> 0 Then Exit Function
    ParseAssignNamed = ParseAssignIndexOr(p, VarPtr(name))
End Function

Function ParseAssignStmt(p As *Parser) As Long
    ParseAssignStmt = -1
    ParseSkipLet(p)
    If ParseTokKind(p) = TK_DOT Then
        ParseAssignStmt = ParseAssignWithDot(p)
        Exit Function
    End If
    ParseAssignStmt = ParseAssignNamed(p)
End Function
