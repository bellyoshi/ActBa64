' ===================================================
'  Compiler - source -> Lexer -> AST -> IR -> PE
' ===================================================

Sub CompFreePe(codeMem As *Byte, idataBuf As *Byte, builder As *ImportBuilder)
    If codeMem <> NULL Then free(codeMem)
    If idataBuf <> NULL Then free(idataBuf)
    If builder <> NULL Then IbFree(builder)
End Sub

Function CompCodeCap() As Long
    Dim codeCap As Long
    Dim capI As Long
    codeCap = 0
    capI = 0
    While capI < 8
        AddTo(codeCap, 1048576)
        capI = capI + 1
    Wend
    CompCodeCap = codeCap
End Function

Function CompAllocScratch(ByRef builder As *ImportBuilder, ByRef idataBuf As *Byte, ByRef codeMem As *Byte) As Long
    CompAllocScratch = 0
    builder = calloc(SizeOf(ImportBuilder))
    If builder = NULL Then
        Print "error: out of memory (import builder)"
        Exit Function
    End If
    IbInit(builder)
    idataBuf = calloc(1048576)
    If idataBuf = NULL Then
        Print "error: out of memory (.idata)"
        IbFree(builder)
        builder = NULL
        Exit Function
    End If
    codeMem = calloc(CompCodeCap())
    If codeMem = NULL Then
        Print "error: out of memory (.text)"
        free(idataBuf)
        idataBuf = NULL
        IbFree(builder)
        builder = NULL
        Exit Function
    End If
    CompAllocScratch = 1
End Function

Function CompEmitOnce(list As *IrList, cb As *CodeBuffer, builder As *ImportBuilder, dataRva As DWord) As Long
    cb->size = 0
    If TyIs32() <> 0 Then
        IrEmitCode32(list, cb, builder, dataRva)
    Else
        IrEmitCode(list, cb, builder, dataRva)
    End If
    If cb->size >= cb->capacity Then
        Print "error: code too large"
        CompEmitOnce = 0
    Else
        CompEmitOnce = 1
    End If
End Function

Function CompWritePe(outPath As *Byte, codeMem As *Byte, codeSize As Long, globSize As Long, idataBuf As *Byte, idataSize As DWord, builder As *ImportBuilder, subsystem As Long) As Long
    CompWritePe = 0
    If TyIs32() <> 0 Then
        CompWritePe = WritePe32(outPath, codeMem, codeSize, globSize, idataBuf, idataSize, builder, subsystem)
    Else
        CompWritePe = WritePe64(outPath, codeMem, codeSize, globSize, idataBuf, idataSize, builder, subsystem)
    End If
    If CompWritePe = 0 Then
        Print "error: cannot write: " + MakeStr(outPath)
    End If
End Function

Function CompileIrToPe(list As *IrList, outPath As *Byte, subsystem As Long) As Long
    Dim builder As *ImportBuilder
    Dim idataBuf As *Byte
    Dim idataSize As DWord
    Dim codeMem As *Byte
    Dim cb As CodeBuffer
    Dim textVirt As DWord
    Dim dataVirt As DWord
    Dim dataRva As DWord
    Dim idataRva As DWord

    CompileIrToPe = 0
    If CompAllocScratch(builder, idataBuf, codeMem) = 0 Then Exit Function
    IrCollect(list, builder)
    cb.buf = codeMem
    cb.capacity = CompCodeCap()
    dataVirt = AlignUp(list->globSize, SECTION_ALIGN)
    If dataVirt < SECTION_ALIGN Then dataVirt = SECTION_ALIGN
    IbFinalize(builder, IDATA_RVA, idataBuf, idataSize)
    If CompEmitOnce(list, VarPtr(cb), builder, TEXT_RVA + SECTION_ALIGN) = 0 Then
        CompFreePe(codeMem, idataBuf, builder)
        Exit Function
    End If
    textVirt = AlignUp(cb.size, SECTION_ALIGN)
    dataRva = TEXT_RVA
    dataRva = dataRva + textVirt
    idataRva = dataRva
    idataRva = idataRva + dataVirt
    IbFinalize(builder, idataRva, idataBuf, idataSize)
    If CompEmitOnce(list, VarPtr(cb), builder, dataRva) = 0 Then
        CompFreePe(codeMem, idataBuf, builder)
        Exit Function
    End If
    If AlignUp(cb.size, SECTION_ALIGN) <> textVirt Then
        Print "error: code size unstable between emit passes"
        CompFreePe(codeMem, idataBuf, builder)
        Exit Function
    End If
    CompileIrToPe = CompWritePe(outPath, codeMem, cb.size, list->globSize, idataBuf, idataSize, builder, subsystem)
    CompFreePe(codeMem, idataBuf, builder)
End Function

Function CompileSource(src As *Byte, outPath As *Byte, useWindow As Long) As Long
    Dim ast As *Ast
    Dim list As *IrList
    Dim subsystem As Long

    CompileSource = 0
    g_compileStrict = PpSourceHasStrict(src)

    ast = AstCreate(AST_MAX_NODES)
    If ast = NULL Then
        Print "error: out of memory (ast)"
        Exit Function
    End If
    If ParseSource(src, ast) = 0 Then
        AstFree(ast)
        Exit Function
    End If

    list = IrCreate(IR_MAX_OPS)
    If list = NULL Then
        Print "error: out of memory (ir)"
        AstFree(ast)
        Exit Function
    End If

    subsystem = IMAGE_SUBSYSTEM_WINDOWS_CUI
    If AstToIr(ast, list, subsystem) = 0 Then
        If DiagErrorCount() > 0 Then
            DiagPrintAll()
            DiagPrintSummary()
        Else
            Print "error: codegen failed (AstToIr)"
        End If
        IrFree(list)
        AstFree(ast)
        Exit Function
    End If
    If DiagWarnCount() > 0 Then
        DiagPrintAll()
        DiagPrintSummary()
    End If
    If useWindow <> 0 Then subsystem = IMAGE_SUBSYSTEM_WINDOWS_GUI

    If CompileIrToPe(list, outPath, subsystem) <> 0 Then
        CompileSource = 1
    End If

    IrFree(list)
    AstFree(ast)
End Function

Function CompileFile(srcPath As *Byte, outPath As *Byte) As Long
    Dim src As *Byte
    Dim srcSize As Long
    Dim cond As *Byte
    Dim condSize As Long
    Dim expanded As *Byte
    Dim full As *Byte

    CompileFile = 0
    If PpStateInit() = 0 Then
        Print "error: out of memory (preproc)"
        Exit Function
    End If
    src = LoadFile(srcPath, srcSize)
    If src = NULL Then
        Print "error: cannot open: " + MakeStr(srcPath)
        PpStateFree()
        Exit Function
    End If
    If srcSize <= 0 Then
        Print "error: empty source: " + MakeStr(srcPath)
        free(src)
        PpStateFree()
        Exit Function
    End If

    cond = PpApplyConditionals(src, srcSize)
    free(src)
    If cond = NULL Then
        Print "error: conditional preprocess failed: " + MakeStr(srcPath)
        PpStateFree()
        Exit Function
    End If
    condSize = 0
    While cond[condSize] <> 0
        condSize = condSize + 1
    Wend
    PpOnceReset()
    expanded = ExpandIncludes(cond, condSize, srcPath)
    free(cond)
    If expanded = NULL Then
        Print "error: preprocess failed: " + MakeStr(srcPath)
        PpStateFree()
        Exit Function
    End If

    full = PpPrependDefaults(expanded)
    free(expanded)
    If full = NULL Then
        Print "error: preprocess failed: " + MakeStr(srcPath)
        PpStateFree()
        Exit Function
    End If

    CompileFile = CompileSource(full, outPath, g_ppUseWindow)
    free(full)
    PpStateFree()
End Function

Function CompilePj(pjPath As *Byte, outPath As *Byte) As Long
    Dim combined As *Byte
    Dim full As *Byte

    CompilePj = 0
    If PpStateInit() = 0 Then
        Print "error: out of memory (preproc)"
        Exit Function
    End If
    combined = CombinePjSources(pjPath)
    If combined = NULL Then
        Print "error: cannot load project: " + MakeStr(pjPath)
        PpStateFree()
        Exit Function
    End If

    full = PpPrependDefaults(combined)
    free(combined)
    If full = NULL Then
        Print "error: preprocess failed: " + MakeStr(pjPath)
        PpStateFree()
        Exit Function
    End If

    CompilePj = CompileSource(full, outPath, g_ppUseWindow)
    free(full)
    PpStateFree()
End Function

Function CompileInput(srcPath As *Byte, outPath As *Byte) As Long
    If PpPathEndsWithPj(srcPath) <> 0 Then
        CompileInput = CompilePj(srcPath, outPath)
    Else
        CompileInput = CompileFile(srcPath, outPath)
    End If
End Function
