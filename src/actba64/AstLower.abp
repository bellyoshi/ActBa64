Function LowToLower(c As Long) As Long
    If c >= 65 And c <= 90 Then
        LowToLower = c + 32
    Else
        LowToLower = c
    End If
End Function

Function LowNameEq(a As *Byte, b As *Byte) As Long
    Dim i As Long
    LowNameEq = 0
    i = 0
    Do
        If LowToLower(a[i]) <> LowToLower(b[i]) Then Exit Function
        If a[i] = 0 Then
            LowNameEq = 1
            Exit Function
        End If
        i = i + 1
    Loop
End Function

' 組み込みランタイム呼び出し（FillMemory / malloc 等）— 綴りは大小無視
Function LowIntrinNameEq(name As *Byte, canon As *Byte) As Long
    LowIntrinNameEq = ByteNameEqCI(name, canon)
End Function

Function LowNameEqExact(a As *Byte, b As *Byte) As Long
    Dim i As Long
    LowNameEqExact = 0
    i = 0
    Do
        If a[i] <> b[i] Then Exit Function
        If a[i] = 0 Then
            LowNameEqExact = 1
            Exit Function
        End If
        i = i + 1
    Loop
End Function

Function LowFindSym(ctx As *LowerCtx, name As *Byte) As Long
    Dim i As Long
    Dim names As *Byte
    Dim off As Long
    LowFindSym = -1
    names = ctx->names
    i = 0
    While i < ctx->symCount
        off = i * SYM_NAME_LEN
        If LowNameEqExact(VarPtr(names[off]), name) <> 0 Then
            LowFindSym = i
            Exit Function
        End If
        i = i + 1
    Wend
End Function

Sub LowAddSymRoots(isByRef As Long, ty As Long, off As Long, sz As Long)
    If isByRef = 0 Then
        If ty = TY_STRING Then
            LowAppendFnPreciseRoot(off)
        ElseIf ty = TY_STRING_ARR Then
            LowAppendFnPreciseStringArr(off, sz)
        End If
    End If
End Sub

Function LowAddSym(ctx As *LowerCtx, name As *Byte, ty As Long, nbytes As Long, typeIdx As Long, isByRef As Long) As Long
    Dim i As Long
    Dim names As *Byte
    Dim offs As *Long
    Dim types As *Long
    Dim typeIdxs As *Long
    Dim byRefs As *Long
    Dim j As Long
    Dim off As Long
    Dim sz As Long

    LowAddSym = -1
    i = LowFindSym(ctx, name)
    If i >= 0 Then
        LowAddSym = i
        Exit Function
    End If
    If LowEnsureSymCap(ctx) = 0 Then
        Print "error: out of memory (locals/syms)"
        ctx->err = 1
        Exit Function
    End If
    i = ctx->symCount
    names = ctx->names
    offs = ctx->offs
    types = ctx->types
    typeIdxs = ctx->typeIdxs
    byRefs = ctx->byRefs
    off = i * SYM_NAME_LEN
    j = 0
    While name[j] <> 0 And j < SYM_NAME_LEN - 1
        names[off + j] = name[j]
        j = j + 1
    Wend
    names[off + j] = 0
    sz = nbytes
    sz = TySlotAlign(sz)
    ctx->frameUsed = ctx->frameUsed + sz
    offs[i] = 0 - ctx->frameUsed
    types[i] = ty
    typeIdxs[i] = typeIdx
    byRefs[i] = isByRef
    ctx->symCount = i + 1
    LowAddSymRoots(isByRef, ty, offs[i], sz)
    LowAddSym = i
End Function

Function LowFindGlob(ctx As *LowerCtx, name As *Byte) As Long
    Dim i As Long
    Dim names As *Byte
    Dim off As Long
    LowFindGlob = -1
    names = g_gNames
    If names = NULL Then Exit Function
    i = 0
    While i < g_gCount
        off = i * SYM_NAME_LEN
        If LowNameEqExact(VarPtr(names[off]), name) <> 0 Then
            LowFindGlob = i
            Exit Function
        End If
        i = i + 1
    Wend
End Function

Function LowAddGlob(ctx As *LowerCtx, name As *Byte, ty As Long, nbytes As Long, typeIdx As Long) As Long
    Dim i As Long
    Dim names As *Byte
    Dim offs As *Long
    Dim types As *Long
    Dim typeIdxs As *Long
    Dim j As Long
    Dim off As Long
    Dim sz As Long

    LowAddGlob = -1
    i = LowFindGlob(ctx, name)
    If i >= 0 Then
        LowAddGlob = i
        Exit Function
    End If
    If LowEnsureGCap(ctx) = 0 Then
        Print "error: out of memory (globals)"
        ctx->err = 1
        Exit Function
    End If
    i = g_gCount
    names = g_gNames
    offs = g_gOffs As *Long
    types = g_gTypes As *Long
    typeIdxs = g_gTypeIdxs As *Long
    off = i * SYM_NAME_LEN
    j = 0
    While name[j] <> 0 And j < SYM_NAME_LEN - 1
        names[off + j] = name[j]
        j = j + 1
    Wend
    names[off + j] = 0
    sz = nbytes
    sz = TySlotAlign(sz)
    offs[i] = g_gSize
    g_gSize = g_gSize + sz
    types[i] = ty
    typeIdxs[i] = typeIdx
    g_gNbytes[i] = sz
    g_gCount = i + 1
    LowAddGlob = i
End Function

' Resolve name: locals first, then module globals.
' Out params as *Byte (self-host parser rejects *Long params); cast to *Long locally.
Function LowLookupVar(ctx As *LowerCtx, name As *Byte, oOffB As *Byte, oTyB As *Byte, oTiB As *Byte, oBrB As *Byte, oGlB As *Byte) As Long
    Dim si As Long
    Dim offs As *Long
    Dim types As *Long
    Dim typeIdxs As *Long
    Dim byRefs As *Long
    Dim oOff As *Long
    Dim oTy As *Long
    Dim oTi As *Long
    Dim oBr As *Long
    Dim oGl As *Long

    oOff = oOffB As *Long
    oTy = oTyB As *Long
    oTi = oTiB As *Long
    oBr = oBrB As *Long
    oGl = oGlB As *Long
    LowLookupVar = 0
    oGl[0] = 0
    oBr[0] = 0
    oOff[0] = 0
    oTy[0] = 0
    oTi[0] = -1
    si = LowFindSym(ctx, name)
    If si >= 0 Then
        offs = ctx->offs
        types = ctx->types
        typeIdxs = ctx->typeIdxs
        byRefs = ctx->byRefs
        oOff[0] = offs[si]
        oTy[0] = types[si]
        oTi[0] = typeIdxs[si]
        oBr[0] = byRefs[si]
        LowLookupVar = 1
        Exit Function
    End If
    si = LowFindGlob(ctx, name)
    If si >= 0 Then
        offs = g_gOffs As *Long
        types = g_gTypes As *Long
        typeIdxs = g_gTypeIdxs As *Long
        oOff[0] = offs[si]
        oTy[0] = types[si]
        oTi[0] = typeIdxs[si]
        oBr[0] = 0
        oGl[0] = 1
        LowLookupVar = 1
    End If
End Function

Sub LowEmitLeaOff(list As *IrList, off As Long, isGlob As Long)
    If isGlob <> 0 Then
        IrEmit(list, OP_LEA_RAX_GLOB, off, 0)
    Else
        IrEmit(list, OP_LEA_LOCAL, off, 0)
    End If
End Sub

Sub LowEmitLoadOff(list As *IrList, off As Long, isGlob As Long)
    If isGlob <> 0 Then
        IrEmit(list, OP_LEA_RAX_GLOB, off, 0)
        IrEmit(list, OP_LOAD_PTR, 0, 0)
    Else
        IrEmit(list, OP_LOAD_LOCAL, off, 0)
    End If
End Sub

Sub LowEmitStoreOff(list As *IrList, off As Long, isGlob As Long)
    If isGlob <> 0 Then
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        IrEmit(list, OP_LEA_RAX_GLOB, off, 0)
        IrEmit(list, OP_POP_RCX, 0, 0)
        IrEmit(list, OP_STORE_PTR, 0, 0)
    Else
        IrEmit(list, OP_STORE_LOCAL, off, 0)
    End If
End Sub

' String 代入: ポインタ格納のみ（解放は StrCollect）
Sub LowEmitStoreString(ctx As *LowerCtx, off As Long, isGlob As Long)
    LowEmitStoreOff(ctx->list, off, isGlob)
End Sub

' AST_NUM.extra: 0=整数, 1=Single IEEE bits, 4=Double IEEE bits (Ast.abp)

Function LowPromoteType(a As Long, b As Long) As Long
    If a = TY_DOUBLE Or b = TY_DOUBLE Then
        LowPromoteType = TY_DOUBLE
    ElseIf a = TY_SINGLE Or b = TY_SINGLE Then
        LowPromoteType = TY_SINGLE
    Else
        LowPromoteType = TY_LONG
    End If
End Function

Function LowExprTypeLeaf(ctx As *LowerCtx, idx As Long, k As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long

    LowExprTypeLeaf = TY_LONG
    ast = ctx->ast
    nodes = ast->nodes
    If k = AST_NUM Then
        If nodes[idx].extra = AST_NUM_EXTRA_F64 Then
            LowExprTypeLeaf = TY_DOUBLE
        ElseIf nodes[idx].extra = AST_NUM_EXTRA_SINGLE Then
            LowExprTypeLeaf = TY_SINGLE
        Else
            LowExprTypeLeaf = TY_LONG
        End If
        Exit Function
    End If
    AstCopyStr(ast, idx, VarPtr(name))
    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
        If vTy = TY_DOUBLE Then
            LowExprTypeLeaf = TY_DOUBLE
        ElseIf vTy = TY_SINGLE Then
            LowExprTypeLeaf = TY_SINGLE
        Else
            LowExprTypeLeaf = TY_LONG
        End If
    End If
End Function

Function LowExprTypeOp(ctx As *LowerCtx, idx As Long, k As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim lty As Long
    Dim rty As Long
    Dim op As Long

    LowExprTypeOp = TY_LONG
    ast = ctx->ast
    nodes = ast->nodes
    If k = AST_UNARY Then
        LowExprTypeOp = LowExprType(ctx, nodes[idx].left)
        Exit Function
    End If
    op = nodes[idx].num
    If op = BOP_EQ Or op = BOP_NE Or op = BOP_LT Or op = BOP_LE Or op = BOP_GT Or op = BOP_GE Then
        LowExprTypeOp = TY_LONG
    Else
        lty = LowExprType(ctx, nodes[idx].left)
        rty = LowExprType(ctx, nodes[idx].right)
        LowExprTypeOp = LowPromoteType(lty, rty)
    End If
End Function

Function LowExprTypeRef(ctx As *LowerCtx, idx As Long, k As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim base As Long

    LowExprTypeRef = TY_LONG
    ast = ctx->ast
    nodes = ast->nodes
    If k = AST_CALL Then
        AstCopyStr(ast, idx, VarPtr(name))
        If nodes[idx].num = 1 Then
            If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
                If vTy = TY_DOUBLE_ARR Then
                    LowExprTypeRef = TY_DOUBLE
                    Exit Function
                End If
                If vTy = TY_SINGLE_ARR Then
                    LowExprTypeRef = TY_SINGLE
                    Exit Function
                End If
                Exit Function
            End If
        End If
        LowExprTypeRef = LowFindFuncRetTy(ctx, VarPtr(name))
        Exit Function
    End If
    base = nodes[idx].left
    If nodes[base].kind = AST_VAR Then
        AstCopyStr(ast, base, VarPtr(name))
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
            If vTy = TY_DOUBLE_ARR Then
                LowExprTypeRef = TY_DOUBLE
            ElseIf vTy = TY_SINGLE_ARR Then
                LowExprTypeRef = TY_SINGLE
            End If
        End If
    End If
End Function

Function LowExprType(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim k As Long

    LowExprType = TY_LONG
    If idx < 0 Then Exit Function
    ast = ctx->ast
    nodes = ast->nodes
    k = nodes[idx].kind
    If k = AST_NUM Then
        LowExprType = LowExprTypeLeaf(ctx, idx, k)
        Exit Function
    End If
    If k = AST_VAR Then
        LowExprType = LowExprTypeLeaf(ctx, idx, k)
        Exit Function
    End If
    If k = AST_BINOP Then
        LowExprType = LowExprTypeOp(ctx, idx, k)
        Exit Function
    End If
    If k = AST_UNARY Then
        LowExprType = LowExprTypeOp(ctx, idx, k)
        Exit Function
    End If
    If k = AST_CALL Then
        LowExprType = LowExprTypeRef(ctx, idx, k)
        Exit Function
    End If
    If k = AST_INDEX Then
        LowExprType = LowExprTypeRef(ctx, idx, k)
    End If
End Function

Function LowExprIsDoubleBitsTail(ctx As *LowerCtx, idx As Long, k As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    LowExprIsDoubleBitsTail = 0
    ast = ctx->ast
    nodes = ast->nodes
    If k = AST_BINOP Then
        If LowExprType(ctx, idx) = TY_DOUBLE Then LowExprIsDoubleBitsTail = 1
    End If
    If k = AST_UNARY Then
        If LowExprType(ctx, idx) = TY_DOUBLE Then LowExprIsDoubleBitsTail = 1
    End If
    If k = AST_NUM Then
        If nodes[idx].extra = AST_NUM_EXTRA_F64 Then LowExprIsDoubleBitsTail = 1
    End If
End Function

Function LowExprIsDoubleBits(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim k As Long
    Dim base As Long

    LowExprIsDoubleBits = 0
    If idx < 0 Then Exit Function
    ast = ctx->ast
    nodes = ast->nodes
    k = nodes[idx].kind
    If k = AST_VAR Then
        AstCopyStr(ast, idx, VarPtr(name))
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
            If vTy = TY_DOUBLE Then LowExprIsDoubleBits = 1
        End If
        Exit Function
    End If
    If k = AST_CALL Then
        AstCopyStr(ast, idx, VarPtr(name))
        If nodes[idx].num = 1 Then
            If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
                If vTy = TY_DOUBLE_ARR Then LowExprIsDoubleBits = 1
                Exit Function
            End If
        End If
        If LowFindFuncRetTy(ctx, VarPtr(name)) = TY_DOUBLE Then LowExprIsDoubleBits = 1
        Exit Function
    End If
    If k = AST_INDEX Then
        base = nodes[idx].left
        If nodes[base].kind = AST_VAR Then
            AstCopyStr(ast, base, VarPtr(name))
            If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
                If vTy = TY_DOUBLE_ARR Then LowExprIsDoubleBits = 1
            End If
        End If
    End If
    If LowExprIsDoubleBitsTail(ctx, idx, k) <> 0 Then LowExprIsDoubleBits = 1
End Function

Function LowExprIsSingleBits(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim k As Long
    Dim base As Long

    LowExprIsSingleBits = 0
    If idx < 0 Then Exit Function
    ast = ctx->ast
    nodes = ast->nodes
    k = nodes[idx].kind
    If k = AST_NUM Then
        If nodes[idx].extra = AST_NUM_EXTRA_SINGLE Then LowExprIsSingleBits = 1
        Exit Function
    End If
    If k = AST_VAR Then
        AstCopyStr(ast, idx, VarPtr(name))
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
            If vTy = TY_SINGLE Then LowExprIsSingleBits = 1
        End If
        Exit Function
    End If
    If k = AST_CALL Then
        AstCopyStr(ast, idx, VarPtr(name))
        If nodes[idx].num = 1 Then
            If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
                If vTy = TY_SINGLE_ARR Then LowExprIsSingleBits = 1
                Exit Function
            End If
        End If
        If LowFindFuncRetTy(ctx, VarPtr(name)) = TY_SINGLE Then LowExprIsSingleBits = 1
        Exit Function
    End If
    If k = AST_INDEX Then
        base = nodes[idx].left
        If nodes[base].kind = AST_VAR Then
            AstCopyStr(ast, base, VarPtr(name))
            If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
                If vTy = TY_SINGLE_ARR Then LowExprIsSingleBits = 1
            End If
        End If
    End If
End Function

' eax が整数のとき Single 代入用に IEEE ビットへ（既にビットなら何もしない）
Sub LowEmitCvtToSingleIfNeeded(ctx As *LowerCtx, rhsIdx As Long)
    If LowExprIsSingleBits(ctx, rhsIdx) <> 0 Then Exit Sub
    If LowExprIsDoubleBits(ctx, rhsIdx) <> 0 Or LowExprType(ctx, rhsIdx) = TY_DOUBLE Then
        IrEmit(ctx->list, OP_CVT_SD_TO_SS, 0, 0)
        Exit Sub
    End If
    IrEmit(ctx->list, OP_CVT_I32_TO_SS, 0, 0)
End Sub

' rax が Double ビットでないとき IEEE Double へ
Sub LowEmitCvtToDoubleIfNeeded(ctx As *LowerCtx, rhsIdx As Long)
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim rty As Long
    If LowExprIsDoubleBits(ctx, rhsIdx) <> 0 Then Exit Sub
    ast = ctx->ast
    nodes = ast->nodes
    rty = LowExprType(ctx, rhsIdx)
    If rty = TY_DOUBLE Then Exit Sub
    If rty = TY_SINGLE Or (nodes[rhsIdx].kind = AST_NUM And nodes[rhsIdx].extra = AST_NUM_EXTRA_SINGLE) Then
        IrEmit(ctx->list, OP_CVT_SS_TO_SD, 0, 0)
        Exit Sub
    End If
    IrEmit(ctx->list, OP_CVT_I32_TO_SD, 0, 0)
End Sub

' Double 式を Long 変数へ格納するとき trunc
Sub LowEmitCvtToLongIfNeeded(ctx As *LowerCtx, rhsIdx As Long, dstTy As Long)
    If dstTy <> TY_LONG And dstTy <> TY_BYTE Then Exit Sub
    If LowExprType(ctx, rhsIdx) = TY_DOUBLE Then
        IrEmit(ctx->list, OP_CVT_SD_TO_I32, 0, 0)
    ElseIf LowExprType(ctx, rhsIdx) = TY_SINGLE Then
        IrEmit(ctx->list, OP_CVT_SS_TO_SD, 0, 0)
        IrEmit(ctx->list, OP_CVT_SD_TO_I32, 0, 0)
    End If
End Sub

' 評価済み rax を式型に合わせて Double へ
Sub LowEmitCvtRaxToDoubleFromTy(ctx As *LowerCtx, ty As Long)
    If ty = TY_DOUBLE Then Exit Sub
    If ty = TY_SINGLE Then
        IrEmit(ctx->list, OP_CVT_SS_TO_SD, 0, 0)
    Else
        IrEmit(ctx->list, OP_CVT_I32_TO_SD, 0, 0)
    End If
End Sub

Function LowFindConst(ctx As *LowerCtx, name As *Byte) As Long
    Dim i As Long
    Dim names As *Byte
    Dim off As Long
    LowFindConst = -1
    names = ctx->constNames
    i = 0
    While i < ctx->constCount
        off = i * SYM_NAME_LEN
        If LowNameEqExact(VarPtr(names[off]), name) <> 0 Then
            LowFindConst = i
            Exit Function
        End If
        i = i + 1
    Wend
End Function

Sub LowAddBuiltinConsts(ctx As *LowerCtx)
    Dim t(7) As Byte
    Dim f(7) As Byte
    lstrcpy(VarPtr(t), "TRUE")
    lstrcpy(VarPtr(f), "FALSE")
    LowAddConst(ctx, VarPtr(t), 1)
    LowAddConst(ctx, VarPtr(f), 0)
End Sub

Function LowAddConst(ctx As *LowerCtx, name As *Byte, v As Long) As Long
    Dim i As Long
    Dim names As *Byte
    Dim vals As *Long
    Dim j As Long
    Dim off As Long

    LowAddConst = 0
    If LowFindConst(ctx, name) >= 0 Then
        LowAddConst = 1
        Exit Function
    End If
    If LowEnsureConstCap(ctx) = 0 Then
        Print "error: out of memory (consts)"
        ctx->err = 1
        Exit Function
    End If
    i = ctx->constCount
    names = ctx->constNames
    vals = ctx->constVals
    off = i * SYM_NAME_LEN
    j = 0
    While name[j] <> 0 And j < SYM_NAME_LEN - 1
        names[off + j] = name[j]
        j = j + 1
    Wend
    names[off + j] = 0
    vals[i] = v
    ctx->constCount = i + 1
    LowAddConst = 1
End Function

Function LowFindStrConst(ctx As *LowerCtx, name As *Byte) As Long
    Dim i As Long
    Dim names As *Byte
    Dim off As Long
    LowFindStrConst = -1
    names = ctx->constStrNames
    If names = NULL Then Exit Function
    i = 0
    While i < ctx->constStrCount
        off = i * SYM_NAME_LEN
        If LowNameEqExact(VarPtr(names[off]), name) <> 0 Then
            LowFindStrConst = i
            Exit Function
        End If
        i = i + 1
    Wend
End Function

Function LowAddStrConst(ctx As *LowerCtx, name As *Byte, s As *Byte) As Long
    Dim i As Long
    Dim names As *Byte
    Dim vals As *Byte
    Dim j As Long
    Dim off As Long

    LowAddStrConst = 0
    If LowFindStrConst(ctx, name) >= 0 Then
        LowAddStrConst = 1
        Exit Function
    End If
    If LowEnsureConstStrCap(ctx) = 0 Then
        Print "error: out of memory (string consts)"
        ctx->err = 1
        Exit Function
    End If
    If ctx->constStrNames = NULL Or ctx->constStrVals = NULL Then
        ctx->err = 1
        Exit Function
    End If
    i = ctx->constStrCount
    names = ctx->constStrNames
    vals = ctx->constStrVals
    off = i * SYM_NAME_LEN
    j = 0
    While name[j] <> 0 And j < SYM_NAME_LEN - 1
        names[off + j] = name[j]
        j = j + 1
    Wend
    names[off + j] = 0
    off = i * AST_STR_LEN
    j = 0
    While s[j] <> 0 And j < AST_STR_LEN - 1
        vals[off + j] = s[j]
        j = j + 1
    Wend
    vals[off + j] = 0
    ctx->constStrCount = i + 1
    LowAddStrConst = 1
End Function

Function LowBoundValArithOps(op As Long, lv As Long, rv As Long) As Long
    LowBoundValArithOps = -1
    If op = BOP_ADD Then
        LowBoundValArithOps = lv + rv
    ElseIf op = BOP_SUB Then
        LowBoundValArithOps = lv - rv
    ElseIf op = BOP_MUL Then
        LowBoundValArithOps = lv * rv
    ElseIf op = BOP_OR Then
        LowBoundValArithOps = lv Or rv
    ElseIf op = BOP_AND Then
        LowBoundValArithOps = lv And rv
    ElseIf op = BOP_IDIV Or op = BOP_DIV Then
        If rv <> 0 Then
            LowBoundValArithOps = lv \ rv
        End If
    ElseIf op = BOP_MOD Then
        If rv <> 0 Then
            LowBoundValArithOps = lv - (lv \ rv) * rv
        End If
    ElseIf op = BOP_XOR Then
        LowBoundValArithOps = (lv Or rv) - (lv And rv)
    End If
End Function

Function LowBoundValShiftPow(op As Long, lv As Long, rv As Long) As Long
    Dim acc As Long
    LowBoundValShiftPow = -1
    If op = BOP_SHL Then
        If rv >= 0 And rv < 32 Then
            acc = lv
            While rv > 0
                acc = acc * 2
                rv = rv - 1
            Wend
            LowBoundValShiftPow = acc
        End If
    ElseIf op = BOP_SHR Then
        If rv >= 0 And rv < 32 Then
            acc = lv
            While rv > 0
                acc = acc \ 2
                rv = rv - 1
            Wend
            LowBoundValShiftPow = acc
        End If
    ElseIf op = BOP_POW Then
        If rv >= 0 Then
            acc = 1
            While rv > 0
                acc = acc * lv
                rv = rv - 1
            Wend
            LowBoundValShiftPow = acc
        End If
    End If
End Function

Function LowBoundValBin(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim lv As Long
    Dim rv As Long
    Dim op As Long
    Dim leftIdx As Long
    Dim rightIdx As Long

    LowBoundValBin = -1
    ast = ctx->ast
    nodes = ast->nodes
    op = nodes[idx].num
    leftIdx = nodes[idx].left
    rightIdx = nodes[idx].right
    If leftIdx < 0 Or rightIdx < 0 Then Exit Function
    lv = LowBoundVal(ctx, leftIdx)
    If lv < 0 Then Exit Function
    rv = LowBoundVal(ctx, rightIdx)
    If rv < 0 Then Exit Function
    If op = BOP_SHL Or op = BOP_SHR Or op = BOP_POW Then
        LowBoundValBin = LowBoundValShiftPow(op, lv, rv)
    Else
        LowBoundValBin = LowBoundValArithOps(op, lv, rv)
    End If
End Function

Function LowBoundVal(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim ci As Long
    Dim vals As *Long
    Dim lv As Long

    LowBoundVal = -1
    If idx < 0 Then Exit Function
    ast = ctx->ast
    nodes = ast->nodes
    If nodes[idx].kind = AST_NUM Then
        LowBoundVal = nodes[idx].num
    ElseIf nodes[idx].kind = AST_VAR Then
        AstCopyStr(ast, idx, VarPtr(name))
        ci = LowFindConst(ctx, VarPtr(name))
        If ci < 0 Then Exit Function
        vals = ctx->constVals
        LowBoundVal = vals[ci]
    ElseIf nodes[idx].kind = AST_BINOP Then
        LowBoundVal = LowBoundValBin(ctx, idx)
    ElseIf nodes[idx].kind = AST_BUILTIN Then
        If nodes[idx].num = BI_ELM Then
            lv = LowBoundVal(ctx, nodes[idx].left)
            If lv >= 0 Then
                LowBoundVal = lv + 1
            End If
        End If
    End If
End Function

Function LowNewLab(ctx As *LowerCtx) As Long
    Dim id As Long
    id = ctx->nextLab
    ctx->nextLab = id + 1
    LowNewLab = id
End Function

' 既知 kernel32 API 名へ正規化（小文字比較）。成功時 apiOut に正式名を書く
Function LowKernelApiHit(name As *Byte, key As *Byte, exp As *Byte, apiOut As *Byte) As Long
    LowKernelApiHit = 0
    If LowNameEq(name, key) = 0 Then Exit Function
    lstrcpy(apiOut, exp)
    LowKernelApiHit = 1
End Function

Function LowKernelApiHit2(name As *Byte, key1 As *Byte, key2 As *Byte, exp As *Byte, apiOut As *Byte) As Long
    LowKernelApiHit2 = 0
    If LowNameEq(name, key1) <> 0 Then
        lstrcpy(apiOut, exp)
        LowKernelApiHit2 = 1
        Exit Function
    End If
    If LowNameEq(name, key2) <> 0 Then
        lstrcpy(apiOut, exp)
        LowKernelApiHit2 = 1
    End If
End Function

