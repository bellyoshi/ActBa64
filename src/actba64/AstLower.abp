Sub LowEmitRtCatBody(ctx As *LowerCtx)
    Dim list As *IrList
    Dim sApi(15) As Byte
    Dim empty(1) As Byte
    Dim labA As Long
    Dim labB As Long

    If g_rtCatLab < 0 Then Exit Sub
    list = ctx.list
    empty[0] = 0
    labA = LowNewLab(ctx)
    labB = LowNewLab(ctx)

    IrEmit(list, OP_LABEL, g_rtCatLab, 0)
    IrEmit(list, OP_ENTER, 64, 0)
    IrEmit(list, OP_STORE_LOCAL_ECX, -8, 0)
    IrEmit(list, OP_STORE_LOCAL_EDX, -16, 0)

    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JNZ, labA, 0)
    IrEmitStr(list, OP_LEA_RAX_STR, 0, VarPtr(empty))
    IrEmit(list, OP_STORE_LOCAL, -8, 0)
    IrEmit(list, OP_LABEL, labA, 0)

    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JNZ, labB, 0)
    IrEmitStr(list, OP_LEA_RAX_STR, 0, VarPtr(empty))
    IrEmit(list, OP_STORE_LOCAL, -16, 0)
    IrEmit(list, OP_LABEL, labB, 0)

    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_MOV_RCX_RAX, 0, 0)
    lstrcpy(VarPtr(sApi), "lstrlenA")
    IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sApi))
    IrEmit(list, OP_STORE_LOCAL, -24, 0)

    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_MOV_RCX_RAX, 0, 0)
    lstrcpy(VarPtr(sApi), "lstrlenA")
    IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sApi))
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_ADD_EAX_ECX, 0, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -24, 0)

    lstrcpy(VarPtr(sApi), "GetProcessHeap")
    IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sApi))
    IrEmit(list, OP_MOV_RCX_RAX, 0, 0)
    IrEmit(list, OP_MOV_EDX_IMM, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_MOV_R8_RAX, 0, 0)
    lstrcpy(VarPtr(sApi), "HeapAlloc")
    IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sApi))
    IrEmit(list, OP_STORE_LOCAL, -32, 0)

    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_MOV_RCX_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
    lstrcpy(VarPtr(sApi), "lstrcpyA")
    IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sApi))

    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_MOV_RCX_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
    lstrcpy(VarPtr(sApi), "lstrcatA")
    IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sApi))

    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_LEAVE, 0, 0)
End Sub

Sub LowEmitRtMidBody(ctx As *LowerCtx)
    Dim list As *IrList
    Dim sApi(15) As Byte
    Dim empty(1) As Byte
    Dim labS As Long
    Dim labStartOk As Long
    Dim labRemOk As Long
    Dim labUseRem As Long
    Dim labCountOk As Long
    Dim labCountDone As Long
    Dim labLoop As Long
    Dim labEnd As Long

    If g_rtMidLab < 0 Then Exit Sub
    list = ctx.list
    empty[0] = 0
    labS = LowNewLab(ctx)
    labStartOk = LowNewLab(ctx)
    labRemOk = LowNewLab(ctx)
    labUseRem = LowNewLab(ctx)
    labCountOk = LowNewLab(ctx)
    labCountDone = LowNewLab(ctx)
    labLoop = LowNewLab(ctx)
    labEnd = LowNewLab(ctx)

    ' rcx=s, rdx=start1, r8=count
    IrEmit(list, OP_LABEL, g_rtMidLab, 0)
    IrEmit(list, OP_ENTER, 80, 0)
    IrEmit(list, OP_STORE_LOCAL_ECX, -8, 0)
    IrEmit(list, OP_STORE_LOCAL_EDX, -16, 0)
    IrEmit(list, OP_MOV_RAX_R8, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -24, 0)

    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JNZ, labS, 0)
    IrEmitStr(list, OP_LEA_RAX_STR, 0, VarPtr(empty))
    IrEmit(list, OP_STORE_LOCAL, -8, 0)
    IrEmit(list, OP_LABEL, labS, 0)

    ' start0 = start1 - 1; if start0 < 0 then 0
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -1, 0)
    IrEmit(list, OP_STORE_LOCAL, -16, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JGE, labStartOk, 0)
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -16, 0)
    IrEmit(list, OP_LABEL, labStartOk, 0)

    ' rem = len - start0
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_MOV_RCX_RAX, 0, 0)
    lstrcpy(VarPtr(sApi), "lstrlenA")
    IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sApi))
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
    IrEmit(list, OP_SUB_EAX_ECX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -40, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JGE, labRemOk, 0)
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -40, 0)
    IrEmit(list, OP_LABEL, labRemOk, 0)

    ' if count < 0 then count = rem else if count > rem then count = rem
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JL, labUseRem, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -40, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JLE, labCountOk, 0)
    IrEmit(list, OP_LABEL, labUseRem, 0)
    IrEmit(list, OP_LOAD_LOCAL, -40, 0)
    IrEmit(list, OP_STORE_LOCAL, -24, 0)
    IrEmit(list, OP_JMP, labCountDone, 0)
    IrEmit(list, OP_LABEL, labCountOk, 0)
    IrEmit(list, OP_LABEL, labCountDone, 0)

    ' src = s + start0
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -8, 0)

    ' dst = HeapAlloc(count+1)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -40, 0)
    lstrcpy(VarPtr(sApi), "GetProcessHeap")
    IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sApi))
    IrEmit(list, OP_MOV_RCX_RAX, 0, 0)
    IrEmit(list, OP_MOV_EDX_IMM, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -40, 0)
    IrEmit(list, OP_MOV_R8_RAX, 0, 0)
    lstrcpy(VarPtr(sApi), "HeapAlloc")
    IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sApi))
    IrEmit(list, OP_STORE_LOCAL, -32, 0)
    IrEmit(list, OP_STORE_LOCAL, -48, 0)

    IrEmit(list, OP_LABEL, labLoop, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JZ, labEnd, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -8, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_STORE_BYTE_RAX_CL, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -32, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -1, 0)
    IrEmit(list, OP_STORE_LOCAL, -24, 0)
    IrEmit(list, OP_JMP, labLoop, 0)

    IrEmit(list, OP_LABEL, labEnd, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_MOV_ECX, 0, 0)
    IrEmit(list, OP_STORE_BYTE_RAX_CL, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -48, 0)
    IrEmit(list, OP_LEAVE, 0, 0)
End Sub

Sub LowEmitRtStrBody(ctx As *LowerCtx)
    Dim list As *IrList
    Dim sApi(15) As Byte
    Dim labPos As Long
    Dim labDig As Long
    Dim labDigDone As Long
    Dim labNoSign As Long
    Dim labNeg As Long

    If g_rtStrLab < 0 Then Exit Sub
    list = ctx.list
    labPos = LowNewLab(ctx)
    labDig = LowNewLab(ctx)
    labDigDone = LowNewLab(ctx)
    labNoSign = LowNewLab(ctx)
    labNeg = LowNewLab(ctx)

    ' rcx = n
    IrEmit(list, OP_LABEL, g_rtStrLab, 0)
    IrEmit(list, OP_ENTER, 64, 0)
    IrEmit(list, OP_STORE_LOCAL_ECX, -8, 0)

    lstrcpy(VarPtr(sApi), "GetProcessHeap")
    IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sApi))
    IrEmit(list, OP_MOV_RCX_RAX, 0, 0)
    IrEmit(list, OP_MOV_EDX_IMM, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 16, 0)
    IrEmit(list, OP_MOV_R8_RAX, 0, 0)
    lstrcpy(VarPtr(sApi), "HeapAlloc")
    IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sApi))
    IrEmit(list, OP_STORE_LOCAL, -16, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 15, 0)
    IrEmit(list, OP_MOV_ECX, 0, 0)
    IrEmit(list, OP_STORE_BYTE_RAX_CL, 0, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -1, 0)
    IrEmit(list, OP_STORE_LOCAL, -24, 0)

    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JGE, labPos, 0)
    ' neg: n = -n, flag=1
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_NEG_EAX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -8, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -32, 0)
    IrEmit(list, OP_JMP, labDig, 0)
    IrEmit(list, OP_LABEL, labPos, 0)
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -32, 0)

    IrEmit(list, OP_LABEL, labDig, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_MOV_ECX, 10, 0)
    IrEmit(list, OP_XOR_EDX, 0, 0)
    IrEmit(list, OP_DIV_ECX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -8, 0)
    IrEmit(list, OP_MOV_EAX_EDX, 0, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 48, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_STORE_BYTE_RAX_CL, 0, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -1, 0)
    IrEmit(list, OP_STORE_LOCAL, -24, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JNZ, labDig, 0)

    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JZ, labNoSign, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_MOV_ECX, 45, 0)
    IrEmit(list, OP_STORE_BYTE_RAX_CL, 0, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -1, 0)
    IrEmit(list, OP_STORE_LOCAL, -24, 0)

    IrEmit(list, OP_LABEL, labNoSign, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    IrEmit(list, OP_LEAVE, 0, 0)
End Sub

' Print s ― stdout + CRLF (rcx = s)
Sub LowEmitRtPrintBody(ctx As *LowerCtx)
    Dim list As *IrList
    Dim sApi(15) As Byte
    Dim crlf(3) As Byte
    Dim labNl As Long

    If g_rtPrintLab < 0 Then Exit Sub
    list = ctx.list
    crlf[0] = 13
    crlf[1] = 10
    crlf[2] = 0
    labNl = LowNewLab(ctx)

    IrEmit(list, OP_LABEL, g_rtPrintLab, 0)
    IrEmit(list, OP_ENTER, 64, 0)
    IrEmit(list, OP_STORE_LOCAL_ECX, -8, 0)

    IrEmit(list, OP_MOV_ECX, &HFFFFFFF5, 0)
    lstrcpy(VarPtr(sApi), "GetStdHandle")
    IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sApi))
    IrEmit(list, OP_STORE_LOCAL, -16, 0)

    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JZ, labNl, 0)
    IrEmit(list, OP_MOV_RCX_RAX, 0, 0)
    lstrcpy(VarPtr(sApi), "lstrlenA")
    IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sApi))
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JZ, labNl, 0)
    IrEmit(list, OP_STORE_LOCAL, -24, 0)

    IrEmit(list, OP_SUB_RSP, 48, 0)
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_STORE_RSP_RAX, 32, 0)
    IrEmit(list, OP_LEA_LOCAL, -32, 0)
    IrEmit(list, OP_MOV_R9_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_MOV_R8_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_MOV_RCX_RAX, 0, 0)
    lstrcpy(VarPtr(sApi), "WriteFile")
    IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sApi))
    IrEmit(list, OP_ADD_RSP, 48, 0)

    IrEmit(list, OP_LABEL, labNl, 0)
    IrEmit(list, OP_SUB_RSP, 48, 0)
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_STORE_RSP_RAX, 32, 0)
    IrEmit(list, OP_LEA_LOCAL, -32, 0)
    IrEmit(list, OP_MOV_R9_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 2, 0)
    IrEmit(list, OP_MOV_R8_RAX, 0, 0)
    IrEmitStr(list, OP_LEA_RAX_STR, 0, VarPtr(crlf))
    IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_MOV_RCX_RAX, 0, 0)
    lstrcpy(VarPtr(sApi), "WriteFile")
    IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sApi))
    IrEmit(list, OP_ADD_RSP, 48, 0)
    IrEmit(list, OP_LEAVE, 0, 0)
End Sub

' Input$ ― stdin から1行読み、ヒープ上の文字列を返す（CR 無視 / LF で終了）
Sub LowEmitRtInputBody(ctx As *LowerCtx)
    Dim list As *IrList
    Dim sApi(15) As Byte
    Dim labFail As Long
    Dim labLoop As Long
    Dim labDone As Long
    Dim labSkipCr As Long

    If g_rtInputLab < 0 Then Exit Sub
    list = ctx.list
    labFail = LowNewLab(ctx)
    labLoop = LowNewLab(ctx)
    labDone = LowNewLab(ctx)
    labSkipCr = LowNewLab(ctx)

    ' locals: -8 ch, -16 handle, -24 buf, -32 len, -40 nRead
    IrEmit(list, OP_LABEL, g_rtInputLab, 0)
    IrEmit(list, OP_ENTER, 80, 0)
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -32, 0)

    lstrcpy(VarPtr(sApi), "GetProcessHeap")
    IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sApi))
    IrEmit(list, OP_MOV_RCX_RAX, 0, 0)
    IrEmit(list, OP_MOV_EDX_IMM, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 256, 0)
    IrEmit(list, OP_MOV_R8_RAX, 0, 0)
    lstrcpy(VarPtr(sApi), "HeapAlloc")
    IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sApi))
    IrEmit(list, OP_STORE_LOCAL, -24, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JZ, labFail, 0)

    IrEmit(list, OP_MOV_ECX, &HFFFFFFF6, 0)
    lstrcpy(VarPtr(sApi), "GetStdHandle")
    IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sApi))
    IrEmit(list, OP_STORE_LOCAL, -16, 0)

    IrEmit(list, OP_LABEL, labLoop, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 255, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JGE, labDone, 0)

    IrEmit(list, OP_SUB_RSP, 48, 0)
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_STORE_RSP_RAX, 32, 0)
    IrEmit(list, OP_LEA_LOCAL, -40, 0)
    IrEmit(list, OP_MOV_R9_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 1, 0)
    IrEmit(list, OP_MOV_R8_RAX, 0, 0)
    IrEmit(list, OP_LEA_LOCAL, -8, 0)
    IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_MOV_RCX_RAX, 0, 0)
    lstrcpy(VarPtr(sApi), "ReadFile")
    IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sApi))
    IrEmit(list, OP_ADD_RSP, 48, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JZ, labDone, 0)
    IrEmit(list, OP_LOAD_LOCAL, -40, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JZ, labDone, 0)

    IrEmit(list, OP_LEA_LOCAL, -8, 0)
    IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 13, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JE, labSkipCr, 0)

    IrEmit(list, OP_LEA_LOCAL, -8, 0)
    IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 10, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JE, labDone, 0)

    IrEmit(list, OP_LEA_LOCAL, -8, 0)
    IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_STORE_BYTE_RAX_CL, 0, 0)
    IrEmit(list, OP_INC_LOCAL, -32, 0)

    IrEmit(list, OP_LABEL, labSkipCr, 0)
    IrEmit(list, OP_JMP, labLoop, 0)

    IrEmit(list, OP_LABEL, labDone, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
    IrEmit(list, OP_MOV_ECX, 0, 0)
    IrEmit(list, OP_STORE_BYTE_RAX_CL, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_LEAVE, 0, 0)

    IrEmit(list, OP_LABEL, labFail, 0)
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_LEAVE, 0, 0)
End Sub

Sub LowLoadSized(list As *IrList, sz As Long)
    If sz = 1 Then
        IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
    ElseIf sz = 2 Then
        IrEmit(list, OP_LOADZX_WORD_RAX, 0, 0)
    ElseIf sz = 4 Then
        IrEmit(list, OP_LOAD_DWORD_RAX, 0, 0)
    ElseIf sz = 8 Then
        IrEmit(list, OP_LOAD_QWORD_RAX, 0, 0)
    Else
        IrEmit(list, OP_LOAD_DWORD_RAX, 0, 0)
    End If
End Sub

Sub LowStoreSized(list As *IrList, sz As Long)
    If sz = 1 Then
        IrEmit(list, OP_STORE_BYTE_RAX_CL, 0, 0)
    ElseIf sz = 2 Then
        IrEmit(list, OP_STORE_WORD_RAX_CX, 0, 0)
    ElseIf sz = 4 Then
        IrEmit(list, OP_STORE_DWORD_RAX_ECX, 0, 0)
    ElseIf sz = 8 Then
        IrEmit(list, OP_STORE_QWORD_RAX_RCX, 0, 0)
    Else
        IrEmit(list, OP_STORE_DWORD_RAX_ECX, 0, 0)
    End If
End Sub

' Address of lvalue -> rax
' AST_MEMBER ノードが指すフィールドの UDT 型インデックス（ネスト解決用）
Function LowMemberFieldType(ctx As *LowerCtx, idx As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim tt As *TypeTable
    Dim base As Long
    Dim name(63) As Byte
    Dim fname(63) As Byte
    Dim ti As Long
    Dim foff As Long
    Dim fsz As Long
    Dim fcnt As Long
    Dim fieldTy As Long
    Dim off As Long
    Dim ty As Long
    Dim typeIdx As Long
    Dim byRef As Long
    Dim isGlob As Long

    LowMemberFieldType = -1
    If idx < 0 Then Exit Function
    ast = ctx.ast
    nodes = ast.nodes
    If nodes[idx].kind <> AST_MEMBER Then Exit Function
    tt = ast.types
    base = nodes[idx].left
    AstCopyStr(ast, idx, VarPtr(fname))
    If nodes[base].kind = AST_MEMBER Then
        ti = LowMemberFieldType(ctx, base)
    ElseIf nodes[base].kind = AST_VAR Then
        AstCopyStr(ast, base, VarPtr(name))
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then Exit Function
        ti = vTypeIdx
    Else
        Exit Function
    End If
    If ti < 0 Then Exit Function
    If TyFindFieldEx(tt, ti, VarPtr(fname), foff, fsz, fcnt, fieldTy) = 0 Then Exit Function
    LowMemberFieldType = fieldTy
End Function

' Byte size of the field addressed by an AST_MEMBER (supports nesting).
Function LowMemberFieldSize(ctx As *LowerCtx, idx As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim tt As *TypeTable
    Dim base As Long
    Dim name(63) As Byte
    Dim fname(63) As Byte
    Dim ti As Long
    Dim foff As Long
    Dim fsz As Long
    Dim fcnt As Long
    Dim fieldTy As Long

    LowMemberFieldSize = 0
    If idx < 0 Then Exit Function
    ast = ctx.ast
    nodes = ast.nodes
    If nodes[idx].kind <> AST_MEMBER Then Exit Function
    tt = ast.types
    base = nodes[idx].left
    AstCopyStr(ast, idx, VarPtr(fname))
    If nodes[base].kind = AST_MEMBER Then
        ti = LowMemberFieldType(ctx, base)
    ElseIf nodes[base].kind = AST_VAR Then
        AstCopyStr(ast, base, VarPtr(name))
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then Exit Function
        ti = vTypeIdx
    ElseIf nodes[base].kind = AST_INDEX Then
        AstCopyStr(ast, nodes[base].left, VarPtr(name))
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then Exit Function
        ti = vTypeIdx
    Else
        Exit Function
    End If
    If ti < 0 Then Exit Function
    If TyFindFieldEx(tt, ti, VarPtr(fname), foff, fsz, fcnt, fieldTy) = 0 Then Exit Function
    LowMemberFieldSize = fsz
End Function

Function LowAddr(ctx As *LowerCtx, idx As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList
    Dim name(63) As Byte
    Dim fname(63) As Byte
    Dim base As Long
    Dim k As Long
    Dim nArgs As Long
    Dim tt As *TypeTable
    Dim foff As Long
    Dim fsz As Long
    Dim fcnt As Long
    Dim ti As Long
    Dim esz As Long
    Dim tsizes As *Long
    Dim ix As Long

    LowAddr = 0
    If idx < 0 Then
        ctx.err = 1
        Exit Function
    End If
    ast = ctx.ast
    list = ctx.list
    nodes = ast.nodes
    k = nodes[idx].kind
    tt = ast.types

    If k = AST_VAR Then
        AstCopyStr(ast, idx, VarPtr(name))
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
            ctx.err = 1
            Exit Function
        End If
        If vByRef <> 0 Then
            LowEmitLoadOff(list, vOff, vGlob)
        Else
            LowEmitLeaOff(list, vOff, vGlob)
        End If
        LowAddr = 1
    ElseIf k = AST_MEMBER Then
        base = nodes[idx].left
        AstCopyStr(ast, idx, VarPtr(fname))
        If nodes[base].kind = AST_MEMBER Then
            ' nested: a.b.c — address of a.b then + offset(c)
            If LowAddr(ctx, base) = 0 Then Exit Function
            ti = LowMemberFieldType(ctx, base)
            If ti < 0 Then
                ctx.err = 1
                Exit Function
            End If
        ElseIf nodes[base].kind = AST_INDEX Then
            If LowAddr(ctx, base) = 0 Then Exit Function
            AstCopyStr(ast, nodes[base].left, VarPtr(name))
            If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
                ctx.err = 1
                Exit Function
            End If
            ti = vTypeIdx
        ElseIf nodes[base].kind = AST_VAR Then
            AstCopyStr(ast, base, VarPtr(name))
            If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
                ctx.err = 1
                Exit Function
            End If
            ti = vTypeIdx
            If nodes[idx].num <> 0 Then
                LowEmitLoadOff(list, vOff, vGlob)
            ElseIf vTy = TY_PTR_UDT Then
                LowEmitLoadOff(list, vOff, vGlob)
            Else
                LowEmitLeaOff(list, vOff, vGlob)
            End If
        Else
            ctx.err = 1
            Exit Function
        End If
        If TyFindField(tt, ti, VarPtr(fname), foff, fsz, fcnt) = 0 Then
            ctx.err = 1
            Exit Function
        End If
        If foff <> 0 Then
            IrEmit(list, OP_ADD_RAX_IMM, foff, 0)
        End If
        LowAddr = 1
    ElseIf k = AST_INDEX Or k = AST_CALL Then
        If k = AST_CALL Then
            nArgs = nodes[idx].num
            If nArgs <> 1 Then
                ctx.err = 1
                Exit Function
            End If
            AstCopyStr(ast, idx, VarPtr(name))
            If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
                ctx.err = 1
                Exit Function
            End If
            If vTy <> TY_BYTE_ARR Then
                If vTy <> TY_LONG_ARR Then
                    If vTy <> TY_STRING_ARR Then
                        If vTy <> TY_DOUBLE_ARR Then
                            ctx.err = 1
                            Exit Function
                        End If
                    End If
                End If
            End If
            ' index expr is left of CALL (AST_ARG wrapper)
            ix = nodes[idx].left
            If ix >= 0 Then
                If nodes[ix].kind = AST_ARG Then ix = nodes[ix].left
            End If
            If LowExpr(ctx, ix) = 0 Then Exit Function
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            LowEmitLeaOff(list, vOff, vGlob)
            IrEmit(list, OP_POP_RCX, 0, 0)
            If vTy = TY_LONG_ARR Or vTy = TY_STRING_ARR Or vTy = TY_DOUBLE_ARR Then
                IrEmit(list, OP_SHL_ECX_3, 0, 0)
            End If
            IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
            LowAddr = 1
            Exit Function
        End If
        base = nodes[idx].left
        If nodes[base].kind = AST_MEMBER Then
            AstCopyStr(ast, base, VarPtr(fname))
            ix = nodes[base].left
            If nodes[ix].kind = AST_INDEX Then
                AstCopyStr(ast, nodes[ix].left, VarPtr(name))
            ElseIf nodes[ix].kind = AST_VAR Then
                AstCopyStr(ast, ix, VarPtr(name))
            Else
                ctx.err = 1
                Exit Function
            End If
            If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
                ctx.err = 1
                Exit Function
            End If
            ti = vTypeIdx
            If TyFindField(tt, ti, VarPtr(fname), foff, fsz, fcnt) = 0 Then
                ctx.err = 1
                Exit Function
            End If
            If fcnt > 1 Then
                ' UDT array field: &field[0] + index * elemSize
                esz = fsz
                If esz <= 0 Then
                    ctx.err = 1
                    Exit Function
                End If
                If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
                If esz <> 1 Then
                    IrEmit(list, OP_MOV_ECX, esz, 0)
                    IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
                End If
                IrEmit(list, OP_PUSH_RAX, 0, 0)
                If LowAddr(ctx, base) = 0 Then Exit Function
                IrEmit(list, OP_POP_RCX, 0, 0)
                IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
            ElseIf fsz = 8 Then
                ' pointer field (*Byte etc.): load ptr + byte index
                If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
                IrEmit(list, OP_PUSH_RAX, 0, 0)
                If LowExpr(ctx, base) = 0 Then Exit Function
                IrEmit(list, OP_POP_RCX, 0, 0)
                IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
            Else
                ctx.err = 1
                Exit Function
            End If
            LowAddr = 1
            Exit Function
        End If
        AstCopyStr(ast, base, VarPtr(name))
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
            ctx.err = 1
            Exit Function
        End If
        If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
        If vTy = TY_PTR_UDT Then
            ti = vTypeIdx
            tsizes = tt.typeSizes
            esz = tsizes[ti]
            If esz <= 0 Then
                ctx.err = 1
                Exit Function
            End If
            IrEmit(list, OP_MOV_ECX, esz, 0)
            IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            LowEmitLoadOff(list, vOff, vGlob)
            IrEmit(list, OP_POP_RCX, 0, 0)
            IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
            LowAddr = 1
            Exit Function
        End If
        If vTy = TY_PTR_LONG Then
            IrEmit(list, OP_MOV_ECX, 4, 0)
            IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            LowEmitLoadOff(list, vOff, vGlob)
            IrEmit(list, OP_POP_RCX, 0, 0)
            IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
            LowAddr = 1
            Exit Function
        End If
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        If vTy = TY_BYTE_ARR Then
            LowEmitLeaOff(list, vOff, vGlob)
        ElseIf vTy = TY_LONG_ARR Or vTy = TY_STRING_ARR Or vTy = TY_DOUBLE_ARR Then
            LowEmitLeaOff(list, vOff, vGlob)
            IrEmit(list, OP_POP_RCX, 0, 0)
            IrEmit(list, OP_SHL_ECX_3, 0, 0)
            IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
            LowAddr = 1
            Exit Function
        ElseIf vTy = TY_PTR_BYTE Then
            LowEmitLoadOff(list, vOff, vGlob)
        Else
            ctx.err = 1
            Exit Function
        End If
        IrEmit(list, OP_POP_RCX, 0, 0)
        IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
        LowAddr = 1
    Else
        ctx.err = 1
    End If
End Function

' 配列名を *Byte 等へ渡すとき先頭アドレスに減衰する
Function LowExprArg(ctx As *LowerCtx, idx As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte

    LowExprArg = 0
    If idx < 0 Then Exit Function
    ast = ctx.ast
    nodes = ast.nodes
    If nodes[idx].kind = AST_VAR Then
        AstCopyStr(ast, idx, VarPtr(name))
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
            If vTy = TY_BYTE_ARR Then
                LowExprArg = LowAddr(ctx, idx)
                Exit Function
            End If
            If vTy = TY_LONG_ARR Then
                LowExprArg = LowAddr(ctx, idx)
                Exit Function
            End If
            If vTy = TY_DOUBLE_ARR Then
                LowExprArg = LowAddr(ctx, idx)
                Exit Function
            End If
            If vTy = TY_STRING_ARR Then
                LowExprArg = LowAddr(ctx, idx)
                Exit Function
            End If
        End If
    End If
    LowExprArg = LowExpr(ctx, idx)
End Function

' WinAPI へ UDT 変数を渡すときはアドレス渡し（LPRECT 等）
Function LowArgIsUdtVar(ctx As *LowerCtx, idx As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte

    LowArgIsUdtVar = 0
    If idx < 0 Then Exit Function
    ast = ctx.ast
    nodes = ast.nodes
    If nodes[idx].kind <> AST_VAR Then Exit Function
    AstCopyStr(ast, idx, VarPtr(name))
    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then Exit Function
    If vTy = TY_UDT Then LowArgIsUdtVar = 1
End Function

Function LowUseArgAddr(ctx As *LowerCtx, idx As Long, byBits As Long, bit As Long, isApi As Long) As Long
    Dim v As Long
    LowUseArgAddr = 0
    v = byBits And bit
    If v <> 0 Then
        LowUseArgAddr = 1
        Exit Function
    End If
    If isApi = 0 Then Exit Function
    If LowArgIsUdtVar(ctx, idx) <> 0 Then LowUseArgAddr = 1
End Function

Function LowExpr(ctx As *LowerCtx, idx As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim k As Long
    Dim name(63) As Byte
    Dim buf(255) As Byte
    Dim si As Long
    Dim offs As *Long
    Dim types As *Long
    Dim op As Long
    Dim list As *IrList
    Dim lab As Long
    Dim nArgs As Long
    Dim v As Long
    Dim labZ As Long
    Dim labE As Long
    Dim sLen(15) As Byte
    Dim ci As Long
    Dim vals As *Long
    Dim strs As *Byte
    Dim tt As *TypeTable
    Dim typeIdxs As *Long
    Dim foff As Long
    Dim fsz As Long
    Dim fcnt As Long
    Dim ti As Long
    Dim sz As Long
    Dim base As Long
    Dim ix As Long
    Dim byRefs As *Long
    Dim byBits As Long
    Dim args(15) As Long
    Dim argi As Long
    Dim argn As Long
    Dim stk As Long
    Dim j As Long
    Dim bbit As Long
    Dim tsizes As *Long
    Dim apiName(63) As Byte
    Dim isApi As Long
    Dim di As Long
    Dim dllKind As Long
    Dim dlls As *Long
    Dim bys As *Long
    Dim useAddr As Long
    Dim labA As Long
    Dim labB As Long

    LowExpr = 0
    If idx < 0 Then
        ctx.err = 1
        Exit Function
    End If
    ast = ctx.ast
    list = ctx.list
    nodes = ast.nodes
    tt = ast.types

    If LowConstInt(ast, idx, v) <> 0 Then
        IrEmit(list, OP_MOV_EAX_IMM, v, 0)
        LowExpr = 1
        Exit Function
    End If
    If LowConstStr(ast, idx, VarPtr(buf)) <> 0 Then
        IrEmitStr(list, OP_LEA_RAX_STR, 0, VarPtr(buf))
        LowExpr = 1
        Exit Function
    End If

    k = nodes[idx].kind
    offs = ctx.offs
    types = ctx.types
    typeIdxs = ctx.typeIdxs
    If k = AST_NUM Then
        IrEmit(list, OP_MOV_EAX_IMM, nodes[idx].num, 0)
        LowExpr = 1
    ElseIf k = AST_STRING Then
        AstCopyStr(ast, idx, VarPtr(buf))
        IrEmitStr(list, OP_LEA_RAX_STR, 0, VarPtr(buf))
        LowExpr = 1
    ElseIf k = AST_VAR Then
        AstCopyStr(ast, idx, VarPtr(name))
        ci = LowFindConst(ctx, VarPtr(name))
        If ci >= 0 Then
            vals = ctx.constVals
            IrEmit(list, OP_MOV_EAX_IMM, vals[ci], 0)
            LowExpr = 1
            Exit Function
        End If
        ci = LowFindStrConst(ctx, VarPtr(name))
        If ci >= 0 Then
            strs = ctx.constStrVals
            IrEmitStr(list, OP_LEA_RAX_STR, 0, VarPtr(strs[ci * AST_STR_LEN]))
            LowExpr = 1
            Exit Function
        End If
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
            Print "error: undefined variable '" + MakeStr(VarPtr(name)) + "'"
            ctx.err = 1
            Exit Function
        End If
        LowEmitLoadOff(list, vOff, vGlob)
        If vByRef <> 0 Then
            IrEmit(list, OP_LOAD_QWORD_RAX, 0, 0)
        End If
        LowExpr = 1
    ElseIf k = AST_MEMBER Then
        If LowAddr(ctx, idx) = 0 Then Exit Function
        AstCopyStr(ast, idx, VarPtr(name))
        base = nodes[idx].left
        If nodes[base].kind = AST_INDEX Then
            AstCopyStr(ast, nodes[base].left, VarPtr(buf))
        ElseIf nodes[base].kind = AST_VAR Then
            AstCopyStr(ast, base, VarPtr(buf))
        Else
            ctx.err = 1
            Exit Function
        End If
        If LowLookupVar(ctx, VarPtr(buf), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
            ctx.err = 1
            Exit Function
        End If
        ti = vTypeIdx
        If TyFindField(tt, ti, VarPtr(name), foff, fsz, fcnt) = 0 Then
            ctx.err = 1
            Exit Function
        End If
        LowLoadSized(list, fsz)
        LowExpr = 1
    ElseIf k = AST_INDEX Then
        base = nodes[idx].left
        If nodes[base].kind = AST_MEMBER Then
            If LowAddr(ctx, idx) = 0 Then Exit Function
            AstCopyStr(ast, base, VarPtr(name))
            ix = nodes[base].left
            If nodes[ix].kind = AST_INDEX Then
                AstCopyStr(ast, nodes[ix].left, VarPtr(buf))
            ElseIf nodes[ix].kind = AST_VAR Then
                AstCopyStr(ast, ix, VarPtr(buf))
            Else
                ctx.err = 1
                Exit Function
            End If
            If LowLookupVar(ctx, VarPtr(buf), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
                ctx.err = 1
                Exit Function
            End If
            ti = vTypeIdx
            If TyFindField(tt, ti, VarPtr(name), foff, fsz, fcnt) = 0 Then
                ctx.err = 1
                Exit Function
            End If
            If fcnt > 1 Then
                LowLoadSized(list, fsz)
            ElseIf fsz = 8 Then
                LowLoadSized(list, 1)
            Else
                ctx.err = 1
                Exit Function
            End If
            LowExpr = 1
        Else
            If LowAddr(ctx, idx) = 0 Then Exit Function
            AstCopyStr(ast, base, VarPtr(buf))
            If LowLookupVar(ctx, VarPtr(buf), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
                If vTy = TY_PTR_LONG Or vTy = TY_LONG_ARR Then
                    LowLoadSized(list, 4)
                ElseIf vTy = TY_STRING_ARR Then
                    LowLoadSized(list, 8)
                Else
                    IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
                End If
            Else
                IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
            End If
            LowExpr = 1
        End If
    ElseIf k = AST_BUILTIN Then
        If nodes[idx].num = BI_SIZEOF Then
            AstCopyStr(ast, nodes[idx].left, VarPtr(name))
            sz = TySizeOfName(tt, VarPtr(name))
            If sz <= 0 Then
                ' also allow SizeOf(var)
                If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
                    ctx.err = 1
                    Exit Function
                End If
                ' approximate: use frame slot size not ideal; prefer type
                ctx.err = 1
                Exit Function
            End If
            IrEmit(list, OP_MOV_EAX_IMM, sz, 0)
            LowExpr = 1
        ElseIf nodes[idx].num = BI_VARPTR Then
            If LowAddr(ctx, nodes[idx].left) = 0 Then Exit Function
            LowExpr = 1
        ElseIf nodes[idx].num = BI_ADDRESSOF Then
            AstCopyStr(ast, idx, VarPtr(name))
            lab = LowFindFunc(ctx, VarPtr(name))
            If lab < 0 Then
                ctx.err = 1
                Exit Function
            End If
            IrEmit(list, OP_LEA_RAX_LAB, lab, 0)
            LowExpr = 1
        ElseIf nodes[idx].num = BI_MALLOC Then
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            lstrcpy(VarPtr(sLen), "GetProcessHeap")
            IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sLen))
            IrEmit(list, OP_MOV_RCX_RAX, 0, 0)
            IrEmit(list, OP_MOV_EDX_IMM, 0, 0)
            IrEmit(list, OP_POP_RAX, 0, 0)
            IrEmit(list, OP_MOV_R8_RAX, 0, 0)
            lstrcpy(VarPtr(sLen), "HeapAlloc")
            IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sLen))
            LowExpr = 1
        ElseIf nodes[idx].num = BI_FREE Then
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            lstrcpy(VarPtr(sLen), "GetProcessHeap")
            IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sLen))
            IrEmit(list, OP_MOV_RCX_RAX, 0, 0)
            IrEmit(list, OP_MOV_EDX_IMM, 0, 0)
            IrEmit(list, OP_POP_R8, 0, 0)
            lstrcpy(VarPtr(sLen), "HeapFree")
            IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sLen))
            LowExpr = 1
        ElseIf nodes[idx].num = BI_LEN Then
            ' Len(UDT var) => SizeOf(type); else string Len via lstrlenA
            If nodes[nodes[idx].left].kind = AST_VAR Then
                AstCopyStr(ast, nodes[idx].left, VarPtr(name))
                If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
                    If vTy = TY_UDT Then
                        ti = vTypeIdx
                        If ti >= 0 Then
                            tsizes = tt.typeSizes
                            sz = tsizes[ti]
                            If sz > 0 Then
                                IrEmit(list, OP_MOV_EAX_IMM, sz, 0)
                                LowExpr = 1
                                Exit Function
                            End If
                        End If
                    End If
                End If
            End If
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            labZ = LowNewLab(ctx)
            labE = LowNewLab(ctx)
            IrEmit(list, OP_TEST_RAX, 0, 0)
            IrEmit(list, OP_JZ, labZ, 0)
            IrEmit(list, OP_MOV_RCX_RAX, 0, 0)
            lstrcpy(VarPtr(sLen), "lstrlenA")
            IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sLen))
            IrEmit(list, OP_JMP, labE, 0)
            IrEmit(list, OP_LABEL, labZ, 0)
            IrEmit(list, OP_XOR_EAX, 0, 0)
            IrEmit(list, OP_LABEL, labE, 0)
            LowExpr = 1
        ElseIf nodes[idx].num = BI_MAKEINTRESOURCE Then
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            LowExpr = 1
        ElseIf nodes[idx].num = BI_FILLMEMORY Then
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            If nodes[idx].extra < 0 Then
                ctx.err = 1
                Exit Function
            End If
            If LowExpr(ctx, nodes[idx].extra) = 0 Then Exit Function
            IrEmit(list, OP_MOV_R8_RAX, 0, 0)
            IrEmit(list, OP_POP_RAX, 0, 0)
            IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
            IrEmit(list, OP_POP_RCX, 0, 0)
            lstrcpy(VarPtr(sLen), "RtlFillMemory")
            IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sLen))
            LowExpr = 1
        ElseIf nodes[idx].num = BI_ASC Then
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            labZ = LowNewLab(ctx)
            labE = LowNewLab(ctx)
            IrEmit(list, OP_TEST_RAX, 0, 0)
            IrEmit(list, OP_JZ, labZ, 0)
            IrEmit(list, OP_MOVZX_EAX_BYTE, 0, 0)
            IrEmit(list, OP_JMP, labE, 0)
            IrEmit(list, OP_LABEL, labZ, 0)
            IrEmit(list, OP_XOR_EAX, 0, 0)
            IrEmit(list, OP_LABEL, labE, 0)
            LowExpr = 1
        ElseIf nodes[idx].num = BI_STRPTR Then
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            LowExpr = 1
        ElseIf nodes[idx].num = BI_STR Then
            lab = LowEnsureRtStr(ctx)
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            IrEmit(list, OP_MOV_RCX_RAX, 0, 0)
            IrEmit(list, OP_CALL_LAB, lab, 0)
            LowExpr = 1
        ElseIf nodes[idx].num = BI_MAKESTR Then
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            LowExpr = 1
        ElseIf nodes[idx].num = BI_MEMCPY Then
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            If nodes[idx].extra < 0 Then
                ctx.err = 1
                Exit Function
            End If
            If LowExpr(ctx, nodes[idx].extra) = 0 Then Exit Function
            IrEmit(list, OP_MOV_R8_RAX, 0, 0)
            IrEmit(list, OP_POP_RAX, 0, 0)
            IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
            IrEmit(list, OP_POP_RCX, 0, 0)
            lstrcpy(VarPtr(sLen), "RtlMoveMemory")
            IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sLen))
            LowExpr = 1
        ElseIf nodes[idx].num = BI_LEFT Then
            ' Left$(s, n) => Mid$(s, 1, n)
            lab = LowEnsureRtMid(ctx)
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
            IrEmit(list, OP_MOV_R8_RAX, 0, 0)
            IrEmit(list, OP_MOV_EAX_IMM, 1, 0)
            IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
            IrEmit(list, OP_POP_RCX, 0, 0)
            IrEmit(list, OP_CALL_LAB, lab, 0)
            LowExpr = 1
        ElseIf nodes[idx].num = BI_MID Then
            lab = LowEnsureRtMid(ctx)
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            If nodes[idx].extra >= 0 Then
                If LowExpr(ctx, nodes[idx].extra) = 0 Then Exit Function
            Else
                IrEmit(list, OP_MOV_EAX_IMM, -1, 0)
            End If
            IrEmit(list, OP_MOV_R8_RAX, 0, 0)
            IrEmit(list, OP_POP_RAX, 0, 0)
            IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
            IrEmit(list, OP_POP_RCX, 0, 0)
            IrEmit(list, OP_CALL_LAB, lab, 0)
            LowExpr = 1
        ElseIf nodes[idx].num = BI_CHR Then
            If LowConstInt(ast, nodes[idx].left, v) <> 0 Then
                buf[0] = v
                buf[1] = 0
                IrEmitStr(list, OP_LEA_RAX_STR, 0, VarPtr(buf))
                LowExpr = 1
                Exit Function
            End If
            ' HeapAlloc(2); buf[0] = code; buf[1] = 0
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            lstrcpy(VarPtr(sLen), "GetProcessHeap")
            IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sLen))
            IrEmit(list, OP_MOV_RCX_RAX, 0, 0)
            IrEmit(list, OP_MOV_EDX_IMM, 0, 0)
            IrEmit(list, OP_MOV_EAX_IMM, 2, 0)
            IrEmit(list, OP_MOV_R8_RAX, 0, 0)
            lstrcpy(VarPtr(sLen), "HeapAlloc")
            IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sLen))
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
            IrEmit(list, OP_MOV_ECX, 0, 0)
            IrEmit(list, OP_STORE_BYTE_RAX_CL, 0, 0)
            IrEmit(list, OP_POP_RAX, 0, 0)
            IrEmit(list, OP_POP_RCX, 0, 0)
            IrEmit(list, OP_STORE_BYTE_RAX_CL, 0, 0)
            LowExpr = 1
        ElseIf nodes[idx].num = BI_RIGHT Then
            ' Right$(s, n) => Mid$(s, len - n + 1, n)
            If nodes[idx].right < 0 Then
                ctx.err = 1
                Exit Function
            End If
            lab = LowEnsureRtMid(ctx)
            labA = LowNewLab(ctx)
            labB = LowNewLab(ctx)
            labZ = LowNewLab(ctx)
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            ' stack: s, n  →  rax = s, rcx = n
            IrEmit(list, OP_POP_RCX, 0, 0)
            IrEmit(list, OP_POP_RAX, 0, 0)
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
            ' rax = s (stack: s, n) → rax = lstrlen(s)
            IrEmit(list, OP_TEST_RAX, 0, 0)
            IrEmit(list, OP_JZ, labA, 0)
            IrEmit(list, OP_MOV_RCX_RAX, 0, 0)
            lstrcpy(VarPtr(sLen), "lstrlenA")
            IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sLen))
            IrEmit(list, OP_JMP, labB, 0)
            IrEmit(list, OP_LABEL, labA, 0)
            IrEmit(list, OP_XOR_EAX, 0, 0)
            IrEmit(list, OP_LABEL, labB, 0)
            ' start = len - n + 1（n はスタックへ戻す）
            IrEmit(list, OP_POP_RCX, 0, 0)
            IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
            IrEmit(list, OP_SUB_EAX_ECX, 0, 0)
            IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
            ' if start < 1 then start = 1
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            IrEmit(list, OP_MOV_EAX_IMM, 1, 0)
            IrEmit(list, OP_POP_RCX, 0, 0)
            IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
            IrEmit(list, OP_JL, labZ, 0)
            IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
            IrEmit(list, OP_LABEL, labZ, 0)
            IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
            IrEmit(list, OP_POP_RAX, 0, 0)
            IrEmit(list, OP_MOV_R8_RAX, 0, 0)
            IrEmit(list, OP_POP_RCX, 0, 0)
            IrEmit(list, OP_CALL_LAB, lab, 0)
            LowExpr = 1
        ElseIf nodes[idx].num = BI_RGB Then
            If nodes[idx].right < 0 Or nodes[idx].extra < 0 Then
                ctx.err = 1
                Exit Function
            End If
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
            IrEmit(list, OP_MOV_ECX, 256, 0)
            IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
            IrEmit(list, OP_POP_RCX, 0, 0)
            IrEmit(list, OP_OR_EAX_ECX, 0, 0)
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            If LowExpr(ctx, nodes[idx].extra) = 0 Then Exit Function
            IrEmit(list, OP_MOV_ECX, 65536, 0)
            IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
            IrEmit(list, OP_POP_RCX, 0, 0)
            IrEmit(list, OP_OR_EAX_ECX, 0, 0)
            LowExpr = 1
        ElseIf nodes[idx].num = BI_LOWORD Then
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            IrEmit(list, OP_MOV_ECX, 65535, 0)
            IrEmit(list, OP_AND_EAX_ECX, 0, 0)
            LowExpr = 1
        Else
            ctx.err = 1
        End If
    ElseIf k = AST_CALL Then
        AstCopyStr(ast, idx, VarPtr(name))
        lstrcpy(VarPtr(buf), "free")
        If LowNameEq(VarPtr(name), VarPtr(buf)) <> 0 Then
            argn = nodes[idx].left
            If argn >= 0 Then
                If nodes[argn].kind = AST_ARG Then argn = nodes[argn].left
            End If
            If LowExpr(ctx, argn) = 0 Then Exit Function
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            lstrcpy(VarPtr(sLen), "GetProcessHeap")
            IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sLen))
            IrEmit(list, OP_MOV_RCX_RAX, 0, 0)
            IrEmit(list, OP_MOV_EDX_IMM, 0, 0)
            IrEmit(list, OP_POP_R8, 0, 0)
            lstrcpy(VarPtr(sLen), "HeapFree")
            IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sLen))
            LowExpr = 1
            Exit Function
        End If
        lstrcpy(VarPtr(buf), "malloc")
        If LowNameEq(VarPtr(name), VarPtr(buf)) <> 0 Then
            argn = nodes[idx].left
            If argn >= 0 Then
                If nodes[argn].kind = AST_ARG Then argn = nodes[argn].left
            End If
            If LowExpr(ctx, argn) = 0 Then Exit Function
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            lstrcpy(VarPtr(sLen), "GetProcessHeap")
            IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sLen))
            IrEmit(list, OP_MOV_RCX_RAX, 0, 0)
            IrEmit(list, OP_MOV_EDX_IMM, 0, 0)
            IrEmit(list, OP_POP_RAX, 0, 0)
            IrEmit(list, OP_MOV_R8_RAX, 0, 0)
            lstrcpy(VarPtr(sLen), "HeapAlloc")
            IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sLen))
            LowExpr = 1
            Exit Function
        End If
        lstrcpy(VarPtr(buf), "calloc")
        If LowNameEq(VarPtr(name), VarPtr(buf)) <> 0 Then
            ' calloc(n) → HeapAlloc(heap, HEAP_ZERO_MEMORY=8, n)
            argn = nodes[idx].left
            If argn >= 0 Then
                If nodes[argn].kind = AST_ARG Then argn = nodes[argn].left
            End If
            If LowExpr(ctx, argn) = 0 Then Exit Function
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            lstrcpy(VarPtr(sLen), "GetProcessHeap")
            IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sLen))
            IrEmit(list, OP_MOV_RCX_RAX, 0, 0)
            IrEmit(list, OP_MOV_EDX_IMM, 8, 0)
            IrEmit(list, OP_POP_RAX, 0, 0)
            IrEmit(list, OP_MOV_R8_RAX, 0, 0)
            lstrcpy(VarPtr(sLen), "HeapAlloc")
            IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sLen))
            LowExpr = 1
            Exit Function
        End If
        lstrcpy(VarPtr(buf), "memcpy")
        If LowNameEq(VarPtr(name), VarPtr(buf)) <> 0 Then
            argi = 0
            argn = nodes[idx].left
            While argn >= 0
                If argi >= 16 Then
                    ctx.err = 1
                    Exit Function
                End If
                args[argi] = argn
                argi = argi + 1
                argn = nodes[argn].nxt
            Wend
            If argi <> 3 Then
                ctx.err = 1
                Exit Function
            End If
            If LowExpr(ctx, nodes[args[0]].left) = 0 Then Exit Function
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            If LowExpr(ctx, nodes[args[1]].left) = 0 Then Exit Function
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            If LowExpr(ctx, nodes[args[2]].left) = 0 Then Exit Function
            IrEmit(list, OP_MOV_R8_RAX, 0, 0)
            IrEmit(list, OP_POP_RAX, 0, 0)
            IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
            IrEmit(list, OP_POP_RCX, 0, 0)
            lstrcpy(VarPtr(sLen), "RtlMoveMemory")
            IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sLen))
            LowExpr = 1
            Exit Function
        End If
        lstrcpy(VarPtr(buf), "fillmemory")
        If LowNameEq(VarPtr(name), VarPtr(buf)) <> 0 Then
            argi = 0
            argn = nodes[idx].left
            While argn >= 0
                If argi >= 16 Then
                    ctx.err = 1
                    Exit Function
                End If
                args[argi] = argn
                argi = argi + 1
                argn = nodes[argn].nxt
            Wend
            If argi <> 3 Then
                ctx.err = 1
                Exit Function
            End If
            If LowExpr(ctx, nodes[args[0]].left) = 0 Then Exit Function
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            If LowExpr(ctx, nodes[args[1]].left) = 0 Then Exit Function
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            If LowExpr(ctx, nodes[args[2]].left) = 0 Then Exit Function
            IrEmit(list, OP_MOV_R8_RAX, 0, 0)
            IrEmit(list, OP_POP_RAX, 0, 0)
            IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
            IrEmit(list, OP_POP_RCX, 0, 0)
            lstrcpy(VarPtr(sLen), "RtlFillMemory")
            IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sLen))
            LowExpr = 1
            Exit Function
        End If
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
            If vTy = TY_BYTE_ARR And nodes[idx].num = 1 Then
                If LowAddr(ctx, idx) = 0 Then Exit Function
                IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
                LowExpr = 1
                Exit Function
            End If
            If vTy = TY_LONG_ARR And nodes[idx].num = 1 Then
                If LowAddr(ctx, idx) = 0 Then Exit Function
                IrEmit(list, OP_LOAD_QWORD_RAX, 0, 0)
                LowExpr = 1
                Exit Function
            End If
            If vTy = TY_DOUBLE_ARR And nodes[idx].num = 1 Then
                If LowAddr(ctx, idx) = 0 Then Exit Function
                IrEmit(list, OP_LOAD_QWORD_RAX, 0, 0)
                LowExpr = 1
                Exit Function
            End If
            If vTy = TY_STRING_ARR And nodes[idx].num = 1 Then
                If LowAddr(ctx, idx) = 0 Then Exit Function
                IrEmit(list, OP_LOAD_QWORD_RAX, 0, 0)
                LowExpr = 1
                Exit Function
            End If
        End If
        lab = LowFindFunc(ctx, VarPtr(name))
        isApi = 0
        dllKind = 0
        byBits = 0
        If lab >= 0 Then
            byBits = LowFindFuncByRefs(ctx, VarPtr(name))
        Else
            di = LowFindDecl(ctx, VarPtr(name))
            If di >= 0 Then
                LowDeclApiName(ctx, di, VarPtr(apiName))
                dlls = ctx.declDlls
                bys = ctx.declByRefs
                dllKind = dlls[di]
                byBits = bys[di]
                isApi = 1
            Else
                If LowMapWinApi(VarPtr(name), dllKind, VarPtr(apiName)) = 0 Then
                    Print "error: unknown API/call '" + MakeStr(VarPtr(name)) + "'"
                    ctx.err = 1
                    Exit Function
                End If
                isApi = 1
            End If
        End If
        If isApi <> 0 Then
            If dllKind = 0 Then dllKind = IR_DLL_KERNEL32
        End If
        nArgs = nodes[idx].num
        If nArgs > 16 Then
            ctx.err = 1
            Exit Function
        End If
        ' collect AST_ARG nodes
        argi = 0
        argn = nodes[idx].left
        While argn >= 0
            If argi >= 16 Then
                ctx.err = 1
                Exit Function
            End If
            args[argi] = argn
            argi = argi + 1
            argn = nodes[argn].nxt
        Wend
        If argi <> nArgs Then
            ctx.err = 1
            Exit Function
        End If
        ' stack space: shadow 32 + 8 per stack arg
        stk = 32
        If nArgs > 4 Then
            stk = stk + (nArgs - 4) * 8
        End If
        stk = (stk + 15) And (0 - 16)
        If stk > 120 Then
            ctx.err = 1
            Exit Function
        End If
        IrEmit(list, OP_SUB_RSP, stk, 0)
        ' stack args 4..n-1
        argi = 4
        While argi < nArgs
            bbit = 1
            j = 0
            While j < argi
                bbit = bbit * 2
                j = j + 1
            Wend
            useAddr = LowUseArgAddr(ctx, nodes[args[argi]].left, byBits, bbit, isApi)
            If useAddr <> 0 Then
                If LowAddr(ctx, nodes[args[argi]].left) = 0 Then Exit Function
            Else
                If LowExprArg(ctx, nodes[args[argi]].left) = 0 Then Exit Function
            End If
            IrEmit(list, OP_STORE_RSP_RAX, 32 + (argi - 4) * 8, 0)
            argi = argi + 1
        Wend
        ' register args 3,2,1,0
        If nArgs >= 4 Then
            useAddr = LowUseArgAddr(ctx, nodes[args[3]].left, byBits, 8, isApi)
            If useAddr <> 0 Then
                If LowAddr(ctx, nodes[args[3]].left) = 0 Then Exit Function
            Else
                If LowExprArg(ctx, nodes[args[3]].left) = 0 Then Exit Function
            End If
            IrEmit(list, OP_MOV_R9_RAX, 0, 0)
        End If
        If nArgs >= 3 Then
            useAddr = LowUseArgAddr(ctx, nodes[args[2]].left, byBits, 4, isApi)
            If useAddr <> 0 Then
                If LowAddr(ctx, nodes[args[2]].left) = 0 Then Exit Function
            Else
                If LowExprArg(ctx, nodes[args[2]].left) = 0 Then Exit Function
            End If
            IrEmit(list, OP_MOV_R8_RAX, 0, 0)
        End If
        If nArgs >= 2 Then
            useAddr = LowUseArgAddr(ctx, nodes[args[1]].left, byBits, 2, isApi)
            If useAddr <> 0 Then
                If LowAddr(ctx, nodes[args[1]].left) = 0 Then Exit Function
            Else
                If LowExprArg(ctx, nodes[args[1]].left) = 0 Then Exit Function
            End If
            IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
        End If
        If nArgs >= 1 Then
            useAddr = LowUseArgAddr(ctx, nodes[args[0]].left, byBits, 1, isApi)
            If useAddr <> 0 Then
                If LowAddr(ctx, nodes[args[0]].left) = 0 Then Exit Function
            Else
                If LowExprArg(ctx, nodes[args[0]].left) = 0 Then Exit Function
            End If
            IrEmit(list, OP_MOV_RCX_RAX, 0, 0)
        End If
        If isApi <> 0 Then
            IrEmitStr(list, OP_CALL_API, dllKind, VarPtr(apiName))
        Else
            IrEmit(list, OP_CALL_LAB, lab, 0)
        End If
        IrEmit(list, OP_ADD_RSP, stk, 0)
        LowExpr = 1
    ElseIf k = AST_UNARY Then
        If nodes[idx].num = UOP_NEG Then
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            IrEmit(list, OP_NEG_EAX, 0, 0)
            LowExpr = 1
        Else
            ctx.err = 1
        End If
    ElseIf k = AST_BINOP Then
        op = nodes[idx].num
        If op = BOP_ADD Or op = BOP_CAT Then
            If LowIsStringExpr(ctx, nodes[idx].left) <> 0 Or LowIsStringExpr(ctx, nodes[idx].right) <> 0 Then
                lab = LowEnsureRtCat(ctx)
                If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
                IrEmit(list, OP_PUSH_RAX, 0, 0)
                If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
                IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
                IrEmit(list, OP_POP_RCX, 0, 0)
                IrEmit(list, OP_CALL_LAB, lab, 0)
                LowExpr = 1
                Exit Function
            End If
        End If
        If op = BOP_ADD Or op = BOP_MUL Or op = BOP_AND Or op = BOP_OR Or op = BOP_SUB Then
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
            IrEmit(list, OP_POP_RCX, 0, 0)
            If op = BOP_ADD Then
                IrEmit(list, OP_ADD_EAX_ECX, 0, 0)
            ElseIf op = BOP_SUB Then
                ' eax=right, ecx=left -> eax = left - right
                IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
                IrEmit(list, OP_SUB_EAX_ECX, 0, 0)
            ElseIf op = BOP_MUL Then
                IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
            ElseIf op = BOP_AND Then
                IrEmit(list, OP_AND_EAX_ECX, 0, 0)
            Else
                IrEmit(list, OP_OR_EAX_ECX, 0, 0)
            End If
            LowExpr = 1
        ElseIf op = BOP_IDIV Then
            ' eax = left, ecx = right, edx = 0 → div ecx
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
            IrEmit(list, OP_MOV_ECX_EAX, 0, 0)
            IrEmit(list, OP_POP_RAX, 0, 0)
            IrEmit(list, OP_XOR_EDX, 0, 0)
            IrEmit(list, OP_DIV_ECX, 0, 0)
            LowExpr = 1
        Else
            Print "error: unsupported binop " + Str$(op)
            ctx.err = 1
        End If
    Else
        Print "error: unsupported expr kind " + Str$(k)
        ctx.err = 1
    End If
End Function

' Emit cmp for a comparison BINOP; return jcc that jumps when FALSE
Function LowCmpFalseJcc(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim op As Long
    Dim list As *IrList
    Dim sCmp(15) As Byte
    Dim empty(1) As Byte
    Dim labA As Long
    Dim labB As Long

    LowCmpFalseJcc = 0
    ast = ctx.ast
    list = ctx.list
    nodes = ast.nodes
    If nodes[idx].kind <> AST_BINOP Then
        ctx.err = 1
        Exit Function
    End If
    op = nodes[idx].num
    If op = BOP_EQ Then
        If LowIsStringExpr(ctx, nodes[idx].left) <> 0 Then
            empty[0] = 0
            labA = LowNewLab(ctx)
            labB = LowNewLab(ctx)
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            IrEmit(list, OP_TEST_RAX, 0, 0)
            IrEmit(list, OP_JNZ, labA, 0)
            IrEmitStr(list, OP_LEA_RAX_STR, 0, VarPtr(empty))
            IrEmit(list, OP_LABEL, labA, 0)
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
            IrEmit(list, OP_TEST_RAX, 0, 0)
            IrEmit(list, OP_JNZ, labB, 0)
            IrEmitStr(list, OP_LEA_RAX_STR, 0, VarPtr(empty))
            IrEmit(list, OP_LABEL, labB, 0)
            IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
            IrEmit(list, OP_POP_RCX, 0, 0)
            lstrcpy(VarPtr(sCmp), "lstrcmpA")
            IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sCmp))
            IrEmit(list, OP_TEST_EAX, 0, 0)
            LowCmpFalseJcc = OP_JNZ
            Exit Function
        End If
        If LowIsStringExpr(ctx, nodes[idx].right) <> 0 Then
            empty[0] = 0
            labA = LowNewLab(ctx)
            labB = LowNewLab(ctx)
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            IrEmit(list, OP_TEST_RAX, 0, 0)
            IrEmit(list, OP_JNZ, labA, 0)
            IrEmitStr(list, OP_LEA_RAX_STR, 0, VarPtr(empty))
            IrEmit(list, OP_LABEL, labA, 0)
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
            IrEmit(list, OP_TEST_RAX, 0, 0)
            IrEmit(list, OP_JNZ, labB, 0)
            IrEmitStr(list, OP_LEA_RAX_STR, 0, VarPtr(empty))
            IrEmit(list, OP_LABEL, labB, 0)
            IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
            IrEmit(list, OP_POP_RCX, 0, 0)
            lstrcpy(VarPtr(sCmp), "lstrcmpA")
            IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sCmp))
            IrEmit(list, OP_TEST_EAX, 0, 0)
            LowCmpFalseJcc = OP_JNZ
            Exit Function
        End If
    End If
    If op = BOP_NE Then
        If LowIsStringExpr(ctx, nodes[idx].left) <> 0 Then
            empty[0] = 0
            labA = LowNewLab(ctx)
            labB = LowNewLab(ctx)
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            IrEmit(list, OP_TEST_RAX, 0, 0)
            IrEmit(list, OP_JNZ, labA, 0)
            IrEmitStr(list, OP_LEA_RAX_STR, 0, VarPtr(empty))
            IrEmit(list, OP_LABEL, labA, 0)
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
            IrEmit(list, OP_TEST_RAX, 0, 0)
            IrEmit(list, OP_JNZ, labB, 0)
            IrEmitStr(list, OP_LEA_RAX_STR, 0, VarPtr(empty))
            IrEmit(list, OP_LABEL, labB, 0)
            IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
            IrEmit(list, OP_POP_RCX, 0, 0)
            lstrcpy(VarPtr(sCmp), "lstrcmpA")
            IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sCmp))
            IrEmit(list, OP_TEST_EAX, 0, 0)
            LowCmpFalseJcc = OP_JZ
            Exit Function
        End If
        If LowIsStringExpr(ctx, nodes[idx].right) <> 0 Then
            empty[0] = 0
            labA = LowNewLab(ctx)
            labB = LowNewLab(ctx)
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            IrEmit(list, OP_TEST_RAX, 0, 0)
            IrEmit(list, OP_JNZ, labA, 0)
            IrEmitStr(list, OP_LEA_RAX_STR, 0, VarPtr(empty))
            IrEmit(list, OP_LABEL, labA, 0)
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
            IrEmit(list, OP_TEST_RAX, 0, 0)
            IrEmit(list, OP_JNZ, labB, 0)
            IrEmitStr(list, OP_LEA_RAX_STR, 0, VarPtr(empty))
            IrEmit(list, OP_LABEL, labB, 0)
            IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
            IrEmit(list, OP_POP_RCX, 0, 0)
            lstrcpy(VarPtr(sCmp), "lstrcmpA")
            IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sCmp))
            IrEmit(list, OP_TEST_EAX, 0, 0)
            LowCmpFalseJcc = OP_JZ
            Exit Function
        End If
    End If
    If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    If op = BOP_EQ Then
        LowCmpFalseJcc = OP_JNE
    ElseIf op = BOP_NE Then
        LowCmpFalseJcc = OP_JE
    ElseIf op = BOP_LT Then
        LowCmpFalseJcc = OP_JGE
    ElseIf op = BOP_LE Then
        LowCmpFalseJcc = OP_JG
    ElseIf op = BOP_GT Then
        LowCmpFalseJcc = OP_JLE
    ElseIf op = BOP_GE Then
        LowCmpFalseJcc = OP_JL
    Else
        ctx.err = 1
    End If
End Function

Function LowCmpTrueJcc(falseJcc As Long) As Long
    LowCmpTrueJcc = 0
    If falseJcc = OP_JNE Then
        LowCmpTrueJcc = OP_JE
    ElseIf falseJcc = OP_JE Then
        LowCmpTrueJcc = OP_JNE
    ElseIf falseJcc = OP_JNZ Then
        ' string EQ: false=JNZ (lstrcmp != 0), true=JZ
        LowCmpTrueJcc = OP_JZ
    ElseIf falseJcc = OP_JZ Then
        ' string NE: false=JZ, true=JNZ
        LowCmpTrueJcc = OP_JNZ
    ElseIf falseJcc = OP_JGE Then
        LowCmpTrueJcc = OP_JL
    ElseIf falseJcc = OP_JG Then
        LowCmpTrueJcc = OP_JLE
    ElseIf falseJcc = OP_JLE Then
        LowCmpTrueJcc = OP_JG
    ElseIf falseJcc = OP_JL Then
        LowCmpTrueJcc = OP_JGE
    End If
End Function

Function LowJumpIfFalse(ctx As *LowerCtx, idx As Long, lab As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim op As Long
    Dim jcc As Long
    Dim labSkip As Long

    LowJumpIfFalse = 0
    ast = ctx.ast
    nodes = ast.nodes
    If nodes[idx].kind <> AST_BINOP Then
        ctx.err = 1
        Exit Function
    End If
    op = nodes[idx].num
    If op = BOP_AND Then
        If LowJumpIfFalse(ctx, nodes[idx].left, lab) = 0 Then Exit Function
        If LowJumpIfFalse(ctx, nodes[idx].right, lab) = 0 Then Exit Function
        LowJumpIfFalse = 1
    ElseIf op = BOP_OR Then
        labSkip = LowNewLab(ctx)
        If LowJumpIfTrue(ctx, nodes[idx].left, labSkip) = 0 Then Exit Function
        If LowJumpIfFalse(ctx, nodes[idx].right, lab) = 0 Then Exit Function
        IrEmit(ctx.list, OP_LABEL, labSkip, 0)
        LowJumpIfFalse = 1
    Else
        jcc = LowCmpFalseJcc(ctx, idx)
        If jcc = 0 Then Exit Function
        IrEmit(ctx.list, jcc, lab, 0)
        LowJumpIfFalse = 1
    End If
End Function

Function LowJumpIfTrue(ctx As *LowerCtx, idx As Long, lab As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim op As Long
    Dim jcc As Long
    Dim jTrue As Long
    Dim labSkip As Long

    LowJumpIfTrue = 0
    ast = ctx.ast
    nodes = ast.nodes
    If nodes[idx].kind <> AST_BINOP Then
        ctx.err = 1
        Exit Function
    End If
    op = nodes[idx].num
    If op = BOP_OR Then
        If LowJumpIfTrue(ctx, nodes[idx].left, lab) = 0 Then Exit Function
        If LowJumpIfTrue(ctx, nodes[idx].right, lab) = 0 Then Exit Function
        LowJumpIfTrue = 1
    ElseIf op = BOP_AND Then
        labSkip = LowNewLab(ctx)
        If LowJumpIfFalse(ctx, nodes[idx].left, labSkip) = 0 Then Exit Function
        If LowJumpIfTrue(ctx, nodes[idx].right, lab) = 0 Then Exit Function
        IrEmit(ctx.list, OP_LABEL, labSkip, 0)
        LowJumpIfTrue = 1
    Else
        jcc = LowCmpFalseJcc(ctx, idx)
        If jcc = 0 Then Exit Function
        jTrue = LowCmpTrueJcc(jcc)
        If jTrue = 0 Then
            ctx.err = 1
            Exit Function
        End If
        IrEmit(ctx.list, jTrue, lab, 0)
        LowJumpIfTrue = 1
    End If
End Function

Function LowStmt(ctx As *LowerCtx, idx As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim k As Long
    Dim name(63) As Byte
    Dim si As Long
    Dim offs As *Long
    Dim labElse As Long
    Dim labEnd As Long
    Dim labTop As Long
    Dim lab As Long
    Dim labStr As Long
    Dim jcc As Long
    Dim body As Long
    Dim leftK As Long
    Dim leftIdx As Long
    Dim tt As *TypeTable
    Dim typeIdxs As *Long
    Dim foff As Long
    Dim fsz As Long
    Dim fcnt As Long
    Dim ti As Long
    Dim fname(63) As Byte
    Dim base As Long
    Dim ix As Long
    Dim saveDo As Long
    Dim saveWhile As Long
    Dim saveFor As Long
    Dim byRefs As *Long
    Dim types As *Long
    Dim list As *IrList
    Dim args(15) As Long
    Dim argi As Long
    Dim argn As Long
    Dim nArgs As Long
    Dim stk As Long
    Dim labSub As Long
    Dim labDone As Long
    Dim sApi(31) As Byte

    LowStmt = 0
    If idx < 0 Then
        LowStmt = 1
        Exit Function
    End If
    ast = ctx.ast
    nodes = ast.nodes
    k = nodes[idx].kind
    tt = ast.types
    typeIdxs = ctx.typeIdxs

    If k = AST_DIM Then
        If nodes[idx].right >= 0 Then
            If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
            AstCopyStr(ast, idx, VarPtr(name))
            If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
                ctx.err = 1
                Exit Function
            End If
            LowEmitStoreOff(ctx.list, vOff, vGlob)
        End If
        LowStmt = 1
    ElseIf k = AST_CONST Then
        LowStmt = 1
    ElseIf k = AST_TYPE Then
        LowStmt = 1
    ElseIf k = AST_ASSIGN Then
        leftIdx = nodes[idx].left
        leftK = nodes[leftIdx].kind
        If leftK = AST_INDEX Or leftK = AST_CALL Then
            If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
            IrEmit(ctx.list, OP_PUSH_RAX, 0, 0)
            If LowAddr(ctx, nodes[idx].left) = 0 Then Exit Function
            IrEmit(ctx.list, OP_POP_RCX, 0, 0)
            If leftK = AST_CALL Then
                AstCopyStr(ast, leftIdx, VarPtr(name))
                If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
                    If vTy = TY_LONG_ARR Or vTy = TY_STRING_ARR Or vTy = TY_DOUBLE_ARR Then
                        IrEmit(ctx.list, OP_STORE_QWORD_RAX_RCX, 0, 0)
                    Else
                        IrEmit(ctx.list, OP_STORE_BYTE_RAX_CL, 0, 0)
                    End If
                Else
                    IrEmit(ctx.list, OP_STORE_BYTE_RAX_CL, 0, 0)
                End If
            Else
                base = nodes[leftIdx].left
                If nodes[base].kind = AST_MEMBER Then
                    AstCopyStr(ast, base, VarPtr(fname))
                    ix = nodes[base].left
                    If nodes[ix].kind = AST_INDEX Then
                        AstCopyStr(ast, nodes[ix].left, VarPtr(name))
                    ElseIf nodes[ix].kind = AST_VAR Then
                        AstCopyStr(ast, ix, VarPtr(name))
                    Else
                        ctx.err = 1
                        Exit Function
                    End If
                    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
                        ctx.err = 1
                        Exit Function
                    End If
                    ti = vTypeIdx
                    If TyFindField(tt, ti, VarPtr(fname), foff, fsz, fcnt) = 0 Then
                        ctx.err = 1
                        Exit Function
                    End If
                    If fcnt > 1 Then
                        LowStoreSized(ctx.list, fsz)
                    ElseIf fsz = 8 Then
                        LowStoreSized(ctx.list, 1)
                    Else
                        ctx.err = 1
                        Exit Function
                    End If
                Else
                    AstCopyStr(ast, base, VarPtr(name))
                    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
                        If vTy = TY_LONG_ARR Or vTy = TY_STRING_ARR Or vTy = TY_DOUBLE_ARR Then
                            IrEmit(ctx.list, OP_STORE_QWORD_RAX_RCX, 0, 0)
                        ElseIf vTy = TY_PTR_LONG Then
                            LowStoreSized(ctx.list, 4)
                        Else
                            IrEmit(ctx.list, OP_STORE_BYTE_RAX_CL, 0, 0)
                        End If
                    Else
                        IrEmit(ctx.list, OP_STORE_BYTE_RAX_CL, 0, 0)
                    End If
                End If
            End If
            LowStmt = 1
        ElseIf leftK = AST_MEMBER Then
            If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
            IrEmit(ctx.list, OP_PUSH_RAX, 0, 0)
            If LowAddr(ctx, nodes[idx].left) = 0 Then Exit Function
            IrEmit(ctx.list, OP_POP_RCX, 0, 0)
            fsz = LowMemberFieldSize(ctx, leftIdx)
            If fsz <= 0 Then
                ctx.err = 1
                Exit Function
            End If
            LowStoreSized(ctx.list, fsz)
            LowStmt = 1
        ElseIf leftK = AST_VAR Then
            If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
            AstCopyStr(ast, nodes[idx].left, VarPtr(name))
            If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
                ctx.err = 1
                Exit Function
            End If
            If vByRef <> 0 Then
                IrEmit(ctx.list, OP_PUSH_RAX, 0, 0)
                LowEmitLoadOff(ctx.list, vOff, vGlob)
                IrEmit(ctx.list, OP_POP_RCX, 0, 0)
                IrEmit(ctx.list, OP_STORE_QWORD_RAX_RCX, 0, 0)
            Else
                LowEmitStoreOff(ctx.list, vOff, vGlob)
            End If
            LowStmt = 1
        Else
            ctx.err = 1
        End If
    ElseIf k = AST_FUNC Then
        ' emitted separately
        LowStmt = 1
    ElseIf k = AST_DECLARE Then
        ' 宣言のみ（コード生成なし）
        LowStmt = 1
    ElseIf k = AST_INSMENU Then
        ' InsertMenuA(hMenu, pos, flags, uIDNewItem, lpNewItem)
        list = ctx.list
        argi = 0
        argn = nodes[idx].left
        While argn >= 0
            If argi >= 16 Then
                ctx.err = 1
                Exit Function
            End If
            args[argi] = argn
            argi = argi + 1
            argn = nodes[argn].nxt
        Wend
        nArgs = argi
        If nArgs < 3 Then
            ctx.err = 1
            Exit Function
        End If
        stk = 48
        IrEmit(list, OP_SUB_RSP, stk, 0)
        ' lpNewItem（第5引数）
        If nArgs >= 4 Then
            If LowExpr(ctx, nodes[args[3]].left) = 0 Then Exit Function
        Else
            IrEmit(list, OP_XOR_EAX, 0, 0)
        End If
        IrEmit(list, OP_STORE_RSP_RAX, 32, 0)
        If nArgs >= 6 Then
            ' hSubMenu <> 0 なら uIDNewItem = hSubMenu かつ MF_POPUP
            labSub = LowNewLab(ctx)
            labDone = LowNewLab(ctx)
            If LowExpr(ctx, nodes[args[5]].left) = 0 Then Exit Function
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            IrEmit(list, OP_TEST_RAX, 0, 0)
            IrEmit(list, OP_JNZ, labSub, 0)
            IrEmit(list, OP_POP_RAX, 0, 0)
            If LowExpr(ctx, nodes[args[4]].left) = 0 Then Exit Function
            IrEmit(list, OP_MOV_R9_RAX, 0, 0)
            If LowExpr(ctx, nodes[args[2]].left) = 0 Then Exit Function
            IrEmit(list, OP_MOV_R8_RAX, 0, 0)
            IrEmit(list, OP_JMP, labDone, 0)
            IrEmit(list, OP_LABEL, labSub, 0)
            IrEmit(list, OP_POP_RAX, 0, 0)
            IrEmit(list, OP_MOV_R9_RAX, 0, 0)
            If LowExpr(ctx, nodes[args[2]].left) = 0 Then Exit Function
            IrEmit(list, OP_MOV_ECX, LOW_MF_POPUP, 0)
            IrEmit(list, OP_OR_EAX_ECX, 0, 0)
            IrEmit(list, OP_MOV_R8_RAX, 0, 0)
            IrEmit(list, OP_LABEL, labDone, 0)
        Else
            If nArgs >= 5 Then
                If LowExpr(ctx, nodes[args[4]].left) = 0 Then Exit Function
            Else
                IrEmit(list, OP_XOR_EAX, 0, 0)
            End If
            IrEmit(list, OP_MOV_R9_RAX, 0, 0)
            If LowExpr(ctx, nodes[args[2]].left) = 0 Then Exit Function
            If nArgs = 3 Then
                IrEmit(list, OP_MOV_ECX, LOW_MF_SEPARATOR, 0)
                IrEmit(list, OP_OR_EAX_ECX, 0, 0)
            End If
            IrEmit(list, OP_MOV_R8_RAX, 0, 0)
        End If
        If LowExpr(ctx, nodes[args[1]].left) = 0 Then Exit Function
        IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
        If LowExpr(ctx, nodes[args[0]].left) = 0 Then Exit Function
        IrEmit(list, OP_MOV_RCX_RAX, 0, 0)
        lstrcpy(VarPtr(sApi), "InsertMenuA")
        IrEmitStr(list, OP_CALL_API, IR_DLL_USER32, VarPtr(sApi))
        IrEmit(list, OP_ADD_RSP, stk, 0)
        LowStmt = 1
    ElseIf k = AST_CALL Then
        If LowExpr(ctx, idx) = 0 Then Exit Function
        LowStmt = 1
    ElseIf k = AST_EXIT Then
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        LowEmitExitEax(ctx)
        LowStmt = 1
    ElseIf k = AST_EXITDO Then
        If g_doEndLab < 0 Then
            ctx.err = 1
            Exit Function
        End If
        IrEmit(ctx.list, OP_JMP, g_doEndLab, 0)
        LowStmt = 1
    ElseIf k = AST_EXITWHILE Then
        If g_whileEndLab < 0 Then
            ctx.err = 1
            Exit Function
        End If
        IrEmit(ctx.list, OP_JMP, g_whileEndLab, 0)
        LowStmt = 1
    ElseIf k = AST_EXITFOR Then
        If g_forEndLab < 0 Then
            ctx.err = 1
            Exit Function
        End If
        IrEmit(ctx.list, OP_JMP, g_forEndLab, 0)
        LowStmt = 1
    ElseIf k = AST_EXITFUNC Then
        If g_funcEndLab < 0 Then
            ctx.err = 1
            Exit Function
        End If
        IrEmit(ctx.list, OP_JMP, g_funcEndLab, 0)
        LowStmt = 1
    ElseIf k = AST_END Then
        LowEmitExitImm(ctx, 0)
        LowStmt = 1
    ElseIf k = AST_PRINT Then
        lab = LowEnsureRtPrint(ctx)
        AstCopyStr(ctx.ast, nodes[idx].left, VarPtr(name))
        vTy = -1
        If nodes[idx].left >= 0 Then
            If nodes[nodes[idx].left].kind = AST_VAR Then
                If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
                    vTy = -1
                End If
            End If
        End If
        If vTy = TY_BYTE_ARR Then
            If LowExprArg(ctx, nodes[idx].left) = 0 Then Exit Function
            IrEmit(ctx.list, OP_MOV_RCX_RAX, 0, 0)
            IrEmit(ctx.list, OP_CALL_LAB, lab, 0)
            LowStmt = 1
            Exit Function
        End If
        If vTy = TY_PTR_BYTE Then
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            IrEmit(ctx.list, OP_MOV_RCX_RAX, 0, 0)
            IrEmit(ctx.list, OP_CALL_LAB, lab, 0)
            LowStmt = 1
            Exit Function
        End If
        If LowIsStringExpr(ctx, nodes[idx].left) = 0 Then
            labStr = LowEnsureRtStr(ctx)
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            IrEmit(ctx.list, OP_MOV_RCX_RAX, 0, 0)
            IrEmit(ctx.list, OP_CALL_LAB, labStr, 0)
        Else
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        End If
        IrEmit(ctx.list, OP_MOV_RCX_RAX, 0, 0)
        IrEmit(ctx.list, OP_CALL_LAB, lab, 0)
        LowStmt = 1
    ElseIf k = AST_INPUT Then
        ' Input var$ ― String のみ（1行読み取り）
        If nodes[idx].left < 0 Then
            ctx.err = 1
            Exit Function
        End If
        If nodes[nodes[idx].left].kind <> AST_VAR Then
            ctx.err = 1
            Exit Function
        End If
        AstCopyStr(ast, nodes[idx].left, VarPtr(name))
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
            ctx.err = 1
            Exit Function
        End If
        If vTy <> TY_STRING Then
            ctx.err = 1
            Exit Function
        End If
        lab = LowEnsureRtInput(ctx)
        IrEmit(ctx.list, OP_CALL_LAB, lab, 0)
        If vByRef <> 0 Then
            IrEmit(ctx.list, OP_PUSH_RAX, 0, 0)
            LowEmitLoadOff(ctx.list, vOff, vGlob)
            IrEmit(ctx.list, OP_POP_RCX, 0, 0)
            IrEmit(ctx.list, OP_STORE_QWORD_RAX_RCX, 0, 0)
        Else
            LowEmitStoreOff(ctx.list, vOff, vGlob)
        End If
        LowStmt = 1
    ElseIf k = AST_IF Then
        labElse = LowNewLab(ctx)
        labEnd = LowNewLab(ctx)
        If LowJumpIfFalse(ctx, nodes[idx].left, labElse) = 0 Then
            Exit Function
        End If
        If LowStmtList(ctx, nodes[idx].right) = 0 Then
            Exit Function
        End If
        IrEmit(ctx.list, OP_JMP, labEnd, 0)
        IrEmit(ctx.list, OP_LABEL, labElse, 0)
        If LowStmtList(ctx, nodes[idx].extra) = 0 Then
            Exit Function
        End If
        IrEmit(ctx.list, OP_LABEL, labEnd, 0)
        LowStmt = 1
    ElseIf k = AST_DO Then
        labTop = LowNewLab(ctx)
        labEnd = LowNewLab(ctx)
        saveDo = g_doEndLab
        g_doEndLab = labEnd
        IrEmit(ctx.list, OP_LABEL, labTop, 0)
        If LowStmtList(ctx, nodes[idx].right) = 0 Then Exit Function
        IrEmit(ctx.list, OP_JMP, labTop, 0)
        IrEmit(ctx.list, OP_LABEL, labEnd, 0)
        g_doEndLab = saveDo
        LowStmt = 1
    ElseIf k = AST_WHILE Then
        labTop = LowNewLab(ctx)
        labEnd = LowNewLab(ctx)
        saveWhile = g_whileEndLab
        g_whileEndLab = labEnd
        IrEmit(ctx.list, OP_LABEL, labTop, 0)
        If LowJumpIfFalse(ctx, nodes[idx].left, labEnd) = 0 Then Exit Function
        If LowStmtList(ctx, nodes[idx].right) = 0 Then Exit Function
        IrEmit(ctx.list, OP_JMP, labTop, 0)
        IrEmit(ctx.list, OP_LABEL, labEnd, 0)
        g_whileEndLab = saveWhile
        LowStmt = 1
    ElseIf k = AST_FOR Then
        ' left=var, right=from, extra=to, num=body
        If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
        AstCopyStr(ast, nodes[idx].left, VarPtr(name))
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
            ctx.err = 1
            Exit Function
        End If
        LowEmitStoreOff(ctx.list, vOff, vGlob)
        labTop = LowNewLab(ctx)
        labEnd = LowNewLab(ctx)
        saveFor = g_forEndLab
        g_forEndLab = labEnd
        IrEmit(ctx.list, OP_LABEL, labTop, 0)
        LowEmitLoadOff(ctx.list, vOff, vGlob)
        IrEmit(ctx.list, OP_PUSH_RAX, 0, 0)
        If LowExpr(ctx, nodes[idx].extra) = 0 Then Exit Function
        IrEmit(ctx.list, OP_POP_RCX, 0, 0)
        IrEmit(ctx.list, OP_CMP_ECX_EAX, 0, 0)
        ' exit when i > to  (ecx=i, eax=to)
        IrEmit(ctx.list, OP_JG, labEnd, 0)
        body = nodes[idx].num
        If LowStmtList(ctx, body) = 0 Then Exit Function
        If vGlob <> 0 Then
            LowEmitLoadOff(ctx.list, vOff, vGlob)
            IrEmit(ctx.list, OP_MOV_ECX, 1, 0)
            IrEmit(ctx.list, OP_ADD_EAX_ECX, 0, 0)
            LowEmitStoreOff(ctx.list, vOff, vGlob)
        Else
            IrEmit(ctx.list, OP_INC_LOCAL, vOff, 0)
        End If
        IrEmit(ctx.list, OP_JMP, labTop, 0)
        IrEmit(ctx.list, OP_LABEL, labEnd, 0)
        g_forEndLab = saveFor
        LowStmt = 1
    Else
        Print "error: unsupported statement kind " + Str$(k)
        ctx.err = 1
    End If
End Function

Function LowStmtList(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim cur As Long

    LowStmtList = 0
    ast = ctx.ast
    nodes = ast.nodes
    cur = idx
    While cur >= 0
        If LowStmt(ctx, cur) = 0 Then Exit Function
        cur = nodes[cur].nxt
    Wend
    LowStmtList = 1
End Function

' Register one AST_DIM (asGlob=1 -> module global, else local). Returns 0 on error.
Function LowRegisterDimNode(ctx As *LowerCtx, dimIdx As Long, asGlob As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim nm(63) As Byte
    Dim ty As Long
    Dim nbytes As Long
    Dim ti As Long
    Dim bound As Long
    Dim tt As *TypeTable
    Dim tsizes As *Long

    LowRegisterDimNode = 0
    ast = ctx.ast
    nodes = ast.nodes
    tt = ast.types
    AstCopyStr(ast, dimIdx, VarPtr(nm))
    ty = nodes[dimIdx].num
    nbytes = 8
    ti = -1
    If ty = TY_BYTE_ARR Then
        bound = LowBoundVal(ctx, nodes[dimIdx].left)
        If bound < 0 Then Exit Function
        nbytes = bound + 1
    ElseIf ty = TY_LONG_ARR Then
        bound = LowBoundVal(ctx, nodes[dimIdx].left)
        If bound < 0 Then Exit Function
        nbytes = (bound + 1) * 8
    ElseIf ty = TY_DOUBLE_ARR Then
        bound = LowBoundVal(ctx, nodes[dimIdx].left)
        If bound < 0 Then Exit Function
        nbytes = (bound + 1) * 8
    ElseIf ty = TY_STRING_ARR Then
        bound = LowBoundVal(ctx, nodes[dimIdx].left)
        If bound < 0 Then Exit Function
        nbytes = (bound + 1) * 8
    ElseIf ty = TY_BYTE Then
        nbytes = 1
    ElseIf ty = TY_DOUBLE Then
        nbytes = 8
    ElseIf ty = TY_UDT Then
        ti = nodes[dimIdx].extra
        If ti < 0 Then Exit Function
        tsizes = tt.typeSizes
        nbytes = tsizes[ti]
        If nbytes <= 0 Then Exit Function
    ElseIf ty = TY_PTR_UDT Then
        ti = nodes[dimIdx].extra
        If ti < 0 Then Exit Function
        nbytes = 8
    End If
    If asGlob <> 0 Then
        If LowAddGlob(ctx, VarPtr(nm), ty, nbytes, ti) < 0 Then Exit Function
    Else
        If LowAddSym(ctx, VarPtr(nm), ty, nbytes, ti, 0) < 0 Then Exit Function
    End If
    LowRegisterDimNode = 1
End Function

' Walk statement list (and nested If/While/For/Do bodies) to register Dims.
Function LowCollectDimsInList(ctx As *LowerCtx, idx As Long, asGlob As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim cur As Long
    Dim k As Long

    LowCollectDimsInList = 0
    ast = ctx.ast
    nodes = ast.nodes
    cur = idx
    While cur >= 0
        k = nodes[cur].kind
        If k = AST_DIM Then
            If LowRegisterDimNode(ctx, cur, asGlob) = 0 Then Exit Function
        ElseIf k = AST_IF Then
            If LowCollectDimsInList(ctx, nodes[cur].right, asGlob) = 0 Then Exit Function
            If LowCollectDimsInList(ctx, nodes[cur].extra, asGlob) = 0 Then Exit Function
        ElseIf k = AST_WHILE Then
            If LowCollectDimsInList(ctx, nodes[cur].right, asGlob) = 0 Then Exit Function
        ElseIf k = AST_DO Then
            If LowCollectDimsInList(ctx, nodes[cur].right, asGlob) = 0 Then Exit Function
        ElseIf k = AST_FOR Then
            If LowCollectDimsInList(ctx, nodes[cur].num, asGlob) = 0 Then Exit Function
        End If
        cur = nodes[cur].nxt
    Wend
    LowCollectDimsInList = 1
End Function

Function AstToIr(ast As *Ast, list As *IrList, ByRef subsystemOut As Long) As Long
    Dim ctx As LowerCtx
    Dim nodes As *AstNode
    Dim prog As Long
    Dim stmt As Long
    Dim nPrint As Long
    Dim namesBuf As *Byte
    Dim offsBuf As *Long
    Dim typesBuf As *Long
    Dim typeIdxsBuf As *Long
    Dim byRefsBuf As *Long
    Dim gNamesBuf As *Byte
    Dim gOffsBuf As *Long
    Dim gTypesBuf As *Long
    Dim gTypeIdxsBuf As *Long
    Dim funcNamesBuf As *Byte
    Dim funcLabsBuf As *Long
    Dim funcByRefsBuf As *Long
    Dim constNamesBuf As *Byte
    Dim constValsBuf As *Long
    Dim constStrNamesBuf As *Byte
    Dim constStrValsBuf As *Byte
    Dim declNamesBuf As *Byte
    Dim declApiNamesBuf As *Byte
    Dim declDllsBuf As *Byte
    Dim declByRefsBuf As *Byte
    Dim dllKind As Long
    Dim apiBuf(63) As Byte
    Dim libBuf(63) As Byte
    Dim sConst(255) As Byte
    Dim byRefBits As Long
    Dim bit As Long
    Dim isByRef As Long
    Dim retBuf(63) As Byte
    Dim nm(63) As Byte
    Dim labMain As Long
    Dim labFn As Long
    Dim frame As Long
    Dim param As Long
    Dim pi As Long
    Dim offs As *Long
    Dim ty As Long
    Dim bound As Long
    Dim nbytes As Long
    Dim ti As Long
    Dim tt As *TypeTable
    Dim tsizes As *Long
    Dim nFlags As Long
    Dim body As Long

    AstToIr = 0
    subsystemOut = IMAGE_SUBSYSTEM_WINDOWS_CUI
    If ast.root < 0 Then Exit Function
    nodes = ast.nodes
    prog = ast.root
    If nodes[prog].kind <> AST_PROGRAM Then Exit Function
    tt = ast.types

    namesBuf = calloc(SYM_MAX * SYM_NAME_LEN)
    offsBuf = calloc(SizeOf(Long) * SYM_MAX)
    typesBuf = calloc(SizeOf(Long) * SYM_MAX)
    typeIdxsBuf = calloc(SizeOf(Long) * SYM_MAX)
    byRefsBuf = calloc(SizeOf(Long) * SYM_MAX)
    gNamesBuf = calloc(SYM_MAX * SYM_NAME_LEN)
    gOffsBuf = calloc(SizeOf(Long) * SYM_MAX)
    gTypesBuf = calloc(SizeOf(Long) * SYM_MAX)
    gTypeIdxsBuf = calloc(SizeOf(Long) * SYM_MAX)
    funcNamesBuf = calloc(SYM_MAX * SYM_NAME_LEN)
    funcLabsBuf = calloc(SizeOf(Long) * SYM_MAX)
    funcByRefsBuf = calloc(SizeOf(Long) * SYM_MAX)
    constNamesBuf = calloc(SYM_MAX * SYM_NAME_LEN)
    constValsBuf = calloc(SizeOf(Long) * SYM_MAX)
    constStrNamesBuf = calloc(SYM_MAX * SYM_NAME_LEN)
    constStrValsBuf = calloc(SYM_MAX * AST_STR_LEN)
    declNamesBuf = calloc(SYM_MAX * SYM_NAME_LEN)
    declApiNamesBuf = calloc(SYM_MAX * SYM_NAME_LEN)
    declDllsBuf = calloc(SizeOf(Long) * SYM_MAX)
    declByRefsBuf = calloc(SizeOf(Long) * SYM_MAX)
    g_fb0 = namesBuf
    g_fb1 = offsBuf
    g_fb2 = typesBuf
    g_fb3 = typeIdxsBuf
    g_fb4 = byRefsBuf
    g_fb5 = gNamesBuf
    g_fb6 = gOffsBuf
    g_fb7 = gTypesBuf
    g_fb8 = gTypeIdxsBuf
    g_fb9 = funcNamesBuf
    g_fb10 = funcLabsBuf
    g_fb11 = funcByRefsBuf
    g_fb12 = constNamesBuf
    g_fb13 = constValsBuf
    g_fb14 = constStrNamesBuf
    g_fb15 = constStrValsBuf
    g_fb16 = declNamesBuf
    g_fb17 = declApiNamesBuf
    g_fb18 = declDllsBuf
    g_fb19 = declByRefsBuf
    If namesBuf = NULL Or offsBuf = NULL Or typesBuf = NULL Or typeIdxsBuf = NULL Or byRefsBuf = NULL Or gNamesBuf = NULL Or gOffsBuf = NULL Or gTypesBuf = NULL Or gTypeIdxsBuf = NULL Or funcNamesBuf = NULL Or funcLabsBuf = NULL Or funcByRefsBuf = NULL Or constNamesBuf = NULL Or constValsBuf = NULL Or constStrNamesBuf = NULL Or constStrValsBuf = NULL Or declNamesBuf = NULL Or declApiNamesBuf = NULL Or declDllsBuf = NULL Or declByRefsBuf = NULL Then
        LowFreeAstBufs()
        Exit Function
    End If

    g_gNames = gNamesBuf
    g_gOffs = gOffsBuf
    g_gTypes = gTypesBuf
    g_gTypeIdxs = gTypeIdxsBuf
    g_gCount = 0
    g_gSize = 0

    ctx.list = list
    ctx.ast = ast
    ctx.symCount = 0
    ctx.nextLab = 0
    ctx.err = 0
    ctx.names = namesBuf
    ctx.offs = offsBuf
    ctx.types = typesBuf
    ctx.typeIdxs = typeIdxsBuf
    ctx.byRefs = byRefsBuf
    ctx.frameUsed = 0
    ctx.inFunc = 0
    ctx.funcNames = funcNamesBuf
    ctx.funcLabs = funcLabsBuf
    ctx.funcByRefs = funcByRefsBuf
    ctx.funcCount = 0
    ctx.constNames = constNamesBuf
    ctx.constVals = constValsBuf
    ctx.constCount = 0
    ctx.constStrNames = constStrNamesBuf
    ctx.constStrVals = constStrValsBuf
    ctx.constStrCount = 0
    ctx.declNames = declNamesBuf
    ctx.declApiNames = declApiNamesBuf
    ctx.declDlls = declDllsBuf
    ctx.declByRefs = declByRefsBuf
    ctx.declCount = 0
    g_doEndLab = -1
    g_whileEndLab = -1
    g_forEndLab = -1
    g_funcEndLab = -1
    g_rtCatLab = -1
    g_rtMidLab = -1
    g_rtStrLab = -1
    g_rtPrintLab = -1
    g_rtInputLab = -1
    retBuf[0] = 0
    list.globSize = 0

    nPrint = 0
    stmt = nodes[prog].left
    While stmt >= 0
        If nodes[stmt].kind = AST_PRINT Then nPrint = nPrint + 1
        stmt = nodes[stmt].nxt
    Wend
    ' #USEWINDOW による GUI サブシステム切り替えは CompileSource 側で行う

    ' Declare Lib（DLL 種別・エクスポート名・ByRef ビット）を登録
    stmt = nodes[prog].left
    While stmt >= 0
        If nodes[stmt].kind = AST_DECLARE Then
            AstCopyStr(ast, stmt, VarPtr(nm))
            libBuf[0] = 0
            apiBuf[0] = 0
            If nodes[stmt].right >= 0 Then
                AstCopyStr(ast, nodes[stmt].right, VarPtr(libBuf))
            End If
            If nodes[stmt].extra >= 0 Then
                AstCopyStr(ast, nodes[stmt].extra, VarPtr(apiBuf))
            End If
            If apiBuf[0] = 0 Then
                AstCopyStr(ast, stmt, VarPtr(apiBuf))
            End If
            dllKind = LowDllKindFromLib(VarPtr(libBuf))
            If dllKind = 0 Then
                Print "error: unknown Declare Lib '" + MakeStr(VarPtr(libBuf)) + "' for '" + MakeStr(VarPtr(nm)) + "'"
                LowFreeAstBufs()
                Exit Function
            End If
            byRefBits = 0
            bit = 1
            param = nodes[stmt].left
            While param >= 0
                If nodes[param].num <> 0 Then
                    byRefBits = byRefBits + bit
                End If
                bit = bit * 2
                param = nodes[param].nxt
            Wend
            If LowAddDecl(VarPtr(ctx), VarPtr(nm), VarPtr(apiBuf), dllKind, byRefBits) = 0 Then
                LowFreeAstBufs()
                Exit Function
            End If
        End If
        stmt = nodes[stmt].nxt
    Wend

    ' consts（数値 / 文字列）
    stmt = nodes[prog].left
    While stmt >= 0
        If nodes[stmt].kind = AST_CONST Then
            AstCopyStr(ast, stmt, VarPtr(nm))
            If nodes[stmt].extra <> 0 Then
                sConst[0] = 0
                If nodes[stmt].left >= 0 Then
                    AstCopyStr(ast, nodes[stmt].left, VarPtr(sConst))
                End If
                If LowAddStrConst(VarPtr(ctx), VarPtr(nm), VarPtr(sConst)) = 0 Then
                    LowFreeAstBufs()
                    Exit Function
                End If
            Else
                If LowAddConst(VarPtr(ctx), VarPtr(nm), nodes[stmt].num) = 0 Then
                    LowFreeAstBufs()
                    Exit Function
                End If
            End If
        End If
        stmt = nodes[stmt].nxt
    Wend

    ' register functions
    stmt = nodes[prog].left
    While stmt >= 0
        If nodes[stmt].kind = AST_FUNC Then
            labFn = LowNewLab(VarPtr(ctx))
            AstCopyStr(ast, stmt, VarPtr(nm))
            byRefBits = 0
            bit = 1
            param = nodes[stmt].left
            While param >= 0
                If nodes[param].num <> 0 Then
                    byRefBits = byRefBits + bit
                End If
                bit = bit * 2
                param = nodes[param].nxt
            Wend
            If LowAddFunc(VarPtr(ctx), VarPtr(nm), labFn, byRefBits) = 0 Then
                LowFreeAstBufs()
                Exit Function
            End If
            nodes[stmt].extra = labFn
        End If
        stmt = nodes[stmt].nxt
    Wend

    ' module-level Dim -> globals (before any function emit; nested Dims in main too)
    If LowCollectDimsInList(VarPtr(ctx), nodes[prog].left, 1) = 0 Then
        LowFreeAstBufs()
        Exit Function
    End If
    list.globSize = g_gSize

    labMain = LowNewLab(VarPtr(ctx))
    IrEmit(list, OP_JMP, labMain, 0)

    ' emit functions
    stmt = nodes[prog].left
    While stmt >= 0
        If nodes[stmt].kind = AST_FUNC Then
            ctx.symCount = 0
            ctx.frameUsed = 0
            ctx.inFunc = 1
            g_doEndLab = -1
            g_whileEndLab = -1
            g_forEndLab = -1
            g_funcEndLab = -1
            nFlags = nodes[stmt].num
            If nFlags >= 256 Then
                retBuf[0] = 0
            Else
                AstCopyStr(ast, stmt, VarPtr(retBuf))
            End If
            param = nodes[stmt].left
            While param >= 0
                AstCopyStr(ast, param, VarPtr(nm))
                isByRef = nodes[param].num
                ty = nodes[param].extra
                If ty < 0 Then ty = TY_LONG
                ti = nodes[param].right
                nbytes = 8
                If LowAddSym(VarPtr(ctx), VarPtr(nm), ty, nbytes, ti, isByRef) < 0 Then
                    LowFreeAstBufs()
                    Exit Function
                End If
                param = nodes[param].nxt
            Wend
            If retBuf[0] <> 0 Then
                ty = nodes[stmt].extra
                If ty <> TY_STRING Then
                    If ty <> TY_DOUBLE Then
                        ty = TY_LONG
                    End If
                End If
                If LowAddSym(VarPtr(ctx), VarPtr(retBuf), ty, 8, -1, 0) < 0 Then
                    LowFreeAstBufs()
                    Exit Function
                End If
            End If
            ' locals: all Dims in body including nested If/Select/loops
            If LowCollectDimsInList(VarPtr(ctx), nodes[stmt].right, 0) = 0 Then
                LowFreeAstBufs()
                Exit Function
            End If
            frame = LowAlign16(ctx.frameUsed + &H28)
            If frame < &H28 Then frame = &H28
            g_funcEndLab = LowNewLab(VarPtr(ctx))
            IrEmit(list, OP_LABEL, nodes[stmt].extra, 0)
            IrEmit(list, OP_ENTER, frame, 0)
            offs = ctx.offs
            pi = 0
            param = nodes[stmt].left
            While param >= 0
                If pi = 0 Then
                    IrEmit(list, OP_STORE_LOCAL_ECX, offs[pi], 0)
                ElseIf pi = 1 Then
                    IrEmit(list, OP_STORE_LOCAL_EDX, offs[pi], 0)
                ElseIf pi = 2 Then
                    IrEmit(list, OP_STORE_LOCAL_R8, offs[pi], 0)
                ElseIf pi = 3 Then
                    IrEmit(list, OP_STORE_LOCAL_R9, offs[pi], 0)
                Else
                    ' stack arg already at [rbp+0x30+(pi-4)*8]
                    offs[pi] = 48 + (pi - 4) * 8
                End If
                pi = pi + 1
                param = nodes[param].nxt
            Wend
            If retBuf[0] <> 0 Then
                pi = LowFindSym(VarPtr(ctx), VarPtr(retBuf))
                If pi < 0 Then
                    LowFreeAstBufs()
                    Exit Function
                End If
                IrEmit(list, OP_MOV_EAX_IMM, 0, 0)
                IrEmit(list, OP_STORE_LOCAL, offs[pi], 0)
            End If
            If LowStmtList(VarPtr(ctx), nodes[stmt].right) = 0 Or ctx.err <> 0 Then
                LowFreeAstBufs()
                Exit Function
            End If
            IrEmit(list, OP_LABEL, g_funcEndLab, 0)
            If retBuf[0] <> 0 Then
                pi = LowFindSym(VarPtr(ctx), VarPtr(retBuf))
                If pi < 0 Then
                    LowFreeAstBufs()
                    Exit Function
                End If
                IrEmit(list, OP_LOAD_LOCAL, offs[pi], 0)
            End If
            IrEmit(list, OP_LEAVE, 0, 0)
            ctx.inFunc = 0
            g_funcEndLab = -1
            retBuf[0] = 0
        End If
        stmt = nodes[stmt].nxt
    Wend

    ' main: module Dims are globals; frame only needs temps (16-byte aligned)
    ctx.symCount = 0
    ctx.frameUsed = 0
    frame = LowAlign16(&H28)

    IrEmit(list, OP_LABEL, labMain, 0)
    IrEmit(list, OP_ENTER, frame, 0)

    stmt = nodes[prog].left
    While stmt >= 0
        If nodes[stmt].kind <> AST_FUNC And nodes[stmt].kind <> AST_CONST And nodes[stmt].kind <> AST_TYPE Then
            If LowStmt(VarPtr(ctx), stmt) = 0 Or ctx.err <> 0 Then
                LowFreeAstBufs()
                Exit Function
            End If
        End If
        stmt = nodes[stmt].nxt
    Wend

    LowEmitExitImm(VarPtr(ctx), 0)
    IrEmit(list, OP_LEAVE, 0, 0)

    LowEmitRtCatBody(VarPtr(ctx))
    LowEmitRtMidBody(VarPtr(ctx))
    LowEmitRtStrBody(VarPtr(ctx))
    LowEmitRtPrintBody(VarPtr(ctx))
    LowEmitRtInputBody(VarPtr(ctx))

    LowFreeAstBufs()
    g_gNames = NULL
    g_gOffs = NULL
    g_gTypes = NULL
    g_gTypeIdxs = NULL
    g_gCount = 0
    g_gSize = 0
    AstToIr = 1
End Function

