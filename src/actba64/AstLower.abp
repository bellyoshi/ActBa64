    Dim i As Long
    Dim names As *Byte
    Dim off As Long
    LowFindDecl = -1
    names = ctx->declNames
    i = 0
    While i < ctx->declCount
        off = i * SYM_NAME_LEN
        If LowNameEq(VarPtr(names[off]), name) <> 0 Then
            LowFindDecl = i
