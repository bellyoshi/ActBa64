Sub LowResetFnPreciseRoots()
    g_fnPreciseRootCount = 0
End Sub

Sub LowAppendFnPreciseRoot(off As Long)
    If g_fnPreciseRoots = NULL Then Exit Sub
    If g_fnPreciseRootCount >= GC_MAX_PRECISE Then Exit Sub
    g_fnPreciseRoots[g_fnPreciseRootCount] = off
    g_fnPreciseRootCount = g_fnPreciseRootCount + 1
End Sub

Sub LowRetargetFnPreciseRoot(oldOff As Long, newOff As Long)
    Dim i As Long
    If g_fnPreciseRoots = NULL Then Exit Sub
    i = 0
    While i < g_fnPreciseRootCount
        If g_fnPreciseRoots[i] = oldOff Then
            g_fnPreciseRoots[i] = newOff
        End If
        i = i + 1
    Wend
End Sub

Sub LowAppendFnPreciseStringArr(baseOff As Long, nbytes As Long)
    Dim j As Long
    Dim n As Long
    n = nbytes \ TyPtrSize()
    j = 0
    While j < n
        LowAppendFnPreciseRoot(baseOff + j * TyPtrSize())
        j = j + 1
    Wend
End Sub

Sub LowAppendPreciseGlobRoot(off As Long)
    If g_preciseRoots = NULL Then Exit Sub
    If g_preciseRootCount >= GC_MAX_PRECISE Then Exit Sub
    g_preciseRoots[g_preciseRootCount] = off
    g_preciseRootCount = g_preciseRootCount + 1
End Sub

Sub LowAppendPreciseGlobStringArr(baseOff As Long, nbytes As Long)
    Dim j As Long
    Dim n As Long
    n = nbytes \ TyPtrSize()
    j = 0
    While j < n
        LowAppendPreciseGlobRoot(baseOff + j * TyPtrSize())
        j = j + 1
    Wend
End Sub

Sub LowCollectPreciseGlobRoots()
    Dim i As Long
    Dim ty As Long
    Dim off As Long
    Dim sz As Long
    Dim types As *Long
    Dim offs As *Long
    Dim nb As *Long
    types = g_gTypes
    offs = g_gOffs
    nb = g_gNbytes
    g_preciseRootCount = 0
    i = 0
    While i < g_gCount
        ty = types[i]
        off = offs[i]
        sz = nb[i]
        If ty = TY_STRING Then
            LowAppendPreciseGlobRoot(off)
        ElseIf ty = TY_STRING_ARR Then
            LowAppendPreciseGlobStringArr(off, sz)
        End If
        i = i + 1
    Wend
End Sub

Function LowEnsureRtStrCollect(ctx As *LowerCtx) As Long
    If g_rtStrHeapAllocLab < 0 Then
        g_rtStrHeapAllocLab = LowNewLab(ctx)
    End If
    If g_rtStrGcPreciseLab < 0 Then
        g_rtStrGcPreciseLab = LowNewLab(ctx)
    End If
    If g_rtStrGcConsLab < 0 Then
        g_rtStrGcConsLab = LowNewLab(ctx)
    End If
    If g_rtStrCollectLab < 0 Then
        g_rtStrCollectLab = LowNewLab(ctx)
    End If
    LowEnsureRtStrCollect = g_rtStrCollectLab
End Function

Sub LowEmitCallStrHeapAlloc(ctx As *LowerCtx)
    LowEnsureRtStrCollect(ctx)
    LowEmitCall1Rax(ctx->list, 0, 0, 0, g_rtStrHeapAllocLab)
End Sub

Sub LowEmitPreciseLocalMarks(ctx As *LowerCtx)
    Dim i As Long
    Dim lab As Long
    If g_fnPreciseRootCount <= 0 Then Exit Sub
    lab = g_rtStrGcPreciseLab
    If lab < 0 Then Exit Sub
    i = 0
    While i < g_fnPreciseRootCount
        IrEmit(ctx->list, OP_LOAD_LOCAL, g_fnPreciseRoots[i], 0)
        LowEmitCall1Rax(ctx->list, 0, 0, 0, lab)
        i = i + 1
    Wend
End Sub

Sub LowEmitGcPreciseRootsInit(ctx As *LowerCtx)
    Dim i As Long
    Dim dst As Long
    If g_preciseRootCount <= 0 Then
        IrEmit(ctx->list, OP_XOR_EAX, 0, 0)
        IrEmit(ctx->list, OP_PUSH_RAX, 0, 0)
        IrEmit(ctx->list, OP_LEA_RAX_GLOB, g_gcBaseOff + GC_HDR_PRECISE_COUNT, 0)
        IrEmit(ctx->list, OP_POP_RCX, 0, 0)
        IrEmit(ctx->list, OP_STORE_PTR, 0, 0)
        Exit Sub
    End If
    i = 0
    While i < g_preciseRootCount
        dst = g_gcBaseOff + GC_HDR_PRECISE_ROOTS + i * 4
        IrEmit(ctx->list, OP_MOV_EAX_IMM, g_preciseRoots[i], 0)
        IrEmit(ctx->list, OP_PUSH_RAX, 0, 0)
        IrEmit(ctx->list, OP_LEA_RAX_GLOB, dst, 0)
        IrEmit(ctx->list, OP_POP_RCX, 0, 0)
        IrEmit(ctx->list, OP_STORE_DWORD_RAX_ECX, 0, 0)
        i = i + 1
    Wend
    IrEmit(ctx->list, OP_MOV_EAX_IMM, g_preciseRootCount, 0)
    IrEmit(ctx->list, OP_PUSH_RAX, 0, 0)
    IrEmit(ctx->list, OP_LEA_RAX_GLOB, g_gcBaseOff + GC_HDR_PRECISE_COUNT, 0)
    IrEmit(ctx->list, OP_POP_RCX, 0, 0)
    IrEmit(ctx->list, OP_STORE_PTR, 0, 0)
End Sub

Sub LowEmitStrCollectSafepoint(ctx As *LowerCtx)
    If g_rtStrCollectLab < 0 Then Exit Sub
    LowEmitPreciseLocalMarks(ctx)
    IrEmit(ctx->list, OP_CALL_LAB, g_rtStrCollectLab, 0)
End Sub

' 部分木が String を新たに確保しうるか。
' 再帰しない（関数フレームが ~8KB のため、ElseIf 連鎖や長い文リストでスタックを尽くす）。
Function LowAstNeedsStrGc(ctx As *LowerCtx, idx As Long) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim k As Long
    Dim bi As Long
    Dim cur As Long
    Dim sp As Long
    Dim n As Long
    Dim stk(255) As Long

    LowAstNeedsStrGc = 0
    If idx < 0 Then Exit Function
    ast = ctx->ast
    If ast = NULL Then Exit Function
    nodes = ast->nodes
    stk[0] = idx
    sp = 1
    While sp > 0
        sp = sp - 1
        cur = stk[sp]
        While cur >= 0
            k = nodes[cur].kind
            If k = AST_PRINT Or k = AST_INPUT Or k = AST_CALL Then
                LowAstNeedsStrGc = 1
                Exit Function
            End If
            If k = AST_BINOP Then
                If nodes[cur].num = BOP_CAT Then
                    LowAstNeedsStrGc = 1
                    Exit Function
                End If
            End If
            If k = AST_BUILTIN Then
                bi = nodes[cur].num
                If bi = BI_LEFT Or bi = BI_MID Or bi = BI_STR Or bi = BI_MAKESTR Or bi = BI_CHR Or bi = BI_RIGHT Then
                    LowAstNeedsStrGc = 1
                    Exit Function
                End If
            End If
            If k = AST_FOR Then
                n = nodes[cur].num
                If n >= 0 Then
                    If sp >= 255 Then
                        LowAstNeedsStrGc = 1
                        Exit Function
                    End If
                    stk[sp] = n
                    sp = sp + 1
                End If
                n = nodes[cur].strId
                If n >= 0 Then
                    If sp >= 255 Then
                        LowAstNeedsStrGc = 1
                        Exit Function
                    End If
                    stk[sp] = n
                    sp = sp + 1
                End If
            End If
            n = nodes[cur].left
            If n >= 0 Then
                If sp >= 255 Then
                    LowAstNeedsStrGc = 1
                    Exit Function
                End If
                stk[sp] = n
                sp = sp + 1
            End If
            n = nodes[cur].right
            If n >= 0 Then
                If sp >= 255 Then
                    LowAstNeedsStrGc = 1
                    Exit Function
                End If
                stk[sp] = n
                sp = sp + 1
            End If
            n = nodes[cur].extra
            If n >= 0 Then
                If sp >= 255 Then
                    LowAstNeedsStrGc = 1
                    Exit Function
                End If
                stk[sp] = n
                sp = sp + 1
            End If
            cur = nodes[cur].nxt
        Wend
    Wend
End Function

' ループ条件・本体（必要なら第3引数）が確保するときだけセーフポイントを出す。
Sub LowMaybeLoopStrCollect(ctx As *LowerCtx, a As Long, b As Long, c As Long)
    If LowAstNeedsStrGc(ctx, a) <> 0 Then
        LowEmitStrCollectSafepoint(ctx)
        Exit Sub
    End If
    If LowAstNeedsStrGc(ctx, b) <> 0 Then
        LowEmitStrCollectSafepoint(ctx)
        Exit Sub
    End If
    If LowAstNeedsStrGc(ctx, c) <> 0 Then
        LowEmitStrCollectSafepoint(ctx)
    End If
End Sub

' rax = String ptr → eax = Len（NULL→0）。[ptr-4] の下位31bit
Sub LowEmitLoadStrLen(list As *IrList, labZ As Long, labE As Long)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JZ, labZ, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -4, 0)
    IrEmit(list, OP_LOAD_DWORD_RAX, 0, 0)
    IrEmit(list, OP_AND_EAX_IMM, 2147483647, 0)
    IrEmit(list, OP_JMP, labE, 0)
    IrEmit(list, OP_LABEL, labZ, 0)
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_LABEL, labE, 0)
End Sub

Sub LowEmitRtCatBody(ctx As *LowerCtx)
    Dim list As *IrList
    Dim sApi(15) As Byte
    Dim empty(1) As Byte
    Dim labA As Long
    Dim labB As Long
    Dim labCopyA As Long
    Dim labCopyADone As Long
    Dim labCopyB As Long
    Dim labCopyBDone As Long

    If g_rtCatLab < 0 Then Exit Sub
    list = ctx->list
    empty[0] = 0
    labA = LowNewLab(ctx)
    labB = LowNewLab(ctx)
    labCopyA = LowNewLab(ctx)
    labCopyADone = LowNewLab(ctx)
    labCopyB = LowNewLab(ctx)
    labCopyBDone = LowNewLab(ctx)

    ' locals: -8 a, -16 b, -24 la, -32 lb, -40 total, -48 base, -56 dst
    IrEmit(list, OP_LABEL, g_rtCatLab, 0)
    IrEmit(list, OP_ENTER, 80, 0)
    LowEmitCaptureArg0(list, -8)
    LowEmitCaptureArg1(list, -16)

    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JNZ, labA, 0)
    IrEmitStr(list, OP_LEA_RAX_STR, 0, VarPtr(empty))
    IrEmit(list, OP_STORE_LOCAL, -8, 0)
    IrEmit(list, OP_LABEL, labA, 0)

    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JNZ, labB, 0)
    IrEmitStr(list, OP_LEA_RAX_STR, 0, VarPtr(empty))
    IrEmit(list, OP_STORE_LOCAL, -16, 0)
    IrEmit(list, OP_LABEL, labB, 0)

    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -4, 0)
    IrEmit(list, OP_LOAD_DWORD_RAX, 0, 0)
    IrEmit(list, OP_AND_EAX_IMM, 2147483647, 0)
    IrEmit(list, OP_STORE_LOCAL, -24, 0)

    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -4, 0)
    IrEmit(list, OP_LOAD_DWORD_RAX, 0, 0)
    IrEmit(list, OP_AND_EAX_IMM, 2147483647, 0)
    IrEmit(list, OP_STORE_LOCAL, -32, 0)

    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_ADD_EAX_ECX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -40, 0)

    IrEmit(list, OP_LOAD_LOCAL, -40, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 5, 0)
    IrEmit(list, OP_MOV_RCX_RAX, 0, 0)
    LowEmitCallStrHeapAlloc(ctx)
    IrEmit(list, OP_STORE_LOCAL, -48, 0)

    IrEmit(list, OP_LOAD_LOCAL, -40, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_ECX, &H80000000, 0)
    IrEmit(list, OP_POP_RAX, 0, 0)
    IrEmit(list, OP_OR_EAX_ECX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -48, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_STORE_DWORD_RAX_ECX, 0, 0)

    IrEmit(list, OP_LOAD_LOCAL, -48, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 4, 0)
    IrEmit(list, OP_STORE_LOCAL, -56, 0)

    ' copy a
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_STORE_LOCAL, -40, 0)
    IrEmit(list, OP_LABEL, labCopyA, 0)
    IrEmit(list, OP_LOAD_LOCAL, -40, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JZ, labCopyADone, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -8, 0)
    IrEmit(list, OP_LOAD_LOCAL, -56, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_STORE_BYTE_RAX_CL, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -56, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -56, 0)
    IrEmit(list, OP_LOAD_LOCAL, -40, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -1, 0)
    IrEmit(list, OP_STORE_LOCAL, -40, 0)
    IrEmit(list, OP_JMP, labCopyA, 0)
    IrEmit(list, OP_LABEL, labCopyADone, 0)

    ' copy b
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_STORE_LOCAL, -40, 0)
    IrEmit(list, OP_LABEL, labCopyB, 0)
    IrEmit(list, OP_LOAD_LOCAL, -40, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JZ, labCopyBDone, 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -16, 0)
    IrEmit(list, OP_LOAD_LOCAL, -56, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_STORE_BYTE_RAX_CL, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -56, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -56, 0)
    IrEmit(list, OP_LOAD_LOCAL, -40, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -1, 0)
    IrEmit(list, OP_STORE_LOCAL, -40, 0)
    IrEmit(list, OP_JMP, labCopyB, 0)
    IrEmit(list, OP_LABEL, labCopyBDone, 0)

    IrEmit(list, OP_LOAD_LOCAL, -56, 0)
    IrEmit(list, OP_MOV_ECX, 0, 0)
    IrEmit(list, OP_STORE_BYTE_RAX_CL, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -48, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 4, 0)
    LowEmitLeaveN(list, 2)
End Sub

Sub LowEmitRtMidBody(ctx As *LowerCtx)
    Dim list As *IrList
    Dim sApi(15) As Byte
    Dim empty(1) As Byte
    Dim labS As Long
    Dim labStartOk As Long
    Dim labRemOk As Long
    Dim labUseRem As Long
    Dim labCountOk As Long
    Dim labCountDone As Long
    Dim labLoop As Long
    Dim labEnd As Long

    If g_rtMidLab < 0 Then Exit Sub
    list = ctx->list
    empty[0] = 0
    labS = LowNewLab(ctx)
    labStartOk = LowNewLab(ctx)
    labRemOk = LowNewLab(ctx)
    labUseRem = LowNewLab(ctx)
    labCountOk = LowNewLab(ctx)
    labCountDone = LowNewLab(ctx)
    labLoop = LowNewLab(ctx)
    labEnd = LowNewLab(ctx)

    ' rcx=s, rdx=start1, r8=count
    IrEmit(list, OP_LABEL, g_rtMidLab, 0)
    IrEmit(list, OP_ENTER, 80, 0)
    LowEmitCaptureArg0(list, -8)
    LowEmitCaptureArg1(list, -16)
    LowEmitCaptureArg2(list, -24)

    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JNZ, labS, 0)
    IrEmitStr(list, OP_LEA_RAX_STR, 0, VarPtr(empty))
    IrEmit(list, OP_STORE_LOCAL, -8, 0)
    IrEmit(list, OP_LABEL, labS, 0)

    ' start0 = start1 - 1; if start0 < 0 then 0
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -1, 0)
    IrEmit(list, OP_STORE_LOCAL, -16, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JGE, labStartOk, 0)
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -16, 0)
    IrEmit(list, OP_LABEL, labStartOk, 0)

    ' rem = len - start0
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -4, 0)
    IrEmit(list, OP_LOAD_DWORD_RAX, 0, 0)
    IrEmit(list, OP_AND_EAX_IMM, 2147483647, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
    IrEmit(list, OP_SUB_EAX_ECX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -40, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JGE, labRemOk, 0)
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -40, 0)
    IrEmit(list, OP_LABEL, labRemOk, 0)

    ' if count < 0 then count = rem else if count > rem then count = rem
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JL, labUseRem, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -40, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JLE, labCountOk, 0)
    IrEmit(list, OP_LABEL, labUseRem, 0)
    IrEmit(list, OP_LOAD_LOCAL, -40, 0)
    IrEmit(list, OP_STORE_LOCAL, -24, 0)
    IrEmit(list, OP_JMP, labCountDone, 0)
    IrEmit(list, OP_LABEL, labCountOk, 0)
    IrEmit(list, OP_LABEL, labCountDone, 0)

    ' src = s + start0
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -8, 0)

    ' dst = HeapAlloc(count+5); [base]=count; return base+4
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 5, 0)
    IrEmit(list, OP_MOV_RCX_RAX, 0, 0)
    LowEmitCallStrHeapAlloc(ctx)
    IrEmit(list, OP_STORE_LOCAL, -48, 0)

    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_ECX, &H80000000, 0)
    IrEmit(list, OP_POP_RAX, 0, 0)
    IrEmit(list, OP_OR_EAX_ECX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -48, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_STORE_DWORD_RAX_ECX, 0, 0)

    IrEmit(list, OP_LOAD_LOCAL, -48, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 4, 0)
    IrEmit(list, OP_STORE_LOCAL, -32, 0)

    IrEmit(list, OP_LABEL, labLoop, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JZ, labEnd, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -8, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_STORE_BYTE_RAX_CL, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -32, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -1, 0)
    IrEmit(list, OP_STORE_LOCAL, -24, 0)
    IrEmit(list, OP_JMP, labLoop, 0)

    IrEmit(list, OP_LABEL, labEnd, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_MOV_ECX, 0, 0)
    IrEmit(list, OP_STORE_BYTE_RAX_CL, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -48, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 4, 0)
    LowEmitLeaveN(list, 3)
End Sub

Sub LowEmitRtStrBody(ctx As *LowerCtx)
    Dim list As *IrList
    Dim sApi(15) As Byte
    Dim labPos As Long
    Dim labDig As Long
    Dim labDigDone As Long
    Dim labNoSign As Long
    Dim labNeg As Long

    If g_rtStrLab < 0 Then Exit Sub
    list = ctx->list
    labPos = LowNewLab(ctx)
    labDig = LowNewLab(ctx)
    labDigDone = LowNewLab(ctx)
    labNoSign = LowNewLab(ctx)
    labNeg = LowNewLab(ctx)

    ' rcx = n
    IrEmit(list, OP_LABEL, g_rtStrLab, 0)
    IrEmit(list, OP_ENTER, 64, 0)
    LowEmitCaptureArg0(list, -8)

    IrEmit(list, OP_MOV_EAX_IMM, 20, 0)
    IrEmit(list, OP_MOV_RCX_RAX, 0, 0)
    LowEmitCallStrHeapAlloc(ctx)
    IrEmit(list, OP_STORE_LOCAL, -16, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 19, 0)
    IrEmit(list, OP_MOV_ECX, 0, 0)
    IrEmit(list, OP_STORE_BYTE_RAX_CL, 0, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -1, 0)
    IrEmit(list, OP_STORE_LOCAL, -24, 0)

    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JGE, labPos, 0)
    ' neg: n = -n, flag=1
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_NEG_EAX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -8, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -32, 0)
    IrEmit(list, OP_JMP, labDig, 0)
    IrEmit(list, OP_LABEL, labPos, 0)
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -32, 0)

    IrEmit(list, OP_LABEL, labDig, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_MOV_ECX, 10, 0)
    IrEmit(list, OP_XOR_EDX, 0, 0)
    IrEmit(list, OP_DIV_ECX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -8, 0)
    IrEmit(list, OP_MOV_EAX_EDX, 0, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 48, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_STORE_BYTE_RAX_CL, 0, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -1, 0)
    IrEmit(list, OP_STORE_LOCAL, -24, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JNZ, labDig, 0)

    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JZ, labNoSign, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_MOV_ECX, 45, 0)
    IrEmit(list, OP_STORE_BYTE_RAX_CL, 0, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -1, 0)
    IrEmit(list, OP_STORE_LOCAL, -24, 0)

    IrEmit(list, OP_LABEL, labNoSign, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -32, 0)
    ' len = (base + 19) - start; store at start-4
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 19, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
    IrEmit(list, OP_SUB_EAX_ECX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_ECX, &H80000000, 0)
    IrEmit(list, OP_POP_RAX, 0, 0)
    IrEmit(list, OP_OR_EAX_ECX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -4, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_STORE_DWORD_RAX_ECX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    LowEmitLeaveN(list, 1)
End Sub

' Print s ― stdout + CRLF (rcx = s)
Sub LowEmitRtPrintBody(ctx As *LowerCtx)
    Dim list As *IrList
    Dim sApi(15) As Byte
    Dim crlf(3) As Byte
    Dim labNl As Long
    Dim stk As Long

    If g_rtPrintLab < 0 Then Exit Sub
    list = ctx->list
    crlf[0] = 13
    crlf[1] = 10
    crlf[2] = 0
    labNl = LowNewLab(ctx)

    IrEmit(list, OP_LABEL, g_rtPrintLab, 0)
    IrEmit(list, OP_ENTER, 64, 0)
    LowEmitCaptureArg0(list, -8)

    lstrcpy(VarPtr(sApi), "GetStdHandle")
    LowEmitApiImm1(list, IR_DLL_KERNEL32, VarPtr(sApi), &HFFFFFFF5)
    IrEmit(list, OP_STORE_LOCAL, -16, 0)

    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JZ, labNl, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -4, 0)
    IrEmit(list, OP_LOAD_DWORD_RAX, 0, 0)
    IrEmit(list, OP_AND_EAX_IMM, 2147483647, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JZ, labNl, 0)
    IrEmit(list, OP_STORE_LOCAL, -24, 0)

    stk = LowCallStk(5)
    If stk > 0 Then
        IrEmit(list, OP_SUB_RSP, stk, 0)
    End If
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_STORE_RSP_RAX, 4 * TyPtrSize(), 0)
    IrEmit(list, OP_LEA_LOCAL, -32, 0)
    IrEmit(list, OP_STORE_RSP_RAX, 3 * TyPtrSize(), 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_STORE_RSP_RAX, 2 * TyPtrSize(), 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_STORE_RSP_RAX, 1 * TyPtrSize(), 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_STORE_RSP_RAX, 0, 0)
    LowEmitLoadRegArgs(list, 5)
    lstrcpy(VarPtr(sApi), "WriteFile")
    IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sApi))
    LowEmitCallFinish(list, stk)

    IrEmit(list, OP_LABEL, labNl, 0)
    stk = LowCallStk(5)
    If stk > 0 Then
        IrEmit(list, OP_SUB_RSP, stk, 0)
    End If
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_STORE_RSP_RAX, 4 * TyPtrSize(), 0)
    IrEmit(list, OP_LEA_LOCAL, -32, 0)
    IrEmit(list, OP_STORE_RSP_RAX, 3 * TyPtrSize(), 0)
    IrEmit(list, OP_MOV_EAX_IMM, 2, 0)
    IrEmit(list, OP_STORE_RSP_RAX, 2 * TyPtrSize(), 0)
    IrEmitStr(list, OP_LEA_RAX_STR, 0, VarPtr(crlf))
    IrEmit(list, OP_STORE_RSP_RAX, 1 * TyPtrSize(), 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_STORE_RSP_RAX, 0, 0)
    LowEmitLoadRegArgs(list, 5)
    lstrcpy(VarPtr(sApi), "WriteFile")
    IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sApi))
    LowEmitCallFinish(list, stk)
    LowEmitLeaveN(list, 1)
End Sub

' Input$ ― stdin から1行読み、ヒープ上の文字列を返す（CR 無視 / LF で終了）
Sub LowEmitRtInputBody(ctx As *LowerCtx)
    Dim list As *IrList
    Dim sApi(15) As Byte
    Dim labFail As Long
    Dim labLoop As Long
    Dim labDone As Long
    Dim labSkipCr As Long
    Dim stk As Long

    If g_rtInputLab < 0 Then Exit Sub
    list = ctx->list
    labFail = LowNewLab(ctx)
    labLoop = LowNewLab(ctx)
    labDone = LowNewLab(ctx)
    labSkipCr = LowNewLab(ctx)

    ' locals: -8 ch, -16 handle, -24 buf(base), -32 len, -40 nRead
    IrEmit(list, OP_LABEL, g_rtInputLab, 0)
    IrEmit(list, OP_ENTER, 80, 0)
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -32, 0)

    IrEmit(list, OP_MOV_EAX_IMM, 260, 0)
    LowEmitCallStrHeapAlloc(ctx)
    IrEmit(list, OP_STORE_LOCAL, -24, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JZ, labFail, 0)

    lstrcpy(VarPtr(sApi), "GetStdHandle")
    LowEmitApiImm1(list, IR_DLL_KERNEL32, VarPtr(sApi), &HFFFFFFF6)
    IrEmit(list, OP_STORE_LOCAL, -16, 0)

    IrEmit(list, OP_LABEL, labLoop, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 255, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JGE, labDone, 0)

    stk = LowCallStk(5)
    If stk > 0 Then
        IrEmit(list, OP_SUB_RSP, stk, 0)
    End If
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_STORE_RSP_RAX, 4 * TyPtrSize(), 0)
    IrEmit(list, OP_LEA_LOCAL, -40, 0)
    IrEmit(list, OP_STORE_RSP_RAX, 3 * TyPtrSize(), 0)
    IrEmit(list, OP_MOV_EAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_RSP_RAX, 2 * TyPtrSize(), 0)
    IrEmit(list, OP_LEA_LOCAL, -8, 0)
    IrEmit(list, OP_STORE_RSP_RAX, 1 * TyPtrSize(), 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_STORE_RSP_RAX, 0, 0)
    LowEmitLoadRegArgs(list, 5)
    lstrcpy(VarPtr(sApi), "ReadFile")
    IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sApi))
    LowEmitCallFinish(list, stk)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JZ, labDone, 0)
    IrEmit(list, OP_LOAD_LOCAL, -40, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JZ, labDone, 0)

    IrEmit(list, OP_LEA_LOCAL, -8, 0)
    IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 13, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JE, labSkipCr, 0)

    IrEmit(list, OP_LEA_LOCAL, -8, 0)
    IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 10, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JE, labDone, 0)

    IrEmit(list, OP_LEA_LOCAL, -8, 0)
    IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 4, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_STORE_BYTE_RAX_CL, 0, 0)
    IrEmit(list, OP_INC_LOCAL, -32, 0)

    IrEmit(list, OP_LABEL, labSkipCr, 0)
    IrEmit(list, OP_JMP, labLoop, 0)

    IrEmit(list, OP_LABEL, labDone, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_ECX, &H80000000, 0)
    IrEmit(list, OP_POP_RAX, 0, 0)
    IrEmit(list, OP_OR_EAX_ECX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_STORE_DWORD_RAX_ECX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 4, 0)
    IrEmit(list, OP_MOV_ECX, 0, 0)
    IrEmit(list, OP_STORE_BYTE_RAX_CL, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 4, 0)
    LowEmitLeaveN(list, 0)

    IrEmit(list, OP_LABEL, labFail, 0)
    IrEmit(list, OP_XOR_EAX, 0, 0)
    LowEmitLeaveN(list, 0)
End Sub

' Val(s) ― 先頭の空白と符号を処理し、十進整数を返す
Sub LowEmitRtValBody(ctx As *LowerCtx)
    Dim list As *IrList
    Dim labSpace As Long
    Dim labSign As Long
    Dim labPlus As Long
    Dim labDigit As Long
    Dim labEnd As Long
    Dim labDone As Long

    If g_rtValLab < 0 Then Exit Sub
    list = ctx->list
    labSpace = LowNewLab(ctx)
    labSign = LowNewLab(ctx)
    labPlus = LowNewLab(ctx)
    labDigit = LowNewLab(ctx)
    labEnd = LowNewLab(ctx)
    labDone = LowNewLab(ctx)

    ' locals: -8 ptr, -16 negative flag, -24 value
    IrEmit(list, OP_LABEL, g_rtValLab, 0)
    IrEmit(list, OP_ENTER, 48, 0)
    LowEmitCaptureArg0(list, -8)
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -16, 0)
    IrEmit(list, OP_STORE_LOCAL, -24, 0)

    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JZ, labDone, 0)

    ' 先頭の空白を読み飛ばす
    IrEmit(list, OP_LABEL, labSpace, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 32, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JNE, labSign, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -8, 0)
    IrEmit(list, OP_JMP, labSpace, 0)

    ' 符号
    IrEmit(list, OP_LABEL, labSign, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 45, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JNE, labPlus, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -16, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -8, 0)
    IrEmit(list, OP_JMP, labDigit, 0)

    IrEmit(list, OP_LABEL, labPlus, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 43, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JNE, labDigit, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -8, 0)

    ' value = value * 10 + digit
    IrEmit(list, OP_LABEL, labDigit, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 48, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JL, labEnd, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 57, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JG, labEnd, 0)
    IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -48, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_MOV_ECX, 10, 0)
    IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_ADD_EAX_ECX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -24, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -8, 0)
    IrEmit(list, OP_JMP, labDigit, 0)

    IrEmit(list, OP_LABEL, labEnd, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_POP_RAX, 0, 0)
    IrEmit(list, OP_JZ, labDone, 0)
    IrEmit(list, OP_NEG_EAX, 0, 0)
    IrEmit(list, OP_JMP, labDone, 0)

    IrEmit(list, OP_LABEL, labDone, 0)
    LowEmitLeaveN(list, 1)
End Sub

' ValMilli(s) ― 符号付き十進数を千分率（milli）で返す。rc=文字列 ptr
' "3.14"→3140, "7"→7000, "-1.5"→-1500, ".5"→500
Sub LowEmitRtValMilliBody(ctx As *LowerCtx)
    Dim list As *IrList
    Dim labSpace As Long
    Dim labSign As Long
    Dim labPlus As Long
    Dim labDigit As Long
    Dim labDot As Long
    Dim labFrac As Long
    Dim labPad As Long
    Dim labScale As Long
    Dim labEnd As Long
    Dim labDone As Long

    If g_rtValMilliLab < 0 Then Exit Sub
    list = ctx->list
    labSpace = LowNewLab(ctx)
    labSign = LowNewLab(ctx)
    labPlus = LowNewLab(ctx)
    labDigit = LowNewLab(ctx)
    labDot = LowNewLab(ctx)
    labFrac = LowNewLab(ctx)
    labPad = LowNewLab(ctx)
    labScale = LowNewLab(ctx)
    labEnd = LowNewLab(ctx)
    labDone = LowNewLab(ctx)

    ' locals: -8 ptr, -16 neg, -24 ival, -32 frac, -40 fracDigits
    IrEmit(list, OP_LABEL, g_rtValMilliLab, 0)
    IrEmit(list, OP_ENTER, 64, 0)
    LowEmitCaptureArg0(list, -8)
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -16, 0)
    IrEmit(list, OP_STORE_LOCAL, -24, 0)
    IrEmit(list, OP_STORE_LOCAL, -32, 0)
    IrEmit(list, OP_STORE_LOCAL, -40, 0)

    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JZ, labDone, 0)

    IrEmit(list, OP_LABEL, labSpace, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 32, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JNE, labSign, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -8, 0)
    IrEmit(list, OP_JMP, labSpace, 0)

    IrEmit(list, OP_LABEL, labSign, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 45, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JNE, labPlus, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -16, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -8, 0)
    IrEmit(list, OP_JMP, labDigit, 0)

    IrEmit(list, OP_LABEL, labPlus, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 43, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JNE, labDigit, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -8, 0)

    IrEmit(list, OP_LABEL, labDigit, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 48, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JL, labDot, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 57, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JG, labDot, 0)
    IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -48, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_MOV_ECX, 10, 0)
    IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_ADD_EAX_ECX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -24, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -8, 0)
    IrEmit(list, OP_JMP, labDigit, 0)

    IrEmit(list, OP_LABEL, labDot, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 46, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JNE, labScale, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -8, 0)

    IrEmit(list, OP_LABEL, labFrac, 0)
    IrEmit(list, OP_LOAD_LOCAL, -40, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 3, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JGE, labPad, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 48, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JL, labPad, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 57, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JG, labPad, 0)
    IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -48, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_MOV_ECX, 10, 0)
    IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_ADD_EAX_ECX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -32, 0)
    IrEmit(list, OP_INC_LOCAL, -40, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -8, 0)
    IrEmit(list, OP_JMP, labFrac, 0)

    IrEmit(list, OP_LABEL, labPad, 0)
    IrEmit(list, OP_LOAD_LOCAL, -40, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 3, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JGE, labScale, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_MOV_ECX, 10, 0)
    IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -32, 0)
    IrEmit(list, OP_INC_LOCAL, -40, 0)
    IrEmit(list, OP_JMP, labPad, 0)

    IrEmit(list, OP_LABEL, labScale, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_MOV_ECX, 1000, 0)
    IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_ADD_EAX_ECX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -24, 0)

    IrEmit(list, OP_LABEL, labEnd, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_POP_RAX, 0, 0)
    IrEmit(list, OP_JZ, labDone, 0)
    IrEmit(list, OP_NEG_EAX, 0, 0)
    IrEmit(list, OP_JMP, labDone, 0)

    IrEmit(list, OP_LABEL, labDone, 0)
    LowEmitLeaveN(list, 1)
End Sub

' MilliToSingle ― eax の千分率 → eax の IEEE Single ビット列（Parser.FloatBitsFromMilli 相当）
Sub LowEmitRtMilliToSingleBody(ctx As *LowerCtx)
    Dim list As *IrList
    Dim labZero As Long
    Dim labPos As Long
    Dim labNormLo As Long
    Dim labNormHi As Long
    Dim labNormDone As Long
    Dim labBadExp As Long
    Dim labDone As Long

    If g_rtMilliToSingleLab < 0 Then Exit Sub
    list = ctx->list
    labZero = LowNewLab(ctx)
    labPos = LowNewLab(ctx)
    labNormLo = LowNewLab(ctx)
    labNormHi = LowNewLab(ctx)
    labNormDone = LowNewLab(ctx)
    labBadExp = LowNewLab(ctx)
    labDone = LowNewLab(ctx)

    ' locals: -8 sign(0/1), -16 num, -24 uexp, -32 man, -40 biased
    IrEmit(list, OP_LABEL, g_rtMilliToSingleLab, 0)
    IrEmit(list, OP_ENTER, 64, 0)
    IrEmit(list, OP_STORE_LOCAL, -16, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JZ, labZero, 0)

    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -8, 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JGE, labPos, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -8, 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_NEG_EAX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -16, 0)

    IrEmit(list, OP_LABEL, labPos, 0)
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -24, 0)

    IrEmit(list, OP_LABEL, labNormLo, 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 1000, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JGE, labNormHi, 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_MOV_ECX_EAX, 0, 0)
    IrEmit(list, OP_ADD_EAX_ECX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -16, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -1, 0)
    IrEmit(list, OP_STORE_LOCAL, -24, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, -140, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JL, labBadExp, 0)
    IrEmit(list, OP_JMP, labNormLo, 0)

    IrEmit(list, OP_LABEL, labNormHi, 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 2000, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JL, labNormDone, 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_XOR_EDX, 0, 0)
    IrEmit(list, OP_MOV_ECX, 2, 0)
    IrEmit(list, OP_DIV_ECX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -16, 0)
    IrEmit(list, OP_INC_LOCAL, -24, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 140, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JG, labBadExp, 0)
    IrEmit(list, OP_JMP, labNormHi, 0)

    IrEmit(list, OP_LABEL, labNormDone, 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_MOV_ECX, 1000, 0)
    IrEmit(list, OP_SUB_EAX_ECX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -32, 0)
    ' man = frac*8388 + (frac*608)/1000  （frac*8388608 は 32bit 乗算で溢れる）
    IrEmit(list, OP_MOV_ECX, 8388, 0)
    IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_MOV_ECX, 608, 0)
    IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
    IrEmit(list, OP_XOR_EDX, 0, 0)
    IrEmit(list, OP_MOV_ECX, 1000, 0)
    IrEmit(list, OP_DIV_ECX, 0, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_ADD_EAX_ECX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -32, 0)

    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 127, 0)
    IrEmit(list, OP_STORE_LOCAL, -40, 0)
    IrEmit(list, OP_LOAD_LOCAL, -40, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JLE, labBadExp, 0)
    IrEmit(list, OP_LOAD_LOCAL, -40, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 255, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JGE, labBadExp, 0)

    IrEmit(list, OP_LOAD_LOCAL, -40, 0)
    IrEmit(list, OP_MOV_ECX, 8388608, 0)
    IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_OR_EAX_ECX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_POP_RAX, 0, 0)
    IrEmit(list, OP_JZ, labDone, 0)
    IrEmit(list, OP_MOV_ECX, &H80000000, 0)
    IrEmit(list, OP_OR_EAX_ECX, 0, 0)
    IrEmit(list, OP_JMP, labDone, 0)

    IrEmit(list, OP_LABEL, labBadExp, 0)
    IrEmit(list, OP_LABEL, labZero, 0)
    IrEmit(list, OP_XOR_EAX, 0, 0)

    IrEmit(list, OP_LABEL, labDone, 0)
    LowEmitLeaveN(list, 1)
End Sub

' MilliToDouble ― eax の千分率 → rax の IEEE Double
' DIV_SD（xmm0=rcx）は stage0/1 で 0 を返しやすいので、実績のある MilliToSingle 経由にする。
Sub LowEmitRtMilliToDoubleBody(ctx As *LowerCtx)
    Dim list As *IrList
    Dim lab As Long

    If g_rtMilliToDoubleLab < 0 Then Exit Sub
    list = ctx->list
    lab = g_rtMilliToSingleLab
    IrEmit(list, OP_LABEL, g_rtMilliToDoubleLab, 0)
    IrEmit(list, OP_ENTER, 32, 0)
    LowEmitCaptureArg0(list, -8)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    If lab >= 0 Then
        LowEmitCall1Rax(list, 0, 0, 0, lab)
        IrEmit(list, OP_CVT_SS_TO_SD, 0, 0)
    End If
    LowEmitLeaveN(list, 1)
End Sub

' MakeStr(p) ― NUL 終端 BytePtr → 長さ付き String（複製）
Sub LowEmitRtMakeStrBody(ctx As *LowerCtx)
    Dim list As *IrList
    Dim sApi(15) As Byte
    Dim empty(1) As Byte
    Dim labOk As Long
    Dim labCopy As Long
    Dim labNul As Long

    If g_rtMakeStrLab < 0 Then Exit Sub
    list = ctx->list
    empty[0] = 0
    labOk = LowNewLab(ctx)
    labCopy = LowNewLab(ctx)
    labNul = LowNewLab(ctx)

    ' rcx = p; locals: -8 src, -16 len, -24 base, -32 dst
    IrEmit(list, OP_LABEL, g_rtMakeStrLab, 0)
    IrEmit(list, OP_ENTER, 48, 0)
    LowEmitCaptureArg0(list, -8)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JNZ, labOk, 0)
    IrEmitStr(list, OP_LEA_RAX_STR, 0, VarPtr(empty))
    LowEmitLeaveN(list, 1)

    IrEmit(list, OP_LABEL, labOk, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    lstrcpy(VarPtr(sApi), "lstrlenA")
    LowEmitCall1Rax(list, 1, IR_DLL_KERNEL32, VarPtr(sApi), 0)
    IrEmit(list, OP_STORE_LOCAL, -16, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 5, 0)
    IrEmit(list, OP_MOV_RCX_RAX, 0, 0)
    LowEmitCallStrHeapAlloc(ctx)
    IrEmit(list, OP_STORE_LOCAL, -24, 0)

    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_ECX, &H80000000, 0)
    IrEmit(list, OP_POP_RAX, 0, 0)
    IrEmit(list, OP_OR_EAX_ECX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_STORE_DWORD_RAX_ECX, 0, 0)

    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 4, 0)
    IrEmit(list, OP_STORE_LOCAL, -32, 0)

    IrEmit(list, OP_LABEL, labCopy, 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JZ, labNul, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -8, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_STORE_BYTE_RAX_CL, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -32, 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -1, 0)
    IrEmit(list, OP_STORE_LOCAL, -16, 0)
    IrEmit(list, OP_JMP, labCopy, 0)

    IrEmit(list, OP_LABEL, labNul, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_MOV_ECX, 0, 0)
    IrEmit(list, OP_STORE_BYTE_RAX_CL, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 4, 0)
    LowEmitLeaveN(list, 1)
End Sub

' StrCmp(rcx=a, rdx=b) → eax（長さ付き辞書順）
Sub LowEmitRtStrCmpBody(ctx As *LowerCtx)
    Dim list As *IrList
    Dim labMinB As Long
    Dim labLoop As Long
    Dim labByteDiff As Long
    Dim labByLen As Long

    If g_rtStrCmpLab < 0 Then Exit Sub
    list = ctx->list
    labMinB = LowNewLab(ctx)
    labLoop = LowNewLab(ctx)
    labByteDiff = LowNewLab(ctx)
    labByLen = LowNewLab(ctx)

    IrEmit(list, OP_LABEL, g_rtStrCmpLab, 0)
    IrEmit(list, OP_ENTER, 64, 0)
    LowEmitCaptureArg0(list, -8)
    LowEmitCaptureArg1(list, -16)

    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -4, 0)
    IrEmit(list, OP_LOAD_DWORD_RAX, 0, 0)
    IrEmit(list, OP_AND_EAX_IMM, 2147483647, 0)
    IrEmit(list, OP_STORE_LOCAL, -24, 0)

    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -4, 0)
    IrEmit(list, OP_LOAD_DWORD_RAX, 0, 0)
    IrEmit(list, OP_AND_EAX_IMM, 2147483647, 0)
    IrEmit(list, OP_STORE_LOCAL, -32, 0)

    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JLE, labMinB, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_STORE_LOCAL, -40, 0)
    IrEmit(list, OP_JMP, labLoop, 0)
    IrEmit(list, OP_LABEL, labMinB, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_STORE_LOCAL, -40, 0)

    IrEmit(list, OP_LABEL, labLoop, 0)
    IrEmit(list, OP_LOAD_LOCAL, -40, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JZ, labByLen, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JNE, labByteDiff, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -8, 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -16, 0)
    IrEmit(list, OP_LOAD_LOCAL, -40, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -1, 0)
    IrEmit(list, OP_STORE_LOCAL, -40, 0)
    IrEmit(list, OP_JMP, labLoop, 0)

    IrEmit(list, OP_LABEL, labByteDiff, 0)
    IrEmit(list, OP_SUB_EAX_ECX, 0, 0)
    IrEmit(list, OP_NEG_EAX, 0, 0)
    LowEmitLeaveN(list, 2)

    IrEmit(list, OP_LABEL, labByLen, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_SUB_EAX_ECX, 0, 0)
    IrEmit(list, OP_NEG_EAX, 0, 0)
    LowEmitLeaveN(list, 2)
End Sub

' StrFree(rcx=p): ヒープ印付きなら HeapFree(p-4)
Sub LowEmitRtStrFreeBody(ctx As *LowerCtx)
    Dim list As *IrList
    Dim sApi(15) As Byte
    Dim labDone As Long
    Dim labSkip As Long

    If g_rtStrFreeLab < 0 Then Exit Sub
    list = ctx->list
    labDone = LowNewLab(ctx)
    labSkip = LowNewLab(ctx)

    IrEmit(list, OP_LABEL, g_rtStrFreeLab, 0)
    IrEmit(list, OP_ENTER, 32, 0)
    LowEmitCaptureArg0(list, -8)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JZ, labDone, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -4, 0)
    IrEmit(list, OP_STORE_LOCAL, -16, 0)
    IrEmit(list, OP_LOAD_DWORD_RAX, 0, 0)
    IrEmit(list, OP_MOV_ECX, &H80000000, 0)
    IrEmit(list, OP_AND_EAX_ECX, 0, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JZ, labDone, 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    LowEmitHeapFreeRax(list)
    IrEmit(list, OP_LABEL, labDone, 0)
    LowEmitLeaveN(list, 1)
End Sub

Function LowTyNbytes(ty As Long) As Long
    If ty = TY_BYTE Then
        LowTyNbytes = 1
    ElseIf ty = TY_DOUBLE Then
        LowTyNbytes = 8
    ElseIf ty = TY_SINGLE Then
        LowTyNbytes = 4
    ElseIf ty = TY_STRING Then
        LowTyNbytes = TyPtrSize()
    ElseIf ty = TY_PTR_BYTE Or ty = TY_PTR_LONG Or ty = TY_PTR_UDT Then
        LowTyNbytes = TyPtrSize()
    Else
        LowTyNbytes = 4
    End If
End Function

Function LowPtrFieldElemSize(fieldTy As Long) As Long
    If fieldTy = FIELDTY_PTR_LONG Then
        LowPtrFieldElemSize = 4
    Else
        LowPtrFieldElemSize = 1
    End If
End Function

Sub LowLoadSized(list As *IrList, sz As Long)
    If sz = 1 Then
        IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
    ElseIf sz = 2 Then
        IrEmit(list, OP_LOADZX_WORD_RAX, 0, 0)
    ElseIf sz = 4 Then
        IrEmit(list, OP_LOAD_DWORD_RAX, 0, 0)
    ElseIf sz = 8 Then
        IrEmit(list, OP_LOAD_QWORD_RAX, 0, 0)
    Else
        IrEmit(list, OP_LOAD_DWORD_RAX, 0, 0)
    End If
End Sub

Sub LowStoreSized(list As *IrList, sz As Long)
    If sz = 1 Then
        IrEmit(list, OP_STORE_BYTE_RAX_CL, 0, 0)
    ElseIf sz = 2 Then
        IrEmit(list, OP_STORE_WORD_RAX_CX, 0, 0)
    ElseIf sz = 4 Then
        IrEmit(list, OP_STORE_DWORD_RAX_ECX, 0, 0)
    ElseIf sz = 8 Then
        IrEmit(list, OP_STORE_QWORD_RAX_RCX, 0, 0)
    Else
        IrEmit(list, OP_STORE_DWORD_RAX_ECX, 0, 0)
    End If
End Sub

' Address of lvalue -> rax
' AST_MEMBER ノードが指すフィールドの UDT 型インデックス（ネスト解決用）
Function LowMemberFieldType(ctx As *LowerCtx, idx As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim tt As *TypeTable
    Dim base As Long
    Dim name(63) As Byte
    Dim fname(63) As Byte
    Dim ti As Long
    Dim foff As Long
    Dim fsz As Long
    Dim fcnt As Long
    Dim fieldTy As Long
    Dim off As Long
    Dim ty As Long
    Dim typeIdx As Long
    Dim byRef As Long
    Dim isGlob As Long

    LowMemberFieldType = -1
    If idx < 0 Then Exit Function
    ast = ctx->ast
    nodes = ast->nodes
    If nodes[idx].kind <> AST_MEMBER Then Exit Function
    tt = ast->types
    base = nodes[idx].left
    AstCopyStr(ast, idx, VarPtr(fname))
    If nodes[base].kind = AST_MEMBER Then
        ti = LowMemberFieldType(ctx, base)
    ElseIf nodes[base].kind = AST_VAR Then
        AstCopyStr(ast, base, VarPtr(name))
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then Exit Function
        ti = vTypeIdx
    Else
        Exit Function
    End If
    If ti < 0 Then Exit Function
    If TyFindFieldEx(tt, ti, VarPtr(fname), foff, fsz, fcnt, fieldTy) = 0 Then Exit Function
    LowMemberFieldType = fieldTy
End Function

' Byte size of the field addressed by an AST_MEMBER (supports nesting).
Function LowMemberFieldSize(ctx As *LowerCtx, idx As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim tt As *TypeTable
    Dim base As Long
    Dim name(63) As Byte
    Dim fname(63) As Byte
    Dim ti As Long
    Dim foff As Long
    Dim fsz As Long
    Dim fcnt As Long
    Dim fieldTy As Long

    LowMemberFieldSize = 0
    If idx < 0 Then Exit Function
    ast = ctx->ast
    nodes = ast->nodes
    If nodes[idx].kind <> AST_MEMBER Then Exit Function
    tt = ast->types
    base = nodes[idx].left
    AstCopyStr(ast, idx, VarPtr(fname))
    If nodes[base].kind = AST_MEMBER Then
        ti = LowMemberFieldType(ctx, base)
    ElseIf nodes[base].kind = AST_VAR Then
        AstCopyStr(ast, base, VarPtr(name))
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then Exit Function
        ti = vTypeIdx
    ElseIf nodes[base].kind = AST_INDEX Then
        AstCopyStr(ast, nodes[base].left, VarPtr(name))
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then Exit Function
        ti = vTypeIdx
    Else
        Exit Function
    End If
    If ti < 0 Then Exit Function
    If TyFindFieldEx(tt, ti, VarPtr(fname), foff, fsz, fcnt, fieldTy) = 0 Then Exit Function
    LowMemberFieldSize = fsz
End Function

Function LowAddr(ctx As *LowerCtx, idx As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList
    Dim name(63) As Byte
    Dim fname(63) As Byte
    Dim base As Long
    Dim k As Long
    Dim nArgs As Long
    Dim tt As *TypeTable
    Dim foff As Long
    Dim fsz As Long
    Dim fcnt As Long
    Dim fieldTy As Long
    Dim ti As Long
    Dim esz As Long
    Dim tsizes As *Long
    Dim ix As Long

    LowAddr = 0
    If idx < 0 Then
        ctx->err = 1
        Exit Function
    End If
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    k = nodes[idx].kind
    tt = ast->types

    If k = AST_VAR Then
        AstCopyStr(ast, idx, VarPtr(name))
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
            ctx->err = 1
            Exit Function
        End If
        If vByRef <> 0 Then
            LowEmitLoadOff(list, vOff, vGlob)
        Else
            LowEmitLeaOff(list, vOff, vGlob)
        End If
        LowAddr = 1
    ElseIf k = AST_MEMBER Then
        base = nodes[idx].left
        AstCopyStr(ast, idx, VarPtr(fname))
        If nodes[base].kind = AST_MEMBER Then
            ' nested: a.b.c — address of a.b then + offset(c)
            If LowAddr(ctx, base) = 0 Then Exit Function
            ti = LowMemberFieldType(ctx, base)
            If ti < 0 Then
                ctx->err = 1
                Exit Function
            End If
        ElseIf nodes[base].kind = AST_INDEX Then
            If LowAddr(ctx, base) = 0 Then Exit Function
            AstCopyStr(ast, nodes[base].left, VarPtr(name))
            If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
                ctx->err = 1
                Exit Function
            End If
            ti = vTypeIdx
        ElseIf nodes[base].kind = AST_VAR Then
            AstCopyStr(ast, base, VarPtr(name))
            If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
                ctx->err = 1
                Exit Function
            End If
            ti = vTypeIdx
            If nodes[idx].num <> 0 Then
                LowEmitLoadOff(list, vOff, vGlob)
            ElseIf vTy = TY_PTR_UDT Then
                LowEmitLoadOff(list, vOff, vGlob)
            Else
                LowEmitLeaOff(list, vOff, vGlob)
            End If
        Else
            ctx->err = 1
            Exit Function
        End If
        If TyFindField(tt, ti, VarPtr(fname), foff, fsz, fcnt) = 0 Then
            ' With 対象が UDT でないとき .x は基底のまま（p.x → p）
            LowAddr = 1
            Exit Function
        End If
        If foff <> 0 Then
            IrEmit(list, OP_ADD_RAX_IMM, foff, 0)
        End If
        LowAddr = 1
    ElseIf k = AST_INDEX Or k = AST_CALL Then
        If k = AST_CALL Then
            nArgs = nodes[idx].num
            If nArgs <> 1 Then
                ctx->err = 1
                Exit Function
            End If
            AstCopyStr(ast, idx, VarPtr(name))
            If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
                ctx->err = 1
                Exit Function
            End If
            If vTy <> TY_BYTE_ARR Then
                If vTy <> TY_LONG_ARR Then
                    If vTy <> TY_STRING_ARR Then
                        If vTy <> TY_DOUBLE_ARR Then
                            If vTy <> TY_SINGLE_ARR Then
                                If vTy <> TY_UDT_ARR Then
                                    ctx->err = 1
                                    Exit Function
                                End If
                            End If
                        End If
                    End If
                End If
            End If
            ' index expr is left of CALL (AST_ARG wrapper)
            ix = nodes[idx].left
            If ix >= 0 Then
                If nodes[ix].kind = AST_ARG Then ix = nodes[ix].left
            End If
            If LowExpr(ctx, ix) = 0 Then Exit Function
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            LowEmitLeaOff(list, vOff, vGlob)
            IrEmit(list, OP_POP_RCX, 0, 0)
            If vTy = TY_STRING_ARR Then
                LowEmitScalePtr(list)
                IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
            ElseIf vTy = TY_DOUBLE_ARR Then
                IrEmit(list, OP_SHL_ECX_3, 0, 0)
                IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
            ElseIf vTy = TY_LONG_ARR Or vTy = TY_SINGLE_ARR Then
                ' Long/DWord/Single = 4 bytes（WinAPI の UINT* 等と互換）
                IrEmit(list, OP_PUSH_RAX, 0, 0)
                IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
                IrEmit(list, OP_MOV_ECX, 4, 0)
                IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
                IrEmit(list, OP_POP_RCX, 0, 0)
                IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
            ElseIf vTy = TY_UDT_ARR Then
                ti = vTypeIdx
                tsizes = tt->typeSizes
                esz = tsizes[ti]
                If esz <= 0 Then
                    ctx->err = 1
                    Exit Function
                End If
                If esz = 1 Then
                    IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
                Else
                    IrEmit(list, OP_PUSH_RAX, 0, 0)
                    IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
                    IrEmit(list, OP_MOV_ECX, esz, 0)
                    IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
                    IrEmit(list, OP_POP_RCX, 0, 0)
                    IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
                End If
            Else
                IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
            End If
            LowAddr = 1
            Exit Function
        End If
        base = nodes[idx].left
        If nodes[base].kind = AST_MEMBER Then
            AstCopyStr(ast, base, VarPtr(fname))
            ix = nodes[base].left
            If nodes[ix].kind = AST_INDEX Then
                AstCopyStr(ast, nodes[ix].left, VarPtr(name))
            ElseIf nodes[ix].kind = AST_VAR Then
                AstCopyStr(ast, ix, VarPtr(name))
            Else
                ctx->err = 1
                Exit Function
            End If
            If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
                ctx->err = 1
                Exit Function
            End If
            ti = vTypeIdx
            If TyFindFieldEx(tt, ti, VarPtr(fname), foff, fsz, fcnt, fieldTy) = 0 Then
                ctx->err = 1
                Exit Function
            End If
            If fcnt > 1 Then
                ' UDT array field: &field[0] + index * elemSize
                esz = fsz
                If esz <= 0 Then
                    ctx->err = 1
                    Exit Function
                End If
                If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
                If esz <> 1 Then
                    IrEmit(list, OP_MOV_ECX, esz, 0)
                    IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
                End If
                IrEmit(list, OP_PUSH_RAX, 0, 0)
                If LowAddr(ctx, base) = 0 Then Exit Function
                IrEmit(list, OP_POP_RCX, 0, 0)
                IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
            ElseIf fsz = TyPtrSize() Then
                ' pointer field: *Long は index*4、それ以外（*Byte 等）はバイト添字
                esz = LowPtrFieldElemSize(fieldTy)
                If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
                If esz <> 1 Then
                    IrEmit(list, OP_MOV_ECX, esz, 0)
                    IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
                End If
                IrEmit(list, OP_PUSH_RAX, 0, 0)
                If LowExpr(ctx, base) = 0 Then Exit Function
                IrEmit(list, OP_POP_RCX, 0, 0)
                IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
            Else
                ctx->err = 1
                Exit Function
            End If
            LowAddr = 1
            Exit Function
        End If
        AstCopyStr(ast, base, VarPtr(name))
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
            ctx->err = 1
            Exit Function
        End If
        If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
        If vTy = TY_PTR_UDT Then
            ti = vTypeIdx
            tsizes = tt->typeSizes
            esz = tsizes[ti]
            If esz <= 0 Then
                ctx->err = 1
                Exit Function
            End If
            IrEmit(list, OP_MOV_ECX, esz, 0)
            IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            LowEmitLoadOff(list, vOff, vGlob)
            IrEmit(list, OP_POP_RCX, 0, 0)
            IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
            LowAddr = 1
            Exit Function
        End If
        If vTy = TY_PTR_LONG Then
            IrEmit(list, OP_MOV_ECX, 4, 0)
            IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            LowEmitLoadOff(list, vOff, vGlob)
            IrEmit(list, OP_POP_RCX, 0, 0)
            IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
            LowAddr = 1
            Exit Function
        End If
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        If vTy = TY_BYTE_ARR Then
            LowEmitLeaOff(list, vOff, vGlob)
        ElseIf vTy = TY_STRING_ARR Then
            LowEmitLeaOff(list, vOff, vGlob)
            IrEmit(list, OP_POP_RCX, 0, 0)
            LowEmitScalePtr(list)
            IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
            LowAddr = 1
            Exit Function
        ElseIf vTy = TY_DOUBLE_ARR Then
            LowEmitLeaOff(list, vOff, vGlob)
            IrEmit(list, OP_POP_RCX, 0, 0)
            IrEmit(list, OP_SHL_ECX_3, 0, 0)
            IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
            LowAddr = 1
            Exit Function
        ElseIf vTy = TY_LONG_ARR Or vTy = TY_SINGLE_ARR Then
            LowEmitLeaOff(list, vOff, vGlob)
            IrEmit(list, OP_POP_RCX, 0, 0)
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
            IrEmit(list, OP_MOV_ECX, 4, 0)
            IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
            IrEmit(list, OP_POP_RCX, 0, 0)
            IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
            LowAddr = 1
            Exit Function
        ElseIf vTy = TY_UDT_ARR Then
            ti = vTypeIdx
            tsizes = tt->typeSizes
            esz = tsizes[ti]
            If esz <= 0 Then
                ctx->err = 1
                Exit Function
            End If
            LowEmitLeaOff(list, vOff, vGlob)
            IrEmit(list, OP_POP_RCX, 0, 0)
            If esz = 1 Then
                IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
            Else
                IrEmit(list, OP_PUSH_RAX, 0, 0)
                IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
                IrEmit(list, OP_MOV_ECX, esz, 0)
                IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
                IrEmit(list, OP_POP_RCX, 0, 0)
                IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
            End If
            LowAddr = 1
            Exit Function
        ElseIf vTy = TY_PTR_BYTE Then
            LowEmitLoadOff(list, vOff, vGlob)
        Else
            ctx->err = 1
            Exit Function
        End If
        IrEmit(list, OP_POP_RCX, 0, 0)
        IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
        LowAddr = 1
    Else
        ctx->err = 1
    End If
End Function

' 配列名を *Byte 等へ渡すとき先頭アドレスに減衰する
Function LowExprArg(ctx As *LowerCtx, idx As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte

    LowExprArg = 0
    If idx < 0 Then Exit Function
    ast = ctx->ast
    nodes = ast->nodes
    If nodes[idx].kind = AST_VAR Then
        AstCopyStr(ast, idx, VarPtr(name))
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
            If vTy = TY_BYTE_ARR Then
                LowExprArg = LowAddr(ctx, idx)
                Exit Function
            End If
            If vTy = TY_LONG_ARR Then
                LowExprArg = LowAddr(ctx, idx)
                Exit Function
            End If
            If vTy = TY_DOUBLE_ARR Then
                LowExprArg = LowAddr(ctx, idx)
                Exit Function
            End If
            If vTy = TY_SINGLE_ARR Then
                LowExprArg = LowAddr(ctx, idx)
                Exit Function
            End If
            If vTy = TY_UDT_ARR Then
                LowExprArg = LowAddr(ctx, idx)
                Exit Function
            End If
            If vTy = TY_STRING_ARR Then
                LowExprArg = LowAddr(ctx, idx)
                Exit Function
            End If
        End If
    End If
    LowExprArg = LowExpr(ctx, idx)
End Function

' WinAPI へ UDT 変数を渡すときはアドレス渡し（LPRECT 等）
Function LowArgIsUdtVar(ctx As *LowerCtx, idx As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte

    LowArgIsUdtVar = 0
    If idx < 0 Then Exit Function
    ast = ctx->ast
    nodes = ast->nodes
    If nodes[idx].kind <> AST_VAR Then Exit Function
    AstCopyStr(ast, idx, VarPtr(name))
    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then Exit Function
    If vTy = TY_UDT Then LowArgIsUdtVar = 1
End Function

Function LowCallUseAddr(ctx As *LowerCtx, argNode As Long, byBits As Long, bit As Long, isApi As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    LowCallUseAddr = 0
    If argNode < 0 Then Exit Function
    ast = ctx->ast
    nodes = ast->nodes
    If nodes[argNode].num <> 0 Then Exit Function
    LowCallUseAddr = LowUseArgAddr(ctx, nodes[argNode].left, byBits, bit, isApi)
End Function

Function LowUseArgAddr(ctx As *LowerCtx, idx As Long, byBits As Long, bit As Long, isApi As Long) As Long
    Dim v As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    LowUseArgAddr = 0
    If idx >= 0 Then
        ast = ctx->ast
        nodes = ast->nodes
        If nodes[idx].kind = AST_BUILTIN Then
            If nodes[idx].num = BI_VARPTR Or nodes[idx].num = BI_STRPTR Then
                Exit Function
            End If
        End If
    End If
    v = byBits And bit
    If v <> 0 Then
        LowUseArgAddr = 1
        Exit Function
    End If
    If isApi = 0 Then Exit Function
    If LowArgIsUdtVar(ctx, idx) <> 0 Then LowUseArgAddr = 1
End Function

Function LowRecvClassTi(ctx As *LowerCtx, recvIdx As Long) As Long
    Dim nodes As *AstNode
    Dim name(63) As Byte
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim ast As *Ast
    Dim tt As *TypeTable

    LowRecvClassTi = -1
    If recvIdx < 0 Then Exit Function
    ast = ctx->ast
    nodes = ast->nodes
    If nodes[recvIdx].kind <> AST_VAR Then Exit Function
    AstCopyStr(ast, recvIdx, VarPtr(name))
    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then Exit Function
    If vTy <> TY_UDT And vTy <> TY_PTR_UDT Then Exit Function
    tt = ast->types
    If TyIsClass(tt, vTypeIdx) = 0 Then Exit Function
    LowRecvClassTi = vTypeIdx
End Function

Function LowRecvIsPtr(ctx As *LowerCtx, recvIdx As Long) As Long
    Dim nodes As *AstNode
    Dim name(63) As Byte
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim ast As *Ast

    LowRecvIsPtr = 0
    If recvIdx < 0 Then Exit Function
    ast = ctx->ast
    nodes = ast->nodes
    If nodes[recvIdx].kind <> AST_VAR Then Exit Function
    AstCopyStr(ast, recvIdx, VarPtr(name))
    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then Exit Function
    If vTy = TY_PTR_UDT Then LowRecvIsPtr = 1
End Function

Sub LowMangleClass(className As *Byte, member As *Byte, dst As *Byte)
    lstrcpy(dst, className)
    lstrcat(dst, "_")
    lstrcat(dst, member)
End Sub

Sub LowEmitOneClassDtor(ctx As *LowerCtx, ti As Long, vOff As Long, vGlob As Long)
    Dim mangled(127) As Byte
    Dim kDtor(7) As Byte
    Dim lab As Long
    Dim tt As *TypeTable
    Dim j As Long
    Dim stk As Long
    Dim names As *Byte
    Dim ast As *Ast

    If ti < 0 Then Exit Sub
    ast = ctx->ast
    tt = ast->types
    If TyIsClass(tt, ti) = 0 Then Exit Sub
    lstrcpy(VarPtr(kDtor), "Dtor")
    j = ti * 48
    names = tt->typeNames
    LowMangleClass(VarPtr(names[j]), VarPtr(kDtor), VarPtr(mangled))
    lab = LowFindFunc(ctx, VarPtr(mangled))
    If lab < 0 Then Exit Sub
    stk = LowCallStk(1)
    If stk > 0 Then
        IrEmit(ctx->list, OP_SUB_RSP, stk, 0)
    End If
    LowEmitLeaOff(ctx->list, vOff, vGlob)
    IrEmit(ctx->list, OP_STORE_RSP_RAX, 0, 0)
    LowEmitLoadRegArgs(ctx->list, 1)
    IrEmit(ctx->list, OP_CALL_LAB, lab, 0)
    LowEmitCallFinish(ctx->list, stk)
End Sub

Sub LowEmitLocalClassDtors(ctx As *LowerCtx)
    Dim i As Long
    Dim types As *Long
    Dim typeIdxs As *Long
    Dim offs As *Long

    types = ctx->types
    typeIdxs = ctx->typeIdxs
    offs = ctx->offs
    i = ctx->symCount - 1
    While i >= 0
        If types[i] = TY_UDT Then
            LowEmitOneClassDtor(ctx, typeIdxs[i], offs[i], 0)
        End If
        i = i - 1
    Wend
End Sub

Sub LowEmitGlobalClassDtors(ctx As *LowerCtx)
    Dim i As Long
    Dim types As *Long
    Dim typeIdxs As *Long
    Dim offs As *Long

    types = g_gTypes
    typeIdxs = g_gTypeIdxs
    offs = g_gOffs
    i = g_gCount - 1
    While i >= 0
        If types[i] = TY_UDT Then
            LowEmitOneClassDtor(ctx, typeIdxs[i], offs[i], 1)
        End If
        i = i - 1
    Wend
End Sub

Function LowExpr(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim k As Long
    Dim name(63) As Byte
    Dim buf(255) As Byte
    Dim si As Long
    Dim offs As *Long
    Dim types As *Long
    Dim op As Long
    Dim list As *IrList
    Dim lab As Long
    Dim nArgs As Long
    Dim v As Long
    Dim labZ As Long
    Dim labE As Long
    Dim sLen(15) As Byte
    Dim ci As Long
    Dim vals As *Long
    Dim strs As *Byte
    Dim tt As *TypeTable
    Dim typeIdxs As *Long
    Dim foff As Long
    Dim fsz As Long
    Dim fcnt As Long
    Dim fieldTy As Long
    Dim ti As Long
    Dim sz As Long
    Dim base As Long
    Dim ix As Long
    Dim byRefs As *Long
    Dim byBits As Long
    Dim args(15) As Long
    Dim argi As Long
    Dim argn As Long
    Dim stk As Long
    Dim j As Long
    Dim bbit As Long
    Dim tsizes As *Long
    Dim apiName(63) As Byte
    Dim isApi As Long
    Dim di As Long
    Dim dllKind As Long
    Dim dlls As *Long
    Dim bys As *Long
    Dim useAddr As Long
    Dim labA As Long
    Dim labB As Long
    Dim names As *Byte
    Dim fty As Long

    LowExpr = 0
    If idx < 0 Then
        ctx->err = 1
        Exit Function
    End If
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    tt = ast->types

    If LowConstInt(ast, idx, v) <> 0 Then
        IrEmit(list, OP_MOV_EAX_IMM, v, 0)
        LowExpr = 1
        Exit Function
    End If
    If LowConstStr(ast, idx, VarPtr(buf)) <> 0 Then
        IrEmitStr(list, OP_LEA_RAX_STR, 0, VarPtr(buf))
        LowExpr = 1
        Exit Function
    End If

    k = nodes[idx].kind
    offs = ctx->offs
    types = ctx->types
    typeIdxs = ctx->typeIdxs
    If k = AST_NUM Then
        If nodes[idx].extra = 1 Then
            IrEmit(list, OP_MOV_EAX_IMM, nodes[idx].num, 0)
        ElseIf nodes[idx].extra = AST_NUM_MILLI Then
            IrEmit(list, OP_MOV_EAX_IMM, nodes[idx].num, 0)
            lab = LowEnsureRtMilliToDouble(ctx)
            LowEmitCall1Rax(list, 0, 0, 0, lab)
        Else
            IrEmit(list, OP_MOV_EAX_IMM, nodes[idx].num, 0)
        End If
        LowExpr = 1
    ElseIf k = AST_STRING Then
        AstCopyStr(ast, idx, VarPtr(buf))
        IrEmitStr(list, OP_LEA_RAX_STR, 0, VarPtr(buf))
        LowExpr = 1
    ElseIf k = AST_VAR Then
        AstCopyStr(ast, idx, VarPtr(name))
        ci = LowFindConst(ctx, VarPtr(name))
        If ci >= 0 Then
            vals = ctx->constVals
            IrEmit(list, OP_MOV_EAX_IMM, vals[ci], 0)
            LowExpr = 1
            Exit Function
        End If
        ci = LowFindStrConst(ctx, VarPtr(name))
        If ci >= 0 Then
            strs = ctx->constStrVals
            IrEmitStr(list, OP_LEA_RAX_STR, 0, VarPtr(strs[ci * AST_STR_LEN]))
            LowExpr = 1
            Exit Function
        End If
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
            Print "error: undefined variable '" + MakeStr(VarPtr(name)) + "'"
            ctx->err = 1
            Exit Function
        End If
        LowEmitLoadOff(list, vOff, vGlob)
        If vByRef <> 0 Then
            IrEmit(list, OP_LOAD_QWORD_RAX, 0, 0)
        End If
        LowExpr = 1
    ElseIf k = AST_MEMBER Then
        If LowAddr(ctx, idx) = 0 Then Exit Function
        AstCopyStr(ast, idx, VarPtr(name))
        base = nodes[idx].left
        If nodes[base].kind = AST_INDEX Then
            AstCopyStr(ast, nodes[base].left, VarPtr(buf))
        ElseIf nodes[base].kind = AST_VAR Then
            AstCopyStr(ast, base, VarPtr(buf))
        Else
            ctx->err = 1
            Exit Function
        End If
        If LowLookupVar(ctx, VarPtr(buf), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
            ctx->err = 1
            Exit Function
        End If
        ti = vTypeIdx
        If TyFindField(tt, ti, VarPtr(name), foff, fsz, fcnt) = 0 Then
            LowLoadSized(list, LowTyNbytes(vTy))
            LowExpr = 1
            Exit Function
        End If
        LowLoadSized(list, fsz)
        LowExpr = 1
    ElseIf k = AST_INDEX Then
        base = nodes[idx].left
        If nodes[base].kind = AST_MEMBER Then
            If LowAddr(ctx, idx) = 0 Then Exit Function
            AstCopyStr(ast, base, VarPtr(name))
            ix = nodes[base].left
            If nodes[ix].kind = AST_INDEX Then
                AstCopyStr(ast, nodes[ix].left, VarPtr(buf))
            ElseIf nodes[ix].kind = AST_VAR Then
                AstCopyStr(ast, ix, VarPtr(buf))
            Else
                ctx->err = 1
                Exit Function
            End If
            If LowLookupVar(ctx, VarPtr(buf), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
                ctx->err = 1
                Exit Function
            End If
            ti = vTypeIdx
            If TyFindFieldEx(tt, ti, VarPtr(name), foff, fsz, fcnt, fieldTy) = 0 Then
                ctx->err = 1
                Exit Function
            End If
            If fcnt > 1 Then
                LowLoadSized(list, fsz)
            ElseIf fsz = TyPtrSize() Then
                LowLoadSized(list, LowPtrFieldElemSize(fieldTy))
            Else
                ctx->err = 1
                Exit Function
            End If
            LowExpr = 1
        Else
            If LowAddr(ctx, idx) = 0 Then Exit Function
            AstCopyStr(ast, base, VarPtr(buf))
            If LowLookupVar(ctx, VarPtr(buf), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
                If vTy = TY_PTR_LONG Or vTy = TY_LONG_ARR Then
                    LowLoadSized(list, 4)
                ElseIf vTy = TY_STRING_ARR Or vTy = TY_DOUBLE_ARR Then
                    LowLoadSized(list, 8)
                ElseIf vTy = TY_SINGLE_ARR Then
                    LowLoadSized(list, 4)
                ElseIf vTy = TY_UDT_ARR Then
                    ' 要素全体の値ロードはしない（メンバアクセス経由）
                    ctx->err = 1
                    Exit Function
                Else
                    IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
                End If
            Else
                IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
            End If
            LowExpr = 1
        End If
    ElseIf k = AST_BUILTIN Then
        If nodes[idx].num = BI_SIZEOF Then
            AstCopyStr(ast, nodes[idx].left, VarPtr(name))
            sz = TySizeOfName(tt, VarPtr(name))
            If sz <= 0 Then
                ' also allow SizeOf(var)
                If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
                    ctx->err = 1
                    Exit Function
                End If
                ' approximate: use frame slot size not ideal; prefer type
                ctx->err = 1
                Exit Function
            End If
            IrEmit(list, OP_MOV_EAX_IMM, sz, 0)
            LowExpr = 1
        ElseIf nodes[idx].num = BI_VARPTR Then
            If LowAddr(ctx, nodes[idx].left) = 0 Then Exit Function
            LowExpr = 1
        ElseIf nodes[idx].num = BI_ADDRESSOF Then
            AstCopyStr(ast, idx, VarPtr(name))
            lab = LowFindFunc(ctx, VarPtr(name))
            If lab < 0 Then
                Print "error: AddressOf unknown function '" + MakeStr(VarPtr(name)) + "'"
                ctx->err = 1
                Exit Function
            End If
            IrEmit(list, OP_LEA_RAX_LAB, lab, 0)
            LowExpr = 1
        ElseIf nodes[idx].num = BI_MALLOC Then
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            LowEmitHeapAllocRax(list, 0)
            LowExpr = 1
        ElseIf nodes[idx].num = BI_FREE Then
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            LowEmitHeapFreeRax(list)
            LowExpr = 1
        ElseIf nodes[idx].num = BI_LEN Then
            ' Len(UDT var) => SizeOf(type); else string Len via lstrlenA
            If nodes[nodes[idx].left].kind = AST_VAR Then
                AstCopyStr(ast, nodes[idx].left, VarPtr(name))
                If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
                    If vTy = TY_UDT Then
                        ti = vTypeIdx
                        If ti >= 0 Then
                            tsizes = tt->typeSizes
                            sz = tsizes[ti]
                            If sz > 0 Then
                                IrEmit(list, OP_MOV_EAX_IMM, sz, 0)
                                LowExpr = 1
                                Exit Function
                            End If
                        End If
                    End If
                End If
            End If
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            labZ = LowNewLab(ctx)
            labE = LowNewLab(ctx)
            LowEmitLoadStrLen(list, labZ, labE)
            LowExpr = 1
        ElseIf nodes[idx].num = BI_MAKEINTRESOURCE Then
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            LowExpr = 1
        ElseIf nodes[idx].num = BI_FILLMEMORY Then
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            If nodes[idx].extra < 0 Then
                ctx->err = 1
                Exit Function
            End If
            If LowExpr(ctx, nodes[idx].extra) = 0 Then Exit Function
            IrEmit(list, OP_MOV_R8_RAX, 0, 0)
            IrEmit(list, OP_POP_RAX, 0, 0)
            IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
            IrEmit(list, OP_POP_RCX, 0, 0)
            lstrcpy(VarPtr(sLen), "RtlFillMemory")
            IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sLen))
            LowExpr = 1
        ElseIf nodes[idx].num = BI_ASC Then
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            labZ = LowNewLab(ctx)
            labE = LowNewLab(ctx)
            IrEmit(list, OP_TEST_RAX, 0, 0)
            IrEmit(list, OP_JZ, labZ, 0)
            IrEmit(list, OP_MOVZX_EAX_BYTE, 0, 0)
            IrEmit(list, OP_JMP, labE, 0)
            IrEmit(list, OP_LABEL, labZ, 0)
            IrEmit(list, OP_XOR_EAX, 0, 0)
            IrEmit(list, OP_LABEL, labE, 0)
            LowExpr = 1
        ElseIf nodes[idx].num = BI_STRPTR Then
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            LowExpr = 1
        ElseIf nodes[idx].num = BI_STR Then
            lab = LowEnsureRtStr(ctx)
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            LowEmitCall1Rax(list, 0, 0, 0, lab)
            LowExpr = 1
        ElseIf nodes[idx].num = BI_MAKESTR Then
            lab = LowEnsureRtMakeStr(ctx)
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            LowEmitCall1Rax(list, 0, 0, 0, lab)
            LowExpr = 1
        ElseIf nodes[idx].num = BI_MEMCPY Then
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            If nodes[idx].extra < 0 Then
                ctx->err = 1
                Exit Function
            End If
            If LowExpr(ctx, nodes[idx].extra) = 0 Then Exit Function
            IrEmit(list, OP_MOV_R8_RAX, 0, 0)
            IrEmit(list, OP_POP_RAX, 0, 0)
            IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
            IrEmit(list, OP_POP_RCX, 0, 0)
            lstrcpy(VarPtr(sLen), "RtlMoveMemory")
            IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sLen))
            LowExpr = 1
        ElseIf nodes[idx].num = BI_LEFT Then
            ' Left$(s, n) => Mid$(s, 1, n)
            lab = LowEnsureRtMid(ctx)
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
            If TyIs32() <> 0 Then
                IrEmit(list, OP_PUSH_RAX, 0, 0)
                IrEmit(list, OP_MOV_EAX_IMM, 1, 0)
                IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
                IrEmit(list, OP_POP_RAX, 0, 0)
                IrEmit(list, OP_POP_RCX, 0, 0)
            Else
                IrEmit(list, OP_MOV_R8_RAX, 0, 0)
                IrEmit(list, OP_MOV_EAX_IMM, 1, 0)
                IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
                IrEmit(list, OP_POP_RCX, 0, 0)
            End If
            LowEmitCallLab3(list, lab)
            LowExpr = 1
        ElseIf nodes[idx].num = BI_MID Then
            lab = LowEnsureRtMid(ctx)
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            If nodes[idx].extra >= 0 Then
                If LowExpr(ctx, nodes[idx].extra) = 0 Then Exit Function
            Else
                IrEmit(list, OP_MOV_EAX_IMM, -1, 0)
            End If
            If TyIs32() <> 0 Then
                IrEmit(list, OP_POP_RDX, 0, 0)
                IrEmit(list, OP_POP_RCX, 0, 0)
            Else
                IrEmit(list, OP_MOV_R8_RAX, 0, 0)
                IrEmit(list, OP_POP_RAX, 0, 0)
                IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
                IrEmit(list, OP_POP_RCX, 0, 0)
            End If
            LowEmitCallLab3(list, lab)
            LowExpr = 1
        ElseIf nodes[idx].num = BI_CHR Then
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            IrEmit(list, OP_MOV_EAX_IMM, 6, 0)
            IrEmit(list, OP_MOV_RCX_RAX, 0, 0)
            LowEmitCallStrHeapAlloc(ctx)
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            IrEmit(list, OP_MOV_ECX, &H80000001, 0)
            IrEmit(list, OP_STORE_DWORD_RAX_ECX, 0, 0)
            IrEmit(list, OP_POP_RAX, 0, 0)
            IrEmit(list, OP_ADD_RAX_IMM, 4, 0)
            IrEmit(list, OP_POP_RCX, 0, 0)
            IrEmit(list, OP_STORE_BYTE_RAX_CL, 0, 0)
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
            IrEmit(list, OP_MOV_ECX, 0, 0)
            IrEmit(list, OP_STORE_BYTE_RAX_CL, 0, 0)
            IrEmit(list, OP_POP_RAX, 0, 0)
            LowExpr = 1
        ElseIf nodes[idx].num = BI_RIGHT Then
            ' Right$(s, n) => Mid$(s, len - n + 1, n)
            If nodes[idx].right < 0 Then
                ctx->err = 1
                Exit Function
            End If
            lab = LowEnsureRtMid(ctx)
            labA = LowNewLab(ctx)
            labB = LowNewLab(ctx)
            labZ = LowNewLab(ctx)
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            ' stack: s, n  →  rax = s, rcx = n
            IrEmit(list, OP_POP_RCX, 0, 0)
            IrEmit(list, OP_POP_RAX, 0, 0)
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
            ' rax = s (stack: s, n) → rax = Len(s)
            IrEmit(list, OP_TEST_RAX, 0, 0)
            IrEmit(list, OP_JZ, labA, 0)
            IrEmit(list, OP_ADD_RAX_IMM, -4, 0)
            IrEmit(list, OP_LOAD_DWORD_RAX, 0, 0)
            IrEmit(list, OP_AND_EAX_IMM, 2147483647, 0)
            IrEmit(list, OP_JMP, labB, 0)
            IrEmit(list, OP_LABEL, labA, 0)
            IrEmit(list, OP_XOR_EAX, 0, 0)
            IrEmit(list, OP_LABEL, labB, 0)
            ' start = len - n + 1（n はスタックへ戻す）
            IrEmit(list, OP_POP_RCX, 0, 0)
            IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
            IrEmit(list, OP_SUB_EAX_ECX, 0, 0)
            IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
            ' if start < 1 then start = 1
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            IrEmit(list, OP_MOV_EAX_IMM, 1, 0)
            IrEmit(list, OP_POP_RCX, 0, 0)
            IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
            IrEmit(list, OP_JL, labZ, 0)
            IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
            IrEmit(list, OP_LABEL, labZ, 0)
            IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
            IrEmit(list, OP_POP_RAX, 0, 0)
            If TyIs32() <> 0 Then
                IrEmit(list, OP_POP_RCX, 0, 0)
            Else
                IrEmit(list, OP_MOV_R8_RAX, 0, 0)
                IrEmit(list, OP_POP_RCX, 0, 0)
            End If
            LowEmitCallLab3(list, lab)
            LowExpr = 1
        ElseIf nodes[idx].num = BIK_RGB Then
            If nodes[idx].right < 0 Or nodes[idx].extra < 0 Then
                ctx->err = 1
                Exit Function
            End If
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
            IrEmit(list, OP_MOV_ECX, 256, 0)
            IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
            IrEmit(list, OP_POP_RCX, 0, 0)
            IrEmit(list, OP_OR_EAX_ECX, 0, 0)
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            If LowExpr(ctx, nodes[idx].extra) = 0 Then Exit Function
            IrEmit(list, OP_MOV_ECX, 65536, 0)
            IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
            IrEmit(list, OP_POP_RCX, 0, 0)
            IrEmit(list, OP_OR_EAX_ECX, 0, 0)
            LowExpr = 1
        ElseIf nodes[idx].num = BI_LOWORD Then
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            IrEmit(list, OP_MOV_ECX, 65535, 0)
            IrEmit(list, OP_AND_EAX_ECX, 0, 0)
            LowExpr = 1
        Else
            Print "error: unsupported builtin " + Str$(nodes[idx].num)
            ctx->err = 1
        End If
    ElseIf k = AST_CALL Then
        AstCopyStr(ast, idx, VarPtr(name))
        If nodes[idx].extra = -3 Then
            ' obj.Method(...) / p->Method(...) — right=receiver, left=user args, str=short name
            ti = LowRecvClassTi(ctx, nodes[idx].right)
            If ti < 0 Then
                Print "error: method call on non-class"
                ctx->err = 1
                Exit Function
            End If
            tt = ast->types
            j = ti * 48
            names = tt->typeNames
            nArgs = nodes[idx].num + 1
            If nArgs > 16 Then
                ctx->err = 1
                Exit Function
            End If
            args[0] = -1
            argi = 1
            argn = nodes[idx].left
            While argn >= 0
                If argi >= 16 Then
                    ctx->err = 1
                    Exit Function
                End If
                args[argi] = argn
                argi = argi + 1
                argn = nodes[argn].nxt
            Wend
            If argi <> nArgs Then
                ctx->err = 1
                Exit Function
            End If
            stk = LowCallStk(nArgs)
            IrEmit(list, OP_SUB_RSP, stk, 0)
            ' user args 1..n-1 into home/stack; this (rcx) set last
            argi = 1
            While argi < nArgs
                useAddr = LowCallUseAddr(ctx, args[argi], 0, 0, 1)
                If useAddr <> 0 Then
                    If LowAddr(ctx, nodes[args[argi]].left) = 0 Then Exit Function
                Else
                    If LowExprArg(ctx, nodes[args[argi]].left) = 0 Then Exit Function
                End If
                IrEmit(list, OP_STORE_RSP_RAX, argi * TyPtrSize(), 0)
                argi = argi + 1
            Wend
            If TyIs32() = 0 Then
            If nArgs >= 4 Then
                IrEmit(list, OP_LOAD_RSP_RAX, 24, 0)
                IrEmit(list, OP_MOV_R9_RAX, 0, 0)
            End If
            If nArgs >= 3 Then
                IrEmit(list, OP_LOAD_RSP_RAX, 16, 0)
                IrEmit(list, OP_MOV_R8_RAX, 0, 0)
            End If
            If nArgs >= 2 Then
                IrEmit(list, OP_LOAD_RSP_RAX, 8, 0)
                IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
            End If
            End If
            ' Me: 値クラスはアドレス、*Class はポインタ値
            If LowRecvIsPtr(ctx, nodes[idx].right) <> 0 Then
                If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
            Else
                If LowAddr(ctx, nodes[idx].right) = 0 Then Exit Function
            End If
            IrEmit(list, OP_STORE_RSP_RAX, 0, 0)
            If TyIs32() = 0 Then
                IrEmit(list, OP_MOV_RCX_RAX, 0, 0)
            End If
            lab = -1
            vals = tt->typeVirtCount
            If vals[ti] > 0 Then
                lab = TyFindVirt(tt, ti, VarPtr(name))
            End If
            If lab >= 0 Then
                ' COM / Virtual: call [ [*this] + slot*8 ]
                IrEmit(list, OP_LOAD_PTR, 0, 0)
                If lab <> 0 Then
                    IrEmit(list, OP_ADD_RAX_IMM, lab * TyPtrSize(), 0)
                End If
                IrEmit(list, OP_LOAD_PTR, 0, 0)
                IrEmit(list, OP_CALL_RAX, 0, 0)
            Else
                LowMangleClass(VarPtr(names[j]), VarPtr(name), VarPtr(buf))
                lab = LowFindFunc(ctx, VarPtr(buf))
                If lab < 0 Then
                    Print "error: unknown method '" + MakeStr(VarPtr(buf)) + "'"
                    ctx->err = 1
                    Exit Function
                End If
                IrEmit(list, OP_CALL_LAB, lab, 0)
            End If
            LowEmitCallFinish(list, stk)
            LowExpr = 1
            Exit Function
        End If
        lstrcpy(VarPtr(buf), "free")
        If LowNameEq(VarPtr(name), VarPtr(buf)) <> 0 Then
            argn = nodes[idx].left
            If argn >= 0 Then
                If nodes[argn].kind = AST_ARG Then argn = nodes[argn].left
            End If
            If LowExpr(ctx, argn) = 0 Then Exit Function
            LowEmitHeapFreeRax(list)
            LowExpr = 1
            Exit Function
        End If
        lstrcpy(VarPtr(buf), "malloc")
        If LowNameEq(VarPtr(name), VarPtr(buf)) <> 0 Then
            argn = nodes[idx].left
            If argn >= 0 Then
                If nodes[argn].kind = AST_ARG Then argn = nodes[argn].left
            End If
            If LowExpr(ctx, argn) = 0 Then Exit Function
            LowEmitHeapAllocRax(list, 0)
            LowExpr = 1
            Exit Function
        End If
        lstrcpy(VarPtr(buf), "calloc")
        If LowNameEq(VarPtr(name), VarPtr(buf)) <> 0 Then
            ' calloc(n) → HeapAlloc(heap, HEAP_ZERO_MEMORY=8, n)
            argn = nodes[idx].left
            If argn >= 0 Then
                If nodes[argn].kind = AST_ARG Then argn = nodes[argn].left
            End If
            If LowExpr(ctx, argn) = 0 Then Exit Function
            LowEmitHeapAllocRax(list, 8)
            LowExpr = 1
            Exit Function
        End If
        lstrcpy(VarPtr(buf), "memcpy")
        If LowNameEq(VarPtr(name), VarPtr(buf)) <> 0 Then
            argi = 0
            argn = nodes[idx].left
            While argn >= 0
                If argi >= 16 Then
                    ctx->err = 1
                    Exit Function
                End If
                args[argi] = argn
                argi = argi + 1
                argn = nodes[argn].nxt
            Wend
            If argi <> 3 Then
                ctx->err = 1
                Exit Function
            End If
            stk = LowCallStk(3)
            If stk > 0 Then
                IrEmit(list, OP_SUB_RSP, stk, 0)
            End If
            If LowExpr(ctx, nodes[args[0]].left) = 0 Then Exit Function
            IrEmit(list, OP_STORE_RSP_RAX, 0, 0)
            If LowExpr(ctx, nodes[args[1]].left) = 0 Then Exit Function
            IrEmit(list, OP_STORE_RSP_RAX, TyPtrSize(), 0)
            If LowExpr(ctx, nodes[args[2]].left) = 0 Then Exit Function
            IrEmit(list, OP_STORE_RSP_RAX, TyPtrSize() + TyPtrSize(), 0)
            LowEmitLoadRegArgs(list, 3)
            lstrcpy(VarPtr(sLen), "RtlMoveMemory")
            IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sLen))
            LowEmitCallFinish(list, stk)
            LowExpr = 1
            Exit Function
        End If
        lstrcpy(VarPtr(buf), "fillmemory")
        If LowNameEq(VarPtr(name), VarPtr(buf)) <> 0 Then
            argi = 0
            argn = nodes[idx].left
            While argn >= 0
                If argi >= 16 Then
                    ctx->err = 1
                    Exit Function
                End If
                args[argi] = argn
                argi = argi + 1
                argn = nodes[argn].nxt
            Wend
            If argi <> 3 Then
                ctx->err = 1
                Exit Function
            End If
            stk = LowCallStk(3)
            If stk > 0 Then
                IrEmit(list, OP_SUB_RSP, stk, 0)
            End If
            If LowExpr(ctx, nodes[args[0]].left) = 0 Then Exit Function
            IrEmit(list, OP_STORE_RSP_RAX, 0, 0)
            If LowExpr(ctx, nodes[args[1]].left) = 0 Then Exit Function
            IrEmit(list, OP_STORE_RSP_RAX, TyPtrSize(), 0)
            If LowExpr(ctx, nodes[args[2]].left) = 0 Then Exit Function
            IrEmit(list, OP_STORE_RSP_RAX, TyPtrSize() + TyPtrSize(), 0)
            LowEmitLoadRegArgs(list, 3)
            lstrcpy(VarPtr(sLen), "RtlFillMemory")
            IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sLen))
            LowEmitCallFinish(list, stk)
            LowExpr = 1
            Exit Function
        End If
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
            If vTy = TY_BYTE_ARR And nodes[idx].num = 1 Then
                If LowAddr(ctx, idx) = 0 Then Exit Function
                IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
                LowExpr = 1
                Exit Function
            End If
            If vTy = TY_LONG_ARR And nodes[idx].num = 1 Then
                If LowAddr(ctx, idx) = 0 Then Exit Function
                IrEmit(list, OP_LOAD_DWORD_RAX, 0, 0)
                LowExpr = 1
                Exit Function
            End If
            If vTy = TY_DOUBLE_ARR And nodes[idx].num = 1 Then
                If LowAddr(ctx, idx) = 0 Then Exit Function
                IrEmit(list, OP_LOAD_QWORD_RAX, 0, 0)
                LowExpr = 1
                Exit Function
            End If
            If vTy = TY_SINGLE_ARR And nodes[idx].num = 1 Then
                If LowAddr(ctx, idx) = 0 Then Exit Function
                IrEmit(list, OP_LOAD_DWORD_RAX, 0, 0)
                LowExpr = 1
                Exit Function
            End If
            If vTy = TY_STRING_ARR And nodes[idx].num = 1 Then
                If LowAddr(ctx, idx) = 0 Then Exit Function
                IrEmit(list, OP_LOAD_PTR, 0, 0)
                LowExpr = 1
                Exit Function
            End If
        End If
        lab = LowFindFunc(ctx, VarPtr(name))
        isApi = 0
        dllKind = 0
        byBits = 0
        If lab >= 0 Then
            byBits = LowFindFuncByRefs(ctx, VarPtr(name))
        Else
            di = LowFindDecl(ctx, VarPtr(name))
            If di >= 0 Then
                LowDeclApiName(ctx, di, VarPtr(apiName))
                dlls = ctx->declDlls
                bys = ctx->declByRefs
                dllKind = dlls[di]
                byBits = bys[di]
                isApi = 1
            Else
                If LowMapWinApi(VarPtr(name), dllKind, VarPtr(apiName)) = 0 Then
                    Print "error: unknown API/call '" + MakeStr(VarPtr(name)) + "'"
                    ctx->err = 1
                    Exit Function
                End If
                isApi = 1
            End If
        End If
        If isApi <> 0 Then
            If dllKind = 0 Then dllKind = IR_DLL_KERNEL32
        End If
        nArgs = nodes[idx].num
        If nArgs > 16 Then
            Print "error: too many call args (" + Str$(nArgs) + ") '" + MakeStr(VarPtr(name)) + "'"
            ctx->err = 1
            Exit Function
        End If
        ' collect AST_ARG nodes
        argi = 0
        argn = nodes[idx].left
        While argn >= 0
            If argi >= 16 Then
                ctx->err = 1
                Exit Function
            End If
            args[argi] = argn
            argi = argi + 1
            argn = nodes[argn].nxt
        Wend
        If argi <> nArgs Then
            ctx->err = 1
            Exit Function
        End If
        ' stack space: 64-bit shadow+stack args, 32-bit packed stdcall
        stk = LowCallStk(nArgs)
        If stk > 120 Then
            Print "error: call stack too large (" + Str$(stk) + ") '" + MakeStr(VarPtr(name)) + "'"
            ctx->err = 1
            Exit Function
        End If
        If stk > 0 Then
            IrEmit(list, OP_SUB_RSP, stk, 0)
        End If
        ' Evaluate all args into home/stack slots first so nested calls
        ' (Len/lstrlenA etc.) cannot clobber already-set arg registers.
        argi = 0
        While argi < nArgs
            bbit = 1
            j = 0
            While j < argi
                bbit = bbit * 2
                j = j + 1
            Wend
            useAddr = LowCallUseAddr(ctx, args[argi], byBits, bbit, isApi)
            If useAddr <> 0 Then
                If LowAddr(ctx, nodes[args[argi]].left) = 0 Then Exit Function
            Else
                If LowExprArg(ctx, nodes[args[argi]].left) = 0 Then Exit Function
            End If
            IrEmit(list, OP_STORE_RSP_RAX, argi * TyPtrSize(), 0)
            argi = argi + 1
        Wend
        LowEmitLoadRegArgs(list, nArgs)
        If isApi <> 0 Then
            IrEmitStr(list, OP_CALL_API, dllKind, VarPtr(apiName))
        Else
            IrEmit(list, OP_CALL_LAB, lab, 0)
        End If
        LowEmitCallFinish(list, stk)
        LowExpr = 1
    ElseIf k = AST_UNARY Then
        If nodes[idx].num = UOP_NEG Then
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            If LowExprType(ctx, nodes[idx].left) = TY_DOUBLE Then
                IrEmit(list, OP_NEG_SD, 0, 0)
            Else
                IrEmit(list, OP_NEG_EAX, 0, 0)
            End If
            LowExpr = 1
        ElseIf nodes[idx].num = UOP_NOT Then
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            IrEmit(list, OP_NOT_EAX, 0, 0)
            LowExpr = 1
        Else
            ctx->err = 1
        End If
    ElseIf k = AST_BINOP Then
        op = nodes[idx].num
        fty = LowPromoteType(LowExprType(ctx, nodes[idx].left), LowExprType(ctx, nodes[idx].right))
        If op = BOP_ADD Or op = BOP_CAT Then
            If LowIsStringExpr(ctx, nodes[idx].left) <> 0 Or LowIsStringExpr(ctx, nodes[idx].right) <> 0 Then
                lab = LowEnsureRtCat(ctx)
                If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
                IrEmit(list, OP_PUSH_RAX, 0, 0)
                If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
                IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
                IrEmit(list, OP_POP_RCX, 0, 0)
                LowEmitCallLab2(list, lab)
                LowExpr = 1
                Exit Function
            End If
        End If
        If op = BOP_ADD Or op = BOP_MUL Or op = BOP_AND Or op = BOP_OR Or op = BOP_SUB Or op = BOP_XOR Then
            If fty = TY_DOUBLE And (op = BOP_ADD Or op = BOP_MUL Or op = BOP_SUB) Then
                If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
                LowEmitCvtRaxToDoubleFromTy(ctx, LowExprType(ctx, nodes[idx].left))
                IrEmit(list, OP_PUSH_RAX, 0, 0)
                If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
                LowEmitCvtRaxToDoubleFromTy(ctx, LowExprType(ctx, nodes[idx].right))
                IrEmit(list, OP_POP_RCX, 0, 0)
                If op = BOP_ADD Then
                    IrEmit(list, OP_ADD_SD, 0, 0)
                ElseIf op = BOP_SUB Then
                    IrEmit(list, OP_SUB_SD, 0, 0)
                Else
                    IrEmit(list, OP_MUL_SD, 0, 0)
                End If
                LowExpr = 1
            Else
                If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
                IrEmit(list, OP_PUSH_RAX, 0, 0)
                If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
                IrEmit(list, OP_POP_RCX, 0, 0)
                If op = BOP_ADD Then
                    IrEmit(list, OP_ADD_EAX_ECX, 0, 0)
                ElseIf op = BOP_SUB Then
                    IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
                    IrEmit(list, OP_SUB_EAX_ECX, 0, 0)
                ElseIf op = BOP_MUL Then
                    IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
                ElseIf op = BOP_AND Then
                    IrEmit(list, OP_AND_EAX_ECX, 0, 0)
                ElseIf op = BOP_XOR Then
                    IrEmit(list, OP_XOR_EAX_ECX, 0, 0)
                Else
                    IrEmit(list, OP_OR_EAX_ECX, 0, 0)
                End If
                LowExpr = 1
            End If
        ElseIf op = BOP_IDIV Or op = BOP_DIV Then
            If fty = TY_DOUBLE Then
                If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
                LowEmitCvtRaxToDoubleFromTy(ctx, LowExprType(ctx, nodes[idx].left))
                IrEmit(list, OP_PUSH_RAX, 0, 0)
                If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
                LowEmitCvtRaxToDoubleFromTy(ctx, LowExprType(ctx, nodes[idx].right))
                IrEmit(list, OP_POP_RCX, 0, 0)
                IrEmit(list, OP_DIV_SD, 0, 0)
                LowExpr = 1
            Else
            ' eax = left, ecx = right, edx = 0 → div ecx
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
            IrEmit(list, OP_MOV_ECX_EAX, 0, 0)
            IrEmit(list, OP_POP_RAX, 0, 0)
            IrEmit(list, OP_XOR_EDX, 0, 0)
            IrEmit(list, OP_DIV_ECX, 0, 0)
            LowExpr = 1
            End If
        ElseIf op = BOP_MOD Then
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
            IrEmit(list, OP_MOV_ECX_EAX, 0, 0)
            IrEmit(list, OP_POP_RAX, 0, 0)
            IrEmit(list, OP_XOR_EDX, 0, 0)
            IrEmit(list, OP_DIV_ECX, 0, 0)
            IrEmit(list, OP_MOV_EAX_EDX, 0, 0)
            LowExpr = 1
        ElseIf op = BOP_SHL Or op = BOP_SHR Then
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
            IrEmit(list, OP_MOV_ECX_EAX, 0, 0)
            IrEmit(list, OP_POP_RAX, 0, 0)
            If op = BOP_SHL Then
                IrEmit(list, OP_SHL_EAX_CL, 0, 0)
            Else
                IrEmit(list, OP_SAR_EAX_CL, 0, 0)
            End If
            LowExpr = 1
        ElseIf op = BOP_POW Then
            ' eax = left ^ right（非負指数の整数累乗）
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
            IrEmit(list, OP_MOV_ECX_EAX, 0, 0)
            IrEmit(list, OP_POP_RAX, 0, 0)
            IrEmit(list, OP_MOV_EDX_EAX, 0, 0)
            IrEmit(list, OP_MOV_EAX_IMM, 1, 0)
            lab = LowNewLab(ctx)
            labB = LowNewLab(ctx)
            IrEmit(list, OP_LABEL, lab, 0)
            IrEmit(list, OP_TEST_ECX, 0, 0)
            IrEmit(list, OP_JZ, labB, 0)
            IrEmit(list, OP_IMUL_EAX_EDX, 0, 0)
            IrEmit(list, OP_DEC_ECX, 0, 0)
            IrEmit(list, OP_JMP, lab, 0)
            IrEmit(list, OP_LABEL, labB, 0)
            LowExpr = 1
        ElseIf op = BOP_EQ Or op = BOP_NE Or op = BOP_LT Or op = BOP_LE Or op = BOP_GT Or op = BOP_GE Then
            ' 関係演算の値: 真=-1 / 偽=0（文字列は辞書順 lstrcmpA）
            If LowIsStringExpr(ctx, nodes[idx].left) <> 0 Or LowIsStringExpr(ctx, nodes[idx].right) <> 0 Then
                If LowEmitStrCmp(ctx, nodes[idx].left, nodes[idx].right) = 0 Then Exit Function
                IrEmit(list, OP_TEST_EAX, 0, 0)
                IrEmit(list, OP_MOV_EAX_IMM, 0, 0)
                labB = LowNewLab(ctx)
                If op = BOP_EQ Then
                    IrEmit(list, OP_JNZ, labB, 0)
                ElseIf op = BOP_NE Then
                    IrEmit(list, OP_JZ, labB, 0)
                ElseIf op = BOP_LT Then
                    IrEmit(list, OP_JGE, labB, 0)
                ElseIf op = BOP_LE Then
                    IrEmit(list, OP_JG, labB, 0)
                ElseIf op = BOP_GT Then
                    IrEmit(list, OP_JLE, labB, 0)
                Else
                    IrEmit(list, OP_JL, labB, 0)
                End If
                IrEmit(list, OP_MOV_EAX_IMM, -1, 0)
                IrEmit(list, OP_LABEL, labB, 0)
                LowExpr = 1
            ElseIf fty = TY_DOUBLE Then
                If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
                LowEmitCvtRaxToDoubleFromTy(ctx, LowExprType(ctx, nodes[idx].left))
                IrEmit(list, OP_PUSH_RAX, 0, 0)
                If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
                LowEmitCvtRaxToDoubleFromTy(ctx, LowExprType(ctx, nodes[idx].right))
                IrEmit(list, OP_POP_RCX, 0, 0)
                IrEmit(list, OP_UCOMISD, 0, 0)
                IrEmit(list, OP_MOV_EAX_IMM, 0, 0)
                labB = LowNewLab(ctx)
                If op = BOP_EQ Then
                    IrEmit(list, OP_JNE, labB, 0)
                ElseIf op = BOP_NE Then
                    IrEmit(list, OP_JE, labB, 0)
                ElseIf op = BOP_LT Then
                    IrEmit(list, OP_JAE, labB, 0)
                ElseIf op = BOP_LE Then
                    IrEmit(list, OP_JA, labB, 0)
                ElseIf op = BOP_GT Then
                    IrEmit(list, OP_JBE, labB, 0)
                Else
                    IrEmit(list, OP_JB, labB, 0)
                End If
                IrEmit(list, OP_MOV_EAX_IMM, -1, 0)
                IrEmit(list, OP_LABEL, labB, 0)
                LowExpr = 1
            Else
                If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
                IrEmit(list, OP_PUSH_RAX, 0, 0)
                If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
                IrEmit(list, OP_POP_RCX, 0, 0)
                IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
                IrEmit(list, OP_MOV_EAX_IMM, 0, 0)
                labB = LowNewLab(ctx)
                If op = BOP_EQ Then
                    IrEmit(list, OP_JNE, labB, 0)
                ElseIf op = BOP_NE Then
                    IrEmit(list, OP_JE, labB, 0)
                ElseIf op = BOP_LT Then
                    IrEmit(list, OP_JGE, labB, 0)
                ElseIf op = BOP_LE Then
                    IrEmit(list, OP_JG, labB, 0)
                ElseIf op = BOP_GT Then
                    IrEmit(list, OP_JLE, labB, 0)
                Else
                    IrEmit(list, OP_JL, labB, 0)
                End If
                IrEmit(list, OP_MOV_EAX_IMM, -1, 0)
                IrEmit(list, OP_LABEL, labB, 0)
                LowExpr = 1
            End If
        Else
            Print "error: unsupported binop " + Str$(op)
            ctx->err = 1
        End If
    ElseIf k = AST_CAST Then
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        If nodes[idx].num <> 0 Then
            IrEmit(list, OP_AND_EAX_IMM, nodes[idx].num, 0)
        End If
        LowExpr = 1
    Else
        Print "error: unsupported expr kind " + Str$(k)
        ctx->err = 1
    End If
End Function

' 文字列比較: 長さ付き辞書順 → eax（<0 / 0 / >0）。NULL は空文字扱い
Function LowEmitStrCmp(ctx As *LowerCtx, leftIdx As Long, rightIdx As Long) As Long
    Dim list As *IrList
    Dim empty(1) As Byte
    Dim labA As Long
    Dim labB As Long
    Dim lab As Long

    LowEmitStrCmp = 0
    list = ctx->list
    empty[0] = 0
    lab = LowEnsureRtStrCmp(ctx)
    labA = LowNewLab(ctx)
    labB = LowNewLab(ctx)
    If LowExpr(ctx, leftIdx) = 0 Then Exit Function
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JNZ, labA, 0)
    IrEmitStr(list, OP_LEA_RAX_STR, 0, VarPtr(empty))
    IrEmit(list, OP_LABEL, labA, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    If LowExpr(ctx, rightIdx) = 0 Then Exit Function
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JNZ, labB, 0)
    IrEmitStr(list, OP_LEA_RAX_STR, 0, VarPtr(empty))
    IrEmit(list, OP_LABEL, labB, 0)
    IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    LowEmitCallLab2(list, lab)
    LowEmitStrCmp = 1
End Function

' Emit cmp for a comparison BINOP; return jcc that jumps when FALSE
Function LowCmpFalseJcc(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim op As Long
    Dim list As *IrList
    Dim fty As Long
    Dim lty As Long
    Dim rty As Long

    LowCmpFalseJcc = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    If nodes[idx].kind <> AST_BINOP Then
        ctx->err = 1
        Exit Function
    End If
    op = nodes[idx].num
    If LowIsStringExpr(ctx, nodes[idx].left) <> 0 Or LowIsStringExpr(ctx, nodes[idx].right) <> 0 Then
        If LowEmitStrCmp(ctx, nodes[idx].left, nodes[idx].right) = 0 Then Exit Function
        IrEmit(list, OP_TEST_EAX, 0, 0)
        If op = BOP_EQ Then
            LowCmpFalseJcc = OP_JNZ
        ElseIf op = BOP_NE Then
            LowCmpFalseJcc = OP_JZ
        ElseIf op = BOP_LT Then
            LowCmpFalseJcc = OP_JGE
        ElseIf op = BOP_LE Then
            LowCmpFalseJcc = OP_JG
        ElseIf op = BOP_GT Then
            LowCmpFalseJcc = OP_JLE
        ElseIf op = BOP_GE Then
            LowCmpFalseJcc = OP_JL
        Else
            ctx->err = 1
        End If
        Exit Function
    End If
    lty = LowExprType(ctx, nodes[idx].left)
    rty = LowExprType(ctx, nodes[idx].right)
    fty = LowPromoteType(lty, rty)
    If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
    If fty = TY_DOUBLE Then
        LowEmitCvtRaxToDoubleFromTy(ctx, lty)
    End If
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
    If fty = TY_DOUBLE Then
        LowEmitCvtRaxToDoubleFromTy(ctx, rty)
    End If
    IrEmit(list, OP_POP_RCX, 0, 0)
    If fty = TY_DOUBLE Then
        IrEmit(list, OP_UCOMISD, 0, 0)
        If op = BOP_EQ Then
            LowCmpFalseJcc = OP_JNE
        ElseIf op = BOP_NE Then
            LowCmpFalseJcc = OP_JE
        ElseIf op = BOP_LT Then
            LowCmpFalseJcc = OP_JAE
        ElseIf op = BOP_LE Then
            LowCmpFalseJcc = OP_JA
        ElseIf op = BOP_GT Then
            LowCmpFalseJcc = OP_JBE
        ElseIf op = BOP_GE Then
            LowCmpFalseJcc = OP_JB
        Else
            ctx->err = 1
        End If
        Exit Function
    End If
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    If op = BOP_EQ Then
        LowCmpFalseJcc = OP_JNE
    ElseIf op = BOP_NE Then
        LowCmpFalseJcc = OP_JE
    ElseIf op = BOP_LT Then
        LowCmpFalseJcc = OP_JGE
    ElseIf op = BOP_LE Then
        LowCmpFalseJcc = OP_JG
    ElseIf op = BOP_GT Then
        LowCmpFalseJcc = OP_JLE
    ElseIf op = BOP_GE Then
        LowCmpFalseJcc = OP_JL
    Else
        ctx->err = 1
    End If
End Function

Function LowCmpTrueJcc(falseJcc As Long) As Long
    LowCmpTrueJcc = 0
    If falseJcc = OP_JNE Then
        LowCmpTrueJcc = OP_JE
    ElseIf falseJcc = OP_JE Then
        LowCmpTrueJcc = OP_JNE
    ElseIf falseJcc = OP_JNZ Then
        ' string EQ: false=JNZ (lstrcmp != 0), true=JZ
        LowCmpTrueJcc = OP_JZ
    ElseIf falseJcc = OP_JZ Then
        ' string NE: false=JZ, true=JNZ
        LowCmpTrueJcc = OP_JNZ
    ElseIf falseJcc = OP_JGE Then
        LowCmpTrueJcc = OP_JL
    ElseIf falseJcc = OP_JG Then
        LowCmpTrueJcc = OP_JLE
    ElseIf falseJcc = OP_JLE Then
        LowCmpTrueJcc = OP_JG
    ElseIf falseJcc = OP_JL Then
        LowCmpTrueJcc = OP_JGE
    ElseIf falseJcc = OP_JAE Then
        LowCmpTrueJcc = OP_JB
    ElseIf falseJcc = OP_JB Then
        LowCmpTrueJcc = OP_JAE
    ElseIf falseJcc = OP_JA Then
        LowCmpTrueJcc = OP_JBE
    ElseIf falseJcc = OP_JBE Then
        LowCmpTrueJcc = OP_JA
    End If
End Function

Function LowJumpIfFalse(ctx As *LowerCtx, idx As Long, lab As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim op As Long
    Dim jcc As Long
    Dim labSkip As Long

    LowJumpIfFalse = 0
    ast = ctx->ast
    nodes = ast->nodes
    If nodes[idx].kind = AST_UNARY Then
        If nodes[idx].num = UOP_NOT Then
            If LowJumpIfTrue(ctx, nodes[idx].left, lab) = 0 Then Exit Function
            LowJumpIfFalse = 1
            Exit Function
        End If
    End If
    If nodes[idx].kind <> AST_BINOP Then
        If LowExpr(ctx, idx) = 0 Then Exit Function
        IrEmit(ctx->list, OP_TEST_EAX, 0, 0)
        IrEmit(ctx->list, OP_JZ, lab, 0)
        LowJumpIfFalse = 1
        Exit Function
    End If
    op = nodes[idx].num
    If op = BOP_AND Then
        If LowJumpIfFalse(ctx, nodes[idx].left, lab) = 0 Then Exit Function
        If LowJumpIfFalse(ctx, nodes[idx].right, lab) = 0 Then Exit Function
        LowJumpIfFalse = 1
    ElseIf op = BOP_OR Then
        labSkip = LowNewLab(ctx)
        If LowJumpIfTrue(ctx, nodes[idx].left, labSkip) = 0 Then Exit Function
        If LowJumpIfFalse(ctx, nodes[idx].right, lab) = 0 Then Exit Function
        IrEmit(ctx->list, OP_LABEL, labSkip, 0)
        LowJumpIfFalse = 1
    ElseIf op = BOP_EQ Or op = BOP_NE Or op = BOP_LT Or op = BOP_LE Or op = BOP_GT Or op = BOP_GE Then
        jcc = LowCmpFalseJcc(ctx, idx)
        If jcc = 0 Then Exit Function
        IrEmit(ctx->list, jcc, lab, 0)
        LowJumpIfFalse = 1
    Else
        If LowExpr(ctx, idx) = 0 Then Exit Function
        IrEmit(ctx->list, OP_TEST_EAX, 0, 0)
        IrEmit(ctx->list, OP_JZ, lab, 0)
        LowJumpIfFalse = 1
    End If
End Function

Function LowJumpIfTrue(ctx As *LowerCtx, idx As Long, lab As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim op As Long
    Dim jcc As Long
    Dim jTrue As Long
    Dim labSkip As Long

    LowJumpIfTrue = 0
    ast = ctx->ast
    nodes = ast->nodes
    If nodes[idx].kind = AST_UNARY Then
        If nodes[idx].num = UOP_NOT Then
            If LowJumpIfFalse(ctx, nodes[idx].left, lab) = 0 Then Exit Function
            LowJumpIfTrue = 1
            Exit Function
        End If
    End If
    If nodes[idx].kind <> AST_BINOP Then
        If LowExpr(ctx, idx) = 0 Then Exit Function
        IrEmit(ctx->list, OP_TEST_EAX, 0, 0)
        IrEmit(ctx->list, OP_JNZ, lab, 0)
        LowJumpIfTrue = 1
        Exit Function
    End If
    op = nodes[idx].num
    If op = BOP_OR Then
        If LowJumpIfTrue(ctx, nodes[idx].left, lab) = 0 Then Exit Function
        If LowJumpIfTrue(ctx, nodes[idx].right, lab) = 0 Then Exit Function
        LowJumpIfTrue = 1
    ElseIf op = BOP_AND Then
        labSkip = LowNewLab(ctx)
        If LowJumpIfFalse(ctx, nodes[idx].left, labSkip) = 0 Then Exit Function
        If LowJumpIfTrue(ctx, nodes[idx].right, lab) = 0 Then Exit Function
        IrEmit(ctx->list, OP_LABEL, labSkip, 0)
        LowJumpIfTrue = 1
    ElseIf op = BOP_EQ Or op = BOP_NE Or op = BOP_LT Or op = BOP_LE Or op = BOP_GT Or op = BOP_GE Then
        jcc = LowCmpFalseJcc(ctx, idx)
        If jcc = 0 Then Exit Function
        jTrue = LowCmpTrueJcc(jcc)
        If jTrue = 0 Then
            ctx->err = 1
            Exit Function
        End If
        IrEmit(ctx->list, jTrue, lab, 0)
        LowJumpIfTrue = 1
    Else
        If LowExpr(ctx, idx) = 0 Then Exit Function
        IrEmit(ctx->list, OP_TEST_EAX, 0, 0)
        IrEmit(ctx->list, OP_JNZ, lab, 0)
        LowJumpIfTrue = 1
    End If
End Function

' If を別関数に分離（LowStmt 巨大フレームの入れ子によるスタック破壊を避ける）
Function LowStmtIf(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim labElse As Long
    Dim labEnd As Long
    Dim thenList As Long
    Dim elseList As Long
    Dim r As Long

    LowStmtIf = 0
    ast = ctx->ast
    nodes = ast->nodes
    thenList = nodes[idx].right
    elseList = nodes[idx].extra
    labElse = LowNewLab(ctx)
    labEnd = LowNewLab(ctx)
    r = LowJumpIfFalse(ctx, nodes[idx].left, labElse)
    If r = 0 Then Exit Function
    r = LowStmtList(ctx, thenList)
    If r = 0 Then Exit Function
    IrEmit(ctx->list, OP_JMP, labEnd, 0)
    IrEmit(ctx->list, OP_LABEL, labElse, 0)
    r = LowStmtList(ctx, elseList)
    If r = 0 Then Exit Function
    IrEmit(ctx->list, OP_LABEL, labEnd, 0)
    LowStmtIf = 1
End Function

Function LowStmt(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim k As Long

    ' 薄いディスパッチ: 巨大フレームの LowStmtHeavy を入れ子にしない
    LowStmt = 0
    If idx < 0 Then
        LowStmt = 1
        Exit Function
    End If
    ast = ctx->ast
    nodes = ast->nodes
    k = nodes[idx].kind
    If k = AST_IF Then
        LowStmt = LowStmtIf(ctx, idx)
        Exit Function
    End If
    If k = AST_CALL Then
        LowStmt = LowExpr(ctx, idx)
        Exit Function
    End If
    If k = AST_EXITFUNC Then
        If g_funcEndLab < 0 Then
            ctx->err = 1
            Exit Function
        End If
        IrEmit(ctx->list, OP_JMP, g_funcEndLab, 0)
        LowStmt = 1
        Exit Function
    End If
    LowStmt = LowStmtHeavy(ctx, idx)
End Function

Function LowStmtHeavy(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim k As Long
    Dim name(63) As Byte
    Dim si As Long
    Dim offs As *Long
    Dim labElse As Long
    Dim labEnd As Long
    Dim labTop As Long
    Dim lab As Long
    Dim labStr As Long
    Dim jcc As Long
    Dim body As Long
    Dim leftK As Long
    Dim leftIdx As Long
    Dim tt As *TypeTable
    Dim typeIdxs As *Long
    Dim foff As Long
    Dim fsz As Long
    Dim fcnt As Long
    Dim fieldTy As Long
    Dim ti As Long
    Dim fname(63) As Byte
    Dim base As Long
    Dim ix As Long
    Dim saveDo As Long
    Dim saveWhile As Long
    Dim saveFor As Long
    Dim doMode As Long
    Dim cond As Long
    Dim stepIdx As Long
    Dim labStepNeg As Long
    Dim labStepCont As Long
    Dim useInc As Long
    Dim byRefs As *Long
    Dim types As *Long
    Dim list As *IrList
    Dim args(15) As Long
    Dim argi As Long
    Dim argn As Long
    Dim nArgs As Long
    Dim stk As Long
    Dim labSub As Long
    Dim labDone As Long
    Dim sApi(31) As Byte
    Dim j As Long
    Dim kCtor(7) As Byte
    Dim names As *Byte

    LowStmtHeavy = 0
    If idx < 0 Then
        LowStmtHeavy = 1
        Exit Function
    End If
    ast = ctx->ast
    nodes = ast->nodes
    k = nodes[idx].kind
    tt = ast->types
    typeIdxs = ctx->typeIdxs

    If k = AST_DIM Then
        AstCopyStr(ast, idx, VarPtr(name))
        If nodes[idx].num = TY_UDT Then
            ti = nodes[idx].extra
            If ti >= 0 Then
                If TyIsClass(tt, ti) <> 0 Then
                    ' call Class_Ctor(Me, args...)
                    j = ti * 48
                    lstrcpy(VarPtr(kCtor), "Ctor")
                    names = tt->typeNames
                    LowMangleClass(VarPtr(names[j]), VarPtr(kCtor), VarPtr(name))
                    lab = LowFindFunc(ctx, VarPtr(name))
                    If lab < 0 Then
                        Print "error: missing ctor '" + MakeStr(VarPtr(name)) + "'"
                        ctx->err = 1
                        Exit Function
                    End If
                    ' count ctor user args
                    nArgs = 1
                    argn = nodes[idx].right
                    While argn >= 0
                        If nodes[argn].kind <> AST_ARG Then Exit While
                        nArgs = nArgs + 1
                        argn = nodes[argn].nxt
                    Wend
                    ' if right is not ARG (scalar init), skip class ctor path below
                    If nodes[idx].right >= 0 Then
                        If nodes[nodes[idx].right].kind <> AST_ARG Then
                            nArgs = -1
                        End If
                    End If
                    If nArgs > 0 Then
                        stk = LowCallStk(nArgs)
                        If stk > 0 Then
                            IrEmit(ctx->list, OP_SUB_RSP, stk, 0)
                        End If
                        ' collect user args into args[]
                        argi = 1
                        argn = nodes[idx].right
                        While argn >= 0 And argi < 16
                            If nodes[argn].kind <> AST_ARG Then Exit While
                            args[argi] = argn
                            argi = argi + 1
                            argn = nodes[argn].nxt
                        Wend
                        argi = 1
                        While argi < nArgs
                            If LowExprArg(ctx, nodes[args[argi]].left) = 0 Then Exit Function
                            IrEmit(ctx->list, OP_STORE_RSP_RAX, argi * TyPtrSize(), 0)
                            argi = argi + 1
                        Wend
                        AstCopyStr(ast, idx, VarPtr(fname))
                        If LowLookupVar(ctx, VarPtr(fname), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
                            ctx->err = 1
                            Exit Function
                        End If
                        LowEmitLeaOff(ctx->list, vOff, vGlob)
                        IrEmit(ctx->list, OP_STORE_RSP_RAX, 0, 0)
                        LowEmitLoadRegArgs(ctx->list, nArgs)
                        IrEmit(ctx->list, OP_CALL_LAB, lab, 0)
                        LowEmitCallFinish(ctx->list, stk)
                        LowStmtHeavy = 1
                        Exit Function
                    End If
                End If
            End If
        End If
        If nodes[idx].right >= 0 Then
            If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
            AstCopyStr(ast, idx, VarPtr(name))
            If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
                ctx->err = 1
                Exit Function
            End If
            If vTy = TY_SINGLE Then
                LowEmitCvtToSingleIfNeeded(ctx, nodes[idx].right)
            ElseIf vTy = TY_DOUBLE Then
                LowEmitCvtToDoubleIfNeeded(ctx, nodes[idx].right)
            Else
                LowEmitCvtToLongIfNeeded(ctx, nodes[idx].right, vTy)
            End If
            LowEmitStoreOff(ctx->list, vOff, vGlob)
        End If
        LowStmtHeavy = 1
    ElseIf k = AST_CONST Then
        LowStmtHeavy = 1
    ElseIf k = AST_TYPE Then
        LowStmtHeavy = 1
    ElseIf k = AST_ASSIGN Then
        leftIdx = nodes[idx].left
        leftK = nodes[leftIdx].kind
        If leftK = AST_INDEX Or leftK = AST_CALL Then
            If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
            If leftK = AST_CALL Then
                AstCopyStr(ast, leftIdx, VarPtr(name))
                If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
                    If vTy = TY_SINGLE_ARR Then
                        LowEmitCvtToSingleIfNeeded(ctx, nodes[idx].right)
                    ElseIf vTy = TY_DOUBLE_ARR Then
                        LowEmitCvtToDoubleIfNeeded(ctx, nodes[idx].right)
                    End If
                End If
            Else
                base = nodes[leftIdx].left
                If nodes[base].kind = AST_VAR Then
                    AstCopyStr(ast, base, VarPtr(name))
                    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
                        If vTy = TY_SINGLE_ARR Then
                            LowEmitCvtToSingleIfNeeded(ctx, nodes[idx].right)
                        ElseIf vTy = TY_DOUBLE_ARR Then
                            LowEmitCvtToDoubleIfNeeded(ctx, nodes[idx].right)
                        End If
                    End If
                End If
            End If
            IrEmit(ctx->list, OP_PUSH_RAX, 0, 0)
            If LowAddr(ctx, nodes[idx].left) = 0 Then Exit Function
            IrEmit(ctx->list, OP_POP_RCX, 0, 0)
            If leftK = AST_CALL Then
                AstCopyStr(ast, leftIdx, VarPtr(name))
                If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
                    If vTy = TY_STRING_ARR Or vTy = TY_DOUBLE_ARR Then
                        IrEmit(ctx->list, OP_STORE_PTR, 0, 0)
                    ElseIf vTy = TY_LONG_ARR Or vTy = TY_SINGLE_ARR Then
                        LowStoreSized(ctx->list, 4)
                    Else
                        IrEmit(ctx->list, OP_STORE_BYTE_RAX_CL, 0, 0)
                    End If
                Else
                    IrEmit(ctx->list, OP_STORE_BYTE_RAX_CL, 0, 0)
                End If
            Else
                base = nodes[leftIdx].left
                If nodes[base].kind = AST_MEMBER Then
                    AstCopyStr(ast, base, VarPtr(fname))
                    ix = nodes[base].left
                    If nodes[ix].kind = AST_INDEX Then
                        AstCopyStr(ast, nodes[ix].left, VarPtr(name))
                    ElseIf nodes[ix].kind = AST_VAR Then
                        AstCopyStr(ast, ix, VarPtr(name))
                    Else
                        ctx->err = 1
                        Exit Function
                    End If
                    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
                        ctx->err = 1
                        Exit Function
                    End If
                    ti = vTypeIdx
                    If TyFindFieldEx(tt, ti, VarPtr(fname), foff, fsz, fcnt, fieldTy) = 0 Then
                        ctx->err = 1
                        Exit Function
                    End If
                    If fcnt > 1 Then
                        LowStoreSized(ctx->list, fsz)
                    ElseIf fsz = TyPtrSize() Then
                        LowStoreSized(ctx->list, LowPtrFieldElemSize(fieldTy))
                    Else
                        ctx->err = 1
                        Exit Function
                    End If
                Else
                    AstCopyStr(ast, base, VarPtr(name))
                    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
                        If vTy = TY_STRING_ARR Or vTy = TY_DOUBLE_ARR Then
                            IrEmit(ctx->list, OP_STORE_PTR, 0, 0)
                        ElseIf vTy = TY_LONG_ARR Or vTy = TY_SINGLE_ARR Then
                            LowStoreSized(ctx->list, 4)
                        ElseIf vTy = TY_PTR_LONG Then
                            LowStoreSized(ctx->list, 4)
                        Else
                            IrEmit(ctx->list, OP_STORE_BYTE_RAX_CL, 0, 0)
                        End If
                    Else
                        IrEmit(ctx->list, OP_STORE_BYTE_RAX_CL, 0, 0)
                    End If
                End If
            End If
            LowStmtHeavy = 1
        ElseIf leftK = AST_MEMBER Then
            If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
            IrEmit(ctx->list, OP_PUSH_RAX, 0, 0)
            If LowAddr(ctx, nodes[idx].left) = 0 Then Exit Function
            IrEmit(ctx->list, OP_POP_RCX, 0, 0)
            fsz = LowMemberFieldSize(ctx, leftIdx)
            If fsz <= 0 Then
                AstCopyStr(ast, leftIdx, VarPtr(name))
                base = nodes[leftIdx].left
                If nodes[base].kind = AST_VAR Then
                    AstCopyStr(ast, base, VarPtr(name))
                    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
                        fsz = LowTyNbytes(vTy)
                    End If
                End If
            End If
            If fsz <= 0 Then
                AstCopyStr(ast, leftIdx, VarPtr(name))
                Print "error: bad member field '" + MakeStr(VarPtr(name)) + "'"
                ctx->err = 1
                Exit Function
            End If
            LowStoreSized(ctx->list, fsz)
            LowStmtHeavy = 1
        ElseIf leftK = AST_VAR Then
            If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
            AstCopyStr(ast, nodes[idx].left, VarPtr(name))
            If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
                Print "error: assign to undefined '" + MakeStr(VarPtr(name)) + "'"
                ctx->err = 1
                Exit Function
            End If
            If vTy = TY_SINGLE Then
                LowEmitCvtToSingleIfNeeded(ctx, nodes[idx].right)
            ElseIf vTy = TY_DOUBLE Then
                LowEmitCvtToDoubleIfNeeded(ctx, nodes[idx].right)
            Else
                LowEmitCvtToLongIfNeeded(ctx, nodes[idx].right, vTy)
            End If
            If vByRef <> 0 Then
                IrEmit(ctx->list, OP_PUSH_RAX, 0, 0)
                LowEmitLoadOff(ctx->list, vOff, vGlob)
                IrEmit(ctx->list, OP_POP_RCX, 0, 0)
                IrEmit(ctx->list, OP_STORE_PTR, 0, 0)
            ElseIf vTy = TY_STRING Then
                LowEmitStoreString(ctx, vOff, vGlob)
            Else
                LowEmitStoreOff(ctx->list, vOff, vGlob)
            End If
            LowStmtHeavy = 1
        Else
            ctx->err = 1
        End If
    ElseIf k = AST_FUNC Then
        ' emitted separately
        LowStmtHeavy = 1
    ElseIf k = AST_DECLARE Then
        ' 宣言のみ（コード生成なし）
        LowStmtHeavy = 1
    ElseIf k = AST_INSMENU Then
        ' InsertMenuA(hMenu, pos, flags, uIDNewItem, lpNewItem)
        list = ctx->list
        argi = 0
        argn = nodes[idx].left
        While argn >= 0
            If argi >= 16 Then
                ctx->err = 1
                Exit Function
            End If
            args[argi] = argn
            argi = argi + 1
            argn = nodes[argn].nxt
        Wend
        nArgs = argi
        If nArgs < 3 Then
            ctx->err = 1
            Exit Function
        End If
        stk = 48
        IrEmit(list, OP_SUB_RSP, stk, 0)
        ' lpNewItem（第5引数）
        If nArgs >= 4 Then
            If LowExpr(ctx, nodes[args[3]].left) = 0 Then Exit Function
        Else
            IrEmit(list, OP_XOR_EAX, 0, 0)
        End If
        IrEmit(list, OP_STORE_RSP_RAX, 32, 0)
        If nArgs >= 6 Then
            ' hSubMenu <> 0 なら uIDNewItem = hSubMenu かつ MF_POPUP
            labSub = LowNewLab(ctx)
            labDone = LowNewLab(ctx)
            If LowExpr(ctx, nodes[args[5]].left) = 0 Then Exit Function
            IrEmit(list, OP_PUSH_RAX, 0, 0)
            IrEmit(list, OP_TEST_RAX, 0, 0)
            IrEmit(list, OP_JNZ, labSub, 0)
            IrEmit(list, OP_POP_RAX, 0, 0)
            If LowExpr(ctx, nodes[args[4]].left) = 0 Then Exit Function
            IrEmit(list, OP_MOV_R9_RAX, 0, 0)
            If LowExpr(ctx, nodes[args[2]].left) = 0 Then Exit Function
            IrEmit(list, OP_MOV_R8_RAX, 0, 0)
            IrEmit(list, OP_JMP, labDone, 0)
            IrEmit(list, OP_LABEL, labSub, 0)
            IrEmit(list, OP_POP_RAX, 0, 0)
            IrEmit(list, OP_MOV_R9_RAX, 0, 0)
            If LowExpr(ctx, nodes[args[2]].left) = 0 Then Exit Function
            IrEmit(list, OP_MOV_ECX, LOW_MF_POPUP, 0)
            IrEmit(list, OP_OR_EAX_ECX, 0, 0)
            IrEmit(list, OP_MOV_R8_RAX, 0, 0)
            IrEmit(list, OP_LABEL, labDone, 0)
        Else
            If nArgs >= 5 Then
                If LowExpr(ctx, nodes[args[4]].left) = 0 Then Exit Function
            Else
                IrEmit(list, OP_XOR_EAX, 0, 0)
            End If
            IrEmit(list, OP_MOV_R9_RAX, 0, 0)
            If LowExpr(ctx, nodes[args[2]].left) = 0 Then Exit Function
            If nArgs = 3 Then
                IrEmit(list, OP_MOV_ECX, LOW_MF_SEPARATOR, 0)
                IrEmit(list, OP_OR_EAX_ECX, 0, 0)
            End If
            IrEmit(list, OP_MOV_R8_RAX, 0, 0)
        End If
        If LowExpr(ctx, nodes[args[1]].left) = 0 Then Exit Function
        IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
        If LowExpr(ctx, nodes[args[0]].left) = 0 Then Exit Function
        IrEmit(list, OP_MOV_RCX_RAX, 0, 0)
        lstrcpy(VarPtr(sApi), "InsertMenuA")
        IrEmitStr(list, OP_CALL_API, IR_DLL_USER32, VarPtr(sApi))
        LowEmitCallFinish(list, stk)
        LowStmtHeavy = 1
    ElseIf k = AST_CALL Then
        LowStmtHeavy = LowExpr(ctx, idx)
    ElseIf k = AST_EXIT Then
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        LowEmitExitEax(ctx)
        LowStmtHeavy = 1
    ElseIf k = AST_EXITDO Then
        If g_doEndLab < 0 Then
            ctx->err = 1
            Exit Function
        End If
        IrEmit(ctx->list, OP_JMP, g_doEndLab, 0)
        LowStmtHeavy = 1
    ElseIf k = AST_EXITWHILE Then
        If g_whileEndLab < 0 Then
            ctx->err = 1
            Exit Function
        End If
        IrEmit(ctx->list, OP_JMP, g_whileEndLab, 0)
        LowStmtHeavy = 1
    ElseIf k = AST_EXITFOR Then
        If g_forEndLab < 0 Then
            ctx->err = 1
            Exit Function
        End If
        IrEmit(ctx->list, OP_JMP, g_forEndLab, 0)
        LowStmtHeavy = 1
    ElseIf k = AST_EXITFUNC Then
        If g_funcEndLab < 0 Then
            ctx->err = 1
            Exit Function
        End If
        IrEmit(ctx->list, OP_JMP, g_funcEndLab, 0)
        LowStmtHeavy = 1
    ElseIf k = AST_END Then
        LowEmitExitImm(ctx, 0)
        LowStmtHeavy = 1
    ElseIf k = AST_PRINT Then
        If LowIsStringExpr(ctx, nodes[idx].left) = 0 Then
            If nodes[idx].left >= 0 Then
                If nodes[nodes[idx].left].kind = AST_VAR Then
                    AstCopyStr(ctx->ast, nodes[idx].left, VarPtr(name))
                    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
                        vTy = -1
                    End If
                Else
                    vTy = -1
                End If
            Else
                vTy = -1
            End If
        Else
            vTy = -1
        End If
        If vTy = TY_BYTE_ARR Then
            If LowExprArg(ctx, nodes[idx].left) = 0 Then Exit Function
        ElseIf vTy = TY_PTR_BYTE Then
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        ElseIf LowIsStringExpr(ctx, nodes[idx].left) = 0 Then
            labStr = LowEnsureRtStr(ctx)
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            LowEmitCall1Rax(ctx->list, 0, 0, VarPtr(name), labStr)
        Else
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        End If
        If PpIsN88Basic() <> 0 Then
            lstrcpy(VarPtr(name), "N88_Print")
            If nodes[idx].num <> 0 Then
                lstrcpy(VarPtr(name), "N88_PrintStay")
            End If
            lab = LowFindFunc(ctx, VarPtr(name))
            If lab < 0 Then
                Print "error: missing '" + MakeStr(VarPtr(name)) + "'"
                ctx->err = 1
                Exit Function
            End If
            IrEmit(ctx->list, OP_SUB_RSP, LowCallStk(1), 0)
            IrEmit(ctx->list, OP_STORE_RSP_RAX, 0, 0)
            LowEmitLoadRegArgs(ctx->list, 1)
            IrEmit(ctx->list, OP_CALL_LAB, lab, 0)
            LowEmitCallFinish(ctx->list, LowCallStk(1))
        Else
            lab = LowEnsureRtPrint(ctx)
            LowEmitCall1Rax(ctx->list, 0, 0, VarPtr(name), lab)
        End If
        LowEmitStrCollectSafepoint(ctx)
        LowStmtHeavy = 1
    ElseIf k = AST_INPUT Then
        ' Input var ― String はそのまま、数値型は十進整数へ変換
        If nodes[idx].left < 0 Then
            ctx->err = 1
            Exit Function
        End If
        If nodes[nodes[idx].left].kind <> AST_VAR Then
            ctx->err = 1
            Exit Function
        End If
        AstCopyStr(ast, nodes[idx].left, VarPtr(name))
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
            ctx->err = 1
            Exit Function
        End If
        If vTy <> TY_STRING And vTy <> TY_LONG And vTy <> TY_BYTE And vTy <> TY_DOUBLE And vTy <> TY_SINGLE Then
            Print "error: Input needs String or numeric variable"
            ctx->err = 1
            Exit Function
        End If
        lab = LowEnsureRtInput(ctx)
        IrEmit(ctx->list, OP_CALL_LAB, lab, 0)
        If vTy <> TY_STRING Then
            If vTy = TY_SINGLE Or vTy = TY_DOUBLE Then
                lab = LowEnsureRtValMilli(ctx)
            Else
                lab = LowEnsureRtVal(ctx)
            End If
            LowEmitCall1Rax(ctx->list, 0, 0, 0, lab)
            If vTy = TY_SINGLE Then
                lab = LowEnsureRtMilliToSingle(ctx)
                LowEmitCall1Rax(ctx->list, 0, 0, 0, lab)
            ElseIf vTy = TY_DOUBLE Then
                lab = LowEnsureRtMilliToDouble(ctx)
                LowEmitCall1Rax(ctx->list, 0, 0, 0, lab)
            End If
        End If
        If vByRef <> 0 Then
            IrEmit(ctx->list, OP_PUSH_RAX, 0, 0)
            LowEmitLoadOff(ctx->list, vOff, vGlob)
            IrEmit(ctx->list, OP_POP_RCX, 0, 0)
            IrEmit(ctx->list, OP_STORE_QWORD_RAX_RCX, 0, 0)
        ElseIf vTy = TY_STRING Then
            LowEmitStoreString(ctx, vOff, vGlob)
        Else
            LowEmitStoreOff(ctx->list, vOff, vGlob)
        End If
        LowEmitStrCollectSafepoint(ctx)
        LowStmtHeavy = 1
    ElseIf k = AST_IF Then
        LowStmtHeavy = LowStmtIf(ctx, idx)
    ElseIf k = AST_DO Then
        labTop = LowNewLab(ctx)
        labEnd = LowNewLab(ctx)
        saveDo = g_doEndLab
        g_doEndLab = labEnd
        doMode = nodes[idx].extra
        cond = nodes[idx].left
        If doMode = DO_WHILE_TOP Then
            IrEmit(ctx->list, OP_LABEL, labTop, 0)
            LowMaybeLoopStrCollect(ctx, cond, nodes[idx].right, -1)
            If LowJumpIfFalse(ctx, cond, labEnd) = 0 Then Exit Function
            If LowStmtList(ctx, nodes[idx].right) = 0 Then Exit Function
            IrEmit(ctx->list, OP_JMP, labTop, 0)
        ElseIf doMode = DO_UNTIL_TOP Then
            IrEmit(ctx->list, OP_LABEL, labTop, 0)
            LowMaybeLoopStrCollect(ctx, cond, nodes[idx].right, -1)
            If LowJumpIfTrue(ctx, cond, labEnd) = 0 Then Exit Function
            If LowStmtList(ctx, nodes[idx].right) = 0 Then Exit Function
            IrEmit(ctx->list, OP_JMP, labTop, 0)
        ElseIf doMode = DO_WHILE_BOTTOM Then
            IrEmit(ctx->list, OP_LABEL, labTop, 0)
            LowMaybeLoopStrCollect(ctx, cond, nodes[idx].right, -1)
            If LowStmtList(ctx, nodes[idx].right) = 0 Then Exit Function
            If LowJumpIfTrue(ctx, cond, labTop) = 0 Then Exit Function
        ElseIf doMode = DO_UNTIL_BOTTOM Then
            IrEmit(ctx->list, OP_LABEL, labTop, 0)
            LowMaybeLoopStrCollect(ctx, cond, nodes[idx].right, -1)
            If LowStmtList(ctx, nodes[idx].right) = 0 Then Exit Function
            If LowJumpIfFalse(ctx, cond, labTop) = 0 Then Exit Function
        Else
            IrEmit(ctx->list, OP_LABEL, labTop, 0)
            LowMaybeLoopStrCollect(ctx, cond, nodes[idx].right, -1)
            If LowStmtList(ctx, nodes[idx].right) = 0 Then Exit Function
            IrEmit(ctx->list, OP_JMP, labTop, 0)
        End If
        IrEmit(ctx->list, OP_LABEL, labEnd, 0)
        g_doEndLab = saveDo
        LowStmtHeavy = 1
    ElseIf k = AST_WHILE Then
        labTop = LowNewLab(ctx)
        labEnd = LowNewLab(ctx)
        saveWhile = g_whileEndLab
        g_whileEndLab = labEnd
        IrEmit(ctx->list, OP_LABEL, labTop, 0)
        LowMaybeLoopStrCollect(ctx, nodes[idx].left, nodes[idx].right, -1)
        If LowJumpIfFalse(ctx, nodes[idx].left, labEnd) = 0 Then Exit Function
        If LowStmtList(ctx, nodes[idx].right) = 0 Then Exit Function
        IrEmit(ctx->list, OP_JMP, labTop, 0)
        IrEmit(ctx->list, OP_LABEL, labEnd, 0)
        g_whileEndLab = saveWhile
        LowStmtHeavy = 1
    ElseIf k = AST_FOR Then
        ' left=var, right=from, extra=to, num=body, strId=step
        If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
        AstCopyStr(ast, nodes[idx].left, VarPtr(name))
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
            ctx->err = 1
            Exit Function
        End If
        LowEmitStoreOff(ctx->list, vOff, vGlob)
        labTop = LowNewLab(ctx)
        labEnd = LowNewLab(ctx)
        labStepNeg = LowNewLab(ctx)
        labStepCont = LowNewLab(ctx)
        saveFor = g_forEndLab
        g_forEndLab = labEnd
        stepIdx = nodes[idx].strId
        useInc = 0
        If stepIdx >= 0 Then
            If nodes[stepIdx].kind = AST_NUM Then
                If nodes[stepIdx].num = 1 Then
                    useInc = 1
                End If
            End If
        End If
        IrEmit(ctx->list, OP_LABEL, labTop, 0)
        LowMaybeLoopStrCollect(ctx, nodes[idx].extra, nodes[idx].num, stepIdx)
        LowEmitLoadOff(ctx->list, vOff, vGlob)
        IrEmit(ctx->list, OP_PUSH_RAX, 0, 0)
        If LowExpr(ctx, nodes[idx].extra) = 0 Then Exit Function
        IrEmit(ctx->list, OP_MOV_EDX_EAX, 0, 0)
        IrEmit(ctx->list, OP_POP_RCX, 0, 0)
        If stepIdx >= 0 Then
            If LowExpr(ctx, stepIdx) = 0 Then Exit Function
            IrEmit(ctx->list, OP_TEST_EAX, 0, 0)
            IrEmit(ctx->list, OP_JL, labStepNeg, 0)
            IrEmit(ctx->list, OP_MOV_EAX_EDX, 0, 0)
            IrEmit(ctx->list, OP_CMP_ECX_EAX, 0, 0)
            IrEmit(ctx->list, OP_JG, labEnd, 0)
            IrEmit(ctx->list, OP_JMP, labStepCont, 0)
            IrEmit(ctx->list, OP_LABEL, labStepNeg, 0)
            IrEmit(ctx->list, OP_MOV_EAX_EDX, 0, 0)
            IrEmit(ctx->list, OP_CMP_ECX_EAX, 0, 0)
            IrEmit(ctx->list, OP_JL, labEnd, 0)
            IrEmit(ctx->list, OP_LABEL, labStepCont, 0)
        Else
            IrEmit(ctx->list, OP_MOV_EAX_EDX, 0, 0)
            IrEmit(ctx->list, OP_CMP_ECX_EAX, 0, 0)
            IrEmit(ctx->list, OP_JG, labEnd, 0)
        End If
        body = nodes[idx].num
        If LowStmtList(ctx, body) = 0 Then Exit Function
        If useInc <> 0 And vGlob = 0 Then
            IrEmit(ctx->list, OP_INC_LOCAL, vOff, 0)
        ElseIf useInc <> 0 Then
            LowEmitLoadOff(ctx->list, vOff, vGlob)
            IrEmit(ctx->list, OP_MOV_ECX, 1, 0)
            IrEmit(ctx->list, OP_ADD_EAX_ECX, 0, 0)
            LowEmitStoreOff(ctx->list, vOff, vGlob)
        ElseIf stepIdx >= 0 Then
            LowEmitLoadOff(ctx->list, vOff, vGlob)
            IrEmit(ctx->list, OP_PUSH_RAX, 0, 0)
            If LowExpr(ctx, stepIdx) = 0 Then Exit Function
            IrEmit(ctx->list, OP_POP_RCX, 0, 0)
            IrEmit(ctx->list, OP_ADD_EAX_ECX, 0, 0)
            LowEmitStoreOff(ctx->list, vOff, vGlob)
        Else
            If vGlob <> 0 Then
                LowEmitLoadOff(ctx->list, vOff, vGlob)
                IrEmit(ctx->list, OP_MOV_ECX, 1, 0)
                IrEmit(ctx->list, OP_ADD_EAX_ECX, 0, 0)
                LowEmitStoreOff(ctx->list, vOff, vGlob)
            Else
                IrEmit(ctx->list, OP_INC_LOCAL, vOff, 0)
            End If
        End If
        IrEmit(ctx->list, OP_JMP, labTop, 0)
        IrEmit(ctx->list, OP_LABEL, labEnd, 0)
        g_forEndLab = saveFor
        LowStmtHeavy = 1
    ElseIf k = AST_WITH Then
        If LowStmtList(ctx, nodes[idx].right) = 0 Then Exit Function
        LowStmtHeavy = 1
    Else
        Print "error: unsupported statement kind " + Str$(k)
        ctx->err = 1
    End If
End Function

Function LowStmtList(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim cur As Long

    LowStmtList = 0
    ast = ctx->ast
    nodes = ast->nodes
    cur = idx
    While cur >= 0
        If LowStmt(ctx, cur) = 0 Then Exit Function
        cur = nodes[cur].nxt
    Wend
    LowStmtList = 1
End Function

' Register one AST_DIM (asGlob=1 -> module global, else local). Returns 0 on error.
Function LowRegisterDimNode(ctx As *LowerCtx, dimIdx As Long, asGlob As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim nm(63) As Byte
    Dim ty As Long
    Dim nbytes As Long
    Dim ti As Long
    Dim bound As Long
    Dim tt As *TypeTable
    Dim tsizes As *Long

    LowRegisterDimNode = 0
    ast = ctx->ast
    nodes = ast->nodes
    tt = ast->types
    AstCopyStr(ast, dimIdx, VarPtr(nm))
    ty = nodes[dimIdx].num
    nbytes = 8
    ti = -1
    If ty = TY_BYTE_ARR Then
        bound = LowBoundVal(ctx, nodes[dimIdx].left)
        If bound < 0 Then Exit Function
        nbytes = bound + 1
    ElseIf ty = TY_LONG_ARR Then
        bound = LowBoundVal(ctx, nodes[dimIdx].left)
        If bound < 0 Then Exit Function
        nbytes = (bound + 1) * 4
    ElseIf ty = TY_DOUBLE_ARR Then
        bound = LowBoundVal(ctx, nodes[dimIdx].left)
        If bound < 0 Then Exit Function
        nbytes = (bound + 1) * 8
    ElseIf ty = TY_SINGLE_ARR Then
        bound = LowBoundVal(ctx, nodes[dimIdx].left)
        If bound < 0 Then Exit Function
        nbytes = (bound + 1) * 4
    ElseIf ty = TY_STRING_ARR Then
        bound = LowBoundVal(ctx, nodes[dimIdx].left)
        If bound < 0 Then Exit Function
        nbytes = (bound + 1) * TyPtrSize()
    ElseIf ty = TY_BYTE Then
        nbytes = 1
    ElseIf ty = TY_DOUBLE Then
        nbytes = 8
    ElseIf ty = TY_SINGLE Then
        nbytes = 4
    ElseIf ty = TY_UDT_ARR Then
        ti = nodes[dimIdx].extra
        If ti < 0 Then
            Print "error: Dim UDT[] missing type '" + MakeStr(VarPtr(nm)) + "'"
            Exit Function
        End If
        bound = LowBoundVal(ctx, nodes[dimIdx].left)
        If bound < 0 Then Exit Function
        tsizes = tt->typeSizes
        nbytes = tsizes[ti]
        If nbytes <= 0 Then
            Print "error: Dim UDT[] size 0 '" + MakeStr(VarPtr(nm)) + "'"
            Exit Function
        End If
        nbytes = nbytes * (bound + 1)
    ElseIf ty = TY_UDT Then
        ti = nodes[dimIdx].extra
        If ti < 0 Then
            Print "error: Dim UDT missing type '" + MakeStr(VarPtr(nm)) + "'"
            Exit Function
        End If
        tsizes = tt->typeSizes
        nbytes = tsizes[ti]
        If nbytes <= 0 Then
            Print "error: Dim UDT size 0 '" + MakeStr(VarPtr(nm)) + "'"
            Exit Function
        End If
    ElseIf ty = TY_PTR_UDT Then
        ti = nodes[dimIdx].extra
        If ti < 0 Then Exit Function
        nbytes = TyPtrSize()
    End If
    If asGlob <> 0 Then
        If LowAddGlob(ctx, VarPtr(nm), ty, nbytes, ti) < 0 Then
            Print "error: register global '" + MakeStr(VarPtr(nm)) + "' ty=" + Str$(ty)
            Exit Function
        End If
    Else
        If LowAddSym(ctx, VarPtr(nm), ty, nbytes, ti, 0) < 0 Then
            Print "error: register local '" + MakeStr(VarPtr(nm)) + "' ty=" + Str$(ty)
            Exit Function
        End If
    End If
    LowRegisterDimNode = 1
End Function

' Walk statement list (and nested If/While/For/Do bodies) to register Dims.
Function LowCollectDimsInList(ctx As *LowerCtx, idx As Long, asGlob As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim cur As Long
    Dim k As Long

    LowCollectDimsInList = 0
    ast = ctx->ast
    nodes = ast->nodes
    cur = idx
    While cur >= 0
        k = nodes[cur].kind
        If k = AST_DIM Then
            If LowRegisterDimNode(ctx, cur, asGlob) = 0 Then Exit Function
        ElseIf k = AST_IF Then
            If LowCollectDimsInList(ctx, nodes[cur].right, asGlob) = 0 Then Exit Function
            If LowCollectDimsInList(ctx, nodes[cur].extra, asGlob) = 0 Then Exit Function
        ElseIf k = AST_WHILE Then
            If LowCollectDimsInList(ctx, nodes[cur].right, asGlob) = 0 Then Exit Function
        ElseIf k = AST_DO Then
            If LowCollectDimsInList(ctx, nodes[cur].right, asGlob) = 0 Then Exit Function
        ElseIf k = AST_FOR Then
            If LowCollectDimsInList(ctx, nodes[cur].num, asGlob) = 0 Then Exit Function
        ElseIf k = AST_WITH Then
            If LowCollectDimsInList(ctx, nodes[cur].right, asGlob) = 0 Then Exit Function
        End If
        cur = nodes[cur].nxt
    Wend
    LowCollectDimsInList = 1
End Function

Function AstToIr(ast As *Ast, list As *IrList, ByRef subsystemOut As Long) As Long
    Dim ctx As LowerCtx
    Dim nodes As *AstNode
    Dim prog As Long
    Dim stmt As Long
    Dim nPrint As Long
    Dim namesBuf As *Byte
    Dim offsBuf As *Long
    Dim typesBuf As *Long
    Dim typeIdxsBuf As *Long
    Dim byRefsBuf As *Long
    Dim gNamesBuf As *Byte
    Dim gOffsBuf As *Long
    Dim gTypesBuf As *Long
    Dim gTypeIdxsBuf As *Long
    Dim funcNamesBuf As *Byte
    Dim funcLabsBuf As *Long
    Dim funcByRefsBuf As *Long
    Dim constNamesBuf As *Byte
    Dim constValsBuf As *Long
    Dim constStrNamesBuf As *Byte
    Dim constStrValsBuf As *Byte
    Dim declNamesBuf As *Byte
    Dim declApiNamesBuf As *Byte
    Dim declDllsBuf As *Byte
    Dim declByRefsBuf As *Byte
    Dim dllKind As Long
    Dim apiBuf(63) As Byte
    Dim libBuf(63) As Byte
    Dim sConst(255) As Byte
    Dim byRefBits As Long
    Dim bit As Long
    Dim isByRef As Long
    Dim retBuf(63) As Byte
    Dim nm(63) As Byte
    Dim labMain As Long
    Dim labFn As Long
    Dim frame As Long
    Dim param As Long
    Dim pi As Long
    Dim j As Long
    Dim offs As *Long
    Dim ty As Long
    Dim bound As Long
    Dim nbytes As Long
    Dim ti As Long
    Dim tt As *TypeTable
    Dim tsizes As *Long
    Dim nFlags As Long
    Dim body As Long

    AstToIr = 0
    subsystemOut = IMAGE_SUBSYSTEM_WINDOWS_CUI
    If ast->root < 0 Then Exit Function
    nodes = ast->nodes
    prog = ast->root
    If nodes[prog].kind <> AST_PROGRAM Then Exit Function
    tt = ast->types

    namesBuf = calloc(BytesN(DYN_INIT, SYM_NAME_LEN))
    offsBuf = calloc(BytesN(DYN_INIT, SizeOf(Long)))
    typesBuf = calloc(BytesN(DYN_INIT, SizeOf(Long)))
    typeIdxsBuf = calloc(BytesN(DYN_INIT, SizeOf(Long)))
    byRefsBuf = calloc(BytesN(DYN_INIT, SizeOf(Long)))
    gNamesBuf = calloc(BytesN(DYN_INIT, SYM_NAME_LEN))
    gOffsBuf = calloc(BytesN(DYN_INIT, SizeOf(Long)))
    gTypesBuf = calloc(BytesN(DYN_INIT, SizeOf(Long)))
    gTypeIdxsBuf = calloc(BytesN(DYN_INIT, SizeOf(Long)))
    funcNamesBuf = calloc(BytesN(DYN_INIT, SYM_NAME_LEN))
    funcLabsBuf = calloc(BytesN(DYN_INIT, SizeOf(Long)))
    funcByRefsBuf = calloc(BytesN(DYN_INIT, SizeOf(Long)))
    constNamesBuf = calloc(BytesN(DYN_INIT, SYM_NAME_LEN))
    constValsBuf = calloc(BytesN(DYN_INIT, SizeOf(Long)))
    constStrNamesBuf = calloc(BytesN(DYN_INIT, SYM_NAME_LEN))
    constStrValsBuf = calloc(BytesN(DYN_INIT, AST_STR_LEN))
    declNamesBuf = calloc(BytesN(DYN_INIT, SYM_NAME_LEN))
    declApiNamesBuf = calloc(BytesN(DYN_INIT, SYM_NAME_LEN))
    declDllsBuf = calloc(BytesN(DYN_INIT, SizeOf(Long)))
    declByRefsBuf = calloc(BytesN(DYN_INIT, SizeOf(Long)))
    g_preciseRoots = calloc(BytesN(GC_MAX_PRECISE, SizeOf(Long)))
    g_fnPreciseRoots = calloc(BytesN(GC_MAX_PRECISE, SizeOf(Long)))
    g_gNbytes = calloc(BytesN(DYN_INIT, SizeOf(Long)))
    g_fb0 = namesBuf
    g_fb1 = offsBuf
    g_fb2 = typesBuf
    g_fb3 = typeIdxsBuf
    g_fb4 = byRefsBuf
    g_fb5 = gNamesBuf
    g_fb6 = gOffsBuf
    g_fb7 = gTypesBuf
    g_fb8 = gTypeIdxsBuf
    g_fb9 = funcNamesBuf
    g_fb10 = funcLabsBuf
    g_fb11 = funcByRefsBuf
    g_fb12 = constNamesBuf
    g_fb13 = constValsBuf
    g_fb14 = constStrNamesBuf
    g_fb15 = constStrValsBuf
    g_fb16 = declNamesBuf
    g_fb17 = declApiNamesBuf
    g_fb18 = declDllsBuf
    g_fb19 = declByRefsBuf
    If namesBuf = NULL Or offsBuf = NULL Or typesBuf = NULL Or typeIdxsBuf = NULL Or byRefsBuf = NULL Or gNamesBuf = NULL Or gOffsBuf = NULL Or gTypesBuf = NULL Or gTypeIdxsBuf = NULL Or funcNamesBuf = NULL Or funcLabsBuf = NULL Or funcByRefsBuf = NULL Or constNamesBuf = NULL Or constValsBuf = NULL Or constStrNamesBuf = NULL Or constStrValsBuf = NULL Or declNamesBuf = NULL Or declApiNamesBuf = NULL Or declDllsBuf = NULL Or declByRefsBuf = NULL Then
        LowFreeAstBufs()
        Exit Function
    End If
    If g_preciseRoots = NULL Or g_fnPreciseRoots = NULL Or g_gNbytes = NULL Then
        LowFreeAstBufs()
        Exit Function
    End If

    g_symCap = DYN_INIT
    g_gCap = DYN_INIT
    g_funcCap = DYN_INIT
    g_constCap = DYN_INIT
    g_constStrCap = DYN_INIT
    g_declCap = DYN_INIT
    g_gNames = gNamesBuf
    g_gOffs = gOffsBuf
    g_gTypes = gTypesBuf
    g_gTypeIdxs = gTypeIdxsBuf
    g_gCount = 0
    g_gSize = 0

    ctx.list = list
    ctx.ast = ast
    ctx.symCount = 0
    ctx.nextLab = 0
    ctx.err = 0
    ctx.names = namesBuf
    ctx.offs = offsBuf
    ctx.types = typesBuf
    ctx.typeIdxs = typeIdxsBuf
    ctx.byRefs = byRefsBuf
    ctx.frameUsed = 0
    ctx.inFunc = 0
    ctx.funcNames = funcNamesBuf
    ctx.funcLabs = funcLabsBuf
    ctx.funcByRefs = funcByRefsBuf
    ctx.funcCount = 0
    ctx.constNames = constNamesBuf
    ctx.constVals = constValsBuf
    ctx.constCount = 0
    ctx.constStrNames = constStrNamesBuf
    ctx.constStrVals = constStrValsBuf
    ctx.constStrCount = 0
    ctx.declNames = declNamesBuf
    ctx.declApiNames = declApiNamesBuf
    ctx.declDlls = declDllsBuf
    ctx.declByRefs = declByRefsBuf
    ctx.declCount = 0
    g_doEndLab = -1
    g_whileEndLab = -1
    g_forEndLab = -1
    g_funcEndLab = -1
    g_rtCatLab = -1
    g_rtMidLab = -1
    g_rtStrLab = -1
    g_rtPrintLab = -1
    g_rtInputLab = -1
    g_rtValLab = -1
    g_rtValMilliLab = -1
    g_rtMilliToSingleLab = -1
    g_rtMilliToDoubleLab = -1
    g_rtMakeStrLab = -1
    g_rtStrCmpLab = -1
    g_rtStrFreeLab = -1
    g_rtStrHeapAllocLab = -1
    g_rtStrGcPreciseLab = -1
    g_rtStrGcConsLab = -1
    g_rtStrCollectLab = -1
    g_gcBaseOff = 0
    g_preciseRootCount = 0
    g_fnPreciseRootCount = 0
    retBuf[0] = 0
    list->globSize = 0

    nPrint = 0
    stmt = nodes[prog].left
    While stmt >= 0
        If nodes[stmt].kind = AST_PRINT Then nPrint = nPrint + 1
        stmt = nodes[stmt].nxt
    Wend
    ' #USEWINDOW による GUI サブシステム切り替えは CompileSource 側で行う

    ' Declare Lib（DLL 種別・エクスポート名・ByRef ビット）を登録
    stmt = nodes[prog].left
    While stmt >= 0
        If nodes[stmt].kind = AST_DECLARE Then
            AstCopyStr(ast, stmt, VarPtr(nm))
            libBuf[0] = 0
            apiBuf[0] = 0
            If nodes[stmt].right >= 0 Then
                AstCopyStr(ast, nodes[stmt].right, VarPtr(libBuf))
            End If
            If nodes[stmt].extra >= 0 Then
                AstCopyStr(ast, nodes[stmt].extra, VarPtr(apiBuf))
            End If
            If apiBuf[0] = 0 Then
                AstCopyStr(ast, stmt, VarPtr(apiBuf))
            End If
            dllKind = LowDllKindFromLib(VarPtr(libBuf))
            If dllKind = 0 Then
                Print "error: unknown Declare Lib '" + MakeStr(VarPtr(libBuf)) + "' for '" + MakeStr(VarPtr(nm)) + "'"
                LowFreeAstBufs()
                Exit Function
            End If
            byRefBits = 0
            bit = 1
            param = nodes[stmt].left
            While param >= 0
                If nodes[param].num <> 0 Then
                    byRefBits = byRefBits + bit
                End If
                bit = bit * 2
                param = nodes[param].nxt
            Wend
            If LowAddDecl(VarPtr(ctx), VarPtr(nm), VarPtr(apiBuf), dllKind, byRefBits) = 0 Then
                LowFreeAstBufs()
                Exit Function
            End If
        End If
        stmt = nodes[stmt].nxt
    Wend

    ' consts（数値 / 文字列）
    stmt = nodes[prog].left
    While stmt >= 0
        If nodes[stmt].kind = AST_CONST Then
            AstCopyStr(ast, stmt, VarPtr(nm))
            If nodes[stmt].extra <> 0 Then
                sConst[0] = 0
                If nodes[stmt].left >= 0 Then
                    AstCopyStr(ast, nodes[stmt].left, VarPtr(sConst))
                End If
                If LowAddStrConst(VarPtr(ctx), VarPtr(nm), VarPtr(sConst)) = 0 Then
                    LowFreeAstBufs()
                    Exit Function
                End If
            Else
                If LowAddConst(VarPtr(ctx), VarPtr(nm), nodes[stmt].num) = 0 Then
                    LowFreeAstBufs()
                    Exit Function
                End If
            End If
        End If
        stmt = nodes[stmt].nxt
    Wend

    ' register functions
    stmt = nodes[prog].left
    While stmt >= 0
        If nodes[stmt].kind = AST_FUNC Then
            labFn = LowNewLab(VarPtr(ctx))
            AstCopyStr(ast, stmt, VarPtr(nm))
            byRefBits = 0
            bit = 1
            param = nodes[stmt].left
            While param >= 0
                If nodes[param].num <> 0 Then
                    byRefBits = byRefBits + bit
                End If
                bit = bit * 2
                param = nodes[param].nxt
            Wend
            If LowAddFunc(VarPtr(ctx), VarPtr(nm), labFn, byRefBits) = 0 Then
                LowFreeAstBufs()
                Exit Function
            End If
            ' extra は Parser が書いた戻り型のまま残す（lab は funcLabs）。
            ' extra を lab で上書きすると TY_STRING/TY_DOUBLE と衝突し、
            ' String 戻りが Double 変換されたり GC ルートから外れる。
        End If
        stmt = nodes[stmt].nxt
    Wend

    ' module-level Dim -> globals (before any function emit; nested Dims in main too)
    If LowCollectDimsInList(VarPtr(ctx), nodes[prog].left, 1) = 0 Then
        LowFreeAstBufs()
        Exit Function
    End If
    LowCollectPreciseGlobRoots()
    g_gcBaseOff = g_gSize
    g_gSize = g_gSize + GC_REGION_SIZE
    list->globSize = g_gSize

    labMain = LowNewLab(VarPtr(ctx))
    IrEmit(list, OP_JMP, labMain, 0)

    ' emit functions
    stmt = nodes[prog].left
    While stmt >= 0
        If nodes[stmt].kind = AST_FUNC Then
            ctx.symCount = 0
            ctx.frameUsed = 0
            ctx.inFunc = 1
            g_doEndLab = -1
            g_whileEndLab = -1
            g_forEndLab = -1
            g_funcEndLab = -1
            LowResetFnPreciseRoots()
            nFlags = nodes[stmt].num
            If nFlags >= 256 Then
                retBuf[0] = 0
            Else
                AstCopyStr(ast, stmt, VarPtr(retBuf))
            End If
            param = nodes[stmt].left
            While param >= 0
                AstCopyStr(ast, param, VarPtr(nm))
                isByRef = nodes[param].num
                ty = nodes[param].extra
                If ty < 0 Then ty = TY_LONG
                ti = nodes[param].right
                nbytes = TyPtrSize()
                If LowAddSym(VarPtr(ctx), VarPtr(nm), ty, nbytes, ti, isByRef) < 0 Then
                    LowFreeAstBufs()
                    Exit Function
                End If
                param = nodes[param].nxt
            Wend
            If retBuf[0] <> 0 Then
                ty = nodes[stmt].extra
                If ty <> TY_STRING Then
                    If ty <> TY_DOUBLE Then
                        ty = TY_LONG
                    End If
                End If
                If LowAddSym(VarPtr(ctx), VarPtr(retBuf), ty, 8, -1, 0) < 0 Then
                    LowFreeAstBufs()
                    Exit Function
                End If
            End If
            ' locals: all Dims in body including nested If/Select/loops
            If LowCollectDimsInList(VarPtr(ctx), nodes[stmt].right, 0) = 0 Then
                LowFreeAstBufs()
                Exit Function
            End If
            frame = LowAlign16(ctx.frameUsed + &H28 + &H2000)
            If frame < &H28 Then frame = &H28
            g_funcEndLab = LowNewLab(VarPtr(ctx))
            AstCopyStr(ast, stmt, VarPtr(nm))
            labFn = LowFindFunc(VarPtr(ctx), VarPtr(nm))
            If labFn < 0 Then
                Print "error: missing function label '" + MakeStr(VarPtr(nm)) + "'"
                LowFreeAstBufs()
                Exit Function
            End If
            IrEmit(list, OP_LABEL, labFn, 0)
            IrEmit(list, OP_ENTER, frame, 0)
            offs = ctx.offs
            pi = 0
            param = nodes[stmt].left
            While param >= 0
                If TyIs32() <> 0 Then
                    offs[pi] = 8 + pi * 4
                ElseIf pi = 0 Then
                    IrEmit(list, OP_STORE_LOCAL_ECX, offs[pi], 0)
                ElseIf pi = 1 Then
                    IrEmit(list, OP_STORE_LOCAL_EDX, offs[pi], 0)
                ElseIf pi = 2 Then
                    IrEmit(list, OP_STORE_LOCAL_R8, offs[pi], 0)
                ElseIf pi = 3 Then
                    IrEmit(list, OP_STORE_LOCAL_R9, offs[pi], 0)
                Else
                    ' stack arg already at [rbp+0x30+(pi-4)*8]
                    ' LowAddSym が付けた precise root を実オフセットへ付け替える
                    LowRetargetFnPreciseRoot(offs[pi], 48 + (pi - 4) * 8)
                    offs[pi] = 48 + (pi - 4) * 8
                End If
                pi = pi + 1
                param = nodes[param].nxt
            Wend
            nFlags = pi
            ' 非引数ローカル（戻り値スロット含む）を 0 初期化。
            ' String を未初期化のまま StoreString→StrFree するとスタックゴミを
            ' HeapFree して AV するため必須。
            j = pi
            While j < ctx.symCount
                IrEmit(list, OP_MOV_EAX_IMM, 0, 0)
                IrEmit(list, OP_STORE_LOCAL, offs[j], 0)
                j = j + 1
            Wend
            If LowStmtList(VarPtr(ctx), nodes[stmt].right) = 0 Or ctx.err <> 0 Then
                AstCopyStr(ast, stmt, VarPtr(nm))
                Print "error: codegen in function '" + MakeStr(VarPtr(nm)) + "'"
                LowFreeAstBufs()
                Exit Function
            End If
            IrEmit(list, OP_LABEL, g_funcEndLab, 0)
            LowEmitLocalClassDtors(VarPtr(ctx))
            ' エピローグでは Collect しない。入れ子の Mid$ / Lower$ 終了時に
            ' 呼び出し元の String が conservative 漏れで解放されるのを防ぐ。
            If retBuf[0] <> 0 Then
                pi = LowFindSym(VarPtr(ctx), VarPtr(retBuf))
                If pi < 0 Then
                    LowFreeAstBufs()
                    Exit Function
                End If
                IrEmit(list, OP_LOAD_LOCAL, offs[pi], 0)
            End If
            LowEmitLeaveN(list, nFlags)
            ctx.inFunc = 0
            g_funcEndLab = -1
            retBuf[0] = 0
        End If
        stmt = nodes[stmt].nxt
    Wend

    ' main: module Dims are globals; frame only needs temps (16-byte aligned)
    ctx.symCount = 0
    ctx.frameUsed = 0
    frame = LowAlign16(&H28)

    IrEmit(list, OP_LABEL, labMain, 0)
    IrEmit(list, OP_ENTER, frame, 0)
    LowEmitGcPreciseRootsInit(VarPtr(ctx))

    stmt = nodes[prog].left
    While stmt >= 0
        If nodes[stmt].kind <> AST_FUNC And nodes[stmt].kind <> AST_CONST And nodes[stmt].kind <> AST_TYPE Then
            If LowStmt(VarPtr(ctx), stmt) = 0 Or ctx.err <> 0 Then
                Print "error: codegen in module stmt kind " + Str$(nodes[stmt].kind)
                LowFreeAstBufs()
                Exit Function
            End If
        End If
        stmt = nodes[stmt].nxt
    Wend

    LowEmitGlobalClassDtors(VarPtr(ctx))
    LowEmitStrCollectSafepoint(VarPtr(ctx))
    LowEmitExitImm(VarPtr(ctx), 0)
    IrEmit(list, OP_LEAVE, 0, 0)

    LowEmitRtCatBody(VarPtr(ctx))
    LowEmitRtMidBody(VarPtr(ctx))
    LowEmitRtStrBody(VarPtr(ctx))
    LowEmitRtPrintBody(VarPtr(ctx))
    LowEmitRtInputBody(VarPtr(ctx))
    LowEmitRtValBody(VarPtr(ctx))
    LowEmitRtValMilliBody(VarPtr(ctx))
    LowEmitRtMilliToSingleBody(VarPtr(ctx))
    LowEmitRtMilliToDoubleBody(VarPtr(ctx))
    LowEmitRtMakeStrBody(VarPtr(ctx))
    LowEmitRtStrCmpBody(VarPtr(ctx))
    LowEmitRtStrFreeBody(VarPtr(ctx))
    LowEmitRtStrHeapAllocBody(VarPtr(ctx))
    LowEmitRtStrGcPreciseBody(VarPtr(ctx))
    LowEmitRtStrGcConsBody(VarPtr(ctx))
    LowEmitRtStrCollectBody(VarPtr(ctx))

    LowFreeAstBufs()
    g_gNames = NULL
    g_gOffs = NULL
    g_gTypes = NULL
    g_gTypeIdxs = NULL
    g_gCount = 0
    g_gSize = 0
    AstToIr = 1
End Function

