    p = MemGrow(ctx->funcLabs, BytesN(g_funcCap, SizeOf(Long)), BytesN(newCap, SizeOf(Long)))
    If p = NULL Then Exit Function
    ctx->funcLabs = p
    g_fb10 = p
    p = MemGrow(ctx->funcByRefs, BytesN(g_funcCap, SizeOf(Long)), BytesN(newCap, SizeOf(Long)))
