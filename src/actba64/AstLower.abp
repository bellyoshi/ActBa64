    newCap = g_funcCap * 2
    If newCap <= g_funcCap Then Exit Function
    p = MemGrow(ctx->funcNames, BytesN(g_funcCap, SYM_NAME_LEN), BytesN(newCap, SYM_NAME_LEN))
    If p = NULL Then Exit Function
    ctx->funcNames = p
    g_freeFuncNames = p
    p = MemGrow(ctx->funcLabs As BytePtr, BytesN(g_funcCap, SizeOf(Long)), BytesN(newCap, SizeOf(Long)))
    If p = NULL Then Exit Function
    ctx->funcLabs = p As *Long
    g_freeFuncLabs = p
    p = MemGrow(ctx->funcByRefs As BytePtr, BytesN(g_funcCap, SizeOf(Long)), BytesN(newCap, SizeOf(Long)))
    If p = NULL Then Exit Function
    ctx->funcByRefs = p As *Long
    g_freeFuncByRefs = p
