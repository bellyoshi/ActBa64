Dim g_gOffs As *Byte
Dim g_gTypes As *Byte
Dim g_gTypeIdxs As *Byte
Dim g_gCount As Long
Dim g_gSize As Long
' Loop/runtime labels (kept out of LowerCtx for stage0 Type field limit)
Dim g_doEndLab As Long
Dim g_doTopLab As Long
Dim g_whileEndLab As Long
Dim g_whileTopLab As Long
Dim g_forEndLab As Long
Dim g_forContLab As Long
Dim g_compileStrict As Long
Dim g_funcEndLab As Long
Dim g_rtCatLab As Long
Dim g_rtMidLab As Long
Dim g_rtStrLab As Long
Dim g_rtPrintLab As Long
Dim g_rtInputLab As Long
Dim g_rtValLab As Long
Dim g_rtValDoubleLab As Long
Dim g_rtMakeStrLab As Long
Dim g_rtStrCmpLab As Long
Dim g_rtStrFreeLab As Long
Dim g_rtStrHeapAllocLab As Long
Dim g_rtStrGcPreciseLab As Long
Dim g_rtStrGcConsLab As Long
Dim g_rtStrCollectLab As Long
Dim g_gcBaseOff As Long
Dim g_preciseRootCount As Long
Dim g_preciseRoots As *Long
Dim g_fnPreciseRootCount As Long
Dim g_fnPreciseRoots As *Long
Dim g_gNbytes As *Long
' AstToIr buffer pointers for error-path free (stage0 max 16 args)
Dim g_fb0 As *Byte
Dim g_fb1 As *Byte
Dim g_fb2 As *Byte
Dim g_fb3 As *Byte
Dim g_fb4 As *Byte
Dim g_fb5 As *Byte
Dim g_fb6 As *Byte
Dim g_fb7 As *Byte
Dim g_fb8 As *Byte
Dim g_fb9 As *Byte
Dim g_fb10 As *Byte
Dim g_fb11 As *Byte
Dim g_fb12 As *Byte
Dim g_fb13 As *Byte
Dim g_fb14 As *Byte
Dim g_fb15 As *Byte
Dim g_fb16 As *Byte
Dim g_fb17 As *Byte
Dim g_fb18 As *Byte
Dim g_fb19 As *Byte
Dim g_symCap As Long
Dim g_gCap As Long
Dim g_funcCap As Long
Dim g_constCap As Long
Dim g_constStrCap As Long
Dim g_declCap As Long

Sub LowerDiagError(ctx As *LowerCtx, idx As Long, msg As String)
    Dim srcLine As Long
    Dim nodes As *AstNode
    Dim ast As *Ast

    srcLine = 1
    If ctx <> NULL Then
        ast = ctx->ast
        If ast <> NULL And idx >= 0 And idx < ast->count Then
            nodes = ast->nodes
            If nodes[idx].srcLine > 0 Then srcLine = nodes[idx].srcLine
        End If
        ctx->err = 1
    End If
    DiagError(srcLine, msg)
End Sub

Sub LowerDiagWarn(ctx As *LowerCtx, idx As Long, msg As String)
    Dim srcLine As Long
    Dim nodes As *AstNode
    Dim ast As *Ast

    srcLine = 1
    If ctx <> NULL Then
        ast = ctx->ast
        If ast <> NULL And idx >= 0 And idx < ast->count Then
            nodes = ast->nodes
            If nodes[idx].srcLine > 0 Then srcLine = nodes[idx].srcLine
        End If
    End If
    DiagWarn(srcLine, msg)
End Sub

Function LowStrictSkipInclude(ctx As *LowerCtx, assignIdx As Long) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim srcLine As Long
    Dim file As String
    Dim localLine As Long
    Dim sp As *Byte
    Dim i As Long
    Dim c0 As Long

    ' Suppress warnings from auto-included Include\default\*.abp
    LowStrictSkipInclude = 0
    ast = ctx->ast
    nodes = ast->nodes
    srcLine = 1
    If assignIdx >= 0 Then
        If nodes[assignIdx].srcLine > 0 Then srcLine = nodes[assignIdx].srcLine
    End If
    file = PpMapSrcName$(g_diagSrc, srcLine, localLine)
    If Len(file) > 0 Then
        sp = StrPtr(file)
        i = 0
        While sp[i] <> 0
            c0 = sp[i]
            If c0 >= 65 And c0 <= 90 Then c0 = c0 + 32
            If c0 = 105 Then
                If sp[i + 1] = 110 Or sp[i + 1] = 78 Then
                    If sp[i + 7] = 92 Or sp[i + 7] = 47 Then
                        If sp[i + 8] = 100 Or sp[i + 8] = 68 Then
                            LowStrictSkipInclude = 1
                            Exit Function
                        End If
                    End If
                End If
            End If
            i = i + 1
        Wend
    End If
End Function

Sub LowStrictWarnMismatch(ctx As *LowerCtx, assignIdx As Long, lhsTy As Long, rhsTy As Long)
    Dim lhsN As String
    Dim rhsN As String
    Dim msg As String
    lhsN = "type"
    rhsN = "type"
    If lhsTy = TY_BYTE Then lhsN = "Byte"
    If lhsTy = TY_LONG Then lhsN = "Long"
    If lhsTy = TY_STRING Then lhsN = "String"
    If lhsTy = TY_SINGLE Then lhsN = "Single"
    If lhsTy = TY_DOUBLE Then lhsN = "Double"
    If lhsTy = TY_PTR_BYTE Then lhsN = "*Byte"
    If lhsTy = TY_PTR_LONG Then lhsN = "*Long"
    If lhsTy = TY_PTR_UDT Then lhsN = "*UDT"
    If rhsTy = TY_BYTE Then rhsN = "Byte"
    If rhsTy = TY_LONG Then rhsN = "Long"
    If rhsTy = TY_STRING Then rhsN = "String"
    If rhsTy = TY_SINGLE Then rhsN = "Single"
    If rhsTy = TY_DOUBLE Then rhsN = "Double"
    If rhsTy = TY_PTR_BYTE Then rhsN = "*Byte"
    If rhsTy = TY_PTR_LONG Then rhsN = "*Long"
    If rhsTy = TY_PTR_UDT Then rhsN = "*UDT"
    msg = "type mismatch assigning " + rhsN + " to " + lhsN + " (#strict)"
    LowerDiagWarn(ctx, assignIdx, msg)
End Sub

Sub LowStrictCheckAssign(ctx As *LowerCtx, assignIdx As Long, lhsTy As Long, lhsTi As Long, rhsIdx As Long)
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim name(63) As Byte
    Dim vOff As Long
    Dim rhsTy As Long
    Dim rhsTi As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim k As Long

    If g_compileStrict = 0 Then Exit Sub
    If ctx = NULL Then Exit Sub
    If rhsIdx < 0 Then Exit Sub
    ast = ctx->ast
    If ast = NULL Then Exit Sub
    nodes = ast->nodes
    k = nodes[rhsIdx].kind
    If k = AST_CAST Then Exit Sub
    If k <> AST_VAR Then Exit Sub
    AstCopyStr(ast, rhsIdx, VarPtr(name))
    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(rhsTy), VarPtr(rhsTi), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then Exit Sub
    If lhsTy = TY_STRING And rhsTy = TY_PTR_BYTE Then Exit Sub
    If lhsTy = TY_PTR_BYTE And rhsTy = TY_STRING Then Exit Sub
    If lhsTy = rhsTy Then
        If lhsTy = TY_PTR_UDT Or lhsTy = TY_UDT Then
            If lhsTi = rhsTi Then Exit Sub
            If lhsTi < 0 Then Exit Sub
            If rhsTi < 0 Then Exit Sub
        Else
            Exit Sub
        End If
    End If
    If LowStrictSkipInclude(ctx, assignIdx) <> 0 Then Exit Sub
    LowStrictWarnMismatch(ctx, assignIdx, lhsTy, rhsTy)
End Sub

Function LowEnsureSymCap(ctx As *LowerCtx) As Long
    Dim newCap As Long
    Dim p As *Byte
    LowEnsureSymCap = 0
    If ctx->symCount < g_symCap Then
        LowEnsureSymCap = 1
        Exit Function
    End If
    newCap = g_symCap * 2
    If newCap <= g_symCap Then Exit Function
    p = MemGrow(ctx->names, BytesN(g_symCap, SYM_NAME_LEN), BytesN(newCap, SYM_NAME_LEN))
    If p = NULL Then Exit Function
    ctx->names = p
    g_fb0 = p
    p = MemGrow(ctx->offs As BytePtr, BytesN(g_symCap, SizeOf(Long)), BytesN(newCap, SizeOf(Long)))
    If p = NULL Then Exit Function
    ctx->offs = p As *Long
    g_fb1 = p
    p = MemGrow(ctx->types As BytePtr, BytesN(g_symCap, SizeOf(Long)), BytesN(newCap, SizeOf(Long)))
    If p = NULL Then Exit Function
    ctx->types = p As *Long
    g_fb2 = p
    p = MemGrow(ctx->typeIdxs As BytePtr, BytesN(g_symCap, SizeOf(Long)), BytesN(newCap, SizeOf(Long)))
    If p = NULL Then Exit Function
    ctx->typeIdxs = p As *Long
    g_fb3 = p
    p = MemGrow(ctx->byRefs As BytePtr, BytesN(g_symCap, SizeOf(Long)), BytesN(newCap, SizeOf(Long)))
    If p = NULL Then Exit Function
    ctx->byRefs = p As *Long
    g_fb4 = p
    g_symCap = newCap
    LowEnsureSymCap = 1
End Function

Function LowEnsureGCap(ctx As *LowerCtx) As Long
    Dim newCap As Long
    Dim p As *Byte
    LowEnsureGCap = 0
    If g_gCount < g_gCap Then
        LowEnsureGCap = 1
