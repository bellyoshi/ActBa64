' ===================================================
'  AstLower - AST -> IR (locals / arith / control)
' ===================================================

Const SYM_NAME_LEN = 64
Const GC_MAX_BLOCKS = 4096
Const GC_MAX_PRECISE = 512
Const GC_HDR_COUNT = 0
Const GC_HDR_BLOCKS = 8
Const GC_HDR_MARKS = 32776
Const GC_HDR_PRECISE_COUNT = 36872
Const GC_HDR_PRECISE_ROOTS = 36880
Const GC_REGION_SIZE = 38928

Const LOW_MF_POPUP = &H10
Const LOW_MF_SEPARATOR = &H800

Type LowerCtx
    list As *IrList
    ast As *Ast
    symCount As Long
    nextLab As Long
    err As Long
    names As *Byte
    offs As *Long
    types As *Long
    typeIdxs As *Long
    byRefs As *Long
    frameUsed As Long
    inFunc As Long
    funcNames As *Byte
    funcLabs As *Long
    funcByRefs As *Long
    funcCount As Long
    constNames As *Byte
    constVals As *Long
    constCount As Long
    constStrNames As *Byte
    constStrVals As *Byte
    constStrCount As Long
    declNames As *Byte
    declApiNames As *Byte
    declDlls As *Long
    declByRefs As *Long
    declCount As Long
End Type

' Module-global symbol table during AstToIr (not LowerCtx fields: stage0 Type limit)
Dim g_gNames As *Byte
Dim g_gOffs As *Byte
Dim g_gTypes As *Byte
Dim g_gTypeIdxs As *Byte
Dim g_gCount As Long
Dim g_gSize As Long
' Loop/runtime labels (kept out of LowerCtx for stage0 Type field limit)
Dim g_doEndLab As Long
Dim g_whileEndLab As Long
Dim g_forEndLab As Long
Dim g_funcEndLab As Long
Dim g_rtCatLab As Long
Dim g_rtMidLab As Long
Dim g_rtStrLab As Long
Dim g_rtPrintLab As Long
Dim g_rtInputLab As Long
Dim g_rtValLab As Long
Dim g_rtValMilliLab As Long
Dim g_rtMilliToSingleLab As Long
Dim g_rtMilliToDoubleLab As Long
Dim g_rtMakeStrLab As Long
Dim g_rtStrCmpLab As Long
Dim g_rtStrFreeLab As Long
Dim g_rtStrHeapAllocLab As Long
Dim g_rtStrGcPreciseLab As Long
Dim g_rtStrGcConsLab As Long
Dim g_rtStrCollectLab As Long
Dim g_gcBaseOff As Long
Dim g_preciseRootCount As Long
Dim g_preciseRoots As *Long
Dim g_fnPreciseRootCount As Long
Dim g_fnPreciseRoots As *Long
Dim g_gNbytes As *Long
' AstToIr buffer pointers for error-path free (stage0 max 16 args)
Dim g_fb0 As *Byte
Dim g_fb1 As *Byte
Dim g_fb2 As *Byte
Dim g_fb3 As *Byte
Dim g_fb4 As *Byte
Dim g_fb5 As *Byte
Dim g_fb6 As *Byte
Dim g_fb7 As *Byte
Dim g_fb8 As *Byte
Dim g_fb9 As *Byte
Dim g_fb10 As *Byte
Dim g_fb11 As *Byte
Dim g_fb12 As *Byte
Dim g_fb13 As *Byte
Dim g_fb14 As *Byte
Dim g_fb15 As *Byte
Dim g_fb16 As *Byte
Dim g_fb17 As *Byte
Dim g_fb18 As *Byte
Dim g_fb19 As *Byte
Dim g_symCap As Long
Dim g_gCap As Long
Dim g_funcCap As Long
Dim g_constCap As Long
Dim g_constStrCap As Long
Dim g_declCap As Long

Function LowEnsureSymCap(ctx As *LowerCtx) As Long
    Dim newCap As Long
    Dim p As *Byte
    LowEnsureSymCap = 0
    If ctx->symCount < g_symCap Then
        LowEnsureSymCap = 1
        Exit Function
    End If
    newCap = g_symCap * 2
    If newCap <= g_symCap Then Exit Function
    p = MemGrow(ctx->names, BytesN(g_symCap, SYM_NAME_LEN), BytesN(newCap, SYM_NAME_LEN))
    If p = NULL Then Exit Function
    ctx->names = p
    g_fb0 = p
    p = MemGrow(ctx->offs, BytesN(g_symCap, SizeOf(Long)), BytesN(newCap, SizeOf(Long)))
    If p = NULL Then Exit Function
    ctx->offs = p
    g_fb1 = p
    p = MemGrow(ctx->types, BytesN(g_symCap, SizeOf(Long)), BytesN(newCap, SizeOf(Long)))
    If p = NULL Then Exit Function
    ctx->types = p
    g_fb2 = p
    p = MemGrow(ctx->typeIdxs, BytesN(g_symCap, SizeOf(Long)), BytesN(newCap, SizeOf(Long)))
    If p = NULL Then Exit Function
    ctx->typeIdxs = p
    g_fb3 = p
    p = MemGrow(ctx->byRefs, BytesN(g_symCap, SizeOf(Long)), BytesN(newCap, SizeOf(Long)))
    If p = NULL Then Exit Function
    ctx->byRefs = p
    g_fb4 = p
    g_symCap = newCap
    LowEnsureSymCap = 1
End Function

Function LowEnsureGCap(ctx As *LowerCtx) As Long
    Dim newCap As Long
    Dim p As *Byte
    LowEnsureGCap = 0
    If g_gCount < g_gCap Then
        LowEnsureGCap = 1
        Exit Function
    End If
    newCap = g_gCap * 2
    If newCap <= g_gCap Then Exit Function
    p = MemGrow(g_gNames, BytesN(g_gCap, SYM_NAME_LEN), BytesN(newCap, SYM_NAME_LEN))
    If p = NULL Then Exit Function
    g_gNames = p
    g_fb5 = p
    p = MemGrow(g_gOffs, BytesN(g_gCap, SizeOf(Long)), BytesN(newCap, SizeOf(Long)))
    If p = NULL Then Exit Function
    g_gOffs = p
    g_fb6 = p
    p = MemGrow(g_gTypes, BytesN(g_gCap, SizeOf(Long)), BytesN(newCap, SizeOf(Long)))
    If p = NULL Then Exit Function
    g_gTypes = p
    g_fb7 = p
    p = MemGrow(g_gTypeIdxs, BytesN(g_gCap, SizeOf(Long)), BytesN(newCap, SizeOf(Long)))
    If p = NULL Then Exit Function
    g_gTypeIdxs = p
    g_fb8 = p
    p = MemGrow(g_gNbytes, BytesN(g_gCap, SizeOf(Long)), BytesN(newCap, SizeOf(Long)))
    If p = NULL Then Exit Function
    g_gNbytes = p
    g_gCap = newCap
    LowEnsureGCap = 1
End Function

