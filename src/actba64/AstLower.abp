' ===================================================
'  AstLower - AST -> IR (locals / arith / control)
' ===================================================

Const SYM_MAX = 512
' Declare 名は長くなりうる（EditorBuild_SetHandleInformation = 32 文字）
Const SYM_NAME_LEN = 64

Const LOW_MF_POPUP = &H10
Const LOW_MF_SEPARATOR = &H800

Type LowerCtx
    list As *IrList
    ast As *Ast
    symCount As Long
    nextLab As Long
    err As Long
    names As *Byte
    offs As *Long
    types As *Long
    typeIdxs As *Long
    byRefs As *Long
    frameUsed As Long
    inFunc As Long
    funcNames As *Byte
    funcLabs As *Long
    funcByRefs As *Long
    funcCount As Long
    constNames As *Byte
    constVals As *Long
    constCount As Long
    constStrNames As *Byte
    constStrVals As *Byte
    constStrCount As Long
    declNames As *Byte
    declApiNames As *Byte
    declDlls As *Long
    declByRefs As *Long
    declCount As Long
End Type

' Module-global symbol table during AstToIr (not LowerCtx fields: stage0 Type limit)
Dim g_gNames As *Byte
Dim g_gOffs As *Byte
Dim g_gTypes As *Byte
Dim g_gTypeIdxs As *Byte
Dim g_gCount As Long
Dim g_gSize As Long
' Loop/runtime labels (kept out of LowerCtx for stage0 Type field limit)
Dim g_doEndLab As Long
Dim g_whileEndLab As Long
Dim g_forEndLab As Long
Dim g_funcEndLab As Long
Dim g_rtCatLab As Long
Dim g_rtMidLab As Long
Dim g_rtStrLab As Long
Dim g_rtPrintLab As Long
Dim g_rtInputLab As Long
' AstToIr buffer pointers for error-path free (stage0 max 16 args)
Dim g_fb0 As *Byte
Dim g_fb1 As *Byte
Dim g_fb2 As *Byte
Dim g_fb3 As *Byte
Dim g_fb4 As *Byte
Dim g_fb5 As *Byte
Dim g_fb6 As *Byte
Dim g_fb7 As *Byte
Dim g_fb8 As *Byte
Dim g_fb9 As *Byte
Dim g_fb10 As *Byte
Dim g_fb11 As *Byte
Dim g_fb12 As *Byte
Dim g_fb13 As *Byte
Dim g_fb14 As *Byte
Dim g_fb15 As *Byte
Dim g_fb16 As *Byte
Dim g_fb17 As *Byte
Dim g_fb18 As *Byte
Dim g_fb19 As *Byte
Function LowToLower(c As Long) As Long
    If c >= 65 And c <= 90 Then
        LowToLower = c + 32
    Else
        LowToLower = c
    End If
End Function

Function LowNameEq(a As *Byte, b As *Byte) As Long
    Dim i As Long
    LowNameEq = 0
    i = 0
    Do
        If LowToLower(a[i]) <> LowToLower(b[i]) Then Exit Function
        If a[i] = 0 Then
            LowNameEq = 1
            Exit Function
        End If
        i = i + 1
    Loop
End Function

Function LowFindSym(ctx As *LowerCtx, name As *Byte) As Long
    Dim i As Long
    Dim names As *Byte
    Dim off As Long
    LowFindSym = -1
    names = ctx.names
    i = 0
    While i < ctx.symCount
        off = i * SYM_NAME_LEN
        If LowNameEq(VarPtr(names[off]), name) <> 0 Then
            LowFindSym = i
            Exit Function
        End If
        i = i + 1
    Wend
End Function

Function LowAddSym(ctx As *LowerCtx, name As *Byte, ty As Long, nbytes As Long, typeIdx As Long, isByRef As Long) As Long
    Dim i As Long
    Dim names As *Byte
    Dim offs As *Long
    Dim types As *Long
    Dim typeIdxs As *Long
    Dim byRefs As *Long
    Dim j As Long
    Dim off As Long
    Dim sz As Long

    LowAddSym = -1
    i = LowFindSym(ctx, name)
    If i >= 0 Then
        LowAddSym = i
        Exit Function
    End If
    If ctx.symCount >= SYM_MAX Then
        Print "error: too many locals/syms (max " + Str$(SYM_MAX) + ")"
        ctx.err = 1
        Exit Function
    End If
    i = ctx.symCount
    names = ctx.names
    offs = ctx.offs
    types = ctx.types
    typeIdxs = ctx.typeIdxs
    byRefs = ctx.byRefs
    off = i * SYM_NAME_LEN
    j = 0
    While name[j] <> 0 And j < SYM_NAME_LEN - 1
        names[off + j] = name[j]
        j = j + 1
    Wend
    names[off + j] = 0
    sz = nbytes
    If sz < 8 Then sz = 8
    sz = (sz + 7) And (0 - 8)
    ctx.frameUsed = ctx.frameUsed + sz
    offs[i] = 0 - ctx.frameUsed
    types[i] = ty
    typeIdxs[i] = typeIdx
    byRefs[i] = isByRef
    ctx.symCount = i + 1
    LowAddSym = i
End Function

Function LowFindGlob(ctx As *LowerCtx, name As *Byte) As Long
    Dim i As Long
    Dim names As *Byte
    Dim off As Long
    LowFindGlob = -1
    names = g_gNames
    If names = NULL Then Exit Function
    i = 0
    While i < g_gCount
        off = i * SYM_NAME_LEN
        If LowNameEq(VarPtr(names[off]), name) <> 0 Then
            LowFindGlob = i
            Exit Function
        End If
        i = i + 1
    Wend
End Function

Function LowAddGlob(ctx As *LowerCtx, name As *Byte, ty As Long, nbytes As Long, typeIdx As Long) As Long
    Dim i As Long
    Dim names As *Byte
    Dim offs As *Long
    Dim types As *Long
    Dim typeIdxs As *Long
    Dim j As Long
    Dim off As Long
    Dim sz As Long

    LowAddGlob = -1
    i = LowFindGlob(ctx, name)
    If i >= 0 Then
        LowAddGlob = i
        Exit Function
    End If
    If g_gCount >= SYM_MAX Then
        Print "error: too many globals (max " + Str$(SYM_MAX) + ")"
        ctx.err = 1
        Exit Function
    End If
    i = g_gCount
    names = g_gNames
    offs = g_gOffs
    types = g_gTypes
    typeIdxs = g_gTypeIdxs
    off = i * SYM_NAME_LEN
    j = 0
    While name[j] <> 0 And j < SYM_NAME_LEN - 1
        names[off + j] = name[j]
        j = j + 1
    Wend
    names[off + j] = 0
    sz = nbytes
    If sz < 8 Then sz = 8
    sz = (sz + 7) And (0 - 8)
    offs[i] = g_gSize
    g_gSize = g_gSize + sz
    types[i] = ty
    typeIdxs[i] = typeIdx
    g_gCount = i + 1
    LowAddGlob = i
End Function

' Resolve name: locals first, then module globals.
' Out params as *Byte (self-host parser rejects *Long params); cast to *Long locally.
Function LowLookupVar(ctx As *LowerCtx, name As *Byte, oOffB As *Byte, oTyB As *Byte, oTiB As *Byte, oBrB As *Byte, oGlB As *Byte) As Long
    Dim si As Long
    Dim offs As *Long
    Dim types As *Long
    Dim typeIdxs As *Long
    Dim byRefs As *Long
    Dim oOff As *Long
    Dim oTy As *Long
    Dim oTi As *Long
    Dim oBr As *Long
    Dim oGl As *Long

    oOff = oOffB
    oTy = oTyB
    oTi = oTiB
    oBr = oBrB
    oGl = oGlB
    LowLookupVar = 0
    oGl[0] = 0
    oBr[0] = 0
    oOff[0] = 0
    oTy[0] = 0
    oTi[0] = -1
    si = LowFindSym(ctx, name)
    If si >= 0 Then
        offs = ctx.offs
        types = ctx.types
        typeIdxs = ctx.typeIdxs
        byRefs = ctx.byRefs
        oOff[0] = offs[si]
        oTy[0] = types[si]
        oTi[0] = typeIdxs[si]
        oBr[0] = byRefs[si]
        LowLookupVar = 1
        Exit Function
    End If
    si = LowFindGlob(ctx, name)
    If si >= 0 Then
        offs = g_gOffs
        types = g_gTypes
        typeIdxs = g_gTypeIdxs
        oOff[0] = offs[si]
        oTy[0] = types[si]
        oTi[0] = typeIdxs[si]
        oBr[0] = 0
        oGl[0] = 1
        LowLookupVar = 1
    End If
End Function

Sub LowEmitLeaOff(list As *IrList, off As Long, isGlob As Long)
    If isGlob <> 0 Then
        IrEmit(list, OP_LEA_RAX_GLOB, off, 0)
    Else
        IrEmit(list, OP_LEA_LOCAL, off, 0)
    End If
End Sub

Sub LowEmitLoadOff(list As *IrList, off As Long, isGlob As Long)
    If isGlob <> 0 Then
        IrEmit(list, OP_LEA_RAX_GLOB, off, 0)
        IrEmit(list, OP_LOAD_QWORD_RAX, 0, 0)
    Else
        IrEmit(list, OP_LOAD_LOCAL, off, 0)
    End If
End Sub

Sub LowEmitStoreOff(list As *IrList, off As Long, isGlob As Long)
    If isGlob <> 0 Then
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        IrEmit(list, OP_LEA_RAX_GLOB, off, 0)
        IrEmit(list, OP_POP_RCX, 0, 0)
        IrEmit(list, OP_STORE_QWORD_RAX_RCX, 0, 0)
    Else
        IrEmit(list, OP_STORE_LOCAL, off, 0)
    End If
End Sub

Function LowFindConst(ctx As *LowerCtx, name As *Byte) As Long
    Dim i As Long
    Dim names As *Byte
    Dim off As Long
    LowFindConst = -1
    names = ctx.constNames
    i = 0
    While i < ctx.constCount
        off = i * SYM_NAME_LEN
        If LowNameEq(VarPtr(names[off]), name) <> 0 Then
            LowFindConst = i
            Exit Function
        End If
        i = i + 1
    Wend
End Function

Function LowAddConst(ctx As *LowerCtx, name As *Byte, v As Long) As Long
    Dim i As Long
    Dim names As *Byte
    Dim vals As *Long
    Dim j As Long
    Dim off As Long

    LowAddConst = 0
    If LowFindConst(ctx, name) >= 0 Then
        LowAddConst = 1
        Exit Function
    End If
    If ctx.constCount >= SYM_MAX Then
        Print "error: too many consts (max " + Str$(SYM_MAX) + ")"
        ctx.err = 1
        Exit Function
    End If
    i = ctx.constCount
    names = ctx.constNames
    vals = ctx.constVals
    off = i * SYM_NAME_LEN
    j = 0
    While name[j] <> 0 And j < SYM_NAME_LEN - 1
        names[off + j] = name[j]
        j = j + 1
    Wend
    names[off + j] = 0
    vals[i] = v
    ctx.constCount = i + 1
    LowAddConst = 1
End Function

Function LowFindStrConst(ctx As *LowerCtx, name As *Byte) As Long
    Dim i As Long
    Dim names As *Byte
    Dim off As Long
    LowFindStrConst = -1
    names = ctx.constStrNames
    If names = NULL Then Exit Function
    i = 0
    While i < ctx.constStrCount
        off = i * SYM_NAME_LEN
        If LowNameEq(VarPtr(names[off]), name) <> 0 Then
            LowFindStrConst = i
            Exit Function
        End If
        i = i + 1
    Wend
End Function

Function LowAddStrConst(ctx As *LowerCtx, name As *Byte, s As *Byte) As Long
    Dim i As Long
    Dim names As *Byte
    Dim vals As *Byte
    Dim j As Long
    Dim off As Long

    LowAddStrConst = 0
    If LowFindStrConst(ctx, name) >= 0 Then
        LowAddStrConst = 1
        Exit Function
    End If
    If ctx.constStrCount >= SYM_MAX Then
        Print "error: too many string consts (max " + Str$(SYM_MAX) + ")"
        ctx.err = 1
        Exit Function
    End If
    If ctx.constStrNames = NULL Or ctx.constStrVals = NULL Then
        ctx.err = 1
        Exit Function
    End If
    i = ctx.constStrCount
    names = ctx.constStrNames
    vals = ctx.constStrVals
    off = i * SYM_NAME_LEN
    j = 0
    While name[j] <> 0 And j < SYM_NAME_LEN - 1
        names[off + j] = name[j]
        j = j + 1
    Wend
    names[off + j] = 0
    off = i * AST_STR_LEN
    j = 0
    While s[j] <> 0 And j < AST_STR_LEN - 1
        vals[off + j] = s[j]
        j = j + 1
    Wend
    vals[off + j] = 0
    ctx.constStrCount = i + 1
    LowAddStrConst = 1
End Function

Function LowBoundVal(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim ci As Long
    Dim vals As *Long
    Dim lv As Long
    Dim rv As Long
    Dim op As Long
    Dim leftIdx As Long
    Dim rightIdx As Long

    LowBoundVal = -1
    If idx < 0 Then Exit Function
    ast = ctx.ast
    nodes = ast.nodes
    If nodes[idx].kind = AST_NUM Then
        LowBoundVal = nodes[idx].num
    ElseIf nodes[idx].kind = AST_VAR Then
        AstCopyStr(ast, idx, VarPtr(name))
        ci = LowFindConst(ctx, VarPtr(name))
        If ci < 0 Then Exit Function
        vals = ctx.constVals
        LowBoundVal = vals[ci]
    ElseIf nodes[idx].kind = AST_BINOP Then
        op = nodes[idx].num
        leftIdx = nodes[idx].left
        rightIdx = nodes[idx].right
        If leftIdx < 0 Or rightIdx < 0 Then Exit Function
        lv = LowBoundVal(ctx, leftIdx)
        If lv < 0 Then Exit Function
        rv = LowBoundVal(ctx, rightIdx)
        If rv < 0 Then Exit Function
        If op = BOP_ADD Then
            LowBoundVal = lv + rv
        ElseIf op = BOP_SUB Then
            LowBoundVal = lv - rv
        ElseIf op = BOP_MUL Then
            LowBoundVal = lv * rv
        ElseIf op = BOP_OR Then
            LowBoundVal = lv Or rv
        ElseIf op = BOP_AND Then
            LowBoundVal = lv And rv
        ElseIf op = BOP_IDIV Then
            If rv <> 0 Then
                LowBoundVal = lv \ rv
            End If
        End If
    End If
End Function

Function LowNewLab(ctx As *LowerCtx) As Long
    Dim id As Long
    id = ctx.nextLab
    ctx.nextLab = id + 1
    LowNewLab = id
End Function

' 既知 kernel32 API 名へ正規化（小文字比較）。成功時 apiOut に正式名を書く
Function LowMapKernelApi(name As *Byte, apiOut As *Byte) As Long
    Dim k(31) As Byte

    LowMapKernelApi = 0
    lstrcpy(VarPtr(k), "createfile")
    If LowNameEq(name, VarPtr(k)) <> 0 Then
        lstrcpy(apiOut, "CreateFileA")
        LowMapKernelApi = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "createfilea")
    If LowNameEq(name, VarPtr(k)) <> 0 Then
        lstrcpy(apiOut, "CreateFileA")
        LowMapKernelApi = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "closehandle")
    If LowNameEq(name, VarPtr(k)) <> 0 Then
        lstrcpy(apiOut, "CloseHandle")
        LowMapKernelApi = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "getfilesize")
    If LowNameEq(name, VarPtr(k)) <> 0 Then
        lstrcpy(apiOut, "GetFileSize")
        LowMapKernelApi = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "readfile")
    If LowNameEq(name, VarPtr(k)) <> 0 Then
        lstrcpy(apiOut, "ReadFile")
        LowMapKernelApi = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "writefile")
    If LowNameEq(name, VarPtr(k)) <> 0 Then
        lstrcpy(apiOut, "WriteFile")
        LowMapKernelApi = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "getfileattributes")
    If LowNameEq(name, VarPtr(k)) <> 0 Then
        lstrcpy(apiOut, "GetFileAttributesA")
        LowMapKernelApi = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "getfileattributesa")
    If LowNameEq(name, VarPtr(k)) <> 0 Then
        lstrcpy(apiOut, "GetFileAttributesA")
        LowMapKernelApi = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "getcommandline")
    If LowNameEq(name, VarPtr(k)) <> 0 Then
        lstrcpy(apiOut, "GetCommandLineA")
        LowMapKernelApi = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "getcommandlinea")
    If LowNameEq(name, VarPtr(k)) <> 0 Then
        lstrcpy(apiOut, "GetCommandLineA")
        LowMapKernelApi = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "lstrlen")
    If LowNameEq(name, VarPtr(k)) <> 0 Then
        lstrcpy(apiOut, "lstrlenA")
        LowMapKernelApi = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "lstrlena")
    If LowNameEq(name, VarPtr(k)) <> 0 Then
        lstrcpy(apiOut, "lstrlenA")
        LowMapKernelApi = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "lstrcpy")
    If LowNameEq(name, VarPtr(k)) <> 0 Then
        lstrcpy(apiOut, "lstrcpyA")
        LowMapKernelApi = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "lstrcpya")
    If LowNameEq(name, VarPtr(k)) <> 0 Then
        lstrcpy(apiOut, "lstrcpyA")
        LowMapKernelApi = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "lstrcat")
    If LowNameEq(name, VarPtr(k)) <> 0 Then
        lstrcpy(apiOut, "lstrcatA")
        LowMapKernelApi = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "lstrcata")
    If LowNameEq(name, VarPtr(k)) <> 0 Then
        lstrcpy(apiOut, "lstrcatA")
        LowMapKernelApi = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "getprocessheap")
    If LowNameEq(name, VarPtr(k)) <> 0 Then
        lstrcpy(apiOut, "GetProcessHeap")
        LowMapKernelApi = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "heapalloc")
    If LowNameEq(name, VarPtr(k)) <> 0 Then
        lstrcpy(apiOut, "HeapAlloc")
        LowMapKernelApi = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "heapfree")
    If LowNameEq(name, VarPtr(k)) <> 0 Then
        lstrcpy(apiOut, "HeapFree")
        LowMapKernelApi = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "getstdhandle")
    If LowNameEq(name, VarPtr(k)) <> 0 Then
        lstrcpy(apiOut, "GetStdHandle")
        LowMapKernelApi = 1
        Exit Function
    End If
End Function

Function LowFindFunc(ctx As *LowerCtx, name As *Byte) As Long
    Dim i As Long
    Dim names As *Byte
    Dim labs As *Long
    Dim off As Long
    LowFindFunc = -1
    names = ctx.funcNames
    labs = ctx.funcLabs
    i = 0
    While i < ctx.funcCount
        off = i * SYM_NAME_LEN
        If LowNameEq(VarPtr(names[off]), name) <> 0 Then
            LowFindFunc = labs[i]
            Exit Function
        End If
        i = i + 1
    Wend
End Function

Function LowFindFuncByRefs(ctx As *LowerCtx, name As *Byte) As Long
    Dim i As Long
    Dim names As *Byte
    Dim bys As *Long
    Dim off As Long
    LowFindFuncByRefs = 0
    names = ctx.funcNames
    bys = ctx.funcByRefs
    i = 0
    While i < ctx.funcCount
        off = i * SYM_NAME_LEN
        If LowNameEq(VarPtr(names[off]), name) <> 0 Then
            LowFindFuncByRefs = bys[i]
            Exit Function
        End If
        i = i + 1
    Wend
End Function

Function LowAddFunc(ctx As *LowerCtx, name As *Byte, lab As Long, byRefBits As Long) As Long
    Dim i As Long
    Dim names As *Byte
    Dim labs As *Long
    Dim bys As *Long
    Dim j As Long
    Dim off As Long

    LowAddFunc = 0
    If ctx.funcCount >= SYM_MAX Then
        Print "error: too many functions (max " + Str$(SYM_MAX) + ")"
        ctx.err = 1
        Exit Function
    End If
    i = ctx.funcCount
    names = ctx.funcNames
    labs = ctx.funcLabs
    bys = ctx.funcByRefs
    off = i * SYM_NAME_LEN
    j = 0
    While name[j] <> 0 And j < SYM_NAME_LEN - 1
        names[off + j] = name[j]
        j = j + 1
    Wend
    names[off + j] = 0
    labs[i] = lab
    bys[i] = byRefBits
    ctx.funcCount = i + 1
    LowAddFunc = 1
End Function

' ---- Declare Lib テーブル ----

Function LowFindDecl(ctx As *LowerCtx, name As *Byte) As Long
    Dim i As Long
    Dim names As *Byte
    Dim off As Long
    LowFindDecl = -1
    names = ctx.declNames
    i = 0
    While i < ctx.declCount
        off = i * SYM_NAME_LEN
        If LowNameEq(VarPtr(names[off]), name) <> 0 Then
            LowFindDecl = i
            Exit Function
        End If
        i = i + 1
    Wend
End Function

Function LowAddDecl(ctx As *LowerCtx, name As *Byte, api As *Byte, dllKind As Long, byRefBits As Long) As Long
    Dim i As Long
    Dim names As *Byte
    Dim apis As *Byte
    Dim dlls As *Long
    Dim bys As *Long
    Dim j As Long
    Dim off As Long

    LowAddDecl = 0
    If ctx.declCount >= SYM_MAX Then
        Print "error: too many Declare entries (max " + Str$(SYM_MAX) + ")"
        ctx.err = 1
        Exit Function
    End If
    i = ctx.declCount
    names = ctx.declNames
    apis = ctx.declApiNames
    dlls = ctx.declDlls
    bys = ctx.declByRefs
    off = i * SYM_NAME_LEN
    j = 0
    While name[j] <> 0 And j < SYM_NAME_LEN - 1
        names[off + j] = name[j]
        j = j + 1
    Wend
    names[off + j] = 0
    j = 0
    While api[j] <> 0 And j < SYM_NAME_LEN - 1
        apis[off + j] = api[j]
        j = j + 1
    Wend
    apis[off + j] = 0
    dlls[i] = dllKind
    bys[i] = byRefBits
    ctx.declCount = i + 1
    LowAddDecl = 1
End Function

Sub LowDeclApiName(ctx As *LowerCtx, di As Long, dst As *Byte)
    Dim apis As *Byte
    Dim off As Long
    Dim j As Long
    apis = ctx.declApiNames
    off = di * SYM_NAME_LEN
    j = 0
    While apis[off + j] <> 0 And j < SYM_NAME_LEN - 1
        dst[j] = apis[off + j]
        j = j + 1
    Wend
    dst[j] = 0
End Sub

' actba64 のセルフホスト構文は *Long 仮引数を扱えないため *Byte で受ける
Sub LowFreeDecl4(a As *Byte, b As *Byte, c As *Byte, d As *Byte)
    If a <> NULL Then free(a)
    If b <> NULL Then free(b)
    If c <> NULL Then free(c)
    If d <> NULL Then free(d)
End Sub

Sub LowFree1(p As *Byte)
    If p <> NULL Then free(p)
End Sub

' AstToIr エラー時のバッファ一括解放（行数削減; 引数は g_fb*）
Sub LowFreeAstBufs()
    LowFree1(g_fb0)
    LowFree1(g_fb1)
    LowFree1(g_fb2)
    LowFree1(g_fb3)
    LowFree1(g_fb4)
    LowFree1(g_fb5)
    LowFree1(g_fb6)
    LowFree1(g_fb7)
    LowFree1(g_fb8)
    LowFree1(g_fb9)
    LowFree1(g_fb10)
    LowFree1(g_fb11)
    LowFree1(g_fb12)
    LowFree1(g_fb13)
    LowFree1(g_fb14)
    LowFree1(g_fb15)
    LowFreeDecl4(g_fb16, g_fb17, g_fb18, g_fb19)
    g_fb0 = NULL
    g_fb1 = NULL
    g_fb2 = NULL
    g_fb3 = NULL
    g_fb4 = NULL
    g_fb5 = NULL
    g_fb6 = NULL
    g_fb7 = NULL
    g_fb8 = NULL
    g_fb9 = NULL
    g_fb10 = NULL
    g_fb11 = NULL
    g_fb12 = NULL
    g_fb13 = NULL
    g_fb14 = NULL
    g_fb15 = NULL
    g_fb16 = NULL
    g_fb17 = NULL
    g_fb18 = NULL
    g_fb19 = NULL
    g_gNames = NULL
    g_gOffs = NULL
    g_gTypes = NULL
    g_gTypeIdxs = NULL
End Sub

Function LowAlign16(n As Long) As Long
    LowAlign16 = (n + 15) And (0 - 16)
End Function

Function LowStrLen(s As *Byte) As Long
    Dim n As Long
    n = 0
    While s[n] <> 0
        n = n + 1
    Wend
    LowStrLen = n
End Function

Sub LowStrCat(dst As *Byte, a As *Byte, b As *Byte, maxLen As Long)
    Dim i As Long
    Dim j As Long
    i = 0
    While a[i] <> 0 And i < maxLen - 1
        dst[i] = a[i]
        i = i + 1
    Wend
    j = 0
    While b[j] <> 0 And i < maxLen - 1
        dst[i] = b[j]
        i = i + 1
        j = j + 1
    Wend
    dst[i] = 0
End Sub

Sub LowStrLeft(dst As *Byte, s As *Byte, n As Long, maxLen As Long)
    Dim i As Long
    Dim ln As Long
    ln = LowStrLen(s)
    If n < 0 Then n = 0
    If n > ln Then n = ln
    If n > maxLen - 1 Then n = maxLen - 1
    i = 0
    While i < n
        dst[i] = s[i]
        i = i + 1
    Wend
    dst[i] = 0
End Sub

Sub LowStrMid(dst As *Byte, s As *Byte, start1 As Long, count As Long, maxLen As Long)
    Dim ln As Long
    Dim idx As Long
    Dim i As Long
    Dim take As Long
    ln = LowStrLen(s)
    If start1 < 1 Then start1 = 1
    idx = start1 - 1
    If idx > ln Then idx = ln
    If count < 0 Then
        take = ln - idx
    Else
        take = count
    End If
    If idx + take > ln Then take = ln - idx
    If take < 0 Then take = 0
    If take > maxLen - 1 Then take = maxLen - 1
    i = 0
    While i < take
        dst[i] = s[idx + i]
        i = i + 1
    Wend
    dst[i] = 0
End Sub

Sub LowIntToStr(dst As *Byte, v As Long, maxLen As Long)
    Dim neg As Long
    Dim n As Long
    Dim tmp(31) As Byte
    Dim i As Long
    Dim j As Long
    Dim d As Long

    If maxLen < 2 Then
        dst[0] = 0
        Exit Sub
    End If
    neg = 0
    n = v
    If n < 0 Then
        neg = 1
        n = 0 - n
    End If
    If n = 0 Then
        dst[0] = 48
        dst[1] = 0
        Exit Sub
    End If
    i = 0
    While n > 0
        d = n
        While d >= 10
            d = d - 10
        Wend
        tmp[i] = d + 48
        i = i + 1
        ' n = n / 10
        j = 0
        While n >= 10
            n = n - 10
            j = j + 1
        Wend
        n = j
    Wend
    j = 0
    If neg <> 0 Then
        If j < maxLen - 1 Then
            dst[j] = 45
            j = j + 1
        End If
    End If
    While i > 0
        i = i - 1
        If j < maxLen - 1 Then
            dst[j] = tmp[i]
            j = j + 1
        End If
    Wend
    dst[j] = 0
End Sub

' Fold const string expression into dst. Returns 1 on success.
Function LowConstStr(ast As *Ast, idx As Long, dst As *Byte) As Long
    Dim nodes As *AstNode
    Dim a(63) As Byte
    Dim b(63) As Byte
    Dim n As Long
    Dim start1 As Long
    Dim count As Long
    Dim bi As Long
    Dim rIdx As Long
    Dim eIdx As Long

    LowConstStr = 0
    If idx < 0 Then Exit Function
    nodes = ast.nodes
    If nodes[idx].kind = AST_STRING Then
        AstCopyStr(ast, idx, dst)
        LowConstStr = 1
    ElseIf nodes[idx].kind = AST_BINOP Then
        If nodes[idx].num = BOP_ADD Or nodes[idx].num = BOP_CAT Then
            If LowConstStr(ast, nodes[idx].left, VarPtr(a)) = 0 Then Exit Function
            If LowConstStr(ast, nodes[idx].right, VarPtr(b)) = 0 Then Exit Function
            LowStrCat(dst, VarPtr(a), VarPtr(b), 64)
            LowConstStr = 1
        End If
    ElseIf nodes[idx].kind = AST_BUILTIN Then
        bi = nodes[idx].num
        If bi = BI_LEFT Then
            If LowConstStr(ast, nodes[idx].left, VarPtr(a)) = 0 Then Exit Function
            rIdx = nodes[idx].right
            If rIdx < 0 Then Exit Function
            If nodes[rIdx].kind <> AST_NUM Then Exit Function
            n = nodes[rIdx].num
            LowStrLeft(dst, VarPtr(a), n, 64)
            LowConstStr = 1
        ElseIf bi = BI_MID Then
            If LowConstStr(ast, nodes[idx].left, VarPtr(a)) = 0 Then Exit Function
            rIdx = nodes[idx].right
            If rIdx < 0 Then Exit Function
            If nodes[rIdx].kind <> AST_NUM Then Exit Function
            start1 = nodes[rIdx].num
            count = -1
            eIdx = nodes[idx].extra
            If eIdx >= 0 Then
                If nodes[eIdx].kind <> AST_NUM Then Exit Function
                count = nodes[eIdx].num
            End If
            LowStrMid(dst, VarPtr(a), start1, count, 64)
            LowConstStr = 1
        ' BI_STR: const-fold はホスト ByRef/バッファで不安定なため実行時 Str$ に任せる
        End If
    End If
End Function

Function LowConstInt(ast As *Ast, idx As Long, ByRef outV As Long) As Long
    Dim nodes As *AstNode
    Dim buf(63) As Byte
    Dim bi As Long

    LowConstInt = 0
    If idx < 0 Then Exit Function
    nodes = ast.nodes
    If nodes[idx].kind = AST_NUM Then
        outV = nodes[idx].num
        LowConstInt = 1
    ElseIf nodes[idx].kind = AST_BUILTIN Then
        bi = nodes[idx].num
        If bi = BI_LEN Then
            If LowConstStr(ast, nodes[idx].left, VarPtr(buf)) = 0 Then Exit Function
            outV = LowStrLen(VarPtr(buf))
            LowConstInt = 1
        ElseIf bi = BI_ASC Then
            If LowConstStr(ast, nodes[idx].left, VarPtr(buf)) = 0 Then Exit Function
            outV = buf[0]
            LowConstInt = 1
        End If
    End If
End Function

Sub LowEmitExitEax(ctx As *LowerCtx)
    Dim sExit(15) As Byte
    lstrcpy(VarPtr(sExit), "ExitProcess")
    IrEmit(ctx.list, OP_MOV_ECX_EAX, 0, 0)
    IrEmitStr(ctx.list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sExit))
End Sub

Sub LowEmitExitImm(ctx As *LowerCtx, code As DWord)
    Dim sExit(15) As Byte
    lstrcpy(VarPtr(sExit), "ExitProcess")
    IrEmit(ctx.list, OP_MOV_ECX, code, 0)
    IrEmitStr(ctx.list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sExit))
End Sub

Function LowIsStringExpr(ctx As *LowerCtx, idx As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim k As Long
    Dim si As Long
    Dim name(63) As Byte
    Dim bi As Long
    Dim off As Long
    Dim ty As Long
    Dim typeIdx As Long
    Dim byRef As Long
    Dim isGlob As Long

    LowIsStringExpr = 0
    If idx < 0 Then Exit Function
    ast = ctx.ast
    nodes = ast.nodes
    k = nodes[idx].kind
    If k = AST_STRING Then
        LowIsStringExpr = 1
        Exit Function
    End If
    If k = AST_BINOP Then
        If nodes[idx].num = BOP_ADD Or nodes[idx].num = BOP_CAT Then
            If LowIsStringExpr(ctx, nodes[idx].left) <> 0 Then
                LowIsStringExpr = 1
                Exit Function
            End If
            If LowIsStringExpr(ctx, nodes[idx].right) <> 0 Then
                LowIsStringExpr = 1
                Exit Function
            End If
        End If
        Exit Function
    End If
    If k = AST_BUILTIN Then
        bi = nodes[idx].num
        If bi = BI_LEFT Or bi = BI_MID Or bi = BI_RIGHT Then
            LowIsStringExpr = 1
        End If
        If bi = BI_CHR Then
            LowIsStringExpr = 1
        End If
        If bi = BI_STR Then
            LowIsStringExpr = 1
        End If
        If bi = BI_MAKESTR Then
            LowIsStringExpr = 1
        End If
        Exit Function
    End If
    If k = AST_VAR Then
        AstCopyStr(ast, idx, VarPtr(name))
        If LowFindStrConst(ctx, VarPtr(name)) >= 0 Then
            LowIsStringExpr = 1
            Exit Function
        End If
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
            If vTy = TY_STRING Then LowIsStringExpr = 1
        End If
        Exit Function
    End If
    If k = AST_CALL Then
        AstCopyStr(ast, idx, VarPtr(name))
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
            If vTy = TY_STRING_ARR Then
                If nodes[idx].num = 1 Then LowIsStringExpr = 1
            End If
        Else
            If LowFindFunc(ctx, VarPtr(name)) >= 0 Then
                si = 0
                While name[si] <> 0
                    si = si + 1
                Wend
                If si > 0 Then
                    If name[si - 1] = 36 Then LowIsStringExpr = 1
                End If
            End If
        End If
        Exit Function
    End If
End Function

