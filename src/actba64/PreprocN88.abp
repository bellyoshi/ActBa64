' ===================================================
'  PreprocN88 - -pN88 の前置きとユーザーコード
' ===================================================
' 前置き: Include\default ほか + Include\N88BASIC + N88_StartUi()。
' #N88BASIC がユーザーコードに無くても、指定したものとして扱う。
' 末尾の N88_WaitClose() は ParserN88Prog がユーザーコードの後ろに足す。

Const PP_N88_MARK_LEN = 1100

Function PpN88Head() As *Byte
    Dim head As *Byte
    Dim headLen As Long
    PpN88Head = NULL
    PpN88SetMode()
    head = calloc(1)
    If head = NULL Then Exit Function
    headLen = 0
    If PpN88HeadChunks(head, headLen) Then PpN88Head = head
End Function

Sub PpN88SetMode()
    g_ppN88Basic = 1
    g_ppConsole = 0
    g_ppUseWindow = 1
End Sub

' 戻り値 true : 正常終了  false : エラーあり（head は解放済み）
Function PpN88HeadChunks(ByRef head As *Byte, ByRef headLen As Long) As boolean
    PpN88HeadChunks = false
    If Not PpAppendDefaultChunk(head, headLen) Then Exit Function
    If Not PpAppendApiChunk(head, headLen) Then Exit Function
    If Not PpAppendUnicodeChunk(head, headLen) Then Exit Function
    If Not PpAppendN88Chunk(head, headLen) Then Exit Function
    PpN88HeadChunks = PpAppendN88Boot(head, headLen)
End Function

' ユーザーコードの先頭にファイル目印（' ---- path ----）を付けた複製
Function PpN88MarkUser(src As *Byte, path As *Byte) As *Byte
    Dim mark(PP_N88_MARK_LEN - 1) As Byte
    Dim markLen As Long
    PpN88MarkUser = NULL
    markLen = 0
    If Not PpEmitFileMark(VarPtr(mark), markLen, PP_N88_MARK_LEN, path) Then Exit Function
    PpN88MarkUser = PpConcatText(VarPtr(mark), markLen, src, lstrlen(src))
End Function
