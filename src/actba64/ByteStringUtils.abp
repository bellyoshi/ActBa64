' ByteStringUtils.abp - String と NUL 終端 ByteString(*Byte) の比較
' 前提: ByteCharUtils.abp（ToLowerChar）

' 完全一致（大小区別あり）。一致なら 1
Function ByteStrEq(s As String, b As *Byte) As Long
    Dim p As *Byte
    Dim i As Long
    Dim n As Long

    ByteStrEq = 0
    If b = 0 Then
        If Len(s) = 0 Then ByteStrEq = 1
        Exit Function
    End If
    p = StrPtr(s)
    n = Len(s)
    i = 0
    While i < n
        If p[i] <> b[i] Then Exit Function
        i = i + 1
    Wend
    If b[n] <> 0 Then Exit Function
    ByteStrEq = 1
End Function

' 大小無視で一致なら 1
Function ByteStrEqCI(s As String, b As *Byte) As Long
    Dim p As *Byte
    Dim i As Long
    Dim n As Long
    Dim ca As Long
    Dim cb As Long

    ByteStrEqCI = 0
    If b = 0 Then
        If Len(s) = 0 Then ByteStrEqCI = 1
        Exit Function
    End If
    p = StrPtr(s)
    n = Len(s)
    i = 0
    While i < n
        ca = ToLowerChar(p[i])
        cb = ToLowerChar(b[i])
        If ca <> cb Then Exit Function
        i = i + 1
    Wend
    If b[n] <> 0 Then Exit Function
    ByteStrEqCI = 1
End Function

' b（NUL 終端）が prefix（String）で始まっていれば 1
Function ByteStrStartsWith(b As *Byte, prefix As String) As Long
    Dim p As *Byte
    Dim i As Long
    Dim n As Long

    ByteStrStartsWith = 0
    n = Len(prefix)
    If n = 0 Then
        ByteStrStartsWith = 1
        Exit Function
    End If
    If b = 0 Then Exit Function
    p = StrPtr(prefix)
    i = 0
    While i < n
        If b[i] = 0 Then Exit Function
        If b[i] <> p[i] Then Exit Function
        i = i + 1
    Wend
    ByteStrStartsWith = 1
End Function

' 大小無視で、b が prefix で始まっていれば 1
Function ByteStrStartsWithCI(b As *Byte, prefix As String) As Long
    Dim p As *Byte
    Dim i As Long
    Dim n As Long
    Dim ca As Long
    Dim cb As Long

    ByteStrStartsWithCI = 0
    n = Len(prefix)
    If n = 0 Then
        ByteStrStartsWithCI = 1
        Exit Function
    End If
    If b = 0 Then Exit Function
    p = StrPtr(prefix)
    i = 0
    While i < n
        If b[i] = 0 Then Exit Function
        ca = ToLowerChar(b[i])
        cb = ToLowerChar(p[i])
        If ca <> cb Then Exit Function
        i = i + 1
    Wend
    ByteStrStartsWithCI = 1
End Function
