' ByteStringUtils.abp - String と NUL 終端 ByteString(*Byte) の比較
' 前提: ByteCharUtils.abp（ToLowerChar）

' 2 本の NUL 終端 *Byte を完全一致（大小区別）。一致なら 1
Function ByteNameEq(a As *Byte, b As *Byte) As Long
    Dim i As Long
    ByteNameEq = 0
    If a = 0 Or b = 0 Then
        If a = b Then ByteNameEq = 1
        Exit Function
    End If
    i = 0
    Do
        If a[i] <> b[i] Then Exit Function
        If a[i] = 0 Then
            ByteNameEq = 1
            Exit Function
        End If
        i = i + 1
    Loop
End Function

' 2 本の NUL 終端 *Byte を大小無視で比較。一致なら 1
Function ByteNameEqCI(a As *Byte, b As *Byte) As Long
    Dim i As Long
    Dim ca As Long
    Dim cb As Long
    ByteNameEqCI = 0
    If a = 0 Or b = 0 Then
        If a = b Then ByteNameEqCI = 1
        Exit Function
    End If
    i = 0
    Do
        ca = ToLowerChar(a[i])
        cb = ToLowerChar(b[i])
        If ca <> cb Then Exit Function
        If ca = 0 Then
            ByteNameEqCI = 1
            Exit Function
        End If
        i = i + 1
    Loop
End Function

' 完全一致（大小区別あり）。一致なら 1
' 戻り値 true : 成り立つ  false : 成り立たない
Function ByteStrEq(s As String, b As *Byte) As boolean
    Dim p As *Byte
    Dim i As Long
    Dim n As Long

    ByteStrEq = false
    If b = 0 Then
        If Len(s) = 0 Then ByteStrEq = 1
        Exit Function
    End If
    p = StrPtr(s)
    n = Len(s)
    i = 0
    While i < n
        If p[i] <> b[i] Then Exit Function
        i = i + 1
    Wend
    If b[n] <> 0 Then Exit Function
    ByteStrEq = true
End Function

' 大小無視で一致なら 1
' 戻り値 true : 成り立つ  false : 成り立たない
Function ByteStrEqCI(s As String, b As *Byte) As boolean
    Dim p As *Byte
    Dim i As Long
    Dim n As Long
    Dim ca As Long
    Dim cb As Long

    ByteStrEqCI = false
    If b = 0 Then
        If Len(s) = 0 Then ByteStrEqCI = 1
        Exit Function
    End If
    p = StrPtr(s)
    n = Len(s)
    i = 0
    While i < n
        ca = ToLowerChar(p[i])
        cb = ToLowerChar(b[i])
        If ca <> cb Then Exit Function
        i = i + 1
    Wend
    If b[n] <> 0 Then Exit Function
    ByteStrEqCI = true
End Function

' b（NUL 終端）が prefix（String）で始まっていれば 1
' 戻り値 true : 成り立つ  false : 成り立たない
Function ByteStrStartsWith(b As *Byte, prefix As String) As boolean
    Dim p As *Byte
    Dim i As Long
    Dim n As Long

    ByteStrStartsWith = false
    n = Len(prefix)
    If n = 0 Then
        ByteStrStartsWith = true
        Exit Function
    End If
    If b = 0 Then Exit Function
    p = StrPtr(prefix)
    i = 0
    While i < n
        If b[i] = 0 Then Exit Function
        If b[i] <> p[i] Then Exit Function
        i = i + 1
    Wend
    ByteStrStartsWith = true
End Function

' 大小無視で、b が prefix で始まっていれば 1
' 戻り値 true : 成り立つ  false : 成り立たない
Function ByteStrStartsWithCI(b As *Byte, prefix As String) As boolean
    Dim p As *Byte
    Dim i As Long
    Dim n As Long
    Dim ca As Long
    Dim cb As Long

    ByteStrStartsWithCI = false
    n = Len(prefix)
    If n = 0 Then
        ByteStrStartsWithCI = true
        Exit Function
    End If
    If b = 0 Then Exit Function
    p = StrPtr(prefix)
    i = 0
    While i < n
        If b[i] = 0 Then Exit Function
        ca = ToLowerChar(b[i])
        cb = ToLowerChar(p[i])
        If ca <> cb Then Exit Function
        i = i + 1
    Wend
    ByteStrStartsWithCI = true
End Function
