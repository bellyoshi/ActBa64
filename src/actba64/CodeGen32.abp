' ===================================================
'  CodeGen32 - IR -> i386 machine code (abs IAT / strings)
' ===================================================

Function CgImageBase32() As DWord
    CgImageBase32 = IMAGE_BASE_32
    If g_ppModuleDll <> 0 Then CgImageBase32 = IMAGE_BASE_32_DLL
End Function

' AB4.20 は連鎖加算を 16bit 化することがある。
Function CgAbs32Add(a As DWord, b As DWord) As DWord
    Dim s As DWord
    s = a
    s = s + b
    CgAbs32Add = s
End Function

Function CgAbs32Lab(off As Long) As DWord
    Dim n As DWord
    Dim t As DWord
    Dim a As DWord
    n = off
    t = TEXT_RVA
    a = CgAbs32Add(CgImageBase32(), t)
    a = CgAbs32Add(a, n)
    CgAbs32Lab = a
End Function

Function CgAbs32Glob(dataRva As DWord, globOff As DWord) As DWord
    Dim a As DWord
    a = CgAbs32Add(CgImageBase32(), dataRva)
    a = CgAbs32Add(a, globOff)
    CgAbs32Glob = a
End Function

Sub CgApplyFixups32(cb As *CodeBuffer)
    Dim i As Long
    Dim li As Long
    Dim at As Long
    Dim rel As Long
    Dim nextRip As Long
    Dim absAddr As DWord
    For i = 0 To g_cgNFix - 1
        li = g_cgFix[i].lab
        at = g_cgFix[i].at
        If CgEnsureLabIdx(li) Then
            If g_cgLabOff[li] >= 0 Then
                If g_cgFix[i].kind = IR_FIX_ABS32 Then
                    absAddr = CgAbs32Lab(g_cgLabOff[li])
                    If at >= 0 And at + 4 <= cb->capacity Then
                        PutDword(cb->buf, at, absAddr)
                    End If
                Else
                    nextRip = at + 4
                    rel = g_cgLabOff[li] - nextRip
                    If at >= 0 And at + 4 <= cb->capacity Then
                        PutDword(cb->buf, at, rel)
                    End If
                End If
            End If
        End If
    Next
    CgSnapExports()
    free(g_cgLabOff)
    free(g_cgFix)
    g_cgLabOff = NULL
    g_cgFix = NULL
    g_cgLabCap = 0
    g_cgFixCap = 0
    g_cgNFix = 0
End Sub

' 戻り値 true : 正常終了  false : エラーあり
Function CgTryEmit32A1(cb As *CodeBuffer, op As *IrOp, builder As *ImportBuilder) As boolean
    Dim opv As Long
    Dim strRva As DWord
    CgTryEmit32A1 = false
    opv = op->op
    If opv = OP_ENTER Then
        Emit32Enter(cb, op->arg1)
    ElseIf opv = OP_LEAVE Then
        Emit32LeaveRet(cb, op->arg1)
    ElseIf opv = OP_XOR_ECX Then
        EmitXorEcx(cb)
    ElseIf opv = OP_XOR_R9D Then
        EmitXorEcx(cb)
    ElseIf opv = OP_LEA_RDX_STR Then
        strRva = IbGetStringRva(builder, op->strId)
        Emit32MovEdxAbs(cb, CgAbs32Add(CgImageBase32(), strRva))
    ElseIf opv = OP_LEA_R8_STR Then
        strRva = IbGetStringRva(builder, op->strId)
        Emit32MovEdxAbs(cb, CgAbs32Add(CgImageBase32(), strRva))
    ElseIf opv = OP_LEA_RAX_STR Then
        strRva = IbGetStringRva(builder, op->strId)
        Emit32MovAbsEax(cb, CgAbs32Add(CgImageBase32(), strRva))
    ElseIf opv = OP_MOV_RCX_RAX Then
        Emit32MovEcxEax(cb)
    ElseIf opv = OP_MOV_RDX_RAX Then
        Emit32MovEdxEax(cb)
    ElseIf opv = OP_MOV_R8_RAX Then
        Emit32MovEcxEax(cb)
    ElseIf opv = OP_MOVZX_EAX_BYTE Then
        EmitMovzxEaxByteRax(cb)
    ElseIf opv = OP_TEST_RAX Then
        EmitTestEax(cb)
    ElseIf opv = OP_XOR_EAX Then
        EmitXorEax(cb)
    Else
        Exit Function
    End If
    CgTryEmit32A1 = true
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function CgTryEmit32A2(cb As *CodeBuffer, op As *IrOp) As boolean
    Dim opv As Long
    CgTryEmit32A2 = false
    opv = op->op
    If opv = OP_LEA_LOCAL Then
        Emit32LeaLocal(cb, op->arg1)
    ElseIf opv = OP_ADD_RAX_RCX Then
        Emit32AddEaxEcx(cb)
    ElseIf opv = OP_LOADZX_BYTE_RAX Then
        EmitLoadzxByteRax(cb)
    ElseIf opv = OP_STORE_BYTE_RAX_CL Then
        EmitStoreByteRaxCl(cb)
    ElseIf opv = OP_ADD_RAX_IMM Then
        Emit32AddEaxImm(cb, op->arg1)
    ElseIf opv = OP_LOADZX_WORD_RAX Then
        EmitLoadzxWordRax(cb)
    ElseIf opv = OP_STORE_WORD_RAX_CX Then
        EmitStoreWordRaxCx(cb)
    ElseIf opv = OP_LOAD_DWORD_RAX Then
        EmitLoadDwordRax(cb)
    ElseIf opv = OP_STORE_DWORD_RAX_ECX Then
        EmitStoreDwordRaxEcx(cb)
    ElseIf opv = OP_LOAD_QWORD_RAX Then
        Emit32LoadPtr(cb)
    ElseIf opv = OP_LOAD_PTR Then
        Emit32LoadPtr(cb)
    ElseIf opv = OP_STORE_QWORD_RAX_RCX Then
        Emit32StorePtr(cb)
    ElseIf opv = OP_STORE_PTR Then
        Emit32StorePtr(cb)
    Else
        Exit Function
    End If
    CgTryEmit32A2 = true
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function CgTryEmit32A(cb As *CodeBuffer, op As *IrOp, builder As *ImportBuilder) As boolean
    CgTryEmit32A = false
    If CgTryEmit32A1(cb, op, builder) Then
        CgTryEmit32A = true
        Exit Function
    End If
    If CgTryEmit32A2(cb, op) Then
        CgTryEmit32A = true
    End If
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function CgTryEmit32B1(cb As *CodeBuffer, op As *IrOp) As boolean
    Dim opv As Long
    CgTryEmit32B1 = false
    opv = op->op
    If opv = OP_SHL_ECX_2 Then
        Emit32ShlEcx2(cb)
    ElseIf opv = OP_AND_EAX_ECX Then
        EmitAndEaxEcx(cb)
    ElseIf opv = OP_OR_EAX_ECX Then
        EmitOrEaxEcx(cb)
    ElseIf opv = OP_NEG_EAX Then
        EmitNegEax(cb)
    ElseIf opv = OP_SUB_EAX_ECX Then
        EmitSubEaxEcx(cb)
    ElseIf opv = OP_POP_RDX Then
        EmitPopRdx(cb)
    ElseIf opv = OP_XCHG_RAX_RCX Then
        Emit32XchgEaxEcx(cb)
    ElseIf opv = OP_MOV_ECX Then
        EmitMovEcxImm(cb, op->arg1)
    ElseIf opv = OP_MOV_EAX_IMM Then
        EmitMovEaxImm(cb, op->arg1)
    ElseIf opv = OP_LOAD_LOCAL Then
        Emit32LoadLocal(cb, op->arg1)
    ElseIf opv = OP_STORE_LOCAL Then
        Emit32StoreLocal(cb, op->arg1)
    Else
        Exit Function
    End If
    CgTryEmit32B1 = true
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function CgTryEmit32B2(cb As *CodeBuffer, op As *IrOp) As boolean
    Dim opv As Long
    CgTryEmit32B2 = false
    opv = op->op
    If opv = OP_PUSH_RAX Then
        EmitPushRax(cb)
    ElseIf opv = OP_POP_RCX Then
        EmitPopRcx(cb)
    ElseIf opv = OP_ADD_EAX_ECX Then
        EmitAddEaxEcx(cb)
    ElseIf opv = OP_IMUL_EAX_ECX Then
        EmitImulEaxEcx(cb)
    ElseIf opv = OP_MOV_ECX_EAX Then
        EmitMovEcxEax(cb)
    ElseIf opv = OP_CMP_ECX_EAX Then
        EmitCmpEcxEax(cb)
    ElseIf opv = OP_CMP_RCX_RAX Then
        EmitCmpEcxEax(cb)
    ElseIf opv = OP_TEST_EAX Then
        EmitTestEax(cb)
    ElseIf opv = OP_INC_LOCAL Then
        Emit32IncLocal(cb, op->arg1)
    ElseIf opv = OP_STORE_LOCAL_ECX Then
        Emit32StoreLocalEcx(cb, op->arg1)
    ElseIf opv = OP_STORE_LOCAL_EDX Then
        Emit32StoreLocalEdx(cb, op->arg1)
    ElseIf opv = OP_MOV_EDX_IMM Then
        EmitMovEdxImm(cb, op->arg1)
    ElseIf opv = OP_MOV_EDX_EAX Then
        EmitMovEdxEax(cb)
    Else
        Exit Function
    End If
    CgTryEmit32B2 = true
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function CgTryEmit32B3(cb As *CodeBuffer, op As *IrOp, dataRva As DWord) As boolean
    Dim opv As Long
    Dim at As Long
    Dim globOff As DWord
    CgTryEmit32B3 = false
    opv = op->op
    If opv = OP_CALL_LAB Then
        at = EmitCallRel32(cb)
        CgPushFix(at, op->arg1, IR_FIX_REL32)
    ElseIf opv = OP_CALL_RAX Then
        EmitCallRax(cb)
    ElseIf opv = OP_LEA_RAX_LAB Then
        at = Emit32MovEaxImmFixup(cb)
        CgPushFix(at, op->arg1, IR_FIX_ABS32)
    ElseIf opv = OP_LEA_RAX_GLOB Then
        globOff = op->arg1
        Emit32MovAbsEax(cb, CgAbs32Glob(dataRva, globOff))
    Else
        Exit Function
    End If
    CgTryEmit32B3 = true
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function CgTryEmit32B(cb As *CodeBuffer, op As *IrOp, dataRva As DWord) As boolean
    CgTryEmit32B = false
    If CgTryEmit32Dbl(cb, op) Then
        CgTryEmit32B = true
        Exit Function
    End If
    If CgTryEmit32B1(cb, op) Then
        CgTryEmit32B = true
        Exit Function
    End If
    If CgTryEmit32B2(cb, op) Then
        CgTryEmit32B = true
        Exit Function
    End If
    If CgTryEmit32B3(cb, op, dataRva) Then
        CgTryEmit32B = true
    End If
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function CgTryEmit32C(cb As *CodeBuffer, op As *IrOp) As boolean
    Dim opv As Long
    CgTryEmit32C = false
    If CgTryEmit32Fpu(cb, op) Then
        CgTryEmit32C = true
        Exit Function
    End If
    If CgTryEmitSharedC(cb, op) Then
        CgTryEmit32C = true
        Exit Function
    End If
    opv = op->op
    If opv = OP_POP_R8 Then
        EmitPopRcx(cb)
    ElseIf opv = OP_MOV_RAX_R8 Then
        Emit32MovEaxEcx(cb)
    ElseIf opv = OP_SUB_RSP Then
        Emit32SubEsp(cb, op->arg1)
    ElseIf opv = OP_ADD_RSP Then
        Emit32AddEsp(cb, op->arg1)
    ElseIf opv = OP_STORE_RSP_RAX Then
        Emit32StoreEspEax(cb, op->arg1)
    ElseIf opv = OP_LOAD_RSP_RAX Then
        Emit32LoadEspEax(cb, op->arg1)
    ElseIf opv = OP_MOV_R9_RAX Then
        Emit32MovEdxEax(cb)
    ElseIf opv = OP_STORE_LOCAL_R8 Then
        Emit32StoreLocalEcx(cb, op->arg1)
    ElseIf opv = OP_STORE_LOCAL_R9 Then
        Emit32StoreLocalEdx(cb, op->arg1)
    Else
        Exit Function
    End If
    CgTryEmit32C = true
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function CgTryEmit32D(list As *IrList, cb As *CodeBuffer, builder As *ImportBuilder, i As Long) As boolean
    Dim ops As *IrOp
    Dim op As *IrOp
    Dim opv As Long
    Dim dll(SYM_NAME_LEN - 1) As Byte
    Dim api(SYM_NAME_LEN - 1) As Byte
    Dim iatRva As DWord
    CgTryEmit32D = false
    ops = list->ops
    op = VarPtr(ops[i])
    If CgTryEmitSharedCtrl(cb, op) Then
        CgTryEmit32D = true
        Exit Function
    End If
    opv = op->op
    If opv = OP_MOV_RAX_GS8 Then
        Emit32FsStackBase(cb)
    ElseIf opv = OP_MOV_R8_RSP Then
        Emit32MovEcxEsp(cb)
    ElseIf opv = OP_CMP_R8_RAX Then
        Emit32CmpEcxEax(cb)
    ElseIf opv = OP_ADD_R8_IMM Then
        Emit32AddEcxImm8(cb, op->arg1 As Byte)
    ElseIf opv = OP_CALL_API Then
        If Not IrResolveApiNames(list, i, VarPtr(dll), VarPtr(api)) Then Exit Function
        iatRva = IbGetIatRva(builder, VarPtr(dll), VarPtr(api))
        Emit32CallIatAbs(cb, CgAbs32Add(CgImageBase32(), iatRva))
    Else
        Exit Function
    End If
    CgTryEmit32D = true
End Function

Function CgEmit32DblImm(cb As *CodeBuffer, op As *IrOp) As boolean
    CgEmit32DblImm = false
    If op->op <> OP_MOV_RAX_IMM64 Then Exit Function
    Emit32MovRaxImm64(cb, op->arg1, op->arg2)
    CgEmit32DblImm = true
End Function

Function CgEmit32DblLocal(cb As *CodeBuffer, op As *IrOp) As boolean
    CgEmit32DblLocal = true
    If op->op = OP_LOAD_DBL Then
        Emit32LoadDbl(cb, op->arg1)
    ElseIf op->op = OP_STORE_DBL Then
        Emit32StoreDbl(cb, op->arg1)
    Else
        CgEmit32DblLocal = false
    End If
End Function

Function CgEmit32DblMove(cb As *CodeBuffer, op As *IrOp) As boolean
    CgEmit32DblMove = CgEmit32DblImm(cb, op)
    If CgEmit32DblMove <> 0 Then Exit Function
    CgEmit32DblMove = CgEmit32DblLocal(cb, op)
End Function

Function CgEmit32DblPush(cb As *CodeBuffer, opv As Long) As boolean
    CgEmit32DblPush = true
    If opv = OP_PUSH_DBL Then
        Emit32PushDbl(cb)
    ElseIf opv = OP_POP_DBL Then
        Emit32PopDbl(cb)
    Else
        CgEmit32DblPush = false
    End If
End Function

Function CgEmit32DblPtr(cb As *CodeBuffer, op As *IrOp) As boolean
    Dim opv As Long
    opv = op->op
    CgEmit32DblPtr = true
    If opv = OP_LOAD_DBL_MEM Then
        Emit32LoadDblMem(cb)
    ElseIf opv = OP_STORE_DBL_MEM Then
        Emit32StoreDblMem(cb)
    ElseIf opv = OP_STORE_RSP_DBL Then
        Emit32StoreEspDbl(cb, op->arg1)
    Else
        CgEmit32DblPtr = false
    End If
End Function

Function CgTryEmit32Dbl(cb As *CodeBuffer, op As *IrOp) As boolean
    CgTryEmit32Dbl = CgEmit32DblMove(cb, op)
    If CgTryEmit32Dbl <> 0 Then Exit Function
    CgTryEmit32Dbl = CgEmit32DblPush(cb, op->op)
    If CgTryEmit32Dbl <> 0 Then Exit Function
    CgTryEmit32Dbl = CgEmit32DblPtr(cb, op)
End Function

Function CgEmit32FpuArith(cb As *CodeBuffer, opv As Long) As boolean
    CgEmit32FpuArith = true
    If opv = OP_ADD_SD Then
        Emit32AddSd(cb)
    ElseIf opv = OP_SUB_SD Then
        Emit32SubSd(cb)
    Else
        CgEmit32FpuArith = false
    End If
End Function

Function CgEmit32FpuMul(cb As *CodeBuffer, opv As Long) As boolean
    CgEmit32FpuMul = true
    If opv = OP_MUL_SD Then
        Emit32MulSd(cb)
    ElseIf opv = OP_DIV_SD Then
        Emit32DivSd(cb)
    Else
        CgEmit32FpuMul = false
    End If
End Function

Function CgEmit32FpuAdd(cb As *CodeBuffer, opv As Long) As boolean
    CgEmit32FpuAdd = CgEmit32FpuArith(cb, opv)
    If CgEmit32FpuAdd <> 0 Then Exit Function
    CgEmit32FpuAdd = CgEmit32FpuMul(cb, opv)
End Function

Function CgEmit32FpuCmp(cb As *CodeBuffer, opv As Long) As boolean
    CgEmit32FpuCmp = true
    If opv = OP_UCOMISD Then
        Emit32Ucomisd(cb)
    ElseIf opv = OP_NEG_SD Then
        Emit32NegSd(cb)
    Else
        CgEmit32FpuCmp = false
    End If
End Function

Function CgEmit32FpuCvtI(cb As *CodeBuffer, opv As Long) As boolean
    CgEmit32FpuCvtI = true
    If opv = OP_CVT_I32_TO_SD Then
        Emit32CvtI32ToSd(cb)
    ElseIf opv = OP_CVT_SD_TO_I32 Then
        Emit32CvtSdToI32(cb)
    Else
        CgEmit32FpuCvtI = false
    End If
End Function

Function CgEmit32FpuCvtS(cb As *CodeBuffer, opv As Long) As boolean
    CgEmit32FpuCvtS = true
    If opv = OP_CVT_SS_TO_SD Then
        Emit32CvtSsToSd(cb)
    ElseIf opv = OP_CVT_SD_TO_SS Then
        Emit32CvtSdToSs(cb)
    Else
        CgEmit32FpuCvtS = false
    End If
End Function

Function CgEmit32FpuCvt(cb As *CodeBuffer, opv As Long) As boolean
    CgEmit32FpuCvt = CgEmit32FpuCvtI(cb, opv)
    If CgEmit32FpuCvt <> 0 Then Exit Function
    CgEmit32FpuCvt = CgEmit32FpuCvtS(cb, opv)
End Function

Function CgTryEmit32Fpu(cb As *CodeBuffer, op As *IrOp) As boolean
    Dim opv As Long
    opv = op->op
    CgTryEmit32Fpu = CgEmit32FpuAdd(cb, opv)
    If CgTryEmit32Fpu <> 0 Then Exit Function
    CgTryEmit32Fpu = CgEmit32FpuCmp(cb, opv)
    If CgTryEmit32Fpu <> 0 Then Exit Function
    CgTryEmit32Fpu = CgEmit32FpuCvt(cb, opv)
End Function

Sub IrEmitCode32(list As *IrList, cb As *CodeBuffer, builder As *ImportBuilder, dataRva As DWord)
    Dim i As Long
    Dim n As Long
    Dim ops As *IrOp

    If Not CgInitFixups() Then Exit Sub
    ops = list->ops
    n = list->count
    For i = 0 To n - 1
        If CgTryEmit32A(cb, VarPtr(ops[i]), builder) Then
        ElseIf CgTryEmit32B(cb, VarPtr(ops[i]), dataRva) Then
        ElseIf CgTryEmit32C(cb, VarPtr(ops[i])) Then
        ElseIf CgTryEmit32D(list, cb, builder, i) Then
        End If
    Next
    CgApplyFixups32(cb)
End Sub
