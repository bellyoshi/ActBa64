' ParserN88Color - COLOR textcolor [, backcolor] → Color(text, back)
' 背景省略時の第2引数は -2（n88color.abp の COLOR_OMIT）

Function ParseN88ColorOpt(p As *Parser, ByRef e2 As Long) As boolean
    ParseN88ColorOpt = true
    e2 = -1
    If ParseTokKind(p) <> TK_COMMA Then Exit Function
    p->pos = p->pos + 1
    e2 = ParseExpr(p)
    If e2 < 0 Then ParseN88ColorOpt = false
End Function

Function ParseN88ColorBare(p As *Parser, ByRef e1 As Long, ByRef e2 As Long) As boolean
    ParseN88ColorBare = false
    e1 = ParseExpr(p)
    If e1 < 0 Then Exit Function
    ParseN88ColorBare = ParseN88ColorOpt(p, e2)
End Function

Function ParseN88ColorParen(p As *Parser, ByRef e1 As Long, ByRef e2 As Long) As boolean
    ParseN88ColorParen = false
    p->pos = p->pos + 1
    If Not ParseN88ColorBare(p, e1, e2) Then Exit Function
    ParseN88ColorParen = ParseExpect(p, TK_RPAREN)
End Function

Function ParseN88ColorHead(p As *Parser, ByRef e1 As Long, ByRef e2 As Long) As boolean
    ParseN88ColorHead = false
    p->pos = p->pos + 1
    If ParseTokKind(p) = TK_LPAREN Then
        ParseN88ColorHead = ParseN88ColorParen(p, e1, e2)
        Exit Function
    End If
    ParseN88ColorHead = ParseN88ColorBare(p, e1, e2)
End Function

Function ParseN88ColorBack(ast As *Ast, e2 As Long) As Long
    ParseN88ColorBack = e2
    If e2 >= 0 Then Exit Function
    ParseN88ColorBack = ParseMakeNum(ast, -2)
End Function

Function ParseN88ColorPush(ast As *Ast, e1 As Long, e2 As Long, ByRef arg0 As Long, ByRef nArgs As Long) As Long
    Dim nPrev As Long
    ParseN88ColorPush = 0
    arg0 = -1
    nPrev = -1
    nArgs = 0
    If Not ParseLinkArg(ast, arg0, nPrev, nArgs, e1) Then Exit Function
    If Not ParseLinkArg(ast, arg0, nPrev, nArgs, e2) Then Exit Function
    ParseN88ColorPush = 1
End Function

Function ParseN88ColorLink(ast As *Ast, e1 As Long, e2 As Long) As Long
    Dim name(KW_LEN - 1) As Byte
    Dim arg0 As Long
    Dim nArgs As Long
    ParseN88ColorLink = -1
    If ParseN88ColorPush(ast, e1, e2, arg0, nArgs) = 0 Then Exit Function
    lstrcpy(VarPtr(name), "Color")
    ParseN88ColorLink = ParseMakeCall(ast, VarPtr(name), arg0, nArgs)
End Function

Function ParseN88ColorStmt(p As *Parser) As Long
    Dim e1 As Long
    Dim e2 As Long
    ParseN88ColorStmt = -1
    If Not ParseN88ColorHead(p, e1, e2) Then Exit Function
    e2 = ParseN88ColorBack(p->ast, e2)
    If e2 < 0 Then Exit Function
    ParseN88ColorStmt = ParseN88ColorLink(p->ast, e1, e2)
End Function
