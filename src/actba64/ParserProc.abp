' ParserProc - Sub、Function、ループの頭

Dim g_loopN As Long
Dim g_loopKind(15) As Long

Sub LoopPush(kind As Long)
    If g_loopN >= 16 Then Exit Sub
    g_loopKind[g_loopN] = kind
    g_loopN = g_loopN + 1
End Sub

Sub LoopPop()
    If g_loopN > 0 Then g_loopN = g_loopN - 1
End Sub

Function LoopTop() As Long
    Dim i As Long
    LoopTop = 0
    If g_loopN <= 0 Then Exit Function
    i = g_loopN - 1
    LoopTop = g_loopKind[i]
End Function

Function ParseSubStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nFunc As Long
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim nFirst As Long
    Dim body As Long
    Dim kEnd(KW_SHORT_LEN - 1) As Byte
    Dim kSub(KW_SHORT_LEN - 1) As Byte
    Dim empty(1) As Byte
    Dim nParams As Long
    Dim exp As Long

    ParseSubStmt = -1
    exp = ParseBeginProc(p, VarPtr(name))
    If exp < 0 Then Exit Function
    If Not ParseExpect(p, TK_LPAREN) Then Exit Function
    ast = p->ast
    If Not ParseParamList(p, nFirst, nParams, 0, 1) Then Exit Function
    empty[0] = 0
    lstrcpy(VarPtr(kEnd), "end")
    lstrcpy(VarPtr(kSub), "sub")
    body = ParseStmtListUntilEndPair(p, VarPtr(kSub))
    If p->err <> 0 Then Exit Function
    If ParseIdentIs(p, VarPtr(kEnd)) = 0 Then
        p->err = 1
        Exit Function
    End If
    p->pos = p->pos + 1
    If ParseIdentIs(p, VarPtr(kSub)) = 0 Then
        p->err = 1
        Exit Function
    End If
    p->pos = p->pos + 1
    nFunc = AstAddNode(ast, AST_FUNC)
    If nFunc < 0 Then Exit Function
    AstSetStr(ast, nFunc, VarPtr(name))
    nodes = ast->nodes
    nodes[nFunc].left = nFirst
    nodes[nFunc].right = body
    nodes[nFunc].num = nParams Or AST_FUNC_SUB
    ParseApplyExport(ast, nFunc, exp)
    ParseSubStmt = nFunc
End Function

Function ParseWhileBody(p As *Parser, kWend As *Byte) As Long
    Dim empty(1) As Byte
    empty[0] = 0
    lstrcpy(kWend, "wend")
    LoopPush(AST_CONTINUEWHILE)
    ParseWhileBody = ParseStmtListUntil(p, kWend, VarPtr(empty))
    LoopPop()
End Function

Function ParseWhileWend(p As *Parser, kWend As *Byte) As boolean
    ParseWhileWend = false
    If ParseIdentIs(p, kWend) = 0 Then
        p->err = 1
        Exit Function
    End If
    p->pos = p->pos + 1
    ParseWhileWend = true
End Function

Sub ParseWhileFill(ast As *Ast, nWhile As Long, cond As Long, body As Long)
    Dim nodes As *AstNode
    nodes = ast->nodes
    nodes[nWhile].left = cond
    nodes[nWhile].right = body
End Sub

Function ParseWhileNode(p As *Parser, cond As Long, body As Long) As Long
    Dim ast As *Ast
    Dim nWhile As Long
    ast = p->ast
    nWhile = AstAddNode(ast, AST_WHILE)
    ParseWhileNode = nWhile
    If nWhile < 0 Then Exit Function
    ParseWhileFill(ast, nWhile, cond, body)
End Function

Function ParseWhileRest(p As *Parser, cond As Long) As Long
    Dim body As Long
    Dim kWend(KW_SHORT_LEN - 1) As Byte
    ParseWhileRest = -1
    body = ParseWhileBody(p, VarPtr(kWend))
    If p->err <> 0 Then Exit Function
    If Not ParseWhileWend(p, VarPtr(kWend)) Then Exit Function
    ParseWhileRest = ParseWhileNode(p, cond, body)
End Function

Function ParseWhileStmt(p As *Parser) As Long
    Dim cond As Long
    ParseWhileStmt = -1
    p->pos = p->pos + 1
    cond = ParseCond(p)
    If cond < 0 Then Exit Function
    ParseWhileStmt = ParseWhileRest(p, cond)
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function ParseForHeader(p As *Parser, ast As *Ast, name As *Byte, ByRef fromE As Long, ByRef toE As Long, ByRef stepE As Long) As boolean
    Dim kTo(KW_SHORT_LEN - 1) As Byte
    Dim kStep(KW_SHORT_LEN - 1) As Byte

    ParseForHeader = false
    p->pos = p->pos + 1
    If Not ParseCopyIdent(p, name) Then Exit Function
    If Not ParseExpect(p, TK_EQ) Then Exit Function
    fromE = ParseExpr(p)
    If fromE < 0 Then Exit Function
    lstrcpy(VarPtr(kTo), "to")
    If ParseIdentIs(p, VarPtr(kTo)) = 0 Then
        p->err = 1
        Exit Function
    End If
    p->pos = p->pos + 1
    toE = ParseExpr(p)
    If toE < 0 Then Exit Function
    stepE = ParseMakeNum(ast, 1)
    If stepE < 0 Then Exit Function
    lstrcpy(VarPtr(kStep), "step")
    If ParseIdentIs(p, VarPtr(kStep)) <> 0 Then
        p->pos = p->pos + 1
        stepE = ParseExpr(p)
        If stepE < 0 Then Exit Function
    End If
    ParseForHeader = true
End Function

Function ParseForBody(p As *Parser) As Long
    Dim kNext(KW_SHORT_LEN - 1) As Byte
    Dim empty(1) As Byte
    lstrcpy(VarPtr(kNext), "next")
    empty[0] = 0
    LoopPush(AST_CONTINUEFOR)
    ParseForBody = ParseStmtListUntil(p, VarPtr(kNext), VarPtr(empty))
    LoopPop()
End Function

Sub ParseForNextName(p As *Parser, name As *Byte)
    If ParseIdentIs(p, name) <> 0 Then p->pos = p->pos + 1
End Sub

Function ParseForTakeNext(p As *Parser, name As *Byte) As boolean
    Dim kNext(KW_SHORT_LEN - 1) As Byte
    lstrcpy(VarPtr(kNext), "next")
    ParseForTakeNext = false
    If ParseIdentIs(p, VarPtr(kNext)) = 0 Then p->err = 1
    If p->err <> 0 Then Exit Function
    p->pos = p->pos + 1
    ParseForNextName(p, name)
    ParseForTakeNext = true
End Function

Sub ParseForFill(nodes As *AstNode, nFor As Long, nVar As Long, fromE As Long, toE As Long, stepE As Long, body As Long)
    nodes[nFor].left = nVar
    nodes[nFor].right = fromE
    nodes[nFor].extra = toE
    nodes[nFor].num = body
    nodes[nFor].strId = stepE
End Sub

Function ParseForLink(ast As *Ast, nVar As Long, name As *Byte, fromE As Long, toE As Long, stepE As Long, body As Long) As Long
    Dim nodes As *AstNode
    Dim nFor As Long
    AstSetStr(ast, nVar, name)
    nFor = AstAddNode(ast, AST_FOR)
    ParseForLink = nFor
    If nFor < 0 Then Exit Function
    nodes = ast->nodes
    ParseForFill(nodes, nFor, nVar, fromE, toE, stepE, body)
End Function

Function ParseForNode(p As *Parser, name As *Byte, fromE As Long, toE As Long, stepE As Long, body As Long) As Long
    Dim ast As *Ast
    Dim nVar As Long
    ParseForNode = -1
    ast = p->ast
    nVar = AstAddNode(ast, AST_VAR)
    If nVar < 0 Then Exit Function
    ParseForNode = ParseForLink(ast, nVar, name, fromE, toE, stepE, body)
End Function

Function ParseForAfter(p As *Parser, name As *Byte, fromE As Long, toE As Long, stepE As Long) As Long
    Dim body As Long
    ParseForAfter = -1
    body = ParseForBody(p)
    If p->err <> 0 Then Exit Function
    If Not ParseForTakeNext(p, name) Then Exit Function
    ParseForAfter = ParseForNode(p, name, fromE, toE, stepE, body)
End Function

Function ParseForStmt(p As *Parser) As Long
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim fromE As Long
    Dim toE As Long
    Dim stepE As Long
    ParseForStmt = -1
    If Not ParseForHeader(p, p->ast, VarPtr(name), fromE, toE, stepE) Then Exit Function
    ParseForStmt = ParseForAfter(p, VarPtr(name), fromE, toE, stepE)
End Function

Function ParseWithStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nWith As Long
    Dim expr As Long
    Dim body As Long
    Dim kEnd(KW_SHORT_LEN - 1) As Byte
    Dim kWith(KW_SHORT_LEN - 1) As Byte
    Dim saveBase As Long

    ParseWithStmt = -1
    p->pos = p->pos + 1
    expr = ParseExpr(p)
    If expr < 0 Then Exit Function
    saveBase = p->withExprIdx
    p->withExprIdx = expr
    lstrcpy(VarPtr(kWith), "with")
    body = ParseStmtListUntilEndPair(p, VarPtr(kWith))
    p->withExprIdx = saveBase
    If p->err <> 0 Then Exit Function
    lstrcpy(VarPtr(kEnd), "end")
    If ParseIdentIs(p, VarPtr(kEnd)) = 0 Then
        p->err = 1
        Exit Function
    End If
    p->pos = p->pos + 1
    If ParseIdentIs(p, VarPtr(kWith)) = 0 Then
        p->err = 1
        Exit Function
    End If
    p->pos = p->pos + 1
    ast = p->ast
    nWith = AstAddNode(ast, AST_WITH)
    If nWith < 0 Then Exit Function
    nodes = ast->nodes
    nodes[nWith].left = expr
    nodes[nWith].right = body
    ParseWithStmt = nWith
End Function

Function ParseFuncMakeNode(ast As *Ast, name As *Byte, nFirst As Long, body As Long, nParams As Long, retTy As Long) As Long
    Dim nodes As *AstNode
    Dim nFunc As Long

    ParseFuncMakeNode = -1
    nFunc = AstAddNode(ast, AST_FUNC)
    If nFunc < 0 Then Exit Function
    AstSetStr(ast, nFunc, name)
    nodes = ast->nodes
    nodes[nFunc].left = nFirst
    nodes[nFunc].right = body
    nodes[nFunc].num = nParams
    nodes[nFunc].extra = retTy
    ParseFuncMakeNode = nFunc
End Function

Function ParseFuncStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim nFirst As Long
    Dim body As Long
    Dim kAs(KW_SHORT_LEN - 1) As Byte
    Dim kEnd(KW_SHORT_LEN - 1) As Byte
    Dim kFun(KW_LEN - 1) As Byte
    Dim empty(1) As Byte
    Dim nParams As Long
    Dim retTy As Long
    Dim exp As Long

    ParseFuncStmt = -1
    exp = ParseBeginProc(p, VarPtr(name))
    If exp < 0 Then Exit Function
    If Not ParseExpect(p, TK_LPAREN) Then Exit Function
    ast = p->ast
    If Not ParseParamList(p, nFirst, nParams, 1, 1) Then Exit Function
    lstrcpy(VarPtr(kAs), "as")
    If ParseIdentIs(p, VarPtr(kAs)) = 0 Then
        p->err = 1
        Exit Function
    End If
    p->pos = p->pos + 1
    If ParseFuncRetType(p, retTy) = 0 Then Exit Function
    empty[0] = 0
    lstrcpy(VarPtr(kEnd), "end")
    lstrcpy(VarPtr(kFun), "function")
    body = ParseStmtListUntilEndPair(p, VarPtr(kFun))
    If p->err <> 0 Then Exit Function
    If ParseIdentIs(p, VarPtr(kEnd)) = 0 Then
        p->err = 1
        Exit Function
    End If
    p->pos = p->pos + 1
    If ParseIdentIs(p, VarPtr(kFun)) = 0 Then
        p->err = 1
        Exit Function
    End If
    p->pos = p->pos + 1
    ParseFuncStmt = ParseApplyExport(ast, ParseFuncMakeNode(ast, VarPtr(name), nFirst, body, nParams, retTy), exp)
End Function

Function ParseEatExport(p As *Parser) As Long
    Dim kw(KW_LEN - 1) As Byte
    ParseEatExport = 0
    lstrcpy(VarPtr(kw), "export")
    If ParseIdentIs(p, VarPtr(kw)) = 0 Then Exit Function
    If ParseTokKindAt(p, p->pos + 1) <> TK_IDENT Then Exit Function
    p->pos = p->pos + 1
    ParseEatExport = 1
End Function

Function ParseBeginProc(p As *Parser, name As *Byte) As Long
    Dim exp As Long
    ParseBeginProc = -1
    p->pos = p->pos + 1
    exp = ParseEatExport(p)
    If Not ParseCopyIdent(p, name) Then Exit Function
    ParseBeginProc = exp
End Function

Function ParseApplyExport(ast As *Ast, nFunc As Long, exp As Long) As Long
    Dim nodes As *AstNode
    ParseApplyExport = nFunc
    If nFunc < 0 Or exp = 0 Then Exit Function
    nodes = ast->nodes
    nodes[nFunc].num = nodes[nFunc].num Or AST_FUNC_EXPORT
End Function
