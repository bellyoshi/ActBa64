' --- split from ParserCtrl.abp (part 2) ---
Function ParseParamType(p As *Parser, ByRef pty As Long, ByRef pti As Long, ByRef isByRef As Long, allowDblStar As Long, allowDouble As Long) As Long
    Dim k(15) As Byte
    Dim typeName(63) As Byte
    Dim types As *TypeTable
    Dim ast As *Ast

    ParseParamType = 0
    ast = p->ast
    types = ast->types
    pty = TY_LONG
    pti = -1
    lstrcpy(VarPtr(k), "byte")
    If ParseTokKind(p) = TK_STAR Then
        p->pos = p->pos + 1
        If allowDblStar <> 0 Then
            If ParseTokKind(p) = TK_STAR Then
                p->pos = p->pos + 1
                isByRef = 1
            End If
        End If
        If ParseIdentIs(p, VarPtr(k)) <> 0 Then
            p->pos = p->pos + 1
            pty = TY_PTR_BYTE
            ParseParamType = 1
            Exit Function
        End If
        If ParseCopyIdent(p, VarPtr(typeName)) = 0 Then Exit Function
        pti = TyFind(types, VarPtr(typeName))
        If pti < 0 Then
            p->err = 1
            Exit Function
        End If
        pty = TY_PTR_UDT
        ParseParamType = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "long")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p->pos = p->pos + 1
        pty = TY_LONG
        ParseParamType = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "string")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p->pos = p->pos + 1
        pty = TY_STRING
        ParseParamType = 1
        Exit Function
    End If
    If allowDouble <> 0 Then
        lstrcpy(VarPtr(typeName), "double")
        If ParseIdentIs(p, VarPtr(typeName)) <> 0 Then
            p->pos = p->pos + 1
            pty = TY_DOUBLE
            ParseParamType = 1
            Exit Function
        End If
    End If
    If ParseEatBytePtrAlias(p) <> 0 Then
        pty = TY_PTR_BYTE
        ParseParamType = 1
        Exit Function
    End If
    If ParseEatLongAlias(p) <> 0 Then
        pty = TY_LONG
        ParseParamType = 1
        Exit Function
    End If
    If ParseCopyIdent(p, VarPtr(typeName)) = 0 Then
        p->err = 1
        Exit Function
    End If
    pti = TyFind(types, VarPtr(typeName))
    If pti < 0 Then
        p->err = 1
        Exit Function
    End If
    pty = TY_UDT
    ParseParamType = 1
End Function

Function ParseParamList(p As *Parser, ByRef nFirst As Long, ByRef nParams As Long, allowDblStar As Long, allowDouble As Long) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim k(15) As Byte
    Dim pname(63) As Byte
    Dim nParam As Long
    Dim nPrev As Long
    Dim isByRef As Long
    Dim pty As Long
    Dim pti As Long

    ParseParamList = 0
    ast = p->ast
    nFirst = -1
    nPrev = -1
    nParams = 0
    lstrcpy(VarPtr(k), "byref")
    If ParseTokKind(p) <> TK_RPAREN Then
        Do
            isByRef = 0
            If ParseIdentIs(p, VarPtr(k)) <> 0 Then
                p->pos = p->pos + 1
                isByRef = 1
            Else
                lstrcpy(VarPtr(k), "byval")
                If ParseIdentIs(p, VarPtr(k)) <> 0 Then
                    p->pos = p->pos + 1
                End If
            End If
            If ParseCopyIdent(p, VarPtr(pname)) = 0 Then Exit Function
            lstrcpy(VarPtr(k), "as")
            If ParseIdentIs(p, VarPtr(k)) = 0 Then
                p->err = 1
                Exit Function
            End If
            p->pos = p->pos + 1
            If ParseParamType(p, pty, pti, isByRef, allowDblStar, allowDouble) = 0 Then Exit Function
            nParam = AstAddNode(ast, AST_VAR)
            If nParam < 0 Then Exit Function
            AstSetStr(ast, nParam, VarPtr(pname))
            nodes = ast->nodes
            nodes[nParam].num = isByRef
            nodes[nParam].extra = pty
            nodes[nParam].right = pti
            If nFirst < 0 Then
                nFirst = nParam
            Else
                nodes[nPrev].nxt = nParam
            End If
            nPrev = nParam
            nParams = nParams + 1
            If ParseTokKind(p) <> TK_COMMA Then Exit Do
            p->pos = p->pos + 1
            lstrcpy(VarPtr(k), "byref")
        Loop
    End If
    If ParseExpect(p, TK_RPAREN) = 0 Then Exit Function
    ParseParamList = 1
End Function

Function ParseFuncRetType(p As *Parser, ByRef retTy As Long) As Long
    Dim k(15) As Byte
    Dim typeName(63) As Byte
    Dim pti As Long
    Dim types As *TypeTable
    Dim ast As *Ast

    ParseFuncRetType = 0
    ast = p->ast
    types = ast->types
    retTy = TY_LONG
    lstrcpy(VarPtr(k), "long")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p->pos = p->pos + 1
        retTy = TY_LONG
        ParseFuncRetType = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "string")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p->pos = p->pos + 1
        retTy = TY_STRING
        ParseFuncRetType = 1
        Exit Function
    End If
    If ParseTokKind(p) = TK_STAR Then
        p->pos = p->pos + 1
        lstrcpy(VarPtr(k), "byte")
        If ParseIdentIs(p, VarPtr(k)) <> 0 Then
            p->pos = p->pos + 1
            retTy = TY_PTR_BYTE
            ParseFuncRetType = 1
            Exit Function
        End If
        If ParseCopyIdent(p, VarPtr(typeName)) = 0 Then Exit Function
        pti = TyFind(types, VarPtr(typeName))
        If pti < 0 Then
            p->err = 1
            Exit Function
        End If
        retTy = TY_PTR_UDT
        ParseFuncRetType = 1
        Exit Function
    End If
    lstrcpy(VarPtr(typeName), "double")
    If ParseIdentIs(p, VarPtr(typeName)) <> 0 Then
        p->pos = p->pos + 1
        retTy = TY_DOUBLE
        ParseFuncRetType = 1
        Exit Function
    End If
    If ParseEatBytePtrAlias(p) <> 0 Then
        retTy = TY_PTR_BYTE
        ParseFuncRetType = 1
        Exit Function
    End If
    If ParseEatLongAlias(p) <> 0 Then
        retTy = TY_LONG
        ParseFuncRetType = 1
        Exit Function
    End If
    p->err = 1
End Function

Function ParseSubStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nFunc As Long
    Dim name(63) As Byte
    Dim nFirst As Long
    Dim body As Long
    Dim kEnd(7) As Byte
    Dim kSub(7) As Byte
    Dim empty(1) As Byte
    Dim nParams As Long

    ParseSubStmt = -1
    p->pos = p->pos + 1
    If ParseCopyIdent(p, VarPtr(name)) = 0 Then Exit Function
    If ParseExpect(p, TK_LPAREN) = 0 Then Exit Function
    ast = p->ast
    If ParseParamList(p, nFirst, nParams, 0, 1) = 0 Then Exit Function
    empty[0] = 0
    lstrcpy(VarPtr(kEnd), "end")
    lstrcpy(VarPtr(kSub), "sub")
    body = ParseStmtListUntilEndPair(p, VarPtr(kSub))
    If p->err <> 0 Then Exit Function
    If ParseIdentIs(p, VarPtr(kEnd)) = 0 Then
        p->err = 1
        Exit Function
    End If
    p->pos = p->pos + 1
    If ParseIdentIs(p, VarPtr(kSub)) = 0 Then
        p->err = 1
        Exit Function
    End If
    p->pos = p->pos + 1
    nFunc = AstAddNode(ast, AST_FUNC)
    If nFunc < 0 Then Exit Function
    AstSetStr(ast, nFunc, VarPtr(name))
    nodes = ast->nodes
    nodes[nFunc].left = nFirst
    nodes[nFunc].right = body
    nodes[nFunc].num = nParams Or 256
    ParseSubStmt = nFunc
End Function

Function ParseWhileStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nWhile As Long
    Dim cond As Long
    Dim body As Long
    Dim kWend(7) As Byte
    Dim empty(1) As Byte

    ParseWhileStmt = -1
    p->pos = p->pos + 1
    cond = ParseCond(p)
    If cond < 0 Then Exit Function
    empty[0] = 0
    lstrcpy(VarPtr(kWend), "wend")
    body = ParseStmtListUntil(p, VarPtr(kWend), VarPtr(empty))
    If p->err <> 0 Then Exit Function
    If ParseIdentIs(p, VarPtr(kWend)) = 0 Then
        p->err = 1
        Exit Function
    End If
    p->pos = p->pos + 1

    ast = p->ast
    nWhile = AstAddNode(ast, AST_WHILE)
    If nWhile < 0 Then Exit Function
    nodes = ast->nodes
    nodes[nWhile].left = cond
    nodes[nWhile].right = body
    ParseWhileStmt = nWhile
End Function

Function ParseForStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nFor As Long
    Dim name(63) As Byte
    Dim nVar As Long
    Dim fromE As Long
    Dim toE As Long
    Dim stepE As Long
    Dim body As Long
    Dim kTo(7) As Byte
    Dim kStep(7) As Byte
    Dim kNext(7) As Byte
    Dim empty(1) As Byte

    ParseForStmt = -1
    p->pos = p->pos + 1
    If ParseCopyIdent(p, VarPtr(name)) = 0 Then Exit Function
    If ParseExpect(p, TK_EQ) = 0 Then Exit Function
    fromE = ParseExpr(p)
    If fromE < 0 Then Exit Function
    lstrcpy(VarPtr(kTo), "to")
    If ParseIdentIs(p, VarPtr(kTo)) = 0 Then
        p->err = 1
        Exit Function
    End If
    p->pos = p->pos + 1
    toE = ParseExpr(p)
    If toE < 0 Then Exit Function
    ast = p->ast
    stepE = ParseMakeNum(ast, 1)
    If stepE < 0 Then Exit Function
    lstrcpy(VarPtr(kStep), "step")
    If ParseIdentIs(p, VarPtr(kStep)) <> 0 Then
        p->pos = p->pos + 1
        stepE = ParseExpr(p)
        If stepE < 0 Then Exit Function
    End If

    empty[0] = 0
    lstrcpy(VarPtr(kNext), "next")
    body = ParseStmtListUntil(p, VarPtr(kNext), VarPtr(empty))
    If p->err <> 0 Then Exit Function
    If ParseIdentIs(p, VarPtr(kNext)) = 0 Then
        p->err = 1
        Exit Function
    End If
    p->pos = p->pos + 1

    nVar = AstAddNode(ast, AST_VAR)
    If nVar < 0 Then Exit Function
    AstSetStr(ast, nVar, VarPtr(name))
    nFor = AstAddNode(ast, AST_FOR)
    If nFor < 0 Then Exit Function
    nodes = ast->nodes
    nodes[nFor].left = nVar
    nodes[nFor].right = fromE
    nodes[nFor].extra = toE
    nodes[nFor].num = body
    nodes[nFor].strId = stepE
    ParseForStmt = nFor
End Function

Function ParseWithStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nWith As Long
    Dim expr As Long
    Dim body As Long
    Dim kEnd(7) As Byte
    Dim kWith(7) As Byte
    Dim saveBase As Long

    ParseWithStmt = -1
    p->pos = p->pos + 1
    expr = ParseExpr(p)
    If expr < 0 Then Exit Function
    saveBase = p->withBase
    p->withBase = expr
    lstrcpy(VarPtr(kWith), "with")
    body = ParseStmtListUntilEndPair(p, VarPtr(kWith))
    p->withBase = saveBase
    If p->err <> 0 Then Exit Function
    lstrcpy(VarPtr(kEnd), "end")
    If ParseIdentIs(p, VarPtr(kEnd)) = 0 Then
        p->err = 1
        Exit Function
    End If
    p->pos = p->pos + 1
    If ParseIdentIs(p, VarPtr(kWith)) = 0 Then
        p->err = 1
        Exit Function
    End If
    p->pos = p->pos + 1
    ast = p->ast
    nWith = AstAddNode(ast, AST_WITH)
    If nWith < 0 Then Exit Function
    nodes = ast->nodes
    nodes[nWith].left = expr
    nodes[nWith].right = body
    ParseWithStmt = nWith
End Function
