' ===================================================
'  DbgInfoVar - .abdbg の変数（ローカル・仮引数・グローバル）を写しておく
' ===================================================

Sub DbgVarGrowL(nc As Long)
    g_dbgVarFn = DbgGrowL(g_dbgVarFn, g_dbgVarCap, nc)
    g_dbgVarOff = DbgGrowL(g_dbgVarOff, g_dbgVarCap, nc)
    g_dbgVarRef = DbgGrowL(g_dbgVarRef, g_dbgVarCap, nc)
    g_dbgVarKind = DbgGrowL(g_dbgVarKind, g_dbgVarCap, nc)
    g_dbgVarTi = DbgGrowL(g_dbgVarTi, g_dbgVarCap, nc)
    g_dbgVarSize = DbgGrowL(g_dbgVarSize, g_dbgVarCap, nc)
    g_dbgVarLine = DbgGrowL(g_dbgVarLine, g_dbgVarCap, nc)
End Sub

Function DbgVarOk() As boolean
    DbgVarOk = false
    If g_dbgVarName = NULL Or g_dbgVarType = NULL Or g_dbgVarFn = NULL Then Exit Function
    If g_dbgVarOff = NULL Or g_dbgVarRef = NULL Or g_dbgVarSize = NULL Then Exit Function
    If g_dbgVarKind = NULL Or g_dbgVarTi = NULL Or g_dbgVarLine = NULL Then Exit Function
    DbgVarOk = true
End Function

Function DbgVarGrow(nc As Long) As boolean
    g_dbgVarName = DbgGrowB(g_dbgVarName, g_dbgVarCap, nc, SYM_NAME_LEN)
    g_dbgVarType = DbgGrowB(g_dbgVarType, g_dbgVarCap, nc, SYM_NAME_LEN)
    DbgVarGrowL(nc)
    DbgVarGrow = DbgVarOk()
    If DbgVarGrow Then g_dbgVarCap = nc
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function DbgVarReserve() As boolean
    DbgVarReserve = true
    If g_dbgVarN < g_dbgVarCap Then Exit Function
    DbgVarReserve = DbgVarGrow(DbgNextCap(g_dbgVarCap))
End Function

Sub DbgSetVarNums(v As Long, fid As Long, off As Long, isRef As Long, kind As Long, ti As Long)
    g_dbgVarFn[v] = fid
    g_dbgVarOff[v] = off
    g_dbgVarRef[v] = isRef
    g_dbgVarKind[v] = kind
    g_dbgVarTi[v] = ti
End Sub

' fid = -1 はグローバル（off は .data の先頭から）。ほかは手続きの [rbp+off]。
' udt は Type / Class の名前（無ければ NULL）。型の名前は書くときに kind から作る（String を作らない）
' fid = -1 はグローバル（off は .data の先頭から）。ほかは手続きの [rbp+off]。
' udt は Type / Class の名前（無ければ NULL）。型の名前は書くときに kind から作る（String を作らない）
Sub DbgPutVar(fid As Long, name As *Byte, off As Long, isRef As Long, kind As Long, ti As Long, udt As *Byte)
    If Not DbgVarReserve() Then
        g_dbgBad = 1
        Exit Sub
    End If
    DbgCopyName(g_dbgVarName, g_dbgVarN, name)
    DbgPutUdt(g_dbgVarN, udt)
    DbgSetVarNums(g_dbgVarN, fid, off, isRef, kind, ti)
    g_dbgVarN = g_dbgVarN + 1
End Sub

' 足したばかりの変数の大きさ（バイト）と宣言した行
Sub DbgSetVarSize(sz As Long, srcLine As Long)
    If g_dbgBad <> 0 Or g_dbgVarN <= 0 Then Exit Sub
    g_dbgVarSize[g_dbgVarN - 1] = sz
    g_dbgVarLine[g_dbgVarN - 1] = srcLine
End Sub

Sub DbgPutUdt(v As Long, udt As *Byte)
    If udt = NULL Then
        g_dbgVarType[BytesN(v, SYM_NAME_LEN)] = 0
    Else
        DbgCopyName(g_dbgVarType, v, udt)
    End If
End Sub

' TY_UDT / TY_PTR_UDT / TY_UDT_ARR の型表の名前。ほかの型や番号の外は NULL
Function DbgUdtPtr(ctx As *LowerCtx, kind As Long, ti As Long) As *Byte
    Dim a As *Ast
    Dim t As *TypeTable
    Dim names As *Byte
    DbgUdtPtr = NULL
    If kind <> TY_UDT And kind <> TY_PTR_UDT And kind <> TY_UDT_ARR Then Exit Function
    ' ctx->ast->types と続けて書くと v0.1.1（CI のブートストラップ）が codegen で落ちる
    a = ctx->ast
    t = a->types
    If t = NULL Or ti < 0 Or ti >= t->nTypes Then Exit Function
    names = t->typeNames
    DbgUdtPtr = VarPtr(names[BytesN(ti, TYNAME_LEN)])
End Function

Sub DbgAddLocal(ctx As *LowerCtx, i As Long)
    Dim kind As Long
    Dim ti As Long
    Dim names As *Byte
    kind = ctx->types[i]
    ti = ctx->typeIdxs[i]
    names = ctx->names
    DbgPutVar(g_dbgCurFn, VarPtr(names[BytesN(i, SYM_NAME_LEN)]), ctx->offs[i], ctx->byRefs[i], kind, ti, DbgUdtPtr(ctx, kind, ti))
    DbgSetVarSize(DbgSymBytes(i), DbgTblAt(g_dbgSymLine, g_dbgSymLineCap, i))
End Sub

' ローカル変数 i のバイト数（LowNoteSymBytes が記録したもの）
Function DbgSymBytes(i As Long) As Long
    DbgSymBytes = 8
    If i < g_symNbCap Then DbgSymBytes = g_symNb[i]
End Function

Function DbgGlobBytes(i As Long) As Long
    DbgGlobBytes = 8
    If i < g_globRawNbCap Then DbgGlobBytes = g_globRawNb[i]
End Function

' 伸びる表の i 番目（無ければ 0）
Function DbgTblAt(tbl As *Long, cap As Long, i As Long) As Long
    DbgTblAt = 0
    If tbl <> NULL And i >= 0 And i < cap Then DbgTblAt = tbl[i]
End Function

' g_globOffs などの *Byte の表の i 番目の Long
Function DbgLongAt(tbl As *Byte, i As Long) As Long
    Dim p As *Long
    p = tbl As *Long
    DbgLongAt = p[i]
End Function

Sub DbgAddGlobal(ctx As *LowerCtx, i As Long)
    Dim kind As Long
    Dim ti As Long
    kind = DbgLongAt(g_globTypes, i)
    ti = DbgLongAt(g_globTypeIdxs, i)
    DbgPutVar(-1, VarPtr(g_globNames[BytesN(i, SYM_NAME_LEN)]), DbgLongAt(g_globOffs, i), 0, kind, ti, DbgUdtPtr(ctx, kind, ti))
    DbgSetVarSize(DbgGlobBytes(i), DbgTblAt(g_dbgGlobLine, g_dbgGlobLineCap, i))
End Sub

' AstToIr の終わり（大域の表を捨てる前）で呼ぶ
Sub DbgAddGlobals(ctx As *LowerCtx)
    Dim i As Long
    Dim a As *Ast
    If DbgActive() = 0 Then Exit Sub
    a = ctx->ast
    DbgSetTypes(a->types)
    For i = 0 To g_globCount - 1
        DbgAddGlobal(ctx, i)
    Next
End Sub

' ---- 宣言した行（LowRegisterDimNode から。si は記号 / 大域の番号） ----

' Dim a, b, c の 2 つ目からは行が 0 なので、前の行を使う
Sub DbgNoteVarLine(si As Long, asGlob As Long, srcLine As Long)
    If DbgActive() = 0 Or si < 0 Then Exit Sub
    If srcLine > 0 Then g_dbgLastDimLine = srcLine
    If asGlob <> 0 Then
        DbgNoteGlobLine(si, g_dbgLastDimLine)
    Else
        DbgNoteSymLine(si, g_dbgLastDimLine)
    End If
End Sub

Sub DbgNoteGlobLine(si As Long, srcLine As Long)
    Dim nc As Long
    If si >= g_dbgGlobLineCap Then
        nc = DbgCapFor(g_dbgGlobLineCap, si)
        g_dbgGlobLine = DbgGrowL(g_dbgGlobLine, g_dbgGlobLineCap, nc)
        g_dbgGlobLineCap = nc
    End If
    If g_dbgGlobLine <> NULL Then g_dbgGlobLine[si] = srcLine
End Sub

Sub DbgNoteSymLine(si As Long, srcLine As Long)
    Dim nc As Long
    If si >= g_dbgSymLineCap Then
        nc = DbgCapFor(g_dbgSymLineCap, si)
        g_dbgSymLine = DbgGrowL(g_dbgSymLine, g_dbgSymLineCap, nc)
        g_dbgSymLineCap = nc
    End If
    If g_dbgSymLine <> NULL Then g_dbgSymLine[si] = srcLine
End Sub

' 手続きの変数を写した後（次の手続きの仮引数などに前の行が残らないよう）
Sub DbgClearSymLines()
    Dim i As Long
    For i = 0 To g_dbgSymLineCap - 1
        g_dbgSymLine[i] = 0
    Next
End Sub
