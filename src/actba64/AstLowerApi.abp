' ===================================================
'  AstLowerApi - API map / call emit / consts
' ===================================================

Function LowMapKernelApiFile(name As *Byte, apiOut As *Byte) As Long
    Dim kw(31) As Byte

    LowMapKernelApiFile = 0
    lstrcpy(VarPtr(kw), "createfile")
    If LowKernelApiMatch2(name, VarPtr(kw), "createfilea", "CreateFileA", apiOut) <> 0 Then
        LowMapKernelApiFile = 1
        Exit Function
    End If
    lstrcpy(VarPtr(kw), "closehandle")
    If LowKernelApiMatch(name, VarPtr(kw), "CloseHandle", apiOut) <> 0 Then
        LowMapKernelApiFile = 1
        Exit Function
    End If
    lstrcpy(VarPtr(kw), "getfilesize")
    If LowKernelApiMatch(name, VarPtr(kw), "GetFileSize", apiOut) <> 0 Then
        LowMapKernelApiFile = 1
        Exit Function
    End If
    lstrcpy(VarPtr(kw), "readfile")
    If LowKernelApiMatch(name, VarPtr(kw), "ReadFile", apiOut) <> 0 Then
        LowMapKernelApiFile = 1
        Exit Function
    End If
    lstrcpy(VarPtr(kw), "writefile")
    If LowKernelApiMatch(name, VarPtr(kw), "WriteFile", apiOut) <> 0 Then
        LowMapKernelApiFile = 1
        Exit Function
    End If
    lstrcpy(VarPtr(kw), "getfileattributes")
    If LowKernelApiMatch2(name, VarPtr(kw), "getfileattributesa", "GetFileAttributesA", apiOut) <> 0 Then
        LowMapKernelApiFile = 1
        Exit Function
    End If
    lstrcpy(VarPtr(kw), "getcommandline")
    If LowKernelApiMatch2(name, VarPtr(kw), "getcommandlinea", "GetCommandLineA", apiOut) <> 0 Then
        LowMapKernelApiFile = 1
        Exit Function
    End If
End Function

Function LowMapKernelApiStr(name As *Byte, apiOut As *Byte) As Long
    Dim kw(31) As Byte

    LowMapKernelApiStr = 0
    lstrcpy(VarPtr(kw), "lstrlen")
    If LowKernelApiMatch2(name, VarPtr(kw), "lstrlena", "lstrlenA", apiOut) <> 0 Then
        LowMapKernelApiStr = 1
        Exit Function
    End If
    lstrcpy(VarPtr(kw), "lstrcpy")
    If LowKernelApiMatch2(name, VarPtr(kw), "lstrcpya", "lstrcpyA", apiOut) <> 0 Then
        LowMapKernelApiStr = 1
        Exit Function
    End If
    lstrcpy(VarPtr(kw), "lstrcat")
    If LowKernelApiMatch2(name, VarPtr(kw), "lstrcata", "lstrcatA", apiOut) <> 0 Then
        LowMapKernelApiStr = 1
        Exit Function
    End If
End Function

Function LowMapKernelApiHeap(name As *Byte, apiOut As *Byte) As Long
    Dim kw(31) As Byte

    LowMapKernelApiHeap = 0
    lstrcpy(VarPtr(kw), "getprocessheap")
    If LowKernelApiMatch(name, VarPtr(kw), "GetProcessHeap", apiOut) <> 0 Then
        LowMapKernelApiHeap = 1
        Exit Function
    End If
    lstrcpy(VarPtr(kw), "heapalloc")
    If LowKernelApiMatch(name, VarPtr(kw), "HeapAlloc", apiOut) <> 0 Then
        LowMapKernelApiHeap = 1
        Exit Function
    End If
    lstrcpy(VarPtr(kw), "heapfree")
    If LowKernelApiMatch(name, VarPtr(kw), "HeapFree", apiOut) <> 0 Then
        LowMapKernelApiHeap = 1
        Exit Function
    End If
    lstrcpy(VarPtr(kw), "getstdhandle")
    If LowKernelApiMatch(name, VarPtr(kw), "GetStdHandle", apiOut) <> 0 Then
        LowMapKernelApiHeap = 1
        Exit Function
    End If
End Function

Function LowMapKernelApi(name As *Byte, apiOut As *Byte) As Long
    LowMapKernelApi = 0
    If LowMapKernelApiFile(name, apiOut) <> 0 Then
        LowMapKernelApi = 1
        Exit Function
    End If
    If LowMapKernelApiStr(name, apiOut) <> 0 Then
        LowMapKernelApi = 1
        Exit Function
    End If
    If LowMapKernelApiHeap(name, apiOut) <> 0 Then
        LowMapKernelApi = 1
    End If
End Function

Function LowFindFunc(ctx As *LowerCtx, name As *Byte) As Long
    Dim i As Long
    Dim names As *Byte
    Dim labs As *Long
    Dim off As Long
    LowFindFunc = -1
    names = ctx->funcNames
    labs = ctx->funcLabs
    i = 0
    While i < ctx->funcCount
        off = i * SYM_NAME_LEN
        If LowNameEqExact(VarPtr(names[off]), name) <> 0 Then
            LowFindFunc = labs[i]
            Exit Function
        End If
        i = i + 1
    Wend
End Function

' AST_FUNC.extra に Parser が書いた戻り型
Function LowFindFuncRetTy(ctx As *LowerCtx, name As *Byte) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim stmt As Long
    Dim nm(63) As Byte
    Dim ty As Long

    LowFindFuncRetTy = TY_LONG
    If ctx = NULL Then Exit Function
    ast = ctx->ast
    If ast = NULL Then Exit Function
    If ast->root < 0 Then Exit Function
    nodes = ast->nodes
    stmt = nodes[ast->root].left
    While stmt >= 0
        If nodes[stmt].kind = AST_FUNC Then
            AstCopyStr(ast, stmt, VarPtr(nm))
            If LowNameEqExact(VarPtr(nm), name) <> 0 Then
                ty = nodes[stmt].extra
                If ty = TY_DOUBLE Or ty = TY_SINGLE Or ty = TY_STRING Then
                    LowFindFuncRetTy = ty
                ElseIf ty = TY_PTR_BYTE Or ty = TY_PTR_LONG Or ty = TY_PTR_UDT Then
                    LowFindFuncRetTy = ty
                Else
                    LowFindFuncRetTy = TY_LONG
                End If
                Exit Function
            End If
        End If
        stmt = nodes[stmt].nxt
    Wend
End Function

' 仮引数 argIndex の型（見つからなければ TY_LONG）
Function LowFindFuncParamTy(ctx As *LowerCtx, name As *Byte, argIndex As Long) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim stmt As Long
    Dim param As Long
    Dim nm(63) As Byte
    Dim i As Long
    Dim ty As Long

    LowFindFuncParamTy = TY_LONG
    If ctx = NULL Then Exit Function
    If argIndex < 0 Then Exit Function
    ast = ctx->ast
    If ast = NULL Then Exit Function
    If ast->root < 0 Then Exit Function
    nodes = ast->nodes
    stmt = nodes[ast->root].left
    While stmt >= 0
        If nodes[stmt].kind = AST_FUNC Then
            AstCopyStr(ast, stmt, VarPtr(nm))
            If LowNameEqExact(VarPtr(nm), name) <> 0 Then
                param = nodes[stmt].left
                i = 0
                While param >= 0
                    If i = argIndex Then
                        ty = nodes[param].extra
                        If ty < 0 Then ty = TY_LONG
                        LowFindFuncParamTy = ty
                        Exit Function
                    End If
                    i = i + 1
                    param = nodes[param].nxt
                Wend
                Exit Function
            End If
        End If
        stmt = nodes[stmt].nxt
    Wend
End Function

Function LowFindFuncByRefs(ctx As *LowerCtx, name As *Byte) As Long
    Dim i As Long
    Dim names As *Byte
    Dim bys As *Long
    Dim off As Long
    LowFindFuncByRefs = 0
    names = ctx->funcNames
    bys = ctx->funcByRefs
    i = 0
    While i < ctx->funcCount
        off = i * SYM_NAME_LEN
        If LowNameEqExact(VarPtr(names[off]), name) <> 0 Then
            LowFindFuncByRefs = bys[i]
            Exit Function
        End If
        i = i + 1
    Wend
End Function

Function LowAddFunc(ctx As *LowerCtx, name As *Byte, lab As Long, byRefBits As Long) As Long
    Dim i As Long
    Dim names As *Byte
    Dim labs As *Long
    Dim bys As *Long
    Dim j As Long
    Dim off As Long

    LowAddFunc = 0
    If LowEnsureFuncCap(ctx) = 0 Then
        Print "error: out of memory (functions)"
        ctx->err = 1
        Exit Function
    End If
    i = ctx->funcCount
    names = ctx->funcNames
    labs = ctx->funcLabs
    bys = ctx->funcByRefs
    off = i * SYM_NAME_LEN
    j = 0
    While name[j] <> 0 And j < SYM_NAME_LEN - 1
        names[off + j] = name[j]
        j = j + 1
    Wend
    names[off + j] = 0
    labs[i] = lab
    bys[i] = byRefBits
    ctx->funcCount = i + 1
    LowAddFunc = 1
End Function

' ---- Declare Lib テーブル ----

Function LowFindDecl(ctx As *LowerCtx, name As *Byte) As Long
    Dim i As Long
    Dim names As *Byte
    Dim off As Long
    LowFindDecl = -1
    names = ctx->declNames
    i = 0
    While i < ctx->declCount
        off = i * SYM_NAME_LEN
        If LowNameEqExact(VarPtr(names[off]), name) <> 0 Then
            LowFindDecl = i
            Exit Function
        End If
        i = i + 1
    Wend
End Function

Function LowAddDecl(ctx As *LowerCtx, name As *Byte, api As *Byte, dllKind As Long, byRefBits As Long) As Long
    Dim i As Long
    Dim names As *Byte
    Dim apis As *Byte
    Dim dlls As *Long
    Dim bys As *Long
    Dim j As Long
    Dim off As Long

    LowAddDecl = 0
    If LowEnsureDeclCap(ctx) = 0 Then
        Print "error: out of memory (Declare)"
        ctx->err = 1
        Exit Function
    End If
    i = ctx->declCount
    names = ctx->declNames
    apis = ctx->declApiNames
    dlls = ctx->declDlls
    bys = ctx->declByRefs
    off = i * SYM_NAME_LEN
    j = 0
    While name[j] <> 0 And j < SYM_NAME_LEN - 1
        names[off + j] = name[j]
        j = j + 1
    Wend
    names[off + j] = 0
    j = 0
    While api[j] <> 0 And j < SYM_NAME_LEN - 1
        apis[off + j] = api[j]
        j = j + 1
    Wend
    apis[off + j] = 0
    dlls[i] = dllKind
    bys[i] = byRefBits
    ctx->declCount = i + 1
    LowAddDecl = 1
End Function

Sub LowDeclApiName(ctx As *LowerCtx, di As Long, dst As *Byte)
    Dim apis As *Byte
    Dim off As Long
    Dim j As Long
    apis = ctx->declApiNames
    off = di * SYM_NAME_LEN
    j = 0
    While apis[off + j] <> 0 And j < SYM_NAME_LEN - 1
        dst[j] = apis[off + j]
        j = j + 1
    Wend
    dst[j] = 0
End Sub

' actba64 のセルフホスト構文は *Long 仮引数を扱えないため *Byte で受ける
Sub LowFreeDeclBufs(a As *Byte, b As *Byte, c As *Byte, d As *Byte)
    If a <> NULL Then free(a)
    If b <> NULL Then free(b)
    If c <> NULL Then free(c)
    If d <> NULL Then free(d)
End Sub

Sub LowFreePtr(p As *Byte)
    If p <> NULL Then free(p)
End Sub

' AstToIr エラー時のバッファ一括解放（行数削減; 引数は g_free*）
Sub LowFreeAstBufs()
    LowFreePtr(g_freeSymNames)
    LowFreePtr(g_freeSymOffs)
    LowFreePtr(g_freeSymTypes)
    LowFreePtr(g_freeSymTypeIdxs)
    LowFreePtr(g_freeSymByRefs)
    LowFreePtr(g_freeGlobNames)
    LowFreePtr(g_freeGlobOffs)
    LowFreePtr(g_freeGlobTypes)
    LowFreePtr(g_freeGlobTypeIdxs)
    LowFreePtr(g_freeFuncNames)
    LowFreePtr(g_freeFuncLabs)
    LowFreePtr(g_freeFuncByRefs)
    LowFreePtr(g_freeConstNames)
    LowFreePtr(g_freeConstVals)
    LowFreePtr(g_freeConstStrNames)
    LowFreePtr(g_freeConstStrVals)
    LowFreeDeclBufs(g_freeDeclNames, g_freeDeclApiNames, g_freeDeclDlls, g_freeDeclByRefs)
    g_freeSymNames = NULL
    g_freeSymOffs = NULL
    g_freeSymTypes = NULL
    g_freeSymTypeIdxs = NULL
    g_freeSymByRefs = NULL
    g_freeGlobNames = NULL
    g_freeGlobOffs = NULL
    g_freeGlobTypes = NULL
    g_freeGlobTypeIdxs = NULL
    g_freeFuncNames = NULL
    g_freeFuncLabs = NULL
    g_freeFuncByRefs = NULL
    g_freeConstNames = NULL
    g_freeConstVals = NULL
    g_freeConstStrNames = NULL
    g_freeConstStrVals = NULL
    g_freeDeclNames = NULL
    g_freeDeclApiNames = NULL
    g_freeDeclDlls = NULL
    g_freeDeclByRefs = NULL
    g_globNames = NULL
    g_globOffs = NULL
    g_globTypes = NULL
    g_globTypeIdxs = NULL
    If g_preciseRoots <> NULL Then free(g_preciseRoots)
    If g_fnPreciseRoots <> NULL Then free(g_fnPreciseRoots)
    If g_globNbytes <> NULL Then free(g_globNbytes)
    g_preciseRoots = NULL
    g_fnPreciseRoots = NULL
    g_globNbytes = NULL
End Sub
