' ===================================================
'  AstLowerApi - Declare lookup / call emit / consts
' ===================================================

Function LowFindFunc(ctx As *LowerCtx, name As *Byte) As Long
    Dim i As Long
    Dim labs As *Long
    i = NhFind(VarPtr(g_nhFunc(0)), ctx->funcNames, name)
    LowFindFunc = -1
    If i < 0 Then Exit Function
    labs = ctx->funcLabs
    LowFindFunc = labs[i]
End Function

' AST_FUNC.extra に Parser が書いた戻り型
Function LowFindFuncRetTy(ctx As *LowerCtx, name As *Byte) As Long
    Dim i As Long
    Dim rets As *Long
    i = LowFuncIndex(ctx, name)
    LowFindFuncRetTy = TY_LONG
    If i < 0 Then Exit Function
    rets = g_freeFuncRet As *Long
    LowFindFuncRetTy = LowNormRet(rets[i])
End Function

' 仮引数 argIndex の型（見つからなければ TY_LONG）
Function LowFindFuncParamTy(ctx As *LowerCtx, name As *Byte, argIndex As Long) As Long
    Dim i As Long
    LowFindFuncParamTy = TY_LONG
    If argIndex < 0 Or argIndex >= LOW_MAX_ARGS Then Exit Function
    i = LowFuncIndex(ctx, name)
    If i < 0 Then Exit Function
    LowFindFuncParamTy = LowSigTy(g_freeFuncPty As *Long, g_freeFuncNArgs As *Long, i, argIndex)
End Function

Function LowFindFuncByRefs(ctx As *LowerCtx, name As *Byte) As Long
    Dim i As Long
    Dim bys As *Long
    i = NhFind(VarPtr(g_nhFunc(0)), ctx->funcNames, name)
    LowFindFuncByRefs = 0
    If i < 0 Then Exit Function
    bys = ctx->funcByRefs
    LowFindFuncByRefs = bys[i]
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function LowAddFunc(ctx As *LowerCtx, name As *Byte, lab As Long, byRefBits As Long) As boolean
    Dim i As Long
    Dim names As *Byte
    Dim labs As *Long
    Dim bys As *Long
    Dim j As Long
    Dim off As Long

    LowAddFunc = false
    If Not LowEnsureFuncCap(ctx) Then
        Print "error: out of memory (functions)"
        ctx->err = 1
        Exit Function
    End If
    i = ctx->funcCount
    names = ctx->funcNames
    labs = ctx->funcLabs
    bys = ctx->funcByRefs
    off = i * SYM_NAME_LEN
    j = 0
    While name[j] <> 0 And j < SYM_NAME_LEN - 1
        names[off + j] = name[j]
        j = j + 1
    Wend
    names[off + j] = 0
    labs[i] = lab
    bys[i] = byRefBits
    ctx->funcCount = i + 1
    NhPut(VarPtr(g_nhFunc(0)), name, i)
    LowAddFunc = true
End Function

' ---- Declare Lib テーブル ----

Function LowFindDecl(ctx As *LowerCtx, name As *Byte) As Long
    LowFindDecl = NhFind(VarPtr(g_nhDecl(0)), ctx->declNames, name)
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function LowAddDecl(ctx As *LowerCtx, name As *Byte, api As *Byte, dllName As *Byte, byRefBits As Long) As boolean
    Dim i As Long
    Dim names As *Byte
    Dim apis As *Byte
    Dim dlls As *Byte
    Dim bys As *Long
    Dim j As Long
    Dim off As Long

    LowAddDecl = false
    If Not LowEnsureDeclCap(ctx) Then
        Print "error: out of memory (Declare)"
        ctx->err = 1
        Exit Function
    End If
    i = ctx->declCount
    names = ctx->declNames
    apis = ctx->declApiNames
    dlls = ctx->declDllNames
    bys = ctx->declByRefs
    off = i * SYM_NAME_LEN
    j = 0
    While name[j] <> 0 And j < SYM_NAME_LEN - 1
        names[off + j] = name[j]
        j = j + 1
    Wend
    names[off + j] = 0
    j = 0
    While api[j] <> 0 And j < SYM_NAME_LEN - 1
        apis[off + j] = api[j]
        j = j + 1
    Wend
    apis[off + j] = 0
    j = 0
    While dllName[j] <> 0 And j < SYM_NAME_LEN - 1
        dlls[off + j] = dllName[j]
        j = j + 1
    Wend
    dlls[off + j] = 0
    bys[i] = byRefBits
    ctx->declCount = i + 1
    NhPut(VarPtr(g_nhDecl(0)), name, i)
    LowAddDecl = true
End Function

Sub LowDeclApiName(ctx As *LowerCtx, di As Long, dst As *Byte)
    Dim apis As *Byte
    Dim off As Long
    Dim j As Long
    apis = ctx->declApiNames
    off = di * SYM_NAME_LEN
    j = 0
    While apis[off + j] <> 0 And j < SYM_NAME_LEN - 1
        dst[j] = apis[off + j]
        j = j + 1
    Wend
    dst[j] = 0
End Sub

Sub LowDeclDllName(ctx As *LowerCtx, di As Long, dst As *Byte)
    Dim dlls As *Byte
    Dim off As Long
    Dim j As Long
    dlls = ctx->declDllNames
    off = di * SYM_NAME_LEN
    j = 0
    While dlls[off + j] <> 0 And j < SYM_NAME_LEN - 1
        dst[j] = dlls[off + j]
        j = j + 1
    Wend
    dst[j] = 0
End Sub

' actba64 のセルフホスト構文は *Long 仮引数を扱えないため *Byte で受ける
Sub LowFreeDeclBufs(a As *Byte, b As *Byte, c As *Byte, d As *Byte)
    If a <> NULL Then free(a)
    If b <> NULL Then free(b)
    If c <> NULL Then free(c)
    If d <> NULL Then free(d)
End Sub

Sub LowFreePtr(p As *Byte)
    If p <> NULL Then free(p)
End Sub

' AstToIr エラー時のバッファ一括解放（行数削減; 引数は g_free*）
Sub LowFreeAstBufs()
    LowFreePtr(g_freeSymNames)
    LowFreePtr(g_freeSymOffs)
    LowFreePtr(g_freeSymTypes)
    LowFreePtr(g_freeSymTypeIdxs)
    LowFreePtr(g_freeSymByRefs)
    LowFreePtr(g_freeGlobNames)
    LowFreePtr(g_freeGlobOffs)
    LowFreePtr(g_freeGlobTypes)
    LowFreePtr(g_freeGlobTypeIdxs)
    LowFreePtr(g_freeFuncNames)
    LowFreePtr(g_freeFuncLabs)
    LowFreePtr(g_freeFuncByRefs)
    LowFreePtr(g_freeFuncRet)
    LowFreePtr(g_freeFuncPty)
    LowFreePtr(g_freeFuncPti)
    LowFreePtr(g_freeFuncNArgs)
    LowFreePtr(g_freeFuncIsFn)
    LowFreePtr(g_freeDeclPty)
    LowFreePtr(g_freeDeclPti)
    LowFreePtr(g_freeDeclNArgs)
    LowFreePtr(g_freeConstNames)
    LowFreePtr(g_freeConstVals)
    LowFreePtr(g_freeConstStrNames)
    LowFreePtr(g_freeConstStrVals)
    LowFreeDeclBufs(g_freeDeclNames, g_freeDeclApiNames, g_freeDeclDlls, g_freeDeclByRefs)
    g_freeSymNames = NULL
    g_freeSymOffs = NULL
    g_freeSymTypes = NULL
    g_freeSymTypeIdxs = NULL
    g_freeSymByRefs = NULL
    g_freeGlobNames = NULL
    g_freeGlobOffs = NULL
    g_freeGlobTypes = NULL
    g_freeGlobTypeIdxs = NULL
    g_freeFuncNames = NULL
    g_freeFuncLabs = NULL
    g_freeFuncByRefs = NULL
    g_freeFuncRet = NULL
    g_freeFuncPty = NULL
    g_freeFuncPti = NULL
    g_freeFuncNArgs = NULL
    g_freeFuncIsFn = NULL
    g_freeDeclPty = NULL
    g_freeDeclPti = NULL
    g_freeDeclNArgs = NULL
    g_freeConstNames = NULL
    g_freeConstVals = NULL
    g_freeConstStrNames = NULL
    g_freeConstStrVals = NULL
    g_freeDeclNames = NULL
    g_freeDeclApiNames = NULL
    g_freeDeclDlls = NULL
    g_freeDeclByRefs = NULL
    g_globNames = NULL
    g_globOffs = NULL
    g_globTypes = NULL
    g_globTypeIdxs = NULL
    If g_preciseRoots <> NULL Then free(g_preciseRoots)
    If g_fnPreciseRoots <> NULL Then free(g_fnPreciseRoots)
    If g_globNbytes <> NULL Then free(g_globNbytes)
    g_preciseRoots = NULL
    g_fnPreciseRoots = NULL
    g_globNbytes = NULL
End Sub
