' FileIO.abp - file helpers for actba64 programs
' Note: MakeStr copies NUL-terminated BytePtr into a length-prefixed String.
' Avoid "\" string literals; use forward slashes in paths.

Const FIO_GENERIC_READ = &H80000000
Const FIO_GENERIC_WRITE = &H40000000
Const FIO_FILE_SHARE_READ = 1
Const FIO_OPEN_EXISTING = 3
Const FIO_CREATE_ALWAYS = 2
Const FIO_FILE_ATTRIBUTE_NORMAL = 128
Const FIO_INVALID_HANDLE = &HFFFFFFFF
Const FIO_INVALID_ATTR = &HFFFFFFFF

Function FileExists(path As String) As Long
    Dim attr As Long
    attr = GetFileAttributes(StrPtr(path))
    If attr = FIO_INVALID_ATTR Then
        FileExists = 0
    Else
        FileExists = 1
    End If
End Function

Function LoadTextFile$(path As String) As String
    Dim hFile As Long
    Dim fsiz As Long
    Dim nRead As Long
    Dim p As *Byte

    LoadTextFile$ = ""
    hFile = CreateFile(StrPtr(path), FIO_GENERIC_READ, FIO_FILE_SHARE_READ, 0, FIO_OPEN_EXISTING, FIO_FILE_ATTRIBUTE_NORMAL, 0)
    If hFile = FIO_INVALID_HANDLE Then
        Exit Function
    End If
    fsiz = GetFileSize(hFile, 0)
    If fsiz < 0 Then
        CloseHandle(hFile)
        Exit Function
    End If
    p = malloc(fsiz + 1)
    If p = 0 Then
        CloseHandle(hFile)
        Exit Function
    End If
    If fsiz > 0 Then
        ReadFile(hFile, p, fsiz, VarPtr(nRead), 0)
    End If
    CloseHandle(hFile)
    p[fsiz] = 0
    LoadTextFile$ = MakeStr(p)
End Function

Function WriteTextFile(path As String, text As String) As Long
    Dim hFile As Long
    Dim nWritten As Long
    Dim n As Long

    WriteTextFile = 0
    n = Len(text)
    hFile = CreateFile(StrPtr(path), FIO_GENERIC_WRITE, 0, 0, FIO_CREATE_ALWAYS, FIO_FILE_ATTRIBUTE_NORMAL, 0)
    If hFile = FIO_INVALID_HANDLE Then Exit Function
    If n > 0 Then
        WriteFile(hFile, StrPtr(text), n, VarPtr(nWritten), 0)
    Else
        nWritten = 0
    End If
    CloseHandle(hFile)
    If nWritten = n Then
        WriteTextFile = 1
    End If
End Function
