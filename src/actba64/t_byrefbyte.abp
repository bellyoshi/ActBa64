#console
Declare Function ExitProcess Lib "kernel32.dll" (uExitCode As Long) As Long
Declare Function calloc Lib "msvcrt.dll" (n As Long) As *Byte
Function Grow(ByRef head As *Byte, ByRef headLen As Long) As Long
    Dim p As *Byte
    Grow = 0
    p = calloc(16)
    If p = NULL Then Exit Function
    p[0] = 65
    p[1] = 0
    head = p
    headLen = 1
    Grow = 1
End Function
Sub Main()
    Dim head As *Byte
    Dim headLen As Long
    head = NULL
    headLen = 0
    If Grow(head, headLen) = 0 Then ExitProcess(1)
    If head = NULL Then ExitProcess(2)
    If headLen <> 1 Then ExitProcess(3)
    If head[0] <> 65 Then ExitProcess(4)
    ExitProcess(42)
End Sub
Main()
End
