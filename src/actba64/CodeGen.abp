' ===================================================
'  CodeGen - IR -> machine code
' ===================================================

Type IrFixup
    at As Long
    lab As Long
    kind As Long
End Type

Const IR_FIX_REL32 = 0
Const IR_FIX_ABS32 = 1

' Growable label/fixup tables for IrEmitCode / IrEmitCode32
Dim g_cgLabOff As *Long
Dim g_cgLabCap As Long
Dim g_cgFix As *IrFixup
Dim g_cgFixCap As Long
Dim g_cgNFix As Long

Function CgEnsureLabIdx(li As Long) As Long
    Dim newCap As Long
    Dim p As *Byte
    Dim i As Long
    CgEnsureLabIdx = 0
    If li < 0 Then Exit Function
    If li < g_cgLabCap Then
        CgEnsureLabIdx = 1
        Exit Function
    End If
    newCap = g_cgLabCap
    If newCap < DYN_INIT Then newCap = DYN_INIT
    While newCap <= li
        newCap = newCap * 2
        If newCap <= g_cgLabCap Then Exit Function
    Wend
    p = MemGrow(g_cgLabOff As BytePtr, BytesN(g_cgLabCap, SizeOf(Long)), BytesN(newCap, SizeOf(Long)))
    If p = NULL Then Exit Function
    g_cgLabOff = p As *Long
    i = g_cgLabCap
    While i < newCap
        g_cgLabOff[i] = -1
        i = i + 1
    Wend
    g_cgLabCap = newCap
    CgEnsureLabIdx = 1
End Function

Function CgPushFix(at As Long, lab As Long, kind As Long) As Long
    Dim newCap As Long
    Dim p As *Byte
    CgPushFix = 0
    If g_cgNFix >= g_cgFixCap Then
        newCap = g_cgFixCap * 2
        If newCap < DYN_INIT Then newCap = DYN_INIT
        If newCap <= g_cgFixCap Then Exit Function
        p = MemGrow(g_cgFix As BytePtr, BytesN(g_cgFixCap, SizeOf(IrFixup)), BytesN(newCap, SizeOf(IrFixup)))
        If p = NULL Then Exit Function
        g_cgFix = p As *IrFixup
        g_cgFixCap = newCap
    End If
    g_cgFix[g_cgNFix].at = at
    g_cgFix[g_cgNFix].lab = lab
    g_cgFix[g_cgNFix].kind = kind
    g_cgNFix = g_cgNFix + 1
    CgPushFix = 1
End Function

Function IrDllNameOf(dllKind As DWord, dst As *Byte) As Long
    IrDllNameOf = 0
    If dllKind = IR_DLL_USER32 Then
        lstrcpy(dst, "user32.dll")
        IrDllNameOf = 1
    ElseIf dllKind = IR_DLL_KERNEL32 Then
        lstrcpy(dst, "kernel32.dll")
        IrDllNameOf = 1
    ElseIf dllKind = IR_DLL_GDI32 Then
        lstrcpy(dst, "gdi32.dll")
        IrDllNameOf = 1
    ElseIf dllKind = IR_DLL_IMM32 Then
        lstrcpy(dst, "imm32.dll")
        IrDllNameOf = 1
    ElseIf dllKind = IR_DLL_COMDLG32 Then
        lstrcpy(dst, "comdlg32.dll")
        IrDllNameOf = 1
    ElseIf dllKind = IR_DLL_SHELL32 Then
        lstrcpy(dst, "shell32.dll")
        IrDllNameOf = 1
    ElseIf dllKind = IR_DLL_OLE32 Then
        lstrcpy(dst, "ole32.dll")
        IrDllNameOf = 1
    ElseIf dllKind = IR_DLL_D3D11 Then
        lstrcpy(dst, "d3d11.dll")
        IrDllNameOf = 1
    ElseIf dllKind = IR_DLL_D3DCOMPILER Then
        lstrcpy(dst, "d3dcompiler_47.dll")
        IrDllNameOf = 1
    End If
End Function

' arg1<>0: enum + str=api / arg1=0: str="dll|api"
Function IrResolveApiNames(list As *IrList, i As Long, dllOut As *Byte, apiOut As *Byte) As Long
    Dim ops As *IrOp
    Dim packed(255) As Byte
    Dim j As Long
    Dim k As Long

    IrResolveApiNames = 0
    ops = list->ops
    If ops[i].arg1 <> 0 Then
        If IrDllNameOf(ops[i].arg1, dllOut) = 0 Then Exit Function
        IrCopyStrAt(list, i, apiOut)
        IrResolveApiNames = 1
        Exit Function
    End If
    IrCopyStrAt(list, i, VarPtr(packed))
    j = 0
    While packed[j] <> 0 And packed[j] <> 124 And j < 63
        dllOut[j] = packed[j]
        j = j + 1
    Wend
    If packed[j] <> 124 Then Exit Function
    dllOut[j] = 0
    j = j + 1
    k = 0
    While packed[j] <> 0 And k < 63
        apiOut[k] = packed[j]
        j = j + 1
        k = k + 1
    Wend
    apiOut[k] = 0
    If dllOut[0] = 0 Or apiOut[0] = 0 Then Exit Function
    IrResolveApiNames = 1
End Function

Sub IrCollect(list As *IrList, builder As *ImportBuilder)
    Dim i As Long
    Dim n As Long
    Dim opv As Long
    Dim ops As *IrOp
    Dim tmp(255) As Byte
    Dim dll(SYM_NAME_LEN - 1) As Byte
    Dim api(SYM_NAME_LEN - 1) As Byte
    Dim sid As Long

    ops = list->ops
    n = list->count
    For i = 0 To n - 1
        opv = ops[i].op
        If opv = OP_CALL_API Then
            If IrResolveApiNames(list, i, VarPtr(dll), VarPtr(api)) <> 0 Then
                IbAddImport(builder, VarPtr(dll), VarPtr(api))
            End If
        ElseIf opv = OP_LEA_RDX_STR Or opv = OP_LEA_R8_STR Or opv = OP_LEA_RAX_STR Then
            IrCopyStrAt(list, i, VarPtr(tmp))
            If ops[i].arg2 > 0 Then
                sid = IbAddStringLen(builder, VarPtr(tmp), ops[i].arg2)
            Else
                sid = IbAddString(builder, VarPtr(tmp))
            End If
            If sid < 0 Then
                Print "error: out of memory (string literals)"
            End If
            ops[i].strId = sid
        End If
    Next
End Sub

Function CgInitFixups() As Long
    Dim i As Long
    CgInitFixups = 0
    If g_cgLabOff <> NULL Then free(g_cgLabOff)
    If g_cgFix <> NULL Then free(g_cgFix)
    g_cgLabCap = DYN_INIT
    g_cgFixCap = DYN_INIT
    g_cgLabOff = calloc(BytesN(g_cgLabCap, SizeOf(Long)))
    g_cgFix = calloc(BytesN(g_cgFixCap, SizeOf(IrFixup)))
    If g_cgLabOff = NULL Or g_cgFix = NULL Then
        If g_cgLabOff <> NULL Then free(g_cgLabOff)
        If g_cgFix <> NULL Then free(g_cgFix)
        g_cgLabOff = NULL
        g_cgFix = NULL
        g_cgLabCap = 0
        g_cgFixCap = 0
        Exit Function
    End If
    For i = 0 To g_cgLabCap - 1
        g_cgLabOff[i] = -1
    Next
    g_cgNFix = 0
    CgInitFixups = 1
End Function

Sub CgApplyFixups(cb As *CodeBuffer)
    Dim i As Long
    Dim li As Long
    Dim at As Long
    Dim rel As Long
    Dim nextRip As Long
    For i = 0 To g_cgNFix - 1
        li = g_cgFix[i].lab
        at = g_cgFix[i].at
        If CgEnsureLabIdx(li) <> 0 Then
            If g_cgLabOff[li] >= 0 Then
                nextRip = at + 4
                rel = g_cgLabOff[li] - nextRip
                If at >= 0 And at + 4 <= cb->capacity Then
                    PutDword(cb->buf, at, rel)
                End If
            End If
        End If
    Next
    free(g_cgLabOff)
    free(g_cgFix)
    g_cgLabOff = NULL
    g_cgFix = NULL
    g_cgLabCap = 0
    g_cgFixCap = 0
    g_cgNFix = 0
End Sub

Function CgTryEmitA1(cb As *CodeBuffer, op As *IrOp, builder As *ImportBuilder) As Long
    Dim opv As Long
    Dim strRva As DWord
    CgTryEmitA1 = 0
    opv = op->op
    If opv = OP_ENTER Then
        EmitEnter(cb, op->arg1)
    ElseIf opv = OP_LEAVE Then
        EmitLeaveRet(cb)
        If op->arg1 <> 0 Then
            ' 64-bit ignores stdcall pop (Microsoft x64)
        End If
    ElseIf opv = OP_XOR_ECX Then
        EmitXorEcx(cb)
    ElseIf opv = OP_XOR_R9D Then
        EmitXorR9d(cb)
    ElseIf opv = OP_LEA_RDX_STR Then
        strRva = IbGetStringRva(builder, op->strId)
        EmitLeaRdxRip(cb, strRva, TEXT_RVA)
    ElseIf opv = OP_LEA_R8_STR Then
        strRva = IbGetStringRva(builder, op->strId)
        EmitLeaR8Rip(cb, strRva, TEXT_RVA)
    ElseIf opv = OP_LEA_RAX_STR Then
        strRva = IbGetStringRva(builder, op->strId)
        EmitLeaRaxRip(cb, strRva, TEXT_RVA)
    ElseIf opv = OP_MOV_RCX_RAX Then
        EmitMovRcxRax(cb)
    ElseIf opv = OP_MOV_RDX_RAX Then
        EmitMovRdxRax(cb)
    ElseIf opv = OP_MOV_R8_RAX Then
        EmitMovR8Rax(cb)
    ElseIf opv = OP_MOVZX_EAX_BYTE Then
        EmitMovzxEaxByteRax(cb)
    ElseIf opv = OP_TEST_RAX Then
        EmitTestRax(cb)
    ElseIf opv = OP_XOR_EAX Then
        EmitXorEax(cb)
    Else
        Exit Function
    End If
    CgTryEmitA1 = 1
End Function

Function CgTryEmitA2(cb As *CodeBuffer, op As *IrOp) As Long
    Dim opv As Long
    CgTryEmitA2 = 0
    opv = op->op
    If opv = OP_LEA_LOCAL Then
        EmitLeaLocal(cb, op->arg1)
    ElseIf opv = OP_ADD_RAX_RCX Then
        EmitAddRaxRcx(cb)
    ElseIf opv = OP_LOADZX_BYTE_RAX Then
        EmitLoadzxByteRax(cb)
    ElseIf opv = OP_STORE_BYTE_RAX_CL Then
        EmitStoreByteRaxCl(cb)
    ElseIf opv = OP_ADD_RAX_IMM Then
        EmitAddRaxImm(cb, op->arg1)
    ElseIf opv = OP_LOADZX_WORD_RAX Then
        EmitLoadzxWordRax(cb)
    ElseIf opv = OP_STORE_WORD_RAX_CX Then
        EmitStoreWordRaxCx(cb)
    ElseIf opv = OP_LOAD_DWORD_RAX Then
        EmitLoadDwordRax(cb)
    ElseIf opv = OP_STORE_DWORD_RAX_ECX Then
        EmitStoreDwordRaxEcx(cb)
    ElseIf opv = OP_LOAD_QWORD_RAX Then
        EmitLoadQwordRax(cb)
    ElseIf opv = OP_LOAD_PTR Then
        EmitLoadQwordRax(cb)
    ElseIf opv = OP_STORE_QWORD_RAX_RCX Then
        EmitStoreQwordRaxRcx(cb)
    ElseIf opv = OP_STORE_PTR Then
        EmitStoreQwordRaxRcx(cb)
    Else
        Exit Function
    End If
    CgTryEmitA2 = 1
End Function

Function CgTryEmitA(cb As *CodeBuffer, op As *IrOp, builder As *ImportBuilder) As Long
    CgTryEmitA = 0
    If CgTryEmitA1(cb, op, builder) <> 0 Then
        CgTryEmitA = 1
        Exit Function
    End If
    If CgTryEmitA2(cb, op) <> 0 Then
        CgTryEmitA = 1
    End If
End Function
