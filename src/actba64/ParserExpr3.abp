' --- split from ParserExpr.abp (part 3) ---
Function ParseOrExpr(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim left As Long
    Dim right As Long
    Dim n As Long
    Dim kOr(7) As Byte

    ParseOrExpr = -1
    left = ParseAndExpr(p)
    If left < 0 Then Exit Function
    lstrcpy(VarPtr(kOr), "or")
    ast = p->ast
    While ParseIdentIs(p, VarPtr(kOr)) <> 0
        p->pos = p->pos + 1
        right = ParseAndExpr(p)
        If right < 0 Then Exit Function
        n = AstAddNode(ast, AST_BINOP)
        If n < 0 Then Exit Function
        nodes = ast->nodes
        nodes[n].num = BOP_OR
        nodes[n].left = left
        nodes[n].right = right
        left = n
    Wend
    ParseOrExpr = left
End Function

' 式（末尾の As キャストなし）。Dim 初期化など As が宣言に属する場合用
Function ParseExprNoAs(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim left As Long
    Dim right As Long
    Dim n As Long
    Dim kXor(7) As Byte

    ParseExprNoAs = -1
    left = ParseOrExpr(p)
    If left < 0 Then Exit Function
    lstrcpy(VarPtr(kXor), "xor")
    ast = p->ast
    While ParseIdentIs(p, VarPtr(kXor)) <> 0
        p->pos = p->pos + 1
        right = ParseOrExpr(p)
        If right < 0 Then Exit Function
        n = AstAddNode(ast, AST_BINOP)
        If n < 0 Then Exit Function
        nodes = ast->nodes
        nodes[n].num = BOP_XOR
        nodes[n].left = left
        nodes[n].right = right
        left = n
    Wend
    ParseExprNoAs = left
End Function

Function ParseExpr(p As *Parser) As Long
    Dim e As Long

    ParseExpr = -1
    e = ParseExprNoAs(p)
    If e < 0 Then Exit Function
    ParseExpr = ParseApplyAs(p, e)
End Function

' Parse expr then optional "As Type" cast (call args only)
Function ParseArgExpr(p As *Parser) As Long
    Dim kAs(7) As Byte
    Dim kByVal(7) As Byte
    Dim tname(63) As Byte
    Dim e As Long

    ParseArgExpr = -1
    g_parseArgByVal = 0
    lstrcpy(VarPtr(kByVal), "byval")
    If ParseIdentIs(p, VarPtr(kByVal)) <> 0 Then
        p->pos = p->pos + 1
        g_parseArgByVal = 1
    End If
    e = ParseExpr(p)
    If e < 0 Then Exit Function
    lstrcpy(VarPtr(kAs), "as")
    If ParseIdentIs(p, VarPtr(kAs)) <> 0 Then
        p->pos = p->pos + 1
        If ParseTokKind(p) = TK_STAR Then
            p->pos = p->pos + 1
        End If
        If ParseCopyIdent(p, VarPtr(tname)) = 0 Then Exit Function
    End If
    ParseArgExpr = e
End Function

Function ParseCmpOp(p As *Parser) As Long
    Dim k As Long
    ParseCmpOp = 0
    k = ParseTokKind(p)
    If k = TK_EQ Then
        ParseCmpOp = BOP_EQ
    ElseIf k = TK_NE Then
        ParseCmpOp = BOP_NE
    ElseIf k = TK_LT Then
        ParseCmpOp = BOP_LT
    ElseIf k = TK_LE Then
        ParseCmpOp = BOP_LE
    ElseIf k = TK_GT Then
        ParseCmpOp = BOP_GT
    ElseIf k = TK_GE Then
        ParseCmpOp = BOP_GE
    End If
End Function

Function ParseCmp(p As *Parser) As Long
    ' 互換: 条件式は ParseExpr に統一（関係・論理・算術）
    ParseCmp = ParseRelExpr(p)
End Function

Function ParseCondAnd(p As *Parser) As Long
    ParseCondAnd = ParseAndExpr(p)
End Function

Function ParseCond(p As *Parser) As Long
    ParseCond = ParseExpr(p)
End Function

