' AstLowerCmp - 比較と条件ジャンプ

Function LowEmitStrCmp(ctx As *LowerCtx, leftIdx As Long, rightIdx As Long) As Long
    Dim list As *IrList
    Dim empty(1) As Byte
    Dim labA As Long
    Dim labB As Long
    Dim lab As Long

    LowEmitStrCmp = 0
    list = ctx->list
    empty[0] = 0
    lab = LowEnsureRtStrCmp(ctx)
    labA = LowNewLab(ctx)
    labB = LowNewLab(ctx)
    If LowExpr(ctx, leftIdx) = 0 Then Exit Function
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JNZ, labA, 0)
    IrEmitStr(list, OP_LEA_RAX_STR, 0, VarPtr(empty))
    IrEmit(list, OP_LABEL, labA, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    If LowExpr(ctx, rightIdx) = 0 Then Exit Function
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JNZ, labB, 0)
    IrEmitStr(list, OP_LEA_RAX_STR, 0, VarPtr(empty))
    IrEmit(list, OP_LABEL, labB, 0)
    IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    LowEmitCallLab2(list, lab)
    LowEmitStrCmp = 1
End Function

' 文字列比較（TEST eax）で偽になる jcc
Function LowCmpFalseJccStr(ctx As *LowerCtx, op As Long) As Long
    LowCmpFalseJccStr = 0
    If op = BOP_EQ Then
        LowCmpFalseJccStr = OP_JNZ
    ElseIf op = BOP_NE Then
        LowCmpFalseJccStr = OP_JZ
    ElseIf op = BOP_LT Then
        LowCmpFalseJccStr = OP_JGE
    ElseIf op = BOP_LE Then
        LowCmpFalseJccStr = OP_JG
    ElseIf op = BOP_GT Then
        LowCmpFalseJccStr = OP_JLE
    ElseIf op = BOP_GE Then
        LowCmpFalseJccStr = OP_JL
    Else
        ctx->err = 1
    End If
End Function

' ucomisd（順序なし比較）で偽になる jcc
Function LowCmpFalseJccFlt(ctx As *LowerCtx, op As Long) As Long
    LowCmpFalseJccFlt = 0
    If op = BOP_EQ Then
        LowCmpFalseJccFlt = OP_JNE
    ElseIf op = BOP_NE Then
        LowCmpFalseJccFlt = OP_JE
    ElseIf op = BOP_LT Then
        LowCmpFalseJccFlt = OP_JAE
    ElseIf op = BOP_LE Then
        LowCmpFalseJccFlt = OP_JA
    ElseIf op = BOP_GT Then
        LowCmpFalseJccFlt = OP_JBE
    ElseIf op = BOP_GE Then
        LowCmpFalseJccFlt = OP_JB
    Else
        ctx->err = 1
    End If
End Function

' cmp（符号付き）で偽になる jcc
Function LowCmpFalseJccInt(ctx As *LowerCtx, op As Long) As Long
    LowCmpFalseJccInt = 0
    If op = BOP_EQ Then
        LowCmpFalseJccInt = OP_JNE
    ElseIf op = BOP_NE Then
        LowCmpFalseJccInt = OP_JE
    ElseIf op = BOP_LT Then
        LowCmpFalseJccInt = OP_JGE
    ElseIf op = BOP_LE Then
        LowCmpFalseJccInt = OP_JG
    ElseIf op = BOP_GT Then
        LowCmpFalseJccInt = OP_JLE
    ElseIf op = BOP_GE Then
        LowCmpFalseJccInt = OP_JL
    Else
        ctx->err = 1
    End If
End Function

' Emit cmp for a comparison BINOP; return jcc that jumps when FALSE
Function LowCmpFalseJcc(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim op As Long
    Dim list As *IrList
    Dim fty As Long
    Dim lty As Long
    Dim rty As Long

    LowCmpFalseJcc = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    If nodes[idx].kind <> AST_BINOP Then
        ctx->err = 1
        Exit Function
    End If
    op = nodes[idx].num
    If LowIsStringExpr(ctx, nodes[idx].left) <> 0 Or LowIsStringExpr(ctx, nodes[idx].right) <> 0 Then
        If LowEmitStrCmp(ctx, nodes[idx].left, nodes[idx].right) = 0 Then Exit Function
        IrEmit(list, OP_TEST_EAX, 0, 0)
        LowCmpFalseJcc = LowCmpFalseJccStr(ctx, op)
        Exit Function
    End If
    lty = LowExprType(ctx, nodes[idx].left)
    rty = LowExprType(ctx, nodes[idx].right)
    fty = LowPromoteType(lty, rty)
    If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
    If fty = TY_DOUBLE Then
        LowEmitCvtRaxToDoubleFromTy(ctx, lty)
    End If
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
    If fty = TY_DOUBLE Then
        LowEmitCvtRaxToDoubleFromTy(ctx, rty)
    End If
    IrEmit(list, OP_POP_RCX, 0, 0)
    If fty = TY_DOUBLE Then
        IrEmit(list, OP_UCOMISD, 0, 0)
        LowCmpFalseJcc = LowCmpFalseJccFlt(ctx, op)
        Exit Function
    End If
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    LowCmpFalseJcc = LowCmpFalseJccInt(ctx, op)
End Function

Function LowCmpTrueJcc(falseJcc As Long) As Long
    LowCmpTrueJcc = 0
    If falseJcc = OP_JNE Then
        LowCmpTrueJcc = OP_JE
    ElseIf falseJcc = OP_JE Then
        LowCmpTrueJcc = OP_JNE
    ElseIf falseJcc = OP_JNZ Then
        ' string EQ: false=JNZ (lstrcmp != 0), true=JZ
        LowCmpTrueJcc = OP_JZ
    ElseIf falseJcc = OP_JZ Then
        ' string NE: false=JZ, true=JNZ
        LowCmpTrueJcc = OP_JNZ
    ElseIf falseJcc = OP_JGE Then
        LowCmpTrueJcc = OP_JL
    ElseIf falseJcc = OP_JG Then
        LowCmpTrueJcc = OP_JLE
    ElseIf falseJcc = OP_JLE Then
        LowCmpTrueJcc = OP_JG
    ElseIf falseJcc = OP_JL Then
        LowCmpTrueJcc = OP_JGE
    ElseIf falseJcc = OP_JAE Then
        LowCmpTrueJcc = OP_JB
    ElseIf falseJcc = OP_JB Then
        LowCmpTrueJcc = OP_JAE
    ElseIf falseJcc = OP_JA Then
        LowCmpTrueJcc = OP_JBE
    ElseIf falseJcc = OP_JBE Then
        LowCmpTrueJcc = OP_JA
    End If
End Function
