' --- split from AstLowerExpr.abp (part 2) ---
Function LowExprVar(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim list As *IrList

    LowExprVar = 0
    ast = ctx->ast
    list = ctx->list

    AstCopyStr(ast, idx, VarPtr(name))
    If LowExprVarConst(ctx, VarPtr(name)) <> 0 Then
        LowExprVar = 1
        Exit Function
    End If
    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
        LowerDiagError(ctx, idx, "undefined variable '" + MakeStr(VarPtr(name)) + "'")
        Exit Function
    End If
    LowEmitLoadOff(list, vOff, vGlob)
    If vByRef <> 0 Then
        IrEmit(list, OP_LOAD_QWORD_RAX, 0, 0)
    End If
    LowExprVar = 1
End Function

Function LowExprMember(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim buf(255) As Byte
    Dim list As *IrList
    Dim tt As *TypeTable
    Dim foff As Long
    Dim fsz As Long
    Dim fcnt As Long
    Dim ti As Long

    LowExprMember = 0
    ast = ctx->ast
    list = ctx->list
    tt = ast->types

    If LowAddr(ctx, idx) = 0 Then Exit Function
    AstCopyStr(ast, idx, VarPtr(name))
    If LowMemberBaseName(ctx, idx, VarPtr(buf)) = 0 Then
        ctx->err = 1
        Exit Function
    End If
    If LowLookupVar(ctx, VarPtr(buf), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
        ctx->err = 1
        Exit Function
    End If
    ti = vTypeIdx
    If TyFindField(tt, ti, VarPtr(name), foff, fsz, fcnt) = 0 Then
        LowLoadSized(list, LowTyNbytes(vTy))
        LowExprMember = 1
        Exit Function
    End If
    LowLoadSized(list, fsz)
    LowExprMember = 1
End Function

' base が AST_MEMBER の添字（UDT 配列フィールド / ポインタフィールド）
Function LowExprIndexMember(ctx As *LowerCtx, idx As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim buf(255) As Byte
    Dim list As *IrList
    Dim tt As *TypeTable
    Dim foff As Long
    Dim fsz As Long
    Dim fcnt As Long
    Dim fieldTy As Long
    Dim ti As Long
    Dim base As Long

    LowExprIndexMember = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    tt = ast->types
    base = nodes[idx].left
    If LowAddr(ctx, idx) = 0 Then Exit Function
    AstCopyStr(ast, base, VarPtr(name))
    If LowMemberBaseName(ctx, base, VarPtr(buf)) = 0 Then
        ctx->err = 1
        Exit Function
    End If
    If LowLookupVar(ctx, VarPtr(buf), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
        ctx->err = 1
        Exit Function
    End If
    ti = vTypeIdx
    If TyFindFieldEx(tt, ti, VarPtr(name), foff, fsz, fcnt, fieldTy) = 0 Then
        ctx->err = 1
        Exit Function
    End If
    If fcnt > 1 Then
        LowLoadSized(list, fsz)
    ElseIf fsz = TyPtrSize() Then
        LowLoadSized(list, LowPtrFieldElemSize(fieldTy))
    Else
        ctx->err = 1
        Exit Function
    End If
    LowExprIndexMember = 1
End Function

' base が単純変数／ポインタの添字
Function LowExprIndexBase(ctx As *LowerCtx, idx As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim buf(255) As Byte
    Dim list As *IrList
    Dim base As Long

    LowExprIndexBase = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    base = nodes[idx].left
    If LowAddr(ctx, idx) = 0 Then Exit Function
    AstCopyStr(ast, base, VarPtr(buf))
    If LowLookupVar(ctx, VarPtr(buf), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
        If vTy = TY_PTR_LONG Or vTy = TY_LONG_ARR Then
            LowLoadSized(list, 4)
        ElseIf vTy = TY_PTR_BYTE Then
            IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
        ElseIf vTy = TY_STRING_ARR Or vTy = TY_DOUBLE_ARR Then
            LowLoadSized(list, 8)
        ElseIf vTy = TY_SINGLE_ARR Then
            LowLoadSized(list, 4)
        ElseIf vTy = TY_UDT_ARR Then
            ' 要素全体の値ロードはしない（メンバアクセス経由）
            ctx->err = 1
            Exit Function
        Else
            IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
        End If
    Else
        IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
    End If
    LowExprIndexBase = 1
End Function

Function LowExprIndex(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim base As Long

    ast = ctx->ast
    nodes = ast->nodes
    base = nodes[idx].left
    If nodes[base].kind = AST_MEMBER Then
        LowExprIndex = LowExprIndexMember(ctx, idx)
    Else
        LowExprIndex = LowExprIndexBase(ctx, idx)
    End If
End Function

' left/right/extra の 3 引数を rcx, rdx, r8 へ積む
Function LowExprBuiltin3ToRcx(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList

    LowExprBuiltin3ToRcx = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    If nodes[idx].extra < 0 Then
        ctx->err = 1
        Exit Function
    End If
    If LowExpr(ctx, nodes[idx].extra) = 0 Then Exit Function
    IrEmit(list, OP_MOV_R8_RAX, 0, 0)
    IrEmit(list, OP_POP_RAX, 0, 0)
    IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    LowExprBuiltin3ToRcx = 1
End Function

Function LowExprBuiltinMem(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList
    Dim labZ As Long
    Dim labE As Long
    Dim sLen(15) As Byte

    LowExprBuiltinMem = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    If nodes[idx].num = BI_FILLMEMORY Then
        If LowExprBuiltin3ToRcx(ctx, idx) = 0 Then Exit Function
        lstrcpy(VarPtr(sLen), "RtlFillMemory")
        IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sLen))
        LowExprBuiltinMem = 1
    ElseIf nodes[idx].num = BI_ASC Then
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        labZ = LowNewLab(ctx)
        labE = LowNewLab(ctx)
        IrEmit(list, OP_TEST_RAX, 0, 0)
        IrEmit(list, OP_JZ, labZ, 0)
        IrEmit(list, OP_MOVZX_EAX_BYTE, 0, 0)
        IrEmit(list, OP_JMP, labE, 0)
        IrEmit(list, OP_LABEL, labZ, 0)
        IrEmit(list, OP_XOR_EAX, 0, 0)
        IrEmit(list, OP_LABEL, labE, 0)
        LowExprBuiltinMem = 1
    ElseIf nodes[idx].num = BI_MEMCPY Then
        If LowExprBuiltin3ToRcx(ctx, idx) = 0 Then Exit Function
        lstrcpy(VarPtr(sLen), "RtlMoveMemory")
        IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sLen))
        LowExprBuiltinMem = 1
    Else
        LowExprBuiltinMem = -1
    End If
End Function

Function LowExprBuiltinLen(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim list As *IrList
    Dim labZ As Long
    Dim labE As Long
    Dim tt As *TypeTable
    Dim ti As Long
    Dim sz As Long
    Dim tsizes As *Long

    LowExprBuiltinLen = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    tt = ast->types
    If nodes[nodes[idx].left].kind = AST_VAR Then
        AstCopyStr(ast, nodes[idx].left, VarPtr(name))
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
            If vTy = TY_UDT Then
                ti = vTypeIdx
                If ti >= 0 Then
                    tsizes = tt->typeSizes
                    sz = tsizes[ti]
                    If sz > 0 Then
                        IrEmit(list, OP_MOV_EAX_IMM, sz, 0)
                        LowExprBuiltinLen = 1
                        Exit Function
                    End If
                End If
            End If
        End If
    End If
    If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
    labZ = LowNewLab(ctx)
    labE = LowNewLab(ctx)
    LowEmitLoadStrLen(list, labZ, labE)
    LowExprBuiltinLen = 1
End Function

Function LowExprBuiltinSizeof(ctx As *LowerCtx, idx As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim list As *IrList
    Dim tt As *TypeTable
    Dim sz As Long

    LowExprBuiltinSizeof = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    tt = ast->types
    AstCopyStr(ast, nodes[idx].left, VarPtr(name))
    sz = TySizeOfName(tt, VarPtr(name))
    If sz <= 0 Then
        If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
            ctx->err = 1
            Exit Function
        End If
        ctx->err = 1
        Exit Function
    End If
    IrEmit(list, OP_MOV_EAX_IMM, sz, 0)
    LowExprBuiltinSizeof = 1
End Function

' ランタイム呼び出し系 / 素通し系の組み込み関数
Function LowExprBuiltinCore2(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList
    Dim lab As Long
    Dim n As Long

    LowExprBuiltinCore2 = 0
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    n = nodes[idx].num
    If n = BI_MAKEINTRESOURCE Then
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        LowExprBuiltinCore2 = 1
    ElseIf n = BI_STRPTR Then
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        LowExprBuiltinCore2 = 1
    ElseIf n = BI_STR Then
        lab = LowEnsureRtStr(ctx)
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        LowEmitCall1Rax(list, 0, 0, 0, lab)
        LowExprBuiltinCore2 = 1
    ElseIf n = BI_MAKESTR Then
        lab = LowEnsureRtMakeStr(ctx)
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        LowEmitCall1Rax(list, 0, 0, 0, lab)
        LowExprBuiltinCore2 = 1
    Else
        LowExprBuiltinCore2 = -1
    End If
End Function
