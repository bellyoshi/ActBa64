' ClassVt - 中身のある Virtual を持つ Class（ユーザーの vtable）
' 型番号ごとに、ユーザーの vtable を持つか（g_vtUser）と、大域データ上の vtable の位置（g_vtOff）

Dim g_vtUser As *Long
Dim g_vtOff As *Long
Dim g_vtCap As Long

Sub VtReset()
    If g_vtUser <> NULL Then free(g_vtUser)
    If g_vtOff <> NULL Then free(g_vtOff)
    g_vtUser = NULL
    g_vtOff = NULL
    g_vtCap = 0
End Sub

Function VtGrowUser(ncap As Long) As Long
    Dim p As *Byte
    VtGrowUser = 0
    p = MemGrow(g_vtUser As BytePtr, BytesN(g_vtCap, SizeOf(Long)), BytesN(ncap, SizeOf(Long)))
    If p = NULL Then Exit Function
    g_vtUser = p As *Long
    VtGrowUser = 1
End Function

Function VtGrowOff(ncap As Long) As Long
    Dim p As *Byte
    VtGrowOff = 0
    p = MemGrow(g_vtOff As BytePtr, BytesN(g_vtCap, SizeOf(Long)), BytesN(ncap, SizeOf(Long)))
    If p = NULL Then Exit Function
    g_vtOff = p As *Long
    VtGrowOff = 1
End Function

Function VtGrow(ncap As Long) As Long
    VtGrow = 0
    If VtGrowUser(ncap) = 0 Then Exit Function
    If VtGrowOff(ncap) = 0 Then Exit Function
    AccFillNeg(g_vtUser, g_vtCap, ncap)
    AccFillNeg(g_vtOff, g_vtCap, ncap)
    g_vtCap = ncap
    VtGrow = 1
End Function

Function VtEnsure(need As Long) As Long
    VtEnsure = 1
    If need <= g_vtCap Then Exit Function
    VtEnsure = VtGrow(AccCapFor(g_vtCap, need))
End Function

Function VtSetUser(ti As Long) As Long
    VtSetUser = 0
    If ti < 0 Then Exit Function
    If VtEnsure(ti + 1) = 0 Then Exit Function
    g_vtUser[ti] = 1
    VtSetUser = 1
End Function

Function VtIsUser(ti As Long) As Long
    VtIsUser = 0
    If ti < 0 Or ti >= g_vtCap Then Exit Function
    If g_vtUser[ti] = 1 Then VtIsUser = 1
End Function

Sub VtSetOff(ti As Long, off As Long)
    If VtEnsure(ti + 1) = 0 Then Exit Sub
    g_vtOff[ti] = off
End Sub

Function VtOff(ti As Long) As Long
    VtOff = -1
    If ti < 0 Or ti >= g_vtCap Then Exit Function
    VtOff = g_vtOff[ti]
End Function
