' ===================================================
'  ParserCtrl - If / loops / Func / Declare
' ===================================================

Function ParseIfElseIfBody(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nIf As Long
    Dim cond As Long
    Dim thenList As Long
    Dim elseList As Long
    Dim kThen(KW_SHORT_LEN - 1) As Byte
    Dim kElse(KW_SHORT_LEN - 1) As Byte
    Dim kElseIf(KW_LEN - 1) As Byte
    Dim kEnd(KW_SHORT_LEN - 1) As Byte

    ParseIfElseIfBody = -1
    p->pos = p->pos + 1
    cond = ParseCond(p)
    If cond < 0 Then Exit Function
    lstrcpy(VarPtr(kThen), "then")
    If ParseIdentIs(p, VarPtr(kThen)) = 0 Then
        p->err = 1
        Exit Function
    End If
    p->pos = p->pos + 1
    lstrcpy(VarPtr(kElse), "else")
    lstrcpy(VarPtr(kElseIf), "elseif")
    lstrcpy(VarPtr(kEnd), "end")
    thenList = ParseStmtListUntil3(p, VarPtr(kElse), VarPtr(kElseIf), VarPtr(kEnd))
    If p->err <> 0 Then Exit Function
    elseList = ParseIfElseParts(p)
    If p->err <> 0 Then Exit Function
    ast = p->ast
    nIf = AstAddNode(ast, AST_IF)
    If nIf < 0 Then Exit Function
    nodes = ast->nodes
    nodes[nIf].left = cond
    nodes[nIf].right = thenList
    nodes[nIf].extra = elseList
    ParseIfElseIfBody = nIf
End Function

Function ParseIfElseParts(p As *Parser) As Long
    Dim elseList As Long
    Dim kElse(KW_SHORT_LEN - 1) As Byte
    Dim kElseIf(KW_LEN - 1) As Byte
    Dim kEnd(KW_SHORT_LEN - 1) As Byte
    Dim empty(1) As Byte

    ParseIfElseParts = -1
    empty[0] = 0
    lstrcpy(VarPtr(kElseIf), "elseif")
    lstrcpy(VarPtr(kElse), "else")
    lstrcpy(VarPtr(kEnd), "end")

    If ParseIdentIs(p, VarPtr(kElseIf)) <> 0 Then
        ParseIfElseParts = ParseIfElseIfBody(p)
        Exit Function
    End If

    If ParseIdentIs(p, VarPtr(kElse)) <> 0 Then
        p->pos = p->pos + 1
        elseList = ParseStmtListUntil(p, VarPtr(kEnd), VarPtr(empty))
        If p->err <> 0 Then Exit Function
        ParseIfElseParts = elseList
        Exit Function
    End If

    ParseIfElseParts = -1
End Function

Function ParseExitLoopArm(p As *Parser) As Long
    Dim ast As *Ast
    Dim n As Long
    Dim kDo(KW_SHORT_LEN - 1) As Byte
    Dim kWhile(KW_LEN - 1) As Byte
    Dim kFor(KW_SHORT_LEN - 1) As Byte

    ParseExitLoopArm = -2
    lstrcpy(VarPtr(kDo), "do")
    lstrcpy(VarPtr(kWhile), "while")
    lstrcpy(VarPtr(kFor), "for")
    If ParseIdentIs(p, VarPtr(kDo)) <> 0 Then
        p->pos = p->pos + 1
        ast = p->ast
        n = AstAddNode(ast, AST_EXITDO)
        If n < 0 Then
            ParseExitLoopArm = -1
            Exit Function
        End If
        ParseExitLoopArm = n
        Exit Function
    End If
    If ParseIdentIs(p, VarPtr(kWhile)) <> 0 Then
        p->pos = p->pos + 1
        ast = p->ast
        n = AstAddNode(ast, AST_EXITWHILE)
        If n < 0 Then
            ParseExitLoopArm = -1
            Exit Function
        End If
        ParseExitLoopArm = n
        Exit Function
    End If
    If ParseIdentIs(p, VarPtr(kFor)) <> 0 Then
        p->pos = p->pos + 1
        ast = p->ast
        n = AstAddNode(ast, AST_EXITFOR)
        If n < 0 Then
            ParseExitLoopArm = -1
            Exit Function
        End If
        ParseExitLoopArm = n
    End If
End Function

Function ParseExitProcArm(p As *Parser) As Long
    Dim ast As *Ast
    Dim n As Long
    Dim kFun(KW_LEN - 1) As Byte
    Dim kSub(KW_SHORT_LEN - 1) As Byte

    ParseExitProcArm = -2
    lstrcpy(VarPtr(kFun), "function")
    lstrcpy(VarPtr(kSub), "sub")
    If ParseIdentIs(p, VarPtr(kFun)) <> 0 Then
        p->pos = p->pos + 1
        ast = p->ast
        n = AstAddNode(ast, AST_EXITFUNC)
        If n < 0 Then
            ParseExitProcArm = -1
            Exit Function
        End If
        ParseExitProcArm = n
        Exit Function
    End If
    If ParseIdentIs(p, VarPtr(kSub)) <> 0 Then
        p->pos = p->pos + 1
        ast = p->ast
        n = AstAddNode(ast, AST_EXITFUNC)
        If n < 0 Then
            ParseExitProcArm = -1
            Exit Function
        End If
        ParseExitProcArm = n
    End If
End Function

Function ParseExitKwStmt(p As *Parser) As Long
    Dim n As Long

    ParseExitKwStmt = -1
    p->pos = p->pos + 1
    n = ParseExitLoopArm(p)
    If n <> -2 Then
        ParseExitKwStmt = n
        Exit Function
    End If
    n = ParseExitProcArm(p)
    If n <> -2 Then
        ParseExitKwStmt = n
        Exit Function
    End If
    p->err = 1
End Function

Function ParseContArm(p As *Parser, kw As *Byte, kind As Long) As Long
    Dim ast As *Ast
    Dim n As Long
    ParseContArm = -2
    If ParseIdentIs(p, kw) = 0 Then Exit Function
    p->pos = p->pos + 1
    ast = p->ast
    n = AstAddNode(ast, kind)
    ParseContArm = n
End Function

Function ParseContinueDoWhile(p As *Parser) As Long
    Dim kw(KW_LEN - 1) As Byte
    lstrcpy(VarPtr(kw), "do")
    ParseContinueDoWhile = ParseContArm(p, VarPtr(kw), AST_CONTINUEDO)
    If ParseContinueDoWhile <> -2 Then Exit Function
    lstrcpy(VarPtr(kw), "while")
    ParseContinueDoWhile = ParseContArm(p, VarPtr(kw), AST_CONTINUEWHILE)
End Function

Function ParseContinueNamed(p As *Parser) As Long
    Dim kw(KW_SHORT_LEN - 1) As Byte
    ParseContinueNamed = ParseContinueDoWhile(p)
    If ParseContinueNamed <> -2 Then Exit Function
    lstrcpy(VarPtr(kw), "for")
    ParseContinueNamed = ParseContArm(p, VarPtr(kw), AST_CONTINUEFOR)
End Function

Function ParseContinueBare(p As *Parser) As Long
    Dim ast As *Ast
    Dim kind As Long
    ParseContinueBare = -1
    kind = LoopTop()
    If kind = 0 Then
        p->err = 1
        Exit Function
    End If
    ast = p->ast
    ParseContinueBare = AstAddNode(ast, kind)
End Function

Function ParseContinueKwStmt(p As *Parser) As Long
    ParseContinueKwStmt = -1
    p->pos = p->pos + 1
    ParseContinueKwStmt = ParseContinueNamed(p)
    If ParseContinueKwStmt <> -2 Then Exit Function
    ParseContinueKwStmt = ParseContinueBare(p)
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function ParseIfThenClause(p As *Parser, thenLine As Long, ByRef thenList As Long, ByRef singleLine As Long) As boolean
    Dim kElse(KW_SHORT_LEN - 1) As Byte
    Dim kElseIf(KW_LEN - 1) As Byte
    Dim kEnd(KW_SHORT_LEN - 1) As Byte
    Dim nextLine As Long

    ParseIfThenClause = false
    lstrcpy(VarPtr(kElse), "else")
    lstrcpy(VarPtr(kElseIf), "elseif")
    lstrcpy(VarPtr(kEnd), "end")
    singleLine = 0

    If ParseTokKind(p) = TK_EOF Then
        ParseFail(p, "expected statement after Then")
        Exit Function
    End If

    nextLine = ParseTokLine(p)
    If thenLine < nextLine Then
        thenList = ParseStmtListUntil3(p, VarPtr(kElse), VarPtr(kElseIf), VarPtr(kEnd))
        If p->err <> 0 Then Exit Function
        singleLine = 0
    Else
        ' 同一行の : 区切りは Then 節（Else または行末まで）
        thenList = ParseSameLineList(p, VarPtr(kElse), thenLine)
        If p->err <> 0 Then Exit Function
        singleLine = 1
    End If
    ParseIfThenClause = true
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function ParseIfEndClause(p As *Parser, ifLine As Long, singleLine As Long, ByRef elseList As Long) As boolean
    Dim kEnd(KW_SHORT_LEN - 1) As Byte
    Dim kIf(KW_SHORT_LEN - 1) As Byte
    Dim kElse(KW_SHORT_LEN - 1) As Byte

    ParseIfEndClause = false
    elseList = -1
    If singleLine = 0 Then
        elseList = ParseIfElseParts(p)
        If p->err <> 0 Then Exit Function
        lstrcpy(VarPtr(kEnd), "end")
        If ParseIdentIs(p, VarPtr(kEnd)) = 0 Then
            DiagError(ifLine, "expected 'End If'")
            p->err = 1
            Exit Function
        End If
        p->pos = p->pos + 1
        lstrcpy(VarPtr(kIf), "if")
        If ParseIdentIs(p, VarPtr(kIf)) = 0 Then
            DiagError(ifLine, "expected 'End If'")
            p->err = 1
            Exit Function
        End If
        p->pos = p->pos + 1
    Else
        ' If cond Then stmt [Else stmt]  on one line
        lstrcpy(VarPtr(kElse), "else")
        If ParseIdentIs(p, VarPtr(kElse)) <> 0 Then
            If ParseTokLine(p) = ifLine Then
                p->pos = p->pos + 1
                elseList = ParseSameLineList(p, VarPtr(kElse), ifLine)
                If p->err <> 0 Then Exit Function
            End If
        End If
    End If
    ParseIfEndClause = true
End Function

Function ParseIfStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nIf As Long
    Dim cond As Long
    Dim thenList As Long
    Dim elseList As Long
    Dim kThen(KW_SHORT_LEN - 1) As Byte
    Dim singleLine As Long
    Dim thenLine As Long
    Dim ifLine As Long

    ParseIfStmt = -1
    ifLine = ParseTokLine(p)
    p->pos = p->pos + 1
    cond = ParseCond(p)
    If cond < 0 Then Exit Function
    lstrcpy(VarPtr(kThen), "then")
    If ParseIdentIs(p, VarPtr(kThen)) = 0 Then
        DiagError(ifLine, "expected 'Then' after condition")
        p->err = 1
        Exit Function
    End If
    thenLine = ParseTokLine(p)
    p->pos = p->pos + 1
    If Not ParseIfThenClause(p, thenLine, thenList, singleLine) Then Exit Function
    If Not ParseIfEndClause(p, ifLine, singleLine, elseList) Then Exit Function

    ast = p->ast
    nIf = AstAddNode(ast, AST_IF)
    If nIf < 0 Then Exit Function
    nodes = ast->nodes
    nodes[nIf].left = cond
    nodes[nIf].right = thenList
    nodes[nIf].extra = elseList
    ParseIfStmt = nIf
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function ParseDoHeadCond(p As *Parser, ByRef cond As Long, ByRef doMode As Long) As boolean
    Dim kWhile(KW_SHORT_LEN - 1) As Byte
    Dim kUntil(KW_SHORT_LEN - 1) As Byte

    ParseDoHeadCond = false
    doMode = DO_PLAIN
    cond = -1
    lstrcpy(VarPtr(kWhile), "while")
    lstrcpy(VarPtr(kUntil), "until")
    If ParseIdentIs(p, VarPtr(kWhile)) <> 0 Then
        p->pos = p->pos + 1
        cond = ParseCond(p)
        If cond < 0 Then Exit Function
        doMode = DO_WHILE_TOP
    ElseIf ParseIdentIs(p, VarPtr(kUntil)) <> 0 Then
        p->pos = p->pos + 1
        cond = ParseCond(p)
        If cond < 0 Then Exit Function
        doMode = DO_UNTIL_TOP
    End If
    ParseDoHeadCond = true
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function ParseDoTailCond(p As *Parser, ByRef cond As Long, ByRef doMode As Long) As boolean
    Dim kWhile(KW_SHORT_LEN - 1) As Byte
    Dim kUntil(KW_SHORT_LEN - 1) As Byte

    ParseDoTailCond = false
    If doMode = DO_PLAIN Then
        lstrcpy(VarPtr(kWhile), "while")
        lstrcpy(VarPtr(kUntil), "until")
        If ParseIdentIs(p, VarPtr(kWhile)) <> 0 Then
            p->pos = p->pos + 1
            cond = ParseCond(p)
            If cond < 0 Then Exit Function
            doMode = DO_WHILE_BOTTOM
        ElseIf ParseIdentIs(p, VarPtr(kUntil)) <> 0 Then
            p->pos = p->pos + 1
            cond = ParseCond(p)
            If cond < 0 Then Exit Function
            doMode = DO_UNTIL_BOTTOM
        End If
    End If
    ParseDoTailCond = true
End Function

Function ParseDoBody(p As *Parser, kLoop As *Byte) As Long
    Dim empty(1) As Byte
    empty[0] = 0
    lstrcpy(kLoop, "loop")
    LoopPush(AST_CONTINUEDO)
    ParseDoBody = ParseStmtListUntil(p, kLoop, VarPtr(empty))
    LoopPop()
End Function

Function ParseDoLoopTok(p As *Parser, kLoop As *Byte) As boolean
    ParseDoLoopTok = false
    If ParseIdentIs(p, kLoop) = 0 Then
        p->err = 1
        Exit Function
    End If
    p->pos = p->pos + 1
    ParseDoLoopTok = true
End Function

Sub ParseDoFill(ast As *Ast, nDo As Long, cond As Long, body As Long, doMode As Long)
    Dim nodes As *AstNode
    nodes = ast->nodes
    nodes[nDo].left = cond
    nodes[nDo].right = body
    nodes[nDo].extra = doMode
End Sub

Function ParseDoNode(p As *Parser, cond As Long, doMode As Long, body As Long) As Long
    Dim ast As *Ast
    Dim nDo As Long
    ast = p->ast
    nDo = AstAddNode(ast, AST_DO)
    ParseDoNode = nDo
    If nDo < 0 Then Exit Function
    ParseDoFill(ast, nDo, cond, body, doMode)
End Function

Function ParseDoTailNode(p As *Parser, cond As Long, doMode As Long, body As Long) As Long
    ParseDoTailNode = -1
    If Not ParseDoTailCond(p, cond, doMode) Then Exit Function
    ParseDoTailNode = ParseDoNode(p, cond, doMode, body)
End Function

Function ParseDoRest(p As *Parser, cond As Long, doMode As Long) As Long
    Dim body As Long
    Dim kLoop(KW_SHORT_LEN - 1) As Byte
    ParseDoRest = -1
    body = ParseDoBody(p, VarPtr(kLoop))
    If p->err <> 0 Then Exit Function
    If Not ParseDoLoopTok(p, VarPtr(kLoop)) Then Exit Function
    ParseDoRest = ParseDoTailNode(p, cond, doMode, body)
End Function

Function ParseDoStmt(p As *Parser) As Long
    Dim cond As Long
    Dim doMode As Long
    ParseDoStmt = -1
    p->pos = p->pos + 1
    If Not ParseDoHeadCond(p, cond, doMode) Then Exit Function
    ParseDoStmt = ParseDoRest(p, cond, doMode)
End Function
