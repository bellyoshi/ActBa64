' ===================================================
'  ParserCtrl - If / loops / Func / Declare
' ===================================================

Function ParseIfElseParts(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nIf As Long
    Dim cond As Long
    Dim thenList As Long
    Dim elseList As Long
    Dim kThen(7) As Byte
    Dim kElse(7) As Byte
    Dim kElseIf(15) As Byte
    Dim kEnd(7) As Byte
    Dim empty(1) As Byte

    ParseIfElseParts = -1
    empty[0] = 0
    lstrcpy(VarPtr(kElseIf), "elseif")
    lstrcpy(VarPtr(kElse), "else")
    lstrcpy(VarPtr(kEnd), "end")
    lstrcpy(VarPtr(kThen), "then")
    ast = p->ast

    If ParseIdentIs(p, VarPtr(kElseIf)) <> 0 Then
        p->pos = p->pos + 1
        cond = ParseCond(p)
        If cond < 0 Then Exit Function
        If ParseIdentIs(p, VarPtr(kThen)) = 0 Then
            p->err = 1
            Exit Function
        End If
        p->pos = p->pos + 1
        thenList = ParseStmtListUntil3(p, VarPtr(kElse), VarPtr(kElseIf), VarPtr(kEnd))
        If p->err <> 0 Then Exit Function
        elseList = ParseIfElseParts(p)
        If p->err <> 0 Then Exit Function
        nIf = AstAddNode(ast, AST_IF)
        If nIf < 0 Then Exit Function
        nodes = ast->nodes
        nodes[nIf].left = cond
        nodes[nIf].right = thenList
        nodes[nIf].extra = elseList
        ParseIfElseParts = nIf
        Exit Function
    End If

    If ParseIdentIs(p, VarPtr(kElse)) <> 0 Then
        p->pos = p->pos + 1
        elseList = ParseStmtListUntil(p, VarPtr(kEnd), VarPtr(empty))
        If p->err <> 0 Then Exit Function
        ParseIfElseParts = elseList
        Exit Function
    End If

    ParseIfElseParts = -1
End Function

Function ParseExitKwStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim n As Long
    Dim kDo(7) As Byte
    Dim kFun(15) As Byte
    Dim kSub(7) As Byte
    Dim kWhile(15) As Byte
    Dim kFor(7) As Byte

    ParseExitKwStmt = -1
    p->pos = p->pos + 1
    lstrcpy(VarPtr(kDo), "do")
    lstrcpy(VarPtr(kFun), "function")
    lstrcpy(VarPtr(kSub), "sub")
    lstrcpy(VarPtr(kWhile), "while")
    lstrcpy(VarPtr(kFor), "for")
    If ParseIdentIs(p, VarPtr(kDo)) <> 0 Then
        p->pos = p->pos + 1
        ast = p->ast
        n = AstAddNode(ast, AST_EXITDO)
        If n < 0 Then Exit Function
        ParseExitKwStmt = n
        Exit Function
    End If
    If ParseIdentIs(p, VarPtr(kWhile)) <> 0 Then
        p->pos = p->pos + 1
        ast = p->ast
        n = AstAddNode(ast, AST_EXITWHILE)
        If n < 0 Then Exit Function
        ParseExitKwStmt = n
        Exit Function
    End If
    If ParseIdentIs(p, VarPtr(kFor)) <> 0 Then
        p->pos = p->pos + 1
        ast = p->ast
        n = AstAddNode(ast, AST_EXITFOR)
        If n < 0 Then Exit Function
        ParseExitKwStmt = n
        Exit Function
    End If
    If ParseIdentIs(p, VarPtr(kFun)) <> 0 Then
        p->pos = p->pos + 1
        ast = p->ast
        n = AstAddNode(ast, AST_EXITFUNC)
        If n < 0 Then Exit Function
        ParseExitKwStmt = n
        Exit Function
    End If
    If ParseIdentIs(p, VarPtr(kSub)) <> 0 Then
        p->pos = p->pos + 1
        ast = p->ast
        n = AstAddNode(ast, AST_EXITFUNC)
        If n < 0 Then Exit Function
        ParseExitKwStmt = n
        Exit Function
    End If
    p->err = 1
End Function

Function ParseContinueKwStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim n As Long
    Dim kDo(7) As Byte
    Dim kWhile(15) As Byte
    Dim kFor(7) As Byte

    ParseContinueKwStmt = -1
    p->pos = p->pos + 1
    lstrcpy(VarPtr(kDo), "do")
    lstrcpy(VarPtr(kWhile), "while")
    lstrcpy(VarPtr(kFor), "for")
    If ParseIdentIs(p, VarPtr(kDo)) <> 0 Then
        p->pos = p->pos + 1
        ast = p->ast
        n = AstAddNode(ast, AST_CONTINUEDO)
        If n < 0 Then Exit Function
        ParseContinueKwStmt = n
        Exit Function
    End If
    If ParseIdentIs(p, VarPtr(kWhile)) <> 0 Then
        p->pos = p->pos + 1
        ast = p->ast
        n = AstAddNode(ast, AST_CONTINUEWHILE)
        If n < 0 Then Exit Function
        ParseContinueKwStmt = n
        Exit Function
    End If
    If ParseIdentIs(p, VarPtr(kFor)) <> 0 Then
        p->pos = p->pos + 1
        ast = p->ast
        n = AstAddNode(ast, AST_CONTINUEFOR)
        If n < 0 Then Exit Function
        ParseContinueKwStmt = n
        Exit Function
    End If
    p->err = 1
End Function

Function ParseIfStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nIf As Long
    Dim cond As Long
    Dim thenList As Long
    Dim elseList As Long
    Dim kThen(7) As Byte
    Dim kElse(7) As Byte
    Dim kElseIf(15) As Byte
    Dim kEnd(7) As Byte
    Dim kIf(7) As Byte
    Dim singleLine As Long
    Dim thenLine As Long
    Dim nextLine As Long

    ParseIfStmt = -1
    p->pos = p->pos + 1
    cond = ParseCond(p)
    If cond < 0 Then Exit Function
    lstrcpy(VarPtr(kThen), "then")
    If ParseIdentIs(p, VarPtr(kThen)) = 0 Then
        p->err = 1
        Exit Function
    End If
    thenLine = ParseTokLine(p)
    p->pos = p->pos + 1

    lstrcpy(VarPtr(kElse), "else")
    lstrcpy(VarPtr(kElseIf), "elseif")
    lstrcpy(VarPtr(kEnd), "end")
    singleLine = 0

    If ParseTokKind(p) = TK_EOF Then
        p->err = 1
        Exit Function
    End If

    nextLine = ParseTokLine(p)
    If thenLine < nextLine Then
        thenList = ParseStmtListUntil3(p, VarPtr(kElse), VarPtr(kElseIf), VarPtr(kEnd))
        If p->err <> 0 Then Exit Function
        singleLine = 0
    Else
        ' Then と本体が同一行 → 単一行 If（後続の End If は外側のもの）
        thenList = ParseStmt(p)
        If thenList < 0 Or p->err <> 0 Then Exit Function
        singleLine = 1
    End If

    elseList = -1
    If singleLine = 0 Then
        elseList = ParseIfElseParts(p)
        If p->err <> 0 Then Exit Function
        If ParseIdentIs(p, VarPtr(kEnd)) = 0 Then
            p->err = 1
            Exit Function
        End If
        p->pos = p->pos + 1
        lstrcpy(VarPtr(kIf), "if")
        If ParseIdentIs(p, VarPtr(kIf)) = 0 Then
            p->err = 1
            Exit Function
        End If
        p->pos = p->pos + 1
    End If

    ast = p->ast
    nIf = AstAddNode(ast, AST_IF)
    If nIf < 0 Then Exit Function
    nodes = ast->nodes
    nodes[nIf].left = cond
    nodes[nIf].right = thenList
    nodes[nIf].extra = elseList
    ParseIfStmt = nIf
End Function

Function ParseSelectStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim sel As Long
    Dim val As Long
    Dim cond As Long
    Dim body As Long
    Dim nIf As Long
    Dim firstIf As Long
    Dim prevIf As Long
    Dim elseList As Long
    Dim kCase(7) As Byte
    Dim kElse(7) As Byte
    Dim kEnd(7) As Byte
    Dim kSel(15) As Byte
    Dim empty(1) As Byte

    ParseSelectStmt = -1
    p->pos = p->pos + 1
    lstrcpy(VarPtr(kCase), "case")
    If ParseIdentIs(p, VarPtr(kCase)) = 0 Then
        p->err = 1
        Exit Function
    End If
    p->pos = p->pos + 1
    sel = ParseExpr(p)
    If sel < 0 Then Exit Function

    empty[0] = 0
    lstrcpy(VarPtr(kElse), "else")
    lstrcpy(VarPtr(kEnd), "end")
    lstrcpy(VarPtr(kSel), "select")
    ast = p->ast
    firstIf = -1
    prevIf = -1

    Do
        If ParseIdentIs(p, VarPtr(kEnd)) <> 0 Then
            Exit Do
        End If
        If ParseIdentIs(p, VarPtr(kCase)) = 0 Then
            p->err = 1
            Exit Function
        End If
        p->pos = p->pos + 1
        If ParseIdentIs(p, VarPtr(kElse)) <> 0 Then
            p->pos = p->pos + 1
            elseList = ParseStmtListUntil(p, VarPtr(kEnd), VarPtr(empty))
            If p->err <> 0 Then Exit Function
            If prevIf >= 0 Then
                nodes = ast->nodes
                nodes[prevIf].extra = elseList
            Else
                firstIf = elseList
            End If
            Exit Do
        End If
        val = ParseExpr(p)
        If val < 0 Then Exit Function
        cond = AstAddNode(ast, AST_BINOP)
        If cond < 0 Then Exit Function
        nodes = ast->nodes
        nodes[cond].num = BOP_EQ
        nodes[cond].left = sel
        nodes[cond].right = val
        body = ParseStmtListUntil3(p, VarPtr(kCase), VarPtr(kEnd), VarPtr(empty))
        If p->err <> 0 Then Exit Function
        nIf = AstAddNode(ast, AST_IF)
        If nIf < 0 Then Exit Function
        nodes = ast->nodes
        nodes[nIf].left = cond
        nodes[nIf].right = body
        nodes[nIf].extra = -1
        If prevIf >= 0 Then
            nodes[prevIf].extra = nIf
        Else
            firstIf = nIf
        End If
        prevIf = nIf
    Loop

    If ParseIdentIs(p, VarPtr(kEnd)) = 0 Then
        p->err = 1
        Exit Function
    End If
    p->pos = p->pos + 1
    If ParseIdentIs(p, VarPtr(kSel)) = 0 Then
        p->err = 1
        Exit Function
    End If
    p->pos = p->pos + 1

    If firstIf < 0 Then
        firstIf = AstAddNode(ast, AST_END)
        If firstIf < 0 Then Exit Function
    End If
    ParseSelectStmt = firstIf
End Function

Function ParseDoStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nDo As Long
    Dim body As Long
    Dim cond As Long
    Dim doMode As Long
    Dim kLoop(7) As Byte
    Dim kWhile(7) As Byte
    Dim kUntil(7) As Byte
    Dim empty(1) As Byte

    ParseDoStmt = -1
    p->pos = p->pos + 1
    doMode = DO_PLAIN
    cond = -1
    lstrcpy(VarPtr(kWhile), "while")
    lstrcpy(VarPtr(kUntil), "until")
    If ParseIdentIs(p, VarPtr(kWhile)) <> 0 Then
        p->pos = p->pos + 1
        cond = ParseCond(p)
        If cond < 0 Then Exit Function
        doMode = DO_WHILE_TOP
    ElseIf ParseIdentIs(p, VarPtr(kUntil)) <> 0 Then
        p->pos = p->pos + 1
        cond = ParseCond(p)
        If cond < 0 Then Exit Function
        doMode = DO_UNTIL_TOP
    End If
    empty[0] = 0
    lstrcpy(VarPtr(kLoop), "loop")
    body = ParseStmtListUntil(p, VarPtr(kLoop), VarPtr(empty))
    If p->err <> 0 Then Exit Function
    If ParseIdentIs(p, VarPtr(kLoop)) = 0 Then
        p->err = 1
        Exit Function
    End If
    p->pos = p->pos + 1
    If doMode = DO_PLAIN Then
        If ParseIdentIs(p, VarPtr(kWhile)) <> 0 Then
            p->pos = p->pos + 1
            cond = ParseCond(p)
            If cond < 0 Then Exit Function
            doMode = DO_WHILE_BOTTOM
        ElseIf ParseIdentIs(p, VarPtr(kUntil)) <> 0 Then
            p->pos = p->pos + 1
            cond = ParseCond(p)
            If cond < 0 Then Exit Function
            doMode = DO_UNTIL_BOTTOM
        End If
    End If
    ast = p->ast
    nDo = AstAddNode(ast, AST_DO)
    If nDo < 0 Then Exit Function
    nodes = ast->nodes
    nodes[nDo].left = cond
    nodes[nDo].right = body
    nodes[nDo].extra = doMode
    ParseDoStmt = nDo
End Function

Function ParseParamType(p As *Parser, ByRef pty As Long, ByRef pti As Long, ByRef isByRef As Long, allowDblStar As Long, allowDouble As Long) As Long
    Dim k(15) As Byte
    Dim typeName(63) As Byte
    Dim types As *TypeTable
    Dim ast As *Ast

    ParseParamType = 0
    ast = p->ast
    types = ast->types
    pty = TY_LONG
    pti = -1
    lstrcpy(VarPtr(k), "byte")
    If ParseTokKind(p) = TK_STAR Then
        p->pos = p->pos + 1
        If allowDblStar <> 0 Then
            If ParseTokKind(p) = TK_STAR Then
                p->pos = p->pos + 1
                isByRef = 1
            End If
        End If
        If ParseIdentIs(p, VarPtr(k)) <> 0 Then
            p->pos = p->pos + 1
            pty = TY_PTR_BYTE
            ParseParamType = 1
            Exit Function
        End If
        If ParseCopyIdent(p, VarPtr(typeName)) = 0 Then Exit Function
        pti = TyFind(types, VarPtr(typeName))
        If pti < 0 Then
            p->err = 1
            Exit Function
        End If
        pty = TY_PTR_UDT
        ParseParamType = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "long")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p->pos = p->pos + 1
        pty = TY_LONG
        ParseParamType = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "string")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p->pos = p->pos + 1
        pty = TY_STRING
        ParseParamType = 1
        Exit Function
    End If
    If allowDouble <> 0 Then
        lstrcpy(VarPtr(typeName), "double")
        If ParseIdentIs(p, VarPtr(typeName)) <> 0 Then
            p->pos = p->pos + 1
            pty = TY_DOUBLE
            ParseParamType = 1
            Exit Function
        End If
    End If
    If ParseEatLongAlias(p) <> 0 Then
        pty = TY_LONG
        ParseParamType = 1
        Exit Function
    End If
    If ParseCopyIdent(p, VarPtr(typeName)) = 0 Then
        p->err = 1
        Exit Function
    End If
    pti = TyFind(types, VarPtr(typeName))
    If pti < 0 Then
        p->err = 1
        Exit Function
    End If
    pty = TY_UDT
    ParseParamType = 1
End Function

Function ParseParamList(p As *Parser, ByRef nFirst As Long, ByRef nParams As Long, allowDblStar As Long, allowDouble As Long) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim k(15) As Byte
    Dim pname(63) As Byte
    Dim nParam As Long
    Dim nPrev As Long
    Dim isByRef As Long
    Dim pty As Long
    Dim pti As Long

    ParseParamList = 0
    ast = p->ast
    nFirst = -1
    nPrev = -1
    nParams = 0
    lstrcpy(VarPtr(k), "byref")
    If ParseTokKind(p) <> TK_RPAREN Then
        Do
            isByRef = 0
            If ParseIdentIs(p, VarPtr(k)) <> 0 Then
                p->pos = p->pos + 1
                isByRef = 1
            Else
                lstrcpy(VarPtr(k), "byval")
                If ParseIdentIs(p, VarPtr(k)) <> 0 Then
                    p->pos = p->pos + 1
                End If
            End If
            If ParseCopyIdent(p, VarPtr(pname)) = 0 Then Exit Function
            lstrcpy(VarPtr(k), "as")
            If ParseIdentIs(p, VarPtr(k)) = 0 Then
                p->err = 1
                Exit Function
            End If
            p->pos = p->pos + 1
            If ParseParamType(p, pty, pti, isByRef, allowDblStar, allowDouble) = 0 Then Exit Function
            nParam = AstAddNode(ast, AST_VAR)
            If nParam < 0 Then Exit Function
            AstSetStr(ast, nParam, VarPtr(pname))
            nodes = ast->nodes
            nodes[nParam].num = isByRef
            nodes[nParam].extra = pty
            nodes[nParam].right = pti
            If nFirst < 0 Then
                nFirst = nParam
            Else
                nodes[nPrev].nxt = nParam
            End If
            nPrev = nParam
            nParams = nParams + 1
            If ParseTokKind(p) <> TK_COMMA Then Exit Do
            p->pos = p->pos + 1
            lstrcpy(VarPtr(k), "byref")
        Loop
    End If
    If ParseExpect(p, TK_RPAREN) = 0 Then Exit Function
    ParseParamList = 1
End Function

Function ParseFuncRetType(p As *Parser, ByRef retTy As Long) As Long
    Dim k(15) As Byte
    Dim typeName(63) As Byte
    Dim pti As Long
    Dim types As *TypeTable
    Dim ast As *Ast

    ParseFuncRetType = 0
    ast = p->ast
    types = ast->types
    retTy = TY_LONG
    lstrcpy(VarPtr(k), "long")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p->pos = p->pos + 1
        retTy = TY_LONG
        ParseFuncRetType = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "string")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p->pos = p->pos + 1
        retTy = TY_STRING
        ParseFuncRetType = 1
        Exit Function
    End If
    If ParseTokKind(p) = TK_STAR Then
        p->pos = p->pos + 1
        lstrcpy(VarPtr(k), "byte")
        If ParseIdentIs(p, VarPtr(k)) <> 0 Then
            p->pos = p->pos + 1
            retTy = TY_PTR_BYTE
            ParseFuncRetType = 1
            Exit Function
        End If
        If ParseCopyIdent(p, VarPtr(typeName)) = 0 Then Exit Function
        pti = TyFind(types, VarPtr(typeName))
        If pti < 0 Then
            p->err = 1
            Exit Function
        End If
        retTy = TY_PTR_UDT
        ParseFuncRetType = 1
        Exit Function
    End If
    lstrcpy(VarPtr(typeName), "double")
    If ParseIdentIs(p, VarPtr(typeName)) <> 0 Then
        p->pos = p->pos + 1
        retTy = TY_DOUBLE
        ParseFuncRetType = 1
        Exit Function
    End If
    If ParseEatLongAlias(p) <> 0 Then
        retTy = TY_LONG
        ParseFuncRetType = 1
        Exit Function
    End If
    p->err = 1
End Function

Function ParseSubStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nFunc As Long
    Dim name(63) As Byte
    Dim nFirst As Long
    Dim body As Long
    Dim kEnd(7) As Byte
    Dim kSub(7) As Byte
    Dim empty(1) As Byte
    Dim nParams As Long

    ParseSubStmt = -1
    p->pos = p->pos + 1
    If ParseCopyIdent(p, VarPtr(name)) = 0 Then Exit Function
    If ParseExpect(p, TK_LPAREN) = 0 Then Exit Function
    ast = p->ast
    If ParseParamList(p, nFirst, nParams, 0, 1) = 0 Then Exit Function
    empty[0] = 0
    lstrcpy(VarPtr(kEnd), "end")
    lstrcpy(VarPtr(kSub), "sub")
    body = ParseStmtListUntilEndPair(p, VarPtr(kSub))
    If p->err <> 0 Then Exit Function
    If ParseIdentIs(p, VarPtr(kEnd)) = 0 Then
        p->err = 1
        Exit Function
    End If
    p->pos = p->pos + 1
    If ParseIdentIs(p, VarPtr(kSub)) = 0 Then
        p->err = 1
        Exit Function
    End If
    p->pos = p->pos + 1
    nFunc = AstAddNode(ast, AST_FUNC)
    If nFunc < 0 Then Exit Function
    AstSetStr(ast, nFunc, VarPtr(name))
    nodes = ast->nodes
    nodes[nFunc].left = nFirst
    nodes[nFunc].right = body
    nodes[nFunc].num = nParams Or 256
    ParseSubStmt = nFunc
End Function

Function ParseWhileStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nWhile As Long
    Dim cond As Long
    Dim body As Long
    Dim kWend(7) As Byte
    Dim empty(1) As Byte

    ParseWhileStmt = -1
    p->pos = p->pos + 1
    cond = ParseCond(p)
    If cond < 0 Then Exit Function
    empty[0] = 0
    lstrcpy(VarPtr(kWend), "wend")
    body = ParseStmtListUntil(p, VarPtr(kWend), VarPtr(empty))
    If p->err <> 0 Then Exit Function
    If ParseIdentIs(p, VarPtr(kWend)) = 0 Then
        p->err = 1
        Exit Function
    End If
    p->pos = p->pos + 1

    ast = p->ast
    nWhile = AstAddNode(ast, AST_WHILE)
    If nWhile < 0 Then Exit Function
    nodes = ast->nodes
    nodes[nWhile].left = cond
    nodes[nWhile].right = body
    ParseWhileStmt = nWhile
End Function

Function ParseForStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nFor As Long
    Dim name(63) As Byte
    Dim nVar As Long
    Dim fromE As Long
    Dim toE As Long
    Dim stepE As Long
    Dim body As Long
    Dim kTo(7) As Byte
    Dim kStep(7) As Byte
    Dim kNext(7) As Byte
    Dim empty(1) As Byte

    ParseForStmt = -1
    p->pos = p->pos + 1
    If ParseCopyIdent(p, VarPtr(name)) = 0 Then Exit Function
    If ParseExpect(p, TK_EQ) = 0 Then Exit Function
    fromE = ParseExpr(p)
    If fromE < 0 Then Exit Function
    lstrcpy(VarPtr(kTo), "to")
    If ParseIdentIs(p, VarPtr(kTo)) = 0 Then
        p->err = 1
        Exit Function
    End If
    p->pos = p->pos + 1
    toE = ParseExpr(p)
    If toE < 0 Then Exit Function
    ast = p->ast
    stepE = ParseMakeNum(ast, 1)
    If stepE < 0 Then Exit Function
    lstrcpy(VarPtr(kStep), "step")
    If ParseIdentIs(p, VarPtr(kStep)) <> 0 Then
        p->pos = p->pos + 1
        stepE = ParseExpr(p)
        If stepE < 0 Then Exit Function
    End If

    empty[0] = 0
    lstrcpy(VarPtr(kNext), "next")
    body = ParseStmtListUntil(p, VarPtr(kNext), VarPtr(empty))
    If p->err <> 0 Then Exit Function
    If ParseIdentIs(p, VarPtr(kNext)) = 0 Then
        p->err = 1
        Exit Function
    End If
    p->pos = p->pos + 1

    nVar = AstAddNode(ast, AST_VAR)
    If nVar < 0 Then Exit Function
    AstSetStr(ast, nVar, VarPtr(name))
    nFor = AstAddNode(ast, AST_FOR)
    If nFor < 0 Then Exit Function
    nodes = ast->nodes
    nodes[nFor].left = nVar
    nodes[nFor].right = fromE
    nodes[nFor].extra = toE
    nodes[nFor].num = body
    nodes[nFor].strId = stepE
    ParseForStmt = nFor
End Function

Function ParseWithStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nWith As Long
    Dim expr As Long
    Dim body As Long
    Dim kEnd(7) As Byte
    Dim kWith(7) As Byte
    Dim saveBase As Long

    ParseWithStmt = -1
    p->pos = p->pos + 1
    expr = ParseExpr(p)
    If expr < 0 Then Exit Function
    saveBase = p->withBase
    p->withBase = expr
    lstrcpy(VarPtr(kWith), "with")
    body = ParseStmtListUntilEndPair(p, VarPtr(kWith))
    p->withBase = saveBase
    If p->err <> 0 Then Exit Function
    lstrcpy(VarPtr(kEnd), "end")
    If ParseIdentIs(p, VarPtr(kEnd)) = 0 Then
        p->err = 1
        Exit Function
    End If
    p->pos = p->pos + 1
    If ParseIdentIs(p, VarPtr(kWith)) = 0 Then
        p->err = 1
        Exit Function
    End If
    p->pos = p->pos + 1
    ast = p->ast
    nWith = AstAddNode(ast, AST_WITH)
    If nWith < 0 Then Exit Function
    nodes = ast->nodes
    nodes[nWith].left = expr
    nodes[nWith].right = body
    ParseWithStmt = nWith
End Function

Function ParseFuncStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nFunc As Long
    Dim name(63) As Byte
    Dim nFirst As Long
    Dim body As Long
    Dim kAs(7) As Byte
    Dim kEnd(7) As Byte
    Dim kFun(15) As Byte
    Dim empty(1) As Byte
    Dim nParams As Long
    Dim retTy As Long

    ParseFuncStmt = -1
    p->pos = p->pos + 1
    If ParseCopyIdent(p, VarPtr(name)) = 0 Then Exit Function
    If ParseExpect(p, TK_LPAREN) = 0 Then Exit Function
    ast = p->ast
    If ParseParamList(p, nFirst, nParams, 1, 1) = 0 Then Exit Function
    lstrcpy(VarPtr(kAs), "as")
    If ParseIdentIs(p, VarPtr(kAs)) = 0 Then
        p->err = 1
        Exit Function
    End If
    p->pos = p->pos + 1
    If ParseFuncRetType(p, retTy) = 0 Then Exit Function
    empty[0] = 0
    lstrcpy(VarPtr(kEnd), "end")
    lstrcpy(VarPtr(kFun), "function")
    body = ParseStmtListUntilEndPair(p, VarPtr(kFun))
    If p->err <> 0 Then Exit Function
    If ParseIdentIs(p, VarPtr(kEnd)) = 0 Then
        p->err = 1
        Exit Function
    End If
    p->pos = p->pos + 1
    If ParseIdentIs(p, VarPtr(kFun)) = 0 Then
        p->err = 1
        Exit Function
    End If
    p->pos = p->pos + 1
    nFunc = AstAddNode(ast, AST_FUNC)
    If nFunc < 0 Then Exit Function
    AstSetStr(ast, nFunc, VarPtr(name))
    nodes = ast->nodes
    nodes[nFunc].left = nFirst
    nodes[nFunc].right = body
    nodes[nFunc].num = nParams
    nodes[nFunc].extra = retTy
    ParseFuncStmt = nFunc
End Function

' Declare Function|Sub Name Lib "dll" [Alias "api"] (params) [As Type]
Function ParseDeclareHdr(p As *Parser, name As *Byte, libName As *Byte, apiName As *Byte, ByRef isSub As Long) As Long
    Dim k(15) As Byte

    ParseDeclareHdr = 0
    isSub = 0
    lstrcpy(VarPtr(k), "function")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p->pos = p->pos + 1
    Else
        lstrcpy(VarPtr(k), "sub")
        If ParseIdentIs(p, VarPtr(k)) <> 0 Then
            p->pos = p->pos + 1
            isSub = 1
        Else
            p->err = 1
            Exit Function
        End If
    End If
    If ParseCopyIdent(p, name) = 0 Then Exit Function
    lstrcpy(VarPtr(k), "lib")
    If ParseIdentIs(p, VarPtr(k)) = 0 Then
        p->err = 1
        Exit Function
    End If
    p->pos = p->pos + 1
    If ParseStringArg(p, libName) = 0 Then Exit Function
    lstrcpy(VarPtr(k), "alias")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p->pos = p->pos + 1
        If ParseStringArg(p, apiName) = 0 Then Exit Function
    Else
        lstrcpy(apiName, name)
    End If
    If ParseExpect(p, TK_LPAREN) = 0 Then Exit Function
    ParseDeclareHdr = 1
End Function

Function ParseDeclareRetSkip(p As *Parser) As Long
    Dim k(15) As Byte
    Dim typeName(63) As Byte

    ParseDeclareRetSkip = 0
    lstrcpy(VarPtr(k), "as")
    If ParseIdentIs(p, VarPtr(k)) = 0 Then
        ParseDeclareRetSkip = 1
        Exit Function
    End If
    p->pos = p->pos + 1
    lstrcpy(VarPtr(k), "long")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p->pos = p->pos + 1
        ParseDeclareRetSkip = 1
        Exit Function
    End If
    lstrcpy(VarPtr(k), "string")
    If ParseIdentIs(p, VarPtr(k)) <> 0 Then
        p->pos = p->pos + 1
        ParseDeclareRetSkip = 1
        Exit Function
    End If
    If ParseTokKind(p) = TK_STAR Then
        p->pos = p->pos + 1
        If ParseTokKind(p) = TK_STAR Then
            p->pos = p->pos + 1
        End If
        lstrcpy(VarPtr(k), "byte")
        If ParseIdentIs(p, VarPtr(k)) <> 0 Then
            p->pos = p->pos + 1
        Else
            If ParseCopyIdent(p, VarPtr(typeName)) = 0 Then Exit Function
        End If
        ParseDeclareRetSkip = 1
        Exit Function
    End If
    lstrcpy(VarPtr(typeName), "double")
    If ParseIdentIs(p, VarPtr(typeName)) <> 0 Then
        p->pos = p->pos + 1
        ParseDeclareRetSkip = 1
        Exit Function
    End If
    If ParseEatLongAlias(p) <> 0 Then
        ParseDeclareRetSkip = 1
        Exit Function
    End If
    If ParseCopyIdent(p, VarPtr(typeName)) = 0 Then Exit Function
    ParseDeclareRetSkip = 1
End Function

Function ParseDeclareStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nDecl As Long
    Dim nDll As Long
    Dim nApi As Long
    Dim nFirst As Long
    Dim nParams As Long
    Dim name(63) As Byte
    Dim libName(63) As Byte
    Dim apiName(63) As Byte
    Dim isSub As Long

    ParseDeclareStmt = -1
    p->pos = p->pos + 1
    ast = p->ast
    If ParseDeclareHdr(p, VarPtr(name), VarPtr(libName), VarPtr(apiName), isSub) = 0 Then Exit Function
    If ParseParamList(p, nFirst, nParams, 1, 1) = 0 Then Exit Function
    If isSub = 0 Then
        If ParseDeclareRetSkip(p) = 0 Then Exit Function
    End If
    nDll = AstAddNode(ast, AST_STRING)
    If nDll < 0 Then Exit Function
    AstSetStr(ast, nDll, VarPtr(libName))
    nApi = AstAddNode(ast, AST_STRING)
    If nApi < 0 Then Exit Function
    AstSetStr(ast, nApi, VarPtr(apiName))
    nDecl = AstAddNode(ast, AST_DECLARE)
    If nDecl < 0 Then Exit Function
    AstSetStr(ast, nDecl, VarPtr(name))
    nodes = ast->nodes
    nodes[nDecl].left = nFirst
    nodes[nDecl].right = nDll
    nodes[nDecl].extra = nApi
    nodes[nDecl].num = nParams
    ParseDeclareStmt = nDecl
End Function

' InsMenu hMenu, pos, flags [, caption [, id [, hSubMenu [, ignored]]]]
Function ParseInsMenuStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nIns As Long
    Dim nArg As Long
    Dim nFirst As Long
    Dim nPrev As Long
    Dim nArgs As Long
    Dim e As Long
    Dim kEx(7) As Byte
    Dim s(255) As Byte

    ParseInsMenuStmt = -1
    p->pos = p->pos + 1
    ast = p->ast
    lstrcpy(VarPtr(kEx), "ex")
    nFirst = -1
    nPrev = -1
    nArgs = 0
    Do
        e = -1
        If ParseIdentIs(p, VarPtr(kEx)) <> 0 Then
            If ParseTokKindAt(p, p->pos + 1) = TK_STRING Then
                p->pos = p->pos + 1
                If ParseStringArg(p, VarPtr(s)) = 0 Then Exit Function
                e = AstAddNode(ast, AST_STRING)
                If e < 0 Then Exit Function
                AstSetStr(ast, e, VarPtr(s))
            End If
        End If
        If e < 0 Then
            e = ParseExpr(p)
            If e < 0 Then Exit Function
        End If
        nArg = AstAddNode(ast, AST_ARG)
        If nArg < 0 Then Exit Function
        nodes = ast->nodes
        nodes[nArg].left = e
        If nFirst < 0 Then
            nFirst = nArg
        Else
            nodes[nPrev].nxt = nArg
        End If
        nPrev = nArg
        nArgs = nArgs + 1
        If ParseTokKind(p) <> TK_COMMA Then Exit Do
        p->pos = p->pos + 1
    Loop
    If nArgs < 3 Then
        p->err = 1
        Exit Function
    End If
    nIns = AstAddNode(ast, AST_INSMENU)
    If nIns < 0 Then Exit Function
    nodes = ast->nodes
    nodes[nIns].left = nFirst
    nodes[nIns].num = nArgs
    ParseInsMenuStmt = nIns
End Function

