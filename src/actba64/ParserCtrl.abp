' ===================================================
'  ParserCtrl - If / loops / Func / Declare
' ===================================================

Function ParseIfElseIfBody(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nIf As Long
    Dim cond As Long
    Dim thenList As Long
    Dim elseList As Long
    Dim kThen(7) As Byte
    Dim kElse(7) As Byte
    Dim kElseIf(15) As Byte
    Dim kEnd(7) As Byte

    ParseIfElseIfBody = -1
    p->pos = p->pos + 1
    cond = ParseCond(p)
    If cond < 0 Then Exit Function
    lstrcpy(VarPtr(kThen), "then")
    If ParseIdentIs(p, VarPtr(kThen)) = 0 Then
        p->err = 1
        Exit Function
    End If
    p->pos = p->pos + 1
    lstrcpy(VarPtr(kElse), "else")
    lstrcpy(VarPtr(kElseIf), "elseif")
    lstrcpy(VarPtr(kEnd), "end")
    thenList = ParseStmtListUntil3(p, VarPtr(kElse), VarPtr(kElseIf), VarPtr(kEnd))
    If p->err <> 0 Then Exit Function
    elseList = ParseIfElseParts(p)
    If p->err <> 0 Then Exit Function
    ast = p->ast
    nIf = AstAddNode(ast, AST_IF)
    If nIf < 0 Then Exit Function
    nodes = ast->nodes
    nodes[nIf].left = cond
    nodes[nIf].right = thenList
    nodes[nIf].extra = elseList
    ParseIfElseIfBody = nIf
End Function

Function ParseIfElseParts(p As *Parser) As Long
    Dim elseList As Long
    Dim kElse(7) As Byte
    Dim kElseIf(15) As Byte
    Dim kEnd(7) As Byte
    Dim empty(1) As Byte

    ParseIfElseParts = -1
    empty[0] = 0
    lstrcpy(VarPtr(kElseIf), "elseif")
    lstrcpy(VarPtr(kElse), "else")
    lstrcpy(VarPtr(kEnd), "end")

    If ParseIdentIs(p, VarPtr(kElseIf)) <> 0 Then
        ParseIfElseParts = ParseIfElseIfBody(p)
        Exit Function
    End If

    If ParseIdentIs(p, VarPtr(kElse)) <> 0 Then
        p->pos = p->pos + 1
        elseList = ParseStmtListUntil(p, VarPtr(kEnd), VarPtr(empty))
        If p->err <> 0 Then Exit Function
        ParseIfElseParts = elseList
        Exit Function
    End If

    ParseIfElseParts = -1
End Function

Function ParseExitLoopArm(p As *Parser) As Long
    Dim ast As *Ast
    Dim n As Long
    Dim kDo(7) As Byte
    Dim kWhile(15) As Byte
    Dim kFor(7) As Byte

    ParseExitLoopArm = -2
    lstrcpy(VarPtr(kDo), "do")
    lstrcpy(VarPtr(kWhile), "while")
    lstrcpy(VarPtr(kFor), "for")
    If ParseIdentIs(p, VarPtr(kDo)) <> 0 Then
        p->pos = p->pos + 1
        ast = p->ast
        n = AstAddNode(ast, AST_EXITDO)
        If n < 0 Then
            ParseExitLoopArm = -1
            Exit Function
        End If
        ParseExitLoopArm = n
        Exit Function
    End If
    If ParseIdentIs(p, VarPtr(kWhile)) <> 0 Then
        p->pos = p->pos + 1
        ast = p->ast
        n = AstAddNode(ast, AST_EXITWHILE)
        If n < 0 Then
            ParseExitLoopArm = -1
            Exit Function
        End If
        ParseExitLoopArm = n
        Exit Function
    End If
    If ParseIdentIs(p, VarPtr(kFor)) <> 0 Then
        p->pos = p->pos + 1
        ast = p->ast
        n = AstAddNode(ast, AST_EXITFOR)
        If n < 0 Then
            ParseExitLoopArm = -1
            Exit Function
        End If
        ParseExitLoopArm = n
    End If
End Function

Function ParseExitProcArm(p As *Parser) As Long
    Dim ast As *Ast
    Dim n As Long
    Dim kFun(15) As Byte
    Dim kSub(7) As Byte

    ParseExitProcArm = -2
    lstrcpy(VarPtr(kFun), "function")
    lstrcpy(VarPtr(kSub), "sub")
    If ParseIdentIs(p, VarPtr(kFun)) <> 0 Then
        p->pos = p->pos + 1
        ast = p->ast
        n = AstAddNode(ast, AST_EXITFUNC)
        If n < 0 Then
            ParseExitProcArm = -1
            Exit Function
        End If
        ParseExitProcArm = n
        Exit Function
    End If
    If ParseIdentIs(p, VarPtr(kSub)) <> 0 Then
        p->pos = p->pos + 1
        ast = p->ast
        n = AstAddNode(ast, AST_EXITFUNC)
        If n < 0 Then
            ParseExitProcArm = -1
            Exit Function
        End If
        ParseExitProcArm = n
    End If
End Function

Function ParseExitKwStmt(p As *Parser) As Long
    Dim n As Long

    ParseExitKwStmt = -1
    p->pos = p->pos + 1
    n = ParseExitLoopArm(p)
    If n <> -2 Then
        ParseExitKwStmt = n
        Exit Function
    End If
    n = ParseExitProcArm(p)
    If n <> -2 Then
        ParseExitKwStmt = n
        Exit Function
    End If
    p->err = 1
End Function

Function ParseContinueKwStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim n As Long
    Dim kDo(7) As Byte
    Dim kWhile(15) As Byte
    Dim kFor(7) As Byte

    ParseContinueKwStmt = -1
    p->pos = p->pos + 1
    lstrcpy(VarPtr(kDo), "do")
    lstrcpy(VarPtr(kWhile), "while")
    lstrcpy(VarPtr(kFor), "for")
    If ParseIdentIs(p, VarPtr(kDo)) <> 0 Then
        p->pos = p->pos + 1
        ast = p->ast
        n = AstAddNode(ast, AST_CONTINUEDO)
        If n < 0 Then Exit Function
        ParseContinueKwStmt = n
        Exit Function
    End If
    If ParseIdentIs(p, VarPtr(kWhile)) <> 0 Then
        p->pos = p->pos + 1
        ast = p->ast
        n = AstAddNode(ast, AST_CONTINUEWHILE)
        If n < 0 Then Exit Function
        ParseContinueKwStmt = n
        Exit Function
    End If
    If ParseIdentIs(p, VarPtr(kFor)) <> 0 Then
        p->pos = p->pos + 1
        ast = p->ast
        n = AstAddNode(ast, AST_CONTINUEFOR)
        If n < 0 Then Exit Function
        ParseContinueKwStmt = n
        Exit Function
    End If
    p->err = 1
End Function

Function ParseIfThenClause(p As *Parser, thenLine As Long, ByRef thenList As Long, ByRef singleLine As Long) As Long
    Dim kElse(7) As Byte
    Dim kElseIf(15) As Byte
    Dim kEnd(7) As Byte
    Dim nextLine As Long

    ParseIfThenClause = 0
    lstrcpy(VarPtr(kElse), "else")
    lstrcpy(VarPtr(kElseIf), "elseif")
    lstrcpy(VarPtr(kEnd), "end")
    singleLine = 0

    If ParseTokKind(p) = TK_EOF Then
        ParseFail(p, "expected statement after Then")
        Exit Function
    End If

    nextLine = ParseTokLine(p)
    If thenLine < nextLine Then
        thenList = ParseStmtListUntil3(p, VarPtr(kElse), VarPtr(kElseIf), VarPtr(kEnd))
        If p->err <> 0 Then Exit Function
        singleLine = 0
    Else
        ' Then と本体が同一行 → 単一行 If（後続の End If は外側のもの）
        thenList = ParseStmt(p)
        If thenList < 0 Or p->err <> 0 Then Exit Function
        singleLine = 1
    End If
    ParseIfThenClause = 1
End Function

Function ParseIfEndClause(p As *Parser, ifLine As Long, singleLine As Long, ByRef elseList As Long) As Long
    Dim kEnd(7) As Byte
    Dim kIf(7) As Byte

    ParseIfEndClause = 0
    elseList = -1
    If singleLine = 0 Then
        elseList = ParseIfElseParts(p)
        If p->err <> 0 Then Exit Function
        lstrcpy(VarPtr(kEnd), "end")
        If ParseIdentIs(p, VarPtr(kEnd)) = 0 Then
            DiagError(ifLine, "expected 'End If'")
            p->err = 1
            Exit Function
        End If
        p->pos = p->pos + 1
        lstrcpy(VarPtr(kIf), "if")
        If ParseIdentIs(p, VarPtr(kIf)) = 0 Then
            DiagError(ifLine, "expected 'End If'")
            p->err = 1
            Exit Function
        End If
        p->pos = p->pos + 1
    End If
    ParseIfEndClause = 1
End Function

Function ParseIfStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nIf As Long
    Dim cond As Long
    Dim thenList As Long
    Dim elseList As Long
    Dim kThen(7) As Byte
    Dim singleLine As Long
    Dim thenLine As Long
    Dim ifLine As Long

    ParseIfStmt = -1
    ifLine = ParseTokLine(p)
    p->pos = p->pos + 1
    cond = ParseCond(p)
    If cond < 0 Then Exit Function
    lstrcpy(VarPtr(kThen), "then")
    If ParseIdentIs(p, VarPtr(kThen)) = 0 Then
        DiagError(ifLine, "expected 'Then' after condition")
        p->err = 1
        Exit Function
    End If
    thenLine = ParseTokLine(p)
    p->pos = p->pos + 1
    If ParseIfThenClause(p, thenLine, thenList, singleLine) = 0 Then Exit Function
    If ParseIfEndClause(p, ifLine, singleLine, elseList) = 0 Then Exit Function

    ast = p->ast
    nIf = AstAddNode(ast, AST_IF)
    If nIf < 0 Then Exit Function
    nodes = ast->nodes
    nodes[nIf].left = cond
    nodes[nIf].right = thenList
    nodes[nIf].extra = elseList
    ParseIfStmt = nIf
End Function

Function ParseDoHeadCond(p As *Parser, ByRef cond As Long, ByRef doMode As Long) As Long
    Dim kWhile(7) As Byte
    Dim kUntil(7) As Byte

    ParseDoHeadCond = 0
    doMode = DO_PLAIN
    cond = -1
    lstrcpy(VarPtr(kWhile), "while")
    lstrcpy(VarPtr(kUntil), "until")
    If ParseIdentIs(p, VarPtr(kWhile)) <> 0 Then
        p->pos = p->pos + 1
        cond = ParseCond(p)
        If cond < 0 Then Exit Function
        doMode = DO_WHILE_TOP
    ElseIf ParseIdentIs(p, VarPtr(kUntil)) <> 0 Then
        p->pos = p->pos + 1
        cond = ParseCond(p)
        If cond < 0 Then Exit Function
        doMode = DO_UNTIL_TOP
    End If
    ParseDoHeadCond = 1
End Function

Function ParseDoTailCond(p As *Parser, ByRef cond As Long, ByRef doMode As Long) As Long
    Dim kWhile(7) As Byte
    Dim kUntil(7) As Byte

    ParseDoTailCond = 0
    If doMode = DO_PLAIN Then
        lstrcpy(VarPtr(kWhile), "while")
        lstrcpy(VarPtr(kUntil), "until")
        If ParseIdentIs(p, VarPtr(kWhile)) <> 0 Then
            p->pos = p->pos + 1
            cond = ParseCond(p)
            If cond < 0 Then Exit Function
            doMode = DO_WHILE_BOTTOM
        ElseIf ParseIdentIs(p, VarPtr(kUntil)) <> 0 Then
            p->pos = p->pos + 1
            cond = ParseCond(p)
            If cond < 0 Then Exit Function
            doMode = DO_UNTIL_BOTTOM
        End If
    End If
    ParseDoTailCond = 1
End Function

Function ParseDoStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim nDo As Long
    Dim body As Long
    Dim cond As Long
    Dim doMode As Long
    Dim kLoop(7) As Byte
    Dim empty(1) As Byte

    ParseDoStmt = -1
    p->pos = p->pos + 1
    If ParseDoHeadCond(p, cond, doMode) = 0 Then Exit Function
    empty[0] = 0
    lstrcpy(VarPtr(kLoop), "loop")
    body = ParseStmtListUntil(p, VarPtr(kLoop), VarPtr(empty))
    If p->err <> 0 Then Exit Function
    If ParseIdentIs(p, VarPtr(kLoop)) = 0 Then
        p->err = 1
        Exit Function
    End If
    p->pos = p->pos + 1
    If ParseDoTailCond(p, cond, doMode) = 0 Then Exit Function
    ast = p->ast
    nDo = AstAddNode(ast, AST_DO)
    If nDo < 0 Then Exit Function
    nodes = ast->nodes
    nodes[nDo].left = cond
    nodes[nDo].right = body
    nodes[nDo].extra = doMode
    ParseDoStmt = nDo
End Function
