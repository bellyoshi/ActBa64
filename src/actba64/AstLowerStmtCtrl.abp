' ===================================================
'  AstLowerStmtCtrl - Field/Get/Put / loops / Heavy / reg
' ===================================================

Function LowEmitToStringRax(ctx As *LowerCtx, exprIdx As Long) As Long
    Dim name(63) As Byte
    Dim lab As Long
    Dim ety As Long

    LowEmitToStringRax = 0
    If LowIsStringExpr(ctx, exprIdx) <> 0 Then
        If LowExpr(ctx, exprIdx) = 0 Then Exit Function
        LowEmitToStringRax = 1
        Exit Function
    End If
    ety = LowExprType(ctx, exprIdx)
    If ety = TY_DOUBLE And TyIs32() = 0 Then
        lstrcpy(VarPtr(name), "StrD$")
        lab = LowFindFunc(ctx, VarPtr(name))
        If lab < 0 Then
            Print "error: missing 'StrD$'"
            ctx->err = 1
            Exit Function
        End If
        If LowExpr(ctx, exprIdx) = 0 Then Exit Function
        LowEmitCall1Rax(ctx->list, 0, 0, VarPtr(name), lab)
    Else
        lab = LowEnsureRtStr(ctx)
        If LowExpr(ctx, exprIdx) = 0 Then Exit Function
        LowEmitCall1Rax(ctx->list, 0, 0, 0, lab)
    End If
    LowEmitToStringRax = 1
End Function

Function LowStmtField(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim lab As Long
    Dim list As *IrList

    LowStmtField = 0
    ast = ctx->ast
    nodes = ast->nodes
    list = ctx->list
    lstrcpy(VarPtr(name), "BaFileField")
    lab = LowFindFunc(ctx, VarPtr(name))
    If lab < 0 Then
        Print "error: missing 'BaFileField'"
        ctx->err = 1
        Exit Function
    End If
    If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
    IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    LowEmitCallLab2(list, lab)
    LowStmtField = 1
End Function

Function LowStmtGet(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim lab As Long
    Dim list As *IrList
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim varIdx As Long

    LowStmtGet = 0
    ast = ctx->ast
    nodes = ast->nodes
    list = ctx->list
    lstrcpy(VarPtr(name), "BaFileGet$")
    lab = LowFindFunc(ctx, VarPtr(name))
    If lab < 0 Then
        Print "error: missing 'BaFileGet$'"
        ctx->err = 1
        Exit Function
    End If
    varIdx = nodes[idx].extra
    If varIdx < 0 Then
        ctx->err = 1
        Exit Function
    End If
    AstCopyStr(ast, varIdx, VarPtr(name))
    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
        ctx->err = 1
        Exit Function
    End If
    If vTy <> TY_STRING Then
        Print "error: Get # needs String variable"
        ctx->err = 1
        Exit Function
    End If
    If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
    IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    LowEmitCallLab2(list, lab)
    If vByRef <> 0 Then
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        LowEmitLoadOff(list, vOff, vGlob)
        IrEmit(list, OP_POP_RCX, 0, 0)
        IrEmit(list, OP_STORE_QWORD_RAX_RCX, 0, 0)
    Else
        LowEmitStoreString(ctx, vOff, vGlob)
    End If
    LowEmitStrCollectSafepoint(ctx)
    LowStmtGet = 1
End Function

Function LowStmtPut(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim lab As Long
    Dim list As *IrList

    LowStmtPut = 0
    ast = ctx->ast
    nodes = ast->nodes
    list = ctx->list
    lstrcpy(VarPtr(name), "BaFilePut")
    lab = LowFindFunc(ctx, VarPtr(name))
    If lab < 0 Then
        Print "error: missing 'BaFilePut'"
        ctx->err = 1
        Exit Function
    End If
    If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    If LowEmitToStringRax(ctx, nodes[idx].extra) = 0 Then Exit Function
    If TyIs32() <> 0 Then
        IrEmit(list, OP_POP_RDX, 0, 0)
        IrEmit(list, OP_POP_RCX, 0, 0)
    Else
        IrEmit(list, OP_MOV_R8_RAX, 0, 0)
        IrEmit(list, OP_POP_RAX, 0, 0)
        IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
        IrEmit(list, OP_POP_RCX, 0, 0)
    End If
    LowEmitCallLab3(list, lab)
    LowEmitStrCollectSafepoint(ctx)
    LowStmtPut = 1
End Function

Function LowStmtWrite(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim labItem As Long
    Dim labComma As Long
    Dim labNl As Long
    Dim list As *IrList
    Dim cur As Long
    Dim first As Long

    LowStmtWrite = 0
    ast = ctx->ast
    nodes = ast->nodes
    list = ctx->list
    lstrcpy(VarPtr(name), "BaFileWriteItem")
    labItem = LowFindFunc(ctx, VarPtr(name))
    lstrcpy(VarPtr(name), "BaFileWriteComma")
    labComma = LowFindFunc(ctx, VarPtr(name))
    lstrcpy(VarPtr(name), "BaFileWriteNl")
    labNl = LowFindFunc(ctx, VarPtr(name))
    If labItem < 0 Or labComma < 0 Or labNl < 0 Then
        Print "error: missing BaFileWrite*"
        ctx->err = 1
        Exit Function
    End If

    first = 1
    cur = nodes[idx].right
    While cur >= 0
        If first = 0 Then
            If nodes[idx].left < 0 Then
                IrEmit(list, OP_MOV_EAX_IMM, 0, 0)
            Else
                If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
            End If
            LowEmitCall1Rax(list, 0, 0, 0, labComma)
        End If
        first = 0
        If LowEmitToStringRax(ctx, nodes[cur].left) = 0 Then Exit Function
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        If nodes[idx].left < 0 Then
            IrEmit(list, OP_MOV_EAX_IMM, 0, 0)
        Else
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        End If
        IrEmit(list, OP_MOV_RCX_RAX, 0, 0)
        IrEmit(list, OP_POP_RAX, 0, 0)
        IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
        LowEmitCallLab2(list, labItem)
        cur = nodes[cur].nxt
    Wend
    If nodes[idx].num = 0 Then
        If nodes[idx].left < 0 Then
            IrEmit(list, OP_MOV_EAX_IMM, 0, 0)
        Else
            If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        End If
        LowEmitCall1Rax(list, 0, 0, 0, labNl)
    End If
    LowEmitStrCollectSafepoint(ctx)
    LowStmtWrite = 1
End Function

Function LowStmtDo(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim offs As *Long
    Dim labEnd As Long
    Dim labTop As Long
    Dim tt As *TypeTable
    Dim typeIdxs As *Long
    Dim saveDo As Long
    Dim saveDoTop As Long
    Dim doMode As Long
    Dim cond As Long
    Dim byRefs As *Long
    Dim types As *Long
    Dim list As *IrList

    LowStmtDo = 0
    ast = ctx->ast
    nodes = ast->nodes
    tt = ast->types
    typeIdxs = ctx->typeIdxs
    list = ctx->list
    offs = ctx->offs
    types = ctx->types
    byRefs = ctx->byRefs

        labTop = LowNewLab(ctx)
        labEnd = LowNewLab(ctx)
        saveDo = g_doEndLab
        saveDoTop = g_doTopLab
        g_doEndLab = labEnd
        g_doTopLab = labTop
        doMode = nodes[idx].extra
        cond = nodes[idx].left
        If doMode = DO_WHILE_TOP Then
            IrEmit(ctx->list, OP_LABEL, labTop, 0)
            LowMaybeLoopStrCollect(ctx, cond, nodes[idx].right, -1)
            If LowJumpIfFalse(ctx, cond, labEnd) = 0 Then Exit Function
            If LowStmtList(ctx, nodes[idx].right) = 0 Then Exit Function
            IrEmit(ctx->list, OP_JMP, labTop, 0)
        ElseIf doMode = DO_UNTIL_TOP Then
            IrEmit(ctx->list, OP_LABEL, labTop, 0)
            LowMaybeLoopStrCollect(ctx, cond, nodes[idx].right, -1)
            If LowJumpIfTrue(ctx, cond, labEnd) = 0 Then Exit Function
            If LowStmtList(ctx, nodes[idx].right) = 0 Then Exit Function
            IrEmit(ctx->list, OP_JMP, labTop, 0)
        ElseIf doMode = DO_WHILE_BOTTOM Then
            IrEmit(ctx->list, OP_LABEL, labTop, 0)
            LowMaybeLoopStrCollect(ctx, cond, nodes[idx].right, -1)
            If LowStmtList(ctx, nodes[idx].right) = 0 Then Exit Function
            If LowJumpIfTrue(ctx, cond, labTop) = 0 Then Exit Function
        ElseIf doMode = DO_UNTIL_BOTTOM Then
            IrEmit(ctx->list, OP_LABEL, labTop, 0)
            LowMaybeLoopStrCollect(ctx, cond, nodes[idx].right, -1)
            If LowStmtList(ctx, nodes[idx].right) = 0 Then Exit Function
            If LowJumpIfFalse(ctx, cond, labTop) = 0 Then Exit Function
        Else
            IrEmit(ctx->list, OP_LABEL, labTop, 0)
            LowMaybeLoopStrCollect(ctx, cond, nodes[idx].right, -1)
            If LowStmtList(ctx, nodes[idx].right) = 0 Then Exit Function
            IrEmit(ctx->list, OP_JMP, labTop, 0)
        End If
        IrEmit(ctx->list, OP_LABEL, labEnd, 0)
        g_doEndLab = saveDo
        g_doTopLab = saveDoTop
        LowStmtDo = 1
End Function

Function LowStmtWhile(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim offs As *Long
    Dim labEnd As Long
    Dim labTop As Long
    Dim tt As *TypeTable
    Dim typeIdxs As *Long
    Dim saveWhile As Long
    Dim saveWhileTop As Long
    Dim byRefs As *Long
    Dim types As *Long
    Dim list As *IrList

    LowStmtWhile = 0
    ast = ctx->ast
    nodes = ast->nodes
    tt = ast->types
    typeIdxs = ctx->typeIdxs
    list = ctx->list
    offs = ctx->offs
    types = ctx->types
    byRefs = ctx->byRefs

        labTop = LowNewLab(ctx)
        labEnd = LowNewLab(ctx)
        saveWhile = g_whileEndLab
        saveWhileTop = g_whileTopLab
        g_whileEndLab = labEnd
        g_whileTopLab = labTop
        IrEmit(ctx->list, OP_LABEL, labTop, 0)
        LowMaybeLoopStrCollect(ctx, nodes[idx].left, nodes[idx].right, -1)
        If LowJumpIfFalse(ctx, nodes[idx].left, labEnd) = 0 Then Exit Function
        If LowStmtList(ctx, nodes[idx].right) = 0 Then Exit Function
        IrEmit(ctx->list, OP_JMP, labTop, 0)
        IrEmit(ctx->list, OP_LABEL, labEnd, 0)
        g_whileEndLab = saveWhile
        g_whileTopLab = saveWhileTop
        LowStmtWhile = 1
End Function

Function LowStmtForStep(ctx As *LowerCtx, idx As Long, vOff As Long, vGlob As Long, stepIdx As Long, useInc As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast

    LowStmtForStep = 0
    ast = ctx->ast
    nodes = ast->nodes
    If useInc <> 0 And vGlob = 0 Then
        IrEmit(ctx->list, OP_INC_LOCAL, vOff, 0)
    ElseIf useInc <> 0 Then
        LowEmitLoadOff(ctx->list, vOff, vGlob)
        IrEmit(ctx->list, OP_MOV_ECX, 1, 0)
        IrEmit(ctx->list, OP_ADD_EAX_ECX, 0, 0)
        LowEmitStoreOff(ctx->list, vOff, vGlob)
    ElseIf stepIdx >= 0 Then
        LowEmitLoadOff(ctx->list, vOff, vGlob)
        IrEmit(ctx->list, OP_PUSH_RAX, 0, 0)
        If LowExpr(ctx, stepIdx) = 0 Then Exit Function
        IrEmit(ctx->list, OP_POP_RCX, 0, 0)
        IrEmit(ctx->list, OP_ADD_EAX_ECX, 0, 0)
        LowEmitStoreOff(ctx->list, vOff, vGlob)
    Else
        If vGlob <> 0 Then
            LowEmitLoadOff(ctx->list, vOff, vGlob)
            IrEmit(ctx->list, OP_MOV_ECX, 1, 0)
            IrEmit(ctx->list, OP_ADD_EAX_ECX, 0, 0)
            LowEmitStoreOff(ctx->list, vOff, vGlob)
        Else
            IrEmit(ctx->list, OP_INC_LOCAL, vOff, 0)
        End If
    End If
    LowStmtForStep = 1
End Function

Function LowStmtFor(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim labEnd As Long
    Dim labTop As Long
    Dim body As Long
    Dim saveFor As Long
    Dim saveForCont As Long
    Dim stepIdx As Long
    Dim labStepNeg As Long
    Dim labStepCont As Long
    Dim labForCont As Long
    Dim useInc As Long

    LowStmtFor = 0
    ast = ctx->ast
    nodes = ast->nodes
    If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
    AstCopyStr(ast, nodes[idx].left, VarPtr(name))
    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
        ctx->err = 1
        Exit Function
    End If
    LowEmitStoreOff(ctx->list, vOff, vGlob)
    labTop = LowNewLab(ctx)
    labEnd = LowNewLab(ctx)
    labStepNeg = LowNewLab(ctx)
    labStepCont = LowNewLab(ctx)
    labForCont = LowNewLab(ctx)
    saveFor = g_forEndLab
    saveForCont = g_forContLab
    g_forEndLab = labEnd
    g_forContLab = labForCont
    stepIdx = nodes[idx].strId
    useInc = 0
    If stepIdx >= 0 Then
        If nodes[stepIdx].kind = AST_NUM Then
            If nodes[stepIdx].num = 1 Then
                useInc = 1
            End If
        End If
    End If
    IrEmit(ctx->list, OP_LABEL, labTop, 0)
    LowMaybeLoopStrCollect(ctx, nodes[idx].extra, nodes[idx].num, stepIdx)
    LowEmitLoadOff(ctx->list, vOff, vGlob)
    IrEmit(ctx->list, OP_PUSH_RAX, 0, 0)
    If LowExpr(ctx, nodes[idx].extra) = 0 Then Exit Function
    IrEmit(ctx->list, OP_MOV_EDX_EAX, 0, 0)
    IrEmit(ctx->list, OP_POP_RCX, 0, 0)
    If stepIdx >= 0 Then
        If LowExpr(ctx, stepIdx) = 0 Then Exit Function
        IrEmit(ctx->list, OP_TEST_EAX, 0, 0)
        IrEmit(ctx->list, OP_JL, labStepNeg, 0)
        IrEmit(ctx->list, OP_MOV_EAX_EDX, 0, 0)
        IrEmit(ctx->list, OP_CMP_ECX_EAX, 0, 0)
        IrEmit(ctx->list, OP_JG, labEnd, 0)
        IrEmit(ctx->list, OP_JMP, labStepCont, 0)
        IrEmit(ctx->list, OP_LABEL, labStepNeg, 0)
        IrEmit(ctx->list, OP_MOV_EAX_EDX, 0, 0)
        IrEmit(ctx->list, OP_CMP_ECX_EAX, 0, 0)
        IrEmit(ctx->list, OP_JL, labEnd, 0)
        IrEmit(ctx->list, OP_LABEL, labStepCont, 0)
    Else
        IrEmit(ctx->list, OP_MOV_EAX_EDX, 0, 0)
        IrEmit(ctx->list, OP_CMP_ECX_EAX, 0, 0)
        IrEmit(ctx->list, OP_JG, labEnd, 0)
    End If
    body = nodes[idx].num
    If LowStmtList(ctx, body) = 0 Then Exit Function
    IrEmit(ctx->list, OP_LABEL, labForCont, 0)
    If LowStmtForStep(ctx, idx, vOff, vGlob, stepIdx, useInc) = 0 Then Exit Function
    IrEmit(ctx->list, OP_JMP, labTop, 0)
    IrEmit(ctx->list, OP_LABEL, labEnd, 0)
    g_forEndLab = saveFor
    g_forContLab = saveForCont
    LowStmtFor = 1
End Function


Function LowStmtWith(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim offs As *Long
    Dim tt As *TypeTable
    Dim typeIdxs As *Long
    Dim byRefs As *Long
    Dim types As *Long
    Dim list As *IrList

    LowStmtWith = 0
    ast = ctx->ast
    nodes = ast->nodes
    tt = ast->types
    typeIdxs = ctx->typeIdxs
    list = ctx->list
    offs = ctx->offs
    types = ctx->types
    byRefs = ctx->byRefs

        If LowStmtList(ctx, nodes[idx].right) = 0 Then Exit Function
        LowStmtWith = 1
End Function

Function LowStmtExit(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim k As Long

    LowStmtExit = 0
    ast = ctx->ast
    nodes = ast->nodes
    k = nodes[idx].kind
    If k = AST_EXIT Then
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        LowEmitExitEax(ctx)
        LowStmtExit = 1
        Exit Function
    End If
    If k = AST_EXITDO Then
        If g_doEndLab < 0 Then
            ctx->err = 1
            Exit Function
        End If
        IrEmit(ctx->list, OP_JMP, g_doEndLab, 0)
        LowStmtExit = 1
        Exit Function
    End If
    If k = AST_EXITWHILE Then
        If g_whileEndLab < 0 Then
            ctx->err = 1
            Exit Function
        End If
        IrEmit(ctx->list, OP_JMP, g_whileEndLab, 0)
        LowStmtExit = 1
        Exit Function
    End If
    If k = AST_EXITFOR Then
        If g_forEndLab < 0 Then
            ctx->err = 1
            Exit Function
        End If
        IrEmit(ctx->list, OP_JMP, g_forEndLab, 0)
        LowStmtExit = 1
        Exit Function
    End If
    If k = AST_EXITFUNC Then
        If g_funcEndLab < 0 Then
            ctx->err = 1
            Exit Function
        End If
        IrEmit(ctx->list, OP_JMP, g_funcEndLab, 0)
        LowStmtExit = 1
        Exit Function
    End If
    If k = AST_CONTINUEDO Then
        If g_doTopLab < 0 Then
            ctx->err = 1
            Exit Function
        End If
        IrEmit(ctx->list, OP_JMP, g_doTopLab, 0)
        LowStmtExit = 1
        Exit Function
    End If
    If k = AST_CONTINUEWHILE Then
        If g_whileTopLab < 0 Then
            ctx->err = 1
            Exit Function
        End If
        IrEmit(ctx->list, OP_JMP, g_whileTopLab, 0)
        LowStmtExit = 1
        Exit Function
    End If
    If k = AST_CONTINUEFOR Then
        If g_forContLab < 0 Then
            ctx->err = 1
            Exit Function
        End If
        IrEmit(ctx->list, OP_JMP, g_forContLab, 0)
        LowStmtExit = 1
        Exit Function
    End If
    If k = AST_END Then
        LowEmitExitImm(ctx, 0)
        LowStmtExit = 1
    End If
End Function

Function LowStmtHeavy(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim k As Long

    LowStmtHeavy = 0
    If idx < 0 Then
        LowStmtHeavy = 1
        Exit Function
    End If
    ast = ctx->ast
    nodes = ast->nodes
    k = nodes[idx].kind

    If k = AST_DIM Then
        LowStmtHeavy = LowStmtDim(ctx, idx)
        Exit Function
    End If
    If k = AST_CONST Or k = AST_TYPE Or k = AST_ENUM Or k = AST_FUNC Or k = AST_DECLARE Then
        LowStmtHeavy = 1
        Exit Function
    End If
    If k = AST_ASSIGN Then
        LowStmtHeavy = LowStmtAssign(ctx, idx)
        Exit Function
    End If
    If k = AST_INSMENU Then
        LowStmtHeavy = LowStmtInsMenu(ctx, idx)
        Exit Function
    End If
    If k = AST_CALL Then
        LowStmtHeavy = LowExpr(ctx, idx)
        Exit Function
    End If
    If k = AST_EXIT Or k = AST_EXITDO Or k = AST_EXITWHILE Or k = AST_EXITFOR Or k = AST_EXITFUNC Or k = AST_CONTINUEDO Or k = AST_CONTINUEWHILE Or k = AST_CONTINUEFOR Or k = AST_END Then
        LowStmtHeavy = LowStmtExit(ctx, idx)
        Exit Function
    End If
    If k = AST_PRINT Then
        LowStmtHeavy = LowStmtPrint(ctx, idx)
        Exit Function
    End If
    If k = AST_INPUT Then
        LowStmtHeavy = LowStmtInput(ctx, idx)
        Exit Function
    End If
    If k = AST_OPEN Then
        LowStmtHeavy = LowStmtOpen(ctx, idx)
        Exit Function
    End If
    If k = AST_CLOSE Then
        LowStmtHeavy = LowStmtClose(ctx, idx)
        Exit Function
    End If
    If k = AST_FINPUT Then
        LowStmtHeavy = LowStmtFInput(ctx, idx)
        Exit Function
    End If
    If k = AST_FIELD Then
        LowStmtHeavy = LowStmtField(ctx, idx)
        Exit Function
    End If
    If k = AST_GET Then
        LowStmtHeavy = LowStmtGet(ctx, idx)
        Exit Function
    End If
    If k = AST_PUT Then
        LowStmtHeavy = LowStmtPut(ctx, idx)
        Exit Function
    End If
    If k = AST_WRITE Then
        LowStmtHeavy = LowStmtWrite(ctx, idx)
        Exit Function
    End If
    If k = AST_IF Then
        LowStmtHeavy = LowStmtIf(ctx, idx)
        Exit Function
    End If
    If k = AST_DO Then
        LowStmtHeavy = LowStmtDo(ctx, idx)
        Exit Function
    End If
    If k = AST_WHILE Then
        LowStmtHeavy = LowStmtWhile(ctx, idx)
        Exit Function
    End If
    If k = AST_FOR Then
        LowStmtHeavy = LowStmtFor(ctx, idx)
        Exit Function
    End If
    If k = AST_WITH Then
        LowStmtHeavy = LowStmtWith(ctx, idx)
        Exit Function
    End If
    Print "error: unsupported statement kind " + Str$(k)
    ctx->err = 1
End Function


Function LowStmtList(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim cur As Long

    LowStmtList = 0
    ast = ctx->ast
    nodes = ast->nodes
    cur = idx
    While cur >= 0
        If LowStmt(ctx, cur) = 0 Then Exit Function
        cur = nodes[cur].nxt
    Wend
    LowStmtList = 1
End Function

' Register one AST_DIM (asGlob=1 -> module global, else local). Returns 0 on error.
Function LowRegisterDimNode(ctx As *LowerCtx, dimIdx As Long, asGlob As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim nm(63) As Byte
    Dim ty As Long
    Dim nbytes As Long
    Dim ti As Long
    Dim bound As Long
    Dim tt As *TypeTable
    Dim tsizes As *Long

    LowRegisterDimNode = 0
    ast = ctx->ast
    nodes = ast->nodes
    tt = ast->types
    AstCopyStr(ast, dimIdx, VarPtr(nm))
    ty = nodes[dimIdx].num
    nbytes = 8
    ti = -1
    If ty = TY_BYTE_ARR Then
        bound = LowBoundVal(ctx, nodes[dimIdx].left)
        If bound < 0 Then Exit Function
        nbytes = bound + 1
    ElseIf ty = TY_LONG_ARR Then
        bound = LowBoundVal(ctx, nodes[dimIdx].left)
        If bound < 0 Then Exit Function
        nbytes = (bound + 1) * 4
    ElseIf ty = TY_DOUBLE_ARR Then
        bound = LowBoundVal(ctx, nodes[dimIdx].left)
        If bound < 0 Then Exit Function
        nbytes = (bound + 1) * 8
    ElseIf ty = TY_SINGLE_ARR Then
        bound = LowBoundVal(ctx, nodes[dimIdx].left)
        If bound < 0 Then Exit Function
        nbytes = (bound + 1) * 4
    ElseIf ty = TY_STRING_ARR Then
        bound = LowBoundVal(ctx, nodes[dimIdx].left)
        If bound < 0 Then Exit Function
        nbytes = (bound + 1) * TyPtrSize()
    ElseIf ty = TY_BYTE Then
        nbytes = 1
    ElseIf ty = TY_DOUBLE Then
        nbytes = 8
    ElseIf ty = TY_SINGLE Then
        nbytes = 4
    ElseIf ty = TY_UDT_ARR Then
        ti = nodes[dimIdx].extra
        If ti < 0 Then
            Print "error: Dim UDT[] missing type '" + MakeStr(VarPtr(nm)) + "'"
            Exit Function
        End If
        bound = LowBoundVal(ctx, nodes[dimIdx].left)
        If bound < 0 Then Exit Function
        tsizes = tt->typeSizes
        nbytes = tsizes[ti]
        If nbytes <= 0 Then
            Print "error: Dim UDT[] size 0 '" + MakeStr(VarPtr(nm)) + "'"
            Exit Function
        End If
        nbytes = nbytes * (bound + 1)
    ElseIf ty = TY_UDT Then
        ti = nodes[dimIdx].extra
        If ti < 0 Then
            Print "error: Dim UDT missing type '" + MakeStr(VarPtr(nm)) + "'"
            Exit Function
        End If
        tsizes = tt->typeSizes
        nbytes = tsizes[ti]
        If nbytes <= 0 Then
            Print "error: Dim UDT size 0 '" + MakeStr(VarPtr(nm)) + "'"
            Exit Function
        End If
    ElseIf ty = TY_PTR_UDT Then
        ti = nodes[dimIdx].extra
        If ti < 0 Then Exit Function
        nbytes = TyPtrSize()
    End If
    If asGlob <> 0 Then
        If LowAddGlob(ctx, VarPtr(nm), ty, nbytes, ti) < 0 Then
            Print "error: register global '" + MakeStr(VarPtr(nm)) + "' ty=" + Str$(ty)
            Exit Function
        End If
    Else
        If LowAddSym(ctx, VarPtr(nm), ty, nbytes, ti, 0) < 0 Then
            Print "error: register local '" + MakeStr(VarPtr(nm)) + "' ty=" + Str$(ty)
            Exit Function
        End If
    End If
    LowRegisterDimNode = 1
End Function

' Walk statement list (and nested If/While/For/Do bodies) to register Dims.
Function LowCollectDimsInList(ctx As *LowerCtx, idx As Long, asGlob As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim cur As Long
    Dim k As Long

    LowCollectDimsInList = 0
    ast = ctx->ast
    nodes = ast->nodes
    cur = idx
    While cur >= 0
        k = nodes[cur].kind
        If k = AST_DIM Then
            If LowRegisterDimNode(ctx, cur, asGlob) = 0 Then Exit Function
        ElseIf k = AST_IF Then
            If LowCollectDimsInList(ctx, nodes[cur].right, asGlob) = 0 Then Exit Function
            If LowCollectDimsInList(ctx, nodes[cur].extra, asGlob) = 0 Then Exit Function
        ElseIf k = AST_WHILE Then
            If LowCollectDimsInList(ctx, nodes[cur].right, asGlob) = 0 Then Exit Function
        ElseIf k = AST_DO Then
            If LowCollectDimsInList(ctx, nodes[cur].right, asGlob) = 0 Then Exit Function
        ElseIf k = AST_FOR Then
            If LowCollectDimsInList(ctx, nodes[cur].num, asGlob) = 0 Then Exit Function
        ElseIf k = AST_WITH Then
            If LowCollectDimsInList(ctx, nodes[cur].right, asGlob) = 0 Then Exit Function
        End If
        cur = nodes[cur].nxt
    Wend
    LowCollectDimsInList = 1
End Function

Function AstToIrRegDecls(ctx As *LowerCtx, prog As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim stmt As Long
    Dim param As Long
    Dim nm(63) As Byte
    Dim apiBuf(63) As Byte
    Dim libBuf(63) As Byte
    Dim dllKind As Long
    Dim byRefBits As Long
    Dim bit As Long

    AstToIrRegDecls = 0
    ast = ctx->ast
    nodes = ast->nodes
    stmt = nodes[prog].left
    While stmt >= 0
        If nodes[stmt].kind = AST_DECLARE Then
            AstCopyStr(ast, stmt, VarPtr(nm))
            libBuf[0] = 0
            apiBuf[0] = 0
            If nodes[stmt].right >= 0 Then
                AstCopyStr(ast, nodes[stmt].right, VarPtr(libBuf))
            End If
            If nodes[stmt].extra >= 0 Then
                AstCopyStr(ast, nodes[stmt].extra, VarPtr(apiBuf))
            End If
            If apiBuf[0] = 0 Then
                AstCopyStr(ast, stmt, VarPtr(apiBuf))
            End If
            dllKind = LowDllKindFromLib(VarPtr(libBuf))
            If dllKind = 0 Then
                Print "error: unknown Declare Lib '" + MakeStr(VarPtr(libBuf)) + "' for '" + MakeStr(VarPtr(nm)) + "'"
                Exit Function
            End If
            byRefBits = 0
            bit = 1
            param = nodes[stmt].left
            While param >= 0
                If nodes[param].num <> 0 Then
                    byRefBits = byRefBits + bit
                End If
                bit = bit * 2
                param = nodes[param].nxt
            Wend
            If LowAddDecl(ctx, VarPtr(nm), VarPtr(apiBuf), dllKind, byRefBits) = 0 Then Exit Function
        End If
        stmt = nodes[stmt].nxt
    Wend
    AstToIrRegDecls = 1
End Function

Function AstToIrRegEnum(ctx As *LowerCtx, enumIdx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim mem As Long
    Dim nm(63) As Byte
    Dim v As Long
    Dim last As Long
    Dim hasLast As Long

    AstToIrRegEnum = 0
    ast = ctx->ast
    nodes = ast->nodes
    mem = nodes[enumIdx].left
    last = 0
    hasLast = 0
    While mem >= 0
        If nodes[mem].kind <> AST_ENUMMEM Then
            ctx->err = 1
            Exit Function
        End If
        If nodes[mem].left >= 0 Then
            v = LowBoundVal(ctx, nodes[mem].left)
            If v < 0 Then
                AstCopyStr(ast, mem, VarPtr(nm))
                Print "error: invalid enum value for '" + MakeStr(VarPtr(nm)) + "'"
                ctx->err = 1
                Exit Function
            End If
        Else
            If hasLast = 0 Then
                v = 1
            Else
                v = last + 1
            End If
        End If
        AstCopyStr(ast, mem, VarPtr(nm))
        If LowAddConst(ctx, VarPtr(nm), v) = 0 Then Exit Function
        last = v
        hasLast = 1
        mem = nodes[mem].nxt
    Wend
    AstToIrRegEnum = 1
End Function

Function AstToIrRegConsts(ctx As *LowerCtx, prog As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim stmt As Long
    Dim nm(63) As Byte
    Dim sConst(255) As Byte

    AstToIrRegConsts = 0
    ast = ctx->ast
    nodes = ast->nodes
    LowAddBuiltinConsts(ctx)
    stmt = nodes[prog].left
    While stmt >= 0
        If nodes[stmt].kind = AST_CONST Then
            AstCopyStr(ast, stmt, VarPtr(nm))
            If nodes[stmt].extra <> 0 Then
                sConst[0] = 0
                If nodes[stmt].left >= 0 Then
                    AstCopyStr(ast, nodes[stmt].left, VarPtr(sConst))
                End If
                If LowAddStrConst(ctx, VarPtr(nm), VarPtr(sConst)) = 0 Then Exit Function
            Else
                If LowAddConst(ctx, VarPtr(nm), nodes[stmt].num) = 0 Then Exit Function
            End If
        ElseIf nodes[stmt].kind = AST_ENUM Then
            If AstToIrRegEnum(ctx, stmt) = 0 Then Exit Function
        End If
        stmt = nodes[stmt].nxt
    Wend
    AstToIrRegConsts = 1
End Function

Function AstToIrRegFuncs(ctx As *LowerCtx, prog As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim stmt As Long
    Dim param As Long
    Dim nm(63) As Byte
    Dim labFn As Long
    Dim byRefBits As Long
    Dim bit As Long

    AstToIrRegFuncs = 0
    ast = ctx->ast
    nodes = ast->nodes
    stmt = nodes[prog].left
    While stmt >= 0
        If nodes[stmt].kind = AST_FUNC Then
            labFn = LowNewLab(ctx)
            AstCopyStr(ast, stmt, VarPtr(nm))
            byRefBits = 0
            bit = 1
            param = nodes[stmt].left
            While param >= 0
                If nodes[param].num <> 0 Then
                    byRefBits = byRefBits + bit
                End If
                bit = bit * 2
                param = nodes[param].nxt
            Wend
            If LowAddFunc(ctx, VarPtr(nm), labFn, byRefBits) = 0 Then Exit Function
            ' extra は Parser が書いた戻り型のまま残す（lab は funcLabs）。
            ' extra を lab で上書きすると TY_STRING/TY_DOUBLE と衝突し、
            ' String 戻りが Double 変換されたり GC ルートから外れる。
        End If
        stmt = nodes[stmt].nxt
    Wend
    AstToIrRegFuncs = 1
End Function

Function AstToIrCaptureParams(ctx As *LowerCtx, stmt As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList
    Dim param As Long
    Dim offs As *Long
    Dim pi As Long
    Dim j As Long

    list = ctx->list
    ast = ctx->ast
    nodes = ast->nodes
    offs = ctx->offs
    pi = 0
    param = nodes[stmt].left
    While param >= 0
        If TyIs32() <> 0 Then
            offs[pi] = 8 + pi * 4
        ElseIf pi = 0 Then
            IrEmit(list, OP_STORE_LOCAL_ECX, offs[pi], 0)
        ElseIf pi = 1 Then
            IrEmit(list, OP_STORE_LOCAL_EDX, offs[pi], 0)
        ElseIf pi = 2 Then
            IrEmit(list, OP_STORE_LOCAL_R8, offs[pi], 0)
        ElseIf pi = 3 Then
            IrEmit(list, OP_STORE_LOCAL_R9, offs[pi], 0)
        Else
            ' stack arg already at [rbp+0x30+(pi-4)*8]
            ' LowAddSym が付けた precise root を実オフセットへ付け替える
            LowRetargetFnPreciseRoot(offs[pi], 48 + (pi - 4) * 8)
            offs[pi] = 48 + (pi - 4) * 8
        End If
        ' Long 引数をここで ZX してはいけない。BytePtr / HWND / VoidPtr
        ' は ParseEatLongAlias で TY_LONG になっており、ヒープの StrPtr
        ' を 32bit に切ると D3DCompile 等が AV する。添字は LowAddr 側で ZX。
        pi = pi + 1
        param = nodes[param].nxt
    Wend
    ' 非引数ローカル（戻り値スロット含む）を 0 初期化。
    ' String を未初期化のまま StoreString→StrFree するとスタックゴミを
    ' HeapFree して AV するため必須。
    j = pi
    While j < ctx->symCount
        IrEmit(list, OP_MOV_EAX_IMM, 0, 0)
        IrEmit(list, OP_STORE_LOCAL, offs[j], 0)
        j = j + 1
    Wend
    AstToIrCaptureParams = pi
End Function

Function AstToIrEmitFuncSetup(ctx As *LowerCtx, stmt As Long, retBuf As *Byte) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList
    Dim param As Long
    Dim nm(63) As Byte
    Dim labFn As Long
    Dim frame As Long
    Dim ty As Long
    Dim nbytes As Long
    Dim ti As Long
    Dim nFlags As Long
    Dim isByRef As Long

    AstToIrEmitFuncSetup = -1
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    ctx->symCount = 0
    ctx->frameUsed = 0
    ctx->inFunc = 1
    g_doEndLab = -1
    g_doTopLab = -1
    g_whileEndLab = -1
    g_whileTopLab = -1
    g_forEndLab = -1
    g_forContLab = -1
    g_funcEndLab = -1
    LowResetFnPreciseRoots()
    nFlags = nodes[stmt].num
    If nFlags >= 256 Then
        retBuf[0] = 0
    Else
        AstCopyStr(ast, stmt, retBuf)
    End If
    param = nodes[stmt].left
    While param >= 0
        AstCopyStr(ast, param, VarPtr(nm))
        isByRef = nodes[param].num
        ty = nodes[param].extra
        If ty < 0 Then ty = TY_LONG
        ti = nodes[param].right
        nbytes = TyPtrSize()
        If LowAddSym(ctx, VarPtr(nm), ty, nbytes, ti, isByRef) < 0 Then Exit Function
        param = nodes[param].nxt
    Wend
    If retBuf[0] <> 0 Then
        ty = nodes[stmt].extra
        If ty <> TY_STRING Then
            If ty <> TY_DOUBLE Then
                ty = TY_LONG
            End If
        End If
        If LowAddSym(ctx, retBuf, ty, 8, -1, 0) < 0 Then Exit Function
    End If
    ' locals: all Dims in body including nested If/Select/loops
    If LowCollectDimsInList(ctx, nodes[stmt].right, 0) = 0 Then Exit Function
    frame = LowAlign16(ctx->frameUsed + &H28 + &H2000)
    If frame < &H28 Then frame = &H28
    g_funcEndLab = LowNewLab(ctx)
    AstCopyStr(ast, stmt, VarPtr(nm))
    labFn = LowFindFunc(ctx, VarPtr(nm))
    If labFn < 0 Then
        Print "error: missing function label '" + MakeStr(VarPtr(nm)) + "'"
        Exit Function
    End If
    IrEmit(list, OP_LABEL, labFn, 0)
    IrEmit(list, OP_ENTER, frame, 0)
    AstToIrEmitFuncSetup = AstToIrCaptureParams(ctx, stmt)
End Function

