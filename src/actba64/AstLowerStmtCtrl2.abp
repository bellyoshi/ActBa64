' --- split from AstLowerStmtCtrl.abp (part 2) ---
Function LowStmtFor(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(63) As Byte
    Dim labEnd As Long
    Dim labTop As Long
    Dim body As Long
    Dim saveFor As Long
    Dim saveForCont As Long
    Dim stepIdx As Long
    Dim labStepNeg As Long
    Dim labStepCont As Long
    Dim labForCont As Long
    Dim useInc As Long

    LowStmtFor = 0
    ast = ctx->ast
    nodes = ast->nodes
    If LowExpr(ctx, nodes[idx].right) = 0 Then Exit Function
    AstCopyStr(ast, nodes[idx].left, VarPtr(name))
    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) = 0 Then
        ctx->err = 1
        Exit Function
    End If
    LowEmitStoreOff(ctx->list, vOff, vGlob)
    labTop = LowNewLab(ctx)
    labEnd = LowNewLab(ctx)
    labStepNeg = LowNewLab(ctx)
    labStepCont = LowNewLab(ctx)
    labForCont = LowNewLab(ctx)
    saveFor = g_forEndLab
    saveForCont = g_forContLab
    g_forEndLab = labEnd
    g_forContLab = labForCont
    stepIdx = nodes[idx].strId
    useInc = 0
    If stepIdx >= 0 Then
        If nodes[stepIdx].kind = AST_NUM Then
            If nodes[stepIdx].num = 1 Then
                useInc = 1
            End If
        End If
    End If
    IrEmit(ctx->list, OP_LABEL, labTop, 0)
    LowMaybeLoopStrCollect(ctx, nodes[idx].extra, nodes[idx].num, stepIdx)
    LowEmitLoadOff(ctx->list, vOff, vGlob)
    IrEmit(ctx->list, OP_PUSH_RAX, 0, 0)
    If LowExpr(ctx, nodes[idx].extra) = 0 Then Exit Function
    IrEmit(ctx->list, OP_MOV_EDX_EAX, 0, 0)
    IrEmit(ctx->list, OP_POP_RCX, 0, 0)
    If stepIdx >= 0 Then
        If LowExpr(ctx, stepIdx) = 0 Then Exit Function
        IrEmit(ctx->list, OP_TEST_EAX, 0, 0)
        IrEmit(ctx->list, OP_JL, labStepNeg, 0)
        IrEmit(ctx->list, OP_MOV_EAX_EDX, 0, 0)
        IrEmit(ctx->list, OP_CMP_ECX_EAX, 0, 0)
        IrEmit(ctx->list, OP_JG, labEnd, 0)
        IrEmit(ctx->list, OP_JMP, labStepCont, 0)
        IrEmit(ctx->list, OP_LABEL, labStepNeg, 0)
        IrEmit(ctx->list, OP_MOV_EAX_EDX, 0, 0)
        IrEmit(ctx->list, OP_CMP_ECX_EAX, 0, 0)
        IrEmit(ctx->list, OP_JL, labEnd, 0)
        IrEmit(ctx->list, OP_LABEL, labStepCont, 0)
    Else
        IrEmit(ctx->list, OP_MOV_EAX_EDX, 0, 0)
        IrEmit(ctx->list, OP_CMP_ECX_EAX, 0, 0)
        IrEmit(ctx->list, OP_JG, labEnd, 0)
    End If
    body = nodes[idx].num
    If LowStmtList(ctx, body) = 0 Then Exit Function
    IrEmit(ctx->list, OP_LABEL, labForCont, 0)
    If LowStmtForStep(ctx, idx, vOff, vGlob, stepIdx, useInc) = 0 Then Exit Function
    IrEmit(ctx->list, OP_JMP, labTop, 0)
    IrEmit(ctx->list, OP_LABEL, labEnd, 0)
    g_forEndLab = saveFor
    g_forContLab = saveForCont
    LowStmtFor = 1
End Function


Function LowStmtWith(ctx As *LowerCtx, idx As Long) As Long
    Dim stackPad(2047) As Byte
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim offs As *Long
    Dim tt As *TypeTable
    Dim typeIdxs As *Long
    Dim byRefs As *Long
    Dim types As *Long
    Dim list As *IrList

    LowStmtWith = 0
    ast = ctx->ast
    nodes = ast->nodes
    tt = ast->types
    typeIdxs = ctx->typeIdxs
    list = ctx->list
    offs = ctx->offs
    types = ctx->types
    byRefs = ctx->byRefs

        If LowStmtList(ctx, nodes[idx].right) = 0 Then Exit Function
        LowStmtWith = 1
End Function

Function LowStmtExit(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim k As Long

    LowStmtExit = 0
    ast = ctx->ast
    nodes = ast->nodes
    k = nodes[idx].kind
    If k = AST_EXIT Then
        If LowExpr(ctx, nodes[idx].left) = 0 Then Exit Function
        LowEmitExitEax(ctx)
        LowStmtExit = 1
        Exit Function
    End If
    If k = AST_EXITDO Then
        If g_doEndLab < 0 Then
            ctx->err = 1
            Exit Function
        End If
        IrEmit(ctx->list, OP_JMP, g_doEndLab, 0)
        LowStmtExit = 1
        Exit Function
    End If
    If k = AST_EXITWHILE Then
        If g_whileEndLab < 0 Then
            ctx->err = 1
            Exit Function
        End If
        IrEmit(ctx->list, OP_JMP, g_whileEndLab, 0)
        LowStmtExit = 1
        Exit Function
    End If
    If k = AST_EXITFOR Then
        If g_forEndLab < 0 Then
            ctx->err = 1
            Exit Function
        End If
        IrEmit(ctx->list, OP_JMP, g_forEndLab, 0)
        LowStmtExit = 1
        Exit Function
    End If
    If k = AST_EXITFUNC Then
        If g_funcEndLab < 0 Then
            ctx->err = 1
            Exit Function
        End If
        IrEmit(ctx->list, OP_JMP, g_funcEndLab, 0)
        LowStmtExit = 1
        Exit Function
    End If
    If k = AST_CONTINUEDO Then
        If g_doTopLab < 0 Then
            ctx->err = 1
            Exit Function
        End If
        IrEmit(ctx->list, OP_JMP, g_doTopLab, 0)
        LowStmtExit = 1
        Exit Function
    End If
    If k = AST_CONTINUEWHILE Then
        If g_whileTopLab < 0 Then
            ctx->err = 1
            Exit Function
        End If
        IrEmit(ctx->list, OP_JMP, g_whileTopLab, 0)
        LowStmtExit = 1
        Exit Function
    End If
    If k = AST_CONTINUEFOR Then
        If g_forContLab < 0 Then
            ctx->err = 1
            Exit Function
        End If
        IrEmit(ctx->list, OP_JMP, g_forContLab, 0)
        LowStmtExit = 1
        Exit Function
    End If
    If k = AST_END Then
        LowEmitExitImm(ctx, 0)
        LowStmtExit = 1
    End If
End Function

Function LowStmtHeavy(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim k As Long

    LowStmtHeavy = 0
    If idx < 0 Then
        LowStmtHeavy = 1
        Exit Function
    End If
    ast = ctx->ast
    nodes = ast->nodes
    k = nodes[idx].kind

    If k = AST_DIM Then
        LowStmtHeavy = LowStmtDim(ctx, idx)
        Exit Function
    End If
    If k = AST_CONST Or k = AST_TYPE Or k = AST_ENUM Or k = AST_FUNC Or k = AST_DECLARE Then
        LowStmtHeavy = 1
        Exit Function
    End If
    If k = AST_ASSIGN Then
        LowStmtHeavy = LowStmtAssign(ctx, idx)
        Exit Function
    End If
    If k = AST_INSMENU Then
        LowStmtHeavy = LowStmtInsMenu(ctx, idx)
        Exit Function
    End If
    If k = AST_CALL Then
        LowStmtHeavy = LowExpr(ctx, idx)
        Exit Function
    End If
    If k = AST_EXIT Or k = AST_EXITDO Or k = AST_EXITWHILE Or k = AST_EXITFOR Or k = AST_EXITFUNC Or k = AST_CONTINUEDO Or k = AST_CONTINUEWHILE Or k = AST_CONTINUEFOR Or k = AST_END Then
        LowStmtHeavy = LowStmtExit(ctx, idx)
        Exit Function
    End If
    If k = AST_PRINT Then
        LowStmtHeavy = LowStmtPrint(ctx, idx)
        Exit Function
    End If
    If k = AST_INPUT Then
        LowStmtHeavy = LowStmtInput(ctx, idx)
        Exit Function
    End If
    If k = AST_OPEN Then
        LowStmtHeavy = LowStmtOpen(ctx, idx)
        Exit Function
    End If
    If k = AST_CLOSE Then
        LowStmtHeavy = LowStmtClose(ctx, idx)
        Exit Function
    End If
    If k = AST_FINPUT Then
        LowStmtHeavy = LowStmtFInput(ctx, idx)
        Exit Function
    End If
    If k = AST_FIELD Then
        LowStmtHeavy = LowStmtField(ctx, idx)
        Exit Function
    End If
    If k = AST_GET Then
        LowStmtHeavy = LowStmtGet(ctx, idx)
        Exit Function
    End If
    If k = AST_PUT Then
        LowStmtHeavy = LowStmtPut(ctx, idx)
        Exit Function
    End If
    If k = AST_WRITE Then
        LowStmtHeavy = LowStmtWrite(ctx, idx)
        Exit Function
    End If
    If k = AST_IF Then
        LowStmtHeavy = LowStmtIf(ctx, idx)
        Exit Function
    End If
    If k = AST_DO Then
        LowStmtHeavy = LowStmtDo(ctx, idx)
        Exit Function
    End If
    If k = AST_WHILE Then
        LowStmtHeavy = LowStmtWhile(ctx, idx)
        Exit Function
    End If
    If k = AST_FOR Then
        LowStmtHeavy = LowStmtFor(ctx, idx)
        Exit Function
    End If
    If k = AST_WITH Then
        LowStmtHeavy = LowStmtWith(ctx, idx)
        Exit Function
    End If
    Print "error: unsupported statement kind " + Str$(k)
    ctx->err = 1
End Function


Function LowStmtList(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim cur As Long
    Dim savedErr As Long
    Dim anyFail As Long

    LowStmtList = 0
    ast = ctx->ast
    nodes = ast->nodes
    cur = idx
    anyFail = 0
    While cur >= 0
        savedErr = ctx->err
        ctx->err = 0
        If LowStmt(ctx, cur) = 0 Then
            anyFail = 1
        End If
        If ctx->err <> 0 Then anyFail = 1
        If savedErr <> 0 Then ctx->err = 1
        cur = nodes[cur].nxt
    Wend
    If anyFail <> 0 Then
        ctx->err = 1
        Exit Function
    End If
    LowStmtList = 1
End Function

' Register one AST_DIM (asGlob=1 -> module global, else local). Returns 0 on error.
