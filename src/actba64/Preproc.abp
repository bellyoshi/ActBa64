' ===================================================
'  Preproc - #include expansion (source-relative)
' ===================================================

Const PP_MAX_DEPTH = 16
Const PP_LINE_MAX = 1024
Const PP_ONCE_PATH = 512

' include-once / #USEWINDOW / #n88basic (module Dims: stage0 Type field limit)
Dim g_ppOnce As *Byte
Dim g_ppOnceCount As Long
Dim g_ppOnceCap As Long
Dim g_ppUseWindow As Long
Dim g_ppN88Basic As Long
Dim g_ppResPath(259) As Byte
Dim g_ppDidPrintErr As Long
Dim g_ppLastRawLen As Long

Const PP_WITH_MAX = 8
Dim g_ppWithDepth As Long
Dim g_ppWithCur(255) As Byte
Dim g_ppWithStack(PP_WITH_MAX * 256) As Byte

Sub PpErrorTooLongLine(path As *Byte, lineNo As Long, n As Long)
    g_ppDidPrintErr = 1
    If path <> NULL Then
        If path[0] <> CH_NUL Then
            Print "error: " + MakeStr(path) + "(" + Str$(lineNo) + "): too long line (" + Str$(n) + " > " + Str$(PP_LINE_MAX) + ")"
            Exit Sub
        End If
    End If
    Print "error: line " + Str$(lineNo) + ": too long line (" + Str$(n) + " > " + Str$(PP_LINE_MAX) + ")"
End Sub

Sub PpWithReset()
    g_ppWithDepth = 0
    g_ppWithCur[0] = CH_NUL
End Sub

Sub PpStrCopy(dst As *Byte, src As *Byte)
    Dim i As Long
    i = 0
    While src[i] <> CH_NUL And i < 255
        dst[i] = src[i]
        i = i + 1
    Wend
    dst[i] = CH_NUL
End Sub

Function PpStrEqCI(a As *Byte, b As *Byte) As Long
    Dim i As Long
    PpStrEqCI = 0
    i = 0
    While a[i] <> CH_NUL And b[i] <> CH_NUL
        If ToLowerChar(a[i]) <> ToLowerChar(b[i]) Then Exit Function
        i = i + 1
    Wend
    If a[i] <> b[i] Then Exit Function
    PpStrEqCI = 1
End Function

Function PpLineTrimOff(line As *Byte, n As Long) As Long
    Dim i As Long
    PpLineTrimOff = 0
    i = 0
    While i < n
        If line[i] = CH_SP Or line[i] = CH_TAB Then
            i = i + 1
        Else
            PpLineTrimOff = i
            Exit Function
        End If
    Wend
    PpLineTrimOff = n
End Function

Function PpIsWithStart(line As *Byte, n As Long, off As Long, exprOut As *Byte) As Long
    Dim kw(15) As Byte
    Dim i As Long
    Dim j As Long
    PpIsWithStart = 0
    If off >= n Then Exit Function
    lstrcpy(VarPtr(kw), "with")
    If n - off < 4 Then Exit Function
    i = 0
    While kw[i] <> CH_NUL
        If ToLowerChar(line[off + i]) <> kw[i] Then Exit Function
        i = i + 1
    Wend
    If off + i >= n Then Exit Function
    If line[off + i] <> CH_SP And line[off + i] <> CH_TAB Then Exit Function
    i = off + i + 1
    While i < n And (line[i] = CH_SP Or line[i] = CH_TAB)
        i = i + 1
    Wend
    j = 0
    While i < n And j < 255
        exprOut[j] = line[i]
        j = j + 1
        i = i + 1
    Wend
    While j > 0 And (exprOut[j - 1] = CH_SP Or exprOut[j - 1] = CH_TAB)
        j = j - 1
    Wend
    exprOut[j] = CH_NUL
    If j <= 0 Then Exit Function
    PpIsWithStart = 1
End Function

Function PpIsEndWith(line As *Byte, n As Long, off As Long) As Long
    Dim kEnd(7) As Byte
    Dim kWith(7) As Byte
    Dim i As Long
    Dim j As Long
    PpIsEndWith = 0
    If off >= n Then Exit Function
    lstrcpy(VarPtr(kEnd), "end")
    lstrcpy(VarPtr(kWith), "with")
    i = 0
    While kEnd[i] <> CH_NUL
        If off + i >= n Then Exit Function
        If ToLowerChar(line[off + i]) <> kEnd[i] Then Exit Function
        i = i + 1
    Wend
    i = off + i
    While i < n And (line[i] = CH_SP Or line[i] = CH_TAB)
        i = i + 1
    Wend
    j = 0
    While kWith[j] <> CH_NUL
        If i + j >= n Then Exit Function
        If ToLowerChar(line[i + j]) <> kWith[j] Then Exit Function
        j = j + 1
    Wend
    i = i + j
    While i < n And (line[i] = CH_SP Or line[i] = CH_TAB)
        i = i + 1
    Wend
    If i < n Then Exit Function
    PpIsEndWith = 1
End Function

Function PpDotNeedsBase(line As *Byte, pos As Long) As Long
    Dim c As Long
    PpDotNeedsBase = 0
    If pos <= 0 Then
        PpDotNeedsBase = 1
        Exit Function
    End If
    c = line[pos - 1]
    If c = CH_SP Or c = CH_TAB Then PpDotNeedsBase = 1
    If c = CH_LPAREN Or c = CH_PLUS Or c = CH_MINUS Or c = CH_STAR Or c = CH_SLASH Or c = CH_BSLASH Then PpDotNeedsBase = 1
    If c = CH_EQ Or c = CH_COMMA Or c = CH_LESS Or c = CH_GREATER Then PpDotNeedsBase = 1
End Function

Function PpWithPush(expr As *Byte) As Long
    Dim stackOff As Long
    PpWithPush = 0
    If g_ppWithDepth >= PP_WITH_MAX Then Exit Function
    stackOff = g_ppWithDepth * 256
    PpStrCopy(VarPtr(g_ppWithStack[stackOff]), VarPtr(g_ppWithCur))
    PpStrCopy(VarPtr(g_ppWithCur), expr)
    g_ppWithDepth = g_ppWithDepth + 1
    PpWithPush = 1
End Function

Sub PpWithPop()
    Dim stackOff As Long
    g_ppWithDepth = g_ppWithDepth - 1
    If g_ppWithDepth > 0 Then
        stackOff = g_ppWithDepth * 256
        PpStrCopy(VarPtr(g_ppWithCur), VarPtr(g_ppWithStack[stackOff]))
    Else
        g_ppWithCur[0] = CH_NUL
    End If
End Sub

Function PpWithSubstitute(line As *Byte, n As Long, out As *Byte, ByRef outN As Long) As Long
    Dim i As Long
    Dim j As Long
    Dim wi As Long
    PpWithSubstitute = 0
    outN = 0
    j = 0
    i = 0
    While i < n
        If line[i] = CH_DOT Then
            If PpDotNeedsBase(line, i) <> 0 Then
                wi = 0
                While g_ppWithCur[wi] <> CH_NUL And j < PP_LINE_MAX - 1
                    out[j] = g_ppWithCur[wi]
                    j = j + 1
                    wi = wi + 1
                Wend
            End If
        End If
        If j >= PP_LINE_MAX - 1 Then Exit Function
        out[j] = line[i]
        j = j + 1
        i = i + 1
    Wend
    out[j] = CH_NUL
    outN = j
    PpWithSubstitute = 1
End Function

Function PpRewriteWithLine(line As *Byte, n As Long, out As *Byte, ByRef outN As Long) As Long
    Dim off As Long
    Dim expr(255) As Byte
    PpRewriteWithLine = 0
    outN = 0
    off = PpLineTrimOff(line, n)
    If PpIsWithStart(line, n, off, VarPtr(expr)) <> 0 Then
        If PpWithPush(VarPtr(expr)) = 0 Then Exit Function
        PpRewriteWithLine = 2
        Exit Function
    End If
    If g_ppWithDepth > 0 And PpIsEndWith(line, n, off) <> 0 Then
        PpWithPop()
        PpRewriteWithLine = 2
        Exit Function
    End If
    If g_ppWithDepth <= 0 Or g_ppWithCur[0] = CH_NUL Then
        PpRewriteWithLine = 1
        Exit Function
    End If
    If PpWithSubstitute(line, n, out, outN) = 0 Then Exit Function
    PpRewriteWithLine = 1
End Function
