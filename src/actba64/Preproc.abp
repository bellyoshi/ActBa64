' ===================================================
'  Preproc - #include expansion (source-relative)
' ===================================================

Const PP_MAX_DEPTH = 16
Const PP_LINE_MAX = 512
Const PP_ONCE_MAX = 256
Const PP_ONCE_PATH = 512

' include-once / #USEWINDOW / #n88basic (module Dims: stage0 Type field limit)
Dim g_ppOnce As *Byte
Dim g_ppOnceCount As Long
Dim g_ppUseWindow As Long
Dim g_ppN88Basic As Long

Const PP_WITH_MAX = 8
Dim g_ppWithDepth As Long
Dim g_ppWithCur(255) As Byte
Dim g_ppWithStack(PP_WITH_MAX * 256) As Byte

Sub PpWithReset()
    g_ppWithDepth = 0
    g_ppWithCur[0] = 0
End Sub

Sub PpStrCopy(dst As *Byte, src As *Byte)
    Dim i As Long
    i = 0
    While src[i] <> 0 And i < 255
        dst[i] = src[i]
        i = i + 1
    Wend
    dst[i] = 0
End Sub

Function PpStrEqCI(a As *Byte, b As *Byte) As Long
    Dim i As Long
    PpStrEqCI = 0
    i = 0
    While a[i] <> 0 And b[i] <> 0
        If PpToLower(a[i]) <> PpToLower(b[i]) Then Exit Function
        i = i + 1
    Wend
    If a[i] <> b[i] Then Exit Function
    PpStrEqCI = 1
End Function

Function PpLineTrimOff(line As *Byte, n As Long) As Long
    Dim i As Long
    PpLineTrimOff = 0
    i = 0
    While i < n
        If line[i] = 32 Or line[i] = 9 Then
            i = i + 1
        Else
            PpLineTrimOff = i
            Exit Function
        End If
    Wend
    PpLineTrimOff = n
End Function

Function PpIsWithStart(line As *Byte, n As Long, off As Long, exprOut As *Byte) As Long
    Dim k(15) As Byte
    Dim i As Long
    Dim j As Long
    PpIsWithStart = 0
    If off >= n Then Exit Function
    lstrcpy(VarPtr(k), "with")
    If n - off < 4 Then Exit Function
    i = 0
    While k[i] <> 0
        If PpToLower(line[off + i]) <> k[i] Then Exit Function
        i = i + 1
    Wend
    If off + i >= n Then Exit Function
    If line[off + i] <> 32 And line[off + i] <> 9 Then Exit Function
    i = off + i + 1
    While i < n And (line[i] = 32 Or line[i] = 9)
        i = i + 1
    Wend
    j = 0
    While i < n And j < 255
        exprOut[j] = line[i]
        j = j + 1
        i = i + 1
    Wend
    While j > 0 And (exprOut[j - 1] = 32 Or exprOut[j - 1] = 9)
        j = j - 1
    Wend
    exprOut[j] = 0
    If j <= 0 Then Exit Function
    PpIsWithStart = 1
End Function

Function PpIsEndWith(line As *Byte, n As Long, off As Long) As Long
    Dim kEnd(7) As Byte
    Dim kWith(7) As Byte
    Dim i As Long
    Dim j As Long
    PpIsEndWith = 0
    If off >= n Then Exit Function
    lstrcpy(VarPtr(kEnd), "end")
    lstrcpy(VarPtr(kWith), "with")
    i = 0
    While kEnd[i] <> 0
        If off + i >= n Then Exit Function
        If PpToLower(line[off + i]) <> kEnd[i] Then Exit Function
        i = i + 1
    Wend
    i = off + i
    While i < n And (line[i] = 32 Or line[i] = 9)
        i = i + 1
    Wend
    j = 0
    While kWith[j] <> 0
        If i + j >= n Then Exit Function
        If PpToLower(line[i + j]) <> kWith[j] Then Exit Function
        j = j + 1
    Wend
    i = i + j
    While i < n And (line[i] = 32 Or line[i] = 9)
        i = i + 1
    Wend
    If i < n Then Exit Function
    PpIsEndWith = 1
End Function

Function PpDotNeedsBase(line As *Byte, pos As Long) As Long
    Dim c As Long
    PpDotNeedsBase = 0
    If pos <= 0 Then
        PpDotNeedsBase = 1
        Exit Function
    End If
    c = line[pos - 1]
    If c = 32 Or c = 9 Then PpDotNeedsBase = 1
    If c = 40 Or c = 43 Or c = 45 Or c = 42 Or c = 47 Or c = 92 Then PpDotNeedsBase = 1
    If c = 61 Or c = 44 Or c = 60 Or c = 62 Then PpDotNeedsBase = 1
End Function

Function PpRewriteWithLine(line As *Byte, n As Long, out As *Byte, ByRef outN As Long) As Long
    Dim off As Long
    Dim expr(255) As Byte
    Dim i As Long
    Dim j As Long
    Dim k As Long
    Dim stackOff As Long
    PpRewriteWithLine = 0
    outN = 0
    off = PpLineTrimOff(line, n)
    If PpIsWithStart(line, n, off, VarPtr(expr)) <> 0 Then
        If g_ppWithDepth >= PP_WITH_MAX Then Exit Function
        stackOff = g_ppWithDepth * 256
        PpStrCopy(VarPtr(g_ppWithStack[stackOff]), VarPtr(g_ppWithCur))
        PpStrCopy(VarPtr(g_ppWithCur), VarPtr(expr))
        g_ppWithDepth = g_ppWithDepth + 1
        PpRewriteWithLine = 2
        Exit Function
    End If
    If g_ppWithDepth > 0 And PpIsEndWith(line, n, off) <> 0 Then
        g_ppWithDepth = g_ppWithDepth - 1
        If g_ppWithDepth > 0 Then
            stackOff = g_ppWithDepth * 256
            PpStrCopy(VarPtr(g_ppWithCur), VarPtr(g_ppWithStack[stackOff]))
        Else
            g_ppWithCur[0] = 0
        End If
        PpRewriteWithLine = 2
        Exit Function
    End If
    If g_ppWithDepth <= 0 Or g_ppWithCur[0] = 0 Then
        PpRewriteWithLine = 1
        Exit Function
    End If
    j = 0
    i = 0
    While i < n
        If line[i] = 46 Then
            If PpDotNeedsBase(line, i) <> 0 Then
                k = 0
                While g_ppWithCur[k] <> 0 And j < PP_LINE_MAX - 1
                    out[j] = g_ppWithCur[k]
                    j = j + 1
                    k = k + 1
                Wend
            End If
        End If
        If j >= PP_LINE_MAX - 1 Then Exit Function
        out[j] = line[i]
        j = j + 1
        i = i + 1
    Wend
    out[j] = 0
    outN = j
    PpRewriteWithLine = 1
End Function

Function PpIsN88Basic() As Long
    PpIsN88Basic = g_ppN88Basic
End Function

Function PpToLower(c As Long) As Long
    If c >= 65 And c <= 90 Then
        PpToLower = c + 32
    Else
        PpToLower = c
    End If
End Function

Function PpStateInit() As Long
    Dim buf As *Byte
    PpStateInit = 0
    buf = calloc(PP_ONCE_MAX * PP_ONCE_PATH)
    If buf = NULL Then Exit Function
    g_ppOnce = buf
    g_ppOnceCount = 0
    g_ppUseWindow = 0
    g_ppN88Basic = 0
    PpStateInit = 1
End Function

Sub PpStateFree()
    If g_ppOnce <> NULL Then free(g_ppOnce)
    g_ppOnce = NULL
    g_ppOnceCount = 0
End Sub

Sub PpOnceReset()
    g_ppOnceCount = 0
End Sub

Function PpPathEq(a As *Byte, b As *Byte) As Long
    Dim i As Long
    PpPathEq = 0
    i = 0
    While a[i] <> 0 And b[i] <> 0
        If PpToLower(a[i]) <> PpToLower(b[i]) Then Exit Function
        i = i + 1
    Wend
    If a[i] <> b[i] Then Exit Function
    PpPathEq = 1
End Function

Function PpOnceHas(path As *Byte) As Long
    Dim i As Long
    Dim off As Long
    Dim buf As *Byte
    PpOnceHas = 0
    buf = g_ppOnce
    If buf = NULL Then Exit Function
    i = 0
    While i < g_ppOnceCount
        off = i * PP_ONCE_PATH
        If PpPathEq(VarPtr(buf[off]), path) <> 0 Then
            PpOnceHas = 1
            Exit Function
        End If
        i = i + 1
    Wend
End Function

Sub PpOnceAdd(path As *Byte)
    Dim buf As *Byte
    Dim dst As *Byte
    Dim off As Long
    Dim j As Long
    buf = g_ppOnce
    If buf = NULL Then Exit Sub
    If g_ppOnceCount >= PP_ONCE_MAX Then Exit Sub
    off = g_ppOnceCount * PP_ONCE_PATH
    dst = VarPtr(buf[off])
    j = 0
    While path[j] <> 0 And j < PP_ONCE_PATH - 1
        dst[j] = path[j]
        j = j + 1
    Wend
    dst[j] = 0
    g_ppOnceCount = g_ppOnceCount + 1
End Sub

Sub PpDirOf(path As *Byte, dst As *Byte)
    Dim i As Long
    Dim last As Long
    Dim c As Long
    last = -1
    i = 0
    While path[i] <> 0
        c = path[i]
        If c = 92 Or c = 47 Then last = i
        i = i + 1
    Wend
    If last < 0 Then
        dst[0] = 0
        Exit Sub
    End If
    i = 0
    While i <= last
        dst[i] = path[i]
        i = i + 1
    Wend
    dst[i] = 0
End Sub

Function PpIsIncludeLine(line As *Byte, n As Long) As Long
    Dim i As Long
    Dim k As Long
    Dim c As Long
    Dim word(15) As Byte
    PpIsIncludeLine = 0
    i = 0
    While i < n
        c = line[i]
        If c <> 32 And c <> 9 Then Exit While
        i = i + 1
    Wend
    If i >= n Then Exit Function
    If line[i] <> 35 Then Exit Function
    i = i + 1
    While i < n
        c = line[i]
        If c <> 32 And c <> 9 Then Exit While
        i = i + 1
    Wend
    lstrcpy(VarPtr(word), "include")
    k = 0
    While word[k] <> 0
        If i + k >= n Then Exit Function
        If PpToLower(line[i + k]) <> word[k] Then Exit Function
        k = k + 1
    Wend
    PpIsIncludeLine = 1
End Function

Function PpExtractInclude(line As *Byte, n As Long, dst As *Byte) As Long
    Dim i As Long
    Dim q1 As Long
    Dim q2 As Long
    Dim j As Long
    PpExtractInclude = 0
    dst[0] = 0
    q1 = -1
    q2 = -1
    i = 0
    While i < n
        If line[i] = 34 Then
            If q1 < 0 Then
                q1 = i
            Else
                q2 = i
                Exit While
            End If
        End If
        i = i + 1
    Wend
    If q1 < 0 Or q2 <= q1 Then Exit Function
    j = 0
    i = q1 + 1
    While i < q2 And j < 250
        dst[j] = line[i]
        j = j + 1
        i = i + 1
    Wend
    dst[j] = 0
    PpExtractInclude = 1
End Function

Function PpAppend(dst As *Byte, ByRef dstLen As Long, dstCap As Long, src As *Byte, n As Long) As Long
    Dim i As Long
    PpAppend = 0
    If dstLen + n + 1 > dstCap Then Exit Function
    i = 0
    While i < n
        dst[dstLen + i] = src[i]
        i = i + 1
    Wend
    dstLen = dstLen + n
    dst[dstLen] = 0
    PpAppend = 1
End Function

Function PpEmitFileMark(dst As *Byte, ByRef dstLen As Long, dstCap As Long, path As *Byte) As Long
    Dim hdr(15) As Byte
    Dim tail(7) As Byte
    PpEmitFileMark = 0
    lstrcpy(VarPtr(hdr), "' ---- ")
    If PpAppend(dst, dstLen, dstCap, VarPtr(hdr), 7) = 0 Then Exit Function
    If PpAppend(dst, dstLen, dstCap, path, lstrlen(path)) = 0 Then Exit Function
    lstrcpy(VarPtr(tail), " ----")
    tail[5] = 13
    tail[6] = 10
    tail[7] = 0
    If PpAppend(dst, dstLen, dstCap, VarPtr(tail), 7) = 0 Then Exit Function
    PpEmitFileMark = 1
End Function

Function PpEmitFileEnd(dst As *Byte, ByRef dstLen As Long, dstCap As Long) As Long
    Dim s(23) As Byte
    PpEmitFileEnd = 0
    lstrcpy(VarPtr(s), "' ---- end ----")
    If PpAppend(dst, dstLen, dstCap, VarPtr(s), 15) = 0 Then Exit Function
    s[0] = 13
    s[1] = 10
    If PpAppend(dst, dstLen, dstCap, VarPtr(s), 2) = 0 Then Exit Function
    PpEmitFileEnd = 1
End Function

Function PpNameIsEnd(name As *Byte) As Long
    PpNameIsEnd = 0
    If name = 0 Then Exit Function
    If PpToLower(name[0]) <> 101 Then Exit Function
    If PpToLower(name[1]) <> 110 Then Exit Function
    If PpToLower(name[2]) <> 100 Then Exit Function
    If name[3] <> 0 Then Exit Function
    PpNameIsEnd = 1
End Function

Function PpLineIsFileMark(line As *Byte, n As Long, nameOut As *Byte, nameMax As Long) As Long
    Dim i As Long
    Dim nameLen As Long
    PpLineIsFileMark = 0
    nameOut[0] = 0
    i = 0
    While i < n
        If line[i] <> 32 And line[i] <> 9 Then Exit While
        i = i + 1
    Wend
    If i + 7 > n Then Exit Function
    If line[i] <> 39 Then Exit Function
    If line[i + 1] <> 32 Then Exit Function
    If line[i + 2] <> 45 Then Exit Function
    If line[i + 3] <> 45 Then Exit Function
    If line[i + 4] <> 45 Then Exit Function
    If line[i + 5] <> 45 Then Exit Function
    If line[i + 6] <> 32 Then Exit Function
    i = i + 7
    nameLen = 0
    While i < n
        If i + 5 <= n Then
            If line[i] = 32 And line[i + 1] = 45 And line[i + 2] = 45 And line[i + 3] = 45 And line[i + 4] = 45 Then
                Exit While
            End If
        End If
        If nameLen < nameMax - 1 Then
            nameOut[nameLen] = line[i]
            nameLen = nameLen + 1
        End If
        i = i + 1
    Wend
    nameOut[nameLen] = 0
    If nameLen <= 0 Then Exit Function
    PpLineIsFileMark = 1
End Function

Function PpMapSrcName$(src As *Byte, combLine As Long, ByRef localLine As Long) As String
    Dim i As Long
    Dim start As Long
    Dim n As Long
    Dim cur As Long
    Dim c As Long
    Dim sp As Long
    Dim off As Long
    Dim name(259) As Byte
    Dim names(4159) As Byte
    Dim locs(15) As Long
    Dim k As Long

    PpMapSrcName$ = ""
    localLine = combLine
    If src = 0 Then Exit Function
    If combLine <= 0 Then combLine = 1
    i = 0
    cur = 1
    sp = 0
    While src[i] <> 0
        start = i
        While src[i] <> 0
            c = src[i]
            If c = 10 Or c = 13 Then Exit While
            i = i + 1
        Wend
        n = i - start
        If PpLineIsFileMark(VarPtr(src[start]), n, VarPtr(name), 260) <> 0 Then
            If PpNameIsEnd(VarPtr(name)) <> 0 Then
                If sp > 0 Then sp = sp - 1
            Else
                If sp < 16 Then
                    off = sp * 260
                    k = 0
                    While name[k] <> 0 And k < 259
                        names[off + k] = name[k]
                        k = k + 1
                    Wend
                    names[off + k] = 0
                    locs[sp] = 0
                    sp = sp + 1
                End If
            End If
        Else
            If sp > 0 Then locs[sp - 1] = locs[sp - 1] + 1
        End If
        If cur >= combLine Then Exit While
        If src[i] = 13 Then i = i + 1
        If src[i] = 10 Then i = i + 1
        cur = cur + 1
    Wend
    If sp > 0 Then
        off = (sp - 1) * 260
        localLine = locs[sp - 1]
        If localLine < 1 Then localLine = 1
        PpMapSrcName$ = MakeStr(VarPtr(names[off]))
    End If
End Function

Function PpErrLoc$(src As *Byte, combLine As Long) As String
    Dim file As String
    Dim localLine As Long
    file = PpMapSrcName$(src, combLine, localLine)
    If Len(file) > 0 Then
        PpErrLoc$ = file + "(" + Str$(localLine) + ")"
    Else
        PpErrLoc$ = "line " + Str$(combLine)
    End If
End Function

Function PpExpandInto(dst As *Byte, ByRef dstLen As Long, dstCap As Long, src As *Byte, srcSize As Long, curFile As *Byte, depth As Long) As Long
    Dim i As Long
    Dim start As Long
    Dim n As Long
    Dim c As Long
    Dim line(511) As Byte
    Dim inc(255) As Byte
    Dim full(511) As Byte
    Dim dir(511) As Byte
    Dim child As *Byte
    Dim childSize As Long
    Dim j As Long
    Dim wOut(511) As Byte
    Dim wN As Long
    Dim wSt As Long

    PpExpandInto = 0
    If depth >= PP_MAX_DEPTH Then Exit Function
    If depth = 0 Then PpWithReset()
    If PpEmitFileMark(dst, dstLen, dstCap, curFile) = 0 Then Exit Function
    i = 0
    While i < srcSize
        start = i
        While i < srcSize
            c = src[i]
            If c = 10 Or c = 13 Then Exit While
            i = i + 1
        Wend
        n = i - start
        If n >= PP_LINE_MAX Then n = PP_LINE_MAX - 1
        j = 0
        While j < n
            line[j] = src[start + j]
            j = j + 1
        Wend
        line[n] = 0
        If PpIsIncludeLine(VarPtr(line), n) <> 0 Then
            If PpExtractInclude(VarPtr(line), n, VarPtr(inc)) = 0 Then Exit Function
            full[0] = 0
            If inc[0] = 0 Then Exit Function
            If (inc[1] = 58) Or (inc[0] = 92) Or (inc[0] = 47) Then
                lstrcpy(VarPtr(full), VarPtr(inc))
            Else
                PpDirOf(curFile, VarPtr(dir))
                lstrcpy(VarPtr(full), VarPtr(dir))
                lstrcat(VarPtr(full), VarPtr(inc))
            End If
            If n > 0 Then
                If PpAppend(dst, dstLen, dstCap, VarPtr(line), n) = 0 Then Exit Function
            End If
            line[0] = 13
            line[1] = 10
            If PpAppend(dst, dstLen, dstCap, VarPtr(line), 2) = 0 Then Exit Function
            If PpOnceHas(VarPtr(full)) = 0 Then
                child = LoadFile(VarPtr(full), childSize)
                If child = NULL Then Exit Function
                PpOnceAdd(VarPtr(full))
                If PpExpandInto(dst, dstLen, dstCap, child, childSize, VarPtr(full), depth + 1) = 0 Then
                    free(child)
                    Exit Function
                End If
                free(child)
            End If
        Else
            wSt = PpRewriteWithLine(VarPtr(line), n, VarPtr(wOut), wN)
            If wSt = 0 Then Exit Function
            If wSt = 2 Then
                ' With / End With 行は出力しない
            ElseIf wSt = 1 And wN > 0 Then
                If PpAppend(dst, dstLen, dstCap, VarPtr(wOut), wN) = 0 Then Exit Function
                line[0] = 13
                line[1] = 10
                If PpAppend(dst, dstLen, dstCap, VarPtr(line), 2) = 0 Then Exit Function
            Else
                If n > 0 Then
                    If PpAppend(dst, dstLen, dstCap, VarPtr(line), n) = 0 Then Exit Function
                End If
                line[0] = 13
                line[1] = 10
                If PpAppend(dst, dstLen, dstCap, VarPtr(line), 2) = 0 Then Exit Function
            End If
        End If
        If i < srcSize And src[i] = 13 Then i = i + 1
        If i < srcSize And src[i] = 10 Then i = i + 1
    Wend
    If PpEmitFileEnd(dst, dstLen, dstCap) = 0 Then Exit Function
    PpExpandInto = 1
End Function

Function ExpandIncludes(src As *Byte, srcSize As Long, srcPath As *Byte) As *Byte
    Dim dst As *Byte
    Dim dstLen As Long
    Dim dstCap As Long

    ExpandIncludes = NULL
    dstCap = srcSize * 8 + 262144
    If dstCap < 2097152 Then dstCap = 2097152
    dst = calloc(dstCap)
    If dst = NULL Then Exit Function
    dstLen = 0
    dst[0] = 0
    If PpExpandInto(dst, dstLen, dstCap, src, srcSize, srcPath, 0) = 0 Then
        free(dst)
        Exit Function
    End If
    ExpandIncludes = dst
End Function

Function PpFileExists(path As *Byte) As Long
    Dim p As *Byte
    Dim n As Long
    PpFileExists = 0
    p = LoadFile(path, n)
    If p = NULL Then Exit Function
    free(p)
    PpFileExists = 1
End Function

' 実行ファイルのあるディレクトリ（末尾は区切り文字付き）
Function PpToolDir(dst As *Byte) As Long
    Dim buf(511) As Byte
    Dim n As Long
    PpToolDir = 0
    dst[0] = 0
    buf[0] = 0
    n = GetModuleFileName(0, VarPtr(buf), 512)
    If n <= 0 Then buf[0] = 0
    If buf[0] = 0 Then
        If GetCmd(0, VarPtr(buf)) = 0 Then Exit Function
    End If
    If buf[0] = 0 Then Exit Function
    PpDirOf(VarPtr(buf), dst)
    If dst[0] = 0 Then Exit Function
    PpToolDir = 1
End Function

' ツール隣 / 3 階層上まで / カレントの Include\... 相対パスを解決
Function PpFindRelIdx(rel As *Byte, dst As *Byte) As Long
    Dim dir(511) As Byte

    PpFindRelIdx = 0
    dst[0] = 0
    If PpToolDir(VarPtr(dir)) <> 0 Then
        lstrcpy(dst, VarPtr(dir))
        lstrcat(dst, rel)
        If PpFileExists(dst) <> 0 Then
            PpFindRelIdx = 1
            Exit Function
        End If
        lstrcpy(dst, VarPtr(dir))
        lstrcat(dst, "..\")
        lstrcat(dst, rel)
        If PpFileExists(dst) <> 0 Then
            PpFindRelIdx = 1
            Exit Function
        End If
        lstrcpy(dst, VarPtr(dir))
        lstrcat(dst, "..\..\")
        lstrcat(dst, rel)
        If PpFileExists(dst) <> 0 Then
            PpFindRelIdx = 1
            Exit Function
        End If
        lstrcpy(dst, VarPtr(dir))
        lstrcat(dst, "..\..\..\")
        lstrcat(dst, rel)
        If PpFileExists(dst) <> 0 Then
            PpFindRelIdx = 1
            Exit Function
        End If
    End If
    lstrcpy(dst, rel)
    If PpFileExists(dst) <> 0 Then
        PpFindRelIdx = 1
        Exit Function
    End If
    dst[0] = 0
End Function

Function PpFindDefaultIdx(dst As *Byte) As Long
    Dim rel(63) As Byte
    lstrcpy(VarPtr(rel), "Include\default\default.idx")
    PpFindDefaultIdx = PpFindRelIdx(VarPtr(rel), dst)
End Function

Function PpFindConsoleIdx(dst As *Byte) As Long
    Dim rel(63) As Byte
    lstrcpy(VarPtr(rel), "Include\console\console.idx")
    PpFindConsoleIdx = PpFindRelIdx(VarPtr(rel), dst)
End Function

Function PpFindN88BasicIdx(dst As *Byte) As Long
    Dim rel(63) As Byte
    lstrcpy(VarPtr(rel), "Include\N88BASIC\n88basic.idx")
    PpFindN88BasicIdx = PpFindRelIdx(VarPtr(rel), dst)
End Function

' actba64 専用（Declare Lib）。actba32/abc の default.idx には載せない
Function PpFindUnicodeApi(dst As *Byte) As Long
    Dim rel(63) As Byte
    lstrcpy(VarPtr(rel), "Include\default\UnicodeApi.sbp")
    PpFindUnicodeApi = PpFindRelIdx(VarPtr(rel), dst)
End Function

' 行頭（空白可）が #name か。name は小文字。続きは空白/終端/' のみ可
Function PpLineIsHashDir(line As *Byte, n As Long, name As *Byte) As Long
    Dim i As Long
    Dim j As Long
    Dim c As Long

    PpLineIsHashDir = 0
    i = 0
    While i < n
        c = line[i]
        If c <> 32 And c <> 9 Then Exit While
        i = i + 1
    Wend
    If i >= n Or line[i] <> 35 Then Exit Function
    i = i + 1
    j = 0
    While name[j] <> 0
        If i >= n Then Exit Function
        If PpToLower(line[i]) <> name[j] Then Exit Function
        i = i + 1
        j = j + 1
    Wend
    If i < n Then
        c = line[i]
        If c <> 32 And c <> 9 And c <> 39 And c <> 13 And c <> 10 Then Exit Function
    End If
    PpLineIsHashDir = 1
End Function

Function PpSourceHasHashDir(src As *Byte, name As *Byte) As Long
    Dim i As Long
    Dim start As Long
    Dim n As Long
    Dim c As Long
    Dim line(511) As Byte
    Dim j As Long

    PpSourceHasHashDir = 0
    If src = NULL Then Exit Function
    i = 0
    While src[i] <> 0
        start = i
        While src[i] <> 0
            c = src[i]
            If c = 10 Or c = 13 Then Exit While
            i = i + 1
        Wend
        n = i - start
        If n >= PP_LINE_MAX Then n = PP_LINE_MAX - 1
        j = 0
        While j < n
            line[j] = src[start + j]
            j = j + 1
        Wend
        line[n] = 0
        If PpLineIsHashDir(VarPtr(line), n, name) <> 0 Then
            PpSourceHasHashDir = 1
            Exit Function
        End If
        If src[i] = 13 Then i = i + 1
        If src[i] = 10 Then i = i + 1
    Wend
End Function

Function PpDupText(src As *Byte) As *Byte
    Dim n As Long
    Dim dst As *Byte
    PpDupText = NULL
    n = lstrlen(src)
    dst = calloc(n + 1)
    If dst = NULL Then Exit Function
    If n > 0 Then memcpy(dst, src, n)
    dst[n] = 0
    PpDupText = dst
End Function

Function PpConcatText(a As *Byte, aLen As Long, b As *Byte, bLen As Long) As *Byte
    Dim dst As *Byte
    PpConcatText = NULL
    dst = calloc(aLen + bLen + 1)
    If dst = NULL Then Exit Function
    If aLen > 0 And a <> NULL Then memcpy(dst, a, aLen)
    If bLen > 0 And b <> NULL Then memcpy(VarPtr(dst[aLen]), b, bLen)
    dst[aLen + bLen] = 0
    PpConcatText = dst
End Function

' idx を ExpandIncludes して返す（失敗時は警告して空文字相当の "" を返す）
Function PpLoadIdxExpanded(idxPath As *Byte) As *Byte
    Dim idxSrc As *Byte
    Dim idxSize As Long
    Dim part As *Byte
    Dim empty As *Byte

    PpLoadIdxExpanded = NULL
    idxSrc = LoadFile(idxPath, idxSize)
    If idxSrc = NULL Then
        Print "warning: cannot open: " + MakeStr(idxPath)
        empty = calloc(1)
        If empty <> NULL Then empty[0] = 0
        PpLoadIdxExpanded = empty
        Exit Function
    End If
    part = ExpandIncludes(idxSrc, idxSize, idxPath)
    free(idxSrc)
    If part = NULL Then
        Print "warning: preprocess failed: " + MakeStr(idxPath)
        empty = calloc(1)
        If empty <> NULL Then empty[0] = 0
        PpLoadIdxExpanded = empty
        Exit Function
    End If
    PpLoadIdxExpanded = part
End Function

' Include\default を常時先頭へ。#console / #n88basic / #prompt なら各 idx も挿入。
' #n88basic / #prompt 時は GUI サブシステムを有効化し、末尾に N88_Run() を付ける。
Function PpPrependDefaults(src As *Byte) As *Byte
    Dim idxPath(511) As Byte
    Dim head As *Byte
    Dim part As *Byte
    Dim nxt As *Byte
    Dim foot(31) As Byte
    Dim headLen As Long
    Dim partLen As Long
    Dim srcLen As Long
    Dim footLen As Long
    Dim wantCon As Long
    Dim wantN88 As Long
    Dim kCon(15) As Byte
    Dim kn88(15) As Byte
    Dim kPrompt(15) As Byte

    PpPrependDefaults = NULL
    lstrcpy(VarPtr(kCon), "console")
    lstrcpy(VarPtr(kn88), "n88basic")
    lstrcpy(VarPtr(kPrompt), "prompt")
    wantCon = PpSourceHasHashDir(src, VarPtr(kCon))
    wantN88 = PpSourceHasHashDir(src, VarPtr(kn88))
    If wantN88 = 0 Then
        wantN88 = PpSourceHasHashDir(src, VarPtr(kPrompt))
    End If
    g_ppN88Basic = wantN88
    If wantN88 <> 0 Then
        g_ppUseWindow = 1
    End If

    head = calloc(1)
    If head = NULL Then Exit Function
    head[0] = 0
    headLen = 0

    If PpFindDefaultIdx(VarPtr(idxPath)) = 0 Then
        Print "warning: not found: Include\default\default.idx"
    Else
        part = PpLoadIdxExpanded(VarPtr(idxPath))
        If part = NULL Then
            free(head)
            Exit Function
        End If
        partLen = lstrlen(part)
        nxt = PpConcatText(head, headLen, part, partLen)
        free(head)
        free(part)
        If nxt = NULL Then Exit Function
        head = nxt
        headLen = headLen + partLen
    End If

    ' WideChar API（Declare Lib）。actba64 のみ
    If PpFindUnicodeApi(VarPtr(idxPath)) <> 0 Then
        part = PpLoadIdxExpanded(VarPtr(idxPath))
        If part = NULL Then
            free(head)
            Exit Function
        End If
        partLen = lstrlen(part)
        nxt = PpConcatText(head, headLen, part, partLen)
        free(head)
        free(part)
        If nxt = NULL Then Exit Function
        head = nxt
        headLen = headLen + partLen
    End If

    If wantCon <> 0 Then
        If PpFindConsoleIdx(VarPtr(idxPath)) = 0 Then
            Print "warning: not found: Include\console\console.idx"
        Else
            part = PpLoadIdxExpanded(VarPtr(idxPath))
            If part = NULL Then
                free(head)
                Exit Function
            End If
            partLen = lstrlen(part)
            nxt = PpConcatText(head, headLen, part, partLen)
            free(head)
            free(part)
            If nxt = NULL Then Exit Function
            head = nxt
            headLen = headLen + partLen
        End If
    End If

    If wantN88 <> 0 Then
        If PpFindN88BasicIdx(VarPtr(idxPath)) = 0 Then
            Print "warning: not found: Include\N88BASIC\n88basic.idx"
        Else
            part = PpLoadIdxExpanded(VarPtr(idxPath))
            If part = NULL Then
                free(head)
                Exit Function
            End If
            partLen = lstrlen(part)
            nxt = PpConcatText(head, headLen, part, partLen)
            free(head)
            free(part)
            If nxt = NULL Then Exit Function
            head = nxt
            headLen = headLen + partLen
        End If
    End If

    srcLen = lstrlen(src)
    nxt = PpConcatText(head, headLen, src, srcLen)
    free(head)
    If nxt = NULL Then Exit Function
    head = nxt
    headLen = headLen + srcLen

    If wantN88 <> 0 Then
        ' 末尾でメッセージループ（End なら N88_End が先に処理）
        foot[0] = 13
        foot[1] = 10
        lstrcpy(VarPtr(foot[2]), "N88_Run()")
        footLen = lstrlen(VarPtr(foot))
        foot[footLen] = 13
        footLen = footLen + 1
        foot[footLen] = 10
        footLen = footLen + 1
        foot[footLen] = 0
        nxt = PpConcatText(head, headLen, VarPtr(foot), footLen)
        free(head)
        If nxt = NULL Then Exit Function
        head = nxt
    End If

    PpPrependDefaults = head
End Function

Const PJ_MAX_SOURCES = 64
Const PJ_PATH_LEN = 260

Function PpPathEndsWithPj(path As *Byte) As Long
    Dim n As Long
    Dim c0 As Long
    Dim c1 As Long
    Dim c2 As Long
    PpPathEndsWithPj = 0
    n = lstrlen(path)
    If n < 3 Then Exit Function
    c0 = path[n - 3]
    c1 = PpToLower(path[n - 2])
    c2 = PpToLower(path[n - 1])
    If c0 = 46 And c1 = 112 And c2 = 106 Then
        PpPathEndsWithPj = 1
    End If
End Function

Function PpLineIsSourceHeader(line As *Byte, n As Long) As Long
    Dim i As Long
    Dim word(15) As Byte
    Dim k As Long
    Dim c As Long
    PpLineIsSourceHeader = 0
    i = 0
    While i < n
        c = line[i]
        If c <> 32 And c <> 9 Then Exit While
        i = i + 1
    Wend
    If i >= n Then Exit Function
    If line[i] <> 35 Then Exit Function
    i = i + 1
    lstrcpy(VarPtr(word), "source")
    k = 0
    While word[k] <> 0
        If i + k >= n Then Exit Function
        If PpToLower(line[i + k]) <> word[k] Then Exit Function
        k = k + 1
    Wend
    If i + k < n Then
        c = line[i + k]
        If c <> 32 And c <> 9 And c <> 0 Then Exit Function
    End If
    PpLineIsSourceHeader = 1
End Function

' #USEWINDOW=1 / #usewindow=0 （#SOURCE 節の外も含め全行を対象）
Function PpLineUseWindow(line As *Byte, n As Long, ByRef valOut As Long) As Long
    Dim i As Long
    Dim k As Long
    Dim c As Long
    Dim word(15) As Byte
    Dim v As Long
    Dim got As Long

    PpLineUseWindow = 0
    i = 0
    While i < n
        c = line[i]
        If c <> 32 And c <> 9 Then Exit While
        i = i + 1
    Wend
    If i >= n Then Exit Function
    If line[i] <> 35 Then Exit Function
    i = i + 1
    lstrcpy(VarPtr(word), "usewindow")
    k = 0
    While word[k] <> 0
        If i + k >= n Then Exit Function
        If PpToLower(line[i + k]) <> word[k] Then Exit Function
        k = k + 1
    Wend
    i = i + k
    While i < n
        c = line[i]
        If c <> 32 And c <> 9 Then Exit While
        i = i + 1
    Wend
    If i >= n Then Exit Function
    If line[i] <> 61 Then Exit Function
    i = i + 1
    v = 0
    got = 0
    While i < n
        c = line[i]
        If c >= 48 And c <= 57 Then
            v = v * 10 + (c - 48)
            got = 1
        ElseIf c = 32 Or c = 9 Then
            If got <> 0 Then Exit While
        Else
            Exit While
        End If
        i = i + 1
    Wend
    If got = 0 Then Exit Function
    valOut = v
    PpLineUseWindow = 1
End Function

Function PpTrimCopy(line As *Byte, n As Long, dst As *Byte, dstMax As Long) As Long
    Dim i As Long
    Dim j As Long
    Dim c As Long
    PpTrimCopy = 0
    dst[0] = 0
    i = 0
    While i < n
        c = line[i]
        If c <> 32 And c <> 9 Then Exit While
        i = i + 1
    Wend
    If i < n And line[i] = 39 Then Exit Function
    j = 0
    While i < n And j < dstMax - 1
        c = line[i]
        If c = 39 Then Exit While
        dst[j] = c
        j = j + 1
        i = i + 1
    Wend
    While j > 0
        c = dst[j - 1]
        If c <> 32 And c <> 9 Then Exit While
        j = j - 1
    Wend
    dst[j] = 0
    PpTrimCopy = j
End Function

Function CombinePjSources(pjPath As *Byte) As *Byte
    Dim pj As *Byte
    Dim pjSize As Long
    Dim i As Long
    Dim start As Long
    Dim n As Long
    Dim c As Long
    Dim line(511) As Byte
    Dim name(259) As Byte
    Dim full(511) As Byte
    Dim dir(511) As Byte
    Dim inSource As Long
    Dim dst As *Byte
    Dim dstLen As Long
    Dim dstCap As Long
    Dim src As *Byte
    Dim srcSize As Long
    Dim expanded As *Byte
    Dim expLen As Long
    Dim nSrc As Long
    Dim hdr(63) As Byte
    Dim j As Long
    Dim uwVal As Long

    CombinePjSources = NULL
    PpOnceReset()
    g_ppUseWindow = 0
    pj = LoadFile(pjPath, pjSize)
    If pj = NULL Then Exit Function
    PpDirOf(pjPath, VarPtr(dir))

    ' Full actba64.pj sources exceed 256KiB once headers are included.
    dstCap = 2097152
    dst = calloc(dstCap)
    If dst = NULL Then
        free(pj)
        Exit Function
    End If
    dstLen = 0
    dst[0] = 0
    inSource = 0
    nSrc = 0
    i = 0
    While i < pjSize
        start = i
        While i < pjSize
            c = pj[i]
            If c = 10 Or c = 13 Then Exit While
            i = i + 1
        Wend
        n = i - start
        If n >= PP_LINE_MAX Then n = PP_LINE_MAX - 1
        j = 0
        While j < n
            line[j] = pj[start + j]
            j = j + 1
        Wend
        line[n] = 0

        If PpLineUseWindow(VarPtr(line), n, uwVal) <> 0 Then
            g_ppUseWindow = uwVal
        End If

        If PpLineIsSourceHeader(VarPtr(line), n) <> 0 Then
            inSource = 1
        ElseIf inSource <> 0 Then
            j = 0
            While j < n
                c = line[j]
                If c <> 32 And c <> 9 Then Exit While
                j = j + 1
            Wend
            If j < n And line[j] = 35 Then
                inSource = 0
            Else
                If PpTrimCopy(VarPtr(line), n, VarPtr(name), PJ_PATH_LEN) > 0 Then
                    If nSrc >= PJ_MAX_SOURCES Then
                        free(pj)
                        free(dst)
                        Exit Function
                    End If
                    full[0] = 0
                    If (name[1] = 58) Or (name[0] = 92) Or (name[0] = 47) Then
                        lstrcpy(VarPtr(full), VarPtr(name))
                    Else
                        lstrcpy(VarPtr(full), VarPtr(dir))
                        lstrcat(VarPtr(full), VarPtr(name))
                    End If
                    If PpOnceHas(VarPtr(full)) = 0 Then
                        src = LoadFile(VarPtr(full), srcSize)
                        If src = NULL Then
                            free(pj)
                            free(dst)
                            Exit Function
                        End If
                        PpOnceAdd(VarPtr(full))
                        expanded = ExpandIncludes(src, srcSize, VarPtr(full))
                        free(src)
                        If expanded = NULL Then
                            free(pj)
                            free(dst)
                            Exit Function
                        End If
                        lstrcpy(VarPtr(hdr), "' ---- ")
                        If PpAppend(dst, dstLen, dstCap, VarPtr(hdr), lstrlen(VarPtr(hdr))) = 0 Then
                            free(expanded)
                            free(pj)
                            free(dst)
                            Exit Function
                        End If
                        If PpAppend(dst, dstLen, dstCap, VarPtr(name), lstrlen(VarPtr(name))) = 0 Then
                            free(expanded)
                            free(pj)
                            free(dst)
                            Exit Function
                        End If
                        lstrcpy(VarPtr(hdr), " ----")
                        hdr[5] = 13
                        hdr[6] = 10
                        hdr[7] = 0
                        If PpAppend(dst, dstLen, dstCap, VarPtr(hdr), 7) = 0 Then
                            free(expanded)
                            free(pj)
                            free(dst)
                            Exit Function
                        End If
                        expLen = lstrlen(expanded)
                        If PpAppend(dst, dstLen, dstCap, expanded, expLen) = 0 Then
                            free(expanded)
                            free(pj)
                            free(dst)
                            Exit Function
                        End If
                        line[0] = 13
                        line[1] = 10
                        If PpAppend(dst, dstLen, dstCap, VarPtr(line), 2) = 0 Then
                            free(expanded)
                            free(pj)
                            free(dst)
                            Exit Function
                        End If
                        free(expanded)
                    End If
                    nSrc = nSrc + 1
                End If
            End If
        End If
        If i < pjSize And pj[i] = 13 Then i = i + 1
        If i < pjSize And pj[i] = 10 Then i = i + 1
    Wend
    free(pj)
    If nSrc <= 0 Then
        free(dst)
        Exit Function
    End If
    CombinePjSources = dst
End Function
