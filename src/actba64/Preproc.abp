' ===================================================
'  Preproc - #include expansion (source-relative)
' ===================================================

Const PP_MAX_DEPTH = 16
Const PP_LINE_MAX = 512
Const PP_ONCE_PATH = 512

' include-once / #USEWINDOW / #n88basic (module Dims: stage0 Type field limit)
Dim g_ppOnce As *Byte
Dim g_ppOnceCount As Long
Dim g_ppOnceCap As Long
Dim g_ppUseWindow As Long
Dim g_ppN88Basic As Long

Const PP_WITH_MAX = 8
Dim g_ppWithDepth As Long
Dim g_ppWithCur(255) As Byte
Dim g_ppWithStack(PP_WITH_MAX * 256) As Byte

Sub PpWithReset()
    g_ppWithDepth = 0
    g_ppWithCur[0] = 0
End Sub

Sub PpStrCopy(dst As *Byte, src As *Byte)
    Dim i As Long
    i = 0
    While src[i] <> 0 And i < 255
        dst[i] = src[i]
        i = i + 1
    Wend
    dst[i] = 0
End Sub

Function PpStrEqCI(a As *Byte, b As *Byte) As Long
    Dim i As Long
    PpStrEqCI = 0
    i = 0
    While a[i] <> 0 And b[i] <> 0
        If PpToLower(a[i]) <> PpToLower(b[i]) Then Exit Function
        i = i + 1
    Wend
    If a[i] <> b[i] Then Exit Function
    PpStrEqCI = 1
End Function

Function PpLineTrimOff(line As *Byte, n As Long) As Long
    Dim i As Long
    PpLineTrimOff = 0
    i = 0
    While i < n
        If line[i] = 32 Or line[i] = 9 Then
            i = i + 1
        Else
            PpLineTrimOff = i
            Exit Function
        End If
    Wend
    PpLineTrimOff = n
End Function

Function PpIsWithStart(line As *Byte, n As Long, off As Long, exprOut As *Byte) As Long
    Dim k(15) As Byte
    Dim i As Long
    Dim j As Long
    PpIsWithStart = 0
    If off >= n Then Exit Function
    lstrcpy(VarPtr(k), "with")
    If n - off < 4 Then Exit Function
    i = 0
    While k[i] <> 0
        If PpToLower(line[off + i]) <> k[i] Then Exit Function
        i = i + 1
    Wend
    If off + i >= n Then Exit Function
    If line[off + i] <> 32 And line[off + i] <> 9 Then Exit Function
    i = off + i + 1
    While i < n And (line[i] = 32 Or line[i] = 9)
        i = i + 1
    Wend
    j = 0
    While i < n And j < 255
        exprOut[j] = line[i]
        j = j + 1
        i = i + 1
    Wend
    While j > 0 And (exprOut[j - 1] = 32 Or exprOut[j - 1] = 9)
        j = j - 1
    Wend
    exprOut[j] = 0
    If j <= 0 Then Exit Function
    PpIsWithStart = 1
End Function

Function PpIsEndWith(line As *Byte, n As Long, off As Long) As Long
    Dim kEnd(7) As Byte
    Dim kWith(7) As Byte
    Dim i As Long
    Dim j As Long
    PpIsEndWith = 0
    If off >= n Then Exit Function
    lstrcpy(VarPtr(kEnd), "end")
    lstrcpy(VarPtr(kWith), "with")
    i = 0
    While kEnd[i] <> 0
        If off + i >= n Then Exit Function
        If PpToLower(line[off + i]) <> kEnd[i] Then Exit Function
        i = i + 1
    Wend
    i = off + i
    While i < n And (line[i] = 32 Or line[i] = 9)
        i = i + 1
    Wend
    j = 0
    While kWith[j] <> 0
        If i + j >= n Then Exit Function
        If PpToLower(line[i + j]) <> kWith[j] Then Exit Function
        j = j + 1
    Wend
    i = i + j
    While i < n And (line[i] = 32 Or line[i] = 9)
        i = i + 1
    Wend
    If i < n Then Exit Function
    PpIsEndWith = 1
End Function

Function PpDotNeedsBase(line As *Byte, pos As Long) As Long
    Dim c As Long
    PpDotNeedsBase = 0
    If pos <= 0 Then
        PpDotNeedsBase = 1
        Exit Function
    End If
    c = line[pos - 1]
    If c = 32 Or c = 9 Then PpDotNeedsBase = 1
    If c = 40 Or c = 43 Or c = 45 Or c = 42 Or c = 47 Or c = 92 Then PpDotNeedsBase = 1
    If c = 61 Or c = 44 Or c = 60 Or c = 62 Then PpDotNeedsBase = 1
End Function

Function PpRewriteWithLine(line As *Byte, n As Long, out As *Byte, ByRef outN As Long) As Long
    Dim off As Long
    Dim expr(255) As Byte
    Dim i As Long
    Dim j As Long
    Dim k As Long
    Dim stackOff As Long
    PpRewriteWithLine = 0
    outN = 0
    off = PpLineTrimOff(line, n)
    If PpIsWithStart(line, n, off, VarPtr(expr)) <> 0 Then
        If g_ppWithDepth >= PP_WITH_MAX Then Exit Function
        stackOff = g_ppWithDepth * 256
        PpStrCopy(VarPtr(g_ppWithStack[stackOff]), VarPtr(g_ppWithCur))
        PpStrCopy(VarPtr(g_ppWithCur), VarPtr(expr))
        g_ppWithDepth = g_ppWithDepth + 1
        PpRewriteWithLine = 2
        Exit Function
    End If
    If g_ppWithDepth > 0 And PpIsEndWith(line, n, off) <> 0 Then
        g_ppWithDepth = g_ppWithDepth - 1
        If g_ppWithDepth > 0 Then
            stackOff = g_ppWithDepth * 256
            PpStrCopy(VarPtr(g_ppWithCur), VarPtr(g_ppWithStack[stackOff]))
        Else
            g_ppWithCur[0] = 0
        End If
        PpRewriteWithLine = 2
        Exit Function
    End If
    If g_ppWithDepth <= 0 Or g_ppWithCur[0] = 0 Then
        PpRewriteWithLine = 1
        Exit Function
    End If
    j = 0
    i = 0
    While i < n
        If line[i] = 46 Then
            If PpDotNeedsBase(line, i) <> 0 Then
                k = 0
                While g_ppWithCur[k] <> 0 And j < PP_LINE_MAX - 1
                    out[j] = g_ppWithCur[k]
                    j = j + 1
                    k = k + 1
                Wend
            End If
        End If
        If j >= PP_LINE_MAX - 1 Then Exit Function
        out[j] = line[i]
        j = j + 1
        i = i + 1
    Wend
    out[j] = 0
    outN = j
    PpRewriteWithLine = 1
End Function

Function PpIsN88Basic() As Long
    PpIsN88Basic = g_ppN88Basic
End Function

Function PpToLower(c As Long) As Long
    If c >= 65 And c <= 90 Then
        PpToLower = c + 32
    Else
        PpToLower = c
    End If
End Function

Function PpStateInit() As Long
    Dim buf As *Byte
    PpStateInit = 0
    g_ppOnceCap = DYN_INIT
    buf = calloc(BytesN(g_ppOnceCap, PP_ONCE_PATH))
    If buf = NULL Then Exit Function
    g_ppOnce = buf
    g_ppOnceCount = 0
    g_ppUseWindow = 0
    g_ppN88Basic = 0
    PpStateInit = 1
End Function

Sub PpStateFree()
    If g_ppOnce <> NULL Then free(g_ppOnce)
    g_ppOnce = NULL
    g_ppOnceCount = 0
    g_ppOnceCap = 0
End Sub

Sub PpOnceReset()
    g_ppOnceCount = 0
End Sub

Function PpPathEq(a As *Byte, b As *Byte) As Long
    Dim i As Long
    PpPathEq = 0
    i = 0
    While a[i] <> 0 And b[i] <> 0
        If PpToLower(a[i]) <> PpToLower(b[i]) Then Exit Function
        i = i + 1
    Wend
    If a[i] <> b[i] Then Exit Function
    PpPathEq = 1
End Function

Function PpOnceHas(path As *Byte) As Long
    Dim i As Long
    Dim off As Long
    Dim buf As *Byte
    PpOnceHas = 0
    buf = g_ppOnce
    If buf = NULL Then Exit Function
    i = 0
    While i < g_ppOnceCount
        off = i * PP_ONCE_PATH
        If PpPathEq(VarPtr(buf[off]), path) <> 0 Then
            PpOnceHas = 1
            Exit Function
        End If
        i = i + 1
    Wend
End Function

Sub PpOnceAdd(path As *Byte)
    Dim buf As *Byte
    Dim dst As *Byte
    Dim off As Long
    Dim j As Long
    Dim newCap As Long
    Dim p As *Byte
    buf = g_ppOnce
    If buf = NULL Then Exit Sub
    If g_ppOnceCount >= g_ppOnceCap Then
        newCap = g_ppOnceCap * 2
        If newCap <= g_ppOnceCap Then Exit Sub
        p = MemGrow(g_ppOnce, BytesN(g_ppOnceCap, PP_ONCE_PATH), BytesN(newCap, PP_ONCE_PATH))
        If p = NULL Then Exit Sub
        g_ppOnce = p
        g_ppOnceCap = newCap
        buf = g_ppOnce
    End If
    off = g_ppOnceCount * PP_ONCE_PATH
    dst = VarPtr(buf[off])
    j = 0
    While path[j] <> 0 And j < PP_ONCE_PATH - 1
        dst[j] = path[j]
        j = j + 1
    Wend
    dst[j] = 0
    g_ppOnceCount = g_ppOnceCount + 1
End Sub

Sub PpDirOf(path As *Byte, dst As *Byte)
    Dim i As Long
    Dim last As Long
    Dim c As Long
    last = -1
    i = 0
    While path[i] <> 0
        c = path[i]
        If c = 92 Or c = 47 Then last = i
        i = i + 1
    Wend
    If last < 0 Then
        dst[0] = 0
        Exit Sub
    End If
    i = 0
    While i <= last
        dst[i] = path[i]
        i = i + 1
    Wend
    dst[i] = 0
End Sub

Function PpIsIncludeLine(line As *Byte, n As Long) As Long
    Dim i As Long
    Dim k As Long
    Dim c As Long
    Dim word(15) As Byte
    PpIsIncludeLine = 0
    i = 0
    While i < n
        c = line[i]
        If c <> 32 And c <> 9 Then Exit While
        i = i + 1
    Wend
    If i >= n Then Exit Function
    If line[i] <> 35 Then Exit Function
    i = i + 1
    While i < n
        c = line[i]
        If c <> 32 And c <> 9 Then Exit While
        i = i + 1
    Wend
    lstrcpy(VarPtr(word), "include")
    k = 0
    While word[k] <> 0
        If i + k >= n Then Exit Function
        If PpToLower(line[i + k]) <> word[k] Then Exit Function
        k = k + 1
    Wend
    PpIsIncludeLine = 1
End Function

Function PpExtractInclude(line As *Byte, n As Long, dst As *Byte, ByRef isAngle As Long) As Long
    Dim i As Long
    Dim q1 As Long
    Dim q2 As Long
    Dim j As Long
    Dim openCh As Long
    Dim closeCh As Long
    PpExtractInclude = 0
    isAngle = 0
    dst[0] = 0
    q1 = -1
    q2 = -1
    openCh = 0
    closeCh = 0
    i = 0
    While i < n
        If line[i] = 34 Then
            openCh = 34
            closeCh = 34
            q1 = i
            Exit While
        End If
        If line[i] = 60 Then
            openCh = 60
            closeCh = 62
            q1 = i
            isAngle = 1
            Exit While
        End If
        i = i + 1
    Wend
    If q1 < 0 Then Exit Function
    i = q1 + 1
    While i < n
        If line[i] = closeCh Then
            q2 = i
            Exit While
        End If
        i = i + 1
    Wend
    If q2 <= q1 Then Exit Function
    j = 0
    i = q1 + 1
    While i < q2 And j < 250
        dst[j] = line[i]
        j = j + 1
        i = i + 1
    Wend
    dst[j] = 0
    PpExtractInclude = 1
End Function

Function PpAppend(dst As *Byte, ByRef dstLen As Long, dstCap As Long, src As *Byte, n As Long) As Long
    Dim i As Long
    PpAppend = 0
    If dstLen + n + 1 > dstCap Then Exit Function
    i = 0
    While i < n
        dst[dstLen + i] = src[i]
        i = i + 1
    Wend
    dstLen = dstLen + n
    dst[dstLen] = 0
    PpAppend = 1
End Function

Function PpEmitFileMark(dst As *Byte, ByRef dstLen As Long, dstCap As Long, path As *Byte) As Long
    Dim hdr(15) As Byte
    Dim tail(7) As Byte
    PpEmitFileMark = 0
    lstrcpy(VarPtr(hdr), "' ---- ")
    If PpAppend(dst, dstLen, dstCap, VarPtr(hdr), 7) = 0 Then Exit Function
    If PpAppend(dst, dstLen, dstCap, path, lstrlen(path)) = 0 Then Exit Function
    lstrcpy(VarPtr(tail), " ----")
    tail[5] = 13
    tail[6] = 10
    tail[7] = 0
    If PpAppend(dst, dstLen, dstCap, VarPtr(tail), 7) = 0 Then Exit Function
    PpEmitFileMark = 1
End Function

Function PpEmitFileEnd(dst As *Byte, ByRef dstLen As Long, dstCap As Long) As Long
    Dim s(23) As Byte
    PpEmitFileEnd = 0
    lstrcpy(VarPtr(s), "' ---- end ----")
    If PpAppend(dst, dstLen, dstCap, VarPtr(s), 15) = 0 Then Exit Function
    s[0] = 13
    s[1] = 10
    If PpAppend(dst, dstLen, dstCap, VarPtr(s), 2) = 0 Then Exit Function
    PpEmitFileEnd = 1
End Function

Function PpNameIsEnd(name As *Byte) As Long
    PpNameIsEnd = 0
    If name = 0 Then Exit Function
    If PpToLower(name[0]) <> 101 Then Exit Function
    If PpToLower(name[1]) <> 110 Then Exit Function
    If PpToLower(name[2]) <> 100 Then Exit Function
    If name[3] <> 0 Then Exit Function
    PpNameIsEnd = 1
End Function

Function PpLineIsFileMark(line As *Byte, n As Long, nameOut As *Byte, nameMax As Long) As Long
    Dim i As Long
    Dim nameLen As Long
    PpLineIsFileMark = 0
    nameOut[0] = 0
    i = 0
    While i < n
        If line[i] <> 32 And line[i] <> 9 Then Exit While
        i = i + 1
    Wend
    If i + 7 > n Then Exit Function
    If line[i] <> 39 Then Exit Function
    If line[i + 1] <> 32 Then Exit Function
    If line[i + 2] <> 45 Then Exit Function
    If line[i + 3] <> 45 Then Exit Function
    If line[i + 4] <> 45 Then Exit Function
    If line[i + 5] <> 45 Then Exit Function
    If line[i + 6] <> 32 Then Exit Function
    i = i + 7
    nameLen = 0
    While i < n
        If i + 5 <= n Then
            If line[i] = 32 And line[i + 1] = 45 And line[i + 2] = 45 And line[i + 3] = 45 And line[i + 4] = 45 Then
                Exit While
            End If
        End If
        If nameLen < nameMax - 1 Then
            nameOut[nameLen] = line[i]
            nameLen = nameLen + 1
        End If
        i = i + 1
    Wend
    nameOut[nameLen] = 0
    If nameLen <= 0 Then Exit Function
    PpLineIsFileMark = 1
End Function

Function PpMapSrcName$(src As *Byte, combLine As Long, ByRef localLine As Long) As String
    Dim i As Long
    Dim start As Long
    Dim n As Long
    Dim cur As Long
    Dim c As Long
    Dim sp As Long
    Dim off As Long
    Dim name(259) As Byte
    Dim names(4159) As Byte
    Dim locs(15) As Long
    Dim k As Long

    PpMapSrcName$ = ""
    localLine = combLine
    If src = 0 Then Exit Function
    If combLine <= 0 Then combLine = 1
    i = 0
    cur = 1
    sp = 0
    While src[i] <> 0
        start = i
        While src[i] <> 0
            c = src[i]
            If c = 10 Or c = 13 Then Exit While
            i = i + 1
        Wend
        n = i - start
        If PpLineIsFileMark(VarPtr(src[start]), n, VarPtr(name), 260) <> 0 Then
            If PpNameIsEnd(VarPtr(name)) <> 0 Then
                If sp > 0 Then sp = sp - 1
            Else
                If sp < 16 Then
                    off = sp * 260
                    k = 0
                    While name[k] <> 0 And k < 259
                        names[off + k] = name[k]
                        k = k + 1
                    Wend
                    names[off + k] = 0
                    locs[sp] = 0
                    sp = sp + 1
                End If
            End If
        Else
            If sp > 0 Then locs[sp - 1] = locs[sp - 1] + 1
        End If
        If cur >= combLine Then Exit While
        If src[i] = 13 Then i = i + 1
        If src[i] = 10 Then i = i + 1
        cur = cur + 1
    Wend
    If sp > 0 Then
        off = (sp - 1) * 260
        localLine = locs[sp - 1]
        If localLine < 1 Then localLine = 1
        PpMapSrcName$ = MakeStr(VarPtr(names[off]))
    End If
End Function

Function PpErrLoc$(src As *Byte, combLine As Long) As String
    Dim file As String
    Dim localLine As Long
    file = PpMapSrcName$(src, combLine, localLine)
    If Len(file) > 0 Then
        PpErrLoc$ = file + "(" + Str$(localLine) + ")"
    Else
        PpErrLoc$ = "line " + Str$(combLine)
    End If
End Function

Function PpExpandInto(dst As *Byte, ByRef dstLen As Long, dstCap As Long, src As *Byte, srcSize As Long, curFile As *Byte, depth As Long) As Long
    Dim i As Long
    Dim start As Long
    Dim n As Long
    Dim c As Long
    Dim line(511) As Byte
    Dim inc(255) As Byte
    Dim full(511) As Byte
    Dim dir(511) As Byte
    Dim child As *Byte
    Dim childSize As Long
    Dim j As Long
    Dim wOut(511) As Byte
    Dim wN As Long
    Dim wSt As Long

    PpExpandInto = 0
    If depth >= PP_MAX_DEPTH Then Exit Function
    If depth = 0 Then PpWithReset()
    If PpEmitFileMark(dst, dstLen, dstCap, curFile) = 0 Then Exit Function
    i = 0
    While i < srcSize
        start = i
        While i < srcSize
            c = src[i]
            If c = 10 Or c = 13 Then Exit While
            i = i + 1
        Wend
        n = i - start
        If n >= PP_LINE_MAX Then n = PP_LINE_MAX - 1
        j = 0
        While j < n
            line[j] = src[start + j]
            j = j + 1
        Wend
        line[n] = 0
        If PpIsIncludeLine(VarPtr(line), n) <> 0 Then
            Dim isAngle As Long
            isAngle = 0
            If PpExtractInclude(VarPtr(line), n, VarPtr(inc), isAngle) = 0 Then Exit Function
            full[0] = 0
            If inc[0] = 0 Then Exit Function
            If isAngle <> 0 Then
                If PpResolveAngleInclude(VarPtr(inc), VarPtr(full)) = 0 Then Exit Function
            ElseIf (inc[1] = 58) Or (inc[0] = 92) Or (inc[0] = 47) Then
                lstrcpy(VarPtr(full), VarPtr(inc))
            Else
                PpDirOf(curFile, VarPtr(dir))
                lstrcpy(VarPtr(full), VarPtr(dir))
                lstrcat(VarPtr(full), VarPtr(inc))
            End If
            If n > 0 Then
                If PpAppend(dst, dstLen, dstCap, VarPtr(line), n) = 0 Then Exit Function
            End If
            line[0] = 13
            line[1] = 10
            If PpAppend(dst, dstLen, dstCap, VarPtr(line), 2) = 0 Then Exit Function
            If PpOnceHas(VarPtr(full)) = 0 Then
                child = LoadFile(VarPtr(full), childSize)
                If child = NULL Then Exit Function
                PpOnceAdd(VarPtr(full))
                If PpExpandInto(dst, dstLen, dstCap, child, childSize, VarPtr(full), depth + 1) = 0 Then
                    free(child)
                    Exit Function
                End If
                free(child)
            End If
        Else
            wSt = PpRewriteWithLine(VarPtr(line), n, VarPtr(wOut), wN)
            If wSt = 0 Then Exit Function
            If wSt = 2 Then
                ' With / End With 行は出力しない
            ElseIf wSt = 1 And wN > 0 Then
                If PpAppend(dst, dstLen, dstCap, VarPtr(wOut), wN) = 0 Then Exit Function
                line[0] = 13
                line[1] = 10
                If PpAppend(dst, dstLen, dstCap, VarPtr(line), 2) = 0 Then Exit Function
            Else
                If n > 0 Then
                    If PpAppend(dst, dstLen, dstCap, VarPtr(line), n) = 0 Then Exit Function
                End If
                line[0] = 13
                line[1] = 10
                If PpAppend(dst, dstLen, dstCap, VarPtr(line), 2) = 0 Then Exit Function
            End If
        End If
        If i < srcSize And src[i] = 13 Then i = i + 1
        If i < srcSize And src[i] = 10 Then i = i + 1
    Wend
    If PpEmitFileEnd(dst, dstLen, dstCap) = 0 Then Exit Function
    PpExpandInto = 1
End Function

Function ExpandIncludes(src As *Byte, srcSize As Long, srcPath As *Byte) As *Byte
    Dim dst As *Byte
    Dim dstLen As Long
    Dim dstCap As Long

    ExpandIncludes = NULL
    dstCap = BytesN(srcSize, 8) + 262144
    If dstCap < 2097152 Then dstCap = 2097152
    dst = calloc(dstCap)
    If dst = NULL Then Exit Function
    dstLen = 0
    dst[0] = 0
    If PpExpandInto(dst, dstLen, dstCap, src, srcSize, srcPath, 0) = 0 Then
        free(dst)
        Exit Function
    End If
    ExpandIncludes = dst
End Function

