' AstLowerDecl - 宣言の登録と関数の入口

' Lib "kernel32" / "kernel32.dll" -> "kernel32.dll"（空は失敗）
' 戻り値 true : 正常終了  false : エラーあり
Function LowNormLibName(libName As *Byte, dst As *Byte) As boolean
    Dim i As Long
    Dim n As Long
    Dim c As Long
    Dim hasDot As Long

    LowNormLibName = false
    If libName = NULL Then Exit Function
    If libName[0] = CH_NUL Then Exit Function
    i = 0
    hasDot = 0
    While libName[i] <> CH_NUL And i < SYM_NAME_LEN - 5
        c = libName[i]
        dst[i] = c As Byte
        If c = CH_DOT Then hasDot = 1
        i = i + 1
    Wend
    If libName[i] <> CH_NUL Then Exit Function
    n = i
    If hasDot = 0 Then
        dst[n] = CH_DOT
        dst[n + 1] = CH_Ld
        dst[n + 2] = CH_Ll
        dst[n + 3] = CH_Ll
        dst[n + 4] = CH_NUL
    Else
        dst[n] = CH_NUL
    End If
    LowNormLibName = true
End Function

Function AstToIrDeclByRefBits(nodes As *AstNode, stmt As Long) As Long
    Dim param As Long
    Dim byRefBits As Long
    Dim bit As Long
    byRefBits = 0
    bit = 1
    param = nodes[stmt].left
    While param >= 0
        If nodes[param].num <> 0 Then
            byRefBits = byRefBits + bit
        End If
        bit = bit * 2
        param = nodes[param].nxt
    Wend
    AstToIrDeclByRefBits = byRefBits
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function AstToIrRegDecls(ctx As *LowerCtx, prog As Long) As boolean
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim stmt As Long
    Dim namePtr(SYM_NAME_LEN - 1) As Byte
    Dim apiBuf(SYM_NAME_LEN - 1) As Byte
    Dim libBuf(SYM_NAME_LEN - 1) As Byte
    Dim dllNorm(SYM_NAME_LEN - 1) As Byte
    Dim byRefBits As Long

    AstToIrRegDecls = false
    ast = ctx->ast
    nodes = ast->nodes
    stmt = nodes[prog].left
    While stmt >= 0
        If nodes[stmt].kind = AST_DECLARE Then
            AstCopyStr(ast, stmt, VarPtr(namePtr))
            libBuf[0] = 0
            apiBuf[0] = 0
            If nodes[stmt].right >= 0 Then
                AstCopyStr(ast, nodes[stmt].right, VarPtr(libBuf))
            End If
            If nodes[stmt].extra >= 0 Then
                AstCopyStr(ast, nodes[stmt].extra, VarPtr(apiBuf))
            End If
            If apiBuf[0] = 0 Then
                AstCopyStr(ast, stmt, VarPtr(apiBuf))
            End If
            If Not LowNormLibName(VarPtr(libBuf), VarPtr(dllNorm)) Then
                Print "error: empty or too long Declare Lib for '" + MakeStr(VarPtr(namePtr)) + "'"
                Exit Function
            End If
            byRefBits = AstToIrDeclByRefBits(nodes, stmt)
            If Not LowAddDecl(ctx, VarPtr(namePtr), VarPtr(apiBuf), VarPtr(dllNorm), byRefBits) Then Exit Function
            LowRegDeclSig(nodes, stmt, ctx->declCount - 1)
        End If
        stmt = nodes[stmt].nxt
    Wend
    AstToIrRegDecls = true
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function AstToIrRegEnum(ctx As *LowerCtx, enumIdx As Long) As boolean
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim mem As Long
    Dim namePtr(SYM_NAME_LEN - 1) As Byte
    Dim v As Long
    Dim last As Long
    Dim hasLast As Long

    AstToIrRegEnum = false
    ast = ctx->ast
    nodes = ast->nodes
    mem = nodes[enumIdx].left
    last = 0
    hasLast = 0
    While mem >= 0
        If nodes[mem].kind <> AST_ENUMMEM Then
            ctx->err = 1
            Exit Function
        End If
        If nodes[mem].left >= 0 Then
            v = LowConstEval(ctx, nodes[mem].left)
            If v < 0 Then
                AstCopyStr(ast, mem, VarPtr(namePtr))
                Print "error: invalid enum value for '" + MakeStr(VarPtr(namePtr)) + "'"
                ctx->err = 1
                Exit Function
            End If
        Else
            If hasLast = 0 Then
                v = 1
            Else
                v = last + 1
            End If
        End If
        AstCopyStr(ast, mem, VarPtr(namePtr))
        If Not LowAddConst(ctx, VarPtr(namePtr), v) Then Exit Function
        last = v
        hasLast = 1
        mem = nodes[mem].nxt
    Wend
    AstToIrRegEnum = true
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function AstToIrRegConsts(ctx As *LowerCtx, prog As Long) As boolean
    AstToIrRegConsts = false
    LowAddBuiltinConsts(ctx)
    If LowRegConstList(ctx, prog) = 0 Then Exit Function
    AstToIrRegConsts = true
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function AstToIrRegFuncs(ctx As *LowerCtx, prog As Long) As boolean
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim stmt As Long
    Dim param As Long
    Dim namePtr(SYM_NAME_LEN - 1) As Byte
    Dim labFn As Long
    Dim byRefBits As Long
    Dim bit As Long

    AstToIrRegFuncs = false
    ast = ctx->ast
    nodes = ast->nodes
    stmt = nodes[prog].left
    While stmt >= 0
        If nodes[stmt].kind = AST_FUNC Then
            labFn = LowNewLabel(ctx)
            AstCopyStr(ast, stmt, VarPtr(namePtr))
            If LowFuncFresh(ctx, stmt, VarPtr(namePtr)) = 0 Then Exit Function
            byRefBits = 0
            bit = 1
            param = nodes[stmt].left
            While param >= 0
                If nodes[param].num <> 0 Then
                    byRefBits = byRefBits + bit
                End If
                bit = bit * 2
                param = nodes[param].nxt
            Wend
            If Not LowAddFunc(ctx, VarPtr(namePtr), labFn, byRefBits) Then Exit Function
            LowRegFuncSig(nodes, stmt, ctx->funcCount - 1)
            If LowNoteFunc(VarPtr(namePtr), labFn, nodes[stmt].num) = 0 Then Exit Function
            ' extra は Parser が書いた戻り型のまま残す（lab は funcLabs）。
            ' extra を lab で上書きすると TY_STRING/TY_DOUBLE と衝突し、
            ' String 戻りが Double 変換されたり GC ルートから外れる。
        End If
        stmt = nodes[stmt].nxt
    Wend
    If LowEnsureStartup(ctx) = 0 Then Exit Function
    AstToIrRegFuncs = true
End Function

Function AstToIrCaptureParams(ctx As *LowerCtx, stmt As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList
    Dim param As Long
    Dim offs As *Long
    Dim pi As Long
    Dim j As Long
    Dim slot As Long
    Dim types As *Long

    list = ctx->list
    ast = ctx->ast
    nodes = ast->nodes
    offs = ctx->offs
    types = ctx->types
    pi = 0
    slot = 8
    param = nodes[stmt].left
    While param >= 0
        If TyIs32() <> 0 Then
            offs[pi] = slot
            slot = slot + LowParamBytes(nodes[param].extra, nodes[param].num)
        ElseIf pi = 0 Then
            IrEmit(list, OP_STORE_LOCAL_ECX, offs[pi], 0)
        ElseIf pi = 1 Then
            IrEmit(list, OP_STORE_LOCAL_EDX, offs[pi], 0)
        ElseIf pi = 2 Then
            IrEmit(list, OP_STORE_LOCAL_R8, offs[pi], 0)
        ElseIf pi = 3 Then
            IrEmit(list, OP_STORE_LOCAL_R9, offs[pi], 0)
        Else
            ' stack arg already at [rbp+0x30+(pi-4)*8]
            ' LowAddSym が付けた precise root を実オフセットへ付け替える
            LowRetargetFnPreciseRoot(offs[pi], ABI_STACK_ARG0 + (pi - 4) * ABI_SLOT)
            offs[pi] = ABI_STACK_ARG0 + (pi - 4) * ABI_SLOT
        End If
        ' Long 引数をここで ZX してはいけない。BytePtr / HWND / VoidPtr
        ' は ParseEatLongAlias で TY_LONG になっており、ヒープの StrPtr
        ' を 32bit に切ると D3DCompile 等が AV する。添字は LowAddr 側で ZX。
        pi = pi + 1
        param = nodes[param].nxt
    Wend
    ' 非引数ローカル（戻り値スロット含む）を 0 初期化。
    ' String を未初期化のまま StoreString→StrFree するとスタックゴミを
    ' HeapFree して AV するため必須。
    j = pi
    While j < ctx->symCount
        LowEmitZeroSlot(list, offs[j], types[j])
        j = j + 1
    Wend
    If TyIs32() <> 0 Then
        AstToIrCaptureParams = slot - 8
    Else
        AstToIrCaptureParams = pi
    End If
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function AstToIrBindFuncSyms(ctx As *LowerCtx, stmt As Long, retBuf As *Byte) As boolean
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim param As Long
    Dim namePtr(SYM_NAME_LEN - 1) As Byte
    Dim nFlags As Long
    Dim typeKind As Long
    Dim nbytes As Long
    Dim typeIdx As Long
    Dim isByRef As Long

    AstToIrBindFuncSyms = false
    ast = ctx->ast
    nodes = ast->nodes
    nFlags = nodes[stmt].num
    If (nFlags And AST_FUNC_SUB) <> 0 Then
        retBuf[0] = 0
    Else
        AstCopyStr(ast, stmt, retBuf)
    End If
    param = nodes[stmt].left
    While param >= 0
        AstCopyStr(ast, param, VarPtr(namePtr))
        isByRef = nodes[param].num
        typeKind = nodes[param].extra
        If typeKind < 0 Then typeKind = TY_LONG
        typeIdx = nodes[param].right
        nbytes = TyPtrSize()
        If LowAddSym(ctx, VarPtr(namePtr), typeKind, nbytes, typeIdx, isByRef) < 0 Then Exit Function
        param = nodes[param].nxt
    Wend
    If retBuf[0] <> 0 Then
        typeKind = nodes[stmt].extra
        If typeKind <> TY_STRING And typeKind <> TY_DOUBLE And typeKind <> TY_SINGLE Then
            If typeKind <> TY_PTR_BYTE And typeKind <> TY_PTR_LONG And typeKind <> TY_PTR_UDT Then
                typeKind = TY_LONG
            End If
        End If
        If LowAddSym(ctx, retBuf, typeKind, 8, -1, 0) < 0 Then Exit Function
    End If
    ' locals: all Dims in body including nested If/Select/loops
    If Not LowCollectDimsInList(ctx, nodes[stmt].right, 0) Then Exit Function
    AstToIrBindFuncSyms = true
End Function

Function AstToIrEmitFuncSetup(ctx As *LowerCtx, stmt As Long, retBuf As *Byte) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim list As *IrList
    Dim namePtr(SYM_NAME_LEN - 1) As Byte
    Dim labFn As Long
    Dim frame As Long

    AstToIrEmitFuncSetup = -1
    ast = ctx->ast
    list = ctx->list
    nodes = ast->nodes
    ctx->symCount = 0
    ctx->frameUsed = 0
    ctx->inFunc = 1
    g_lowClassTi = -1
    g_doEndLab = -1
    g_doTopLab = -1
    g_whileEndLab = -1
    g_whileTopLab = -1
    g_forEndLab = -1
    g_forContLab = -1
    g_funcEndLab = -1
    LowResetFnPreciseRoots()
    If Not AstToIrBindFuncSyms(ctx, stmt, retBuf) Then Exit Function
    frame = LowAlign16(ctx->frameUsed + &H28 + &H2000)
    If frame < &H28 Then frame = &H28
    g_funcEndLab = LowNewLabel(ctx)
    AstCopyStr(ast, stmt, VarPtr(namePtr))
    g_lowClassTi = AccClassOfName(ast->types, VarPtr(namePtr))
    labFn = LowFindFunc(ctx, VarPtr(namePtr))
    If labFn < 0 Then
        Print "error: missing function label '" + MakeStr(VarPtr(namePtr)) + "'"
        Exit Function
    End If
    IrEmit(list, OP_LABEL, labFn, 0)
    IrEmit(list, OP_ENTER, frame, 0)
    AstToIrEmitFuncSetup = AstToIrCaptureParams(ctx, stmt)
End Function
