' AstLowerSym - シンボル表とオフセットの読み書き

Function LowEnsureDeclCap(ctx As *LowerCtx) As Long
    Dim newCap As Long
    Dim p As *Byte
    LowEnsureDeclCap = 0
    If ctx->declCount < g_declCap Then
        LowEnsureDeclCap = 1
        Exit Function
    End If
    newCap = g_declCap * 2
    If newCap <= g_declCap Then Exit Function
    p = MemGrow(ctx->declNames, BytesN(g_declCap, SYM_NAME_LEN), BytesN(newCap, SYM_NAME_LEN))
    If p = NULL Then Exit Function
    ctx->declNames = p
    g_freeDeclNames = p
    p = MemGrow(ctx->declApiNames, BytesN(g_declCap, SYM_NAME_LEN), BytesN(newCap, SYM_NAME_LEN))
    If p = NULL Then Exit Function
    ctx->declApiNames = p
    g_freeDeclApiNames = p
    p = MemGrow(ctx->declDlls As BytePtr, BytesN(g_declCap, SizeOf(Long)), BytesN(newCap, SizeOf(Long)))
    If p = NULL Then Exit Function
    ctx->declDlls = p As *Long
    g_freeDeclDlls = p
    p = MemGrow(ctx->declByRefs As BytePtr, BytesN(g_declCap, SizeOf(Long)), BytesN(newCap, SizeOf(Long)))
    If p = NULL Then Exit Function
    ctx->declByRefs = p As *Long
    g_freeDeclByRefs = p
    g_declCap = newCap
    LowEnsureDeclCap = 1
End Function

Function LowToLower(c As Long) As Long
    If c >= 65 And c <= 90 Then
        LowToLower = c + 32
    Else
        LowToLower = c
    End If
End Function

Function LowNameEq(a As *Byte, b As *Byte) As Long
    Dim i As Long
    LowNameEq = 0
    i = 0
    Do
        If LowToLower(a[i]) <> LowToLower(b[i]) Then Exit Function
        If a[i] = 0 Then
            LowNameEq = 1
            Exit Function
        End If
        i = i + 1
    Loop
End Function

' 組み込みランタイム呼び出し（FillMemory / malloc 等）— 綴りは大小無視
Function LowIntrinNameEq(name As *Byte, canon As *Byte) As Long
    LowIntrinNameEq = ByteNameEqCI(name, canon)
End Function

Function LowNameEqExact(a As *Byte, b As *Byte) As Long
    Dim i As Long
    LowNameEqExact = 0
    i = 0
    Do
        If a[i] <> b[i] Then Exit Function
        If a[i] = 0 Then
            LowNameEqExact = 1
            Exit Function
        End If
        i = i + 1
    Loop
End Function

Function LowFindSym(ctx As *LowerCtx, name As *Byte) As Long
    Dim i As Long
    Dim names As *Byte
    Dim off As Long
    LowFindSym = -1
    names = ctx->names
    i = 0
    While i < ctx->symCount
        off = i * SYM_NAME_LEN
        If LowNameEqExact(VarPtr(names[off]), name) <> 0 Then
            LowFindSym = i
            Exit Function
        End If
        i = i + 1
    Wend
End Function

Sub LowAddSymRoots(isByRef As Long, typeKind As Long, off As Long, sz As Long)
    If isByRef = 0 Then
        If typeKind = TY_STRING Then
            LowAppendFnPreciseRoot(off)
        ElseIf typeKind = TY_STRING_ARR Then
            LowAppendFnPreciseStringArr(off, sz)
        End If
    End If
End Sub

Function LowAddSym(ctx As *LowerCtx, name As *Byte, typeKind As Long, nbytes As Long, typeIdx As Long, isByRef As Long) As Long
    Dim i As Long
    Dim names As *Byte
    Dim offs As *Long
    Dim types As *Long
    Dim typeIdxs As *Long
    Dim byRefs As *Long
    Dim j As Long
    Dim off As Long
    Dim sz As Long

    LowAddSym = -1
    i = LowFindSym(ctx, name)
    If i >= 0 Then
        LowAddSym = i
        Exit Function
    End If
    If LowEnsureSymCap(ctx) = 0 Then
        Print "error: out of memory (locals/syms)"
        ctx->err = 1
        Exit Function
    End If
    i = ctx->symCount
    names = ctx->names
    offs = ctx->offs
    types = ctx->types
    typeIdxs = ctx->typeIdxs
    byRefs = ctx->byRefs
    off = i * SYM_NAME_LEN
    j = 0
    While name[j] <> 0 And j < SYM_NAME_LEN - 1
        names[off + j] = name[j]
        j = j + 1
    Wend
    names[off + j] = 0
    sz = nbytes
    sz = TySlotAlign(sz)
    ctx->frameUsed = ctx->frameUsed + sz
    offs[i] = 0 - ctx->frameUsed
    types[i] = typeKind
    typeIdxs[i] = typeIdx
    byRefs[i] = isByRef
    ctx->symCount = i + 1
    LowAddSymRoots(isByRef, typeKind, offs[i], sz)
    LowAddSym = i
End Function

Function LowFindGlob(ctx As *LowerCtx, name As *Byte) As Long
    Dim i As Long
    Dim names As *Byte
    Dim off As Long
    LowFindGlob = -1
    names = g_globNames
    If names = NULL Then Exit Function
    i = 0
    While i < g_globCount
        off = i * SYM_NAME_LEN
        If LowNameEqExact(VarPtr(names[off]), name) <> 0 Then
            LowFindGlob = i
            Exit Function
        End If
        i = i + 1
    Wend
End Function

Function LowAddGlob(ctx As *LowerCtx, name As *Byte, typeKind As Long, nbytes As Long, typeIdx As Long) As Long
    Dim i As Long
    Dim names As *Byte
    Dim offs As *Long
    Dim types As *Long
    Dim typeIdxs As *Long
    Dim j As Long
    Dim off As Long
    Dim sz As Long

    LowAddGlob = -1
    i = LowFindGlob(ctx, name)
    If i >= 0 Then
        LowAddGlob = i
        Exit Function
    End If
    If LowEnsureGlobCap(ctx) = 0 Then
        Print "error: out of memory (globals)"
        ctx->err = 1
        Exit Function
    End If
    i = g_globCount
    names = g_globNames
    offs = g_globOffs As *Long
    types = g_globTypes As *Long
    typeIdxs = g_globTypeIdxs As *Long
    off = i * SYM_NAME_LEN
    j = 0
    While name[j] <> 0 And j < SYM_NAME_LEN - 1
        names[off + j] = name[j]
        j = j + 1
    Wend
    names[off + j] = 0
    sz = nbytes
    sz = TySlotAlign(sz)
    offs[i] = g_globDataSize
    g_globDataSize = g_globDataSize + sz
    types[i] = typeKind
    typeIdxs[i] = typeIdx
    g_globNbytes[i] = sz
    g_globCount = i + 1
    LowAddGlob = i
End Function

' Resolve name: locals first, then module globals.
' Out params as *Byte (self-host parser rejects *Long params); cast to *Long locally.
Function LowLookupVar(ctx As *LowerCtx, name As *Byte, oOffB As *Byte, oTyB As *Byte, oTiB As *Byte, oBrB As *Byte, oGlB As *Byte) As Long
    Dim si As Long
    Dim offs As *Long
    Dim types As *Long
    Dim typeIdxs As *Long
    Dim byRefs As *Long
    Dim oOff As *Long
    Dim oTy As *Long
    Dim oTi As *Long
    Dim oBr As *Long
    Dim oGl As *Long

    oOff = oOffB As *Long
    oTy = oTyB As *Long
    oTi = oTiB As *Long
    oBr = oBrB As *Long
    oGl = oGlB As *Long
    LowLookupVar = 0
    oGl[0] = 0
    oBr[0] = 0
    oOff[0] = 0
    oTy[0] = 0
    oTi[0] = -1
    si = LowFindSym(ctx, name)
    If si >= 0 Then
        offs = ctx->offs
        types = ctx->types
        typeIdxs = ctx->typeIdxs
        byRefs = ctx->byRefs
        oOff[0] = offs[si]
        oTy[0] = types[si]
        oTi[0] = typeIdxs[si]
        oBr[0] = byRefs[si]
        LowLookupVar = 1
        Exit Function
    End If
    si = LowFindGlob(ctx, name)
    If si >= 0 Then
        offs = g_globOffs As *Long
        types = g_globTypes As *Long
        typeIdxs = g_globTypeIdxs As *Long
        oOff[0] = offs[si]
        oTy[0] = types[si]
        oTi[0] = typeIdxs[si]
        oBr[0] = 0
        oGl[0] = 1
        LowLookupVar = 1
    End If
End Function

Sub LowEmitLeaOff(list As *IrList, off As Long, isGlob As Long)
    If isGlob <> 0 Then
        IrEmit(list, OP_LEA_RAX_GLOB, off, 0)
    Else
        IrEmit(list, OP_LEA_LOCAL, off, 0)
    End If
End Sub

Sub LowEmitLoadOff(list As *IrList, off As Long, isGlob As Long)
    If isGlob <> 0 Then
        IrEmit(list, OP_LEA_RAX_GLOB, off, 0)
        IrEmit(list, OP_LOAD_PTR, 0, 0)
    Else
        IrEmit(list, OP_LOAD_LOCAL, off, 0)
    End If
End Sub

Sub LowEmitStoreOff(list As *IrList, off As Long, isGlob As Long)
    If isGlob <> 0 Then
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        IrEmit(list, OP_LEA_RAX_GLOB, off, 0)
        IrEmit(list, OP_POP_RCX, 0, 0)
        IrEmit(list, OP_STORE_PTR, 0, 0)
    Else
        IrEmit(list, OP_STORE_LOCAL, off, 0)
    End If
End Sub

' String 代入: ポインタ格納のみ（解放は StrCollect）
Sub LowEmitStoreString(ctx As *LowerCtx, off As Long, isGlob As Long)
    LowEmitStoreOff(ctx->list, off, isGlob)
End Sub

' AST_NUM.extra: 0=整数, 1=Single IEEE bits, 4=Double IEEE bits (Ast.abp)

Function LowPromoteType(a As Long, b As Long) As Long
    If a = TY_DOUBLE Or b = TY_DOUBLE Then
        LowPromoteType = TY_DOUBLE
    ElseIf a = TY_SINGLE Or b = TY_SINGLE Then
        LowPromoteType = TY_SINGLE
    Else
        LowPromoteType = TY_LONG
    End If
End Function
