#console
Declare Function ExitProcess Lib "kernel32.dll" (uExitCode As Long) As Long
Function GetCmdProbe(cnt As Long, buf As *Byte) As Long
    Dim ctmp[260] As Byte
    Dim i As Long
    i = 0
    While i < 260
        ctmp[i] = 0
        i = i + 1
    Wend
    ctmp[0] = 65
    ctmp[1] = 66
    buf[0] = ctmp[0]
    buf[1] = ctmp[1]
    buf[2] = 0
    GetCmdProbe = 1
End Function
Sub Main()
    Dim arg[260] As Byte
    If GetCmdProbe(0, VarPtr(arg)) = 0 Then ExitProcess(1)
    If arg[0] <> 65 Then ExitProcess(2)
    If arg[1] <> 66 Then ExitProcess(3)
    ExitProcess(42)
End Sub
Main()
End
