' SrcEnc - ソースを内部 UTF-8 にする（変換本体は common\TextEnc.abp）

Function LoadText(path As *Byte, ByRef outSize As Long) As *Byte
    Dim raw As *Byte
    LoadText = 0
    raw = LoadFile(path, outSize)
    If raw = 0 Then raw = LoadEmptyText(path, outSize)
    If raw = 0 Then Exit Function
    LoadText = Enc_Normalize(raw, outSize)
End Function

' LoadFile は 0 バイトのファイルにも 0 を返す。開けるなら空のテキストにする
' （中身のない #include "lib.sbp" を「開けません」にしないため）
Function LoadEmptyText(path As *Byte, ByRef outSize As Long) As *Byte
    Dim hFile As HANDLE
    LoadEmptyText = 0
    outSize = 0
    hFile = FileOpenRead(path)
    If hFile = INVALID_HANDLE_VALUE Then Exit Function
    If FileSizeOrZero(hFile) = 0 Then LoadEmptyText = calloc(1)
    CloseHandle(hFile)
End Function
