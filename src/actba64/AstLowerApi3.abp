' --- split from AstLowerApi.abp (part 3) ---
Sub LowEmitApiCallShadow(list As *IrList, dllKind As Long, apiName As *Byte)
    Dim stk As Long
    stk = LowCallStk(0)
    If stk > 0 Then
        IrEmit(list, OP_SUB_RSP, stk, 0)
    End If
    IrEmitStr(list, OP_CALL_API, dllKind, apiName)
    LowEmitCallFinish(list, stk)
End Sub

' rax = byte count; HeapAlloc(GetProcessHeap(), flags, rax)
Sub LowEmitHeapAllocRax(list As *IrList, flags As DWord)
    Dim stk As Long
    Dim sApi(15) As Byte
    Dim ps As Long
    ps = TyPtrSize()
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    lstrcpy(VarPtr(sApi), "GetProcessHeap")
    LowEmitApiCallShadow(list, IR_DLL_KERNEL32, VarPtr(sApi))
    stk = LowCallStk(3)
    If stk > 0 Then
        IrEmit(list, OP_SUB_RSP, stk, 0)
    End If
    IrEmit(list, OP_STORE_RSP_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, flags, 0)
    IrEmit(list, OP_STORE_RSP_RAX, ps, 0)
    IrEmit(list, OP_LOAD_RSP_RAX, stk, 0)
    IrEmit(list, OP_STORE_RSP_RAX, ps + ps, 0)
    LowEmitLoadRegArgs(list, 3)
    lstrcpy(VarPtr(sApi), "HeapAlloc")
    IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sApi))
    LowEmitCallFinish(list, stk)
    IrEmit(list, OP_POP_RCX, 0, 0)
End Sub

' rax = block; HeapFree(GetProcessHeap(), 0, rax)
Sub LowEmitHeapFreeRax(list As *IrList)
    Dim stk As Long
    Dim sApi(15) As Byte
    Dim ps As Long
    ps = TyPtrSize()
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    lstrcpy(VarPtr(sApi), "GetProcessHeap")
    LowEmitApiCallShadow(list, IR_DLL_KERNEL32, VarPtr(sApi))
    stk = LowCallStk(3)
    If stk > 0 Then
        IrEmit(list, OP_SUB_RSP, stk, 0)
    End If
    IrEmit(list, OP_STORE_RSP_RAX, 0, 0)
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_STORE_RSP_RAX, ps, 0)
    IrEmit(list, OP_LOAD_RSP_RAX, stk, 0)
    IrEmit(list, OP_STORE_RSP_RAX, ps + ps, 0)
    LowEmitLoadRegArgs(list, 3)
    lstrcpy(VarPtr(sApi), "HeapFree")
    IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sApi))
    LowEmitCallFinish(list, stk)
    IrEmit(list, OP_POP_RCX, 0, 0)
End Sub

' 名前の末尾が '$' なら 1
Function LowNameHasStrSuffix(name As *Byte) As Long
    Dim si As Long

    LowNameHasStrSuffix = 0
    si = 0
    While name[si] <> 0
        si = si + 1
    Wend
    If si > 0 Then
        If name[si - 1] = 36 Then LowNameHasStrSuffix = 1
    End If
End Function

' String 定数か String 変数なら 1
Function LowIsStringExprVar(ctx As *LowerCtx, idx As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim name(63) As Byte

    LowIsStringExprVar = 0
    AstCopyStr(ctx->ast, idx, VarPtr(name))
    If LowFindStrConst(ctx, VarPtr(name)) >= 0 Then
        LowIsStringExprVar = 1
        Exit Function
    End If
    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
        If vTy = TY_STRING Then LowIsStringExprVar = 1
    End If
End Function

' String 配列の添字、または '$' 付き関数の呼び出しなら 1
Function LowIsStringExprCall(ctx As *LowerCtx, idx As Long) As Long
    Dim vOff As Long
    Dim vTy As Long
    Dim vTypeIdx As Long
    Dim vByRef As Long
    Dim vGlob As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim name(63) As Byte

    LowIsStringExprCall = 0
    ast = ctx->ast
    nodes = ast->nodes
    AstCopyStr(ast, idx, VarPtr(name))
    If LowLookupVar(ctx, VarPtr(name), VarPtr(vOff), VarPtr(vTy), VarPtr(vTypeIdx), VarPtr(vByRef), VarPtr(vGlob)) <> 0 Then
        If vTy = TY_STRING_ARR Then
            If nodes[idx].num = 1 Then LowIsStringExprCall = 1
        End If
        Exit Function
    End If
    If LowFindFunc(ctx, VarPtr(name)) >= 0 Then
        LowIsStringExprCall = LowNameHasStrSuffix(VarPtr(name))
    End If
End Function

Function LowIsStringExpr(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim k As Long
    Dim bi As Long

    LowIsStringExpr = 0
    If idx < 0 Then Exit Function
    ast = ctx->ast
    nodes = ast->nodes
    k = nodes[idx].kind
    If k = AST_STRING Then
        LowIsStringExpr = 1
    ElseIf k = AST_BINOP Then
        If nodes[idx].num = BOP_ADD Or nodes[idx].num = BOP_CAT Then
            If LowIsStringExpr(ctx, nodes[idx].left) <> 0 Then
                LowIsStringExpr = 1
                Exit Function
            End If
            If LowIsStringExpr(ctx, nodes[idx].right) <> 0 Then LowIsStringExpr = 1
        End If
    ElseIf k = AST_BUILTIN Then
        bi = nodes[idx].num
        If bi = BI_LEFT Or bi = BI_MID Or bi = BI_RIGHT Or bi = BI_CHR Or bi = BI_STR Or bi = BI_MAKESTR Then
            LowIsStringExpr = 1
        End If
    ElseIf k = AST_VAR Then
        LowIsStringExpr = LowIsStringExprVar(ctx, idx)
    ElseIf k = AST_CALL Then
        LowIsStringExpr = LowIsStringExprCall(ctx, idx)
    End If
End Function

Function LowEnsureRtCat(ctx As *LowerCtx) As Long
    If g_rtCatLab < 0 Then
        g_rtCatLab = LowNewLab(ctx)
    End If
    LowEnsureRtCat = g_rtCatLab
End Function

