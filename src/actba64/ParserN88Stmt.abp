' ParserN88Stmt - #n88basic 文の振り分け（ParseStmtN88 から）

Function ParseStmtN88Line(p As *Parser) As Long
    Dim kw(KW_LEN - 1) As Byte
    ParseStmtN88Line = -2
    lstrcpy(VarPtr(kw), "line")
    If ParseIdentIs(p, VarPtr(kw)) = 0 Then Exit Function
    ParseStmtN88Line = ParseN88LineOrAssign(p)
End Function

Function ParseStmtN88Circle(p As *Parser) As Long
    Dim kw(KW_LEN - 1) As Byte
    ParseStmtN88Circle = -2
    lstrcpy(VarPtr(kw), "circle")
    If ParseIdentIs(p, VarPtr(kw)) = 0 Then Exit Function
    ParseStmtN88Circle = ParseN88CircleOrAssign(p)
End Function

Function ParseStmtN88Locate(p As *Parser) As Long
    Dim kw(KW_LEN - 1) As Byte
    ParseStmtN88Locate = -2
    lstrcpy(VarPtr(kw), "locate")
    If ParseIdentIs(p, VarPtr(kw)) = 0 Then Exit Function
    ParseStmtN88Locate = ParseN88LocateStmt(p)
End Function

Function ParseStmtN88Color(p As *Parser) As Long
    Dim kw(KW_LEN - 1) As Byte
    ParseStmtN88Color = -2
    lstrcpy(VarPtr(kw), "color")
    If ParseIdentIs(p, VarPtr(kw)) = 0 Then Exit Function
    ParseStmtN88Color = ParseN88ColorStmt(p)
End Function

Function ParseStmtN88Paint(p As *Parser) As Long
    Dim kw(KW_LEN - 1) As Byte
    ParseStmtN88Paint = -2
    lstrcpy(VarPtr(kw), "paint")
    If ParseIdentIs(p, VarPtr(kw)) = 0 Then Exit Function
    ParseStmtN88Paint = ParseN88PaintStmt(p)
End Function

Function ParseStmtN88PSet(p As *Parser) As Long
    Dim kw(KW_LEN - 1) As Byte
    ParseStmtN88PSet = -2
    lstrcpy(VarPtr(kw), "pset")
    If ParseIdentIs(p, VarPtr(kw)) = 0 Then Exit Function
    ParseStmtN88PSet = ParseN88PSetOrAssign(p)
End Function

Function ParseStmtN88Draw(p As *Parser) As Long
    Dim n As Long
    n = ParseStmtN88Line(p)
    If n <> -2 Then
        ParseStmtN88Draw = n
        Exit Function
    End If
    ParseStmtN88Draw = ParseStmtN88Circle(p)
End Function

Function ParseStmtN88Text(p As *Parser) As Long
    Dim n As Long
    n = ParseStmtN88Locate(p)
    If n <> -2 Then
        ParseStmtN88Text = n
        Exit Function
    End If
    ParseStmtN88Text = ParseStmtN88Color(p)
End Function

Function ParseStmtN88PaintPSet(p As *Parser) As Long
    Dim n As Long
    n = ParseStmtN88Paint(p)
    If n <> -2 Then
        ParseStmtN88PaintPSet = n
        Exit Function
    End If
    ParseStmtN88PaintPSet = ParseStmtN88PSet(p)
End Function

Function ParseStmtN88Rest(p As *Parser) As Long
    Dim n As Long
    n = ParseStmtN88Text(p)
    If n <> -2 Then
        ParseStmtN88Rest = n
        Exit Function
    End If
    ParseStmtN88Rest = ParseStmtN88PaintPSet(p)
End Function

Function ParseStmtN88Body(p As *Parser) As Long
    Dim n As Long
    n = ParseStmtN88Draw(p)
    If n <> -2 Then
        ParseStmtN88Body = n
        Exit Function
    End If
    ParseStmtN88Body = ParseStmtN88Rest(p)
End Function
