#console
Declare Function ExitProcess Lib "kernel32.dll" (uExitCode As Long) As Long
Declare Function calloc Lib "msvcrt.dll" (n As Long) As *Byte
Type Box
    count As Long
End Type
Function MakeBox(ByRef list As *Box) As Long
    Dim p As *Box
    MakeBox = 0
    p = calloc(SizeOf(Box)) As *Box
    If p = NULL Then Exit Function
    list = p
    list->count = 99
    MakeBox = 1
End Function
Function SetLong(ByRef x As Long) As Long
    x = 123
    SetLong = 1
End Function
Sub Main()
    Dim list As *Box
    Dim x As Long
    list = NULL
    x = 0
    If SetLong(x) = 0 Then ExitProcess(10)
    If x <> 123 Then ExitProcess(11)
    If MakeBox(list) = 0 Then ExitProcess(1)
    If list = NULL Then ExitProcess(2)
    If list->count <> 99 Then ExitProcess(3)
    ExitProcess(42)
End Sub
Main()
End
