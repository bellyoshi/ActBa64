Function ParseStmtKwB(p As *Parser) As Long
    Dim n As Long

    n = ParseStmtKwLoop(p)
    If n <> -2 Then
        ParseStmtKwB = n
        Exit Function
    End If
    ParseStmtKwB = ParseStmtKwProc(p)
End Function

Sub ParseStmtBadTok(p As *Parser)
    Dim tmp(63) As Byte
    Dim toks As *Tok
    Dim lx As *Lexer
    Dim kind As Long

    kind = ParseTokKind(p)
    lx = p->lx
    toks = lx->toks
    If kind = TK_IDENT Or kind = TK_STRING Or kind = TK_NUMBER Then
        LexCopyText(lx, toks[p->pos].textOff, VarPtr(tmp))
        ParseFail(p, "unexpected token near '" + MakeStr(VarPtr(tmp)) + "'")
    ElseIf kind = TK_EOF Then
        ParseFail(p, "unexpected end of file")
    Else
        ParseFail(p, "unexpected token")
    End If
End Sub

Function ParseStmt(p As *Parser) As Long
    Dim n As Long
    Dim startLine As Long

    ParseStmt = -1
    startLine = ParseTokLine(p)
    n = ParseStmtKwA(p)
    If n <> -2 Then
        If n >= 0 Then AstSetSrcLine(p->ast, n, startLine)
        ParseStmt = n
        Exit Function
    End If
    n = ParseStmtN88(p)
    If n <> -2 Then
        If n >= 0 Then AstSetSrcLine(p->ast, n, startLine)
        ParseStmt = n
        Exit Function
    End If
    n = ParseStmtKwB(p)
    If n <> -2 Then
        If n >= 0 Then AstSetSrcLine(p->ast, n, startLine)
        ParseStmt = n
        Exit Function
    End If
    If ParseTokKind(p) = TK_DOT Then
        If p->withBase < 0 Then
            ParseFail(p, "'.' member access outside With block")
            Exit Function
        End If
        n = ParseAssignStmt(p)
        If n >= 0 Then AstSetSrcLine(p->ast, n, startLine)
        ParseStmt = n
        Exit Function
    End If
    If ParseTokKind(p) = TK_IDENT Then
        n = ParseAssignStmt(p)
        If n >= 0 Then AstSetSrcLine(p->ast, n, startLine)
        ParseStmt = n
        Exit Function
    End If
    ParseStmtBadTok(p)
End Function

Sub ParseProgramTake(p As *Parser, ast As *Ast, ByRef nFirst As Long, ByRef nPrev As Long, ByRef hadErr As Long)
    Dim nStmt As Long
    Dim nodes As *AstNode

    nStmt = ParseStmt(p)
    If nStmt < 0 Or p->err <> 0 Then
        hadErr = 1
        ParseRecoverStmt(p)
        ' Continue at next line; do not link failed stmt
    Else
        If nFirst < 0 Then
            nFirst = nStmt
        Else
            nodes = ast->nodes
            nodes[nPrev].nxt = nStmt
        End If
        nPrev = nStmt
        nodes = ast->nodes
        While nodes[nPrev].nxt >= 0
            nPrev = nodes[nPrev].nxt
        Wend
    End If
End Sub

Function ParseProgram(p As *Parser) As Long
    Dim nProg As Long
    Dim nFirst As Long
    Dim nPrev As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim hadErr As Long

    ParseProgram = -1
    ast = p->ast
    p->classTi = -1
    p->withBase = -1
    nFirst = -1
    nPrev = -1
    hadErr = 0

    While ParseTokKind(p) <> TK_EOF
        ParseSkipColons(p)
        If ParseTokKind(p) = TK_EOF Then Exit While
        ParseProgramTake(p, ast, nFirst, nPrev, hadErr)
    Wend

    If hadErr <> 0 Or DiagCount() > 0 Then
        Exit Function
    End If

    If nFirst < 0 Then
        nFirst = AstAddNode(ast, AST_END)
        If nFirst < 0 Then Exit Function
    End If

    nProg = AstAddNode(ast, AST_PROGRAM)
    If nProg < 0 Then Exit Function
    nodes = ast->nodes
    nodes[nProg].left = nFirst
    ast->root = nProg
    ParseProgram = nProg
End Function

Function ParseSource(src As *Byte, ast As *Ast) As Long
    Dim lx As *Lexer
    Dim p As Parser
    Dim errLine As Long

    ParseSource = 0
    DiagReset(src)
    lx = LexCreate(LEX_MAX_TOKS)
    If lx = NULL Then
        DiagError(1, "out of memory (lexer)")
        DiagPrintAll()
        DiagPrintSummary()
        Exit Function
    End If
    If LexTokenize(lx, src) = 0 Then
        errLine = lx->srcLine
        If errLine <= 0 Then errLine = 1
        DiagError(errLine, "lex failed")
        DiagPrintAll()
        DiagPrintSummary()
        LexFree(lx)
        Exit Function
    End If

    p.lx = lx
    p.ast = ast
    p.pos = 0
    p.err = 0
    p.n88Mode = PpIsN88Basic()
    p.withBase = -1
    If ParseProgram(VarPtr(p)) < 0 Or p.err <> 0 Or DiagCount() > 0 Then
        DiagPrintAll()
        DiagPrintSummary()
        LexFree(lx)
        Exit Function
    End If

    LexFree(lx)
    ParseSource = 1
End Function
