End Function

Function ParseStmt(p As *Parser) As Long
    Dim n As Long

    ParseStmt = -1
    n = ParseStmtKwA(p)
    If n <> -2 Then
        ParseStmt = n
        Exit Function
    End If
    n = ParseStmtN88(p)
    If n <> -2 Then
        ParseStmt = n
        Exit Function
    End If
    n = ParseStmtKwB(p)
    If n <> -2 Then
        ParseStmt = n
        Exit Function
    End If
    If ParseTokKind(p) = TK_DOT Then
        If p->withBase < 0 Then
            p->err = 1
            Exit Function
        End If
        ParseStmt = ParseAssignStmt(p)
        Exit Function
    End If
    If ParseTokKind(p) = TK_IDENT Then
        ParseStmt = ParseAssignStmt(p)
        Exit Function
    End If
    p->err = 1
End Function

Function ParseProgram(p As *Parser) As Long
    Dim nProg As Long
    Dim nStmt As Long
    Dim nFirst As Long
    Dim nPrev As Long
    Dim ast As *Ast
    Dim nodes As *AstNode

    ParseProgram = -1
    ast = p->ast
    p->classTi = -1
    p->withBase = -1
    nFirst = -1
    nPrev = -1

    While ParseTokKind(p) <> TK_EOF
        ParseSkipColons(p)
        If ParseTokKind(p) = TK_EOF Then Exit While
        nStmt = ParseStmt(p)
        If nStmt < 0 Or p->err <> 0 Then Exit Function
        If nFirst < 0 Then
            nFirst = nStmt
        Else
            nodes = ast->nodes
            nodes[nPrev].nxt = nStmt
        End If
        nPrev = nStmt
        nodes = ast->nodes
        While nodes[nPrev].nxt >= 0
            nPrev = nodes[nPrev].nxt
        Wend
    Wend

    If nFirst < 0 Then
        nFirst = AstAddNode(ast, AST_END)
        If nFirst < 0 Then Exit Function
    End If

    nProg = AstAddNode(ast, AST_PROGRAM)
    If nProg < 0 Then Exit Function
    nodes = ast->nodes
    nodes[nProg].left = nFirst
    ast->root = nProg
    ParseProgram = nProg
End Function

Function ParseSource(src As *Byte, ast As *Ast) As Long
    Dim lx As *Lexer
    Dim p As Parser
    Dim toks As *Tok
    Dim errLine As Long
    Dim kind As Long
    Dim tmp(63) As Byte

    ParseSource = 0
    lx = LexCreate(LEX_MAX_TOKS)
    If lx = NULL Then
        Print "error: out of memory (lexer)"
        Exit Function
    End If
    If LexTokenize(lx, src) = 0 Then
        errLine = lx->srcLine
        If errLine <= 0 Then errLine = 1
        Print "error: lex failed at " + PpErrLoc$(src, errLine)
        LexFree(lx)
        Exit Function
    End If

    p.lx = lx
    p.ast = ast
    p.pos = 0
    p.err = 0
    p.n88Mode = PpIsN88Basic()
    p.withBase = -1
    If ParseProgram(VarPtr(p)) < 0 Or p.err <> 0 Then
        errLine = ParseTokLine(VarPtr(p))
        If errLine <= 0 Then errLine = 1
        kind = ParseTokKind(VarPtr(p))
        If kind = TK_EOF Then
            Print "error: parse failed at " + PpErrLoc$(src, errLine) + ": unexpected end of file"
        ElseIf kind = TK_IDENT Or kind = TK_STRING Or kind = TK_NUMBER Then
            toks = lx->toks
            LexCopyText(lx, toks[p.pos].textOff, VarPtr(tmp))
            Print "error: parse failed at " + PpErrLoc$(src, errLine) + " near '" + MakeStr(VarPtr(tmp)) + "'"
        Else
            Print "error: parse failed at " + PpErrLoc$(src, errLine)
        End If
        LexFree(lx)
        Exit Function
    End If

    LexFree(lx)
    ParseSource = 1
End Function
