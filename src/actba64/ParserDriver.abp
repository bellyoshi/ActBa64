' ===================================================
'  ParserDriver - ParseStmt / ParseSource
' ===================================================

Function ParseStmtN88(p As *Parser) As Long
    Dim kw(15) As Byte

    ParseStmtN88 = -2
    If p->n88Mode = 0 Then Exit Function
    lstrcpy(VarPtr(kw), "line")
    If ParseIdentIs(p, VarPtr(kw)) <> 0 Then
        ParseStmtN88 = ParseN88LineOrAssign(p)
        Exit Function
    End If
    lstrcpy(VarPtr(kw), "circle")
    If ParseIdentIs(p, VarPtr(kw)) <> 0 Then
        ParseStmtN88 = ParseN88CircleOrAssign(p)
        Exit Function
    End If
    lstrcpy(VarPtr(kw), "locate")
    If ParseIdentIs(p, VarPtr(kw)) <> 0 Then
        ParseStmtN88 = ParseN88LocateStmt(p)
        Exit Function
    End If
    lstrcpy(VarPtr(kw), "paint")
    If ParseIdentIs(p, VarPtr(kw)) <> 0 Then
        ParseStmtN88 = ParseN88PaintStmt(p)
    End If
End Function

