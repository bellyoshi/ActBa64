Function ParseStmtKwIoDecl(p As *Parser) As Long
    Dim n As Long

    n = ParseStmtKwIoSeq(p)
    If n <> -2 Then
        ParseStmtKwIoDecl = n
        Exit Function
    End If
    n = ParseStmtKwIoRandom(p)
    If n <> -2 Then
        ParseStmtKwIoDecl = n
        Exit Function
    End If
    n = ParseStmtKwExitEnd(p)
    If n <> -2 Then
        ParseStmtKwIoDecl = n
        Exit Function
    End If
    ParseStmtKwIoDecl = ParseStmtKwDimClass(p)
End Function

