Function ParseStmtKwA(p As *Parser) As Long
    Dim n As Long

    n = ParseStmtKwFileA(p)
    If n <> -2 Then
        ParseStmtKwA = n
        Exit Function
    End If
    n = ParseStmtKwFileB(p)
    If n <> -2 Then
        ParseStmtKwA = n
        Exit Function
    End If
    n = ParseStmtKwExitEnd(p)
    If n <> -2 Then
        ParseStmtKwA = n
        Exit Function
    End If
    ParseStmtKwA = ParseStmtKwDimClass(p)
End Function

