' ResEmbed - ファイルを PE .rsrc（RCDATA id=1）へ

Const RT_RCDATA = 10
Const RES_DATA_ENTRY_OFF = &H48
Const RES_PAYLOAD_OFF = &H58

Const RES_FIX_MAX = 32

Dim g_rsrcBuf As *Byte
Dim g_rsrcSize As Long
Dim g_resFixN As Long
Dim g_resFixOff(31) As Long

Sub ResFixClear()
    g_resFixN = 0
End Sub

Sub ResFixAdd(off As Long)
    If g_resFixN >= RES_FIX_MAX Then Exit Sub
    g_resFixOff(g_resFixN) = off
    g_resFixN = g_resFixN + 1
End Sub

Sub ResClear()
    If g_rsrcBuf <> NULL Then free(g_rsrcBuf)
    g_rsrcBuf = NULL
    g_rsrcSize = 0
    ResFixClear()
End Sub

Function ResBuf() As *Byte
    ResBuf = g_rsrcBuf
End Function

Function ResSize() As Long
    ResSize = g_rsrcSize
End Function

Function ResAlign4(n As Long) As Long
    ResAlign4 = (n + 3) And (0 - 4)
End Function

Sub ResPutDir(buf As *Byte, off As Long, nId As Long)
    PutDword(buf, off + 0, 0)
    PutDword(buf, off + 4, 0)
    PutWord(buf, off + 8, 0)
    PutWord(buf, off + 10, 0)
    PutWord(buf, off + 12, 0)
    PutWord(buf, off + 14, nId As Word)
End Sub

Sub ResPutIdEntry(buf As *Byte, off As Long, id As Long, childOff As Long, isDir As Long)
    Dim o As DWord
    PutDword(buf, off + 0, id)
    o = childOff
    If isDir <> 0 Then o = o Or &H80000000
    PutDword(buf, off + 4, o)
End Sub

Sub ResPutTree(buf As *Byte, dataSize As Long)
    ResPutDir(buf, 0, 1)
    ResPutIdEntry(buf, &H10, RT_RCDATA, &H18, 1)
    ResPutDir(buf, &H18, 1)
    ResPutIdEntry(buf, &H28, 1, &H30, 1)
    ResPutDir(buf, &H30, 1)
    ResPutIdEntry(buf, &H40, 0, RES_DATA_ENTRY_OFF, 0)
    PutDword(buf, RES_DATA_ENTRY_OFF + 0, RES_PAYLOAD_OFF)
    PutDword(buf, RES_DATA_ENTRY_OFF + 4, dataSize)
    ResFixClear()
    ResFixAdd(RES_DATA_ENTRY_OFF)
End Sub

Function ResBuildRcdata(data As *Byte, dataSize As Long) As *Byte
    Dim buf As *Byte
    Dim total As Long
    Dim i As Long

    ResBuildRcdata = NULL
    total = RES_PAYLOAD_OFF + ResAlign4(dataSize)
    buf = calloc(total)
    If buf = NULL Then Exit Function
    ResPutTree(buf, dataSize)
    i = 0
    While i < dataSize
        buf[RES_PAYLOAD_OFF + i] = data[i]
        i = i + 1
    Wend
    g_rsrcSize = total
    ResBuildRcdata = buf
End Function

Function ResDwAt(p As *Byte, off As Long) As DWord
    Dim q As *Byte
    Dim v As DWord
    v = 0
    PtrAddTo(p, off, q)
    memcpy(VarPtr(v), q, 4)
    ResDwAt = v
End Function

Sub ResFixOne(rsrcRva As DWord, i As Long)
    Dim off As Long
    Dim cur As DWord
    off = g_resFixOff(i)
    cur = ResDwAt(g_rsrcBuf, off)
    PutDword(g_rsrcBuf, off, rsrcRva + cur)
End Sub

Sub ResFixupRvas(rsrcRva As DWord)
    Dim i As Long
    If g_rsrcBuf = NULL Then Exit Sub
    i = 0
    While i < g_resFixN
        ResFixOne(rsrcRva, i)
        i = i + 1
    Wend
End Sub

' 戻り値 true : 正常終了  false : エラーあり
Function ResPathIsRc(path As *Byte) As boolean
    Dim i As Long
    Dim n As Long

    ResPathIsRc = false
    n = 0
    While path[n] <> CH_NUL
        n = n + 1
    Wend
    If n < 3 Then Exit Function
    i = n - 3
    If ToLowerChar(path[i]) <> CH_DOT Then Exit Function
    If ToLowerChar(path[i + 1]) <> CH_Lr Then Exit Function
    If ToLowerChar(path[i + 2]) <> CH_Lc Then Exit Function
    ResPathIsRc = true
End Function

Function ResLoadFileAsRcdata(path As *Byte) As Long
    Dim data As *Byte
    Dim sz As Long

    ResLoadFileAsRcdata = 0
    data = LoadFile(path, sz)
    If data = NULL Then
        Print "error: #resource cannot open: " + MakeStr(path)
        Exit Function
    End If
    If sz <= 0 Then
        Print "error: #resource empty: " + MakeStr(path)
        free(data)
        Exit Function
    End If
    g_rsrcBuf = ResBuildRcdata(data, sz)
    free(data)
    If g_rsrcBuf = NULL Then
        Print "error: #resource out of memory"
        Exit Function
    End If
    ResLoadFileAsRcdata = 1
End Function

Function ResPrepareFromPp() As Long
    Dim path As *Byte

    ResPrepareFromPp = 1
    ResClear()
    If PpResHas() = 0 Then Exit Function
    path = PpResPathGet()
    If ResPathIsRc(path) Then ResPrepareFromPp = ResCompileRc(path)
    If Not ResPathIsRc(path) Then ResPrepareFromPp = ResLoadFileAsRcdata(path)
End Function
