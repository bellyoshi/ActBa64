' ParserClassMeth - メソッドと Inherits

' 戻り値 true : 正常終了  false : エラーあり
Function ParseClassMethRet(p As *Parser, isFun As Long, ByRef retTy As Long) As boolean
    Dim kAs(KW_SHORT_LEN - 1) As Byte

    ParseClassMethRet = false
    retTy = TY_LONG
    If isFun <> 0 Then
        lstrcpy(VarPtr(kAs), "as")
        If ParseIdentIs(p, VarPtr(kAs)) <> 0 Then
            p->pos = p->pos + 1
            If ParseFuncRetType(p, retTy) = 0 Then Exit Function
        End If
    End If
    ParseClassMethRet = true
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function ParseClassMethBody(p As *Parser, isFun As Long, name As *Byte, mangled As *Byte, ByRef body As Long) As boolean
    Dim kSub(KW_SHORT_LEN - 1) As Byte
    Dim kFun(KW_LEN - 1) As Byte
    Dim saveTi As Long

    ParseClassMethBody = false
    lstrcpy(VarPtr(kSub), "sub")
    lstrcpy(VarPtr(kFun), "function")
    saveTi = p->classTypeIdx
    g_clsMethShort[0] = 0
    g_clsMethMangled[0] = 0
    If isFun <> 0 Then
        lstrcpy(VarPtr(g_clsMethShort), name)
        lstrcpy(VarPtr(g_clsMethMangled), mangled)
        body = ParseStmtListUntilEndPair(p, VarPtr(kFun))
    Else
        body = ParseStmtListUntilEndPair(p, VarPtr(kSub))
    End If
    g_clsMethShort[0] = 0
    g_clsMethMangled[0] = 0
    p->classTypeIdx = saveTi
    If p->err <> 0 Then Exit Function
    ParseClassMethBody = true
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function ParseClassMethEnd(p As *Parser, isFun As Long) As boolean
    Dim kEnd(KW_SHORT_LEN - 1) As Byte
    Dim kSub(KW_SHORT_LEN - 1) As Byte
    Dim kFun(KW_LEN - 1) As Byte

    ParseClassMethEnd = false
    lstrcpy(VarPtr(kEnd), "end")
    lstrcpy(VarPtr(kSub), "sub")
    lstrcpy(VarPtr(kFun), "function")
    If ParseIdentIs(p, VarPtr(kEnd)) = 0 Then
        p->err = 1
        Exit Function
    End If
    p->pos = p->pos + 1
    If isFun <> 0 Then
        If ParseIdentIs(p, VarPtr(kFun)) = 0 Then
            p->err = 1
            Exit Function
        End If
    Else
        If ParseIdentIs(p, VarPtr(kSub)) = 0 Then
            p->err = 1
            Exit Function
        End If
    End If
    p->pos = p->pos + 1
    ParseClassMethEnd = true
End Function

Function ParseClassMethNode(ast As *Ast, mangled As *Byte, nFirst As Long, body As Long, isFun As Long, nParams As Long, retTy As Long) As Long
    Dim nodes As *AstNode
    Dim nFunc As Long

    ParseClassMethNode = -1
    nFunc = AstAddNode(ast, AST_FUNC)
    If nFunc < 0 Then Exit Function
    AstSetStr(ast, nFunc, mangled)
    nodes = ast->nodes
    nodes[nFunc].left = nFirst
    nodes[nFunc].right = body
    If isFun <> 0 Then
        nodes[nFunc].num = nParams
        nodes[nFunc].extra = retTy
    Else
        nodes[nFunc].num = nParams Or 256
    End If
    ParseClassMethNode = nFunc
End Function

' Class 内の Sub/Function（本体あり）
Function ParseClassMethFinish(p As *Parser, isFun As Long, name As *Byte, mangled As *Byte, nFirst As Long, nParams As Long) As Long
    Dim ast As *Ast
    Dim body As Long
    Dim retTy As Long

    ParseClassMethFinish = -1
    ast = p->ast
    If Not ParseClassMethRet(p, isFun, retTy) Then Exit Function
    nFirst = ParsePrependMeParam(p, nFirst, nParams)
    If nFirst < 0 Then Exit Function
    If Not ParseClassMethBody(p, isFun, name, mangled, body) Then Exit Function
    If Not ParseClassMethEnd(p, isFun) Then Exit Function
    ParseClassMethFinish = ParseClassMethNode(ast, mangled, nFirst, body, isFun, nParams, retTy)
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function ParseClassMethSig(p As *Parser, className As *Byte, name As *Byte, ByRef isFun As Long, ByRef isDtor As Long, ByRef outIsCtor As Long, ByRef outIsDtor As Long) As boolean
    Dim kSub(KW_SHORT_LEN - 1) As Byte
    Dim kFun(KW_LEN - 1) As Byte

    ParseClassMethSig = false
    isFun = 0
    isDtor = 0
    outIsCtor = 0
    outIsDtor = 0
    lstrcpy(VarPtr(kSub), "sub")
    lstrcpy(VarPtr(kFun), "function")
    If ParseIdentIs(p, VarPtr(kFun)) <> 0 Then
        isFun = 1
        p->pos = p->pos + 1
    ElseIf ParseIdentIs(p, VarPtr(kSub)) <> 0 Then
        p->pos = p->pos + 1
    Else
        p->err = 1
        Exit Function
    End If
    If ParseTokKind(p) = TK_TILDE Then
        If isFun <> 0 Then
            p->err = 1
            Exit Function
        End If
        p->pos = p->pos + 1
        isDtor = 1
        outIsDtor = 1
    End If
    If Not ParseCopyIdent(p, name) Then Exit Function
    If isDtor = 0 Then
        If TyNameEq(name, className) <> 0 Then
            outIsCtor = 1
        End If
    End If
    ParseClassMethSig = true
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function ParseClassMethMangle(p As *Parser, className As *Byte, name As *Byte, mangled As *Byte, isDtor As Long, outIsCtor As Long) As boolean
    ParseClassMethMangle = false
    If isDtor <> 0 Then
        If TyNameEq(name, className) = 0 Then
            p->err = 1
            Exit Function
        End If
        lstrcpy(mangled, className)
        lstrcat(mangled, "_Dtor")
    ElseIf outIsCtor <> 0 Then
        lstrcpy(mangled, className)
        lstrcat(mangled, "_Ctor")
    Else
        ParseMangleClassMember(className, name, mangled)
    End If
    ParseClassMethMangle = true
End Function

Function ParseClassMethod(p As *Parser, className As *Byte, ByRef outIsCtor As Long, ByRef outIsDtor As Long) As Long
    Dim isFun As Long
    Dim isDtor As Long
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim mangled(MANGLED_LEN - 1) As Byte
    Dim nFirst As Long
    Dim nParams As Long

    ParseClassMethod = -1
    If Not ParseClassMethSig(p, className, VarPtr(name), isFun, isDtor, outIsCtor, outIsDtor) Then Exit Function
    If Not ParseClassMethMangle(p, className, VarPtr(name), VarPtr(mangled), isDtor, outIsCtor) Then Exit Function
    If Not ParseExpect(p, TK_LPAREN) Then Exit Function
    If ParseTokKind(p) <> TK_RPAREN Then
        If isDtor <> 0 Then
            p->err = 1
            Exit Function
        End If
    End If
    If Not ParseParamList(p, nFirst, nParams, 0, 0) Then Exit Function
    ParseClassMethod = ParseClassMethFinish(p, isFun, VarPtr(name), VarPtr(mangled), nFirst, nParams)
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function ParseClassInherits(p As *Parser, ti As Long, ByRef isIface As Long) As boolean
    Dim kInh(KW_LEN - 1) As Byte
    Dim parent(SYM_NAME_LEN - 1) As Byte
    Dim parentTi As Long
    Dim types As *TypeTable
    Dim ast As *Ast

    ParseClassInherits = false
    ast = p->ast
    types = ast->types
    isIface = 0
    lstrcpy(VarPtr(kInh), "inherits")
    If ParseIdentIs(p, VarPtr(kInh)) = 0 Then
        ParseClassInherits = true
        Exit Function
    End If
    p->pos = p->pos + 1
    If Not ParseCopyIdent(p, VarPtr(parent)) Then Exit Function
    parentTi = TyFind(types, VarPtr(parent))
    If parentTi < 0 Then
        Print "error: Inherits parent not found: " + MakeStr(VarPtr(parent))
        p->err = 1
        Exit Function
    End If
    If TyIsClass(types, parentTi) = 0 Then
        Print "error: Inherits parent is not a Class"
        p->err = 1
        Exit Function
    End If
    If Not TyCopyVirts(types, ti, parentTi) Then
        Print "error: Inherits Virtual copy failed"
        p->err = 1
        Exit Function
    End If
    isIface = 1
    ParseClassInherits = true
End Function
