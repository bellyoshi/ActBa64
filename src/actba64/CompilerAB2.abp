' ===================================================
'  CompilerAB2 - -pAB2: ActiveBasic 2.62 のソースを読む
' ===================================================
' ソースは通常の Lexer / Parser で読む。AB2 にしか無い書き方は
' CompIsAB2() を見て受け付ける（ParserAB2 など）。

Dim g_compAB2 As Long

Sub CompSetAB2(on As Long)
    g_compAB2 = on
End Sub

Function CompIsAB2() As Long
    CompIsAB2 = g_compAB2
End Function

' == 行番号付きの N88 のソース ==
' -pAB2 でも、最初の文の行が行番号で始まるソースは N88-BASIC として読む（-pN88 と同じ）。
' ActiveBasic 2.62 の #N88BASIC のプログラム（行番号付き・宣言なし）のため。

' CompileInput から。N88 として読むなら -pAB2 を外して -pN88 にする
Sub CompAB2PickN88(srcPath As *Byte)
    Dim src As *Byte
    Dim srcSize As Long
    If CompIsAB2() = 0 Then Exit Sub
    src = LoadText(srcPath, srcSize)
    If src = NULL Then Exit Sub
    If CompAB2LooksN88(src) Then CompSetAB2(0)
    If CompIsAB2() = 0 Then CompSetN88(1)
    free(src)
End Sub

' 空行と ' の行を飛ばし、最初の行の先頭が数字なら true
Function CompAB2LooksN88(src As *Byte) As boolean
    Dim i As Long
    i = 0
    Do
        i = CompAB2SkipBlank(src, i)
        If src[i] <> CH_SQUOTE Then Exit Do
        i = CompAB2SkipLine(src, i)
    Loop
    CompAB2LooksN88 = IsDigit(src[i])
End Function

' 空白・改行・BOM（&H80 以上）を飛ばした位置
Function CompAB2SkipBlank(src As *Byte, i As Long) As Long
    While src[i] <> CH_NUL And (IsSpace(src[i]) Or src[i] >= &H80)
        i = i + 1
    Wend
    CompAB2SkipBlank = i
End Function

Function CompAB2SkipLine(src As *Byte, i As Long) As Long
    While src[i] <> CH_NUL And src[i] <> CH_NL
        i = i + 1
    Wend
    CompAB2SkipLine = i
End Function
