' ===================================================
'  CompilerAB2 - -pAB2: ActiveBasic 2.62 のソースを読む
' ===================================================
' ソースは通常の Lexer / Parser で読む。AB2 にしか無い書き方は
' CompIsAB2() を見て受け付ける（ParserAB2 など）。

Dim g_compAB2 As Long

Sub CompSetAB2(on As Long)
    g_compAB2 = on
End Sub

Function CompIsAB2() As Long
    CompIsAB2 = g_compAB2
End Function
