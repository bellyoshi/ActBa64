' ===================================================
'  Lexer - source text -> token list
' ===================================================

Const TK_EOF = 0
Const TK_IDENT = 1
Const TK_STRING = 2
Const TK_LPAREN = 3
Const TK_RPAREN = 4
Const TK_SEMI = 5
Const TK_NUMBER = 6
Const TK_EQ = 7
Const TK_PLUS = 8
Const TK_STAR = 9
Const TK_LT = 10
Const TK_LE = 11
Const TK_GT = 12
Const TK_GE = 13
Const TK_NE = 14
Const TK_COMMA = 15
Const TK_LBRACK = 16
Const TK_RBRACK = 17
Const TK_DOT = 18
Const TK_MINUS = 19
Const TK_ARROW = 20
Const TK_AMP = 21
Const TK_BACKSLASH = 22
Const TK_FLOAT = 23
Const TK_SLASH = 24
Const TK_SHL = 25
Const TK_SHR = 26
Const TK_CARET = 27
Const TK_TILDE = 28
Const TK_COLON = 29
Const TK_HASH = 30
Const TK_ERROR = 99

Const LEX_MAX_TOKS = 131072
Const LEX_TEXT_LEN = 256
' Dim buf(…) 用（LEX_TEXT_LEN - 1）
Const LEX_TEXT_MAXIDX = 255
' 小数リテラルの千分率（3 桁 → *1000）
Const LEX_FLOAT_FRAC_DIGITS = 3
Const LEX_FLOAT_SCALE = 1000
Const LEX_RADIX_DEC = 10
Const LEX_RADIX_HEX = 16

Type Tok
    kind As Long
    textOff As Long
    num As Long
    srcLine As Long
End Type

Type Lexer
    src As *Byte
    pos As Long
    toks As *Tok
    texts As *Byte
    count As Long
    capacity As Long
    err As Long
    srcLine As Long
End Type

' 行末の _ （および直後の空白・'注釈）→ 次行へ継続。識別子 _foo とは区別
Function LexLineContHere(lx As *Lexer) As Long
    Dim src As *Byte
    Dim p As Long
    Dim c As Long

    LexLineContHere = 0
    src = lx->src
    p = lx->pos + 1
    c = src[p]
    If IsIdentCont(c) <> 0 Then Exit Function
    If c = CH_DOLLAR Then Exit Function
    While IsHSpace(src[p]) <> 0
        p = p + 1
    Wend
    If src[p] = CH_SQUOTE Then
        While src[p] <> CH_NUL And IsEol(src[p]) = 0
            p = p + 1
        Wend
    End If
    If src[p] <> CH_NUL And IsEol(src[p]) = 0 Then Exit Function
    lx->pos = p
    If src[lx->pos] = CH_CR Then
        lx->srcLine = lx->srcLine + 1
        lx->pos = lx->pos + 1
        If src[lx->pos] = CH_NL Then
            lx->pos = lx->pos + 1
        End If
    ElseIf src[lx->pos] = CH_NL Then
        lx->srcLine = lx->srcLine + 1
        lx->pos = lx->pos + 1
    End If
    LexLineContHere = 1
End Function

' 行頭（空白のみのあと）の # はディレクティブ。文中の # は TK_HASH（Input #1 / As #1）
Function LexHashIsDirective(lx As *Lexer) As Long
    Dim src As *Byte
    Dim p As Long
    Dim c As Long

    LexHashIsDirective = 1
    src = lx->src
    p = lx->pos - 1
    While p >= 0
        c = src[p]
        If c = CH_SP Or c = CH_TAB Then
            p = p - 1
        ElseIf c = CH_NL Or c = CH_CR Then
            Exit Function
        Else
            LexHashIsDirective = 0
            Exit Function
        End If
    Wend
End Function

Function LexCreate(capacity As Long) As *Lexer
    Dim lx As *Lexer
    LexCreate = NULL
    lx = calloc(SizeOf(Lexer))
    If lx = NULL Then Exit Function
    lx->toks = calloc(BytesN(capacity, SizeOf(Tok)))
    lx->texts = calloc(BytesN(capacity, LEX_TEXT_LEN))
    If lx->toks = NULL Or lx->texts = NULL Then
        If lx->toks <> NULL Then free(lx->toks)
        If lx->texts <> NULL Then free(lx->texts)
        free(lx)
        Exit Function
    End If
    lx->capacity = capacity
    lx->count = 0
    lx->pos = 0
    lx->err = 0
    LexCreate = lx
End Function

Sub LexFree(lx As *Lexer)
    If lx = NULL Then Exit Sub
    If lx->toks <> NULL Then free(lx->toks)
    If lx->texts <> NULL Then free(lx->texts)
    free(lx)
End Sub

Sub LexStoreText(lx As *Lexer, idx As Long, s As *Byte, n As Long)
    Dim texts As *Byte
    Dim off As Long
    Dim i As Long
    texts = lx->texts
    off = idx * LEX_TEXT_LEN
    i = 0
    While i < n And i < LEX_TEXT_MAXIDX
        texts[off + i] = s[i]
        i = i + 1
    Wend
    texts[off + i] = CH_NUL
End Sub

Sub LexCopyText(lx As *Lexer, idx As Long, dst As *Byte)
    Dim texts As *Byte
    Dim off As Long
    Dim i As Long
    texts = lx->texts
    off = idx * LEX_TEXT_LEN
    i = 0
    Do
        dst[i] = texts[off + i]
        If texts[off + i] = CH_NUL Then Exit Sub
        i = i + 1
        If i >= LEX_TEXT_LEN Then
            dst[LEX_TEXT_MAXIDX] = CH_NUL
            Exit Sub
        End If
    Loop
End Sub

Function LexPush(lx As *Lexer, kind As Long) As Long
    Dim toks As *Tok
    Dim i As Long
    Dim newCap As Long
    Dim p As *Byte
    LexPush = -1
    If lx->count >= lx->capacity Then
        newCap = lx->capacity * 2
        If newCap <= lx->capacity Then
            lx->err = 1
            Exit Function
        End If
        p = MemGrow(lx->toks, BytesN(lx->capacity, SizeOf(Tok)), BytesN(newCap, SizeOf(Tok)))
        If p = NULL Then
            lx->err = 1
            Exit Function
        End If
        lx->toks = p
        p = MemGrow(lx->texts, BytesN(lx->capacity, LEX_TEXT_LEN), BytesN(newCap, LEX_TEXT_LEN))
        If p = NULL Then
            lx->err = 1
            Exit Function
        End If
        lx->texts = p
        lx->capacity = newCap
    End If
    toks = lx->toks
    i = lx->count
    toks[i].kind = kind
    toks[i].textOff = i
    toks[i].num = 0
    toks[i].srcLine = lx->srcLine
    LexPush = i
    lx->count = i + 1
End Function

Sub LexSkipEol(lx As *Lexer)
    Dim src As *Byte
    src = lx->src
    While src[lx->pos] <> CH_NUL And IsEol(src[lx->pos]) = 0
        lx->pos = lx->pos + 1
    Wend
End Sub

Function LexSkipComment(lx As *Lexer) As Long
    Dim src As *Byte
    LexSkipComment = 0
    src = lx->src
    If src[lx->pos + 1] <> CH_STAR Then
        LexPush(lx, TK_SLASH)
        lx->pos = lx->pos + 1
        LexSkipComment = 1
        Exit Function
    End If
    lx->pos = lx->pos + 2
    Do
        If src[lx->pos] = CH_NUL Then
            lx->err = 1
            Exit Function
        End If
        If src[lx->pos] = CH_CR Then
            lx->srcLine = lx->srcLine + 1
            lx->pos = lx->pos + 1
            If src[lx->pos] = CH_NL Then
                lx->pos = lx->pos + 1
            End If
        ElseIf src[lx->pos] = CH_NL Then
            lx->srcLine = lx->srcLine + 1
            lx->pos = lx->pos + 1
        ElseIf src[lx->pos] = CH_STAR Then
            If src[lx->pos + 1] = CH_SLASH Then
                lx->pos = lx->pos + 2
                Exit Do
            End If
            lx->pos = lx->pos + 1
        Else
            lx->pos = lx->pos + 1
        End If
    Loop
    LexSkipComment = 1
End Function

Function LexHexLit(lx As *Lexer) As Long
    Dim src As *Byte
    Dim n2 As Long
    Dim c As Long
    Dim n As Long
    Dim v As Long
    Dim idx As Long
    Dim toks As *Tok
    LexHexLit = 0
    src = lx->src
    n2 = src[lx->pos + 1]
    If IsHexPrefix(n2) <> 0 Then
        lx->pos = lx->pos + 2
        n = 0
        Do
            c = src[lx->pos]
            v = HexDigitValue(c)
            If v < 0 Then Exit Do
            n = n * LEX_RADIX_HEX + v
            lx->pos = lx->pos + 1
        Loop
        idx = LexPush(lx, TK_NUMBER)
        If idx < 0 Then Exit Function
        toks = lx->toks
        toks[idx].num = n
    Else
        LexPush(lx, TK_AMP)
        lx->pos = lx->pos + 1
    End If
    LexHexLit = 1
End Function

Function LexNumber(lx As *Lexer) As Long
    Dim src As *Byte
    Dim n As Long
    Dim n2 As Long
    Dim i As Long
    Dim idx As Long
    Dim toks As *Tok
    LexNumber = 0
    src = lx->src
    n = 0
    While IsDigit(src[lx->pos]) <> 0
        n = n * LEX_RADIX_DEC + DigitValue(src[lx->pos])
        lx->pos = lx->pos + 1
    Wend
    ' 1.5 / 6.28 → TK_FLOAT（千分率: 1500 / 6280）
    If src[lx->pos] = CH_DOT Then
        If IsDigit(src[lx->pos + 1]) <> 0 Then
            lx->pos = lx->pos + 1
            n2 = 0
            i = 0
            While IsDigit(src[lx->pos]) <> 0
                If i < LEX_FLOAT_FRAC_DIGITS Then
                    n2 = n2 * LEX_RADIX_DEC + DigitValue(src[lx->pos])
                    i = i + 1
                End If
                lx->pos = lx->pos + 1
            Wend
            While i < LEX_FLOAT_FRAC_DIGITS
                n2 = n2 * LEX_RADIX_DEC
                i = i + 1
            Wend
            idx = LexPush(lx, TK_FLOAT)
            If idx < 0 Then Exit Function
            toks = lx->toks
            toks[idx].num = n * LEX_FLOAT_SCALE + n2
        Else
            idx = LexPush(lx, TK_NUMBER)
            If idx < 0 Then Exit Function
            toks = lx->toks
            toks[idx].num = n
        End If
    Else
        idx = LexPush(lx, TK_NUMBER)
        If idx < 0 Then Exit Function
        toks = lx->toks
        toks[idx].num = n
    End If
    LexNumber = 1
End Function

Function LexIdent(lx As *Lexer) As Long
    Dim src As *Byte
    Dim start As Long
    Dim n As Long
    Dim i As Long
    Dim idx As Long
    Dim buf(LEX_TEXT_MAXIDX) As Byte
    LexIdent = 0
    src = lx->src
    start = lx->pos
    While IsIdentCont(src[lx->pos]) <> 0
        lx->pos = lx->pos + 1
    Wend
    If src[lx->pos] = CH_DOLLAR Then
        lx->pos = lx->pos + 1
    End If
    n = lx->pos - start
    i = 0
    While i < n And i < LEX_TEXT_MAXIDX
        buf[i] = src[start + i]
        i = i + 1
    Wend
    buf[i] = CH_NUL
    idx = LexPush(lx, TK_IDENT)
    If idx < 0 Then Exit Function
    LexStoreText(lx, idx, VarPtr(buf), i)
    LexIdent = 1
End Function

Function LexString(lx As *Lexer) As Long
    Dim src As *Byte
    Dim i As Long
    Dim idx As Long
    Dim buf(LEX_TEXT_MAXIDX) As Byte
    LexString = 0
    src = lx->src
    lx->pos = lx->pos + 1
    i = 0
    Do
        If src[lx->pos] = CH_NUL Then
            lx->err = 1
            Exit Function
        End If
        If src[lx->pos] = CH_DQUOTE Then
            If src[lx->pos + 1] = CH_DQUOTE Then
                If i < LEX_TEXT_MAXIDX Then
                    buf[i] = CH_DQUOTE
                    i = i + 1
                End If
                lx->pos = lx->pos + 2
            Else
                Exit Do
            End If
        Else
            If i < LEX_TEXT_MAXIDX Then
                buf[i] = src[lx->pos]
                i = i + 1
            End If
            lx->pos = lx->pos + 1
        End If
    Loop
    buf[i] = CH_NUL
    lx->pos = lx->pos + 1
    idx = LexPush(lx, TK_STRING)
    If idx < 0 Then Exit Function
    LexStoreText(lx, idx, VarPtr(buf), i)
    LexString = 1
End Function

Sub LexTwoCharOp(lx As *Lexer, c As Long)
    Dim src As *Byte
    Dim n2 As Long
    src = lx->src
    n2 = src[lx->pos + 1]
    If c = CH_MINUS Then
        If n2 = CH_GREATER Then
            LexPush(lx, TK_ARROW)
            lx->pos = lx->pos + 2
        Else
            LexPush(lx, TK_MINUS)
            lx->pos = lx->pos + 1
        End If
    ElseIf c = CH_LESS Then
        If n2 = CH_EQ Then
            LexPush(lx, TK_LE)
            lx->pos = lx->pos + 2
        ElseIf n2 = CH_GREATER Then
            LexPush(lx, TK_NE)
            lx->pos = lx->pos + 2
        ElseIf n2 = CH_LESS Then
            LexPush(lx, TK_SHL)
            lx->pos = lx->pos + 2
        Else
            LexPush(lx, TK_LT)
            lx->pos = lx->pos + 1
        End If
    ElseIf c = CH_GREATER Then
        If n2 = CH_EQ Then
            LexPush(lx, TK_GE)
            lx->pos = lx->pos + 2
        ElseIf n2 = CH_LESS Then
            ' >< は <> と同じ（等しくない）
            LexPush(lx, TK_NE)
            lx->pos = lx->pos + 2
        ElseIf n2 = CH_GREATER Then
            LexPush(lx, TK_SHR)
            lx->pos = lx->pos + 2
        Else
            LexPush(lx, TK_GT)
            lx->pos = lx->pos + 1
        End If
    End If
End Sub

Sub LexSimpleOp(lx As *Lexer, kind As Long)
    LexPush(lx, kind)
    lx->pos = lx->pos + 1
End Sub

Function LexTokenize(lx As *Lexer, src As *Byte) As Long
    Dim c As Long

    LexTokenize = 0
    lx->src = src
    lx->pos = 0
    lx->count = 0
    lx->err = 0
    lx->srcLine = 1

    While src[lx->pos] <> CH_NUL
        c = src[lx->pos]
        If c = CH_CR Then
            lx->srcLine = lx->srcLine + 1
            lx->pos = lx->pos + 1
            If src[lx->pos] = CH_NL Then
                lx->pos = lx->pos + 1
            End If
        ElseIf c = CH_NL Then
            lx->srcLine = lx->srcLine + 1
            lx->pos = lx->pos + 1
        ElseIf IsHSpace(c) <> 0 Then
            lx->pos = lx->pos + 1
        ElseIf c = CH_SQUOTE Then
            LexSkipEol(lx)
        ElseIf c = CH_SLASH Then
            If LexSkipComment(lx) = 0 Then Exit Function
        ElseIf c = CH_HASH Then
            If LexHashIsDirective(lx) <> 0 Then
                LexSkipEol(lx)
            Else
                LexSimpleOp(lx, TK_HASH)
            End If
        ElseIf c = CH_AMP Then
            If LexHexLit(lx) = 0 Then Exit Function
        ElseIf c = CH_BSLASH Then
            LexSimpleOp(lx, TK_BACKSLASH)
        ElseIf IsDigit(c) <> 0 Then
            If LexNumber(lx) = 0 Then Exit Function
        ElseIf c = CH_UNDER Then
            If LexLineContHere(lx) <> 0 Then
                ' skip
            Else
                If LexIdent(lx) = 0 Then Exit Function
            End If
        ElseIf IsIdentChar(c) <> 0 Then
            If LexIdent(lx) = 0 Then Exit Function
        ElseIf c = CH_DQUOTE Then
            If LexString(lx) = 0 Then Exit Function
        ElseIf c = CH_LPAREN Then
            LexSimpleOp(lx, TK_LPAREN)
        ElseIf c = CH_RPAREN Then
            LexSimpleOp(lx, TK_RPAREN)
        ElseIf c = CH_SEMI Then
            LexSimpleOp(lx, TK_SEMI)
        ElseIf c = CH_COLON Then
            LexSimpleOp(lx, TK_COLON)
        ElseIf c = CH_COMMA Then
            LexSimpleOp(lx, TK_COMMA)
        ElseIf c = CH_LBRACK Then
            LexSimpleOp(lx, TK_LBRACK)
        ElseIf c = CH_RBRACK Then
            LexSimpleOp(lx, TK_RBRACK)
        ElseIf c = CH_DOT Then
            LexSimpleOp(lx, TK_DOT)
        ElseIf c = CH_PLUS Then
            LexSimpleOp(lx, TK_PLUS)
        ElseIf c = CH_MINUS Or c = CH_LESS Or c = CH_GREATER Then
            LexTwoCharOp(lx, c)
        ElseIf c = CH_STAR Then
            LexSimpleOp(lx, TK_STAR)
        ElseIf c = CH_CARET Then
            LexSimpleOp(lx, TK_CARET)
        ElseIf c = CH_TILDE Then
            LexSimpleOp(lx, TK_TILDE)
        ElseIf c = CH_EQ Then
            LexSimpleOp(lx, TK_EQ)
        Else
            lx->err = 1
            Exit Function
        End If
    Wend

    LexPush(lx, TK_EOF)
    If lx->err <> 0 Then Exit Function
    LexTokenize = 1
End Function
