' ===================================================
'  Lexer - source text -> token list
' ===================================================

Const TK_EOF = 0
Const TK_IDENT = 1
Const TK_STRING = 2
Const TK_LPAREN = 3
Const TK_RPAREN = 4
Const TK_SEMI = 5
Const TK_NUMBER = 6
Const TK_EQ = 7
Const TK_PLUS = 8
Const TK_STAR = 9
Const TK_LT = 10
Const TK_LE = 11
Const TK_GT = 12
Const TK_GE = 13
Const TK_NE = 14
Const TK_COMMA = 15
Const TK_LBRACK = 16
Const TK_RBRACK = 17
Const TK_DOT = 18
Const TK_MINUS = 19
Const TK_ARROW = 20
Const TK_AMP = 21
Const TK_BACKSLASH = 22
Const TK_FLOAT = 23
Const TK_SLASH = 24
Const TK_SHL = 25
Const TK_SHR = 26
Const TK_CARET = 27
Const TK_TILDE = 28
Const TK_COLON = 29
Const TK_HASH = 30
Const TK_ERROR = 99

Const LEX_MAX_TOKS = 131072
Const LEX_TEXT_LEN = 256
' Dim buf(…) 用（LEX_TEXT_LEN - 1）
Const LEX_TEXT_MAXIDX = 255
Const LEX_RADIX_DEC = 10
Const LEX_RADIX_HEX = 16

Type Tok
    kind As Long
    textOff As Long
    num As Long
    srcLine As Long
End Type

Type Lexer
    src As *Byte
    pos As Long
    toks As *Tok
    texts As *Byte
    count As Long
    capacity As Long
    err As Long
    srcLine As Long
End Type

' 行末の _ （および直後の空白・'注釈）→ 次行へ継続。識別子 _foo とは区別
Function LexLineContHere(lx As *Lexer) As Long
    Dim src As *Byte
    Dim p As Long
    Dim c As Long

    LexLineContHere = 0
    src = lx->src
    p = lx->pos + 1
    c = src[p]
    If IsIdentCont(c) <> 0 Then Exit Function
    If c = CH_DOLLAR Then Exit Function
    While IsHSpace(src[p]) <> 0
        p = p + 1
    Wend
    If src[p] = CH_SQUOTE Then
        While src[p] <> CH_NUL And IsEol(src[p]) = 0
            p = p + 1
        Wend
    End If
    If src[p] <> CH_NUL And IsEol(src[p]) = 0 Then Exit Function
    lx->pos = p
    If src[lx->pos] = CH_CR Then
        lx->srcLine = lx->srcLine + 1
        lx->pos = lx->pos + 1
        If src[lx->pos] = CH_NL Then
            lx->pos = lx->pos + 1
        End If
    ElseIf src[lx->pos] = CH_NL Then
        lx->srcLine = lx->srcLine + 1
        lx->pos = lx->pos + 1
    End If
    LexLineContHere = 1
End Function

' 行頭（空白のみのあと）の # はディレクティブ。文中の # は TK_HASH（Input #1 / As #1）
Function LexHashIsDirective(lx As *Lexer) As Long
    Dim src As *Byte
    Dim p As Long
    Dim c As Long

    LexHashIsDirective = 1
    src = lx->src
    p = lx->pos - 1
    While p >= 0
        c = src[p]
        If c = CH_SP Or c = CH_TAB Then
            p = p - 1
        ElseIf c = CH_NL Or c = CH_CR Then
            Exit Function
        Else
            LexHashIsDirective = 0
            Exit Function
        End If
    Wend
End Function

Function LexCreate(capacity As Long) As *Lexer
    Dim lx As *Lexer
    LexCreate = NULL
    lx = calloc(SizeOf(Lexer))
    If lx = NULL Then Exit Function
    lx->toks = calloc(BytesN(capacity, SizeOf(Tok)))
    lx->texts = calloc(BytesN(capacity, LEX_TEXT_LEN))
    If lx->toks = NULL Or lx->texts = NULL Then
        If lx->toks <> NULL Then free(lx->toks)
        If lx->texts <> NULL Then free(lx->texts)
        free(lx)
        Exit Function
    End If
    lx->capacity = capacity
    lx->count = 0
    lx->pos = 0
    lx->err = 0
    LexCreate = lx
End Function

Sub LexFree(lx As *Lexer)
    If lx = NULL Then Exit Sub
    If lx->toks <> NULL Then free(lx->toks)
    If lx->texts <> NULL Then free(lx->texts)
    free(lx)
End Sub

Sub LexStoreText(lx As *Lexer, idx As Long, s As *Byte, n As Long)
    Dim texts As *Byte
    Dim toks As *Tok
    Dim off As Long
    Dim i As Long
    texts = lx->texts
    off = idx * LEX_TEXT_LEN
    i = 0
    While i < n And i < LEX_TEXT_MAXIDX
        texts[off + i] = s[i]
        i = i + 1
    Wend
    texts[off + i] = CH_NUL
    If n < LEX_TEXT_LEN Then
        texts[off + LEX_TEXT_LEN - 1] = n As Byte
    End If
    toks = lx->toks
    toks[idx].num = n
End Sub

Sub LexCopyText(lx As *Lexer, idx As Long, dst As *Byte)
    Dim texts As *Byte
    Dim off As Long
    Dim i As Long
    texts = lx->texts
    off = idx * LEX_TEXT_LEN
    i = 0
    Do
        dst[i] = texts[off + i]
        If texts[off + i] = CH_NUL Then Exit Sub
        i = i + 1
        If i >= LEX_TEXT_LEN Then
            dst[LEX_TEXT_MAXIDX] = CH_NUL
            Exit Sub
        End If
    Loop
End Sub

Function LexPush(lx As *Lexer, kind As Long) As Long
    Dim toks As *Tok
    Dim i As Long
    Dim newCap As Long
    Dim p As *Byte
    LexPush = -1
    If lx->count >= lx->capacity Then
        newCap = lx->capacity * 2
        If newCap <= lx->capacity Then
            lx->err = 1
            Exit Function
        End If
        p = MemGrow(lx->toks As BytePtr, BytesN(lx->capacity, SizeOf(Tok)), BytesN(newCap, SizeOf(Tok)))
        If p = NULL Then
            lx->err = 1
            Exit Function
        End If
        lx->toks = p As *Tok
        p = MemGrow(lx->texts, BytesN(lx->capacity, LEX_TEXT_LEN), BytesN(newCap, LEX_TEXT_LEN))
        If p = NULL Then
            lx->err = 1
            Exit Function
        End If
        lx->texts = p
        lx->capacity = newCap
    End If
    toks = lx->toks
    i = lx->count
    toks[i].kind = kind
    toks[i].textOff = i
    toks[i].num = 0
    toks[i].srcLine = lx->srcLine
    LexPush = i
    lx->count = i + 1
End Function

Sub LexSkipEol(lx As *Lexer)
    Dim src As *Byte
    src = lx->src
    While src[lx->pos] <> CH_NUL And IsEol(src[lx->pos]) = 0
        lx->pos = lx->pos + 1
    Wend
End Sub

Function LexSkipComment(lx As *Lexer) As Long
    Dim src As *Byte
    LexSkipComment = 0
    src = lx->src
    If src[lx->pos + 1] <> CH_STAR Then
        LexPush(lx, TK_SLASH)
        lx->pos = lx->pos + 1
        LexSkipComment = 1
        Exit Function
    End If
    lx->pos = lx->pos + 2
    Do
        If src[lx->pos] = CH_NUL Then
            lx->err = 1
            Exit Function
        End If
        If src[lx->pos] = CH_CR Then
            lx->srcLine = lx->srcLine + 1
            lx->pos = lx->pos + 1
            If src[lx->pos] = CH_NL Then
                lx->pos = lx->pos + 1
            End If
        ElseIf src[lx->pos] = CH_NL Then
            lx->srcLine = lx->srcLine + 1
            lx->pos = lx->pos + 1
        ElseIf src[lx->pos] = CH_STAR Then
            If src[lx->pos + 1] = CH_SLASH Then
                lx->pos = lx->pos + 2
                Exit Do
            End If
            lx->pos = lx->pos + 1
        Else
            lx->pos = lx->pos + 1
        End If
    Loop
    LexSkipComment = 1
End Function

Function LexHexLit(lx As *Lexer) As Long
    Dim src As *Byte
    Dim n2 As Long
    Dim c As Long
    Dim n As Long
    Dim v As Long
    Dim idx As Long
    Dim toks As *Tok
    LexHexLit = 0
    src = lx->src
    n2 = src[lx->pos + 1]
    If IsHexPrefix(n2) <> 0 Then
        lx->pos = lx->pos + 2
        n = 0
        Do
            c = src[lx->pos]
            v = HexDigitValue(c)
            If v < 0 Then Exit Do
            n = n * LEX_RADIX_HEX + v
            lx->pos = lx->pos + 1
        Loop
        idx = LexPush(lx, TK_NUMBER)
        If idx < 0 Then Exit Function
        toks = lx->toks
        toks[idx].num = n
    Else
        LexPush(lx, TK_AMP)
        lx->pos = lx->pos + 1
    End If
    LexHexLit = 1
End Function

Function LexNumber(lx As *Lexer) As Long
    Dim src As *Byte
    Dim start As Long
    Dim n As Long
    Dim i As Long
    Dim idx As Long
    Dim toks As *Tok
    Dim buf(LEX_TEXT_MAXIDX) As Byte

    LexNumber = 0
    src = lx->src
    start = lx->pos
    n = 0
    While IsDigit(src[lx->pos]) <> 0
        n = n * LEX_RADIX_DEC + DigitValue(src[lx->pos])
        lx->pos = lx->pos + 1
    Wend
    ' 1.5 / 1.12345 → TK_FLOAT（テキスト保持。IEEE 化は Parser）
    If src[lx->pos] = CH_DOT Then
        If IsDigit(src[lx->pos + 1]) <> 0 Then
            lx->pos = lx->pos + 1
            While IsDigit(src[lx->pos]) <> 0
                lx->pos = lx->pos + 1
            Wend
            n = lx->pos - start
            If n > LEX_TEXT_MAXIDX Then n = LEX_TEXT_MAXIDX
            i = 0
            While i < n
                buf[i] = src[start + i]
                i = i + 1
            Wend
            idx = LexPush(lx, TK_FLOAT)
            If idx < 0 Then Exit Function
            LexStoreText(lx, idx, VarPtr(buf), n)
        Else
            idx = LexPush(lx, TK_NUMBER)
            If idx < 0 Then Exit Function
            toks = lx->toks
            toks[idx].num = n
        End If
    Else
        idx = LexPush(lx, TK_NUMBER)
        If idx < 0 Then Exit Function
        toks = lx->toks
        toks[idx].num = n
    End If
    LexNumber = 1
End Function

Function LexIdent(lx As *Lexer) As Long
    Dim src As *Byte
    Dim start As Long
    Dim n As Long
    Dim i As Long
    Dim idx As Long
    Dim buf(LEX_TEXT_MAXIDX) As Byte
    LexIdent = 0
    src = lx->src
    start = lx->pos
    While IsIdentCont(src[lx->pos]) <> 0
        lx->pos = lx->pos + 1
    Wend
    If src[lx->pos] = CH_DOLLAR Then
        lx->pos = lx->pos + 1
    End If
    n = lx->pos - start
    i = 0
    While i < n And i < LEX_TEXT_MAXIDX
        buf[i] = src[start + i]
        i = i + 1
    Wend
    buf[i] = CH_NUL
    idx = LexPush(lx, TK_IDENT)
    If idx < 0 Then Exit Function
    LexStoreText(lx, idx, VarPtr(buf), i)
    LexIdent = 1
End Function

Function LexString(lx As *Lexer) As Long
    Dim src As *Byte
    Dim i As Long
    Dim idx As Long
    Dim toks As *Tok
    Dim buf(LEX_TEXT_MAXIDX) As Byte
    LexString = 0
    src = lx->src
    lx->pos = lx->pos + 1
    i = 0
    Do
        If src[lx->pos] = CH_NUL Then
            lx->err = 1
            Exit Function
        End If
        If src[lx->pos] = CH_DQUOTE Then
            If src[lx->pos + 1] = CH_DQUOTE Then
                If i < LEX_TEXT_MAXIDX Then
                    buf[i] = CH_DQUOTE
                    i = i + 1
                End If
                lx->pos = lx->pos + 2
            Else
                Exit Do
            End If
        Else
            If i < LEX_TEXT_MAXIDX Then
                buf[i] = src[lx->pos]
                i = i + 1
            End If
            lx->pos = lx->pos + 1
        End If
    Loop
    buf[i] = CH_NUL
    lx->pos = lx->pos + 1
    idx = LexPush(lx, TK_STRING)
    If idx < 0 Then Exit Function
    LexStoreText(lx, idx, VarPtr(buf), i)
    toks = lx->toks
    toks[idx].num = i
    LexString = 1
End Function

Function LexEscapeChar(n2 As Long) As Long
    If n2 = 110 Then
        LexEscapeChar = CH_NL
    ElseIf n2 = 114 Then
        LexEscapeChar = CH_CR
    ElseIf n2 = 116 Then
        LexEscapeChar = CH_TAB
    ElseIf n2 = 48 Then
        LexEscapeChar = CH_NUL
    ElseIf n2 = 92 Then
        LexEscapeChar = CH_BSLASH
    ElseIf n2 = 34 Then
        LexEscapeChar = CH_DQUOTE
    Else
        LexEscapeChar = n2
    End If
End Function

Function LexExString(lx As *Lexer) As Long
    Dim src As *Byte
    Dim i As Long
    Dim idx As Long
    Dim toks As *Tok
    Dim buf(LEX_TEXT_MAXIDX) As Byte
    Dim c As Long
    LexExString = 0
    src = lx->src
    If src[lx->pos] <> CH_DQUOTE Then Exit Function
    lx->pos = lx->pos + 1
    i = 0
    Do
        If src[lx->pos] = CH_NUL Then
            lx->err = 1
            Exit Function
        End If
        If src[lx->pos] = CH_DQUOTE Then
            Exit Do
        End If
        If src[lx->pos] = CH_BSLASH Then
            lx->pos = lx->pos + 1
            If src[lx->pos] = CH_NUL Then
                lx->err = 1
                Exit Function
            End If
            c = LexEscapeChar(src[lx->pos])
            lx->pos = lx->pos + 1
        Else
            c = src[lx->pos]
            lx->pos = lx->pos + 1
        End If
        If i < LEX_TEXT_MAXIDX Then
            buf[i] = c As Byte
            i = i + 1
        End If
    Loop
    buf[i] = CH_NUL
    lx->pos = lx->pos + 1
    idx = LexPush(lx, TK_STRING)
    If idx < 0 Then Exit Function
    LexStoreText(lx, idx, VarPtr(buf), i)
    toks = lx->toks
    toks[idx].num = i
    LexExString = 1
End Function

Function LexTryExStringAfterIdent(lx As *Lexer) As Long
    Dim src As *Byte
    Dim last As Long
    Dim toks As *Tok
    Dim texts As *Byte
    Dim off As Long
    Dim c0 As Long
    Dim c1 As Long
    LexTryExStringAfterIdent = 0
    If lx->count <= 0 Then Exit Function
    last = lx->count - 1
    toks = lx->toks
    If toks[last].kind <> TK_IDENT Then Exit Function
    texts = lx->texts
    off = toks[last].textOff * LEX_TEXT_LEN
    c0 = texts[off]
    c1 = texts[off + 1]
    If texts[off + 2] <> CH_NUL Then Exit Function
    If c0 >= Asc("A") And c0 <= Asc("Z") Then c0 = c0 + 32
    If c1 >= Asc("A") And c1 <= Asc("Z") Then c1 = c1 + 32
    If c0 <> Asc("e") Or c1 <> Asc("x") Then Exit Function
    src = lx->src
    While IsHSpace(src[lx->pos]) <> 0
        lx->pos = lx->pos + 1
    Wend
    If src[lx->pos] <> CH_DQUOTE Then Exit Function
    lx->count = last
    LexTryExStringAfterIdent = LexExString(lx)
End Function

Sub LexTwoCharOp(lx As *Lexer, c As Long)
    Dim src As *Byte
    Dim n2 As Long
    src = lx->src
    n2 = src[lx->pos + 1]
    If c = CH_MINUS Then
        If n2 = CH_GREATER Then
            LexPush(lx, TK_ARROW)
            lx->pos = lx->pos + 2
        Else
            LexPush(lx, TK_MINUS)
            lx->pos = lx->pos + 1
        End If
    ElseIf c = CH_LESS Then
        If n2 = CH_EQ Then
            LexPush(lx, TK_LE)
            lx->pos = lx->pos + 2
        ElseIf n2 = CH_GREATER Then
            LexPush(lx, TK_NE)
            lx->pos = lx->pos + 2
        ElseIf n2 = CH_LESS Then
            LexPush(lx, TK_SHL)
            lx->pos = lx->pos + 2
        Else
            LexPush(lx, TK_LT)
            lx->pos = lx->pos + 1
        End If
    ElseIf c = CH_GREATER Then
        If n2 = CH_EQ Then
            LexPush(lx, TK_GE)
            lx->pos = lx->pos + 2
        ElseIf n2 = CH_LESS Then
            ' >< は <> と同じ（等しくない）
            LexPush(lx, TK_NE)
            lx->pos = lx->pos + 2
        ElseIf n2 = CH_GREATER Then
            LexPush(lx, TK_SHR)
            lx->pos = lx->pos + 2
        Else
            LexPush(lx, TK_GT)
            lx->pos = lx->pos + 1
        End If
    End If
End Sub

Sub LexSimpleOp(lx As *Lexer, kind As Long)
    LexPush(lx, kind)
    lx->pos = lx->pos + 1
End Sub

' 単一文字で確定する演算子。該当しなければ -1
Function LexSimpleOpKind(c As Long) As Long
    LexSimpleOpKind = -1
    If c = CH_LPAREN Then
        LexSimpleOpKind = TK_LPAREN
    ElseIf c = CH_RPAREN Then
        LexSimpleOpKind = TK_RPAREN
    ElseIf c = CH_SEMI Then
        LexSimpleOpKind = TK_SEMI
    ElseIf c = CH_COLON Then
        LexSimpleOpKind = TK_COLON
    ElseIf c = CH_COMMA Then
        LexSimpleOpKind = TK_COMMA
    ElseIf c = CH_LBRACK Then
        LexSimpleOpKind = TK_LBRACK
    ElseIf c = CH_RBRACK Then
        LexSimpleOpKind = TK_RBRACK
    ElseIf c = CH_DOT Then
        LexSimpleOpKind = TK_DOT
    ElseIf c = CH_PLUS Then
        LexSimpleOpKind = TK_PLUS
    ElseIf c = CH_STAR Then
        LexSimpleOpKind = TK_STAR
    ElseIf c = CH_CARET Then
        LexSimpleOpKind = TK_CARET
    ElseIf c = CH_TILDE Then
        LexSimpleOpKind = TK_TILDE
    ElseIf c = CH_EQ Then
        LexSimpleOpKind = TK_EQ
    End If
End Function

' 改行を消費したら 1
Function LexAdvanceNewline(lx As *Lexer, c As Long) As Long
    Dim src As *Byte
    LexAdvanceNewline = 0
    src = lx->src
    If c = CH_CR Then
        lx->srcLine = lx->srcLine + 1
        lx->pos = lx->pos + 1
        If src[lx->pos] = CH_NL Then
            lx->pos = lx->pos + 1
        End If
        LexAdvanceNewline = 1
    ElseIf c = CH_NL Then
        lx->srcLine = lx->srcLine + 1
        lx->pos = lx->pos + 1
        LexAdvanceNewline = 1
    End If
End Function

Function LexIdentOrExString(lx As *Lexer) As Long
    LexIdentOrExString = 0
    If LexIdent(lx) = 0 Then Exit Function
    If LexTryExStringAfterIdent(lx) = 0 Then
        If lx->err <> 0 Then Exit Function
    End If
    LexIdentOrExString = 1
End Function

Function LexTokenOne(lx As *Lexer, c As Long) As Long
    Dim kind As Long
    LexTokenOne = 1
    If IsHSpace(c) <> 0 Then
        lx->pos = lx->pos + 1
    ElseIf c = CH_SQUOTE Then
        LexSkipEol(lx)
    ElseIf c = CH_SLASH Then
        LexTokenOne = LexSkipComment(lx)
    ElseIf c = CH_HASH Then
        If LexHashIsDirective(lx) <> 0 Then
            LexSkipEol(lx)
        Else
            LexSimpleOp(lx, TK_HASH)
        End If
    ElseIf c = CH_AMP Then
        LexTokenOne = LexHexLit(lx)
    ElseIf c = CH_BSLASH Then
        LexSimpleOp(lx, TK_BACKSLASH)
    ElseIf IsDigit(c) <> 0 Then
        LexTokenOne = LexNumber(lx)
    ElseIf c = CH_UNDER Then
        If LexLineContHere(lx) = 0 Then
            LexTokenOne = LexIdent(lx)
        End If
    ElseIf IsIdentChar(c) <> 0 Then
        LexTokenOne = LexIdentOrExString(lx)
    ElseIf c = CH_DQUOTE Then
        LexTokenOne = LexString(lx)
    ElseIf c = CH_MINUS Or c = CH_LESS Or c = CH_GREATER Then
        LexTwoCharOp(lx, c)
    Else
        kind = LexSimpleOpKind(c)
        If kind < 0 Then
            lx->err = 1
            LexTokenOne = 0
        Else
            LexSimpleOp(lx, kind)
        End If
    End If
End Function

Function LexTokenize(lx As *Lexer, src As *Byte) As Long
    Dim c As Long

    LexTokenize = 0
    lx->src = src
    lx->pos = 0
    lx->count = 0
    lx->err = 0
    lx->srcLine = 1

    While src[lx->pos] <> CH_NUL
        c = src[lx->pos]
        If LexAdvanceNewline(lx, c) = 0 Then
            If LexTokenOne(lx, c) = 0 Then Exit Function
        End If
    Wend

    LexPush(lx, TK_EOF)
    If lx->err <> 0 Then Exit Function
    LexTokenize = 1
End Function
