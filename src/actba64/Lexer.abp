' ===================================================
'  Lexer - source text -> token list
' ===================================================

Const TK_EOF = 0
Const TK_IDENT = 1
Const TK_STRING = 2
Const TK_LPAREN = 3
Const TK_RPAREN = 4
Const TK_SEMI = 5
Const TK_NUMBER = 6
Const TK_EQ = 7
Const TK_PLUS = 8
Const TK_STAR = 9
Const TK_LT = 10
Const TK_LE = 11
Const TK_GT = 12
Const TK_GE = 13
Const TK_NE = 14
Const TK_COMMA = 15
Const TK_LBRACK = 16
Const TK_RBRACK = 17
Const TK_DOT = 18
Const TK_MINUS = 19
Const TK_ARROW = 20
Const TK_AMP = 21
Const TK_BACKSLASH = 22
Const TK_FLOAT = 23
Const TK_SLASH = 24
Const TK_SHL = 25
Const TK_SHR = 26
Const TK_CARET = 27
Const TK_TILDE = 28
Const TK_COLON = 29
Const TK_HASH = 30
Const TK_ERROR = 99

Const LEX_MAX_TOKS = 131072
Const LEX_TEXT_LEN = 256
' Dim buf(…) 用（LEX_TEXT_LEN - 1）
Const LEX_TEXT_MAXIDX = 255
Const LEX_RADIX_DEC = 10
Const LEX_RADIX_HEX = 16

Type Tok
    kind As Long
    textOff As Long
    num As Long
    srcLine As Long
End Type

Type Lexer
    src As *Byte
    pos As Long
    toks As *Tok
    texts As *Byte
    count As Long
    capacity As Long
    err As Long
    srcLine As Long
End Type

' 行末の _ （および直後の空白・'注釈）→ 次行へ継続。識別子 _foo とは区別
Function LexLineContHere(lx As *Lexer) As Long
    Dim src As *Byte
    Dim p As Long
    Dim c As Long

    LexLineContHere = 0
    src = lx->src
    p = lx->pos + 1
    c = src[p]
    If IsIdentCont(c) <> 0 Then Exit Function
    If c = CH_DOLLAR Then Exit Function
    While IsHSpace(src[p]) <> 0
        p = p + 1
    Wend
    If src[p] = CH_SQUOTE Then
        While src[p] <> CH_NUL And IsEol(src[p]) = 0
            p = p + 1
        Wend
    End If
    If src[p] <> CH_NUL And IsEol(src[p]) = 0 Then Exit Function
    lx->pos = p
    If src[lx->pos] = CH_CR Then
        lx->srcLine = lx->srcLine + 1
        lx->pos = lx->pos + 1
        If src[lx->pos] = CH_NL Then
            lx->pos = lx->pos + 1
        End If
    ElseIf src[lx->pos] = CH_NL Then
        lx->srcLine = lx->srcLine + 1
        lx->pos = lx->pos + 1
    End If
    LexLineContHere = 1
End Function

' 行頭（空白のみのあと）の # はディレクティブ。文中の # は TK_HASH（Input #1 / As #1）
Function LexHashIsDirective(lx As *Lexer) As Long
    Dim src As *Byte
    Dim p As Long
    Dim c As Long

    LexHashIsDirective = 1
    src = lx->src
    p = lx->pos - 1
    While p >= 0
        c = src[p]
        If c = CH_SP Or c = CH_TAB Then
            p = p - 1
        ElseIf c = CH_NL Or c = CH_CR Then
            Exit Function
        Else
            LexHashIsDirective = 0
            Exit Function
        End If
    Wend
End Function

Function LexCreate(capacity As Long) As *Lexer
    Dim lx As *Lexer
    LexCreate = NULL
    lx = calloc(SizeOf(Lexer))
    If lx = NULL Then Exit Function
    lx->toks = calloc(BytesN(capacity, SizeOf(Tok)))
    lx->texts = calloc(BytesN(capacity, LEX_TEXT_LEN))
    If lx->toks = NULL Or lx->texts = NULL Then
        If lx->toks <> NULL Then free(lx->toks)
        If lx->texts <> NULL Then free(lx->texts)
        free(lx)
        Exit Function
    End If
    lx->capacity = capacity
    lx->count = 0
    lx->pos = 0
    lx->err = 0
    LexCreate = lx
End Function

Sub LexFree(lx As *Lexer)
    If lx = NULL Then Exit Sub
    If lx->toks <> NULL Then free(lx->toks)
    If lx->texts <> NULL Then free(lx->texts)
    free(lx)
End Sub

Sub LexStoreText(lx As *Lexer, idx As Long, s As *Byte, n As Long)
    Dim texts As *Byte
    Dim toks As *Tok
    Dim off As Long
    Dim i As Long
    texts = lx->texts
    off = idx * LEX_TEXT_LEN
    i = 0
    While i < n And i < LEX_TEXT_MAXIDX
        texts[off + i] = s[i]
        i = i + 1
    Wend
    texts[off + i] = CH_NUL
    If n < LEX_TEXT_LEN Then
        texts[off + LEX_TEXT_LEN - 1] = n As Byte
    End If
    toks = lx->toks
    toks[idx].num = n
End Sub

Sub LexCopyText(lx As *Lexer, idx As Long, dst As *Byte)
    Dim texts As *Byte
    Dim off As Long
    Dim i As Long
    texts = lx->texts
    off = idx * LEX_TEXT_LEN
    i = 0
    Do
        dst[i] = texts[off + i]
        If texts[off + i] = CH_NUL Then Exit Sub
        i = i + 1
        If i >= LEX_TEXT_LEN Then
            dst[LEX_TEXT_MAXIDX] = CH_NUL
            Exit Sub
        End If
    Loop
End Sub

Function LexPush(lx As *Lexer, kind As Long) As Long
    Dim toks As *Tok
    Dim i As Long
    Dim newCap As Long
    Dim p As *Byte
    LexPush = -1
    If lx->count >= lx->capacity Then
        newCap = lx->capacity * 2
        If newCap <= lx->capacity Then
            lx->err = 1
            Exit Function
        End If
        p = MemGrow(lx->toks As BytePtr, BytesN(lx->capacity, SizeOf(Tok)), BytesN(newCap, SizeOf(Tok)))
        If p = NULL Then
            lx->err = 1
            Exit Function
        End If
        lx->toks = p As *Tok
        p = MemGrow(lx->texts, BytesN(lx->capacity, LEX_TEXT_LEN), BytesN(newCap, LEX_TEXT_LEN))
        If p = NULL Then
            lx->err = 1
            Exit Function
        End If
        lx->texts = p
        lx->capacity = newCap
    End If
    toks = lx->toks
    i = lx->count
    toks[i].kind = kind
    toks[i].textOff = i
    toks[i].num = 0
    toks[i].srcLine = lx->srcLine
    LexPush = i
    lx->count = i + 1
End Function

Sub LexSkipEol(lx As *Lexer)
    Dim src As *Byte
    src = lx->src
    While src[lx->pos] <> CH_NUL And IsEol(src[lx->pos]) = 0
        lx->pos = lx->pos + 1
    Wend
End Sub

Function LexSkipComment(lx As *Lexer) As Long
    Dim src As *Byte
    LexSkipComment = 0
    src = lx->src
    If src[lx->pos + 1] <> CH_STAR Then
        LexPush(lx, TK_SLASH)
        lx->pos = lx->pos + 1
        LexSkipComment = 1
        Exit Function
    End If
    lx->pos = lx->pos + 2
    Do
        If src[lx->pos] = CH_NUL Then
            lx->err = 1
            Exit Function
        End If
        If src[lx->pos] = CH_CR Then
            lx->srcLine = lx->srcLine + 1
            lx->pos = lx->pos + 1
            If src[lx->pos] = CH_NL Then
                lx->pos = lx->pos + 1
            End If
        ElseIf src[lx->pos] = CH_NL Then
            lx->srcLine = lx->srcLine + 1
            lx->pos = lx->pos + 1
        ElseIf src[lx->pos] = CH_STAR Then
            If src[lx->pos + 1] = CH_SLASH Then
                lx->pos = lx->pos + 2
                Exit Do
            End If
            lx->pos = lx->pos + 1
        Else
            lx->pos = lx->pos + 1
        End If
    Loop
    LexSkipComment = 1
End Function
