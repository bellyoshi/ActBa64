' ===================================================
'  Lexer - source text -> token list
' ===================================================

Const TK_EOF = 0
Const TK_IDENT = 1
Const TK_STRING = 2
Const TK_LPAREN = 3
Const TK_RPAREN = 4
Const TK_SEMI = 5
Const TK_NUMBER = 6
Const TK_EQ = 7
Const TK_PLUS = 8
Const TK_STAR = 9
Const TK_LT = 10
Const TK_LE = 11
Const TK_GT = 12
Const TK_GE = 13
Const TK_NE = 14
Const TK_COMMA = 15
Const TK_LBRACK = 16
Const TK_RBRACK = 17
Const TK_DOT = 18
Const TK_MINUS = 19
Const TK_ARROW = 20
Const TK_AMP = 21
Const TK_BACKSLASH = 22
Const TK_ERROR = 99

Const LEX_MAX_TOKS = 131072
Const LEX_TEXT_LEN = 256

Type Tok
    kind As Long
    textOff As Long
    num As Long
    line As Long
End Type

Type Lexer
    src As *Byte
    pos As Long
    toks As *Tok
    texts As *Byte
    count As Long
    capacity As Long
    err As Long
    line As Long
End Type

Function LexIsSpace(c As Long) As Long
    If c = 32 Or c = 9 Or c = 10 Or c = 13 Then
        LexIsSpace = 1
    Else
        LexIsSpace = 0
    End If
End Function

Function LexIsAlpha(c As Long) As Long
    If c >= 65 And c <= 90 Then
        LexIsAlpha = 1
    ElseIf c >= 97 And c <= 122 Then
        LexIsAlpha = 1
    ElseIf c = 95 Then
        LexIsAlpha = 1
    Else
        LexIsAlpha = 0
    End If
End Function

Function LexIsDigit(c As Long) As Long
    If c >= 48 And c <= 57 Then
        LexIsDigit = 1
    Else
        LexIsDigit = 0
    End If
End Function

Function LexIsAlnum(c As Long) As Long
    If LexIsAlpha(c) <> 0 Then
        LexIsAlnum = 1
    ElseIf LexIsDigit(c) <> 0 Then
        LexIsAlnum = 1
    Else
        LexIsAlnum = 0
    End If
End Function

Function LexCreate(capacity As Long) As *Lexer
    Dim lx As *Lexer
    LexCreate = NULL
    lx = calloc(SizeOf(Lexer))
    If lx = NULL Then Exit Function
    lx.toks = calloc(SizeOf(Tok) * capacity)
    lx.texts = calloc(LEX_TEXT_LEN * capacity)
    If lx.toks = NULL Or lx.texts = NULL Then
        If lx.toks <> NULL Then free(lx.toks)
        If lx.texts <> NULL Then free(lx.texts)
        free(lx)
        Exit Function
    End If
    lx.capacity = capacity
    lx.count = 0
    lx.pos = 0
    lx.err = 0
    LexCreate = lx
End Function

Sub LexFree(lx As *Lexer)
    If lx = NULL Then Exit Sub
    If lx.toks <> NULL Then free(lx.toks)
    If lx.texts <> NULL Then free(lx.texts)
    free(lx)
End Sub

Sub LexStoreText(lx As *Lexer, idx As Long, s As *Byte, n As Long)
    Dim texts As *Byte
    Dim off As Long
    Dim i As Long
    texts = lx.texts
    off = idx * LEX_TEXT_LEN
    i = 0
    While i < n And i < LEX_TEXT_LEN - 1
        texts[off + i] = s[i]
        i = i + 1
    Wend
    texts[off + i] = 0
End Sub

Sub LexCopyText(lx As *Lexer, idx As Long, dst As *Byte)
    Dim texts As *Byte
    Dim off As Long
    Dim i As Long
    texts = lx.texts
    off = idx * LEX_TEXT_LEN
    i = 0
    Do
        dst[i] = texts[off + i]
        If texts[off + i] = 0 Then Exit Sub
        i = i + 1
        If i >= LEX_TEXT_LEN Then
            dst[LEX_TEXT_LEN - 1] = 0
            Exit Sub
        End If
    Loop
End Sub

Function LexPush(lx As *Lexer, kind As Long) As Long
    Dim toks As *Tok
    Dim i As Long
    LexPush = -1
    If lx.count >= lx.capacity Then
        lx.err = 1
        Exit Function
    End If
    toks = lx.toks
    i = lx.count
    toks[i].kind = kind
    toks[i].textOff = i
    toks[i].num = 0
    toks[i].line = lx.line
    LexPush = i
    lx.count = i + 1
End Function

Function LexTokenize(lx As *Lexer, src As *Byte) As Long
    Dim c As Long
    Dim n2 As Long
    Dim start As Long
    Dim n As Long
    Dim idx As Long
    Dim buf(255) As Byte
    Dim i As Long
    Dim toks As *Tok

    LexTokenize = 0
    lx.src = src
    lx.pos = 0
    lx.count = 0
    lx.err = 0
    lx.line = 1

    While src[lx.pos] <> 0
        c = src[lx.pos]
        If c = 13 Then
            lx.line = lx.line + 1
            lx.pos = lx.pos + 1
            If src[lx.pos] = 10 Then
                lx.pos = lx.pos + 1
            End If
        ElseIf c = 10 Then
            lx.line = lx.line + 1
            lx.pos = lx.pos + 1
        ElseIf c = 32 Or c = 9 Then
            lx.pos = lx.pos + 1
        ElseIf c = 39 Then
            While src[lx.pos] <> 0 And src[lx.pos] <> 10 And src[lx.pos] <> 13
                lx.pos = lx.pos + 1
            Wend
        ElseIf c = 35 Then
            While src[lx.pos] <> 0 And src[lx.pos] <> 10 And src[lx.pos] <> 13
                lx.pos = lx.pos + 1
            Wend
        ElseIf c = 38 Then
            ' &H hex literal, else string concat &
            n2 = src[lx.pos + 1]
            If n2 = 72 Or n2 = 104 Then
                lx.pos = lx.pos + 2
                n = 0
                Do
                    c = src[lx.pos]
                    If c >= 48 And c <= 57 Then
                        n = n * 16 + (c - 48)
                    ElseIf c >= 65 And c <= 70 Then
                        n = n * 16 + (c - 55)
                    ElseIf c >= 97 And c <= 102 Then
                        n = n * 16 + (c - 87)
                    Else
                        Exit Do
                    End If
                    lx.pos = lx.pos + 1
                Loop
                idx = LexPush(lx, TK_NUMBER)
                If idx < 0 Then Exit Function
                toks = lx.toks
                toks[idx].num = n
            Else
                LexPush(lx, TK_AMP)
                lx.pos = lx.pos + 1
            End If
        ElseIf c = 92 Then
            LexPush(lx, TK_BACKSLASH)
            lx.pos = lx.pos + 1
        ElseIf LexIsDigit(c) <> 0 Then
            n = 0
            While LexIsDigit(src[lx.pos]) <> 0
                n = n * 10 + (src[lx.pos] - 48)
                lx.pos = lx.pos + 1
            Wend
            idx = LexPush(lx, TK_NUMBER)
            If idx < 0 Then Exit Function
            toks = lx.toks
            toks[idx].num = n
        ElseIf LexIsAlpha(c) <> 0 Then
            start = lx.pos
            While LexIsAlnum(src[lx.pos]) <> 0
                lx.pos = lx.pos + 1
            Wend
            If src[lx.pos] = 36 Then
                ' trailing $ (Left$ / Mid$)
                lx.pos = lx.pos + 1
            End If
            n = lx.pos - start
            i = 0
            While i < n And i < LEX_TEXT_LEN - 1
                buf[i] = src[start + i]
                i = i + 1
            Wend
            buf[i] = 0
            idx = LexPush(lx, TK_IDENT)
            If idx < 0 Then Exit Function
            LexStoreText(lx, idx, VarPtr(buf), i)
        ElseIf c = 34 Then
            lx.pos = lx.pos + 1
            i = 0
            Do
                If src[lx.pos] = 0 Then
                    lx.err = 1
                    Exit Function
                End If
                If src[lx.pos] = 34 Then
                    If src[lx.pos + 1] = 34 Then
                        If i < LEX_TEXT_LEN - 1 Then
                            buf[i] = 34
                            i = i + 1
                        End If
                        lx.pos = lx.pos + 2
                    Else
                        Exit Do
                    End If
                Else
                    If i < LEX_TEXT_LEN - 1 Then
                        buf[i] = src[lx.pos]
                        i = i + 1
                    End If
                    lx.pos = lx.pos + 1
                End If
            Loop
            buf[i] = 0
            lx.pos = lx.pos + 1
            idx = LexPush(lx, TK_STRING)
            If idx < 0 Then Exit Function
            LexStoreText(lx, idx, VarPtr(buf), i)
        ElseIf c = 40 Then
            LexPush(lx, TK_LPAREN)
            lx.pos = lx.pos + 1
        ElseIf c = 41 Then
            LexPush(lx, TK_RPAREN)
            lx.pos = lx.pos + 1
        ElseIf c = 59 Then
            LexPush(lx, TK_SEMI)
            lx.pos = lx.pos + 1
        ElseIf c = 44 Then
            LexPush(lx, TK_COMMA)
            lx.pos = lx.pos + 1
        ElseIf c = 91 Then
            LexPush(lx, TK_LBRACK)
            lx.pos = lx.pos + 1
        ElseIf c = 93 Then
            LexPush(lx, TK_RBRACK)
            lx.pos = lx.pos + 1
        ElseIf c = 46 Then
            LexPush(lx, TK_DOT)
            lx.pos = lx.pos + 1
        ElseIf c = 43 Then
            LexPush(lx, TK_PLUS)
            lx.pos = lx.pos + 1
        ElseIf c = 45 Then
            If src[lx.pos + 1] = 62 Then
                LexPush(lx, TK_ARROW)
                lx.pos = lx.pos + 2
            Else
                LexPush(lx, TK_MINUS)
                lx.pos = lx.pos + 1
            End If
        ElseIf c = 42 Then
            LexPush(lx, TK_STAR)
            lx.pos = lx.pos + 1
        ElseIf c = 61 Then
            LexPush(lx, TK_EQ)
            lx.pos = lx.pos + 1
        ElseIf c = 60 Then
            n2 = src[lx.pos + 1]
            If n2 = 61 Then
                LexPush(lx, TK_LE)
                lx.pos = lx.pos + 2
            ElseIf n2 = 62 Then
                LexPush(lx, TK_NE)
                lx.pos = lx.pos + 2
            Else
                LexPush(lx, TK_LT)
                lx.pos = lx.pos + 1
            End If
        ElseIf c = 62 Then
            If src[lx.pos + 1] = 61 Then
                LexPush(lx, TK_GE)
                lx.pos = lx.pos + 2
            Else
                LexPush(lx, TK_GT)
                lx.pos = lx.pos + 1
            End If
        Else
            lx.err = 1
            Exit Function
        End If
    Wend

    LexPush(lx, TK_EOF)
    If lx.err <> 0 Then Exit Function
    LexTokenize = 1
End Function
