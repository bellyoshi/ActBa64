Const IR_DLL_USER32 = 1
Const IR_DLL_KERNEL32 = 2
Const IR_DLL_GDI32 = 3
Const IR_DLL_IMM32 = 4
Const IR_DLL_COMDLG32 = 5
Const IR_DLL_SHELL32 = 6
Const IR_DLL_OLE32 = 7
Const IR_DLL_D3D11 = 8
Const IR_DLL_D3DCOMPILER = 9

Const IR_MAX_OPS = 262144
Const IR_STR_LEN = 256
Const IR_MAX_FIXUPS = 32768
Const IR_MAX_LABELS = 32768

Type IrOp
    op As Long
    arg1 As DWord
    arg2 As DWord
    strId As Long
End Type

Type IrList
    ops As *IrOp
    strs As *Byte
    count As Long
    capacity As Long
    frameSize As Long
    globSize As Long
End Type

Function IrCreate(capacity As Long) As *IrList
    Dim list As *IrList
    IrCreate = NULL
    list = calloc(SizeOf(IrList))
    If list = NULL Then Exit Function
    list->ops = calloc(BytesN(capacity, SizeOf(IrOp)))
    list->strs = calloc(BytesN(capacity, IR_STR_LEN))
    If list->ops = NULL Or list->strs = NULL Then
        If list->ops <> NULL Then free(list->ops)
        If list->strs <> NULL Then free(list->strs)
        free(list)
        Exit Function
    End If
    list->count = 0
    list->capacity = capacity
    list->frameSize = &H28
    list->globSize = 0
    IrCreate = list
End Function

Sub IrFree(list As *IrList)
    If list = NULL Then Exit Sub
    If list->ops <> NULL Then free(list->ops)
    If list->strs <> NULL Then free(list->strs)
    free(list)
End Sub

Sub IrSetStrAt(list As *IrList, idx As Long, s As *Byte)
    Dim i As Long
    Dim off As Long
    Dim strs As *Byte
    strs = list->strs
    off = idx * IR_STR_LEN
    i = 0
    While s[i] <> 0 And i < IR_STR_LEN - 1
        strs[off + i] = s[i]
        i = i + 1
    Wend
    strs[off + i] = 0
End Sub

Sub IrCopyStrAt(list As *IrList, idx As Long, dst As *Byte)
    Dim i As Long
    Dim off As Long
    Dim strs As *Byte
    strs = list->strs
    off = idx * IR_STR_LEN
    i = 0
    Do
        dst[i] = strs[off + i]
        If strs[off + i] = 0 Then Exit Sub
        i = i + 1
        If i >= IR_STR_LEN Then
            dst[IR_STR_LEN - 1] = 0
            Exit Sub
        End If
    Loop
End Sub

Function IrEmit(list As *IrList, op As Long, arg1 As DWord, arg2 As DWord) As Long
    Dim ops As *IrOp
    Dim i As Long
    Dim strs As *Byte
    Dim newCap As Long
    Dim p As *Byte
    IrEmit = -1
    If list->count >= list->capacity Then
        newCap = list->capacity * 2
        If newCap <= list->capacity Then Exit Function
        p = MemGrow(list->ops, BytesN(list->capacity, SizeOf(IrOp)), BytesN(newCap, SizeOf(IrOp)))
        If p = NULL Then Exit Function
        list->ops = p
        p = MemGrow(list->strs, BytesN(list->capacity, IR_STR_LEN), BytesN(newCap, IR_STR_LEN))
        If p = NULL Then Exit Function
        list->strs = p
        list->capacity = newCap
    End If
    ops = list->ops
    strs = list->strs
    i = list->count
    ops[i].op = op
    ops[i].arg1 = arg1
    ops[i].arg2 = arg2
    ops[i].strId = -1
    strs[i * IR_STR_LEN] = 0
    IrEmit = i
    list->count = i + 1
End Function

Function IrEmitStr(list As *IrList, op As Long, arg1 As DWord, s As *Byte) As Long
    Dim idx As Long
    idx = IrEmit(list, op, arg1, 0)
    If idx < 0 Then
        IrEmitStr = -1
        Exit Function
    End If
    IrSetStrAt(list, idx, s)
    IrEmitStr = idx
End Function
