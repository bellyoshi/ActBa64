' AstLowerConst - 定数登録と定数畳み込み

' 診断に使う、いま登録している Const / Enum の文（-1 は組込み）
Dim g_constStmt As Long
' 組込み定数（TRUE / FALSE）の数。これより後ろだけ再定義を調べる
Dim g_constBuiltinN As Long

' 同じ名前の Const を違う値で定義し直したらエラー（同じ値なら標準ヘッダとユーザの重複として許す）
Function LowConstRedefErr(ctx As *LowerCtx, name As *Byte) As boolean
    LowConstRedefErr = false
    LowerDiagError(ctx, g_constStmt, "Const '" + MakeStr(name) + "' is already defined with a different value")
    ctx->err = 1
End Function

' 既にある数値定数 i と同じ値・同じ種類なら true
Function LowConstSameNum(ctx As *LowerCtx, i As Long, lo As Long, hi As Long, isDbl As Long) As boolean
    Dim vals As *Long
    LowConstSameNum = false
    vals = ctx->constVals
    If vals[i] <> lo Or g_constIsDbl[i] <> isDbl Then Exit Function
    If isDbl <> 0 And g_constHi[i] <> hi Then Exit Function
    LowConstSameNum = true
End Function

' 既にあれば 1（同じ値）/ -1（違う値でエラー）、無ければ 0
Function LowConstSeenNum(ctx As *LowerCtx, name As *Byte, lo As Long, hi As Long, isDbl As Long) As Long
    Dim i As Long
    LowConstSeenNum = 0
    i = LowFindConst(ctx, name)
    If i < 0 Then Exit Function
    LowConstSeenNum = 1
    If i < g_constBuiltinN Then Exit Function
    If LowConstSameNum(ctx, i, lo, hi, isDbl) Then Exit Function
    LowConstRedefErr(ctx, name)
    LowConstSeenNum = -1
End Function

Function LowFindConst(ctx As *LowerCtx, name As *Byte) As Long
    LowFindConst = NhFind(VarPtr(g_nhConst(0)), ctx->constNames, name)
End Function

Sub LowAddBuiltinConsts(ctx As *LowerCtx)
    Dim t(KW_SHORT_LEN - 1) As Byte
    Dim f(KW_SHORT_LEN - 1) As Byte
    lstrcpy(VarPtr(t), "TRUE")
    lstrcpy(VarPtr(f), "FALSE")
    g_constStmt = -1
    g_constBuiltinN = 0
    LowAddConst(ctx, VarPtr(t), 1)
    LowAddConst(ctx, VarPtr(f), 0)
    g_constBuiltinN = ctx->constCount
End Sub

' 戻り値 true : 正常終了  false : エラーあり
Function LowAddConst(ctx As *LowerCtx, name As *Byte, v As Long) As boolean
    Dim seen As Long
    Dim i As Long
    Dim names As *Byte
    Dim vals As *Long
    Dim j As Long
    Dim off As Long

    LowAddConst = false
    seen = LowConstSeenNum(ctx, name, v, 0, 0)
    If seen < 0 Then Exit Function
    If seen > 0 Then
        LowAddConst = true
        Exit Function
    End If
    If Not LowEnsureConstCap(ctx) Then
        Print "error: out of memory (consts)"
        ctx->err = 1
        Exit Function
    End If
    i = ctx->constCount
    names = ctx->constNames
    vals = ctx->constVals
    off = i * SYM_NAME_LEN
    j = 0
    While name[j] <> 0 And j < SYM_NAME_LEN - 1
        names[off + j] = name[j]
        j = j + 1
    Wend
    names[off + j] = 0
    vals[i] = v
    g_constHi[i] = 0
    g_constIsDbl[i] = 0
    ctx->constCount = i + 1
    NhPut(VarPtr(g_nhConst(0)), name, i)
    LowAddConst = true
End Function

Function LowAddDblConst(ctx As *LowerCtx, name As *Byte, lo As Long, hi As Long) As boolean
    Dim i As Long
    Dim seen As Long
    LowAddDblConst = false
    seen = LowConstSeenNum(ctx, name, lo, hi, 1)
    If seen < 0 Then Exit Function
    LowAddDblConst = true
    If seen > 0 Then Exit Function
    LowAddDblConst = false
    If Not LowAddConst(ctx, name, lo) Then Exit Function
    i = LowFindConst(ctx, name)
    If i < 0 Then Exit Function
    g_constHi[i] = hi
    g_constIsDbl[i] = 1
    LowAddDblConst = true
End Function

Function LowConstType(ctx As *LowerCtx, name As *Byte) As Long
    Dim ci As Long
    LowConstType = -1
    ci = LowFindConst(ctx, name)
    If ci < 0 Then Exit Function
    LowConstType = TY_LONG
    If g_constIsDbl[ci] <> 0 Then LowConstType = TY_DOUBLE
End Function

Function LowFindStrConst(ctx As *LowerCtx, name As *Byte) As Long
    Dim i As Long
    Dim names As *Byte
    Dim off As Long
    LowFindStrConst = -1
    names = ctx->constStrNames
    If names = NULL Then Exit Function
    i = 0
    While i < ctx->constStrCount
        off = i * SYM_NAME_LEN
        If LowNameEqExact(VarPtr(names[off]), name) Then
            LowFindStrConst = i
            Exit Function
        End If
        i = i + 1
    Wend
End Function

' 文字列定数 i が s と同じなら true
Function LowStrConstSame(ctx As *LowerCtx, i As Long, s As *Byte) As boolean
    Dim vals As *Byte
    vals = ctx->constStrVals
    LowStrConstSame = false
    If lstrcmp(VarPtr(vals[i * AST_STR_LEN]), s) = 0 Then LowStrConstSame = true
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function LowAddStrConst(ctx As *LowerCtx, name As *Byte, s As *Byte) As boolean
    Dim i As Long
    Dim names As *Byte
    Dim vals As *Byte
    Dim j As Long
    Dim off As Long

    LowAddStrConst = false
    i = LowFindStrConst(ctx, name)
    If i >= 0 Then
        If LowStrConstSame(ctx, i, s) Then LowAddStrConst = true
        If Not LowAddStrConst Then LowConstRedefErr(ctx, name)
        Exit Function
    End If
    If Not LowEnsureConstStrCap(ctx) Then
        Print "error: out of memory (string consts)"
        ctx->err = 1
        Exit Function
    End If
    If ctx->constStrNames = NULL Or ctx->constStrVals = NULL Then
        ctx->err = 1
        Exit Function
    End If
    i = ctx->constStrCount
    names = ctx->constStrNames
    vals = ctx->constStrVals
    off = i * SYM_NAME_LEN
    j = 0
    While name[j] <> 0 And j < SYM_NAME_LEN - 1
        names[off + j] = name[j]
        j = j + 1
    Wend
    names[off + j] = 0
    off = i * AST_STR_LEN
    j = 0
    While s[j] <> 0 And j < AST_STR_LEN - 1
        vals[off + j] = s[j]
        j = j + 1
    Wend
    vals[off + j] = 0
    ctx->constStrCount = i + 1
    LowAddStrConst = true
End Function

Function LowConstEvalArithOps(op As Long, lv As Long, rv As Long) As Long
    LowConstEvalArithOps = -1
    If op = BOP_ADD Then
        LowConstEvalArithOps = lv + rv
    ElseIf op = BOP_SUB Then
        LowConstEvalArithOps = lv - rv
    ElseIf op = BOP_MUL Then
        LowConstEvalArithOps = lv * rv
    ElseIf op = BOP_OR Then
        LowConstEvalArithOps = lv Or rv
    ElseIf op = BOP_AND Then
        LowConstEvalArithOps = lv And rv
    ElseIf op = BOP_IDIV Or op = BOP_DIV Then
        If rv <> 0 Then
            LowConstEvalArithOps = lv \ rv
        End If
    ElseIf op = BOP_MOD Then
        If rv <> 0 Then
            LowConstEvalArithOps = lv - (lv \ rv) * rv
        End If
    ElseIf op = BOP_XOR Then
        LowConstEvalArithOps = (lv Or rv) - (lv And rv)
    End If
End Function

Function LowConstEvalShiftPow(op As Long, lv As Long, rv As Long) As Long
    Dim acc As Long
    LowConstEvalShiftPow = -1
    If op = BOP_SHL Then
        If rv >= 0 And rv < 32 Then
            acc = lv
            While rv > 0
                acc = acc * 2
                rv = rv - 1
            Wend
            LowConstEvalShiftPow = acc
        End If
    ElseIf op = BOP_SHR Then
        If rv >= 0 And rv < 32 Then
            acc = lv
            While rv > 0
                acc = acc \ 2
                rv = rv - 1
            Wend
            LowConstEvalShiftPow = acc
        End If
    ElseIf op = BOP_POW Then
        If rv >= 0 Then
            acc = 1
            While rv > 0
                acc = acc * lv
                rv = rv - 1
            Wend
            LowConstEvalShiftPow = acc
        End If
    End If
End Function

Function LowConstEvalBin(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim lv As Long
    Dim rv As Long
    Dim op As Long
    Dim leftIdx As Long
    Dim rightIdx As Long

    LowConstEvalBin = -1
    ast = ctx->ast
    nodes = ast->nodes
    op = nodes[idx].num
    leftIdx = nodes[idx].left
    rightIdx = nodes[idx].right
    If leftIdx < 0 Or rightIdx < 0 Then Exit Function
    lv = LowConstEval(ctx, leftIdx)
    If lv < 0 Then Exit Function
    rv = LowConstEval(ctx, rightIdx)
    If rv < 0 Then Exit Function
    If op = BOP_SHL Or op = BOP_SHR Or op = BOP_POW Then
        LowConstEvalBin = LowConstEvalShiftPow(op, lv, rv)
    Else
        LowConstEvalBin = LowConstEvalArithOps(op, lv, rv)
    End If
End Function

Function LowConstEval(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim ci As Long
    Dim vals As *Long
    Dim lv As Long

    LowConstEval = -1
    If idx < 0 Then Exit Function
    ast = ctx->ast
    nodes = ast->nodes
    If nodes[idx].kind = AST_NUM Then
        LowConstEval = nodes[idx].num
    ElseIf nodes[idx].kind = AST_VAR Then
        AstCopyStr(ast, idx, VarPtr(name))
        ci = LowFindConst(ctx, VarPtr(name))
        If ci < 0 Then Exit Function
        vals = ctx->constVals
        LowConstEval = vals[ci]
    ElseIf nodes[idx].kind = AST_BINOP Then
        LowConstEval = LowConstEvalBin(ctx, idx)
    ElseIf nodes[idx].kind = AST_BUILTIN Then
        If nodes[idx].num = BIK_ELM Then
            lv = LowConstEval(ctx, nodes[idx].left)
            If lv >= 0 Then
                LowConstEval = lv - 1
            End If
        End If
    End If
End Function

Function LowNewLabel(ctx As *LowerCtx) As Long
    Dim id As Long
    id = ctx->nextLab
    ctx->nextLab = id + 1
    LowNewLabel = id
End Function
