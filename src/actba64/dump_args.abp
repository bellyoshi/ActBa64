#console
#include "ByteCharUtils.abp"
#include "ByteStringUtils.abp"
#include "Utils.abp"
Sub Dump(n As Long)
    Dim arg[260] As Byte
    Dim i As Long
    If GetCmd(n, arg) = 0 Then
        Print n; "=none"
        Exit Sub
    End If
    Print n; "=";
    i = 0
    While arg[i] <> 0 And i < 200
        Print Chr$(arg[i]);
        i = i + 1
    Wend
    Print ""
End Sub
Sub Main()
    Dim n As Long
    n = 0
    While n < 6
        Dump(n)
        n = n + 1
    Wend
End Sub
Main()
End
