' ParserClassField - フィールドとクラス本体

' 戻り値 true : 正常終了  false : エラーあり
Function ParseFieldTypeSize(p As *Parser, types As *TypeTable, ByRef sz As Long, ByRef fieldTy As Long) As boolean
    Dim tname(SYM_NAME_LEN - 1) As Byte

    ParseFieldTypeSize = false
    fieldTy = -1
    If ParseTokKind(p) = TK_STAR Then
        p->pos = p->pos + 1
        If Not ParseCopyIdent(p, VarPtr(tname)) Then
            p->err = 1
            Exit Function
        End If
        sz = TyPtrSize()
        fieldTy = TyPtrFieldTag(VarPtr(tname))
    Else
        If Not ParseCopyIdent(p, VarPtr(tname)) Then
            p->err = 1
            Exit Function
        End If
        sz = TySizeOfName(types, VarPtr(tname))
        If sz <= 0 Then
            p->err = 1
            Exit Function
        End If
        fieldTy = TyFind(types, VarPtr(tname))
    End If
    ParseFieldTypeSize = true
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function ParseClassField(p As *Parser, ti As Long) As boolean
    Dim fname(SYM_NAME_LEN - 1) As Byte
    Dim kAs(KW_SHORT_LEN - 1) As Byte
    Dim count As Long
    Dim sz As Long
    Dim fieldTy As Long
    Dim types As *TypeTable
    Dim ast As *Ast

    ParseClassField = false
    ast = p->ast
    types = ast->types
    lstrcpy(VarPtr(kAs), "as")
    If Not ParseCopyIdent(p, VarPtr(fname)) Then
        p->err = 1
        Exit Function
    End If
    count = 1
    If ParseTokKind(p) = TK_LPAREN Then
        p->pos = p->pos + 1
        If ParseTokKind(p) <> TK_NUMBER Then
            p->err = 1
            Exit Function
        End If
        count = ParseTokNum(p) + 1
        p->pos = p->pos + 1
        If Not ParseExpect(p, TK_RPAREN) Then Exit Function
    End If
    If ParseIdentIs(p, VarPtr(kAs)) = 0 Then
        p->err = 1
        Exit Function
    End If
    p->pos = p->pos + 1
    If Not ParseFieldTypeSize(p, types, sz, fieldTy) Then Exit Function
    If Not TyAddField(types, ti, VarPtr(fname), sz, count, fieldTy) Then
        p->err = 1
        Exit Function
    End If
    ParseClassField = true
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function ParseClassEnsureCd(p As *Parser, name As *Byte, hasCtor As Long, hasDtor As Long, ByRef nPrev As Long) As boolean
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim mangled(MANGLED_LEN - 1) As Byte
    Dim nMeth As Long

    ParseClassEnsureCd = false
    ast = p->ast
    If hasCtor = 0 Then
        lstrcpy(VarPtr(mangled), name)
        lstrcat(VarPtr(mangled), "_Ctor")
        nMeth = ParseMakeEmptyClassFunc(p, VarPtr(mangled), 1)
        If nMeth < 0 Then Exit Function
        nodes = ast->nodes
        nodes[nPrev].nxt = nMeth
        nPrev = nMeth
    End If
    If hasDtor = 0 Then
        lstrcpy(VarPtr(mangled), name)
        lstrcat(VarPtr(mangled), "_Dtor")
        nMeth = ParseMakeEmptyClassFunc(p, VarPtr(mangled), 1)
        If nMeth < 0 Then Exit Function
        nodes = ast->nodes
        nodes[nPrev].nxt = nMeth
    End If
    ParseClassEnsureCd = true
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function ParseClassBodyItem(p As *Parser, ast As *Ast, name As *Byte, ti As Long, ByRef nPrev As Long, ByRef hasCtor As Long, ByRef hasDtor As Long, ByRef isIface As Long) As boolean
    Dim nodes As *AstNode
    Dim kPriv(KW_LEN - 1) As Byte
    Dim kPub(KW_LEN - 1) As Byte
    Dim kProt(KW_LEN - 1) As Byte
    Dim kVirt(KW_LEN - 1) As Byte
    Dim kSub(KW_SHORT_LEN - 1) As Byte
    Dim kFun(KW_LEN - 1) As Byte
    Dim nMeth As Long
    Dim isCtor As Long
    Dim isDtor As Long
    Dim access As Long

    ParseClassBodyItem = false
    lstrcpy(VarPtr(kPriv), "private")
    lstrcpy(VarPtr(kPub), "public")
    lstrcpy(VarPtr(kProt), "protected")
    lstrcpy(VarPtr(kVirt), "virtual")
    lstrcpy(VarPtr(kSub), "sub")
    lstrcpy(VarPtr(kFun), "function")
    If ParseIdentIs(p, VarPtr(kPriv)) <> 0 Then
        p->pos = p->pos + 1
        access = 0
    ElseIf ParseIdentIs(p, VarPtr(kPub)) <> 0 Then
        p->pos = p->pos + 1
        access = 1
    ElseIf ParseIdentIs(p, VarPtr(kProt)) <> 0 Then
        p->pos = p->pos + 1
        access = 1
    ElseIf ParseIdentIs(p, VarPtr(kVirt)) <> 0 Then
        p->pos = p->pos + 1
        If Not ParseClassVirtDecl(p) Then Exit Function
        isIface = 1
    ElseIf ParseIdentIs(p, VarPtr(kSub)) <> 0 Or ParseIdentIs(p, VarPtr(kFun)) <> 0 Then
        nMeth = ParseClassMethod(p, name, isCtor, isDtor)
        If nMeth < 0 Then Exit Function
        If isCtor <> 0 Then hasCtor = 1
        If isDtor <> 0 Then hasDtor = 1
        nodes = ast->nodes
        nodes[nPrev].nxt = nMeth
        nPrev = nMeth
        While nodes[nPrev].nxt >= 0
            nPrev = nodes[nPrev].nxt
        Wend
    Else
        If Not ParseClassField(p, ti) Then Exit Function
    End If
    ParseClassBodyItem = true
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function ParseClassBody(p As *Parser, name As *Byte, ti As Long, ByRef nPrev As Long, ByRef hasCtor As Long, ByRef hasDtor As Long, ByRef isIface As Long) As boolean
    Dim ast As *Ast
    Dim kEnd(KW_SHORT_LEN - 1) As Byte
    Dim kClass(KW_LEN - 1) As Byte

    ParseClassBody = false
    ast = p->ast
    lstrcpy(VarPtr(kEnd), "end")
    lstrcpy(VarPtr(kClass), "class")
    Do
        If ParseIdentIs(p, VarPtr(kEnd)) <> 0 Then
            p->pos = p->pos + 1
            If ParseIdentIs(p, VarPtr(kClass)) = 0 Then
                p->err = 1
                Exit Function
            End If
            p->pos = p->pos + 1
            Exit Do
        End If
        If Not ParseClassBodyItem(p, ast, name, ti, nPrev, hasCtor, hasDtor, isIface) Then Exit Function
    Loop
    ParseClassBody = true
End Function

' 戻り値 true : 正常終了  false : エラーあり
Function ParseClassOpen(p As *Parser, name As *Byte, ByRef ti As Long, ByRef isIface As Long) As boolean
    Dim ast As *Ast
    Dim types As *TypeTable

    ParseClassOpen = false
    p->pos = p->pos + 1
    If Not ParseCopyIdent(p, name) Then Exit Function
    ast = p->ast
    types = ast->types
    ti = TyAdd(types, name)
    If ti < 0 Then
        p->err = 1
        Exit Function
    End If
    If Not TySetClass(types, ti) Then
        p->err = 1
        Exit Function
    End If
    If Not ParseClassInherits(p, ti, isIface) Then Exit Function
    ParseClassOpen = true
End Function

Function ParseClassStmt(p As *Parser) As Long
    Dim ast As *Ast
    Dim types As *TypeTable
    Dim name(SYM_NAME_LEN - 1) As Byte
    Dim ti As Long
    Dim nType As Long
    Dim nFirst As Long
    Dim nPrev As Long
    Dim hasCtor As Long
    Dim hasDtor As Long
    Dim isIface As Long

    ParseClassStmt = -1
    If Not ParseClassOpen(p, VarPtr(name), ti, isIface) Then Exit Function
    ast = p->ast
    types = ast->types
    hasCtor = 0
    hasDtor = 0
    nFirst = -1
    nPrev = -1
    p->classTypeIdx = ti

    nType = AstAddNode(ast, AST_TYPE)
    If nType < 0 Then Exit Function
    AstSetStr(ast, nType, VarPtr(name))
    nFirst = nType
    nPrev = nType
    If Not ParseClassBody(p, VarPtr(name), ti, nPrev, hasCtor, hasDtor, isIface) Then Exit Function

    ' COM インターフェース（Virtual のみ）は空 ctor/dtor を付けない
    If isIface = 0 Then
        If Not ParseClassEnsureCd(p, VarPtr(name), hasCtor, hasDtor, nPrev) Then Exit Function
    End If

    TyFinalizeType(types, ti)
    p->classTypeIdx = -1
    ParseClassStmt = nFirst
End Function
