' AstLowerCall - 呼び出しシーケンスとヒープ

' HeapAlloc dwFlags（AB4.20 組込 HEAP_ZERO_MEMORY と名前衝突するため別名）
Const LOW_HEAP_ZERO = 8
' Microsoft x64: 先頭4引数の shadow / スロット幅 / スタック整列
Const ABI_SHADOW = 32
Const ABI_SLOT = 8
Const ABI_ALIGN = 16
' 第5引数以降の [rbp+…]（shadow の次）
Const ABI_STACK_ARG0 = 48

Function LowAlign16(n As Long) As Long
    LowAlign16 = (n + ABI_ALIGN - 1) And (0 - ABI_ALIGN)
End Function

Function LowCallBytes(nArgs As Long) As Long
    Dim callBytes As Long
    If TyIs32() <> 0 Then
        LowCallBytes = nArgs * 4
        Exit Function
    End If
    callBytes = ABI_SHADOW
    If nArgs > 4 Then
        callBytes = callBytes + (nArgs - 4) * ABI_SLOT
    End If
    LowCallBytes = (callBytes + ABI_ALIGN - 1) And (0 - ABI_ALIGN)
End Function

Sub LowEmitLoadRegArgs(list As *IrList, nArgs As Long)
    Dim ps As Long
    If TyIs32() <> 0 Then Exit Sub
    ps = ABI_SLOT
    If nArgs >= 4 Then
        IrEmit(list, OP_LOAD_RSP_RAX, 3 * ps, 0)
        IrEmit(list, OP_MOV_R9_RAX, 0, 0)
    End If
    If nArgs >= 3 Then
        IrEmit(list, OP_LOAD_RSP_RAX, 2 * ps, 0)
        IrEmit(list, OP_MOV_R8_RAX, 0, 0)
    End If
    If nArgs >= 2 Then
        IrEmit(list, OP_LOAD_RSP_RAX, 1 * ps, 0)
        IrEmit(list, OP_MOV_RDX_RAX, 0, 0)
    End If
    If nArgs >= 1 Then
        IrEmit(list, OP_LOAD_RSP_RAX, 0, 0)
        IrEmit(list, OP_MOV_RCX_RAX, 0, 0)
    End If
End Sub

Sub LowEmitCallFinish(list As *IrList, callBytes As Long)
    If TyIs32() <> 0 Then Exit Sub
    If callBytes <= 0 Then Exit Sub
    IrEmit(list, OP_ADD_RSP, callBytes, 0)
End Sub

' rax already holds arg0
Sub LowEmitCall1Rax(list As *IrList, isApi As Long, dllKind As Long, apiName As *Byte, lab As Long)
    Dim callBytes As Long
    callBytes = LowCallBytes(1)
    If callBytes > 0 Then
        IrEmit(list, OP_SUB_RSP, callBytes, 0)
    End If
    IrEmit(list, OP_STORE_RSP_RAX, 0, 0)
    LowEmitLoadRegArgs(list, 1)
    If isApi <> 0 Then
        IrEmitStr(list, OP_CALL_API, dllKind, apiName)
    Else
        IrEmit(list, OP_CALL_LAB, lab, 0)
    End If
    LowEmitCallFinish(list, callBytes)
End Sub

' 評価済みの Double を StrD$ へ。32bit は edx:eax を 8 バイトで渡す。
Function LowStrDLab(ctx As *LowerCtx) As Long
    Dim name(SYM_NAME_LEN - 1) As Byte
    lstrcpy(VarPtr(name), "StrD$")
    LowStrDLab = LowFindFunc(ctx, VarPtr(name))
    If LowStrDLab >= 0 Then Exit Function
    Print "error: missing 'StrD$' (Include\default\DoubleStr.abp)"
    ctx->err = 1
End Function

Sub LowEmitCallStrD(list As *IrList, lab As Long)
    If TyIs32() = 0 Then
        LowEmitCall1Rax(list, 0, 0, 0, lab)
        Exit Sub
    End If
    IrEmit(list, OP_SUB_RSP, 8, 0)
    IrEmit(list, OP_STORE_RSP_DBL, 0, 0)
    IrEmit(list, OP_CALL_LAB, lab, 0)
End Sub

Function LowEmitExprStrD(ctx As *LowerCtx, exprIdx As Long) As boolean
    Dim lab As Long
    lab = LowStrDLab(ctx)
    LowEmitExprStrD = false
    If lab < 0 Then Exit Function
    If LowExpr(ctx, exprIdx) = 0 Then Exit Function
    LowEmitCallStrD(ctx->list, lab)
    LowEmitExprStrD = true
End Function

' 32bit stdcall: ecx=arg0, edx=arg1 をスタックへ積んで呼ぶ。64bit は既に rcx/rdx。
Sub LowEmitCallLab2(list As *IrList, lab As Long)
    Dim callBytes As Long
    If TyIs32() <> 0 Then
        IrEmit(list, OP_MOV_EAX_EDX, 0, 0)
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        IrEmit(list, OP_CALL_LAB, lab, 0)
        Exit Sub
    End If
    callBytes = LowCallBytes(2)
    If callBytes > 0 Then
        IrEmit(list, OP_SUB_RSP, callBytes, 0)
    End If
    IrEmit(list, OP_CALL_LAB, lab, 0)
    LowEmitCallFinish(list, callBytes)
End Sub

' 32bit stdcall: ecx=arg0, edx=arg1, eax=arg2。64bit は rcx/rdx/r8。
Sub LowEmitCallLab3(list As *IrList, lab As Long)
    Dim callBytes As Long
    If TyIs32() <> 0 Then
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        IrEmit(list, OP_MOV_EAX_EDX, 0, 0)
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
        IrEmit(list, OP_PUSH_RAX, 0, 0)
        IrEmit(list, OP_CALL_LAB, lab, 0)
        Exit Sub
    End If
    callBytes = LowCallBytes(3)
    If callBytes > 0 Then
        IrEmit(list, OP_SUB_RSP, callBytes, 0)
    End If
    IrEmit(list, OP_CALL_LAB, lab, 0)
    LowEmitCallFinish(list, callBytes)
End Sub

Sub LowEmitApiImm1(list As *IrList, dllKind As Long, apiName As *Byte, imm As DWord)
    Dim callBytes As Long
    callBytes = LowCallBytes(1)
    If callBytes > 0 Then
        IrEmit(list, OP_SUB_RSP, callBytes, 0)
    End If
    IrEmit(list, OP_MOV_EAX_IMM, imm, 0)
    IrEmit(list, OP_STORE_RSP_RAX, 0, 0)
    LowEmitLoadRegArgs(list, 1)
    IrEmitStr(list, OP_CALL_API, dllKind, apiName)
    LowEmitCallFinish(list, callBytes)
End Sub

Sub LowEmitCaptureArg0(list As *IrList, disp As Long)
    If TyIs32() <> 0 Then
        IrEmit(list, OP_LOAD_LOCAL, 8, 0)
        IrEmit(list, OP_STORE_LOCAL, disp, 0)
    Else
        IrEmit(list, OP_STORE_LOCAL_ECX, disp, 0)
    End If
End Sub

Sub LowEmitCaptureArg1(list As *IrList, disp As Long)
    If TyIs32() <> 0 Then
        IrEmit(list, OP_LOAD_LOCAL, 12, 0)
        IrEmit(list, OP_STORE_LOCAL, disp, 0)
    Else
        IrEmit(list, OP_STORE_LOCAL_EDX, disp, 0)
    End If
End Sub

Sub LowEmitCaptureArg2(list As *IrList, disp As Long)
    If TyIs32() <> 0 Then
        IrEmit(list, OP_LOAD_LOCAL, 16, 0)
        IrEmit(list, OP_STORE_LOCAL, disp, 0)
    Else
        IrEmit(list, OP_MOV_RAX_R8, 0, 0)
        IrEmit(list, OP_STORE_LOCAL, disp, 0)
    End If
End Sub

Sub LowEmitLeaveBytes(list As *IrList, nbytes As Long)
    Dim n As Long
    n = 0
    If TyIs32() <> 0 Then n = nbytes
    IrEmit(list, OP_LEAVE, n, 0)
End Sub

Sub LowEmitLeave(list As *IrList, leaveArgCount As Long)
    LowEmitLeaveBytes(list, leaveArgCount * 4)
End Sub

Function LowParamBytes(ty As Long, isByRef As Long) As Long
    LowParamBytes = 4
    If isByRef <> 0 Then Exit Function
    If ty = TY_DOUBLE Then LowParamBytes = 8
End Function

Sub LowEmitPushOperand(list As *IrList, fty As Long)
    If fty = TY_DOUBLE And TyIs32() <> 0 Then
        IrEmit(list, OP_PUSH_DBL, 0, 0)
        Exit Sub
    End If
    IrEmit(list, OP_PUSH_RAX, 0, 0)
End Sub

Sub LowEmitPopOperand(list As *IrList, fty As Long)
    If fty = TY_DOUBLE And TyIs32() <> 0 Then Exit Sub
    IrEmit(list, OP_POP_RCX, 0, 0)
End Sub

Sub LowEmitScalePtr(list As *IrList)
    If TyIs32() <> 0 Then
        IrEmit(list, OP_SHL_ECX_2, 0, 0)
    Else
        IrEmit(list, OP_SHL_ECX_3, 0, 0)
    End If
End Sub

Sub LowEmitExitEax(ctx As *LowerCtx)
    Dim sExit(KW_LEN - 1) As Byte
    lstrcpy(VarPtr(sExit), "ExitProcess")
    LowEmitCall1Rax(ctx->list, 1, IR_DLL_KERNEL32, VarPtr(sExit), 0)
End Sub

Sub LowEmitExitImm(ctx As *LowerCtx, code As DWord)
    Dim sExit(KW_LEN - 1) As Byte
    lstrcpy(VarPtr(sExit), "ExitProcess")
    IrEmit(ctx->list, OP_MOV_EAX_IMM, code, 0)
    LowEmitCall1Rax(ctx->list, 1, IR_DLL_KERNEL32, VarPtr(sExit), 0)
End Sub

' Nested API call. 64-bit allocates shadow space; 32-bit stdcall uses regs already set via stack in emit32.
Sub LowEmitApiCallShadow(list As *IrList, dllKind As Long, apiName As *Byte)
    Dim callBytes As Long
    callBytes = LowCallBytes(0)
    If callBytes > 0 Then
        IrEmit(list, OP_SUB_RSP, callBytes, 0)
    End If
    IrEmitStr(list, OP_CALL_API, dllKind, apiName)
    LowEmitCallFinish(list, callBytes)
End Sub

' rax = byte count; HeapAlloc(GetProcessHeap(), flags, rax)
Sub LowEmitHeapAllocRax(list As *IrList, flags As DWord)
    Dim callBytes As Long
    Dim sApi(KW_LEN - 1) As Byte
    Dim ps As Long
    ps = TyPtrSize()
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    lstrcpy(VarPtr(sApi), "GetProcessHeap")
    LowEmitApiCallShadow(list, IR_DLL_KERNEL32, VarPtr(sApi))
    callBytes = LowCallBytes(3)
    If callBytes > 0 Then
        IrEmit(list, OP_SUB_RSP, callBytes, 0)
    End If
    IrEmit(list, OP_STORE_RSP_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, flags, 0)
    IrEmit(list, OP_STORE_RSP_RAX, ps, 0)
    IrEmit(list, OP_LOAD_RSP_RAX, callBytes, 0)
    IrEmit(list, OP_STORE_RSP_RAX, ps + ps, 0)
    LowEmitLoadRegArgs(list, 3)
    lstrcpy(VarPtr(sApi), "HeapAlloc")
    IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sApi))
    LowEmitCallFinish(list, callBytes)
    IrEmit(list, OP_POP_RCX, 0, 0)
End Sub

' rax = block; HeapFree(GetProcessHeap(), 0, rax)
Sub LowEmitHeapFreeRax(list As *IrList)
    Dim callBytes As Long
    Dim sApi(KW_LEN - 1) As Byte
    Dim ps As Long
    ps = TyPtrSize()
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    lstrcpy(VarPtr(sApi), "GetProcessHeap")
    LowEmitApiCallShadow(list, IR_DLL_KERNEL32, VarPtr(sApi))
    callBytes = LowCallBytes(3)
    If callBytes > 0 Then
        IrEmit(list, OP_SUB_RSP, callBytes, 0)
    End If
    IrEmit(list, OP_STORE_RSP_RAX, 0, 0)
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_STORE_RSP_RAX, ps, 0)
    IrEmit(list, OP_LOAD_RSP_RAX, callBytes, 0)
    IrEmit(list, OP_STORE_RSP_RAX, ps + ps, 0)
    LowEmitLoadRegArgs(list, 3)
    lstrcpy(VarPtr(sApi), "HeapFree")
    IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sApi))
    LowEmitCallFinish(list, callBytes)
    IrEmit(list, OP_POP_RCX, 0, 0)
End Sub

' rax = heap。フレームを開き、引数0=heap 引数1=0
Sub LowEmitReallocHeap(list As *IrList, callBytes As Long)
    Dim ps As Long
    ps = TyPtrSize()
    If callBytes > 0 Then IrEmit(list, OP_SUB_RSP, callBytes, 0)
    IrEmit(list, OP_STORE_RSP_RAX, 0, 0)
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_STORE_RSP_RAX, ps, 0)
End Sub

' スタック上の [size][ptr] を引数2・3へ。ptr が深い
Sub LowEmitReallocArgs(list As *IrList, callBytes As Long)
    Dim ps As Long
    ps = TyPtrSize()
    IrEmit(list, OP_LOAD_RSP_RAX, callBytes + ps, 0)
    IrEmit(list, OP_STORE_RSP_RAX, ps + ps, 0)
    IrEmit(list, OP_LOAD_RSP_RAX, callBytes, 0)
    IrEmit(list, OP_STORE_RSP_RAX, ps + ps + ps, 0)
    LowEmitLoadRegArgs(list, 4)
End Sub

Sub LowEmitHeapReAllocCall(list As *IrList, callBytes As Long)
    Dim sApi(KW_LEN - 1) As Byte
    lstrcpy(VarPtr(sApi), "HeapReAlloc")
    IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sApi))
    LowEmitCallFinish(list, callBytes)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
End Sub

' 呼び出し前のスタックは [size][ptr]（ptr が深い）。戻り値は rax
Sub LowEmitHeapReAlloc(list As *IrList)
    Dim callBytes As Long
    Dim sApi(KW_LEN - 1) As Byte
    lstrcpy(VarPtr(sApi), "GetProcessHeap")
    LowEmitApiCallShadow(list, IR_DLL_KERNEL32, VarPtr(sApi))
    callBytes = LowCallBytes(4)
    LowEmitReallocHeap(list, callBytes)
    LowEmitReallocArgs(list, callBytes)
    LowEmitHeapReAllocCall(list, callBytes)
End Sub

Function LowExprReallocOk(ctx As *LowerCtx, idx As Long) As Long
    Dim n As Long
    n = LowCountCallArgs(ctx, idx, 0)
    LowExprReallocOk = 0
    If n = 2 Then LowExprReallocOk = 1
    If n <> 2 Then ctx->err = 1
End Function

Function LowReallocArg0(ctx As *LowerCtx, idx As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim a0 As Long
    ast = ctx->ast
    nodes = ast->nodes
    a0 = nodes[idx].left
    LowReallocArg0 = a0
End Function

Function LowReallocArg1(ctx As *LowerCtx, a0 As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    Dim a1 As Long
    ast = ctx->ast
    nodes = ast->nodes
    a1 = nodes[a0].nxt
    LowReallocArg1 = a1
End Function

Function LowExprPushArg(ctx As *LowerCtx, argNode As Long) As Long
    Dim nodes As *AstNode
    Dim ast As *Ast
    ast = ctx->ast
    nodes = ast->nodes
    LowExprPushArg = 0
    If LowExpr(ctx, nodes[argNode].left) = 0 Then Exit Function
    IrEmit(ctx->list, OP_PUSH_RAX, 0, 0)
    LowExprPushArg = 1
End Function

Function LowExprPush2(ctx As *LowerCtx, a0 As Long) As Long
    Dim a1 As Long
    LowExprPush2 = 0
    a1 = LowReallocArg1(ctx, a0)
    If LowExprPushArg(ctx, a0) = 0 Then Exit Function
    If LowExprPushArg(ctx, a1) = 0 Then Exit Function
    LowExprPush2 = 1
End Function

Function LowExprCallRealloc(ctx As *LowerCtx, idx As Long) As Long
    Dim a0 As Long
    LowExprCallRealloc = 0
    If LowExprReallocOk(ctx, idx) = 0 Then Exit Function
    a0 = LowReallocArg0(ctx, idx)
    If LowExprPush2(ctx, a0) = 0 Then Exit Function
    LowEmitHeapReAlloc(ctx->list)
    LowExprCallRealloc = 1
End Function
