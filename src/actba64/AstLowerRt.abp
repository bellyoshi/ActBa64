' ===================================================
'  AstLowerRt - string runtime helpers
' ===================================================

Function LowEnsureRtStrCollect(ctx As *LowerCtx) As Long
    If g_rtStrHeapAllocLab < 0 Then
        g_rtStrHeapAllocLab = LowNewLab(ctx)
    End If
    If g_rtStrGcPreciseLab < 0 Then
        g_rtStrGcPreciseLab = LowNewLab(ctx)
    End If
    If g_rtStrGcConsLab < 0 Then
        g_rtStrGcConsLab = LowNewLab(ctx)
    End If
    If g_rtStrCollectLab < 0 Then
        g_rtStrCollectLab = LowNewLab(ctx)
    End If
    LowEnsureRtStrCollect = g_rtStrCollectLab
End Function

Sub LowEmitCallStrHeapAlloc(ctx As *LowerCtx)
    LowEnsureRtStrCollect(ctx)
    LowEmitCall1Rax(ctx->list, 0, 0, 0, g_rtStrHeapAllocLab)
End Sub

Sub LowEmitPreciseLocalMarks(ctx As *LowerCtx)
    Dim i As Long
    Dim lab As Long
    If g_fnPreciseRootCount <= 0 Then Exit Sub
    lab = g_rtStrGcPreciseLab
    If lab < 0 Then Exit Sub
    i = 0
    While i < g_fnPreciseRootCount
        IrEmit(ctx->list, OP_LOAD_LOCAL, g_fnPreciseRoots[i], 0)
        LowEmitCall1Rax(ctx->list, 0, 0, 0, lab)
        i = i + 1
    Wend
End Sub

Sub LowEmitGcPreciseRootsInit(ctx As *LowerCtx)
    Dim i As Long
    Dim dst As Long
    If g_preciseRootCount <= 0 Then
        IrEmit(ctx->list, OP_XOR_EAX, 0, 0)
        IrEmit(ctx->list, OP_PUSH_RAX, 0, 0)
        IrEmit(ctx->list, OP_LEA_RAX_GLOB, g_gcBaseOff + GC_HDR_PRECISE_COUNT, 0)
        IrEmit(ctx->list, OP_POP_RCX, 0, 0)
        IrEmit(ctx->list, OP_STORE_PTR, 0, 0)
        Exit Sub
    End If
    i = 0
    While i < g_preciseRootCount
        dst = g_gcBaseOff + GC_HDR_PRECISE_ROOTS + i * 4
        IrEmit(ctx->list, OP_MOV_EAX_IMM, g_preciseRoots[i], 0)
        IrEmit(ctx->list, OP_PUSH_RAX, 0, 0)
        IrEmit(ctx->list, OP_LEA_RAX_GLOB, dst, 0)
        IrEmit(ctx->list, OP_POP_RCX, 0, 0)
        IrEmit(ctx->list, OP_STORE_DWORD_RAX_ECX, 0, 0)
        i = i + 1
    Wend
    IrEmit(ctx->list, OP_MOV_EAX_IMM, g_preciseRootCount, 0)
    IrEmit(ctx->list, OP_PUSH_RAX, 0, 0)
    IrEmit(ctx->list, OP_LEA_RAX_GLOB, g_gcBaseOff + GC_HDR_PRECISE_COUNT, 0)
    IrEmit(ctx->list, OP_POP_RCX, 0, 0)
    IrEmit(ctx->list, OP_STORE_PTR, 0, 0)
End Sub

Sub LowEmitStrCollectSafepoint(ctx As *LowerCtx)
    If g_rtStrCollectLab < 0 Then Exit Sub
    LowEmitPreciseLocalMarks(ctx)
    IrEmit(ctx->list, OP_CALL_LAB, g_rtStrCollectLab, 0)
End Sub

' 部分木が String を新たに確保しうるか。
' 再帰しない（関数フレームが ~8KB のため、ElseIf 連鎖や長い文リストでスタックを尽くす）。
Function LowAstNeedsStrGc(ctx As *LowerCtx, idx As Long) As Long
    Dim ast As *Ast
    Dim nodes As *AstNode
    Dim k As Long
    Dim bi As Long
    Dim cur As Long
    Dim sp As Long
    Dim n As Long
    Dim stk(255) As Long

    LowAstNeedsStrGc = 0
    If idx < 0 Then Exit Function
    ast = ctx->ast
    If ast = NULL Then Exit Function
    nodes = ast->nodes
    stk[0] = idx
    sp = 1
    While sp > 0
        sp = sp - 1
        cur = stk[sp]
        While cur >= 0
            k = nodes[cur].kind
            If k = AST_PRINT Or k = AST_INPUT Or k = AST_FINPUT Or k = AST_OPEN Or k = AST_CLOSE Or k = AST_FIELD Or k = AST_GET Or k = AST_PUT Or k = AST_WRITE Then
                LowAstNeedsStrGc = 1
                Exit Function
            End If
            ' 呼び出しは見ない。Hl_MidBytes$ / GetLinePrefix$ も本体の Mid$ は
            ' callee 側にあり、ここで CALL を確保扱いすると描画 While が毎トークン
            ' Collect し、行末の String が conservative 漏れで欠ける。
            ' 引数式の Cat / Mid$ は left を辿って拾う。
            If k = AST_BINOP Then
                If nodes[cur].num = BOP_CAT Then
                    LowAstNeedsStrGc = 1
                    Exit Function
                End If
            End If
            If k = AST_BUILTIN Then
                bi = nodes[cur].num
                If bi = BI_LEFT Or bi = BI_MID Or bi = BI_STR Or bi = BI_MAKESTR Or bi = BI_CHR Or bi = BI_RIGHT Then
                    LowAstNeedsStrGc = 1
                    Exit Function
                End If
            End If
            If k = AST_FOR Then
                n = nodes[cur].num
                If n >= 0 Then
                    If sp >= 255 Then
                        LowAstNeedsStrGc = 1
                        Exit Function
                    End If
                    stk[sp] = n
                    sp = sp + 1
                End If
                n = nodes[cur].strId
                If n >= 0 Then
                    If sp >= 255 Then
                        LowAstNeedsStrGc = 1
                        Exit Function
                    End If
                    stk[sp] = n
                    sp = sp + 1
                End If
            End If
            n = nodes[cur].left
            If n >= 0 Then
                If sp >= 255 Then
                    LowAstNeedsStrGc = 1
                    Exit Function
                End If
                stk[sp] = n
                sp = sp + 1
            End If
            n = nodes[cur].right
            If n >= 0 Then
                If sp >= 255 Then
                    LowAstNeedsStrGc = 1
                    Exit Function
                End If
                stk[sp] = n
                sp = sp + 1
            End If
            n = nodes[cur].extra
            If n >= 0 Then
                If sp >= 255 Then
                    LowAstNeedsStrGc = 1
                    Exit Function
                End If
                stk[sp] = n
                sp = sp + 1
            End If
            cur = nodes[cur].nxt
        Wend
    Wend
End Function

' ループ条件・本体（必要なら第3引数）が確保するときだけセーフポイントを出す。
' MAIN（メッセージループ等）は毎回集める。描画中の入れ子では集めない。
Sub LowMaybeLoopStrCollect(ctx As *LowerCtx, a As Long, b As Long, c As Long)
    If ctx->inFunc = 0 Then
        LowEmitStrCollectSafepoint(ctx)
        Exit Sub
    End If
    If LowAstNeedsStrGc(ctx, a) <> 0 Then
        LowEmitStrCollectSafepoint(ctx)
        Exit Sub
    End If
    If LowAstNeedsStrGc(ctx, b) <> 0 Then
        LowEmitStrCollectSafepoint(ctx)
        Exit Sub
    End If
    If LowAstNeedsStrGc(ctx, c) <> 0 Then
        LowEmitStrCollectSafepoint(ctx)
    End If
End Sub

' eax 書き込みで rax 上位を 0 にする（Long 添字をポインタ加算する前）
Sub LowEmitZxEax(list As *IrList)
    IrEmit(list, OP_AND_EAX_IMM, -1, 0)
End Sub

' rax = String ptr → eax = Len（NULL→0）。[ptr-4] の下位31bit
Sub LowEmitLoadStrLen(list As *IrList, labZ As Long, labE As Long)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JZ, labZ, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -4, 0)
    IrEmit(list, OP_LOAD_DWORD_RAX, 0, 0)
    IrEmit(list, OP_AND_EAX_IMM, 2147483647, 0)
    IrEmit(list, OP_JMP, labE, 0)
    IrEmit(list, OP_LABEL, labZ, 0)
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_LABEL, labE, 0)
End Sub

Sub LowEmitRtCatCopyStr(list As *IrList, srcDisp As Long, lenSrc As Long, labLoop As Long, labDone As Long)
    IrEmit(list, OP_LOAD_LOCAL, lenSrc, 0)
    IrEmit(list, OP_STORE_LOCAL, -40, 0)
    IrEmit(list, OP_LABEL, labLoop, 0)
    IrEmit(list, OP_LOAD_LOCAL, -40, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JZ, labDone, 0)
    IrEmit(list, OP_LOAD_LOCAL, srcDisp, 0)
    IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, srcDisp, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, srcDisp, 0)
    IrEmit(list, OP_LOAD_LOCAL, -56, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_STORE_BYTE_RAX_CL, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -56, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -56, 0)
    IrEmit(list, OP_LOAD_LOCAL, -40, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -1, 0)
    IrEmit(list, OP_STORE_LOCAL, -40, 0)
    IrEmit(list, OP_JMP, labLoop, 0)
    IrEmit(list, OP_LABEL, labDone, 0)
End Sub

Sub LowEmitRtCatBody(ctx As *LowerCtx)
    Dim list As *IrList
    Dim sApi(15) As Byte
    Dim empty(1) As Byte
    Dim labA As Long
    Dim labB As Long
    Dim labCopyA As Long
    Dim labCopyADone As Long
    Dim labCopyB As Long
    Dim labCopyBDone As Long

    If g_rtCatLab < 0 Then Exit Sub
    list = ctx->list
    empty[0] = 0
    labA = LowNewLab(ctx)
    labB = LowNewLab(ctx)
    labCopyA = LowNewLab(ctx)
    labCopyADone = LowNewLab(ctx)
    labCopyB = LowNewLab(ctx)
    labCopyBDone = LowNewLab(ctx)

    ' locals: -8 a, -16 b, -24 la, -32 lb, -40 total, -48 base, -56 dst
    IrEmit(list, OP_LABEL, g_rtCatLab, 0)
    IrEmit(list, OP_ENTER, 80, 0)
    LowEmitCaptureArg0(list, -8)
    LowEmitCaptureArg1(list, -16)

    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JNZ, labA, 0)
    IrEmitStr(list, OP_LEA_RAX_STR, 0, VarPtr(empty))
    IrEmit(list, OP_STORE_LOCAL, -8, 0)
    IrEmit(list, OP_LABEL, labA, 0)

    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JNZ, labB, 0)
    IrEmitStr(list, OP_LEA_RAX_STR, 0, VarPtr(empty))
    IrEmit(list, OP_STORE_LOCAL, -16, 0)
    IrEmit(list, OP_LABEL, labB, 0)

    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -4, 0)
    IrEmit(list, OP_LOAD_DWORD_RAX, 0, 0)
    IrEmit(list, OP_AND_EAX_IMM, 2147483647, 0)
    IrEmit(list, OP_STORE_LOCAL, -24, 0)

    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -4, 0)
    IrEmit(list, OP_LOAD_DWORD_RAX, 0, 0)
    IrEmit(list, OP_AND_EAX_IMM, 2147483647, 0)
    IrEmit(list, OP_STORE_LOCAL, -32, 0)

    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_ADD_EAX_ECX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -40, 0)

    IrEmit(list, OP_LOAD_LOCAL, -40, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 5, 0)
    IrEmit(list, OP_MOV_RCX_RAX, 0, 0)
    LowEmitCallStrHeapAlloc(ctx)
    IrEmit(list, OP_STORE_LOCAL, -48, 0)

    IrEmit(list, OP_LOAD_LOCAL, -40, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_ECX, &H80000000, 0)
    IrEmit(list, OP_POP_RAX, 0, 0)
    IrEmit(list, OP_OR_EAX_ECX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -48, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_STORE_DWORD_RAX_ECX, 0, 0)

    IrEmit(list, OP_LOAD_LOCAL, -48, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 4, 0)
    IrEmit(list, OP_STORE_LOCAL, -56, 0)

    LowEmitRtCatCopyStr(list, -8, -24, labCopyA, labCopyADone)
    LowEmitRtCatCopyStr(list, -16, -32, labCopyB, labCopyBDone)

    IrEmit(list, OP_LOAD_LOCAL, -56, 0)
    IrEmit(list, OP_MOV_ECX, 0, 0)
    IrEmit(list, OP_STORE_BYTE_RAX_CL, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -48, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 4, 0)
    LowEmitLeaveN(list, 2)
End Sub

Sub LowEmitRtMidCalcRem(list As *IrList, labRemOk As Long)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -4, 0)
    IrEmit(list, OP_LOAD_DWORD_RAX, 0, 0)
    IrEmit(list, OP_AND_EAX_IMM, 2147483647, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
    IrEmit(list, OP_SUB_EAX_ECX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -40, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JGE, labRemOk, 0)
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -40, 0)
    IrEmit(list, OP_LABEL, labRemOk, 0)
End Sub

Sub LowEmitRtMidClampCount(list As *IrList, labUseRem As Long, labCountOk As Long, labCountDone As Long)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JL, labUseRem, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -40, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JLE, labCountOk, 0)
    IrEmit(list, OP_LABEL, labUseRem, 0)
    IrEmit(list, OP_LOAD_LOCAL, -40, 0)
    IrEmit(list, OP_STORE_LOCAL, -24, 0)
    IrEmit(list, OP_JMP, labCountDone, 0)
    IrEmit(list, OP_LABEL, labCountOk, 0)
    IrEmit(list, OP_LABEL, labCountDone, 0)
End Sub

Sub LowEmitRtMidCopyLoop(list As *IrList, labLoop As Long, labEnd As Long)
    IrEmit(list, OP_LABEL, labLoop, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JZ, labEnd, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -8, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_STORE_BYTE_RAX_CL, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -32, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -1, 0)
    IrEmit(list, OP_STORE_LOCAL, -24, 0)
    IrEmit(list, OP_JMP, labLoop, 0)
End Sub

Sub LowEmitRtMidBody(ctx As *LowerCtx)
    Dim list As *IrList
    Dim sApi(15) As Byte
    Dim empty(1) As Byte
    Dim labS As Long
    Dim labStartOk As Long
    Dim labRemOk As Long
    Dim labUseRem As Long
    Dim labCountOk As Long
    Dim labCountDone As Long
    Dim labLoop As Long
    Dim labEnd As Long

    If g_rtMidLab < 0 Then Exit Sub
    list = ctx->list
    empty[0] = 0
    labS = LowNewLab(ctx)
    labStartOk = LowNewLab(ctx)
    labRemOk = LowNewLab(ctx)
    labUseRem = LowNewLab(ctx)
    labCountOk = LowNewLab(ctx)
    labCountDone = LowNewLab(ctx)
    labLoop = LowNewLab(ctx)
    labEnd = LowNewLab(ctx)

    ' rcx=s, rdx=start1, r8=count
    IrEmit(list, OP_LABEL, g_rtMidLab, 0)
    IrEmit(list, OP_ENTER, 80, 0)
    LowEmitCaptureArg0(list, -8)
    LowEmitCaptureArg1(list, -16)
    LowEmitCaptureArg2(list, -24)

    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JNZ, labS, 0)
    IrEmitStr(list, OP_LEA_RAX_STR, 0, VarPtr(empty))
    IrEmit(list, OP_STORE_LOCAL, -8, 0)
    IrEmit(list, OP_LABEL, labS, 0)

    ' start0 = start1 - 1; if start0 < 0 then 0
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -1, 0)
    IrEmit(list, OP_STORE_LOCAL, -16, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JGE, labStartOk, 0)
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -16, 0)
    IrEmit(list, OP_LABEL, labStartOk, 0)

    LowEmitRtMidCalcRem(list, labRemOk)
    LowEmitRtMidClampCount(list, labUseRem, labCountOk, labCountDone)

    ' src = s + start0
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -8, 0)

    ' dst = HeapAlloc(count+5); [base]=count; return base+4
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 5, 0)
    IrEmit(list, OP_MOV_RCX_RAX, 0, 0)
    LowEmitCallStrHeapAlloc(ctx)
    IrEmit(list, OP_STORE_LOCAL, -48, 0)

    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_ECX, &H80000000, 0)
    IrEmit(list, OP_POP_RAX, 0, 0)
    IrEmit(list, OP_OR_EAX_ECX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -48, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_STORE_DWORD_RAX_ECX, 0, 0)

    IrEmit(list, OP_LOAD_LOCAL, -48, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 4, 0)
    IrEmit(list, OP_STORE_LOCAL, -32, 0)

    LowEmitRtMidCopyLoop(list, labLoop, labEnd)

    IrEmit(list, OP_LABEL, labEnd, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_MOV_ECX, 0, 0)
    IrEmit(list, OP_STORE_BYTE_RAX_CL, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -48, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 4, 0)
    LowEmitLeaveN(list, 3)
End Sub

Sub LowEmitRtStrBody(ctx As *LowerCtx)
    Dim list As *IrList
    Dim sApi(15) As Byte
    Dim labPos As Long
    Dim labDig As Long
    Dim labDigDone As Long
    Dim labNoSign As Long
    Dim labNeg As Long

    If g_rtStrLab < 0 Then Exit Sub
    list = ctx->list
    labPos = LowNewLab(ctx)
    labDig = LowNewLab(ctx)
    labDigDone = LowNewLab(ctx)
    labNoSign = LowNewLab(ctx)
    labNeg = LowNewLab(ctx)

    ' rcx = n
    IrEmit(list, OP_LABEL, g_rtStrLab, 0)
    IrEmit(list, OP_ENTER, 64, 0)
    LowEmitCaptureArg0(list, -8)

    IrEmit(list, OP_MOV_EAX_IMM, 20, 0)
    IrEmit(list, OP_MOV_RCX_RAX, 0, 0)
    LowEmitCallStrHeapAlloc(ctx)
    IrEmit(list, OP_STORE_LOCAL, -16, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 19, 0)
    IrEmit(list, OP_MOV_ECX, 0, 0)
    IrEmit(list, OP_STORE_BYTE_RAX_CL, 0, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -1, 0)
    IrEmit(list, OP_STORE_LOCAL, -24, 0)

    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JGE, labPos, 0)
    ' neg: n = -n, flag=1
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_NEG_EAX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -8, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -32, 0)
    IrEmit(list, OP_JMP, labDig, 0)
    IrEmit(list, OP_LABEL, labPos, 0)
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -32, 0)

    IrEmit(list, OP_LABEL, labDig, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_MOV_ECX, 10, 0)
    IrEmit(list, OP_XOR_EDX, 0, 0)
    IrEmit(list, OP_DIV_ECX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -8, 0)
    IrEmit(list, OP_MOV_EAX_EDX, 0, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 48, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_STORE_BYTE_RAX_CL, 0, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -1, 0)
    IrEmit(list, OP_STORE_LOCAL, -24, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JNZ, labDig, 0)

    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JZ, labNoSign, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_MOV_ECX, 45, 0)
    IrEmit(list, OP_STORE_BYTE_RAX_CL, 0, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -1, 0)
    IrEmit(list, OP_STORE_LOCAL, -24, 0)

    IrEmit(list, OP_LABEL, labNoSign, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -32, 0)
    ' len = (base + 19) - start; store at start-4
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 19, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
    IrEmit(list, OP_SUB_EAX_ECX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_ECX, &H80000000, 0)
    IrEmit(list, OP_POP_RAX, 0, 0)
    IrEmit(list, OP_OR_EAX_ECX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -4, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_STORE_DWORD_RAX_ECX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    LowEmitLeaveN(list, 1)
End Sub

' Print s ― stdout + CRLF (rcx = s)
Sub LowEmitRtPrintBody(ctx As *LowerCtx)
    Dim list As *IrList
    Dim sApi(15) As Byte
    Dim crlf(3) As Byte
    Dim labNl As Long
    Dim stk As Long

    If g_rtPrintLab < 0 Then Exit Sub
    list = ctx->list
    crlf[0] = 13
    crlf[1] = 10
    crlf[2] = 0
    labNl = LowNewLab(ctx)

    IrEmit(list, OP_LABEL, g_rtPrintLab, 0)
    IrEmit(list, OP_ENTER, 64, 0)
    LowEmitCaptureArg0(list, -8)

    lstrcpy(VarPtr(sApi), "GetStdHandle")
    LowEmitApiImm1(list, IR_DLL_KERNEL32, VarPtr(sApi), &HFFFFFFF5)
    IrEmit(list, OP_STORE_LOCAL, -16, 0)

    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JZ, labNl, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -4, 0)
    IrEmit(list, OP_LOAD_DWORD_RAX, 0, 0)
    IrEmit(list, OP_AND_EAX_IMM, 2147483647, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JZ, labNl, 0)
    IrEmit(list, OP_STORE_LOCAL, -24, 0)

    stk = LowCallStk(5)
    If stk > 0 Then
        IrEmit(list, OP_SUB_RSP, stk, 0)
    End If
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_STORE_RSP_RAX, 4 * TyPtrSize(), 0)
    IrEmit(list, OP_LEA_LOCAL, -32, 0)
    IrEmit(list, OP_STORE_RSP_RAX, 3 * TyPtrSize(), 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_STORE_RSP_RAX, 2 * TyPtrSize(), 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_STORE_RSP_RAX, 1 * TyPtrSize(), 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_STORE_RSP_RAX, 0, 0)
    LowEmitLoadRegArgs(list, 5)
    lstrcpy(VarPtr(sApi), "WriteFile")
    IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sApi))
    LowEmitCallFinish(list, stk)

    IrEmit(list, OP_LABEL, labNl, 0)
    stk = LowCallStk(5)
    If stk > 0 Then
        IrEmit(list, OP_SUB_RSP, stk, 0)
    End If
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_STORE_RSP_RAX, 4 * TyPtrSize(), 0)
    IrEmit(list, OP_LEA_LOCAL, -32, 0)
    IrEmit(list, OP_STORE_RSP_RAX, 3 * TyPtrSize(), 0)
    IrEmit(list, OP_MOV_EAX_IMM, 2, 0)
    IrEmit(list, OP_STORE_RSP_RAX, 2 * TyPtrSize(), 0)
    IrEmitStr(list, OP_LEA_RAX_STR, 0, VarPtr(crlf))
    IrEmit(list, OP_STORE_RSP_RAX, 1 * TyPtrSize(), 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_STORE_RSP_RAX, 0, 0)
    LowEmitLoadRegArgs(list, 5)
    lstrcpy(VarPtr(sApi), "WriteFile")
    IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sApi))
    LowEmitCallFinish(list, stk)
    LowEmitLeaveN(list, 1)
End Sub

Sub LowEmitRtInputReadLoop(ctx As *LowerCtx, list As *IrList, labLoop As Long, labDone As Long, labSkipCr As Long)
    Dim sApi(15) As Byte
    Dim stk As Long

    IrEmit(list, OP_LABEL, labLoop, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 255, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JGE, labDone, 0)

    stk = LowCallStk(5)
    If stk > 0 Then
        IrEmit(list, OP_SUB_RSP, stk, 0)
    End If
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_STORE_RSP_RAX, 4 * TyPtrSize(), 0)
    IrEmit(list, OP_LEA_LOCAL, -40, 0)
    IrEmit(list, OP_STORE_RSP_RAX, 3 * TyPtrSize(), 0)
    IrEmit(list, OP_MOV_EAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_RSP_RAX, 2 * TyPtrSize(), 0)
    IrEmit(list, OP_LEA_LOCAL, -8, 0)
    IrEmit(list, OP_STORE_RSP_RAX, 1 * TyPtrSize(), 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_STORE_RSP_RAX, 0, 0)
    LowEmitLoadRegArgs(list, 5)
    lstrcpy(VarPtr(sApi), "ReadFile")
    IrEmitStr(list, OP_CALL_API, IR_DLL_KERNEL32, VarPtr(sApi))
    LowEmitCallFinish(list, stk)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JZ, labDone, 0)
    IrEmit(list, OP_LOAD_LOCAL, -40, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JZ, labDone, 0)

    IrEmit(list, OP_LEA_LOCAL, -8, 0)
    IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 13, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JE, labSkipCr, 0)

    IrEmit(list, OP_LEA_LOCAL, -8, 0)
    IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 10, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JE, labDone, 0)

    IrEmit(list, OP_LEA_LOCAL, -8, 0)
    IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 4, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_STORE_BYTE_RAX_CL, 0, 0)
    IrEmit(list, OP_INC_LOCAL, -32, 0)

    IrEmit(list, OP_LABEL, labSkipCr, 0)
    IrEmit(list, OP_JMP, labLoop, 0)
End Sub

Sub LowEmitRtInputDone(list As *IrList)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_ECX, &H80000000, 0)
    IrEmit(list, OP_POP_RAX, 0, 0)
    IrEmit(list, OP_OR_EAX_ECX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_STORE_DWORD_RAX_ECX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_ADD_RAX_RCX, 0, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 4, 0)
    IrEmit(list, OP_MOV_ECX, 0, 0)
    IrEmit(list, OP_STORE_BYTE_RAX_CL, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 4, 0)
    LowEmitLeaveN(list, 0)
End Sub

' Input$ ― stdin から1行読み、ヒープ上の文字列を返す（CR 無視 / LF で終了）
Sub LowEmitRtInputBody(ctx As *LowerCtx)
    Dim list As *IrList
    Dim sApi(15) As Byte
    Dim labFail As Long
    Dim labLoop As Long
    Dim labDone As Long
    Dim labSkipCr As Long

    If g_rtInputLab < 0 Then Exit Sub
    list = ctx->list
    labFail = LowNewLab(ctx)
    labLoop = LowNewLab(ctx)
    labDone = LowNewLab(ctx)
    labSkipCr = LowNewLab(ctx)

    ' locals: -8 ch, -16 handle, -24 buf(base), -32 len, -40 nRead
    IrEmit(list, OP_LABEL, g_rtInputLab, 0)
    IrEmit(list, OP_ENTER, 80, 0)
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -32, 0)

    IrEmit(list, OP_MOV_EAX_IMM, 260, 0)
    LowEmitCallStrHeapAlloc(ctx)
    IrEmit(list, OP_STORE_LOCAL, -24, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JZ, labFail, 0)

    lstrcpy(VarPtr(sApi), "GetStdHandle")
    LowEmitApiImm1(list, IR_DLL_KERNEL32, VarPtr(sApi), &HFFFFFFF6)
    IrEmit(list, OP_STORE_LOCAL, -16, 0)

    LowEmitRtInputReadLoop(ctx, list, labLoop, labDone, labSkipCr)

    IrEmit(list, OP_LABEL, labDone, 0)
    LowEmitRtInputDone(list)

    IrEmit(list, OP_LABEL, labFail, 0)
    IrEmit(list, OP_XOR_EAX, 0, 0)
    LowEmitLeaveN(list, 0)
End Sub

Sub LowEmitRtValSkipLeading(list As *IrList, labSpace As Long, labSign As Long)
    IrEmit(list, OP_LABEL, labSpace, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 32, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JNE, labSign, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -8, 0)
    IrEmit(list, OP_JMP, labSpace, 0)
End Sub

Sub LowEmitRtValParseSign(list As *IrList, labSign As Long, labPlus As Long, labDigit As Long)
    IrEmit(list, OP_LABEL, labSign, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 45, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JNE, labPlus, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -16, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -8, 0)
    IrEmit(list, OP_JMP, labDigit, 0)

    IrEmit(list, OP_LABEL, labPlus, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 43, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JNE, labDigit, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -8, 0)
End Sub

Sub LowEmitRtValParseDigits(list As *IrList, labDigit As Long, labEnd As Long)
    IrEmit(list, OP_LABEL, labDigit, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 48, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JL, labEnd, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 57, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JG, labEnd, 0)
    IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -48, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_MOV_ECX, 10, 0)
    IrEmit(list, OP_IMUL_EAX_ECX, 0, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_ADD_EAX_ECX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -24, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -8, 0)
    IrEmit(list, OP_JMP, labDigit, 0)
End Sub

' Val(s) ― 先頭の空白と符号を処理し、十進整数を返す
Sub LowEmitRtValBody(ctx As *LowerCtx)
    Dim list As *IrList
    Dim labSpace As Long
    Dim labSign As Long
    Dim labPlus As Long
    Dim labDigit As Long
    Dim labEnd As Long
    Dim labDone As Long

    If g_rtValLab < 0 Then Exit Sub
    list = ctx->list
    labSpace = LowNewLab(ctx)
    labSign = LowNewLab(ctx)
    labPlus = LowNewLab(ctx)
    labDigit = LowNewLab(ctx)
    labEnd = LowNewLab(ctx)
    labDone = LowNewLab(ctx)

    ' locals: -8 ptr, -16 negative flag, -24 value
    IrEmit(list, OP_LABEL, g_rtValLab, 0)
    IrEmit(list, OP_ENTER, 48, 0)
    LowEmitCaptureArg0(list, -8)
    IrEmit(list, OP_XOR_EAX, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -16, 0)
    IrEmit(list, OP_STORE_LOCAL, -24, 0)

    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_JZ, labDone, 0)

    LowEmitRtValSkipLeading(list, labSpace, labSign)
    LowEmitRtValParseSign(list, labSign, labPlus, labDigit)
    LowEmitRtValParseDigits(list, labDigit, labEnd)

    IrEmit(list, OP_LABEL, labEnd, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_POP_RAX, 0, 0)
    IrEmit(list, OP_JZ, labDone, 0)
    IrEmit(list, OP_NEG_EAX, 0, 0)
    IrEmit(list, OP_JMP, labDone, 0)

    IrEmit(list, OP_LABEL, labDone, 0)
    LowEmitLeaveN(list, 1)
End Sub

Sub LowEmitRtValDoubleMul10AddDigit(list As *IrList)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_RAX_IMM64, 0, &H40240000)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_MUL_SD, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -24, 0)
    IrEmit(list, OP_POP_RAX, 0, 0)
    IrEmit(list, OP_CVT_I32_TO_SD, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_ADD_SD, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -24, 0)
End Sub

Sub LowEmitRtValDoubleAddScaledDigit(list As *IrList)
    IrEmit(list, OP_CVT_I32_TO_SD, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_MUL_SD, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_ADD_SD, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -24, 0)
    IrEmit(list, OP_LOAD_LOCAL, -32, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_RAX_IMM64, &H9999999A, &H3FB99999)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_MUL_SD, 0, 0)
    IrEmit(list, OP_STORE_LOCAL, -32, 0)
End Sub

Sub LowEmitRtValDoubleParseDigits(list As *IrList, labDigit As Long, labDot As Long)
    IrEmit(list, OP_LABEL, labDigit, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 48, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JL, labDot, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 57, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JG, labDot, 0)
    IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -48, 0)
    LowEmitRtValDoubleMul10AddDigit(list)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -8, 0)
    IrEmit(list, OP_JMP, labDigit, 0)
End Sub

Sub LowEmitRtValDoubleFraction(list As *IrList, labDot As Long, labFrac As Long, labEnd As Long)
    IrEmit(list, OP_LABEL, labDot, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 46, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JNE, labEnd, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -8, 0)

    IrEmit(list, OP_LABEL, labFrac, 0)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_LOADZX_BYTE_RAX, 0, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 48, 0)
    IrEmit(list, OP_POP_RCX, 0, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JL, labEnd, 0)
    IrEmit(list, OP_MOV_EAX_IMM, 57, 0)
    IrEmit(list, OP_CMP_ECX_EAX, 0, 0)
    IrEmit(list, OP_JG, labEnd, 0)
    IrEmit(list, OP_XCHG_RAX_RCX, 0, 0)
    IrEmit(list, OP_ADD_RAX_IMM, -48, 0)
    LowEmitRtValDoubleAddScaledDigit(list)
    IrEmit(list, OP_LOAD_LOCAL, -8, 0)
    IrEmit(list, OP_ADD_RAX_IMM, 1, 0)
    IrEmit(list, OP_STORE_LOCAL, -8, 0)
    IrEmit(list, OP_JMP, labFrac, 0)
End Sub

Sub LowEmitRtValDoubleApplySign(list As *IrList, labEnd As Long, labDone As Long)
    IrEmit(list, OP_LABEL, labEnd, 0)
    IrEmit(list, OP_LOAD_LOCAL, -24, 0)
    IrEmit(list, OP_PUSH_RAX, 0, 0)
    IrEmit(list, OP_LOAD_LOCAL, -16, 0)
    IrEmit(list, OP_TEST_RAX, 0, 0)
    IrEmit(list, OP_POP_RAX, 0, 0)
    IrEmit(list, OP_JZ, labDone, 0)
    IrEmit(list, OP_NEG_SD, 0, 0)
    IrEmit(list, OP_JMP, labDone, 0)
End Sub

