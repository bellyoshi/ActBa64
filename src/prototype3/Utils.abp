' Utils.abp - 文字列・パス共通ユーティリティ
' 各ツールは xxx.idx 経由で #include する（.pj の #SOURCE にも列挙）

Function IsSpace(c As Long) As Long
    If c = Asc(" ") Or c = 9 Or c = 13 Or c = 10 Then
        IsSpace = 1
    Else
        IsSpace = 0
    End If
End Function

Function Trim$(s As String) As String
    Dim p As *Byte
    Dim i As Long
    Dim j As Long
    Dim n As Long
    n = Len(s)
    If n = 0 Then
        Trim$ = ""
        Exit Function
    End If
    p = StrPtr(s)
    i = 0
    While i < n And IsSpace(p[i]) <> 0
        i = i + 1
    Wend
    j = n - 1
    While j >= i And IsSpace(p[j]) <> 0
        j = j - 1
    Wend
    If j < i Then
        Trim$ = ""
    Else
        Trim$ = Mid$(s, i + 1, j - i + 1)
    End If
End Function

' 大文字小文字を無視した文字列比較（ポインタ比較に落とさない）
Function StrEqCI(a As String, b As String) As Long
    Dim i As Long
    Dim n As Long
    Dim pa As *Byte
    Dim pb As *Byte
    Dim ca As Long
    Dim cb As Long
    StrEqCI = 0
    n = Len(a)
    If n <> Len(b) Then Exit Function
    If n = 0 Then
        StrEqCI = 1
        Exit Function
    End If
    pa = StrPtr(a)
    pb = StrPtr(b)
    For i = 0 To n - 1
        ca = pa[i]
        cb = pb[i]
        If ca >= Asc("A") And ca <= Asc("Z") Then ca = ca + 32
        If cb >= Asc("A") And cb <= Asc("Z") Then cb = cb + 32
        If ca <> cb Then Exit Function
    Next
    StrEqCI = 1
End Function

Function Lower$(s As String) As String
    Dim p As *Byte
    Dim i As Long
    Dim n As Long
    Dim c As Long
    Dim tmp As Long
    Dim bp As *Byte
    Dim r As String
    n = Len(s)
    If n = 0 Then
        Lower$ = ""
        Exit Function
    End If
    ' Mid$ で1回確保し、その場で小文字化（文字単位 + の O(n^2) を避ける）
    r = Mid$(s, 1, n)
    p = StrPtr(r)
    bp = VarPtr(tmp)
    For i = 0 To n - 1
        c = p[i]
        If c >= Asc("A") And c <= Asc("Z") Then
            tmp = c + 32
            p[i] = bp[0]
        End If
    Next
    Lower$ = r
End Function

' 大文字小文字を区別する前方一致
Function StartsWith(s As String, prefix As String) As Long
    Dim n As Long
    Dim m As Long
    n = Len(s)
    m = Len(prefix)
    If n < m Then
        StartsWith = 0
    ElseIf Left$(s, m) = prefix Then
        StartsWith = 1
    Else
        StartsWith = 0
    End If
End Function

' 大文字小文字を区別しない前方一致
Function StartsWithCI(s As String, prefix As String) As Long
    Dim n As Long
    Dim m As Long
    Dim a As String
    n = Len(s)
    m = Len(prefix)
    If n < m Then
        StartsWithCI = 0
        Exit Function
    End If
    If m = 0 Then
        StartsWithCI = 1
        Exit Function
    End If
    a = Left$(s, m)
    StartsWithCI = StrEqCI(a, prefix)
End Function

' 拡張子を除いたパス（ディレクトリ含む）
Function BaseName$(inPath As String) As String
    Dim i As Long
    Dim n As Long
    Dim ch As String
    Dim dotPos As Long
    Dim slashPos As Long
    n = Len(inPath)
    dotPos = 0
    slashPos = 0
    For i = 1 To n
        ch = Mid$(inPath, i, 1)
        If ch = "\" Or ch = "/" Then
            slashPos = i
            dotPos = 0
        ElseIf ch = "." Then
            dotPos = i
        End If
    Next
    If dotPos > slashPos Then
        BaseName$ = Left$(inPath, dotPos - 1)
    Else
        BaseName$ = inPath
    End If
End Function

' ディレクトリ部分（末尾に \ または / を含む）。無ければ ""
Function DirOf$(path As String) As String
    Dim i As Long
    Dim n As Long
    Dim ch As String
    Dim slashPos As Long
    n = Len(path)
    slashPos = 0
    For i = 1 To n
        ch = Mid$(path, i, 1)
        If ch = "\" Or ch = "/" Then
            slashPos = i
        End If
    Next
    If slashPos > 0 Then
        DirOf$ = Left$(path, slashPos)
    Else
        DirOf$ = ""
    End If
End Function

Function FileNameOnly$(path As String) As String
    Dim d As String
    Dim n As Long
    d = DirOf$(path)
    n = Len(d)
    If n = 0 Then
        FileNameOnly$ = path
    Else
        FileNameOnly$ = Mid$(path, n + 1, Len(path) - n)
    End If
End Function

Function EndsWithExt(path As String, ext As String) As Long
    Dim n As Long
    Dim m As Long
    Dim i As Long
    Dim cp As Long
    Dim ce As Long
    Dim pp As *Byte
    Dim pe As *Byte
    n = Len(path)
    m = Len(ext)
    EndsWithExt = 0
    If n < m Then Exit Function
    If m = 0 Then
        EndsWithExt = 1
        Exit Function
    End If
    pp = StrPtr(path)
    pe = StrPtr(ext)
    For i = 0 To m - 1
        cp = pp[n - m + i]
        ce = pe[i]
        If cp >= Asc("A") And cp <= Asc("Z") Then cp = cp + 32
        If ce >= Asc("A") And ce <= Asc("Z") Then ce = ce + 32
        If cp <> ce Then Exit Function
    Next
    EndsWithExt = 1
End Function

' 拡張子を newExt（例: ".asm"）に置換したパスを返す
Function ChangeExtension$(inPath As String, newExt As String) As String
    Dim base As String
    base = BaseName$(inPath)
    ChangeExtension$ = base + newExt
End Function
