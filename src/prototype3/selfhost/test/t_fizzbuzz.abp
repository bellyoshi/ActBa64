' Expect: 6
' FizzBuzz 1..100: FizzBuzz 回数 (15 の倍数) = 6
#console

' n Mod m = 0 なら 1
Function IsMod0(n As Long, m As Long) As Long
    Dim r As Long
    r = n
    While r >= m
        r = r - m
    Wend
    If r = 0 Then
        IsMod0 = 1
    Else
        IsMod0 = 0
    End If
End Function

Sub PrintNum(n As Long)
    Print Str$(n)
End Sub

Dim i As Long
Dim n As Long
Dim r As Long
n = 0
For i = 1 To 100
    r = i
    If IsMod0(r, 15) <> 0 Then
        n = n + 1
    Else
        If IsMod0(r, 3) <> 0 Then
            Print "Fizz"
        Else
            If IsMod0(r, 5) <> 0 Then
                Print "Buzz"
            Else
                PrintNum(r)
            End If
        End If
    End If
Next
ExitProcess(n)
