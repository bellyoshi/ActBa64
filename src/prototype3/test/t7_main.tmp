' Include/default 自動読み込み一覧（ソースに #include 不要）
' WinTypes.sbp - Win32 構造体（abc 自己ホスト用。AB420 は api_system.sbp 側を使う）
Type SECURITY_ATTRIBUTES
    nLength As DWord
    lpSecurityDescriptor As Long
    bInheritHandle As Long
End Type
Type PROCESS_INFORMATION
    hProcess As HANDLE
    hThread As HANDLE
    dwProcessId As DWord
    dwThreadId As DWord
End Type
Type STARTUPINFO
    cb As DWord
    lpReserved As Long
    lpDesktop As Long
    lpTitle As Long
    dwX As DWord
    dwY As DWord
    dwXSize As DWord
    dwYSize As DWord
    dwXCountChars As DWord
    dwYCountChars As DWord
    dwFillAttribute As DWord
    dwFlags As DWord
    wShowWindow As Word
    cbReserved2 As Word
    lpReserved2 As Long
    hStdInput As HANDLE
    hStdOutput As HANDLE
    hStdError As HANDLE
End Type
' Expect: 50
' Phase7 main (uses t7_lib via .pj combine)
ExitProcess(SizeOf(Point) + MAGIC)
