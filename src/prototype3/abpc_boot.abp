' ---- Include/default ----
' WinTypes.sbp - Win32 構造体（abc 自己ホスト用。AB420 は api_system.sbp 側を使う）

Type SECURITY_ATTRIBUTES
    nLength As DWord
    lpSecurityDescriptor As Long
    bInheritHandle As Long
End Type

Type PROCESS_INFORMATION
    hProcess As HANDLE
    hThread As HANDLE
    dwProcessId As DWord
    dwThreadId As DWord
End Type

Type STARTUPINFO
    cb As DWord
    lpReserved As Long
    lpDesktop As Long
    lpTitle As Long
    dwX As DWord
    dwY As DWord
    dwXSize As DWord
    dwYSize As DWord
    dwXCountChars As DWord
    dwYCountChars As DWord
    dwFillAttribute As DWord
    dwFlags As DWord
    wShowWindow As Word
    cbReserved2 As Word
    lpReserved2 As Long
    hStdInput As HANDLE
    hStdOutput As HANDLE
    hStdError As HANDLE
End Type
' ---- Utils.abp ----
' Utils.abp - 文字列・パス共通ユーティリティ
' 各ツールは xxx.idx 経由で #include する（.pj の #SOURCE にも列挙）

Function IsSpace(c As Long) As Long
    If c = Asc(" ") Or c = 9 Or c = 13 Or c = 10 Then
        IsSpace = 1
    Else
        IsSpace = 0
    End If
End Function

Function Trim$(s As String) As String
    Dim p As *Byte
    Dim i As Long
    Dim j As Long
    Dim n As Long
    n = Len(s)
    If n = 0 Then
        Trim$ = ""
        Exit Function
    End If
    p = StrPtr(s)
    i = 0
    While i < n And IsSpace(p[i]) <> 0
        i = i + 1
    Wend
    j = n - 1
    While j >= i And IsSpace(p[j]) <> 0
        j = j - 1
    Wend
    If j < i Then
        Trim$ = ""
    Else
        Trim$ = Mid$(s, i + 1, j - i + 1)
    End If
End Function

Function Lower$(s As String) As String
    Dim p As *Byte
    Dim i As Long
    Dim n As Long
    Dim c As Long
    Dim r As String
    n = Len(s)
    If n = 0 Then
        Lower$ = ""
        Exit Function
    End If
    ' Mid$ で1回確保し、その場で小文字化（文字単位 + の O(n^2) を避ける）
    r = Mid$(s, 1, n)
    p = StrPtr(r)
    For i = 0 To n - 1
        c = p[i]
        If c >= Asc("A") And c <= Asc("Z") Then p[i] = c + 32
    Next
    Lower$ = r
End Function

' 大文字小文字を区別する前方一致
Function StartsWith(s As String, prefix As String) As Long
    Dim n As Long
    Dim m As Long
    n = Len(s)
    m = Len(prefix)
    If n < m Then
        StartsWith = 0
    ElseIf Left$(s, m) = prefix Then
        StartsWith = 1
    Else
        StartsWith = 0
    End If
End Function

' 大文字小文字を区別しない前方一致
Function StartsWithCI(s As String, prefix As String) As Long
    Dim n As Long
    Dim m As Long
    Dim a As String
    Dim b As String
    n = Len(s)
    m = Len(prefix)
    If n < m Then
        StartsWithCI = 0
        Exit Function
    End If
    If m = 0 Then
        StartsWithCI = 1
        Exit Function
    End If
    a = Left$(s, m)
    a = Lower$(a)
    b = Lower$(prefix)
    If a = b Then
        StartsWithCI = 1
    Else
        StartsWithCI = 0
    End If
End Function

' 拡張子を除いたパス（ディレクトリ含む）
Function BaseName$(inPath As String) As String
    Dim i As Long
    Dim n As Long
    Dim ch As String
    Dim dotPos As Long
    Dim slashPos As Long
    n = Len(inPath)
    dotPos = 0
    slashPos = 0
    For i = 1 To n
        ch = Mid$(inPath, i, 1)
        If ch = "\" Or ch = "/" Then
            slashPos = i
            dotPos = 0
        ElseIf ch = "." Then
            dotPos = i
        End If
    Next
    If dotPos > slashPos Then
        BaseName$ = Left$(inPath, dotPos - 1)
    Else
        BaseName$ = inPath
    End If
End Function

' ディレクトリ部分（末尾に \ または / を含む）。無ければ ""
Function DirOf$(path As String) As String
    Dim i As Long
    Dim n As Long
    Dim ch As String
    Dim slashPos As Long
    n = Len(path)
    slashPos = 0
    For i = 1 To n
        ch = Mid$(path, i, 1)
        If ch = "\" Or ch = "/" Then
            slashPos = i
        End If
    Next
    If slashPos > 0 Then
        DirOf$ = Left$(path, slashPos)
    Else
        DirOf$ = ""
    End If
End Function

Function FileNameOnly$(path As String) As String
    Dim d As String
    Dim n As Long
    d = DirOf$(path)
    n = Len(d)
    If n = 0 Then
        FileNameOnly$ = path
    Else
        FileNameOnly$ = Mid$(path, n + 1, Len(path) - n)
    End If
End Function

Function EndsWithExt(path As String, ext As String) As Long
    Dim n As Long
    Dim m As Long
    Dim i As Long
    Dim cp As Long
    Dim ce As Long
    Dim pp As *Byte
    Dim pe As *Byte
    n = Len(path)
    m = Len(ext)
    EndsWithExt = 0
    If n < m Then Exit Function
    If m = 0 Then
        EndsWithExt = 1
        Exit Function
    End If
    pp = StrPtr(path)
    pe = StrPtr(ext)
    For i = 0 To m - 1
        cp = pp[n - m + i]
        ce = pe[i]
        If cp >= Asc("A") And cp <= Asc("Z") Then cp = cp + 32
        If ce >= Asc("A") And ce <= Asc("Z") Then ce = ce + 32
        If cp <> ce Then Exit Function
    Next
    EndsWithExt = 1
End Function

' 拡張子を newExt（例: ".asm"）に置換したパスを返す
Function ChangeExtension$(inPath As String, newExt As String) As String
    Dim base As String
    base = BaseName$(inPath)
    ChangeExtension$ = base + newExt
End Function
' ---- Common.abp ----
' Common.abp - コマンド行・メモリ・書式の共通処理
' WinAPI 定数 (MAX_PATH / NULL 等) はホストヘッダまたは abc 組み込みを使う

Function GetCmd(cnt As Long, buf As *Byte) As Long
    Dim cmd As *Byte
    Dim cmdlen As Long
    Dim cidx As Long
    Dim ctmp[MAX_PATH] As Byte
    Dim n As Long
    Dim m As Long
    Dim pBuf As *Byte

    pBuf = buf
    cmd = GetCommandLine()
    cmdlen = lstrlen(cmd)
    cmd[cmdlen] = &H20
    pBuf[0] = 0
    cidx = 0

    For n = 0 To cmdlen
        If cmd[n] = &H20 And cmd[n + 1] = &H20 Then
            memcpy(VarPtr(cmd[n]), VarPtr(cmd[n + 1]), cmdlen - n)
            n = n - 1
            cmdlen = cmdlen - 1
        End If
    Next

    For n = 0 To cmdlen
        m = 0
        While cmd[n] <> &H20
            ctmp[m] = cmd[n]
            m = m + 1
            n = n + 1
        Wend
        ctmp[m] = 0
        If cidx = cnt Then
            lstrcpy(buf, ctmp)
            GetCmd = 1
            Exit Function
        End If
        cidx = cidx + 1
    Next
    GetCmd = 0
End Function

Sub ZeroMem(p As *Byte, n As Long)
    Dim i As Long
    Dim q As *Byte
    If n <= 0 Then Exit Sub
    q = p
    For i = 0 To n - 1
        q[i] = 0
    Next
End Sub

Function HexPad$(num As Long, digits As Long) As String
    Dim s As String
    s = Hex$(num)
    While Len(s) < digits
        s = "0" + s
    Wend
    HexPad$ = s
End Function
' ---- FileIO.abp ----
' FileIO.abp - ファイル入出力共通処理
' ホスト AB: ポインタ引数のみ ByVal NULL。HANDLE 等は NULL/0

Dim gLastLoadSize As Long
Dim gLoadPtr As *Byte

Function FileExists(path As String) As Long
    Dim attr As DWord
    attr = GetFileAttributes(StrPtr(path))
    If attr = &HFFFFFFFF Then
        FileExists = 0
    Else
        FileExists = 1
    End If
End Function

' Function 戻り (*Byte) が壊れることがあるため、結果は gLoadPtr / gLastLoadSize へ
Sub LoadFileToGlobal(path As *Byte)
    Dim hFile As HANDLE
    Dim fsiz As Long
    Dim nRead As DWord
    Dim p As *Byte

    gLoadPtr = 0
    gLastLoadSize = 0

    hFile = CreateFile(path, GENERIC_READ, FILE_SHARE_READ, ByVal NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL)
    If hFile = INVALID_HANDLE_VALUE Then Exit Sub

    fsiz = GetFileSize(hFile, NULL)
    If fsiz <= 0 Then
        CloseHandle(hFile)
        Exit Sub
    End If

    p = malloc(fsiz + 1)
    If p = 0 Then
        CloseHandle(hFile)
        Exit Sub
    End If

    ReadFile(hFile, p, fsiz, VarPtr(nRead), ByVal NULL)
    CloseHandle(hFile)
    p[fsiz] = 0
    gLastLoadSize = fsiz
    gLoadPtr = p
End Sub

Function LoadFile(path As *Byte, ByRef outSize As Long) As *Byte
    LoadFileToGlobal(path)
    outSize = gLastLoadSize
    LoadFile = gLoadPtr
End Function

Function WriteAll(path As *Byte, p As *Byte, size As Long) As Long
    Dim hFile As HANDLE
    Dim nWritten As DWord

    WriteAll = 0
    hFile = CreateFile(path, GENERIC_WRITE, 0, ByVal NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL)
    If hFile = INVALID_HANDLE_VALUE Then Exit Function

    WriteFile(hFile, p, size, VarPtr(nWritten), ByVal NULL)
    CloseHandle(hFile)
    If nWritten = size Then WriteAll = 1
End Function

Function LoadTextFile$(path As String) As String
    Dim hFile As HANDLE
    Dim fsiz As Long
    Dim nRead As DWord
    Dim p As *Byte

    LoadTextFile$ = ""
    hFile = CreateFile(StrPtr(path), GENERIC_READ, FILE_SHARE_READ, ByVal NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL)
    If hFile = INVALID_HANDLE_VALUE Then
        Print "cannot open: " + path
        Exit Function
    End If
    fsiz = GetFileSize(hFile, NULL)
    If fsiz < 0 Then
        CloseHandle(hFile)
        Exit Function
    End If
    p = malloc(fsiz + 1)
    If p = 0 Then
        CloseHandle(hFile)
        Exit Function
    End If
    If fsiz > 0 Then
        ReadFile(hFile, p, fsiz, VarPtr(nRead), ByVal NULL)
    End If
    CloseHandle(hFile)
    p[fsiz] = 0
    LoadTextFile$ = MakeStr(p)
    free(p)
End Function

Function WriteTextFile(path As String, text As String) As Long
    Dim hFile As HANDLE
    Dim nWritten As DWord
    Dim n As Long

    WriteTextFile = 0
    n = Len(text)
    hFile = CreateFile(StrPtr(path), GENERIC_WRITE, 0, ByVal NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL)
    If hFile = INVALID_HANDLE_VALUE Then Exit Function
    If n > 0 Then
        WriteFile(hFile, StrPtr(text), n, VarPtr(nWritten), ByVal NULL)
    Else
        nWritten = 0
    End If
    CloseHandle(hFile)
    If nWritten = n Then
        WriteTextFile = 1
    End If
End Function
' ---- abpc.abp ----

#console

' abpc - ABP ビルドドライバ
' 使い方:
'   abpc <input.abp> [-o output.exe]       ' 単一ソース（#include 展開）
'   abpc <project.pj> [-o output.exe]      ' #SOURCE 結合（#include 展開）→ abc → asm → obj → exe
'
' -o は .pj の #OUTPUT_RELEASE より優先。未指定時は .pj の out（単一 .abp は basename.exe）。
' 互換: 位置引数 [output.exe] も可（-o があればそちら優先）。
'
' 呼び出し順:
'   1. #include 展開（abpc）
'   2. abc         (.abp -> .asm)
'   3. abassembler (.asm -> .obj)
'   4. ablinker    (.obj -> .exe)

Const MAX_CMDLINE = 1024
Const MAX_SOURCES = 32
Const MAX_INCLUDES = 64

Dim gSources(31) As String
Dim gNSources As Long
Dim gOutExe As String
Dim gPlatform As Long
Dim gProjDir As String
Dim gProjName As String
Dim gIncSeen(63) As String
Dim gNIncSeen As Long
Dim gExpandOk As Long
Dim gPreparedAbp As String
Dim gCombinedAbp As String
Dim gCombineAll As String
Dim gCliOutOk As Long

Sub USAGE()
    Print "abpc build driver"
    Print "abpc <abp|pj> [-o out.exe]"
    Print "expand/abc/asm/link"
    End
End Sub

Function ToolDir$() As String
    Dim buf[MAX_PATH] As Byte
    Dim s As String
    Dim i As Long
    Dim n As Long
    Dim ch As String
    Dim slashPos As Long

    GetModuleFileName(NULL, buf, MAX_PATH)
    s = MakeStr(buf)
    n = Len(s)
    slashPos = 0
    For i = 1 To n
        ch = Mid$(s, i, 1)
        If ch = "\" Or ch = "/" Then
            slashPos = i
        End If
    Next
    If slashPos > 0 Then
        ToolDir$ = Left$(s, slashPos)
    Else
        ToolDir$ = ""
    End If
End Function

' Include/default/default.idx（ツール隣 or カレント）
Function DefaultIncludeIdx$() As String
    Dim p As String
    p = ToolDir$() + "Include\default\default.idx"
    If FileExists(p) <> 0 Then
        DefaultIncludeIdx$ = p
        Exit Function
    End If
    p = "Include\default\default.idx"
    If FileExists(p) <> 0 Then
        DefaultIncludeIdx$ = p
        Exit Function
    End If
    DefaultIncludeIdx$ = ""
End Function

Function AppendDefaultIncludes() As Long
    Dim idx As String
    Dim chunk As String
    AppendDefaultIncludes = 0
    idx = DefaultIncludeIdx$()
    If idx = "" Then
        AppendDefaultIncludes = 1
        Exit Function
    End If
    chunk = ExpandFile$(idx)
    If gExpandOk = 0 Then Exit Function
    If Len(chunk) > 0 Then
        gCombineAll = gCombineAll + "' ---- Include/default ----" + Chr$(13) + Chr$(10)
        gCombineAll = gCombineAll + chunk
        If Right$(gCombineAll, 2) <> Chr$(13) + Chr$(10) Then
            gCombineAll = gCombineAll + Chr$(13) + Chr$(10)
        End If
    End If
    AppendDefaultIncludes = 1
End Function

Function StripCommentPj$(s As String) As String
    Dim n As Long
    Dim i As Long
    Dim inQ As Long
    Dim c As Long
    Dim p As *Byte
    Dim t As String
    n = Len(s)
    If n = 0 Then
        StripCommentPj$ = ""
        Exit Function
    End If
    p = StrPtr(s)
    inQ = 0
    For i = 0 To n - 1
        c = p[i]
        If inQ <> 0 Then
            If c = 34 Then inQ = 0
        ElseIf c = 34 Then
            inQ = 1
        ElseIf c = Asc("'") Then
            t = Left$(s, i)
            StripCommentPj$ = Trim$(t)
            Exit Function
        End If
    Next
    StripCommentPj$ = Trim$(s)
End Function

Function NormalizeOutPath$(p As String) As String
    Dim t As String
    t = Trim$(p)
    If Len(t) >= 2 Then
        If Left$(t, 2) = ".\" Then
            t = Mid$(t, 3, Len(t) - 2)
        End If
    End If
    NormalizeOutPath$ = t
End Function

Function JoinPath$(dir As String, name As String) As String
    If Len(DirOf$(name)) > 0 Then
        JoinPath$ = name
    ElseIf Len(dir) = 0 Then
        JoinPath$ = name
    Else
        JoinPath$ = dir + name
    End If
End Function

' CLI の出力先。-o path 優先、なければ位置引数。無ければ ""。
' エラー時は gCliOutOk=0 を返す（呼び出し側で End）。
Function ParseCliOut$() As String
    Dim i As Long
    Dim buf[MAX_PATH] As Byte
    Dim nxt[MAX_PATH] As Byte
    Dim arg As String
    Dim pos As String

    gCliOutOk = 1
    ParseCliOut$ = ""
    pos = ""
    i = 2
    While GetCmd(i, buf) <> 0
        arg = MakeStr(buf)
        If arg = "-o" Or arg = "-O" Or arg = "/o" Then
            If GetCmd(i + 1, nxt) = 0 Then
                Print "error: -o requires an output path"
                gCliOutOk = 0
                ParseCliOut$ = ""
                Exit Function
            End If
            ParseCliOut$ = NormalizeOutPath$(MakeStr(nxt))
            Exit Function
        End If
        If Left$(arg, 1) <> "-" Then
            If pos = "" Then
                pos = NormalizeOutPath$(arg)
            End If
        End If
        i = i + 1
    Wend
    ParseCliOut$ = pos
End Function

Function ParseProject(pjPath As String) As Long
    Dim text As String
    Dim oneLine As String
    Dim i As Long
    Dim start As Long
    Dim n As Long
    Dim c As Long
    Dim p As *Byte
    Dim inSource As Long
    Dim low As String
    Dim eq As Long
    Dim key As String
    Dim value As String
    Dim tmp As String

    ParseProject = 0
    gNSources = 0
    gOutExe = ""
    gPlatform = 0
    gProjDir = DirOf$(pjPath)
    tmp = BaseName$(pjPath)
    gProjName = FileNameOnly$(tmp)

    text = LoadTextFile$(pjPath)
    If text = "" Then
        If FileExists(pjPath) = 0 Then Exit Function
    End If

    n = Len(text)
    p = StrPtr(text)
    i = 0
    inSource = 0
    While i < n
        start = i
        While i < n
            c = p[i]
            If c = 10 Or c = 13 Then Exit While
            i = i + 1
        Wend
        oneLine = StripCommentPj$(Mid$(text, start + 1, i - start))
        While i < n
            c = p[i]
            If c <> 10 And c <> 13 Then Exit While
            i = i + 1
        Wend
        If oneLine = "" Then
            ' skip
        Else
            If Left$(oneLine, 1) = "#" Then
                low = Lower$(oneLine)
                If low = "#source" Then
                    inSource = 1
                Else
                    inSource = 0
                    eq = InStr(1, oneLine, "=")
                    If eq > 1 Then
                        tmp = Left$(oneLine, eq - 1)
                        tmp = Trim$(tmp)
                        key = Lower$(tmp)
                        tmp = Mid$(oneLine, eq + 1, Len(oneLine) - eq)
                        value = Trim$(tmp)
                        If key = "#output_release" Then
                            gOutExe = NormalizeOutPath$(value)
                        ElseIf key = "#platform" Then
                            If value = "32" Then
                                gPlatform = 32
                            Else
        Print "bad platform: " + value
                                Exit Function
                            End If
                        ElseIf key = "#name" Then
                            If value <> "" Then
                                gProjName = value
                            End If
                        End If
                    End If
                End If
            Else
                If inSource <> 0 Then
                    If gNSources >= MAX_SOURCES Then
                        Print "too many #SOURCE files"
                        Exit Function
                    End If
                    gSources(gNSources) = oneLine
                    gNSources = gNSources + 1
                End If
            End If
        End If
    Wend

    If gNSources <= 0 Then
        Print "no #SOURCE in " + pjPath
        Exit Function
    End If
    If gOutExe = "" Then
        gOutExe = gProjName + ".exe"
    End If
    If gPlatform = 0 Then
        gPlatform = 32
    End If
    gOutExe = JoinPath$(gProjDir, gOutExe)
    ParseProject = 1
End Function

Function TextHasInclude(text As String) As Long
    Dim low As String
    Dim oneLine As String
    Dim i As Long
    Dim start As Long
    Dim n As Long
    Dim c As Long
    Dim p As *Byte
    TextHasInclude = 0
    n = Len(text)
    If n = 0 Then Exit Function
    p = StrPtr(text)
    i = 0
    While i < n
        start = i
        While i < n
            c = p[i]
            If c = 10 Or c = 13 Then Exit While
            i = i + 1
        Wend
        oneLine = StripCommentPj$(Mid$(text, start + 1, i - start))
        low = Lower$(Trim$(oneLine))
        If StartsWith(low, "#include") <> 0 Then
            TextHasInclude = 1
            Exit Function
        End If
        While i < n
            c = p[i]
            If c <> 10 And c <> 13 Then Exit While
            i = i + 1
        Wend
    Wend
End Function

Function FindIncSeen(path As String) As Long
    Dim i As Long
    Dim low As String
    FindIncSeen = 0
    low = Lower$(path)
    For i = 0 To gNIncSeen - 1
        If Lower$(gIncSeen(i)) = low Then
            FindIncSeen = 1
            Exit Function
        End If
    Next
End Function

Function MarkIncSeen(path As String) As Long
    MarkIncSeen = 0
    If gNIncSeen >= MAX_INCLUDES Then
        Print "too many includes"
        Exit Function
    End If
    gIncSeen(gNIncSeen) = path
    gNIncSeen = gNIncSeen + 1
    MarkIncSeen = 1
End Function

Function ResolveIncludePath$(currentFile As String, inc As String) As String
    Dim full As String
    full = Trim$(inc)
    If InStr(1, full, ":") = 0 And Left$(full, 1) <> "\" And Left$(full, 1) <> "/" Then
        full = DirOf$(currentFile) + full
    End If
    ResolveIncludePath$ = full
End Function

' #include を再帰展開。同一パスは once（再出現は空挿入）。失敗時 gExpandOk=0。
Function ExpandFile$(path As String) As String
    Dim text As String
    Dim outText As String
    Dim oneLine As String
    Dim i As Long
    Dim start As Long
    Dim n As Long
    Dim c As Long
    Dim p As *Byte
    Dim low As String
    Dim q1 As Long
    Dim q2 As Long
    Dim inc As String
    Dim full As String
    Dim child As String

    ExpandFile$ = ""
    If gExpandOk = 0 Then Exit Function
    If FindIncSeen(path) <> 0 Then
        Exit Function
    End If
    If MarkIncSeen(path) = 0 Then
        gExpandOk = 0
        Exit Function
    End If
    If FileExists(path) = 0 Then
        Print "cannot include: " + path
        gExpandOk = 0
        Exit Function
    End If

    text = LoadTextFile$(path)
    outText = ""
    n = Len(text)
    p = StrPtr(text)
    i = 0
    While i < n
        start = i
        While i < n
            c = p[i]
            If c = 10 Or c = 13 Then Exit While
            i = i + 1
        Wend
        oneLine = Mid$(text, start + 1, i - start)
        low = Lower$(Trim$(StripCommentPj$(oneLine)))
        If StartsWith(low, "#include") <> 0 Then
            q1 = InStr(1, oneLine, Chr$(34))
            q2 = 0
            If q1 > 0 Then q2 = InStr(q1 + 1, oneLine, Chr$(34))
            If q1 = 0 Or q2 <= q1 Then
                Print "bad #include: " + oneLine
                gExpandOk = 0
                Exit Function
            End If
            inc = Mid$(oneLine, q1 + 1, q2 - q1 - 1)
            full = ResolveIncludePath$(path, inc)
            child = ExpandFile$(full)
            If gExpandOk = 0 Then Exit Function
            outText = outText + child
        Else
            outText = outText + oneLine
            outText = outText + Chr$(13) + Chr$(10)
        End If
        While i < n
            c = p[i]
            If c <> 10 And c <> 13 Then Exit While
            i = i + 1
        Wend
    Wend
    ExpandFile$ = outText
End Function

Function AppendSourceChunk(srcName As String) As Long
    Dim srcPath As String
    Dim chunk As String
    AppendSourceChunk = 0
    srcPath = JoinPath$(gProjDir, srcName)
    If FileExists(srcPath) = 0 Then
        Print "missing source: " + srcPath
        Exit Function
    End If
    ' 既に他ソースの #include で展開済みならスキップ（once）
    If FindIncSeen(srcPath) <> 0 Then
        AppendSourceChunk = 1
        Exit Function
    End If
    chunk = ExpandFile$(srcPath)
    If gExpandOk = 0 Then Exit Function
    If Len(chunk) = 0 Then
        AppendSourceChunk = 1
        Exit Function
    End If
    gCombineAll = gCombineAll + "' ---- " + srcName + " ----" + Chr$(13) + Chr$(10)
    gCombineAll = gCombineAll + chunk
    If Right$(gCombineAll, 2) <> Chr$(13) + Chr$(10) Then
        gCombineAll = gCombineAll + Chr$(13) + Chr$(10)
    End If
    AppendSourceChunk = 1
End Function

Function CombineSources() As Long
    Dim i As Long
    Dim combined As String

    CombineSources = 0
    gCombineAll = ""
    gNIncSeen = 0
    gExpandOk = 1
    gCombinedAbp = ""
    ' Include/default を先に読む（ソースへの明示 #include 不要）
    If AppendDefaultIncludes() = 0 Then Exit Function
    ' #SOURCE 順に結合。#include は展開し、重複ファイルは once で除外。
    For i = 0 To gNSources - 1
        If AppendSourceChunk(gSources(i)) = 0 Then Exit Function
    Next
    If gExpandOk = 0 Then Exit Function

    combined = JoinPath$(gProjDir, gProjName + "_combined.abp")
    If WriteTextFile(combined, gCombineAll) = 0 Then
        Print "cannot write: " + combined
        Exit Function
    End If
    gCombinedAbp = combined
    CombineSources = 1
End Function

' 単一 .abp の #include を展開。結果は gPreparedAbp。
Function PrepareAbp(abpPath As String) As Long
    Dim text As String
    Dim expanded As String
    Dim expPath As String
    Dim idx As String
    Dim defaults As String
    Dim lowPath As String

    PrepareAbp = 0
    gPreparedAbp = ""
    If FileExists(abpPath) = 0 Then
        Print "missing: " + abpPath
        Exit Function
    End If

    gNIncSeen = 0
    gExpandOk = 1
    defaults = ""
    lowPath = Lower$(abpPath)
    ' *_combined.abp は CombineSources で default 済み
    If InStr(1, lowPath, "_combined.abp") = 0 Then
        idx = DefaultIncludeIdx$()
        If idx <> "" Then
            defaults = ExpandFile$(idx)
            If gExpandOk = 0 Then Exit Function
        End If
    End If

    text = LoadTextFile$(abpPath)
    If TextHasInclude(text) = 0 And defaults = "" Then
        gPreparedAbp = abpPath
        PrepareAbp = 1
        Exit Function
    End If

    If TextHasInclude(text) <> 0 Then
        expanded = ExpandFile$(abpPath)
        If gExpandOk = 0 Then Exit Function
    Else
        expanded = text
    End If
    expanded = defaults + expanded

    expPath = BaseName$(abpPath) + ".tmp"
    If WriteTextFile(expPath, expanded) = 0 Then
        Print "cannot write: " + expPath
        Exit Function
    End If
    If defaults <> "" Or TextHasInclude(text) <> 0 Then
        Print "include: " + abpPath + " -> " + expPath
    End If
    gPreparedAbp = expPath
    PrepareAbp = 1
End Function

Function EnsureParentDir(path As String) As Long
    Dim d As String
    Dim n As Long
    Dim last As String
    EnsureParentDir = 0
    d = DirOf$(path)
    n = Len(d)
    If n = 0 Then
        EnsureParentDir = 1
        Exit Function
    End If
    last = Right$(d, 1)
    If last = "\" Or last = "/" Then
        d = Left$(d, n - 1)
    End If
    If Len(d) = 0 Or d = "." Then
        EnsureParentDir = 1
        Exit Function
    End If
    If FileExists(d) = 0 Then
        Print "no out dir: " + d
        Exit Function
    End If
    EnsureParentDir = 1
End Function

Function RunTool(toolName As String, arg1 As String, arg2 As String) As Long
    Dim toolPath As String
    Dim cmdStr As String
    Dim dir As String
    Dim cmdBuf[1023] As Byte
    Dim si As STARTUPINFO
    Dim pi As PROCESS_INFORMATION
    Dim sa As SECURITY_ATTRIBUTES
    Dim ok As Long

    dir = ToolDir$()
    toolPath = dir + toolName
    cmdStr = toolPath + " " + arg1 + " " + arg2
    Print ">> " + cmdStr

    If Len(cmdStr) >= MAX_CMDLINE Then
        Print "cmdline too long"
        RunTool = 0
        Exit Function
    End If

    If FileExists(toolPath) = 0 Then
        Print "not found: " + toolPath
        RunTool = 0
        Exit Function
    End If

    ZeroMem(cmdBuf, MAX_CMDLINE)
    lstrcpy(cmdBuf, StrPtr(cmdStr))

    ZeroMem(VarPtr(si), SizeOf(STARTUPINFO))
    si.cb = SizeOf(STARTUPINFO)

    sa.nLength = SizeOf(SECURITY_ATTRIBUTES)
    sa.lpSecurityDescriptor = 0
    sa.bInheritHandle = 0

    ZeroMem(VarPtr(pi), SizeOf(PROCESS_INFORMATION))

    ' abc は Type 引数を値ロードできないため、ポインタを明示する
    ok = CreateProcess(NULL, cmdBuf, VarPtr(sa), VarPtr(sa), 0, 0, NULL, NULL, VarPtr(si), VarPtr(pi))
    If ok = 0 Then
        Print "cannot run: " + toolPath
        RunTool = 0
        Exit Function
    End If

    WaitForSingleObject(pi.hProcess, INFINITE)
    CloseHandle(pi.hThread)
    CloseHandle(pi.hProcess)
    RunTool = 1
End Function

Function BuildOne(abpPath As String, exePath As String) As Long
    Dim base As String
    Dim asmPath As String
    Dim objPath As String
    Dim srcPath As String

    BuildOne = 0
    If PrepareAbp(abpPath) = 0 Then Exit Function
    srcPath = gPreparedAbp
    If EnsureParentDir(exePath) = 0 Then Exit Function

    base = BaseName$(srcPath)
    asmPath = base + ".asm"
    objPath = base + ".obj"

    Print "abpc: " + abpPath + " -> " + exePath

    DeleteFile(StrPtr(asmPath))
    If RunTool("abc.exe", srcPath, asmPath) = 0 Then Exit Function
    If FileExists(asmPath) = 0 Then
        Print "error: abc produced no .asm (compile failed or silent exit)"
        Print "  expected: " + asmPath
        Print "  input:    " + srcPath
        Print "  hint: run the >> command above manually; if abc prints nothing,"
        Print "        abc.exe may be a broken/GUI binary - restore abc_host.exe or rebuild"
        Exit Function
    End If

    DeleteFile(StrPtr(objPath))
    If RunTool("abassembler.exe", asmPath, objPath) = 0 Then Exit Function
    If FileExists(objPath) = 0 Then
        Print "error: abassembler produced no .obj (assemble failed)"
        Print "  expected: " + objPath
        Print "  input:    " + asmPath
        Exit Function
    End If

    DeleteFile(StrPtr(exePath))
    If RunTool("ablinker.exe", objPath, exePath) = 0 Then Exit Function
    If FileExists(exePath) = 0 Then
        Print "error: ablinker produced no .exe (link failed)"
        Print "  expected: " + exePath
        Print "  input:    " + objPath
        Exit Function
    End If

    Print "OK: " + abpPath + " -> " + exePath
    ' #include 展開の中間（*.tmp / 旧 *_exp.abp）は成果物ではないので消す
    If srcPath <> abpPath Then
        DeleteFile(StrPtr(srcPath))
    End If
    BuildOne = 1
End Function

' --- メイン ---
Dim inPath[MAX_PATH] As Byte
Dim inName As String
Dim exePath As String
Dim cliOut As String
Dim i As Long
Dim tmp As String

If GetCmd(1, inPath) = 0 Then
    USAGE()
End If

inName = MakeStr(inPath)
cliOut = ParseCliOut$()
If gCliOutOk = 0 Then
    End
End If

' .pj 判定は EndsWithExt に頼らずインライン（AB の UDF 解決揺れ対策）
i = Len(inName)
tmp = ""
If i >= 3 Then
    tmp = Mid$(inName, i - 2, 3)
End If
If tmp = ".pj" Or tmp = ".PJ" Or tmp = ".Pj" Or tmp = ".pJ" Then
    If ParseProject(inName) = 0 Then
        End
    End If
    ' -o / 位置引数が .pj の #OUTPUT_RELEASE より優先
    If cliOut <> "" Then
        gOutExe = JoinPath$(gProjDir, cliOut)
    End If
    Print "project: " + inName
    tmp = Str$(gNSources)
    tmp = Trim$(tmp)
    Print "  sources: " + tmp
    For i = 0 To gNSources - 1
        Print "    " + gSources(i)
    Next
    Print "  output: " + gOutExe
    If CombineSources() = 0 Then
        End
    End If
    If BuildOne(gCombinedAbp, gOutExe) = 0 Then
        End
    End If
    ' *_combined.abp も中間
    If gCombinedAbp <> "" Then
        DeleteFile(StrPtr(gCombinedAbp))
    End If
Else
    If cliOut = "" Then
        exePath = BaseName$(inName) + ".exe"
    Else
        exePath = cliOut
    End If
    If BuildOne(inName, exePath) = 0 Then
        End
    End If
End If

End
