' StrTrim.abp - Trim$（前後の空白を除く）
' AB 4.20 に Trim$ は無いので Include\default には置かない。使うソースが取り込む。
' 空白はスペース、タブ、CR、LF。

Function StrTrim_IsSpace(c As Long) As Long
    StrTrim_IsSpace = 0
    If c = 32 Or c = 9 Then StrTrim_IsSpace = 1
    If c = 13 Or c = 10 Then StrTrim_IsSpace = 1
End Function

Function Trim$(s As String) As String
    Dim p As *Byte
    Dim i As Long
    Dim j As Long
    Dim n As Long
    n = Len(s)
    If n = 0 Then
        Trim$ = ""
        Exit Function
    End If
    p = StrPtr(s)
    i = 0
    While i < n And StrTrim_IsSpace(p[i]) <> 0
        i = i + 1
    Wend
    j = n - 1
    While j >= i And StrTrim_IsSpace(p[j]) <> 0
        j = j - 1
    Wend
    If j < i Then
        Trim$ = ""
    Else
        Trim$ = Mid$(s, i + 1, j - i + 1)
    End If
End Function
