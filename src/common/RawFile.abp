' ===================================================
'  RawFile - ファイル全体の読み書き
' ===================================================

Function FileOpenRead(path As *Byte) As HANDLE
    FileOpenRead = CreateFile(path, GENERIC_READ, FILE_SHARE_READ, ByVal NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL)
End Function

Function FileSizeOrZero(hFile As HANDLE) As Long
    Dim fsiz As Long
    fsiz = GetFileSize(hFile, 0 As DWordPtr)
    FileSizeOrZero = 0
    If fsiz > 0 Then FileSizeOrZero = fsiz
End Function

Function FileReadOk(p As *Byte, nRead As Long, sz As Long) As *Byte
    FileReadOk = 0
    If nRead <> sz Then free(p)
    If nRead <> sz Then Exit Function
    p[sz] = 0
    FileReadOk = p
End Function

Function FileAllocRead(hFile As HANDLE, fsiz As Long) As *Byte
    Dim nRead As Long
    Dim p As *Byte
    FileAllocRead = 0
    p = malloc(fsiz + 1)
    If p = 0 Then Exit Function
    ReadFile(hFile, p, fsiz, VarPtr(nRead), ByVal NULL)
    FileAllocRead = FileReadOk(p, nRead, fsiz)
End Function

Function FileReadSized(hFile As HANDLE, ByRef outSize As Long) As *Byte
    Dim fsiz As Long
    FileReadSized = 0
    fsiz = FileSizeOrZero(hFile)
    If fsiz <= 0 Then Exit Function
    FileReadSized = FileAllocRead(hFile, fsiz)
    If FileReadSized <> 0 Then outSize = fsiz
End Function

Function LoadFile(path As *Byte, ByRef outSize As Long) As *Byte
    Dim hFile As HANDLE
    LoadFile = 0
    outSize = 0
    hFile = FileOpenRead(path)
    If hFile = INVALID_HANDLE_VALUE Then Exit Function
    LoadFile = FileReadSized(hFile, outSize)
    CloseHandle(hFile)
End Function

Function WriteAll(path As *Byte, p As *Byte, size As Long) As Long
    Dim hFile As HANDLE
    Dim nWritten As Long
    WriteAll = 0
    hFile = CreateFile(path, GENERIC_WRITE, 0, ByVal NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL)
    If hFile = INVALID_HANDLE_VALUE Then Exit Function
    WriteFile(hFile, p, size, VarPtr(nWritten), ByVal NULL)
    CloseHandle(hFile)
    If nWritten = size Then WriteAll = 1
End Function
