' ExePath - 実行ファイルのパスと、そのディレクトリ
' ディレクトリは末尾の区切り文字を含む。区切りが無ければ空。

Function ExeModuleFile(dst As *Byte, cap As Long) As Long
    Dim n As Long
    ExeModuleFile = 0
    If dst = 0 Or cap <= 0 Then Exit Function
    dst[0] = 0
    n = GetModuleFileName(0, dst, cap)
    If n <= 0 Then dst[0] = 0
    If n <= 0 Then Exit Function
    ExeModuleFile = n
End Function

Function ExeLastSlash(path As *Byte) As *Byte
    Dim p As *Byte
    ExeLastSlash = 0
    If path = 0 Then Exit Function
    p = path
    While p[0] <> 0
        If p[0] = 92 Or p[0] = 47 Then ExeLastSlash = p
        p = VarPtr(p[1])
    Wend
End Function

Sub ExeCopyStop(ByVal src As *Byte, ByVal stopAt As *Byte, ByVal dst As *Byte)
    While src <> stopAt
        dst[0] = src[0]
        src = VarPtr(src[1])
        dst = VarPtr(dst[1])
    Wend
    dst[0] = 0
End Sub

Function ExeDirOf(path As *Byte, dst As *Byte) As Long
    Dim slash As *Byte
    ExeDirOf = 0
    If dst = 0 Then Exit Function
    dst[0] = 0
    slash = ExeLastSlash(path)
    If slash = 0 Then Exit Function
    ExeCopyStop(path, VarPtr(slash[1]), dst)
    ExeDirOf = 1
End Function
