#include "..\Utils.abp"
#include "..\Common.abp"
#include "..\FileIO.abp"
#console
Dim text As String
Dim oneLine As String
Dim eq As Long
text = LoadTextFile$("abpc.pj")
eq = InStr(1, text, "#PLATFORM=")
oneLine = Mid$(text, eq, 20)
Print "midlen=" + Str$(Len(oneLine))
Print "first20 done"
ExitProcess(0)
