' Expect: 332
#console

Type COFF_HEADER
    Machine As Word
    NumberOfSections As Word
    TimeDateStamp As DWord
    PointerToSymbolTable As DWord
    NumberOfSymbols As DWord
    SizeOfOptionalHeader As Word
    Characteristics As Word
End Type

Dim h As COFF_HEADER
h.Machine = &H14C
ExitProcess(h.Machine)
