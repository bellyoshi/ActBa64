Type SECURITY_ATTRIBUTES
    nLength As DWord
    lpSecurityDescriptor As Long
    bInheritHandle As Long
End Type

Type PROCESS_INFORMATION
    hProcess As HANDLE
    hThread As HANDLE
    dwProcessId As DWord
    dwThreadId As DWord
End Type

Type STARTUPINFO
    cb As DWord
    lpReserved As Long
    lpDesktop As Long
    lpTitle As Long
    dwX As DWord
    dwY As DWord
    dwXSize As DWord
    dwYSize As DWord
    dwXCountChars As DWord
    dwYCountChars As DWord
    dwFillAttribute As DWord
    dwFlags As DWord
    wShowWindow As Word
    cbReserved2 As Word
    lpReserved2 As Long
    hStdInput As HANDLE
    hStdOutput As HANDLE
    hStdError As HANDLE
End Type

' ---- Utils.abp ----
' Utils.abp - 文字列・パス共通ユーティリティ
' 各ツールは xxx.idx 経由で #include する（.pj の #SOURCE にも列挙）

Function IsSpace(c As Long) As Long
    If c = Asc(" ") Or c = 9 Or c = 13 Or c = 10 Then
        IsSpace = 1
    Else
        IsSpace = 0
    End If
End Function

Function Trim$(s As String) As String
    Dim p As *Byte
    Dim i As Long
    Dim j As Long
    Dim n As Long
    n = Len(s)
    If n = 0 Then
        Trim$ = ""
        Exit Function
    End If
    p = StrPtr(s)
    i = 0
    While i < n And IsSpace(p[i]) <> 0
        i = i + 1
    Wend
    j = n - 1
    While j >= i And IsSpace(p[j]) <> 0
        j = j - 1
    Wend
    If j < i Then
        Trim$ = ""
    Else
        Trim$ = Mid$(s, i + 1, j - i + 1)
    End If
End Function

Function Lower$(s As String) As String
    Dim p As *Byte
    Dim i As Long
    Dim n As Long
    Dim c As Long
    Dim r As String
    n = Len(s)
    If n = 0 Then
        Lower$ = ""
        Exit Function
    End If
    ' Mid$ で1回確保し、その場で小文字化（文字単位 + の O(n^2) を避ける）
    r = Mid$(s, 1, n)
    p = StrPtr(r)
    For i = 0 To n - 1
        c = p[i]
        If c >= Asc("A") And c <= Asc("Z") Then p[i] = c + 32
    Next
    Lower$ = r
End Function

' 大文字小文字を区別する前方一致
Function StartsWith(s As String, prefix As String) As Long
    Dim n As Long
    Dim m As Long
    n = Len(s)
    m = Len(prefix)
    If n < m Then
        StartsWith = 0
    ElseIf Left$(s, m) = prefix Then
        StartsWith = 1
    Else
        StartsWith = 0
    End If
End Function

' 大文字小文字を区別しない前方一致
Function StartsWithCI(s As String, prefix As String) As Long
    Dim n As Long
    Dim m As Long
    Dim a As String
    Dim b As String
    n = Len(s)
    m = Len(prefix)
    If n < m Then
        StartsWithCI = 0
        Exit Function
    End If
    If m = 0 Then
        StartsWithCI = 1
        Exit Function
    End If
    a = Left$(s, m)
    a = Lower$(a)
    b = Lower$(prefix)
    If a = b Then
        StartsWithCI = 1
    Else
        StartsWithCI = 0
    End If
End Function

' 拡張子を除いたパス（ディレクトリ含む）
Function BaseName$(inPath As String) As String
    Dim i As Long
    Dim n As Long
    Dim ch As String
    Dim dotPos As Long
    Dim slashPos As Long
    n = Len(inPath)
    dotPos = 0
    slashPos = 0
    For i = 1 To n
        ch = Mid$(inPath, i, 1)
        If ch = "\" Or ch = "/" Then
            slashPos = i
            dotPos = 0
        ElseIf ch = "." Then
            dotPos = i
        End If
    Next
    If dotPos > slashPos Then
        BaseName$ = Left$(inPath, dotPos - 1)
    Else
        BaseName$ = inPath
    End If
End Function

' ディレクトリ部分（末尾に \ または / を含む）。無ければ ""
Function DirOf$(path As String) As String
    Dim i As Long
    Dim n As Long
    Dim ch As String
    Dim slashPos As Long
    n = Len(path)
    slashPos = 0
    For i = 1 To n
        ch = Mid$(path, i, 1)
        If ch = "\" Or ch = "/" Then
            slashPos = i
        End If
    Next
    If slashPos > 0 Then
        DirOf$ = Left$(path, slashPos)
    Else
        DirOf$ = ""
    End If
End Function

Function FileNameOnly$(path As String) As String
    Dim d As String
    Dim n As Long
    d = DirOf$(path)
    n = Len(d)
    If n = 0 Then
        FileNameOnly$ = path
    Else
        FileNameOnly$ = Mid$(path, n + 1, Len(path) - n)
    End If
End Function

Function EndsWithExt(path As String, ext As String) As Long
    Dim n As Long
    Dim m As Long
    Dim i As Long
    Dim cp As Long
    Dim ce As Long
    Dim pp As *Byte
    Dim pe As *Byte
    n = Len(path)
    m = Len(ext)
    EndsWithExt = 0
    If n < m Then Exit Function
    If m = 0 Then
        EndsWithExt = 1
        Exit Function
    End If
    pp = StrPtr(path)
    pe = StrPtr(ext)
    For i = 0 To m - 1
        cp = pp[n - m + i]
        ce = pe[i]
        If cp >= Asc("A") And cp <= Asc("Z") Then cp = cp + 32
        If ce >= Asc("A") And ce <= Asc("Z") Then ce = ce + 32
        If cp <> ce Then Exit Function
    Next
    EndsWithExt = 1
End Function

' 拡張子を newExt（例: ".asm"）に置換したパスを返す
Function ChangeExtension$(inPath As String, newExt As String) As String
    Dim base As String
    base = BaseName$(inPath)
    ChangeExtension$ = base + newExt
End Function

' ---- Common.abp ----
' Common.abp - コマンド行・メモリ・書式の共通処理
' WinAPI 定数 (MAX_PATH / NULL 等) はホストヘッダまたは abc 組み込みを使う

Function GetCmd(cnt As Long, buf As *Byte) As Long
    Dim cmd As *Byte
    Dim cmdlen As Long
    Dim cidx As Long
    Dim ctmp[MAX_PATH] As Byte
    Dim n As Long
    Dim m As Long
    Dim pBuf As *Byte

    pBuf = buf
    cmd = GetCommandLine()
    cmdlen = lstrlen(cmd)
    cmd[cmdlen] = &H20
    pBuf[0] = 0
    cidx = 0

    For n = 0 To cmdlen
        If cmd[n] = &H20 And cmd[n + 1] = &H20 Then
            memcpy(VarPtr(cmd[n]), VarPtr(cmd[n + 1]), cmdlen - n)
            n = n - 1
            cmdlen = cmdlen - 1
        End If
    Next

    For n = 0 To cmdlen
        m = 0
        While cmd[n] <> &H20
            ctmp[m] = cmd[n]
            m = m + 1
            n = n + 1
        Wend
        ctmp[m] = 0
        If cidx = cnt Then
            lstrcpy(buf, ctmp)
            GetCmd = 1
            Exit Function
        End If
        cidx = cidx + 1
    Next
    GetCmd = 0
End Function

Sub ZeroMem(p As *Byte, n As Long)
    Dim i As Long
    Dim q As *Byte
    If n <= 0 Then Exit Sub
    q = p
    For i = 0 To n - 1
        q[i] = 0
    Next
End Sub

Function HexPad$(num As Long, digits As Long) As String
    Dim s As String
    s = Hex$(num)
    While Len(s) < digits
        s = "0" + s
    Wend
    HexPad$ = s
End Function

' ---- FileIO.abp ----
' FileIO.abp - ファイル入出力共通処理
' ホスト AB: ポインタ引数のみ ByVal NULL。HANDLE 等は NULL/0

Dim gLastLoadSize As Long
Dim gLoadPtr As *Byte

Function FileExists(path As String) As Long
    Dim attr As DWord
    attr = GetFileAttributes(StrPtr(path))
    If attr = &HFFFFFFFF Then
        FileExists = 0
    Else
        FileExists = 1
    End If
End Function

' Function 戻り (*Byte) が壊れることがあるため、結果は gLoadPtr / gLastLoadSize へ
Sub LoadFileToGlobal(path As *Byte)
    Dim hFile As HANDLE
    Dim fsiz As Long
    Dim nRead As DWord
    Dim p As *Byte

    gLoadPtr = 0
    gLastLoadSize = 0

    hFile = CreateFile(path, GENERIC_READ, FILE_SHARE_READ, ByVal NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL)
    If hFile = INVALID_HANDLE_VALUE Then Exit Sub

    fsiz = GetFileSize(hFile, NULL)
    If fsiz <= 0 Then
        CloseHandle(hFile)
        Exit Sub
    End If

    p = malloc(fsiz + 1)
    If p = 0 Then
        CloseHandle(hFile)
        Exit Sub
    End If

    ReadFile(hFile, p, fsiz, VarPtr(nRead), ByVal NULL)
    CloseHandle(hFile)
    p[fsiz] = 0
    gLastLoadSize = fsiz
    gLoadPtr = p
End Sub

Function LoadFile(path As *Byte, ByRef outSize As Long) As *Byte
    LoadFileToGlobal(path)
    outSize = gLastLoadSize
    LoadFile = gLoadPtr
End Function

Function WriteAll(path As *Byte, p As *Byte, size As Long) As Long
    Dim hFile As HANDLE
    Dim nWritten As DWord

    WriteAll = 0
    hFile = CreateFile(path, GENERIC_WRITE, 0, ByVal NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL)
    If hFile = INVALID_HANDLE_VALUE Then Exit Function

    WriteFile(hFile, p, size, VarPtr(nWritten), ByVal NULL)
    CloseHandle(hFile)
    If nWritten = size Then WriteAll = 1
End Function

Function LoadTextFile$(path As String) As String
    Dim hFile As HANDLE
    Dim fsiz As Long
    Dim nRead As DWord
    Dim p As *Byte

    LoadTextFile$ = ""
    hFile = CreateFile(StrPtr(path), GENERIC_READ, FILE_SHARE_READ, ByVal NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL)
    If hFile = INVALID_HANDLE_VALUE Then
        Print "cannot open: " + path
        Exit Function
    End If
    fsiz = GetFileSize(hFile, NULL)
    If fsiz < 0 Then
        CloseHandle(hFile)
        Exit Function
    End If
    p = malloc(fsiz + 1)
    If p = 0 Then
        CloseHandle(hFile)
        Exit Function
    End If
    If fsiz > 0 Then
        ReadFile(hFile, p, fsiz, VarPtr(nRead), ByVal NULL)
    End If
    CloseHandle(hFile)
    p[fsiz] = 0
    LoadTextFile$ = MakeStr(p)
    free(p)
End Function

Function WriteTextFile(path As String, text As String) As Long
    Dim hFile As HANDLE
    Dim nWritten As DWord
    Dim n As Long

    WriteTextFile = 0
    n = Len(text)
    hFile = CreateFile(StrPtr(path), GENERIC_WRITE, 0, ByVal NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL)
    If hFile = INVALID_HANDLE_VALUE Then Exit Function
    If n > 0 Then
        WriteFile(hFile, StrPtr(text), n, VarPtr(nWritten), ByVal NULL)
    Else
        nWritten = 0
    End If
    CloseHandle(hFile)
    If nWritten = n Then
        WriteTextFile = 1
    End If
End Function

' ---- StringBuffer.abp ----
' StringBuffer.abp - 可変長バイトバッファ（クラスなし）
' 巨大な String 連結の O(n^2) を避けるため、末尾追記 + 倍増確保
' 注: abc は base->field[i] 未対応のため、添字は一時 *Byte 経由

Const SB_INIT_CAP = 4096

Type StringBuffer
    p As *Byte
    len As Long
    cap As Long
End Type

Sub SbInit(sb As *StringBuffer)
    sb->p = 0
    sb->len = 0
    sb->cap = 0
End Sub

Sub SbFree(sb As *StringBuffer)
    Dim p As *Byte
    p = sb->p
    If p <> 0 Then
        free(p)
    End If
    sb->p = 0
    sb->len = 0
    sb->cap = 0
End Sub

Sub SbClear(sb As *StringBuffer)
    Dim p As *Byte
    sb->len = 0
    p = sb->p
    If p <> 0 Then
        p[0] = 0
    End If
End Sub

Function SbEnsure(sb As *StringBuffer, need As Long) As Long
    Dim np As *Byte
    Dim ncap As Long
    Dim op As *Byte
    Dim n As Long
    SbEnsure = 0
    If need <= sb->cap Then
        SbEnsure = 1
        Exit Function
    End If
    ncap = sb->cap
    If ncap <= 0 Then ncap = SB_INIT_CAP
    While ncap < need
        ncap = ncap * 2
    Wend
    np = malloc(ncap)
    If np = 0 Then
        Print "StringBuffer: out of memory"
        Exit Function
    End If
    n = sb->len
    op = sb->p
    If n > 0 And op <> 0 Then
        memcpy(np, op, n)
    End If
    If op <> 0 Then
        free(op)
    End If
    sb->p = np
    sb->cap = ncap
    SbEnsure = 1
End Function

Sub SbAppendBytes(sb As *StringBuffer, src As *Byte, n As Long)
    Dim p As *Byte
    Dim off As Long
    If n <= 0 Then Exit Sub
    If SbEnsure(sb, sb->len + n + 1) = 0 Then
        ExitProcess(1)
    End If
    p = sb->p
    off = sb->len
    memcpy(VarPtr(p[off]), src, n)
    off = off + n
    sb->len = off
    p[off] = 0
End Sub

Sub SbAppendStr(sb As *StringBuffer, s As String)
    Dim n As Long
    n = Len(s)
    If n <= 0 Then Exit Sub
    SbAppendBytes(sb, StrPtr(s), n)
End Sub

Sub SbAppendCRLF(sb As *StringBuffer)
    Dim crlf[2] As Byte
    crlf[0] = 13
    crlf[1] = 10
    SbAppendBytes(sb, crlf, 2)
End Sub

Sub SbAppendSb(dst As *StringBuffer, src As *StringBuffer)
    Dim sp As *Byte
    Dim n As Long
    n = src->len
    If n <= 0 Then Exit Sub
    sp = src->p
    SbAppendBytes(dst, sp, n)
End Sub

Sub SbAppendByte(sb As *StringBuffer, b As Long)
    Dim p As *Byte
    Dim off As Long
    If SbEnsure(sb, sb->len + 2) = 0 Then
        ExitProcess(1)
    End If
    p = sb->p
    off = sb->len
    p[off] = b And &HFF
    off = off + 1
    sb->len = off
    p[off] = 0
End Sub

Sub SbAppendZeros(sb As *StringBuffer, n As Long)
    Dim p As *Byte
    Dim off As Long
    If n <= 0 Then Exit Sub
    If SbEnsure(sb, sb->len + n + 1) = 0 Then
        ExitProcess(1)
    End If
    p = sb->p
    off = sb->len
    ZeroMem(VarPtr(p[off]), n)
    off = off + n
    sb->len = off
    p[off] = 0
End Sub

' dst を解放し、src の所有権を移す（src は空になる）
Sub SbMove(dst As *StringBuffer, src As *StringBuffer)
    Dim p As *Byte
    p = dst->p
    If p <> 0 Then
        free(p)
    End If
    dst->p = src->p
    dst->len = src->len
    dst->cap = src->cap
    src->p = 0
    src->len = 0
    src->cap = 0
End Sub

Function SbLen(sb As *StringBuffer) As Long
    SbLen = sb->len
End Function

Function SbData(sb As *StringBuffer) As *Byte
    SbData = sb->p
End Function

Function SbIsEmpty(sb As *StringBuffer) As Long
    If sb->len <= 0 Then
        SbIsEmpty = 1
    Else
        SbIsEmpty = 0
    End If
End Function

Function SbToString$(sb As *StringBuffer) As String
    Dim p As *Byte
    Dim n As Long
    p = sb->p
    n = sb->len
    If p = 0 Or n <= 0 Then
        SbToString$ = ""
    Else
        p[n] = 0
        SbToString$ = MakeStr(p)
    End If
End Function

' ---- abpc.abp ----
