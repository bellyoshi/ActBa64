' ???W?? 0..7?B?p?X?? p?A?I???? q?B
' Expect: 0
#console

Const BOARD_SIZE = 8
Const BOARD_MAX = 63
Const EMPTY = 0
Const BLACK = 1
Const WHITE = 2

Dim Board(BOARD_MAX) As Long
Dim CurrentTurn As Long
Dim dx(7) As Long
Dim dy(7) As Long

Function Cell(x As Long, y As Long) As Long
    Cell = x + y * BOARD_SIZE
End Function

Sub InitDirs()
    dx(0) = -1
    dy(0) = -1
    dx(1) = 0
    dy(1) = -1
    dx(2) = 1
    dy(2) = -1
    dx(3) = -1
    dy(3) = 0
    dx(4) = 1
    dy(4) = 0
    dx(5) = -1
    dy(5) = 1
    dx(6) = 0
    dy(6) = 1
    dx(7) = 1
    dy(7) = 1
End Sub

Sub InitBoard()
    Dim x As Long
    Dim y As Long
    For y = 0 To BOARD_SIZE - 1
        For x = 0 To BOARD_SIZE - 1
            Board(Cell(x, y)) = EMPTY
        Next
    Next
    Board(Cell(3, 3)) = WHITE
    Board(Cell(4, 3)) = BLACK
    Board(Cell(3, 4)) = BLACK
    Board(Cell(4, 4)) = WHITE
    CurrentTurn = BLACK
End Sub

Sub DrawBoard()
    Dim x As Long
    Dim y As Long
    Dim v As Long
    Dim row As String
    Print "  0 1 2 3 4 5 6 7"
    For y = 0 To BOARD_SIZE - 1
        row = Str$(y) + " "
        For x = 0 To BOARD_SIZE - 1
            v = Board(Cell(x, y))
            If v = EMPTY Then
                row = row + ". "
            ElseIf v = BLACK Then
                row = row + "O "
            Else
                row = row + "X "
            End If
        Next
        Print row
    Next
    Print ""
    If CurrentTurn = BLACK Then
        Print "turn: O (black)"
    Else
        Print "turn: X (white)"
    End If
End Sub

Function CanFlipDirection(x As Long, y As Long, dirX As Long, dirY As Long, player As Long) As Long
    Dim opponent As Long
    Dim nx As Long
    Dim ny As Long
    Dim count As Long
    CanFlipDirection = 0
    If player = BLACK Then
        opponent = WHITE
    Else
        opponent = BLACK
    End If
    nx = x + dirX
    ny = y + dirY
    count = 0
    While nx >= 0
        If nx >= BOARD_SIZE Then Exit While
        If ny < 0 Then Exit While
        If ny >= BOARD_SIZE Then Exit While
        If Board(Cell(nx, ny)) = opponent Then
            count = count + 1
        ElseIf Board(Cell(nx, ny)) = player Then
            If count > 0 Then
                CanFlipDirection = 1
            End If
            Exit While
        Else
            Exit While
        End If
        nx = nx + dirX
        ny = ny + dirY
    Wend
End Function

Function CanPut(x As Long, y As Long, player As Long) As Long
    Dim i As Long
    CanPut = 0
    If x < 0 Then Exit Function
    If x >= BOARD_SIZE Then Exit Function
    If y < 0 Then Exit Function
    If y >= BOARD_SIZE Then Exit Function
    If Board(Cell(x, y)) <> EMPTY Then Exit Function
    For i = 0 To 7
        If CanFlipDirection(x, y, dx(i), dy(i), player) = 1 Then
            CanPut = 1
            Exit Function
        End If
    Next
End Function

Function HasAnyMove(player As Long) As Long
    Dim x As Long
    Dim y As Long
    HasAnyMove = 0
    For y = 0 To BOARD_SIZE - 1
        For x = 0 To BOARD_SIZE - 1
            If CanPut(x, y, player) = 1 Then
                HasAnyMove = 1
                Exit Function
            End If
        Next
    Next
End Function

Sub FlipAndPut(x As Long, y As Long, player As Long)
    Dim i As Long
    Dim opponent As Long
    Dim nx As Long
    Dim ny As Long
    If player = BLACK Then
        opponent = WHITE
    Else
        opponent = BLACK
    End If
    Board(Cell(x, y)) = player
    For i = 0 To 7
        If CanFlipDirection(x, y, dx(i), dy(i), player) = 1 Then
            nx = x + dx(i)
            ny = y + dy(i)
            While Board(Cell(nx, ny)) = opponent
                Board(Cell(nx, ny)) = player
                nx = nx + dx(i)
                ny = ny + dy(i)
            Wend
        End If
    Next
End Sub

Sub SwitchTurn()
    If CurrentTurn = BLACK Then
        CurrentTurn = WHITE
    Else
        CurrentTurn = BLACK
    End If
End Sub

Function CountPieces(player As Long) As Long
    Dim i As Long
    Dim n As Long
    n = 0
    For i = 0 To BOARD_MAX
        If Board(i) = player Then
            n = n + 1
        End If
    Next
    CountPieces = n
End Function

Sub ShowScore()
    Dim b As Long
    Dim w As Long
    b = CountPieces(BLACK)
    w = CountPieces(WHITE)
    Print "score O=" + Str$(b) + " X=" + Str$(w)
    If b > w Then
        Print "O wins"
    ElseIf w > b Then
        Print "X wins"
    Else
        Print "draw"
    End If
End Sub

Dim x As Long
Dim y As Long
Dim cmd As String
Dim running As Long
Dim passed As Long

InitDirs()
InitBoard()

Print "reversi: enter x then y (0-7). pass=p quit=q"
running = 1
passed = 0
While running <> 0
    DrawBoard()
    If HasAnyMove(CurrentTurn) = 0 Then
        Print "no move - pass"
        SwitchTurn()
        passed = passed + 1
        If passed >= 2 Then
            ShowScore()
            running = 0
        End If
    Else
        passed = 0
        Print "command (x / p / q):"
        Input cmd
        If Len(cmd) = 0 Then
            Print "empty input - quit"
            ShowScore()
            running = 0
        ElseIf Asc(cmd) = Asc("q") Then
            ShowScore()
            running = 0
        ElseIf Asc(cmd) = Asc("Q") Then
            ShowScore()
            running = 0
        ElseIf Asc(cmd) = Asc("p") Then
            SwitchTurn()
        ElseIf Asc(cmd) = Asc("P") Then
            SwitchTurn()
        Else
            x = Val(cmd)
            Print "y:"
            Input y
            If CanPut(x, y, CurrentTurn) = 1 Then
                FlipAndPut(x, y, CurrentTurn)
                SwitchTurn()
            Else
                Print "illegal move"
            End If
        End If
    End If
Wend

ExitProcess(0)
