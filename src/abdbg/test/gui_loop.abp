' GUI のメッセージループの先頭の Debug（AB4 の使用例と同じ形）。タイマーで 3 回回って終わる
Dim msgMain As MSG, iResult As Long, n As Long
SetTimer(0, 0, 30, 0)
Do
	Debug
	iResult = GetMessage(msgMain, 0, 0, 0)
	If iResult = 0 Or iResult = -1 Then Exit Do
	n = n + 1
	If n >= 3 Then PostQuitMessage(0)
	DispatchMessage(msgMain)
Loop
End
