#console
Type Pt
    x As Long
    y As Long
End Type
Type Box
    name As String
    p As Pt
    v(2) As Integer
    d As Double
End Type
Dim gCount As Long
Dim gName As String
Dim gBox As Box

Sub Show(s As String, ByRef b As Box, pp As *Pt)
    Dim w As Word, i As Integer, bt As Byte, dw As DWord, q As QWord, i6 As Int64
    Dim sg As Single, db As Double, vp As VoidPtr, ok As BOOL
    Dim a(3) As Long, sa(1) As String
    w = 65535
    i = -5
    bt = 200
    dw = &HFFFFFFFF
    q = 1234567890123
    i6 = -9876543210
    sg = 1.5
    db = -2.25
    vp = pp
    ok = TRUE
    a(0) = 10 : a(3) = 40
    sa(0) = "x" : sa(1) = "yz"
    Print s
End Sub

Dim pt As Pt
pt.x = 3 : pt.y = 4
gCount = 7
gName = "hello"
gBox.name = "box1"
gBox.p.x = 11
gBox.v[1] = -2
gBox.d = 0.5
Show("arg", gBox, VarPtr(pt))
