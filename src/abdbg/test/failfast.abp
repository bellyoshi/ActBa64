#console
' CI の Windows Server では、例外を続けると OS が配る途中で fail fast（c0000409）になる。
' ベクタ例外ハンドラーから RaiseFailFastException を呼んで同じ流れを作る
Declare Function AddVectoredExceptionHandler Lib "kernel32.dll" (ByVal first As DWord, ByVal h As VoidPtr) As VoidPtr
Declare Sub RaiseFailFastException Lib "kernel32.dll" (ByVal rec As VoidPtr, ByVal ctx As VoidPtr, ByVal flags As DWord)

Function OnExc(info As VoidPtr) As Long
    Dim rec[160] As Byte
    Dim pc As *Long
    pc = VarPtr(rec[0]) As *Long
    pc[0] = &HC0000409
    RaiseFailFastException(VarPtr(rec[0]), 0, 0)
    OnExc = 0
End Function

Sub Poke(p As *Long)
    p[0] = 5
End Sub

AddVectoredExceptionHandler(1, AddressOf(OnExc))
Print "before"
Poke(0)
Print "after"
