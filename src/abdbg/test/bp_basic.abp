#console
Type Pt
    x As Long
    y As Long
End Type
Dim g As Long
Dim gs As String

Function Add(a As Long, b As Long) As Long
    Dim t As Long
    t = a + b
    Add = t
End Function

Sub Show(s As String, ByRef p As Pt)
    Dim d As Double
    d = 1.5
    Print s; p.x; d
End Sub

Dim i As Long
Dim q As Pt
For i = 1 To 3
    g = Add(g, i)
Next
q.x = g
gs = "sum"
Show(gs, q)
If g > 5 Then
    Print "big"
Else
    Print "small"
End If
Debug
Print "end"
