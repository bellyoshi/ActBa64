' AdVec - 伸びる Long の列と、決まった幅の名前の列

Type AdVec
    p As *Long
    n As Long
    cap As Long
End Type

Type AdNames
    p As *Byte
    stride As Long
    n As Long
    cap As Long
End Type

' 戻り値 1 : 入る  0 : メモリが足りない
Function AdVecReserve(v As *AdVec) As Long
    Dim nc As Long
    Dim q As *Long
    AdVecReserve = 1
    If v->n < v->cap Then Exit Function
    nc = v->cap * 2 + 256
    q = calloc(nc * 4)
    AdVecReserve = 0
    If q <> 0 Then AdVecReserve = AdVecMove(v, q, nc)
End Function

Function AdVecMove(v As *AdVec, q As *Long, nc As Long) As Long
    If v->n > 0 Then memcpy(q, v->p, v->n * 4)
    If v->p <> 0 Then free(v->p)
    v->p = q
    v->cap = nc
    AdVecMove = 1
End Function

' 足した番号（足せなければ -1）
Function AdVecPush(v As *AdVec, x As Long) As Long
    Dim p As *Long
    AdVecPush = -1
    If AdVecReserve(v) = 0 Then Exit Function
    p = v->p
    p[v->n] = x
    AdVecPush = v->n
    v->n = v->n + 1
End Function

Function AdVecAt(v As *AdVec, i As Long) As Long
    Dim p As *Long
    p = v->p
    AdVecAt = p[i]
End Function

Sub AdVecSet(v As *AdVec, i As Long, x As Long)
    Dim p As *Long
    p = v->p
    p[i] = x
End Sub

' ---- 名前 ----

Sub AdNamesInit(t As *AdNames, stride As Long)
    t->p = 0
    t->stride = stride
    t->n = 0
    t->cap = 0
End Sub

Function AdNamesReserve(t As *AdNames) As Long
    Dim nc As Long
    Dim q As *Byte
    AdNamesReserve = 1
    If t->n < t->cap Then Exit Function
    nc = t->cap * 2 + 64
    q = calloc(nc * t->stride)
    AdNamesReserve = 0
    If q <> 0 Then AdNamesReserve = AdNamesMove(t, q, nc)
End Function

Function AdNamesMove(t As *AdNames, q As *Byte, nc As Long) As Long
    If t->n > 0 Then memcpy(q, t->p, t->n * t->stride)
    If t->p <> 0 Then free(t->p)
    t->p = q
    t->cap = nc
    AdNamesMove = 1
End Function

Function AdNamesAt(t As *AdNames, i As Long) As *Byte
    Dim p As *Byte
    p = t->p
    AdNamesAt = VarPtr(p[i * t->stride])
End Function

' s から n バイト（stride - 1 まで）を足す
Function AdNamesPush(t As *AdNames, s As *Byte, n As Long) As Long
    AdNamesPush = -1
    If AdNamesReserve(t) = 0 Then Exit Function
    AdNamesCopy(AdNamesAt(t, t->n), s, n, t->stride)
    AdNamesPush = t->n
    t->n = t->n + 1
End Function

Sub AdNamesCopy(d As *Byte, s As *Byte, n As Long, stride As Long)
    If n > stride - 1 Then n = stride - 1
    If n > 0 Then memcpy(d, s, n)
    d[n] = 0
End Sub
