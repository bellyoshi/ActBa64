Sub coreBridgeDeleteCharBeforeCursor()
    TextBuf_Delete()
End Sub

Sub coreBridgeMoveCursor(dir As String)
    If dir = "left" Then
        TextBuf_MoveCursorLeft()
    ElseIf dir = "right" Then
        TextBuf_MoveCursorRight()
    ElseIf dir = "up" Then
        TextBuf_MoveCursorUp()
    ElseIf dir = "down" Then
        TextBuf_MoveCursorDown()
    End If
End Sub

Sub coreBridgeMoveCursorTo(ByVal newIndex As Long)
    TextBuf_MoveCursorTo(newIndex)
    TextBuf_SyncPreferredCol()
End Sub

Function coreBridgeLineCount() As Long
    coreBridgeLineCount = TextBuf_LineCount()
End Function

Function coreBridgeGetLineStart(ByVal lineNo As Long) As Long
    coreBridgeGetLineStart = TextBuf_GetLineStart(lineNo)
End Function

Sub coreBridgeMoveCursorToLine(ByVal lineNo As Long)
    TextBuf_MoveCursorTo(TextBuf_GetLineStart(lineNo))
    TextBuf_SyncPreferredCol()
End Sub

Sub coreBridgeScrollBy(hWnd As HWND, ByVal deltaLines As Long)
    VirtualScroll_By(hWnd, deltaLines)
End Sub

Sub coreBridgeEnsureCursorVisible(hWnd As HWND)
    VirtualScroll_EnsureCursorVisible(hWnd)
End Sub

Sub coreBridgeClick(hWnd As HWND, ByVal x As Long, ByVal y As Long)
    TextBuf_ClearSelection()
    EditorHitTestClick(hWnd, x, y)
End Sub
