' AB4 デザイナーの右の欄（幅 AB4D_PANEL_W）。上に「- コントロール -」の道具箱（AB 4.20 と同じ並び）、
' その下に選んだ部品か窓のプロパティ（Ab4DesignProp.sbp）。
' 道具を選んでから窓の中を押すと、その種類の部品を既定の大きさで足す。引けば引いた四角で足す。
' 足したら道具はポインタに戻り、足した部品を選ぶ。Del で選んだ部品を消す。Esc で道具と選びをやめる。

Const AB4D_PANEL_W = 214                    ' 右の欄の幅
Const AB4D_TOOL_CELL = 31                   ' 道具の絵のボタン 1 つ分（30 x 30 と 1 の隙間）
Const AB4D_TOOL_GAP = 16                    ' 左の 3 列と右の 2 列のあいだ
Const AB4D_TOOL_N = 17                      ' 道具の数（ポインタ + 16 種類）
Const AB4D_DRAG_NEW = 32                    ' g_a4Drag: 道具で部品の四角を引いている

Dim g_a4Tool As Long                        ' 選んでいる道具の種類（0 はポインタ）
Dim g_a4Hover As Long                       ' マウスの下の道具（-1 は無し。下の帯に名前を出す）

' 表示言語が日本語なら ja、そうでなければ en
Function Ab4D_L$(ja As String, en As String) As String
    Ab4D_L$ = ja
    If UiText$(UI_TAB_CODE) = "Code" Then Ab4D_L$ = en
End Function

Function Ab4D_PanelX(ByRef rc As RECT) As Long
    Ab4D_PanelX = rc.right - AB4D_PANEL_W
End Function

' 道具 k（0..16）の種類と、道具箱の中の列（0..4）・段（0..4）。AB 4.20 と同じく左に 3 列、右に 2 列
'   段 0: ポインタ / 1: テキスト エディット グループ | リストビュー リスト / 2: ボタン チェック ラジオ | コンボ ツリー
'   段 3: 横スクロール 縦スクロール アップダウン | イメージ / 4: トラックバー プログレス
Function Ab4D_ToolPos$() As String
    Ab4D_ToolPos$ = "00 0 0 11 0 1 04 1 1 05 2 1 09 3 1 08 4 1 01 0 2 02 1 2 10 2 2 03 3 2 12 4 2 06 0 3 13 1 3 14 2 3 07 3 3 16 0 4 15 1 4 "
End Function

Function Ab4D_ToolType(ByVal k As Long) As Long
    Ab4D_ToolType = Val(Mid$(Ab4D_ToolPos$(), k * 7 + 1, 2))
End Function

' 種類 t の道具の名前
Function Ab4D_ToolLabel$(ByVal t As Long) As String
    Dim k As Long
    Ab4D_ToolLabel$ = ""
    For k = 0 To AB4D_TOOL_N - 1
        If Ab4D_ToolType(k) = t Then Ab4D_ToolLabel$ = Ab4D_ToolName$(k)
    Next
End Function

Function Ab4D_ToolName$(ByVal k As Long) As String
    Dim ja As String, en As String
    ja = "ポインタ|テキスト|エディット|グループ|リストビュー|リスト|ボタン|チェック|ラジオ|コンボ|ツリービュー|横スクロール|縦スクロール|アップダウン|イメージ|トラックバー|プログレス"
    en = "Pointer|Static|EditBox|GroupBox|ListView|ListBox|Button|CheckBox|Radio|ComboBox|TreeView|HScrollBar|VScrollBar|UpDown|ImageBox|TrackBar|ProgressBar"
    Ab4D_ToolName$ = Ab4D_Nth$(Ab4D_L$(ja, en), "|", k + 1)
End Function

Function Ab4D_ToolTop() As Long
    Ab4D_ToolTop = DOCTAB_H + 24
End Function

' 道具箱の下端（プロパティはここから下）
Function Ab4D_ToolBottom() As Long
    Ab4D_ToolBottom = Ab4D_ToolTop() + 5 * AB4D_TOOL_CELL
End Function

Sub Ab4D_ToolRect(ByRef rc As RECT, ByVal k As Long, ByRef r As RECT)
    Dim x As Long, y As Long
    Dim c As Long
    c = Val(Mid$(Ab4D_ToolPos$(), k * 7 + 4, 1))
    x = Ab4D_PanelX(rc) + 8 + c * AB4D_TOOL_CELL
    If c >= 3 Then x = x + AB4D_TOOL_GAP
    y = Ab4D_ToolTop() + Val(Mid$(Ab4D_ToolPos$(), k * 7 + 6, 1)) * AB4D_TOOL_CELL
    FormDesign_Rect(r, x, y, x + AB4D_TOOL_CELL - 1, y + AB4D_TOOL_CELL - 1)
End Sub

' 見出し（- 文字 -）を y に、欄の真ん中に
Sub Ab4D_PanelHead(hDC As HDC, ByRef rc As RECT, ByVal y As Long, s As String)
    Dim r As RECT
    FormDesign_Rect(r, Ab4D_PanelX(rc), y, rc.right, y + 18)
    Ui_TextColor(hDC, Ui_SysColor(COLOR_BTNTEXT))
    Ui_TextCenter(hDC, r, "- " & s & " -")
End Sub

Sub Ab4D_DrawTool(hDC As HDC, ByRef rc As RECT, ByVal k As Long)
    Dim r As RECT, d As Long
    Ab4D_ToolRect(rc, k, r)
    d = Ab4D_ToolFrame(hDC, r, Ab4D_ToolType(k) = g_a4Tool)
    Ab4D_DrawIcon(hDC, r.left + 5 + d, r.top + 5 + d, Ab4D_ToolType(k))
End Sub

' 道具のボタンの枠。選んでいれば押し込んだ形にして 1（絵を 1 ずらす）
Function Ab4D_ToolFrame(hDC As HDC, ByRef r As RECT, ByVal down As Long) As Long
    Ab4D_ToolFrame = 0
    If down = 0 Then Ui_ButtonFrame(hDC, r, DFCS_BUTTONPUSH) : Exit Function
    FormDesign_Fill(hDC, r.left, r.top, r.right, r.bottom, RGB(232, 232, 236))
    Ui_Edge(hDC, r, EDGE_SUNKEN, BF_RECT)
    Ab4D_ToolFrame = 1
End Function

Sub Ab4D_DrawPanel(hDC As HDC, hWnd As HWND, ByRef rc As RECT)
    Dim x As Long
    x = Ab4D_PanelX(rc)
    FormDesign_Fill(hDC, x, DOCTAB_H, rc.right, rc.bottom - AB4D_INFO_H, Ui_SysColor(COLOR_BTNFACE))
    FormDesign_Fill(hDC, x, DOCTAB_H, x + 1, rc.bottom - AB4D_INFO_H, RGB(160, 160, 170))
    Ab4D_PanelHead(hDC, rc, DOCTAB_H + 4, Ab4D_L$("コントロール", "Controls"))
    Ab4D_DrawTools(hDC, rc)
    Ab4D_DrawProps(hDC, hWnd, rc)
End Sub

Sub Ab4D_DrawTools(hDC As HDC, ByRef rc As RECT)
    Dim k As Long
    For k = 0 To AB4D_TOOL_N - 1
        Ab4D_DrawTool(hDC, rc, k)
    Next
End Sub

' 点の上の道具（無ければ -1）
Function Ab4D_ToolAt(hWnd As HWND, ByVal x As Long, ByVal y As Long) As Long
    Dim rc As RECT, r As RECT, k As Long
    Ui_ClientRect(hWnd, rc)
    Ab4D_ToolAt = -1
    For k = 0 To AB4D_TOOL_N - 1
        Ab4D_ToolRect(rc, k, r)
        If FormDesign_In(x, y, r.left, r.top, r.right - r.left, r.bottom - r.top) <> 0 Then Ab4D_ToolAt = k
    Next
End Function

' 道具箱を押した。道具の上なら選んで 1
Function Ab4D_ToolDown(hWnd As HWND, ByVal x As Long, ByVal y As Long) As Long
    Dim k As Long
    k = Ab4D_ToolAt(hWnd, x, y)
    Ab4D_ToolDown = 0
    If k < 0 Then Exit Function
    g_a4Tool = Ab4D_ToolType(k)
    Ab4D_ToolDown = 1
End Function

' 引いていないときのマウスの動き。道具の上に来たら、下の帯にその名前を出す
Sub Ab4D_Hover(hWnd As HWND, ByVal lParam As LPARAM)
    Dim x As Long, y As Long, k As Long
    EditorSelect_XY(lParam, x, y)
    k = Ab4D_ToolAt(hWnd, x, y)
    If k = g_a4Hover Then Exit Sub
    g_a4Hover = k
    InvalidateRect(hWnd, ByVal 0, FALSE)
End Sub

' 下の帯の文字: 道具の上なら道具の名前、道具を選んでいればその名前と使い方。どちらでもなければ ""
Function Ab4D_ToolInfo$() As String
    Ab4D_ToolInfo$ = ""
    If g_a4Hover >= 0 Then Ab4D_ToolInfo$ = Ab4D_ToolName$(g_a4Hover)
    If g_a4Hover >= 0 Or g_a4Tool = 0 Then Exit Function
    Ab4D_ToolInfo$ = Ab4D_ToolLabel$(g_a4Tool) & Ab4D_L$(": 窓の中を押すか引いて足す", ": click or drag in a window to add")
End Function

' ---- 道具で足す ----

' 点が窓のクライアントの中なら 1。w に窓、cx, cy にクライアントの中の位置
Function Ab4D_ClientAt(ByVal x As Long, ByVal y As Long, ByRef w As Long, ByRef cx As Long, ByRef cy As Long) As Long
    Dim k As Long
    Ab4D_ClientAt = 0
    k = Ab4D_ClientWin(x, y)
    If k < 0 Then Exit Function
    w = k : cx = x - Ab4D_ClientX(k) : cy = y - Ab4D_ClientY(k)
    Ab4D_ClientAt = 1
End Function

' x, y が中にある窓（上に描いたものから。無ければ -1）
Function Ab4D_ClientWin(ByVal x As Long, ByVal y As Long) As Long
    Dim k As Long
    For k = g_rwCount - 1 To 0 Step -1
        If Ab4D_InClient(k, x, y) <> 0 Then Exit For
    Next
    Ab4D_ClientWin = k
End Function

' 点が窓 k のクライアント（枠と見出しの帯の内側）の中なら 1
Function Ab4D_InClient(ByVal k As Long, ByVal x As Long, ByVal y As Long) As Long
    Dim lx As Long, ly As Long, cw As Long, ch As Long
    lx = x - Ab4D_ClientX(k)
    ly = y - Ab4D_ClientY(k)
    cw = Ab4D_WinW(k) - 8
    ch = Ab4D_WinH(k) - 8 - Ui_CaptionH()
    Ab4D_InClient = 0
    If lx >= 0 And ly >= 0 And lx < cw And ly < ch Then Ab4D_InClient = 1
End Function

' 道具を選んで窓の中を押した。引き始める（離したときに足す）
Function Ab4D_NewDown(hWnd As HWND, ByVal x As Long, ByVal y As Long) As Long
    Dim w As Long, cx As Long, cy As Long
    Ab4D_NewDown = 0
    If g_a4Tool = 0 Then Exit Function
    Ab4D_NewDown = 1
    If Ab4D_ClientAt(x, y, w, cx, cy) = 0 Then Exit Function
    Ab4D_Unselect()
    g_a4Win = w : g_a4Drag = AB4D_DRAG_NEW
    g_a4CX0 = cx : g_a4CY0 = cy : g_a4CX = cx : g_a4CY = cy : g_a4CW = 0 : g_a4CH = 0
End Function

' 引いている間の四角（左上と大きさにそろえる）
Sub Ab4D_NewMove(ByVal dx As Long, ByVal dy As Long)
    g_a4CX = g_a4CX0 : g_a4CY = g_a4CY0 : g_a4CW = dx : g_a4CH = dy
    If dx < 0 Then g_a4CX = g_a4CX0 + dx : g_a4CW = -dx
    If dy < 0 Then g_a4CY = g_a4CY0 + dy : g_a4CH = -dy
End Sub

' 離した。少ししか引いていなければ既定の大きさで足す
Function Ab4D_NewText$(t As String) As String
    If g_a4CW < 4 Or g_a4CH < 4 Then
        Ab4D_NewText$ = Ab4D_AddItem$(t, g_a4Win, g_a4Tool, g_a4CX0, g_a4CY0)
    Else
        Ab4D_NewText$ = Ab4D_AddItemRect$(t, g_a4Win, g_a4Tool, g_a4CX, g_a4CY, g_a4CW, g_a4CH)
    End If
End Function

' 足した部品を選び、道具をポインタに戻す
Sub Ab4D_NewDone(hWnd As HWND)
    g_a4SelDoc = hWnd
    g_a4SelWin = g_a4Win
    g_a4SelName = Ab4D_LastAdded$()
    g_a4Tool = 0
End Sub

' 引いている四角の枠
Sub Ab4D_DrawNew(hDC As HDC)
    Dim r As RECT, x As Long, y As Long
    If g_a4Drag <> AB4D_DRAG_NEW Then Exit Sub
    x = Ab4D_ClientX(g_a4Win) + g_a4CX
    y = Ab4D_ClientY(g_a4Win) + g_a4CY
    FormDesign_Rect(r, x, y, x + g_a4CW + 1, y + g_a4CH + 1)
    Ui_Frame(hDC, r, RGB(0, 0, 0))
End Sub

' ---- キー ----

' 選んだ部品を消す（1 回の編集）
Sub Ab4D_Delete(hWnd As HWND)
    Dim t As String, u As String
    If Ab4D_SelIndex(hWnd) < 0 Then Exit Sub
    t = TextBuf_GetConfirmed$()
    u = Ab4D_DelItem$(t, g_a4SelWin, g_a4SelName)
    Ab4D_Unselect()
    If u <> t Then FormDesign_Replace(u)
    InvalidateRect(hWnd, ByVal 0, FALSE)
End Sub

' AB4 デザイナーのキー: Del（消す）、Esc（道具と選びをやめる）
Sub Ab4D_Key(hWnd As HWND, ByVal vk As Long)
    If vk = VK_DELETE Then Ab4D_Delete(hWnd)
    If vk <> VK_ESCAPE Then Exit Sub
    g_a4Tool = 0
    Ab4D_Unselect()
    InvalidateRect(hWnd, ByVal 0, FALSE)
End Sub
