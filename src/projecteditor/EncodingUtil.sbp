' EncodingUtil - 画面に出す文字の幅と描画（UTF-8 のまま）。文字コードの変換は EncText.sbp。

' TextOutW / GetTextExtentPoint32W は日本語で TextShaping が落ちる。
' 描画は ETO_IGNORELANGUAGE。幅は ASCII セルと全角 2 セルで足す。
Function Enc_TakeCell(hDC As HDC, wide As *Byte, chars As Long, ByRef cy As Long) As Long
    Dim sz As SIZE
    Enc_TakeCell = 8
    If EditorGetTextExtentPoint32W(hDC, wide, chars, sz) = 0 Then Exit Function
    cy = sz.cy
    Enc_TakeCell = sz.cx
End Function

Function Enc_CellCx(hDC As HDC, ByRef cy As Long) As Long
    Dim wide As *Byte
    Dim chars As Long
    cy = 16
    Enc_CellCx = 8
    wide = Enc_Utf8ToWide("8", chars)
    If wide = 0 Then Exit Function
    Enc_CellCx = Enc_TakeCell(hDC, wide, chars, cy)
    free(wide)
End Function

Function Enc_ChWidth(ch As Long, cell As Long) As Long
    Enc_ChWidth = cell * 2
    If ch < 128 Then Enc_ChWidth = cell
    If ch >= &HFF61 And ch <= &HFF9F Then Enc_ChWidth = cell
End Function

Function Enc_AtWide(wide As *Byte, i As Long) As Long
    Dim b0 As Long
    Dim b1 As Long
    b0 = wide[i * 2] And &HFF
    b1 = wide[i * 2 + 1] And &HFF
    Enc_AtWide = b0 + b1 * 256
End Function

Function Enc_WidthOf(wide As *Byte, chars As Long, cell As Long) As Long
    Dim i As Long
    Enc_WidthOf = 0
    i = 0
    While i < chars
        Enc_WidthOf = Enc_WidthOf + Enc_ChWidth(Enc_AtWide(wide, i), cell)
        i = i + 1
    Wend
End Function

Function Enc_FillSize(hDC As HDC, wide As *Byte, chars As Long, ByRef lpSize As SIZE) As Long
    Dim cell As Long
    cell = Enc_CellCx(hDC, lpSize.cy)
    lpSize.cx = Enc_WidthOf(wide, chars, cell)
    Enc_FillSize = 1
End Function

Function Enc_TextExtentUtf8(ByVal hDC As HDC, ByVal text As String, ByRef lpSize As SIZE) As Long
    Dim wide As *Byte
    Dim chars As Long
    Enc_TextExtentUtf8 = 0
    wide = Enc_Utf8ToWide(text, chars)
    If wide = 0 Then Exit Function
    Enc_TextExtentUtf8 = Enc_FillSize(hDC, wide, chars, lpSize)
    free(wide)
End Function

Function Enc_TextOutUtf8(ByVal hDC As HDC, ByVal x As Long, ByVal y As Long, ByVal text As String) As Long
    Dim wide As *Byte
    Dim chars As Long
    Enc_TextOutUtf8 = 0
    wide = Enc_Utf8ToWide(text, chars)
    If wide = 0 Then Exit Function
    Enc_TextOutUtf8 = EditorExtTextOutW(hDC, x, y, &H1000, 0, wide, chars, 0)
    free(wide)
End Function

Function Enc_TabPad(ByVal col As Long) As Long
    Enc_TabPad = 4 - (col Mod 4)
End Function

Function Enc_ByteAt(text As String, ByVal i As Long) As Long
    Enc_ByteAt = Asc(Mid$(text, i, 1)) And &HFF
End Function

Function Enc_CharBytesAt(text As String, ByVal i As Long) As Long
    Dim nb As Long
    nb = Enc_Utf8CharBytes(Enc_ByteAt(text, i))
    If i + nb - 1 > Len(text) Then nb = 1
    Enc_CharBytesAt = nb
End Function

Sub Enc_AppendChar(ByRef out As String, text As String, ByRef i As Long, ByRef col As Long)
    Dim nb As Long
    nb = Enc_CharBytesAt(text, i)
    out = out & Mid$(text, i, nb)
    i = i + nb
    col = col + 1
End Sub

Sub Enc_AppendTab(ByRef out As String, ByRef i As Long, ByRef col As Long)
    Dim pad As Long
    pad = Enc_TabPad(col)
    out = out & Left$("    ", pad)
    i = i + 1
    col = col + pad
End Sub

Sub Enc_ExpandOne(ByRef out As String, text As String, ByRef i As Long, ByRef col As Long)
    If Enc_ByteAt(text, i) = 9 Then
        Enc_AppendTab(out, i, col)
    Else
        Enc_AppendChar(out, text, i, col)
    End If
End Sub

Function Enc_ExpandTabsFrom$(text As String, ByRef col As Long) As String
    Dim i As Long
    Dim out As String
    i = 1
    out = ""
    While i <= Len(text)
        Enc_ExpandOne(out, text, i, col)
    Wend
    Enc_ExpandTabsFrom$ = out
End Function

Function Enc_ExpandTabs$(text As String) As String
    Dim col As Long
    col = 0
    Enc_ExpandTabs$ = Enc_ExpandTabsFrom$(text, col)
End Function
