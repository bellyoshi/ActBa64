' Text encoding support. Editor text is always UTF-8 internally.
' Detection and CP932 / UTF-8 byte conversion live in ..\common\TextEnc.abp.
' Enc_Utf8CharBytes stays here: an invalid byte still advances one byte.

Function Enc_Utf8CharBytes(ByVal b As Long) As Long
    Enc_Utf8CharBytes = 1
    If b >= &HC2 And b <= &HDF Then Enc_Utf8CharBytes = 2
    If b >= &HE0 And b <= &HEF Then Enc_Utf8CharBytes = 3
    If b >= &HF0 And b <= &HF4 Then Enc_Utf8CharBytes = 4
End Function

Function Enc_IsSjisLead(ByVal b As Long) As Long
    Enc_IsSjisLead = 0
    If b >= &H81 And b <= &H9F Then Enc_IsSjisLead = 1
    If b >= &HE0 And b <= &HFC Then Enc_IsSjisLead = 1
End Function

Sub Enc_PutCp932(raw As *Byte, b0 As Long, b1 As Long, ByRef n As Long)
    memcpy(raw, VarPtr(b0), 1)
    n = 1
    raw[1] = 0
    If b1 = 0 Then Exit Sub
    memcpy(VarPtr(raw[1]), VarPtr(b1), 1)
    raw[2] = 0
    n = 2
End Sub

Function Enc_Cp932CharToUtf8$(ByVal b0 As Long, ByVal b1 As Long) As String
    Dim raw(3) As Byte
    Dim n As Long
    Enc_PutCp932(VarPtr(raw[0]), b0, b1, n)
    Enc_Cp932CharToUtf8$ = Enc_BytesToUtf8$(VarPtr(raw), n, ENC_CP932)
End Function

Function Enc_DupCStr$(ByVal p As *Byte, ByVal n As Long) As String
    Dim s As String
    Enc_DupCStr$ = ""
    If p = 0 Then Exit Function
    If n <= 0 Then Exit Function
    s = MakeStr(p)
    Enc_DupCStr$ = Mid$(s, 1, n)
End Function

Function Enc_DupRaw(raw As *Byte, n As Long) As *Byte
    Dim out As *Byte
    Enc_DupRaw = 0
    If raw = 0 Or n <= 0 Then Exit Function
    out = malloc(n + 1)
    If out = 0 Then Exit Function
    memcpy(out, raw, n)
    out[n] = 0
    Enc_DupRaw = out
End Function

Function Enc_CopyBytes$(ByVal raw As *Byte, ByVal n As Long) As String
    Dim out As *Byte
    Enc_CopyBytes$ = ""
    out = Enc_DupRaw(raw, n)
    If out = 0 Then Exit Function
    Enc_CopyBytes$ = Enc_DupCStr$(out, n)
    free(out)
End Function

Function Enc_Utf8Slice$(raw As *Byte, n As Long, encoding As Long) As String
    Dim srcLen As Long
    srcLen = n
    Enc_Utf8Slice$ = ""
    If encoding <> ENC_UTF8_BOM Then Enc_Utf8Slice$ = Enc_CopyBytes$(raw, srcLen)
    If encoding <> ENC_UTF8_BOM Then Exit Function
    If srcLen <= 3 Then Exit Function
    Enc_Utf8Slice$ = Enc_CopyBytes$(VarPtr(raw[3]), srcLen - 3)
End Function

Function Enc_Cp932ToUtf8$(ByVal src As *Byte, ByVal srcLen As Long) As String
    Dim out As *Byte
    Dim n As Long
    Enc_Cp932ToUtf8$ = ""
    out = Enc_Cp932AsUtf8(src, srcLen, n)
    If out = 0 Then Exit Function
    Enc_Cp932ToUtf8$ = Enc_DupCStr$(out, n)
    free(out)
End Function

Function Enc_BytesToUtf8$(ByVal raw As *Byte, ByVal n As Long, ByVal encoding As Long) As String
    Enc_BytesToUtf8$ = ""
    If raw = 0 Or n <= 0 Then Exit Function
    If encoding = ENC_CP932 Then Enc_BytesToUtf8$ = Enc_Cp932ToUtf8$(raw, n)
    If encoding = ENC_CP932 Then Exit Function
    Enc_BytesToUtf8$ = Enc_Utf8Slice$(raw, n, encoding)
End Function

Function Enc_Utf8ToWide(ByVal text As String, ByRef outChars As Long) As *Byte
    Dim n As Long
    outChars = 0
    n = Len(text)
    If n <= 0 Then Exit Function
    Enc_Utf8ToWide = Enc_ToWide(ENC_CP_UTF8, StrPtr(text), n, outChars)
End Function

Function Enc_WideToUtf8$(ByVal wide As *Byte, ByVal chars As Long) As String
    Dim out As *Byte
    Dim n As Long
    Enc_WideToUtf8$ = ""
    out = Enc_FromWide(ENC_CP_UTF8, wide, chars, n)
    If out = 0 Then Exit Function
    Enc_WideToUtf8$ = Enc_DupCStr$(out, n)
    free(out)
End Function

Function Enc_Utf8Bytes(n As Long, encoding As Long) As Long
    Dim m As Long
    m = n
    If encoding = ENC_UTF8_BOM Then Enc_Add(m, 3)
    Enc_Utf8Bytes = m
End Function

Sub Enc_PutBom(out As *Byte, ByRef dst As *Byte)
    out[0] = &HEF
    out[1] = &HBB
    out[2] = &HBF
    dst = VarPtr(out[3])
End Sub

Sub Enc_FillUtf8(out As *Byte, text As String, n As Long, encoding As Long)
    Dim dst As *Byte
    dst = out
    If encoding = ENC_UTF8_BOM Then Enc_PutBom(out, dst)
    If n <= 0 Then Exit Sub
    memcpy(dst, StrPtr(text), n)
End Sub

Function Enc_SaveUtf8(text As String, encoding As Long, ByRef outLen As Long) As *Byte
    Dim n As Long
    Dim out As *Byte
    n = Len(text)
    outLen = Enc_Utf8Bytes(n, encoding)
    out = Enc_Alloc(outLen)
    If out = 0 Then outLen = 0
    If out <> 0 Then Enc_FillUtf8(out, text, n, encoding)
    Enc_SaveUtf8 = out
End Function

Function Enc_SaveCp932(text As String, ByRef outLen As Long) As *Byte
    Dim n As Long
    outLen = 0
    Enc_SaveCp932 = 0
    n = Len(text)
    If n <= 0 Then Exit Function
    Enc_SaveCp932 = Enc_Utf8AsCp932(StrPtr(text), n, outLen)
End Function

Function Enc_EncodeText(ByVal text As String, ByVal encoding As Long, ByRef outLen As Long) As *Byte
    Enc_EncodeText = 0
    outLen = 0
    If encoding = ENC_CP932 Then Enc_EncodeText = Enc_SaveCp932(text, outLen)
    If encoding = ENC_CP932 Then Exit Function
    Enc_EncodeText = Enc_SaveUtf8(text, encoding, outLen)
End Function

Function Enc_TextExtentUtf8(ByVal hDC As HDC, ByVal text As String, ByRef lpSize As SIZE) As Long
    Dim wide As *Byte
    Dim chars As Long
    Enc_TextExtentUtf8 = 0
    wide = Enc_Utf8ToWide(text, chars)
    If wide = 0 Then Exit Function
    Enc_TextExtentUtf8 = EditorGetTextExtentPoint32W(hDC, wide, chars, lpSize)
    free(wide)
End Function

Function Enc_TextOutUtf8(ByVal hDC As HDC, ByVal x As Long, ByVal y As Long, ByVal text As String) As Long
    Dim wide As *Byte
    Dim chars As Long
    Enc_TextOutUtf8 = 0
    wide = Enc_Utf8ToWide(text, chars)
    If wide = 0 Then Exit Function
    Enc_TextOutUtf8 = EditorTextOutW(hDC, x, y, wide, chars)
    free(wide)
End Function

Function Enc_TabPad(ByVal col As Long) As Long
    Enc_TabPad = 4 - (col Mod 4)
End Function

Function Enc_ByteAt(text As String, ByVal i As Long) As Long
    Enc_ByteAt = Asc(Mid$(text, i, 1)) And &HFF
End Function

Function Enc_CharBytesAt(text As String, ByVal i As Long) As Long
    Dim nb As Long
    nb = Enc_Utf8CharBytes(Enc_ByteAt(text, i))
    If i + nb - 1 > Len(text) Then nb = 1
    Enc_CharBytesAt = nb
End Function

Sub Enc_AppendChar(ByRef out As String, text As String, ByRef i As Long, ByRef col As Long)
    Dim nb As Long
    nb = Enc_CharBytesAt(text, i)
    out = out & Mid$(text, i, nb)
    i = i + nb
    col = col + 1
End Sub

Sub Enc_AppendTab(ByRef out As String, ByRef i As Long, ByRef col As Long)
    Dim pad As Long
    pad = Enc_TabPad(col)
    out = out & Left$("    ", pad)
    i = i + 1
    col = col + pad
End Sub

Sub Enc_ExpandOne(ByRef out As String, text As String, ByRef i As Long, ByRef col As Long)
    If Enc_ByteAt(text, i) = 9 Then
        Enc_AppendTab(out, i, col)
    Else
        Enc_AppendChar(out, text, i, col)
    End If
End Sub

Function Enc_ExpandTabsFrom$(text As String, ByRef col As Long) As String
    Dim i As Long
    Dim out As String
    i = 1
    out = ""
    While i <= Len(text)
        Enc_ExpandOne(out, text, i, col)
    Wend
    Enc_ExpandTabsFrom$ = out
End Function

Function Enc_ExpandTabs$(text As String) As String
    Dim col As Long
    col = 0
    Enc_ExpandTabs$ = Enc_ExpandTabsFrom$(text, col)
End Function
