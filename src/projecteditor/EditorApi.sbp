' Win32 API that one of the two compilers does not ship in its default headers.
' AB 4.20 already defines the names inside #ifdef _ACTBA64.
' ActBa64 already defines the names inside #ifndef _ACTBA64.

#ifdef _ACTBA64
Type SCROLLINFO
    cbSize As Long
    fMask As Long
    nMin As Long
    nMax As Long
    nPage As Long
    nPos As Long
    nTrackPos As Long
End Type

Declare Function DrawMenuBar Lib "user32.dll" (ByVal hWnd As HWND) As Long
Declare Function SetScrollInfo Lib "user32.dll" (ByVal hWnd As HWND, ByVal nBar As Long, ByRef lpsi As SCROLLINFO, ByVal bRedraw As Long) As Long
Declare Function GetScrollInfo Lib "user32.dll" (ByVal hWnd As HWND, ByVal nBar As Long, ByRef lpsi As SCROLLINFO) As Long
#endif

Declare Function AppendMenu Lib "user32.dll" Alias "AppendMenuA" (ByVal hMenu As HMENU, ByVal uFlags As Long, ByVal uIDNewItem As Long, ByVal lpNewItem As String) As Long
Declare Function AppendMenuW Lib "user32.dll" (ByVal hMenu As HMENU, ByVal uFlags As Long, ByVal uIDNewItem As Long, ByVal lpNewItem As *Byte) As Long
Declare Function ModifyMenuW Lib "user32.dll" (ByVal hMenu As HMENU, ByVal uPosition As Long, ByVal uFlags As Long, ByVal uIDNewItem As Long, ByVal lpNewItem As *Byte) As Long
#ifndef _ACTBA64
Declare Function CheckMenuItem Lib "user32.dll" (ByVal hMenu As HMENU, ByVal uIDCheckItem As Long, ByVal uCheck As Long) As Long
Declare Function IsClipboardFormatAvailable Lib "user32.dll" (ByVal format As DWord) As Long
Declare Function ImmGetContext Lib "imm32.dll" (ByVal hWnd As HWND) As Long
Declare Function ImmReleaseContext Lib "imm32.dll" (ByVal hWnd As HWND, ByVal hIMC As Long) As Long
Declare Function ImmGetCompositionStringW Lib "imm32.dll" (ByVal hIMC As Long, ByVal dwIndex As DWord, ByVal lpBuf As *Byte, ByVal dwBufLen As DWord) As Long
Declare Function ImmSetCompositionWindow Lib "imm32.dll" (ByVal hIMC As Long, ByVal lpCompForm As VoidPtr) As Long
#endif

' AB4.20 declares the standard names with *Word. These aliases deliberately use
' byte pointers so the same UTF-16 buffers compile without casts on both compilers.
Declare Function EditorMultiByteToWideChar Lib "kernel32.dll" Alias "MultiByteToWideChar" (ByVal CodePage As DWord, ByVal dwFlags As DWord, ByVal lpMultiByteStr As *Byte, ByVal cbMultiByte As Long, ByVal lpWideCharStr As *Byte, ByVal cchWideChar As Long) As Long
Declare Function EditorWideCharToMultiByte Lib "kernel32.dll" Alias "WideCharToMultiByte" (ByVal CodePage As DWord, ByVal dwFlags As DWord, ByVal lpWideCharStr As *Byte, ByVal cchWideChar As Long, ByVal lpMultiByteStr As *Byte, ByVal cbMultiByte As Long, ByVal lpDefaultChar As *Byte, ByVal lpUsedDefaultChar As *Byte) As Long
Declare Function EditorTextOutW Lib "gdi32.dll" Alias "TextOutW" (ByVal hdc As HDC, ByVal x As Long, ByVal y As Long, ByVal lpString As *Byte, ByVal c As Long) As Long
Declare Function EditorGetTextExtentPoint32W Lib "gdi32.dll" Alias "GetTextExtentPoint32W" (ByVal hdc As HDC, ByVal lpString As *Byte, ByVal c As Long, ByRef lpSize As SIZE) As Long

' 32bit user32 has SetWindowLongA. SetWindowLongPtrA is the 64bit export.
#ifdef _WIN64
Declare Function EditorSetWndProc Lib "user32.dll" Alias "SetWindowLongPtrA" (ByVal hWnd As HWND, ByVal nIndex As Long, ByVal newProc As LONG_PTR) As LONG_PTR
#else
Declare Function EditorSetWndProc Lib "user32.dll" Alias "SetWindowLongA" (ByVal hWnd As HWND, ByVal nIndex As Long, ByVal newProc As LONG_PTR) As LONG_PTR
#endif
Declare Function EditorCallWndProc Lib "user32.dll" Alias "CallWindowProcA" (ByVal prevProc As LONG_PTR, ByVal hWnd As HWND, ByVal Msg As DWord, ByVal wParam As WPARAM, ByVal lParam As LPARAM) As LRESULT
