Sub EditorCoreDeleteCharBeforeCursor()
    TextBuf_Delete()
End Sub

Sub EditorCoreMoveH(dir As String)
    If dir = "left" Then TextBuf_MoveCursorLeft()
    If dir = "right" Then TextBuf_MoveCursorRight()
End Sub

Sub EditorCoreMoveV(dir As String)
    If dir = "up" Then TextBuf_MoveCursorUp()
    If dir = "down" Then TextBuf_MoveCursorDown()
End Sub

Sub EditorCoreMoveCursor(dir As String)
    TextBuf_SetKeep(EditorKeys_Shift())
    EditorCoreMoveH(dir)
    EditorCoreMoveV(dir)
End Sub

Sub EditorCoreMoveCursorTo(ByVal newIndex As Long)
    TextBuf_MoveCursorTo(newIndex)
    TextBuf_SyncPreferredCol()
End Sub

Function EditorCoreLineCount() As Long
    EditorCoreLineCount = TextBuf_LineCount()
End Function

Function EditorCoreGetLineStart(ByVal lineNo As Long) As Long
    EditorCoreGetLineStart = TextBuf_GetLineStart(lineNo)
End Function

Sub EditorCoreMoveCursorToLine(ByVal lineNo As Long)
    TextBuf_MoveCursorTo(TextBuf_GetLineStart(lineNo))
    TextBuf_SyncPreferredCol()
End Sub

Sub EditorCoreScrollBy(hWnd As HWND, ByVal deltaLines As Long)
    VirtualScroll_ScrollBy(hWnd, deltaLines)
End Sub

Sub EditorCoreEnsureCursorVisible(hWnd As HWND)
    VirtualScroll_EnsureCursorVisible(hWnd)
End Sub

Sub EditorCoreClick(hWnd As HWND, ByVal x As Long, ByVal y As Long)
    TextBuf_ClearSelection()
    EditorHitTestClick(hWnd, x, y)
End Sub
