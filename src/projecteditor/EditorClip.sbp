Declare Function IsClipboardFormatAvailable Lib "user32.dll" (ByVal format As Long) As Long

Sub EditorClip_CopyText(hWnd As HWND, s As String)
    Dim n As Long
    Dim hMem As HANDLE
    Dim p As *Byte

    n = Len(s)
    If OpenClipboard(hWnd) = 0 Then Exit Sub
    EmptyClipboard()
    hMem = GlobalAlloc(GMEM_MOVEABLE, n + 1)
    If hMem <> 0 Then
        p = GlobalLock(hMem)
        If p <> 0 Then
            If n > 0 Then memcpy(p, StrPtr(s), n)
            p[n] = 0
            GlobalUnlock(hMem)
            SetClipboardData(CF_TEXT, hMem)
        End If
    End If
    CloseClipboard()
End Sub

Sub EditorClip_CopyAll(hWnd As HWND)
    If TextBuf_HasSelection() <> 0 Then
        EditorClip_CopyText(hWnd, TextBuf_GetSelected$())
    Else
        EditorClip_CopyText(hWnd, TextBuf_GetConfirmed$())
    End If
End Sub

Sub EditorClip_CutAll(hWnd As HWND)
    If TextBuf_HasSelection() <> 0 Then
        EditorClip_CopyText(hWnd, TextBuf_GetSelected$())
        TextBuf_DeleteSelection()
        EditorDoc_MarkDirty()
        Exit Sub
    End If
    EditorUndo_EndCoalesce()
    EditorUndo_BeforeEdit()
    EditorClip_CopyText(hWnd, TextBuf_GetConfirmed$())
    TextBuf_SetText("")
    EditorUndo_EndCoalesce()
    EditorDoc_MarkDirty()
End Sub

Sub EditorClip_Paste(hWnd As HWND)
    Dim hMem As HANDLE
    Dim p As *Byte
    Dim s As String

    If IsClipboardFormatAvailable(CF_TEXT) = 0 Then Exit Sub
    If OpenClipboard(hWnd) = 0 Then Exit Sub
    hMem = GetClipboardData(CF_TEXT)
    If hMem = 0 Then
        CloseClipboard()
        Exit Sub
    End If
    p = GlobalLock(hMem)
    If p = 0 Then
        CloseClipboard()
        Exit Sub
    End If
    s = MakeStr(p)
    GlobalUnlock(hMem)
    CloseClipboard()

    EditorUndo_EndCoalesce()
    If TextBuf_HasSelection() <> 0 Then
        TextBuf_DeleteSelection()
    End If
    EditorUndo_BeforeEdit()
    TextBuf_Append(s)
    EditorUndo_EndCoalesce()
    EditorDoc_MarkDirty()
End Sub

Sub EditorClip_Delete(hWnd As HWND)
    EditorUndo_EndCoalesce()
    If TextBuf_HasSelection() <> 0 Then
        TextBuf_DeleteSelection()
    Else
        TextBuf_DeleteForward()
    End If
    EditorUndo_EndCoalesce()
    EditorDoc_MarkDirty()
End Sub

Sub EditorClip_SelectAll()
    TextBuf_SelectAll()
End Sub
