' EditorView - 「表示」メニュー（編集の次）。
'   プロジェクトビュー: プロジェクトの窓（Windows は MDI の子、Linux は左の欄）を出す・隠す。
'   隠してもプロジェクトは閉じない（窓を閉じるとプロジェクトも閉じる）。出ていればチェック。
'   プロジェクトを開いていなければ灰色。

Const IDM_VIEWPROJ = 1332

Dim g_hMenuView As HMENU

' メニュー バーの 2 番目（ファイル・編集の次）に差し込む。表示名は EditorView_ApplyMenu で
Sub EditorView_BuildMenu()
    g_hMenuView = CreatePopupMenu()
    EditorMenu_Append(g_hMenuView, MF_STRING, IDM_VIEWPROJ, UI_MENU_VIEWPROJ)
#ifdef _LINUX
    InsMenu hMenu_M_MAIN, 2, MF_BYPOSITION, "View", 0, g_hMenuView, 0
#else
    InsMenu hMenu_M_MAIN, 2, MF_BYPOSITION, Ex"View(&V)", 0, g_hMenuView, 0
#endif
End Sub

Sub EditorView_ApplyMenu()
    If g_hMenuView = 0 Then Exit Sub
    EditorMenu_SetCmd(g_hMenuView, IDM_VIEWPROJ, UI_MENU_VIEWPROJ)
    EditorMenu_SetPopup(hMenu_M_MAIN, 2, g_hMenuView, UI_MENU_VIEW)
    EditorView_UpdateMenu()
End Sub

' プロジェクトの窓が出ているか（起動中は親がまだ見えないので、自分の WS_VISIBLE を見る）
Function EditorView_ProjShown() As Long
    EditorView_ProjShown = 0
    If g_hProject = 0 Then Exit Function
#ifdef _LINUX
    EditorView_ProjShown = g_lxsProjShow
#else
    If (GetWindowLong(g_hProject, GWL_STYLE) And WS_VISIBLE) <> 0 Then EditorView_ProjShown = 1
#endif
End Function

Sub EditorView_UpdateMenu()
    Dim flags As Long
    If g_hMenuView = 0 Then Exit Sub
    flags = MF_BYCOMMAND
    If EditorView_ProjShown() <> 0 Then flags = flags Or MF_CHECKED
    CheckMenuItem(g_hMenuView, IDM_VIEWPROJ, flags)
    flags = MF_BYCOMMAND
    If g_hProject = 0 Then flags = flags Or MF_GRAYED
    EnableMenuItem(g_hMenuView, IDM_VIEWPROJ, flags)
End Sub

Sub EditorView_ToggleProj()
    If g_hProject = 0 Then Exit Sub
#ifdef _LINUX
    g_lxsProjShow = 1 - EditorView_ProjShown()
    LxShell_Layout()
#else
    If EditorView_ProjShown() <> 0 Then ShowWindow(g_hProject, SW_HIDE) Else ShowWindow(g_hProject, SW_SHOW)
#endif
    EditorView_UpdateMenu()
End Sub

Function EditorView_Cmd(id As Long) As Long
    EditorView_Cmd = 0
    If id <> IDM_VIEWPROJ Then Exit Function
    EditorView_ToggleProj()
    EditorView_Cmd = 1
End Function
