' 文書内検索。位置は 0 始まり。見つからなければ -1。
' 前向きの origin は含む。後ろ向きの origin は含まない。末尾と先頭を 1 周する。
' matchCase が 0 のとき A-Z だけを小文字として比べる。空の needle は -1。

Function FindText_Fold(ByVal c As Long, ByVal matchCase As Long) As Long
    FindText_Fold = c
    If matchCase <> 0 Then Exit Function
    FindText_Fold = StrU_ToLowerChar(c)
End Function

Function FindText_EqBytes(hp As *Byte, np As *Byte, ByVal at As Long, ByVal nn As Long, ByVal matchCase As Long) As Long
    Dim i As Long
    FindText_EqBytes = 1
    For i = 0 To nn - 1
        If FindText_Fold(hp[at + i], matchCase) <> FindText_Fold(np[i], matchCase) Then FindText_EqBytes = 0
    Next
End Function

Function FindText_InRange(ByVal i As Long, ByVal last As Long, ByVal step As Long) As Long
    FindText_InRange = 0
    If step > 0 And i <= last Then FindText_InRange = 1
    If step < 0 And i >= last Then FindText_InRange = 1
End Function

Function FindText_Walk(hp As *Byte, np As *Byte, ByVal i As Long, ByVal last As Long, ByVal step As Long, ByVal nn As Long, ByVal matchCase As Long) As Long
    FindText_Walk = -1
    While FindText_InRange(i, last, step) <> 0
        If FindText_EqBytes(hp, np, i, nn, matchCase) <> 0 Then FindText_Walk = i
        If FindText_Walk >= 0 Then Exit Function
        i = i + step
    Wend
End Function

Function FindText_Scan(hay As String, needle As String, ByVal i As Long, ByVal last As Long, ByVal step As Long, ByVal matchCase As Long) As Long
    Dim hp As *Byte, np As *Byte, nn As Long
    FindText_Scan = -1
    nn = Len(needle)
    If nn = 0 Or step = 0 Or Len(hay) = 0 Then Exit Function
    hp = StrPtr(hay)
    np = StrPtr(needle)
    FindText_Scan = FindText_Walk(hp, np, i, last, step, nn, matchCase)
End Function

Function FindText_Lim(ByVal origin As Long, ByVal hi As Long) As Long
    FindText_Lim = origin
    If origin < 0 Then FindText_Lim = 0
    If origin > hi Then FindText_Lim = hi
End Function

Function FindText_FwdRest(hay As String, needle As String, ByVal origin As Long, ByVal matchCase As Long) As Long
    Dim last As Long
    last = Len(hay) - Len(needle)
    FindText_FwdRest = FindText_Scan(hay, needle, origin, last, 1, matchCase)
End Function

Function FindText_Forward(hay As String, needle As String, ByVal origin As Long, ByVal matchCase As Long) As Long
    Dim last As Long
    last = Len(hay) - Len(needle)
    FindText_Forward = -1
    If Len(needle) = 0 Or last < 0 Then Exit Function
    origin = FindText_Lim(origin, last + 1)
    FindText_Forward = FindText_FwdRest(hay, needle, origin, matchCase)
    If FindText_Forward < 0 And origin > 0 Then FindText_Forward = FindText_Scan(hay, needle, 0, origin - 1, 1, matchCase)
End Function

Function FindText_BackRest(hay As String, needle As String, ByVal origin As Long, ByVal matchCase As Long) As Long
    FindText_BackRest = -1
    If origin <= 0 Then Exit Function
    FindText_BackRest = FindText_Scan(hay, needle, origin - 1, 0, -1, matchCase)
End Function

Function FindText_Backward(hay As String, needle As String, ByVal origin As Long, ByVal matchCase As Long) As Long
    Dim last As Long
    last = Len(hay) - Len(needle)
    FindText_Backward = -1
    If Len(needle) = 0 Or last < 0 Then Exit Function
    origin = FindText_Lim(origin, last + 1)
    FindText_Backward = FindText_BackRest(hay, needle, origin, matchCase)
    If FindText_Backward < 0 And origin <= last Then FindText_Backward = FindText_Scan(hay, needle, last, origin, -1, matchCase)
End Function
