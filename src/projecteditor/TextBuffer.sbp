Const TEXTBUF_INITIAL_GAP = 1024
Const LINEOFF_INITIAL_CAP = 64

Dim g_imeComposition As String
Dim g_selAnchor As Long
Dim g_selKeep As Long
Dim g_preferredCol As Long

Class LineOffsetTable
    Public
    offsets As *Long
    count As Long
    capacity As Long

    Sub LineOffsetTable()
        offsets = 0
        count = 0
        capacity = 0
    End Sub

    Sub ~LineOffsetTable()
        This.Destroy()
    End Sub

    Sub EnsureCap(ByVal need As Long)
        Dim newCap As Long
        Dim newBuf As *Long
        Dim nCopy As Long

        If offsets <> 0 And need <= capacity Then Exit Sub

        newCap = capacity
        If newCap <= 0 Then newCap = LINEOFF_INITIAL_CAP
        While newCap < need
            newCap = newCap * 2
        Wend

        newBuf = malloc(newCap * 4)
        If newBuf = 0 Then Exit Sub

        If offsets <> 0 Then
            nCopy = count
            If nCopy > 0 Then
                memcpy(newBuf, offsets, nCopy * 4)
            End If
            free(offsets)
        End If

        offsets = newBuf
        capacity = newCap
    End Sub

    Sub Init()
        Dim p As *Long
        If offsets <> 0 Then
            free(offsets)
            offsets = 0
        End If
        count = 0
        capacity = 0
        This.EnsureCap(LINEOFF_INITIAL_CAP)
        p = offsets
        p[0] = 0
        count = 1
    End Sub

    Sub Destroy()
        If offsets <> 0 Then
            free(offsets)
            offsets = 0
        End If
        count = 0
        capacity = 0
    End Sub
End Class

Class TextBuffer
    Public
    buffer As *Byte
    gap_start As Long
    gap_end As Long
    capacity As Long

    Sub TextBuffer()
        buffer = 0
        gap_start = 0
        gap_end = 0
        capacity = 0
    End Sub

    Sub ~TextBuffer()
        This.Destroy()
    End Sub

    Function DocLen() As Long
        DocLen = gap_start + (capacity - gap_end)
    End Function

    Function GetByte(ByVal logicalIndex As Long) As Long
        Dim rightLen As Long
        Dim tmp As Byte
        Dim bp As *Byte
        Dim p As *Byte

        GetByte = 0
        p = buffer
        rightLen = capacity - gap_end
        If logicalIndex < 0 Then Exit Function
        If logicalIndex >= gap_start + rightLen Then Exit Function

        bp = VarPtr(tmp)
        If logicalIndex < gap_start Then
            bp[0] = p[logicalIndex]
        Else
            bp[0] = p[gap_end + (logicalIndex - gap_start)]
        End If
        GetByte = tmp
    End Function

    Sub Init()
        If buffer <> 0 Then
            free(buffer)
        End If
        capacity = TEXTBUF_INITIAL_GAP
        buffer = malloc(capacity)
        gap_start = 0
        gap_end = capacity
    End Sub

    Sub EnsureInit()
        If buffer = 0 Then
            This.Init()
        End If
    End Sub

    Sub Destroy()
        If buffer <> 0 Then
            free(buffer)
            buffer = 0
        End If
        gap_start = 0
        gap_end = 0
        capacity = 0
    End Sub

    Sub GrowGap()
        Dim newCap As Long
        Dim newBuf As *Byte
        Dim rightLen As Long
        Dim newGapEnd As Long
        Dim p As *Byte

        p = buffer
        rightLen = capacity - gap_end
        newCap = capacity * 2
        If newCap < capacity + TEXTBUF_INITIAL_GAP Then
            newCap = capacity + TEXTBUF_INITIAL_GAP
        End If

        newBuf = malloc(newCap)
        If newBuf = 0 Then Exit Sub

        If gap_start > 0 Then
            memcpy(newBuf, p, gap_start)
        End If

        newGapEnd = newCap - rightLen
        If rightLen > 0 Then
            memcpy(VarPtr(newBuf[newGapEnd]), VarPtr(p[gap_end]), rightLen)
        End If

        free(p)
        buffer = newBuf
        gap_end = newGapEnd
        capacity = newCap
    End Sub

    Sub MoveCursorTo(ByVal newIndex As Long)
        Dim nDoc As Long
        Dim tmp As Long
        Dim bp As *Byte
        Dim p As *Byte

        This.EnsureInit()

        nDoc = This.DocLen()
        If newIndex < 0 Then newIndex = 0
        If newIndex > nDoc Then newIndex = nDoc

        If newIndex = gap_start Then Exit Sub

        bp = VarPtr(tmp)
        p = buffer

        If newIndex < gap_start Then
            While gap_start > newIndex
                gap_end = gap_end - 1
                gap_start = gap_start - 1
                bp[0] = p[gap_start]
                p[gap_end] = bp[0]
            Wend
        Else
            While gap_start < newIndex
                bp[0] = p[gap_end]
                p[gap_start] = bp[0]
                gap_start = gap_start + 1
                gap_end = gap_end + 1
            Wend
        End If
    End Sub
End Class

Dim g_textBuf As TextBuffer
Dim g_lineOff As LineOffsetTable

Sub LineOff_EnsureCap(ByVal need As Long)
    g_lineOff.EnsureCap(need)
End Sub

Sub LineOff_Init()
    g_lineOff.Init()
End Sub

Sub LineOff_Destroy()
    g_lineOff.Destroy()
End Sub

Function TextBuf_GetByte(ByVal logicalIndex As Long) As Byte
    Dim v As Long, ch As Byte, p As *Byte
    v = g_textBuf.GetByte(logicalIndex)
    p = VarPtr(ch)
    memcpy(p, VarPtr(v), 1)
    TextBuf_GetByte = ch
End Function

Function TextBuf_BufByte(p As *Byte, ByVal logical As Long, ByVal leftLen As Long) As Long
    Dim tmp As Byte
    Dim bp As *Byte
    bp = VarPtr(tmp)
    If logical < leftLen Then
        bp[0] = p[logical]
    Else
        bp[0] = p[g_textBuf.gap_end + (logical - leftLen)]
    End If
    TextBuf_BufByte = tmp And &HFF
End Function

Sub InitTextBuffer()
    g_textBuf.Init()
    g_selAnchor = -1
    g_selKeep = 0
    g_lineOff.Init()
End Sub

Sub TextBuf_EnsureInit()
    If g_textBuf.buffer = 0 Then
        InitTextBuffer()
    End If
End Sub

Sub TextBuf_Destroy()
    g_textBuf.Destroy()
    g_imeComposition = ""
    g_lineOff.Destroy()
End Sub

Sub TextBuf_GrowGap()
    g_textBuf.GrowGap()
End Sub

Sub TextBuf_InsertChar(ByVal c As Long)
    Dim tmp As Long
    Dim bp As *Byte

    TextBuf_EnsureInit()
    If TextBuf_HasSelection() <> 0 Then
        TextBuf_DeleteSelection()
    End If
    EditorUndo_BeforeEdit()
    EditorBp_EditBegin()

    If g_textBuf.gap_start = g_textBuf.gap_end Then
        TextBuf_GrowGap()
        If g_textBuf.gap_start = g_textBuf.gap_end Then Exit Sub
    End If

    tmp = c And &HFF
    bp = VarPtr(tmp)
    g_textBuf.buffer[g_textBuf.gap_start] = bp[0]
    g_textBuf.gap_start = g_textBuf.gap_start + 1
    TextBuf_RebuildLineOffsets()
    Hl_ResetCache()
    TextBuf_SyncPreferredCol()
    If g_undoSuppress = 0 Then EditorDoc_MarkDirty()
    EditorBp_EditEnd(1)
End Sub

Sub TextBuf_DeleteForward()
    Dim n As Long

    TextBuf_EnsureInit()
    If TextBuf_HasSelection() <> 0 Then
        TextBuf_DeleteSelection()
        Exit Sub
    End If
    n = TextBuf_NextCharBytes()
    If n <= 0 Then Exit Sub
    EditorUndo_BeforeEdit()
    EditorBp_EditBegin()
    g_textBuf.gap_end = g_textBuf.gap_end + n
    TextBuf_RebuildLineOffsets()
    TextBuf_SyncPreferredCol()
    If g_undoSuppress = 0 Then EditorDoc_MarkDirty()
    EditorBp_EditEnd(0)
End Sub

Sub TextBuf_Delete()
    Dim i As Long
    Dim lastStart As Long
    Dim b As Long
    Dim tmp As Long
    Dim bp As *Byte

    TextBuf_EnsureInit()
    If TextBuf_HasSelection() <> 0 Then
        TextBuf_DeleteSelection()
        Exit Sub
    End If
    If g_textBuf.gap_start <= 0 Then Exit Sub
    EditorUndo_BeforeEdit()
    EditorBp_EditBegin()

    i = 0
    lastStart = 0
    bp = VarPtr(tmp)
    While i < g_textBuf.gap_start
        lastStart = i
        bp[0] = g_textBuf.buffer[i]
        b = tmp And &HFF
        i = i + Enc_Utf8CharBytes(b)
        If i > g_textBuf.gap_start Then i = g_textBuf.gap_start
    Wend

    g_textBuf.gap_start = lastStart
    TextBuf_RebuildLineOffsets()
    TextBuf_SyncPreferredCol()
    If g_undoSuppress = 0 Then EditorDoc_MarkDirty()
    EditorBp_EditEnd(0)
End Sub

Function TextBuf_PrevCharBytes() As Long
    Dim i As Long
    Dim lastStart As Long
    Dim b As Long
    Dim tmp As Long
    Dim bp As *Byte

    TextBuf_PrevCharBytes = 0
    If g_textBuf.gap_start <= 0 Then Exit Function

    i = 0
    lastStart = 0
    bp = VarPtr(tmp)
    While i < g_textBuf.gap_start
        lastStart = i
        bp[0] = g_textBuf.buffer[i]
        b = tmp And &HFF
        i = i + Enc_Utf8CharBytes(b)
        If i > g_textBuf.gap_start Then i = g_textBuf.gap_start
    Wend

    TextBuf_PrevCharBytes = g_textBuf.gap_start - lastStart
End Function

Function TextBuf_NextCharBytes() As Long
    Dim b As Long
    Dim tmp As Long
    Dim bp As *Byte

    TextBuf_NextCharBytes = 0
    If g_textBuf.gap_end >= g_textBuf.capacity Then Exit Function

    bp = VarPtr(tmp)
    bp[0] = g_textBuf.buffer[g_textBuf.gap_end]
    b = tmp And &HFF
    TextBuf_NextCharBytes = Enc_Utf8CharBytes(b)
    If g_textBuf.gap_end + TextBuf_NextCharBytes > g_textBuf.capacity Then TextBuf_NextCharBytes = 1
End Function

Sub TextBuf_MoveCursorTo(ByVal newIndex As Long)
    g_textBuf.MoveCursorTo(newIndex)
End Sub

Sub TextBuf_MoveCursorLeft()
    Dim n As Long
    TextBuf_PrepareMove()
    n = TextBuf_PrevCharBytes()
    If n <= 0 Then Exit Sub
    TextBuf_MoveCursorTo(g_textBuf.gap_start - n)
    TextBuf_SyncPreferredCol()
End Sub

Sub TextBuf_MoveCursorRight()
    Dim n As Long
    TextBuf_PrepareMove()
    n = TextBuf_NextCharBytes()
    If n <= 0 Then Exit Sub
    TextBuf_MoveCursorTo(g_textBuf.gap_start + n)
    TextBuf_SyncPreferredCol()
End Sub

Sub TextBuf_Append(s As String)
    Dim n As Long
    Dim i As Long
    Dim p As *Byte
    Dim tmp As Long
    Dim bp As *Byte

    n = Len(s)
    If n <= 0 Then Exit Sub
    p = StrPtr(s)
    bp = VarPtr(tmp)
    For i = 0 To n - 1
        bp[0] = p[i]
        TextBuf_InsertChar(tmp And &HFF)
    Next
End Sub

Sub TextBuf_AppendChar(ByVal ch As Long)
    TextBuf_InsertChar(ch)
End Sub

Sub TextBuf_Clear()
    TextBuf_EnsureInit()
    g_textBuf.gap_start = 0
    g_textBuf.gap_end = g_textBuf.capacity
    g_imeComposition = ""
    g_selAnchor = -1
    LineOff_Init()
    g_preferredCol = 0
    Hl_ResetCache()
End Sub

Function TextBuf_GapRoom() As Long
    TextBuf_GapRoom = g_textBuf.gap_end - g_textBuf.gap_start
End Function

Function TextBuf_GrowOnce() As Long
    Dim before As Long
    before = g_textBuf.capacity
    g_textBuf.GrowGap()
    TextBuf_GrowOnce = 0
    If g_textBuf.capacity > before Then TextBuf_GrowOnce = 1
End Function

Function TextBuf_EnsureRoom(ByVal n As Long) As Long
    TextBuf_EnsureRoom = 0
    While TextBuf_GapRoom() < n
        If TextBuf_GrowOnce() = 0 Then Exit Function
    Wend
    TextBuf_EnsureRoom = 1
End Function

Sub TextBuf_CopyIn(p As *Byte, ByVal n As Long)
    memcpy(VarPtr(g_textBuf.buffer[g_textBuf.gap_start]), p, n)
    g_textBuf.gap_start = g_textBuf.gap_start + n
    TextBuf_RebuildLineOffsets()
End Sub

Sub TextBuf_Fill(s As String)
    Dim n As Long
    n = Len(s)
    If n <= 0 Then Exit Sub
    TextBuf_EnsureInit()
    If TextBuf_EnsureRoom(n) = 0 Then Exit Sub
    TextBuf_CopyIn(StrPtr(s), n)
End Sub

Sub TextBuf_SetText(s As String)
    EditorUndo_Suppress(1)
    TextBuf_Clear()
    TextBuf_Fill(s)
    Hl_ResetCache()
    TextBuf_MoveCursorTo(0)
    TextBuf_SyncPreferredCol()
    EditorUndo_Suppress(0)
End Sub

Sub TextBuf_SetImeComposition(s As String)
    g_imeComposition = s
End Sub

Sub TextBuf_ClearImeComposition()
    g_imeComposition = ""
End Sub

Function TextBuf_Len() As Long
    TextBuf_EnsureInit()
    TextBuf_Len = g_textBuf.DocLen()
End Function

Function TextBuf_GetConfirmed$() As String
    Dim n As Long
    Dim rightLen As Long
    Dim out As *Byte

    TextBuf_EnsureInit()
    rightLen = g_textBuf.capacity - g_textBuf.gap_end
    n = g_textBuf.gap_start + rightLen
    If n <= 0 Then
        TextBuf_GetConfirmed$ = ""
        Exit Function
    End If

    out = malloc(n + 1)
    If out = 0 Then
        TextBuf_GetConfirmed$ = ""
        Exit Function
    End If

    If g_textBuf.gap_start > 0 Then
        memcpy(out, g_textBuf.buffer, g_textBuf.gap_start)
    End If
    If rightLen > 0 Then
        memcpy(VarPtr(out[g_textBuf.gap_start]), VarPtr(g_textBuf.buffer[g_textBuf.gap_end]), rightLen)
    End If
    out[n] = 0

    TextBuf_GetConfirmed$ = Enc_DupCStr$(out, n)
    free(out)
End Function

Function TextBuf_GetDisplay$() As String
    TextBuf_GetDisplay$ = TextBuf_GetConfirmed$() & g_imeComposition
End Function
