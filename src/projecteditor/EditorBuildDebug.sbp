' EditorBuildDebug - デバッグ実行（EditorDbg）のときだけ actba64 に -debug を付けて訳す
' （#IFDEF _DEBUG の部分を入れる）。プロジェクトなら出力は #OUTPUT_DEBUG（無ければ #OUTPUT_RELEASE）。
' Basic メニューの「_DEBUG を定義」は、デバッグ実行側で定義されるので無くした。

Function EditorBuild_IsDebug() As Long
    EditorBuild_IsDebug = 0
    If g_dbgForce <> 0 Then EditorBuild_IsDebug = 1
End Function

Function EditorBuild_DebugOpt$() As String
    EditorBuild_DebugOpt$ = ""
    If EditorBuild_IsDebug() <> 0 Then EditorBuild_DebugOpt$ = " -debug"
End Function
