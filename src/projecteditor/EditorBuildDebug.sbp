' EditorBuildDebug - Basic メニューの「_DEBUG を定義(-debug)」
' 選ぶと actba64 に -debug を付けて訳す（#IFDEF _DEBUG の部分を入れる）。
' プロジェクトなら出力は #OUTPUT_DEBUG（無ければ #OUTPUT_RELEASE）。
' AB4 のデバッグ実行とは違い、デバッガーは付かない（ブレークポイント・ステップ実行・変数の表示は無い）。
' ほかの項目とは別に入り切りし、editor.target に " dbg" を付けて覚える。

Const IDM_DEBUGDEF = 1321

Dim g_buildDebug As Long
Dim g_buildDebugMenu As Long

Function EditorBuild_IsDebug() As Long
    EditorBuild_IsDebug = g_buildDebug
    ' デバッグ実行（EditorDbg）は -debug を付けて訳す
    If g_dbgForce <> 0 Then EditorBuild_IsDebug = 1
End Function

Function EditorBuild_DebugOpt$() As String
    EditorBuild_DebugOpt$ = ""
    If EditorBuild_IsDebug() <> 0 Then EditorBuild_DebugOpt$ = " -debug"
End Function

' Basic メニューの -debug の項目なら切り替えて 1
Function EditorBuild_DebugCmd(id As Long) As Long
    EditorBuild_DebugCmd = 0
    If id <> IDM_DEBUGDEF Then Exit Function
    g_buildDebug = EditorBuild_Flip(g_buildDebug)
    EditorBuild_SyntaxChanged()
    EditorBuild_DebugCmd = 1
End Function

' ---- メニュー ----

' -X の次（実行の前）に差し込む。2 回目からは表示名だけ更新
Sub EditorBuild_ApplyDebugMenu()
    If g_buildDebugMenu = 0 Then EditorBuild_InsertDebugMenu()
    EditorMenu_SetCmd(hMenu_M_MAIN_2, IDM_DEBUGDEF, UI_MENU_DEBUGDEF)
    EditorBuild_CheckDebugMenu()
End Sub

Sub EditorBuild_InsertDebugMenu()
    Dim wide As *Byte
    Dim chars As Long
    wide = Enc_Utf8ToWide(UiText$(UI_MENU_DEBUGDEF), chars)
    If wide = 0 Then Exit Sub
    InsertMenuW(hMenu_M_MAIN_2, IDM_RUN, MF_BYCOMMAND Or MF_STRING, IDM_DEBUGDEF, wide)
    free(wide)
    g_buildDebugMenu = 1
End Sub

Sub EditorBuild_CheckDebugMenu()
    Dim flags As Long
    If g_buildDebugMenu = 0 Then Exit Sub
    flags = MF_BYCOMMAND
    If g_buildDebug <> 0 Then flags = flags Or MF_CHECKED
    CheckMenuItem(hMenu_M_MAIN_2, IDM_DEBUGDEF, flags)
End Sub

' ---- 設定ファイル（editor.target に " dbg"）----

Function EditorBuild_DebugTag$() As String
    EditorBuild_DebugTag$ = ""
    If g_buildDebug <> 0 Then EditorBuild_DebugTag$ = " dbg"
End Function

Sub EditorBuild_LoadDebug(s As String)
    g_buildDebug = 0
    If InStr(1, s, " dbg") > 0 Then g_buildDebug = 1
End Sub
