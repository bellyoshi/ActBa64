Function MessageWndProc(hWnd As HWND, dwMsg As DWord, wParam As WPARAM, lParam As LPARAM) As DWord
    Select Case dwMsg
        Case WM_SIZE
            Dim rc As RECT
            Dim hEdit As HWND
            GetClientRect(hWnd, rc)
            hEdit = GetDlgItem(hWnd, EditBox1)
            If hEdit <> 0 Then
                MoveWindow(hEdit, 7, 7, rc.right - 14, rc.bottom - 14, TRUE)
            End If
            MessageWndProc = 0
            Exit Function
    End Select

    MessageWndProc = EventCall_MessageWnd(hWnd, dwMsg, wParam, lParam)
End Function

Function MessageWnd_IsAlive() As Long
    MessageWnd_IsAlive = 0
    If hMessageWnd = 0 Then Exit Function
    If IsWindow(hMessageWnd) = 0 Then
        hMessageWnd = 0
        Exit Function
    End If
    MessageWnd_IsAlive = 1
End Function

Sub MessageWnd_Open(hOwner As HWND)
    If MessageWnd_IsAlive() <> 0 Then
        ShowWindow(hMessageWnd, SW_SHOW)
        SetForegroundWindow(hMessageWnd)
        Exit Sub
    End If

    hMessageWnd = CreateWindowEx(&H00000000, "NORMALDLG", "Message", &H00cf0000, -1, -1, 480, 360, hOwner, 0 As HMENU, GetModuleHandle(0), 0)
    If hMessageWnd = 0 Then Exit Sub
    SetWindowLong(hMessageWnd, GWL_WNDPROC, AddressOf(MessageWndProc) As LONG_PTR)
    SendMessage(hMessageWnd, WM_INITDIALOG, 0, 0)
    ShowWindow(hMessageWnd, SW_SHOW)
    UpdateWindow(hMessageWnd)
End Sub

Sub MessageWnd_SetText(text As String)
    Dim hEdit As HWND
    If MessageWnd_IsAlive() = 0 Then Exit Sub
    hEdit = GetDlgItem(hMessageWnd, EditBox1)
    If hEdit = 0 Then Exit Sub
    SetWindowText(hEdit, text)
End Sub

Sub MessageWnd_Append(text As String)
    Dim hEdit As HWND
    Dim cur As String
    Dim n As Long
    Dim buf As *Byte

    If MessageWnd_IsAlive() = 0 Then Exit Sub
    hEdit = GetDlgItem(hMessageWnd, EditBox1)
    If hEdit = 0 Then Exit Sub

    n = GetWindowTextLength(hEdit)
    If n <= 0 Then
        SetWindowText(hEdit, text)
        Exit Sub
    End If

    buf = malloc(n + 1)
    If buf = 0 Then
        SetWindowText(hEdit, text)
        Exit Sub
    End If
    GetWindowText(hEdit, buf, n + 1)
    cur = MakeStr(buf)
    free(buf)
    SetWindowText(hEdit, cur + text)
End Sub