#ifndef _LINUX
Dim g_msgEditProc As LONG_PTR
Dim g_msgDownX As Long
Dim g_msgDownY As Long

' メッセージの窓は MDI の子。開くときは MDI の地の下の方に横いっぱいに置き、文書の窓から活性を奪わない
Dim g_msgClass As String
Dim g_msgRegistered As Long
Dim g_msgWc As WNDCLASSEX
Dim g_msgMcs As MDICREATESTRUCT

Function MessageWndProc(hWnd As HWND, dwMsg As DWord, wParam As WPARAM, lParam As LPARAM) As LRESULT
    MessageWndProc = 0
    If dwMsg = WM_CREATE Then EventCall_MessageWnd(hWnd, WM_INITDIALOG, 0, 0)
    If dwMsg = WM_CLOSE Then
        MessageWnd_Hide(hWnd)
        Exit Function
    End If
    If dwMsg = WM_SIZE Then MessageWnd_Layout(hWnd)
    If dwMsg = WM_DESTROY And hWnd = hMessageWnd Then
        g_msgEditProc = 0
        hMessageWnd = 0
    End If
    MessageWndProc = DefMDIChildProc(hWnd, dwMsg, wParam, lParam)
End Function

' × は隠すだけ（次のコンパイルや実行でまた出す）。前にあったら文書の窓を前へ戻す
Sub MessageWnd_Hide(hWnd As HWND)
    If g_activeChild <> 0 And IsWindow(g_activeChild) <> 0 Then SendMessage(g_hClient, WM_MDIACTIVATE, g_activeChild As WPARAM, 0)
    ShowWindow(hWnd, SW_HIDE)
End Sub

Sub MessageWnd_Layout(hWnd As HWND)
    Dim rc As RECT
    Dim hEdit As HWND
    GetClientRect(hWnd, rc)
    hEdit = GetDlgItem(hWnd, EditBox1)
    If hEdit <> 0 Then MoveWindow(hEdit, 0, 0, rc.right, rc.bottom, TRUE)
End Sub

Function MessageWnd_IsAlive() As Long
    MessageWnd_IsAlive = 0
    If hMessageWnd = 0 Then Exit Function
    If IsWindow(hMessageWnd) = 0 Then
        hMessageWnd = 0
        g_msgEditProc = 0
        Exit Function
    End If
    MessageWnd_IsAlive = 1
End Function

Sub MessageWnd_Register()
    If g_msgRegistered <> 0 Then Exit Sub
    g_msgRegistered = 1
    g_msgClass = "EditorMessage"
    FillMemory(VarPtr(g_msgWc), SizeOf(WNDCLASSEX), 0)
    g_msgWc.cbSize = SizeOf(WNDCLASSEX)
    g_msgWc.hInstance = GetModuleHandle(0)
    g_msgWc.style = CS_HREDRAW Or CS_VREDRAW
    g_msgWc.lpfnWndProc = AddressOf(MessageWndProc)
    g_msgWc.hCursor = LoadCursor(NULL, MAKEINTRESOURCE(IDC_ARROW))
    g_msgWc.hbrBackground = h3DFaceBrush
    g_msgWc.lpszClassName = StrPtr(g_msgClass)
    g_msgWc.hIcon = LoadIcon(GetModuleHandle(0), MAKEINTRESOURCE(IDI_ICON1))
    RegisterClassEx(g_msgWc)
End Sub

' MDI の地の下の 1/4（120 ～ 240 の高さ）に横いっぱい
Sub MessageWnd_FillPos()
    Dim rc As RECT
    Dim h As Long
    GetClientRect(g_hClient, rc)
    h = rc.bottom \ 4
    If h < 120 Then h = 120
    If h > 240 Then h = 240
    If h > rc.bottom Then h = rc.bottom
    g_msgMcs.x = 0
    g_msgMcs.y = rc.bottom - h
    g_msgMcs.cx = rc.right
    g_msgMcs.cy = h
End Sub

' 文書の窓が活性のまま、メッセージの窓をいちばん上に見せる
Sub MessageWnd_ShowTop()
    ShowWindow(hMessageWnd, SW_SHOWNA)
    SetWindowPos(hMessageWnd, HWND_TOP, 0, 0, 0, 0, SWP_NOMOVE Or SWP_NOSIZE Or SWP_NOACTIVATE)
End Sub

Sub MessageWnd_Open(hOwner As HWND)
    If MessageWnd_IsAlive() <> 0 Then
        MessageWnd_ShowTop()
        Exit Sub
    End If
    If g_hClient = 0 Then Exit Sub
    MessageWnd_Register()
    FillMemory(VarPtr(g_msgMcs), SizeOf(MDICREATESTRUCT), 0)
    g_msgMcs.szClass = StrPtr(g_msgClass)
    g_msgMcs.szTitle = "Message"
    g_msgMcs.hOwner = GetModuleHandle(0)
    MessageWnd_FillPos()
    g_msgMcs.style = WS_VISIBLE
    hMessageWnd = EditorSendMessage(g_hClient, WM_MDICREATE, 0, VarPtr(g_msgMcs))
    If hMessageWnd = 0 Then Exit Sub
    MessageWnd_Layout(hMessageWnd)
    MessageJump_Hook()
    ' MDICREATE は新しい子を活性にするので、文書の窓へ戻す
    If g_activeChild <> 0 And IsWindow(g_activeChild) <> 0 Then SendMessage(g_hClient, WM_MDIACTIVATE, g_activeChild As WPARAM, 0)
    MessageWnd_ShowTop()
End Sub

Sub MessageWnd_SetText(text As String)
    Dim hEdit As HWND
    If MessageWnd_IsAlive() = 0 Then Exit Sub
    hEdit = GetDlgItem(hMessageWnd, EditBox1)
    If hEdit = 0 Then Exit Sub
    SetWindowText(hEdit, text)
End Sub

Sub MessageWnd_Append(text As String)
    Dim hEdit As HWND
    Dim cur As String
    Dim n As Long
    Dim buf As *Byte

    If MessageWnd_IsAlive() = 0 Then Exit Sub
    hEdit = GetDlgItem(hMessageWnd, EditBox1)
    If hEdit = 0 Then Exit Sub

    n = GetWindowTextLength(hEdit)
    If n <= 0 Then
        SetWindowText(hEdit, text)
        Exit Sub
    End If

    buf = malloc(n + 1)
    If buf = 0 Then
        SetWindowText(hEdit, text)
        Exit Sub
    End If
    GetWindowText(hEdit, buf, n + 1)
    cur = Enc_DupCStr$(buf, n)
    free(buf)
    SetWindowText(hEdit, cur + text)
End Sub
#endif
