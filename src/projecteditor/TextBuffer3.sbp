' --- split from TextBuffer.sbp (part 3) ---
Sub TextBuf_MoveCursorRight()
    Dim n As Long

    TextBuf_EnsureInit()
    TextBuf_ClearSelection()
    n = TextBuf_NextCharBytes()
    If n <= 0 Then Exit Sub
    TextBuf_MoveCursorTo(g_textBuf.gap_start + n)
    TextBuf_SyncPreferredCol()
End Sub

Sub TextBuf_Append(s As String)
    Dim n As Long
    Dim i As Long
    Dim p As *Byte
    Dim tmp As Long
    Dim bp As *Byte

    n = Len(s)
    If n <= 0 Then Exit Sub
    p = StrPtr(s)
    bp = VarPtr(tmp)
    For i = 0 To n - 1
        bp[0] = p[i]
        TextBuf_InsertChar(tmp And &HFF)
    Next
End Sub

Sub TextBuf_AppendChar(ByVal ch As Long)
    TextBuf_InsertChar(ch)
End Sub

Sub TextBuf_Clear()
    TextBuf_EnsureInit()
    g_textBuf.gap_start = 0
    g_textBuf.gap_end = g_textBuf.capacity
    g_strComp = ""
    g_selAnchor = -1
    LineOff_Init()
    g_preferredCol = 0
    Hl_ResetCache()
End Sub

Sub TextBuf_SetText(s As String)
    Dim n As Long
    Dim p As *Byte

    EditorUndo_Suppress(1)
    TextBuf_Clear()
    n = Len(s)
    If n > 0 Then
        TextBuf_EnsureInit()
        While (g_textBuf.gap_end - g_textBuf.gap_start) < n
            g_textBuf.GrowGap()
            If (g_textBuf.gap_end - g_textBuf.gap_start) < n Then
                EditorUndo_Suppress(0)
                Exit Sub
            End If
        Wend
        p = StrPtr(s)
        memcpy(VarPtr(g_textBuf.buffer[g_textBuf.gap_start]), p, n)
        g_textBuf.gap_start = g_textBuf.gap_start + n
        TextBuf_RebuildLineOffsets()
    End If
    Hl_ResetCache()
    TextBuf_MoveCursorTo(0)
    TextBuf_SyncPreferredCol()
    EditorUndo_Suppress(0)
End Sub

Sub TextBuf_SetComp(s As String)
    g_strComp = s
End Sub

Sub TextBuf_ClearComp()
    g_strComp = ""
End Sub

Function TextBuf_Len() As Long
    TextBuf_EnsureInit()
    TextBuf_Len = g_textBuf.DocLen()
End Function

Function TextBuf_GetConfirmed$() As String
    Dim n As Long
    Dim rightLen As Long
    Dim out As *Byte

    TextBuf_EnsureInit()
    rightLen = g_textBuf.capacity - g_textBuf.gap_end
    n = g_textBuf.gap_start + rightLen
    If n <= 0 Then
        TextBuf_GetConfirmed$ = ""
        Exit Function
    End If

    out = malloc(n + 1)
    If out = 0 Then
        TextBuf_GetConfirmed$ = ""
        Exit Function
    End If

    If g_textBuf.gap_start > 0 Then
        memcpy(out, g_textBuf.buffer, g_textBuf.gap_start)
    End If
    If rightLen > 0 Then
        memcpy(VarPtr(out[g_textBuf.gap_start]), VarPtr(g_textBuf.buffer[g_textBuf.gap_end]), rightLen)
    End If
    out[n] = 0

    TextBuf_GetConfirmed$ = Enc_DupCStr$(out, n)
    free(out)
End Function

Function TextBuf_GetDisplay$() As String
    TextBuf_GetDisplay$ = TextBuf_GetConfirmed$() & g_strComp
End Function
