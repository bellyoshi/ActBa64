Declare Function EditorBuild_CreateProcess Lib "kernel32" Alias "CreateProcessA" (ByVal lpApplicationName As Long, ByVal lpCommandLine As *Byte, ByVal lpProcessAttributes As Long, ByVal lpThreadAttributes As Long, ByVal bInheritHandles As Long, ByVal dwCreationFlags As DWord, ByVal lpEnvironment As Long, ByVal lpCurrentDirectory As Long, ByVal lpStartupInfo As *Byte, ByVal lpProcessInformation As *Byte) As Long
Declare Function EditorBuild_CreatePipe Lib "kernel32" Alias "CreatePipe" (ByVal hReadPipe As *Byte, ByVal hWritePipe As *Byte, ByVal lpPipeAttributes As Long, ByVal nSize As Long) As Long
Declare Function EditorBuild_SetHandleInformation Lib "kernel32" Alias "SetHandleInformation" (ByVal hObject As HANDLE, ByVal dwMask As DWord, ByVal dwFlags As DWord) As Long
Declare Function EditorBuild_GetExitCodeProcess Lib "kernel32" Alias "GetExitCodeProcess" (ByVal hProcess As HANDLE, ByVal lpExitCode As *Byte) As Long

Const EDITORBUILD_HANDLE_FLAG_INHERIT = 1
Dim g_buildSi As STARTUPINFO
Dim g_buildPi As PROCESS_INFORMATION

' 0 = 64bit (actba64) / 1 = 32bit (actba64 -actba32)
Dim g_buildTarget32 As Long
Dim g_runKeepConsole As Long
Dim g_targetMenuInitialized As Long

Function EditorBuild_ExeDir$() As String
    Dim buf As *Byte
    Dim s As String
    Dim n As Long
    Dim i As Long
    Dim lastSlash As Long
    Dim tmp As Long
    Dim bp As *Byte

    EditorBuild_ExeDir$ = ""
    buf = malloc(260)
    If buf = 0 Then Exit Function
    n = GetModuleFileName(NULL, buf, 260)
    If n <= 0 Then
        free(buf)
        Exit Function
    End If
    lastSlash = -1
    bp = VarPtr(tmp)
    For i = 0 To n - 1
        bp[0] = buf[i]
        tmp = tmp And &HFF
        If tmp = 92 Or tmp = 47 Then lastSlash = i
    Next
    If lastSlash >= 0 Then
        buf[lastSlash + 1] = 0
        EditorBuild_ExeDir$ = Enc_DupCStr$(buf, lastSlash + 1)
    End If
    free(buf)
End Function

Function EditorBuild_TargetConfigPath$() As String
    Dim dir As String
    dir = EditorBuild_ExeDir$()
    If Len(dir) = 0 Then
        EditorBuild_TargetConfigPath$ = "editor.target"
    Else
        EditorBuild_TargetConfigPath$ = dir + "editor.target"
    End If
End Function

Function EditorBuild_Is32BitTarget() As Long
    EditorBuild_Is32BitTarget = g_buildTarget32
End Function

Function EditorBuild_TargetLabel$() As String
    If g_buildTarget32 <> 0 Then
        EditorBuild_TargetLabel$ = "32bit"
    Else
        EditorBuild_TargetLabel$ = "64bit"
    End If
End Function

Function EditorBuild_CompilerName$() As String
    EditorBuild_CompilerName$ = "actba64.exe"
End Function

Function EditorBuild_TargetOpt$() As String
    EditorBuild_TargetOpt$ = ""
    If g_buildTarget32 <> 0 Then EditorBuild_TargetOpt$ = " -actba32"
End Function

Function EditorBuild_CompilerPath$() As String
    Dim dir As String
    dir = EditorBuild_ExeDir$()
    If Len(dir) = 0 Then
        EditorBuild_CompilerPath$ = EditorBuild_CompilerName$()
    Else
        EditorBuild_CompilerPath$ = dir + EditorBuild_CompilerName$()
    End If
End Function

Function EditorBuild_ActBa64Path$() As String
    EditorBuild_ActBa64Path$ = EditorBuild_CompilerPath$()
End Function

Sub EditorBuild_UpdateTargetMenu()
    Dim flags64 As Long
    Dim flags32 As Long
    If g_targetMenuInitialized = 0 Then Exit Sub
    flags64 = MF_BYCOMMAND
    flags32 = MF_BYCOMMAND
    If g_buildTarget32 = 0 Then
        flags64 = flags64 Or MF_CHECKED
    Else
        flags32 = flags32 Or MF_CHECKED
    End If
    CheckMenuItem(hMenu_M_MAIN_2, IDM_TARGET64, flags64)
    CheckMenuItem(hMenu_M_MAIN_2, IDM_TARGET32, flags32)
End Sub

Sub EditorBuild_LoadTarget()
    Dim path As String
    Dim s As String
    Dim n As Long
    Dim p As *Byte

    g_buildTarget32 = 0
    path = EditorBuild_TargetConfigPath$()
    s = EditorDoc_LoadTextFile$(path)
    n = Len(s)
    If n <= 0 Then Exit Sub
    p = StrPtr(s)
    If p = 0 Then Exit Sub
    If p[0] = 51 And p[1] = 50 Then
        g_buildTarget32 = 1
    End If
End Sub

Sub EditorBuild_SaveTarget()
    Dim path As String
    path = EditorBuild_TargetConfigPath$()
    If g_buildTarget32 <> 0 Then
        EditorDoc_WriteTextFile(path, "32")
    Else
        EditorDoc_WriteTextFile(path, "64")
    End If
End Sub

Sub EditorBuild_SetTarget32(ByVal is32 As Long)
    If is32 <> 0 Then
        g_buildTarget32 = 1
    Else
        g_buildTarget32 = 0
    End If
    EditorBuild_SaveTarget()
    EditorBuild_UpdateTargetMenu()
    If g_activeChild <> 0 Then EditorDoc_UpdateTitle(g_activeChild)
End Sub

Sub EditorBuild_Init(hWnd As HWND)
    EditorBuild_LoadTarget()
    g_targetMenuInitialized = 1
    EditorBuild_UpdateTargetMenu()
    If hWnd <> 0 Then EditorDoc_UpdateTitle(hWnd)
End Sub

Function EditorBuild_ExeFromPath$(path As String) As String
    Dim dotPos As Long
    dotPos = Len(path)
    While dotPos > 0
        If Mid$(path, dotPos, 1) = "." Then Exit While
        dotPos = dotPos - 1
    Wend
    If dotPos > 0 Then EditorBuild_ExeFromPath$ = Left$(path, dotPos - 1) + ".exe"
    If dotPos = 0 Then EditorBuild_ExeFromPath$ = path + ".exe"
End Function

Function EditorBuild_ExePathFromDoc$() As String
    If Len(g_projectPath) > 0 Then
        EditorBuild_ExePathFromDoc$ = ProjOutputExe$()
        Exit Function
    End If
    EditorBuild_ExePathFromDoc$ = EditorBuild_ExeFromPath$(g_docPath)
End Function

Function EditorBuild_QuoteArg$(s As String) As String
    Dim i As Long
    Dim need As Long

    need = 0
    For i = 1 To Len(s)
        If Mid$(s, i, 1) = " " Then
            need = 1
            Exit For
        End If
    Next
    If need <> 0 Then
        EditorBuild_QuoteArg$ = Chr$(34) + s + Chr$(34)
    Else
        EditorBuild_QuoteArg$ = s
    End If
End Function

Function EditorBuild_CompileArgs$() As String
    Dim outExe As String
    If Len(g_projectPath) > 0 Then
        EditorBuild_CompileArgs$ = ProjCompileArgs$()
        Exit Function
    End If
    outExe = EditorBuild_ExePathFromDoc$()
    EditorBuild_CompileArgs$ = EditorBuild_QuoteArg$(g_docPath) + " -o " + EditorBuild_QuoteArg$(outExe)
End Function

Function EditorBuild_ReadPipeAll$(hRead As HANDLE) As String
    Dim cap As Long
    Dim used As Long
    Dim nRead As DWord
    Dim buf As *Byte
    Dim tmp As *Byte
    Dim chunk[1023] As Byte
    Dim i As Long

    EditorBuild_ReadPipeAll$ = ""
    cap = 4096
    used = 0
    buf = malloc(cap)
    If buf = 0 Then Exit Function

    While ReadFile(hRead, chunk, 1024, VarPtr(nRead), ByVal NULL) <> 0
        If nRead = 0 Then Exit While
        If used + nRead + 1 > cap Then
            While used + nRead + 1 > cap
                cap = cap * 2
            Wend
            tmp = malloc(cap)
            If tmp = 0 Then
                free(buf)
                Exit Function
            End If
            If used > 0 Then memcpy(tmp, buf, used)
            free(buf)
            buf = tmp
        End If
        For i = 0 To nRead - 1
            buf[used + i] = chunk[i]
        Next
        used = used + nRead
    Wend

    buf[used] = 0
    EditorBuild_ReadPipeAll$ = Enc_DupCStr$(buf, used)
    free(buf)
End Function

Function EditorBuild_RunCapture(cmdLine As String, ByRef outText As String, ByRef exitCode As Long) As Long
    Dim hRead As HANDLE
    Dim hProcess As HANDLE
    EditorBuild_RunCapture = 0
    outText = ""
    exitCode = 1
    If EditorBuild_CaptureChild(cmdLine, hRead, hProcess) = 0 Then Exit Function
    EditorBuild_RunCapture = EditorBuild_FinishCapture(hRead, hProcess, outText, exitCode)
End Function

Function EditorBuild_FinishCapture(hRead As HANDLE, hProcess As HANDLE, ByRef outText As String, ByRef exitCode As Long) As Long
    outText = EditorBuild_ReadPipeAll$(hRead)
    CloseHandle(hRead)
    exitCode = EditorBuild_WaitExit(hProcess)
    CloseHandle(hProcess)
    EditorBuild_FinishCapture = 1
End Function

Function EditorBuild_CaptureChild(cmdLine As String, ByRef hRead As HANDLE, ByRef hProcess As HANDLE) As Long
    Dim hWrite As HANDLE
    EditorBuild_CaptureChild = 0
    If EditorBuild_OpenCapturePipe(hRead, hWrite) = 0 Then Exit Function
    EditorBuild_CaptureChild = EditorBuild_SpawnCapture(cmdLine, hRead, hWrite, hProcess)
End Function

Function EditorBuild_OpenCapturePipe(ByRef hRead As HANDLE, ByRef hWrite As HANDLE) As Long
    Dim hr As HANDLE
    Dim hw As HANDLE
    EditorBuild_OpenCapturePipe = 0
    If EditorBuild_CreatePipe(VarPtr(hr), VarPtr(hw), 0, 0) = 0 Then Exit Function
    EditorBuild_SetHandleInformation(hw, EDITORBUILD_HANDLE_FLAG_INHERIT, EDITORBUILD_HANDLE_FLAG_INHERIT)
    hRead = hr
    hWrite = hw
    EditorBuild_OpenCapturePipe = 1
End Function

Sub EditorBuild_ClosePair(hA As HANDLE, hB As HANDLE)
    CloseHandle(hA)
    CloseHandle(hB)
End Sub

Function EditorBuild_SpawnCapture(cmdLine As String, ByRef hRead As HANDLE, ByRef hWrite As HANDLE, ByRef hProcess As HANDLE) As Long
    EditorBuild_SpawnCapture = EditorBuild_StartProcess(cmdLine, hWrite, hProcess)
    If EditorBuild_SpawnCapture = 0 Then EditorBuild_ClosePair(hRead, hWrite)
    If EditorBuild_SpawnCapture <> 0 Then CloseHandle(hWrite)
End Function

Sub EditorBuild_ArmSi(hWrite As HANDLE)
    FillMemory(VarPtr(g_buildSi), Len(g_buildSi), 0)
    g_buildSi.cb = Len(g_buildSi)
    g_buildSi.dwFlags = STARTF_USESHOWWINDOW Or STARTF_USESTDHANDLES
    g_buildSi.wShowWindow = SW_HIDE
    g_buildSi.hStdOutput = hWrite
    g_buildSi.hStdError = hWrite
End Sub

Function EditorBuild_StartProcess(cmdLine As String, hWrite As HANDLE, ByRef hProcess As HANDLE) As Long
    EditorBuild_ArmSi(hWrite)
    FillMemory(VarPtr(g_buildPi), Len(g_buildPi), 0)
    EditorBuild_StartProcess = EditorBuild_CreateProcess(0, StrPtr(cmdLine), 0, 0, 1, CREATE_NO_WINDOW, 0, 0, VarPtr(g_buildSi), VarPtr(g_buildPi))
    If EditorBuild_StartProcess = 0 Then Exit Function
    CloseHandle(g_buildPi.hThread)
    hProcess = g_buildPi.hProcess
End Function

Function EditorBuild_WaitExit(hProcess As HANDLE) As Long
    Dim code As DWord
    WaitForSingleObject(hProcess, INFINITE)
    code = 1
    EditorBuild_GetExitCodeProcess(hProcess, VarPtr(code))
    EditorBuild_WaitExit = code
End Function

Function EditorBuild_FormatResult$(outText As String, ByVal exitCode As Long) As String
    Dim msg As String
    If Len(outText) = 0 Then
        If exitCode = 0 Then
            msg = "Compile succeeded." + Chr$(13) + Chr$(10)
        Else
            msg = "Compile failed. (exit=" + Str$(exitCode) + ")" + Chr$(13) + Chr$(10)
        End If
    Else
        msg = outText
        If Right$(msg, 1) <> Chr$(10) Then msg = msg + Chr$(13) + Chr$(10)
        If exitCode = 0 Then
            msg = msg + "Compile succeeded." + Chr$(13) + Chr$(10)
        Else
            msg = msg + "Compile failed. (exit=" + Str$(exitCode) + ")" + Chr$(13) + Chr$(10)
        End If
    End If
    EditorBuild_FormatResult$ = msg
End Function

Sub EditorBuild_Compile(hWnd As HWND)
    EditorBuild_DoCompile(hWnd)
End Sub

Function EditorBuild_TrimDirective$(s As String) As String
    Dim t As String
    t = s
    While Len(t) > 0
        If Left$(t, 1) <> " " And Left$(t, 1) <> Chr$(9) Then Exit While
        t = Mid$(t, 2)
    Wend
    EditorBuild_TrimDirective$ = t
End Function

Function EditorBuild_LineIsConsole(s As String) As Long
    Dim t As String
    EditorBuild_LineIsConsole = 0
    t = EditorBuild_TrimDirective$(s)
    If Len(t) < 8 Then Exit Function
    If Left$(t, 8) = "#console" Then EditorBuild_LineIsConsole = 1
End Function

Function EditorBuild_DocHasConsole() As Long
    Dim i As Long
    Dim n As Long
    EditorBuild_DocHasConsole = 0
    n = TextBuf_LineCount()
    If n > 120 Then n = 120
    For i = 1 To n
        If EditorBuild_LineIsConsole(TextBuf_GetLineText$(i)) <> 0 Then
            EditorBuild_DocHasConsole = 1
            Exit Function
        End If
    Next
End Function

Function EditorBuild_WantConsole() As Long
    If g_runKeepConsole <> 0 Then EditorBuild_WantConsole = 1
    If g_runKeepConsole <> 0 Then Exit Function
    EditorBuild_WantConsole = 0
    If Len(g_projectPath) > 0 Then
        If g_projUseWindow = 0 Then EditorBuild_WantConsole = 1
        Exit Function
    End If
    EditorBuild_WantConsole = EditorBuild_DocHasConsole()
End Function

Function EditorBuild_LaunchExe(hWnd As HWND, exePath As String) As Long
    Dim params As String
    EditorBuild_LaunchExe = 0
    If EditorBuild_WantConsole() <> 0 Then
        params = "/k " + Chr$(34) + exePath + Chr$(34)
        If ShellExecute(hWnd, "open", "cmd.exe", params, "", SW_SHOWNORMAL) > 32 Then
            EditorBuild_LaunchExe = 1
        End If
    Else
        If ShellExecute(hWnd, "open", exePath, "", "", SW_SHOWNORMAL) > 32 Then
            EditorBuild_LaunchExe = 1
        End If
    End If
End Function

Sub EditorBuild_RunBody(hWnd As HWND)
    Dim exePath As String

    If EditorBuild_DoCompile(hWnd) = 0 Then Exit Sub

    exePath = EditorBuild_ExePathFromDoc$()
    MessageWnd_Append("Running " + exePath + Chr$(13) + Chr$(10))
    If EditorBuild_LaunchExe(hWnd, exePath) = 0 Then
        MessageWnd_Append("Failed to run program." + Chr$(13) + Chr$(10))
    End If
End Sub

Sub EditorBuild_Run(hWnd As HWND)
    g_runKeepConsole = 0
    EditorBuild_RunBody(hWnd)
End Sub

Sub EditorBuild_RunWait(hWnd As HWND)
    g_runKeepConsole = 1
    EditorBuild_RunBody(hWnd)
End Sub