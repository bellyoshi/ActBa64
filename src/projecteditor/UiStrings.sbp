' UI string IDs and English built-in defaults.
' Pack load/lookup: UiLang.sbp. Selection: setting.ini Language= + ProjectEditor_lang_<code>.csv

Declare Function MessageBoxW Lib "user32.dll" (ByVal hWnd As HWND, ByVal lpText As *Byte, ByVal lpCaption As *Byte, ByVal uType As Long) As Long

Const UI_SAVE_FAILED = 1
Const UI_HELP_NOT_FOUND = 2
Const UI_HELP_OPEN_FAILED = 3
Const UI_HELP_TITLE = 4

Const UI_MENU_FILE = 10
Const UI_MENU_NEW = 11
Const UI_MENU_OPEN = 12
Const UI_MENU_SAVEAS = 13
Const UI_MENU_SAVE = 14
Const UI_MENU_EDIT = 15
Const UI_MENU_UNDO = 16
Const UI_MENU_REDO = 17
Const UI_MENU_CUT = 18
Const UI_MENU_COPY = 19
Const UI_MENU_PASTE = 20
Const UI_MENU_SELECTALL = 21
Const UI_MENU_DELETE = 22
Const UI_MENU_BASIC = 23
Const UI_MENU_TARGET64 = 24
Const UI_MENU_TARGET32 = 25
Const UI_MENU_RUN = 26
Const UI_MENU_COMPILE = 27
Const UI_MENU_HELP = 28
Const UI_MENU_HELP_KW = 29
Const UI_MENU_HELP_ACTBA = 30
Const UI_MENU_CTX_HELP_KW = 31
Const UI_MENU_SETTING = 32
Const UI_MENU_SETTING_ITEM = 33
Const UI_SETTING_TITLE = 34
Const UI_SETTING_LANG = 35
Const UI_SETTING_OK = 36
Const UI_SETTING_RESTART = 37
Const UI_SETTING_RESTART_TITLE = 38
Const UI_LANG_EN = 39
Const UI_LANG_JA = 40

Dim g_uiLangCode As String

Function UiTextDefaultMsg$(ByVal id As Long) As String
    If id = UI_SAVE_FAILED Then
        UiTextDefaultMsg$ = "Failed to save file."
    ElseIf id = UI_HELP_NOT_FOUND Then
        UiTextDefaultMsg$ = "Cannot find help\actba64_ref.html. Place the help folder next to the editor."
    ElseIf id = UI_HELP_OPEN_FAILED Then
        UiTextDefaultMsg$ = "Could not open help: "
    ElseIf id = UI_HELP_TITLE Then
        UiTextDefaultMsg$ = "actba64 Help"
    ElseIf id = UI_SETTING_TITLE Then
        UiTextDefaultMsg$ = "Settings"
    ElseIf id = UI_SETTING_LANG Then
        UiTextDefaultMsg$ = "Language"
    ElseIf id = UI_SETTING_OK Then
        UiTextDefaultMsg$ = "OK"
    ElseIf id = UI_SETTING_RESTART Then
        UiTextDefaultMsg$ = "Restart and reload settings?"
    ElseIf id = UI_SETTING_RESTART_TITLE Then
        UiTextDefaultMsg$ = "Settings"
    ElseIf id = UI_LANG_EN Then
        UiTextDefaultMsg$ = "English"
    ElseIf id = UI_LANG_JA Then
        UiTextDefaultMsg$ = "Japanese"
    Else
        UiTextDefaultMsg$ = ""
    End If
End Function

Function UiTextDefaultMenuFile$(ByVal id As Long) As String
    If id = UI_MENU_FILE Then
        UiTextDefaultMenuFile$ = "File(&F)"
    ElseIf id = UI_MENU_NEW Then
        UiTextDefaultMenuFile$ = "New(&N)"
    ElseIf id = UI_MENU_OPEN Then
        UiTextDefaultMenuFile$ = "Open(&O)"
    ElseIf id = UI_MENU_SAVEAS Then
        UiTextDefaultMenuFile$ = "Save As(&A)"
    ElseIf id = UI_MENU_SAVE Then
        UiTextDefaultMenuFile$ = "Save(&S)"
    Else
        UiTextDefaultMenuFile$ = ""
    End If
End Function

Function UiTextDefaultMenuEdit$(ByVal id As Long) As String
    If id = UI_MENU_EDIT Then
        UiTextDefaultMenuEdit$ = "Edit(&E)"
    ElseIf id = UI_MENU_UNDO Then
        UiTextDefaultMenuEdit$ = "Undo(&U)"
    ElseIf id = UI_MENU_REDO Then
        UiTextDefaultMenuEdit$ = "Redo(&R)"
    ElseIf id = UI_MENU_CUT Then
        UiTextDefaultMenuEdit$ = "Cut(&T)"
    ElseIf id = UI_MENU_COPY Then
        UiTextDefaultMenuEdit$ = "Copy(&C)"
    ElseIf id = UI_MENU_PASTE Then
        UiTextDefaultMenuEdit$ = "Paste(&P)"
    ElseIf id = UI_MENU_SELECTALL Then
        UiTextDefaultMenuEdit$ = "Select All(&A)"
    ElseIf id = UI_MENU_DELETE Then
        UiTextDefaultMenuEdit$ = "Delete(&D)"
    Else
        UiTextDefaultMenuEdit$ = ""
    End If
End Function

Function UiTextDefaultMenuOther$(ByVal id As Long) As String
    If id = UI_MENU_BASIC Then
        UiTextDefaultMenuOther$ = "Basic"
    ElseIf id = UI_MENU_TARGET64 Then
        UiTextDefaultMenuOther$ = "64bit"
    ElseIf id = UI_MENU_TARGET32 Then
        UiTextDefaultMenuOther$ = "32bit"
    ElseIf id = UI_MENU_RUN Then
        UiTextDefaultMenuOther$ = "Run(&R)"
    ElseIf id = UI_MENU_COMPILE Then
        UiTextDefaultMenuOther$ = "Compile(&C)"
    ElseIf id = UI_MENU_SETTING Then
        UiTextDefaultMenuOther$ = "Setting(&S)"
    ElseIf id = UI_MENU_SETTING_ITEM Then
        UiTextDefaultMenuOther$ = "Settings"
    ElseIf id = UI_MENU_HELP Then
        UiTextDefaultMenuOther$ = "Help(&H)"
    ElseIf id = UI_MENU_HELP_KW Then
        UiTextDefaultMenuOther$ = "Keyword"
    ElseIf id = UI_MENU_HELP_ACTBA Then
        UiTextDefaultMenuOther$ = "actba64 Help"
    ElseIf id = UI_MENU_CTX_HELP_KW Then
        UiTextDefaultMenuOther$ = "Keyword help"
    Else
        UiTextDefaultMenuOther$ = ""
    End If
End Function

Function UiTextDefault$(ByVal id As Long) As String
    UiTextDefault$ = UiTextDefaultMsg$(id)
    If UiTextDefault$ <> "" Then Exit Function
    UiTextDefault$ = UiTextDefaultMenuFile$(id)
    If UiTextDefault$ <> "" Then Exit Function
    UiTextDefault$ = UiTextDefaultMenuEdit$(id)
    If UiTextDefault$ <> "" Then Exit Function
    UiTextDefault$ = UiTextDefaultMenuOther$(id)
End Function
