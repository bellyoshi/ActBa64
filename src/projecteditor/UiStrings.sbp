' UI strings. Japanese is the default for ProjectEditor menus and messages.

Const UI_SAVE_FAILED = 1
Const UI_HELP_NOT_FOUND = 2
Const UI_HELP_OPEN_FAILED = 3
Const UI_HELP_TITLE = 4

Const UI_MENU_FILE = 10
Const UI_MENU_NEW = 11
Const UI_MENU_OPEN = 12
Const UI_MENU_SAVEAS = 13
Const UI_MENU_SAVE = 14
Const UI_MENU_EDIT = 15
Const UI_MENU_UNDO = 16
Const UI_MENU_REDO = 17
Const UI_MENU_CUT = 18
Const UI_MENU_COPY = 19
Const UI_MENU_PASTE = 20
Const UI_MENU_SELECTALL = 21
Const UI_MENU_DELETE = 22
Const UI_MENU_BASIC = 23
Const UI_MENU_TARGET64 = 24
Const UI_MENU_TARGET32 = 25
Const UI_MENU_RUN = 26
Const UI_MENU_COMPILE = 27
Const UI_MENU_HELP = 28
Const UI_MENU_HELP_KW = 29
Const UI_MENU_HELP_ACTBA = 30
Const UI_MENU_CTX_HELP_KW = 31

Function UiText$(ByVal id As Long) As String
    If id = UI_SAVE_FAILED Then
        UiText$ = "ファイルの保存に失敗しました。"
    ElseIf id = UI_HELP_NOT_FOUND Then
        UiText$ = "help\actba64_ref.html が見つかりません。editor.exe と同じ場所に help フォルダを置いてください。"
    ElseIf id = UI_HELP_OPEN_FAILED Then
        UiText$ = "ヘルプを開けませんでした: "
    ElseIf id = UI_HELP_TITLE Then
        UiText$ = "actba64 ヘルプ"
    ElseIf id = UI_MENU_FILE Then
        UiText$ = "ファイル(&F)"
    ElseIf id = UI_MENU_NEW Then
        UiText$ = "新規(&N)"
    ElseIf id = UI_MENU_OPEN Then
        UiText$ = "開く(&O)"
    ElseIf id = UI_MENU_SAVEAS Then
        UiText$ = "名前を付けて保存(&A)"
    ElseIf id = UI_MENU_SAVE Then
        UiText$ = "上書き保存(&S)"
    ElseIf id = UI_MENU_EDIT Then
        UiText$ = "編集(&E)"
    ElseIf id = UI_MENU_UNDO Then
        UiText$ = "元に戻す(&U)"
    ElseIf id = UI_MENU_REDO Then
        UiText$ = "やり直し(&R)"
    ElseIf id = UI_MENU_CUT Then
        UiText$ = "切り取り(&T)"
    ElseIf id = UI_MENU_COPY Then
        UiText$ = "コピー(&C)"
    ElseIf id = UI_MENU_PASTE Then
        UiText$ = "貼り付け(&P)"
    ElseIf id = UI_MENU_SELECTALL Then
        UiText$ = "すべて選択(&A)"
    ElseIf id = UI_MENU_DELETE Then
        UiText$ = "削除(&D)"
    ElseIf id = UI_MENU_BASIC Then
        UiText$ = "Basic"
    ElseIf id = UI_MENU_TARGET64 Then
        UiText$ = "64bit"
    ElseIf id = UI_MENU_TARGET32 Then
        UiText$ = "32bit"
    ElseIf id = UI_MENU_RUN Then
        UiText$ = "実行(&R)"
    ElseIf id = UI_MENU_COMPILE Then
        UiText$ = "コンパイル(&C)"
    ElseIf id = UI_MENU_HELP Then
        UiText$ = "ヘルプ(&H)"
    ElseIf id = UI_MENU_HELP_KW Then
        UiText$ = "キーワード"
    ElseIf id = UI_MENU_HELP_ACTBA Then
        UiText$ = "actba64 ヘルプ"
    ElseIf id = UI_MENU_CTX_HELP_KW Then
        UiText$ = "キーワードのヘルプ"
    Else
        UiText$ = ""
    End If
End Function
