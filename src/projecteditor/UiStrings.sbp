' English is the built-in fallback language.
' Keep UI text behind IDs so external language packs can replace this later.

Const UI_SAVE_FAILED = 1
Const UI_HELP_NOT_FOUND = 2
Const UI_HELP_OPEN_FAILED = 3
Const UI_HELP_TITLE = 4

Function UiText$(ByVal id As Long) As String
    If id = UI_SAVE_FAILED Then
        UiText$ = "Failed to save file."
    ElseIf id = UI_HELP_NOT_FOUND Then
        UiText$ = "Cannot find help\actba64_ref.html. Place the help folder next to editor.exe."
    ElseIf id = UI_HELP_OPEN_FAILED Then
        UiText$ = "Could not open help: "
    ElseIf id = UI_HELP_TITLE Then
        UiText$ = "actba64 Help"
    Else
        UiText$ = ""
    End If
End Function
