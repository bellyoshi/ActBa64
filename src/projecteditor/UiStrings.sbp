Dim g_uiLangCode As String

Function UiTextDefaultMsg$(ByVal id As Long) As String
    If id = UI_SAVE_FAILED Then
        UiTextDefaultMsg$ = "Failed to save file."
    ElseIf id = UI_HELP_NOT_FOUND Then
        UiTextDefaultMsg$ = "Cannot find help\actba64_ref.html. Place the help folder next to the editor."
    ElseIf id = UI_HELP_OPEN_FAILED Then
        UiTextDefaultMsg$ = "Could not open help: "
    ElseIf id = UI_HELP_TITLE Then
        UiTextDefaultMsg$ = "actba64 Help"
    ElseIf id = UI_SETTING_TITLE Then
        UiTextDefaultMsg$ = "Settings"
    ElseIf id = UI_SETTING_LANG Then
        UiTextDefaultMsg$ = "Language"
    ElseIf id = UI_SETTING_OK Then
        UiTextDefaultMsg$ = "OK"
    ElseIf id = UI_SETTING_RESTART Then
        UiTextDefaultMsg$ = "Restart and reload settings?"
    ElseIf id = UI_SETTING_RESTART_TITLE Then
        UiTextDefaultMsg$ = "Settings"
    ElseIf id = UI_LANG_EN Then
        UiTextDefaultMsg$ = "English"
    ElseIf id = UI_LANG_JA Then
        UiTextDefaultMsg$ = "Japanese"
    Else
        UiTextDefaultMsg$ = ""
    End If
End Function

Function UiTextDefaultMenuFile$(ByVal id As Long) As String
    If id = UI_MENU_FILE Then
        UiTextDefaultMenuFile$ = "File(&F)"
    ElseIf id = UI_MENU_NEW Then
        UiTextDefaultMenuFile$ = "New(&N)"
    ElseIf id = UI_MENU_OPEN Then
        UiTextDefaultMenuFile$ = "Open(&O)"
    ElseIf id = UI_MENU_SAVEAS Then
        UiTextDefaultMenuFile$ = "Save As(&A)"
    ElseIf id = UI_MENU_SAVE Then
        UiTextDefaultMenuFile$ = "Save(&S)" + Chr$(9) + "Ctrl+S"
    ElseIf id = UI_MENU_EXIT Then
        UiTextDefaultMenuFile$ = "Exit(&X)"
    Else
        UiTextDefaultMenuFile$ = ""
    End If
End Function

Function UiTextDefaultMenuEdit$(ByVal id As Long) As String
    If id = UI_MENU_EDIT Then
        UiTextDefaultMenuEdit$ = "Edit(&E)"
    ElseIf id = UI_MENU_UNDO Then
        UiTextDefaultMenuEdit$ = "Undo(&U)" + Chr$(9) + "Ctrl+Z"
    ElseIf id = UI_MENU_REDO Then
        UiTextDefaultMenuEdit$ = "Redo(&R)" + Chr$(9) + "Ctrl+Y"
    ElseIf id = UI_MENU_CUT Then
        UiTextDefaultMenuEdit$ = "Cut(&T)" + Chr$(9) + "Ctrl+X"
    ElseIf id = UI_MENU_COPY Then
        UiTextDefaultMenuEdit$ = "Copy(&C)" + Chr$(9) + "Ctrl+C"
    ElseIf id = UI_MENU_PASTE Then
        UiTextDefaultMenuEdit$ = "Paste(&P)" + Chr$(9) + "Ctrl+V"
    ElseIf id = UI_MENU_SELECTALL Then
        UiTextDefaultMenuEdit$ = "Select All(&A)" + Chr$(9) + "Ctrl+A"
    ElseIf id = UI_MENU_DELETE Then
        UiTextDefaultMenuEdit$ = "Delete(&D)"
    Else
        UiTextDefaultMenuEdit$ = ""
    End If
End Function

Function UiTextDefaultMenuOther$(ByVal id As Long) As String
    If id = UI_MENU_BASIC Then
        UiTextDefaultMenuOther$ = "Basic"
    ElseIf id = UI_MENU_TARGET64 Then
        UiTextDefaultMenuOther$ = "64bit"
    ElseIf id = UI_MENU_TARGET32 Then
        UiTextDefaultMenuOther$ = "32bit"
    ElseIf id = UI_MENU_RUN Then
        UiTextDefaultMenuOther$ = "Run(&R)"
    ElseIf id = UI_MENU_COMPILE Then
        UiTextDefaultMenuOther$ = "Compile(&C)"
    ElseIf id = UI_MENU_SETTING Then
        UiTextDefaultMenuOther$ = "Setting(&S)"
    ElseIf id = UI_MENU_SETTING_ITEM Then
        UiTextDefaultMenuOther$ = "Settings"
    ElseIf id = UI_MENU_HELP Then
        UiTextDefaultMenuOther$ = "Help(&H)"
    ElseIf id = UI_MENU_HELP_KW Then
        UiTextDefaultMenuOther$ = "Keyword"
    ElseIf id = UI_MENU_HELP_ACTBA Then
        UiTextDefaultMenuOther$ = "actba64 Help"
    ElseIf id = UI_MENU_CTX_HELP_KW Then
        UiTextDefaultMenuOther$ = "Keyword help"
    Else
        UiTextDefaultMenuOther$ = ""
    End If
End Function

Function UiTextDefaultMenuWin$(ByVal id As Long) As String
    UiTextDefaultMenuWin$ = ""
    If id = UI_MENU_WINDOW Then UiTextDefaultMenuWin$ = "Window(&W)"
    If id = UI_MENU_VIEW Then UiTextDefaultMenuWin$ = "View(&V)"
    If id = UI_MENU_VIEWPROJ Then UiTextDefaultMenuWin$ = "Project View(&P)"
    If id = UI_MENU_CASCADE Then UiTextDefaultMenuWin$ = "Cascade(&C)"
    If id = UI_MENU_TILEHORZ Then UiTextDefaultMenuWin$ = "Tile Horizontal(&H)"
    If id = UI_MENU_TILEVERT Then UiTextDefaultMenuWin$ = "Tile Vertical(&V)"
    If id = UI_MENU_RUNWAIT Then UiTextDefaultMenuWin$ = "Run (Wait After Exit)(&W)"
End Function

Function UiTextDefault$(ByVal id As Long) As String
    UiTextDefault$ = UiTextDefaultMsg$(id)
    If UiTextDefault$ <> "" Then Exit Function
    UiTextDefault$ = UiTextDefaultMenuFile$(id)
    If UiTextDefault$ <> "" Then Exit Function
    UiTextDefault$ = UiTextDefaultMenuEdit$(id)
    If UiTextDefault$ <> "" Then Exit Function
    UiTextDefault$ = UiTextDefaultMenuOther$(id)
    If Len(UiTextDefault$) = 0 Then UiTextDefault$ = UiTextDefaultTail$(id)
End Function

Function UiTextDefaultFindDlg$(ByVal id As Long) As String
    UiTextDefaultFindDlg$ = ""
    If id = UI_FIND_TITLE Then UiTextDefaultFindDlg$ = "Find"
    If id = UI_FIND_NOT_FOUND Then UiTextDefaultFindDlg$ = "Cannot find the text."
    If id = UI_FIND_NEXT Then UiTextDefaultFindDlg$ = "Find Next"
    If id = UI_FIND_PREV Then UiTextDefaultFindDlg$ = "Find Previous"
    If id = UI_FIND_CLOSE Then UiTextDefaultFindDlg$ = "Close"
    If id = UI_FIND_CASE Then UiTextDefaultFindDlg$ = "Match case"
End Function

Function UiTextDefaultFindMenu$(ByVal id As Long) As String
    UiTextDefaultFindMenu$ = ""
    If id = UI_MENU_FIND Then UiTextDefaultFindMenu$ = "Find(&F)" + Chr$(9) + "Ctrl+F"
    If id = UI_MENU_FINDNEXT Then UiTextDefaultFindMenu$ = "Find Next(&N)" + Chr$(9) + "F3"
    If id = UI_MENU_FINDPREV Then UiTextDefaultFindMenu$ = "Find Previous(&V)" + Chr$(9) + "Shift+F3"
End Function

Function UiTextDefaultTail$(ByVal id As Long) As String
    UiTextDefaultTail$ = UiTextDefaultMenuWin$(id)
    If id = UI_ASK_SAVE Then UiTextDefaultTail$ = "Save changes to the following file?"
    If id = UI_MENU_SYNTAXN88 Then UiTextDefaultTail$ = "N88BASIC Syntax (-pN88)"
    If id = UI_MENU_SYNTAXAB2 Then UiTextDefaultTail$ = "ActiveBasic2 Syntax (-pAB2)"
    If id = UI_MENU_DEADSTRIP Then UiTextDefaultTail$ = "Remove Unused Procedures (-X)"
    If id = UI_MENU_NEWFORM Then UiTextDefaultTail$ = "New Form(&M)"
    If id = UI_TAB_CODE Then UiTextDefaultTail$ = "Code"
    If id = UI_TAB_DESIGN Then UiTextDefaultTail$ = "Designer"
    If id = UI_TEMP_ASK_SAVE Then UiTextDefaultTail$ = "The new project is still in a temporary folder. Save it?"
    If id = UI_MSG_TITLE Then UiTextDefaultTail$ = "Messages"
    If id = UI_BTN_YES Then UiTextDefaultTail$ = "Yes"
    If id = UI_BTN_NO Then UiTextDefaultTail$ = "No"
    If id = UI_BTN_CANCEL Then UiTextDefaultTail$ = "Cancel"
    If id = UI_MENU_TARGETLINUX Then UiTextDefaultTail$ = "Linux (ELF)"
    If id = UI_NEWFORM_EXISTS Then UiTextDefaultTail$ = "The file already exists. Choose another folder or project name."
    If Len(UiTextDefaultTail$) = 0 Then UiTextDefaultTail$ = UiTextDefaultFindDlg$(id)
    If Len(UiTextDefaultTail$) = 0 Then UiTextDefaultTail$ = UiTextDefaultFindMenu$(id)
    If Len(UiTextDefaultTail$) = 0 Then UiTextDefaultTail$ = UiTextDefaultAB4$(id)
    If Len(UiTextDefaultTail$) = 0 Then UiTextDefaultTail$ = UiTextDefaultProjEdit$(id)
    If Len(UiTextDefaultTail$) = 0 Then UiTextDefaultTail$ = UiTextDefaultDbg$(id)
End Function

Function UiTextDefaultProjEdit$(ByVal id As Long) As String
    UiTextDefaultProjEdit$ = ""
    If id = UI_PROJ_ADDFILE Then UiTextDefaultProjEdit$ = "Insert File(&I)..."
    If id = UI_PROJ_REMOVE Then UiTextDefaultProjEdit$ = "Remove from Project(&R)"
    If id = UI_PROJ_PROP Then UiTextDefaultProjEdit$ = "Properties(&P)"
    If id = UI_PROJ_ALREADY Then UiTextDefaultProjEdit$ = "The file is already in the project:"
    If id = UI_PROJ_MAIN Then UiTextDefaultProjEdit$ = "This file is the main file of the project."
    If id = UI_PROJ_REMOVE_ASK Then UiTextDefaultProjEdit$ = "Remove it from the project?"
    If id = UI_PROJ_CLOSE Then UiTextDefaultProjEdit$ = "Close Project(&C)"
    If Len(UiTextDefaultProjEdit$) = 0 Then UiTextDefaultProjEdit$ = UiTextDefaultProjProp$(id)
End Function

Function UiTextDefaultProjProp$(ByVal id As Long) As String
    UiTextDefaultProjProp$ = ""
    If id = UI_PROJ_PROP_TITLE Then UiTextDefaultProjProp$ = "Properties"
    If id = UI_PROJ_P_REL Then UiTextDefaultProjProp$ = "Path in project:"
    If id = UI_PROJ_P_FULL Then UiTextDefaultProjProp$ = "Full path:"
    If id = UI_PROJ_P_SIZE Then UiTextDefaultProjProp$ = "Size:"
    If id = UI_PROJ_P_BYTES Then UiTextDefaultProjProp$ = "bytes"
    If id = UI_PROJ_P_NOFILE Then UiTextDefaultProjProp$ = "The file does not exist."
End Function

Function UiTextDefaultAB4$(ByVal id As Long) As String
    UiTextDefaultAB4$ = ""
    If Len(UiTextDefaultAB4$) = 0 Then UiTextDefaultAB4$ = UiTextDefaultAB4_0$(id)
    If Len(UiTextDefaultAB4$) = 0 Then UiTextDefaultAB4$ = UiTextDefaultAB4_1$(id)
    If Len(UiTextDefaultAB4$) = 0 Then UiTextDefaultAB4$ = UiTextDefaultAB4_2$(id)
    If Len(UiTextDefaultAB4$) = 0 Then UiTextDefaultAB4$ = UiTextDefaultAB4_3$(id)
End Function

Function UiTextDefaultAB4_0$(ByVal id As Long) As String
    UiTextDefaultAB4_0$ = ""
    If id = UI_MENU_AB4PROJ Then UiTextDefaultAB4_0$ = "New AB4 Project(&P)..."
    If id = UI_AB4_TITLE Then UiTextDefaultAB4_0$ = "Create Project"
    If id = UI_AB4_NAME Then UiTextDefaultAB4_0$ = "Project name(&N):"
    If id = UI_AB4_DIR Then UiTextDefaultAB4_0$ = "Directory(&D):"
    If id = UI_AB4_BROWSE Then UiTextDefaultAB4_0$ = "Browse(&B)..."
    If id = UI_AB4_TYPE Then UiTextDefaultAB4_0$ = "Application type (Win32)"
    If id = UI_AB4_KIND0 Then UiTextDefaultAB4_0$ = "EXE - Normal window base"
End Function

Function UiTextDefaultAB4_1$(ByVal id As Long) As String
    UiTextDefaultAB4_1$ = ""
    If id = UI_AB4_KIND1 Then UiTextDefaultAB4_1$ = "EXE - N88 prompt base"
    If id = UI_AB4_KIND2 Then UiTextDefaultAB4_1$ = "EXE - DOS prompt base"
    If id = UI_AB4_KIND3 Then UiTextDefaultAB4_1$ = "EXE - No base"
    If id = UI_AB4_KIND4 Then UiTextDefaultAB4_1$ = "EXE - DirectX application"
    If id = UI_AB4_KIND5 Then UiTextDefaultAB4_1$ = "DLL - Procedure library"
    If id = UI_AB4_DESC0 Then UiTextDefaultAB4_1$ = "Makes a GUI application based on a normal window."
    If id = UI_AB4_DESC1 Then UiTextDefaultAB4_1$ = "Makes a program on an N88-BASIC style prompt window."
End Function

Function UiTextDefaultAB4_2$(ByVal id As Long) As String
    UiTextDefaultAB4_2$ = ""
    If id = UI_AB4_DESC2 Then UiTextDefaultAB4_2$ = "Makes a console (command prompt) program."
    If id = UI_AB4_DESC3 Then UiTextDefaultAB4_2$ = "Makes a program without a base window."
    If id = UI_AB4_DESC4 Then UiTextDefaultAB4_2$ = "Makes an application that uses DirectX. (Not available yet.)"
    If id = UI_AB4_DESC5 Then UiTextDefaultAB4_2$ = "Makes a DLL that exports procedures."
    If id = UI_AB4_HELLO Then UiTextDefaultAB4_2$ = "Show " + Chr$(34) + "Hello world!" + Chr$(34) + ""
    If id = UI_AB4_DESC Then UiTextDefaultAB4_2$ = "Description:"
    If id = UI_AB4_CREATE Then UiTextDefaultAB4_2$ = "Create"
End Function

Function UiTextDefaultAB4_3$(ByVal id As Long) As String
    UiTextDefaultAB4_3$ = ""
    If id = UI_AB4_ERR_NAME Then UiTextDefaultAB4_3$ = "Enter a project name of letters, digits and _ (not starting with a digit)."
    If id = UI_AB4_ERR_EXISTS Then UiTextDefaultAB4_3$ = "The project already exists:"
    If id = UI_AB4_ERR_WRITE Then UiTextDefaultAB4_3$ = "Cannot write the file:"
    If id = UI_AB4_ERR_DIR Then UiTextDefaultAB4_3$ = "Cannot make the folder:"
    If id = UI_AB4_BROWSE_TITLE Then UiTextDefaultAB4_3$ = "Choose the folder to make the project in."
    If id = UI_TAB_AB4 Then UiTextDefaultAB4_3$ = "AB4 Designer"
End Function

Function UiTextDefaultDbg$(ByVal id As Long) As String
    UiTextDefaultDbg$ = UiTextDefaultDbgMenu$(id) + UiTextDefaultDbgEnd$(id)
    If id = UI_DBG_NOTARGET Then UiTextDefaultDbg$ = "The debugger works only with Windows programs (choose 64bit or 32bit in the Basic menu)."
    If id = UI_DBG_NOABDBG Then UiTextDefaultDbg$ = "abdbg.exe was not found (place it beside the editor)."
    If id = UI_DBG_START Then UiTextDefaultDbg$ = "Debugging: "
    If id = UI_DBG_NOSTART Then UiTextDefaultDbg$ = "Failed to start abdbg.exe."
    If id = UI_DBG_STOPPED Then UiTextDefaultDbg$ = "Stopped: "
    If id = UI_DBG_EXIT Then UiTextDefaultDbg$ = "The program exited. Exit code: "
    UiTextDefaultDbg$ = UiTextDefaultDbg$ + UiTextDefaultDbgList$(id)
End Function

Function UiTextDefaultDbgList$(ByVal id As Long) As String
    UiTextDefaultDbgList$ = ""
    If id = UI_DBG_STACK Then UiTextDefaultDbgList$ = "Call stack"
    If id = UI_DBG_VARS Then UiTextDefaultDbgList$ = "Variables"
    If id = UI_DBG_GLOBALS Then UiTextDefaultDbgList$ = "Global"
    If id = UI_DBG_LOCALS Then UiTextDefaultDbgList$ = "Local"
    If id = UI_MENU_DEBUG Then UiTextDefaultDbgList$ = "Debug(&D)"
End Function

Function UiTextDefaultDbgEnd$(ByVal id As Long) As String
    UiTextDefaultDbgEnd$ = ""
    If id = UI_DBG_ENDED Then UiTextDefaultDbgEnd$ = "Debugging stopped."
    If id = UI_DBG_LINUX Then UiTextDefaultDbgEnd$ = "The debugger is not available in the Linux version."
    If id = UI_MENU_DBG_COND Then UiTextDefaultDbgEnd$ = "Conditional Breakpoint(&N)..."
    If id = UI_DBG_CONDTITLE Then UiTextDefaultDbgEnd$ = "Stop only when (e.g. i = 5, n >= 10). Leave empty to always stop:"
    If id = UI_DBG_PANE Then UiTextDefaultDbgEnd$ = "Debug"
End Function

Function UiTextDefaultDbgMenu$(ByVal id As Long) As String
    UiTextDefaultDbgMenu$ = ""
    If id = UI_MENU_DBG_GO Then UiTextDefaultDbgMenu$ = "Start / Continue Debugging(&D) (F5)"
    If id = UI_MENU_DBG_STOP Then UiTextDefaultDbgMenu$ = "Stop Debugging (Shift+F5)"
    If id = UI_MENU_DBG_OVER Then UiTextDefaultDbgMenu$ = "Step Over (F10)"
    If id = UI_MENU_DBG_IN Then UiTextDefaultDbgMenu$ = "Step Into (F11)"
    If id = UI_MENU_DBG_OUT Then UiTextDefaultDbgMenu$ = "Step Out (Shift+F11)"
    If id = UI_MENU_DBG_BP Then UiTextDefaultDbgMenu$ = "Toggle Breakpoint (F9)"
End Function
