' AB4ProjText - 「AB4 プロジェクト作成」が書くファイルの中身（文字列だけ。ファイルは AB4ProjWrite.sbp）。
' AB 4.20 の「プロジェクトを作成」の「EXE - ノーマル ウィンドウ ベース」と同じ形:
'   name.pj  name.abp（メッセージループ）  name.idx  name.wnd（MainWnd）  MainWnd.sbp  name.wrk
' 「EXE - N88 プロンプト ベース」は name.pj（#USEWINDOW=0）  name.abp（#N88BASIC）  name.idx  name.wrk だけ。
' 「EXE - DOS プロンプト ベース」も同じ 4 つで、.abp の #N88BASIC が #console になるだけ。
' 「EXE - ベースなし」も同じ 4 つで、.abp に指令を置かない（Hello world! も足さない）。
' 「DLL - プロシージャ ライブラリ」も同じ 4 つで、.pj が #MODULETYPE=1・<名前>.dll、.abp が DllMain の雛形。
' この 4 種類を「<名前>.abp だけのプロジェクト」（AB4Proj_Single*）と呼ぶ。
' Callback.wbp / MakeWindow.wbp は .wnd と MainWnd.sbp から RadGen で作る（AB4ProjWrite.sbp）。
' 改行は nl。文字列は UTF-8（書くときに Shift_JIS にする）。

Const AB4PROJ_NORMAL = 0       ' EXE - ノーマル ウィンドウ ベース
Const AB4PROJ_N88 = 1          ' EXE - N88 プロンプト ベース
Const AB4PROJ_DOS = 2          ' EXE - DOS プロンプト ベース
Const AB4PROJ_NOBASE = 3       ' EXE - ベースなし
Const AB4PROJ_DIRECTX = 4      ' EXE - DirectX 対応アプリケーション
Const AB4PROJ_DLL = 5          ' DLL - プロシージャ ライブラリ

' 作れる種類か
Function AB4Proj_CanMake(ByVal kind As Long) As Long
    AB4Proj_CanMake = 0
    If kind = AB4PROJ_NORMAL Or AB4Proj_IsSingle(kind) <> 0 Then AB4Proj_CanMake = 1
End Function

' "Hello world!" 表示を選べる種類か（ベースなし・DLL は出す先が無いので選べない）
Function AB4Proj_HasHello(ByVal kind As Long) As Long
    AB4Proj_HasHello = 0
    If kind = AB4PROJ_NORMAL Or kind = AB4PROJ_N88 Or kind = AB4PROJ_DOS Then AB4Proj_HasHello = 1
End Function

' ProjectCmd -createPj の種類のオプション（作れない種類は ""）
Function AB4Proj_KindOpt$(ByVal kind As Long) As String
    AB4Proj_KindOpt$ = ""
    If kind = AB4PROJ_NORMAL Then AB4Proj_KindOpt$ = "-normalWnd"
    If kind = AB4PROJ_N88 Then AB4Proj_KindOpt$ = "-n88"
    If kind = AB4PROJ_DOS Then AB4Proj_KindOpt$ = "-dos"
    If kind = AB4PROJ_NOBASE Then AB4Proj_KindOpt$ = "-noBase"
    If kind = AB4PROJ_DLL Then AB4Proj_KindOpt$ = "-dll"
End Function

' オプション（大文字小文字は問わない）から種類。種類のオプションでなければ -1。-nomalWnd は -normalWnd の別名
Function AB4Proj_KindOfOpt(opt As String) As Long
    Dim k As Long, o As String
    o = Lower$(opt)
    AB4Proj_KindOfOpt = AB4PROJ_NORMAL
    If o = "-nomalwnd" Then Exit Function
    For k = 0 To AB4PROJ_DLL
        If Lower$(AB4Proj_KindOpt$(k)) = o Then AB4Proj_KindOfOpt = k : Exit Function
    Next
    AB4Proj_KindOfOpt = -1
End Function

' .pj の #SOURCE の前まで。useWindow は #USEWINDOW の値
Function AB4Proj_PjHead$(name As String, useWindow As String, nl As String) As String
    AB4Proj_PjHead$ = AB4Proj_PjHeadMod$(name, useWindow, "0", ".exe", nl)
End Function

' modType は #MODULETYPE（0 = EXE、1 = DLL）、ext は #OUTPUT_RELEASE の拡張子。#OUTPUT_DEBUG は DLL でも _debug.exe（AB 4.20 と同じ）
Function AB4Proj_PjHeadMod$(name As String, useWindow As String, modType As String, ext As String, nl As String) As String
    Dim s As String
    s = "' ActiveBasic Project file." & nl & nl & EditorNewForm_PjKey$("VERSION", "9", nl)
    s = s & EditorNewForm_PjKey$("MODULETYPE", modType, nl) & EditorNewForm_PjKey$("NAME", name, nl)
    s = s & EditorNewForm_PjKey$("PLATFORM", "32", nl) & EditorNewForm_PjKey$("USEWINDOW", useWindow, nl)
    s = s & EditorNewForm_PjKey$("OPTION", "&H00010000", nl)
    s = s & EditorNewForm_PjKey$("OUTPUT_RELEASE", ".\" & name & ext, nl)
    AB4Proj_PjHeadMod$ = s & EditorNewForm_PjKey$("OUTPUT_DEBUG", ".\" & name & "_debug.exe", nl) & EditorNewForm_PjKey$("RESOURCE", "0", nl)
End Function

Function AB4Proj_Pj$(name As String, nl As String) As String
    AB4Proj_Pj$ = AB4Proj_PjHead$(name, "1", nl) & "#SOURCE" & nl & name & ".abp" & nl & "MainWnd.sbp" & nl
End Function

Function AB4Proj_Abp$(name As String, nl As String) As String
    Dim s As String, t As String
    t = Chr$(9)
    s = AB4Proj_Inc$(name & ".idx", nl) & nl & "'---------------------------" & nl
    s = s & "'  Window Message Loop" & nl & "'---------------------------" & nl & "Dim msgMain As MSG, iResult As Long" & nl
    s = s & "Do" & nl & t & "iResult=GetMessage(msgMain,0,0,0)" & nl & t & "If iResult=0 or iResult=-1 Then Exit Do" & nl
    s = s & t & "TranslateMessage(msgMain)" & nl & t & "DispatchMessage(msgMain)" & nl & "Loop" & nl & nl
    AB4Proj_Abp$ = s & "' Call destructores and exit process" & nl & "End" & nl
End Function

Function AB4Proj_Inc$(file As String, nl As String) As String
    AB4Proj_Inc$ = "#include " & Chr$(34) & file & Chr$(34) & nl
End Function

Function AB4Proj_Idx$(nl As String) As String
    Dim s As String
    s = "' インデックス プログラム" & nl & nl & "#strict" & nl & nl & "'Win32APIの定義ファイル" & nl & nl
    s = s & "'RADツールが生成するウィンドウ制御プログラム" & nl & AB4Proj_Inc$("Callback.wbp", nl) & nl
    s = s & "'プロジェクト内のプログラム ファイル" & nl & AB4Proj_Inc$("MainWnd.sbp", nl) & nl
    AB4Proj_Idx$ = s & "'RADツールが生成するウィンドウ生成プログラム" & nl & AB4Proj_Inc$("MakeWindow.wbp", nl)
End Function

Function AB4Proj_WndKey$(key As String, v As String, nl As String) As String
    AB4Proj_WndKey$ = "    " & Left$(key & "          ", 10) & "= " & v & nl
End Function

Function AB4Proj_Wnd$(name As String, nl As String) As String
    Dim s As String, q As String
    q = Chr$(34)
    s = "WINDOW:MainWnd" & nl & AB4Proj_WndKey$("HANDLE", "hMainWnd", nl) & AB4Proj_WndKey$("POINT", "-2147483648,-2147483648", nl)
    s = s & AB4Proj_WndKey$("SIZE", "480,360", nl) & AB4Proj_WndKey$("CAPTION", q & name & q, nl) & AB4Proj_WndKey$("STYLE", "&H10cf0000", nl)
    s = s & AB4Proj_WndKey$("EXSTYLE", "&H00000000", nl) & AB4Proj_WndKey$("ID", "0", nl) & AB4Proj_WndKey$("BGCOLOR", "15", nl)
    s = s & AB4Proj_WndKey$("FONT", "-12,0,0,0,400,0,0,0,128,3,2,1,32," & q & "ＭＳ Ｐゴシック" & q, nl) & AB4Proj_WndKey$("CLASS", q & "NORMAL" & q, nl)
    s = s & AB4Proj_WndKey$("CALLBACK", "MainWndProc", nl) & AB4Proj_WndKey$("TYPE", "0", nl)
    AB4Proj_Wnd$ = s & AB4Proj_WndKey$("FILEPATH", "MainWnd.sbp", nl) & "END" & nl
End Function

Function AB4Proj_Bar$(nl As String) As String
    AB4Proj_Bar$ = "'-----------------------------------------------------------------------------" & nl
End Function

Function AB4Proj_MainHead$(nl As String) As String
    Dim s As String
    s = AB4Proj_Bar$(nl) & "'  イベント プロシージャ" & nl & AB4Proj_Bar$(nl)
    s = s & "' このファイルには、ウィンドウ [MainWnd] に関するイベントをコーディングします。" & nl
    s = s & "' ウィンドウ ハンドル: hMainWnd" & nl & nl
    AB4Proj_MainHead$ = s & "' TODO: この位置にグローバルな変数、構造体、定数、関数を定義します。" & nl & nl & nl
End Function

Function AB4Proj_MainProc$(nl As String) As String
    Dim s As String, t As String
    t = Chr$(9)
    s = AB4Proj_Bar$(nl) & "' ウィンドウメッセージを処理するためのコールバック関数" & nl & nl
    s = s & "Function MainWndProc(hWnd As HWND, dwMsg As DWord, wParam As WPARAM, lParam As LPARAM) As DWord" & nl
    s = s & t & "' TODO: この位置にウィンドウメッセージを処理するためのコードを記述します。" & nl & nl
    s = s & t & "' イベントプロシージャの呼び出しを行います。" & nl
    AB4Proj_MainProc$ = s & t & "MainWndProc=EventCall_MainWnd(hWnd,dwMsg,wParam,lParam)" & nl & "End Function" & nl & nl & nl
End Function

' hello <> 0 なら、窓に Hello world! を書く Paint イベントを足す
Function AB4Proj_MainEvents$(name As String, ByVal hello As Long, nl As String) As String
    Dim s As String, t As String
    t = Chr$(9)
    s = AB4Proj_Bar$(nl) & "' ここから下は、イベントプロシージャを記述するための領域になります。" & nl & nl
    s = s & "Sub MainWnd_Destroy()" & nl & t & name & "_DestroyObjects()" & nl & t & "PostQuitMessage(0)" & nl & "End Sub" & nl
    AB4Proj_MainEvents$ = s
    If hello = 0 Then Exit Function
    s = s & nl & "Sub MainWnd_Paint(hDC As HDC)" & nl & t & "SetBkMode(hDC,TRANSPARENT)" & nl
    AB4Proj_MainEvents$ = s & t & "TextOut(hDC,10,10," & Chr$(34) & "Hello world!" & Chr$(34) & ",12)" & nl & "End Sub" & nl
End Function

Function AB4Proj_MainWnd$(name As String, ByVal hello As Long, nl As String) As String
    AB4Proj_MainWnd$ = AB4Proj_MainHead$(nl) & AB4Proj_MainProc$(nl) & AB4Proj_MainEvents$(name, hello, nl)
End Function

' .wrk。opened は開いている窓の行。最後の行に改行は付けない（AB 4.20 と同じ）
Function AB4Proj_WrkOf$(opened As String, nl As String) As String
    AB4Proj_WrkOf$ = "case4" & nl & nl & opened & nl & nl & "0" & nl & "0" & nl & "0" & nl & "0,0,0,0,0"
End Function

Function AB4Proj_Wrk$(nl As String) As String
    AB4Proj_Wrk$ = AB4Proj_WrkOf$("rad,MainWnd", nl)
End Function

' ---- <名前>.abp だけのプロジェクト（N88 / DOS プロンプト ベース・ベースなし・DLL）----
' .idx .wrk は 4 つとも同じ。.pj は DLL だけ #MODULETYPE=1・<名前>.dll。.abp は種類ごとに違う

' <名前>.abp だけのプロジェクトか（RAD の窓を持たない。作ったら <名前>.abp を開く）
Function AB4Proj_IsSingle(ByVal kind As Long) As Long
    AB4Proj_IsSingle = 0
    If kind = AB4PROJ_N88 Or kind = AB4PROJ_DOS Or kind = AB4PROJ_NOBASE Or kind = AB4PROJ_DLL Then AB4Proj_IsSingle = 1
End Function

Function AB4Proj_SinglePj$(name As String, ByVal kind As Long, nl As String) As String
    Dim head As String
    head = AB4Proj_PjHead$(name, "0", nl)
    If kind = AB4PROJ_DLL Then head = AB4Proj_PjHeadMod$(name, "0", "1", ".dll", nl)
    AB4Proj_SinglePj$ = head & "#SOURCE" & nl & name & ".abp" & nl
End Function

Function AB4Proj_SingleAbp$(name As String, ByVal kind As Long, ByVal hello As Long, nl As String) As String
    If kind = AB4PROJ_DLL Then AB4Proj_SingleAbp$ = AB4Proj_DllAbp$(name, nl) : Exit Function
    AB4Proj_SingleAbp$ = AB4Proj_PromptAbp$(name, kind, hello, nl)
End Function

Function AB4Proj_SingleIdx$(nl As String) As String
    AB4Proj_SingleIdx$ = "' インデックス プログラム" & nl & nl & "#strict" & nl & nl & "'Win32APIの定義ファイル" & nl
End Function

Function AB4Proj_SingleWrk$(name As String, nl As String) As String
    AB4Proj_SingleWrk$ = AB4Proj_WrkOf$("text," & Chr$(34) & name & ".abp" & Chr$(34) & ",0,0,0,0", nl)
End Function

' .abp に置く指令。N88 は N88 の窓、DOS はコマンド プロンプトで動く。ベースなしは ""
Function AB4Proj_PromptDirective$(ByVal kind As Long) As String
    AB4Proj_PromptDirective$ = "#N88BASIC"
    If kind = AB4PROJ_DOS Then AB4Proj_PromptDirective$ = "#console"
    If kind = AB4PROJ_NOBASE Then AB4Proj_PromptDirective$ = ""
End Function

' N88 / DOS / ベースなしの .abp。hello <> 0 なら Print "Hello World!" を足す（AB 4.20 と同じく W は大文字。ベースなしは足さない）
Function AB4Proj_PromptAbp$(name As String, ByVal kind As Long, ByVal hello As Long, nl As String) As String
    Dim s As String, d As String
    d = AB4Proj_PromptDirective$(kind)
    s = AB4Proj_Inc$(name & ".idx", nl) & nl
    If Len(d) > 0 Then s = s & d & nl & nl
    s = s & "' ↓ ここからプログラムが実行されます" & nl & nl
    If hello <> 0 And AB4Proj_HasHello(kind) <> 0 Then s = s & "Print " & Chr$(34) & "Hello World!" & Chr$(34) & nl
    AB4Proj_PromptAbp$ = s
End Function

Function AB4Proj_DllMemo$(nl As String) As String
    Dim s As String, bar As String, ind As String
    bar = "'-------------------------------------------------------------------" & nl
    ind = "'        "
    s = bar & "' メモ - このファイルには、DLLの構成要素を記述します。" & nl & ind & "（例：関数定義、グローバル変数、定数定義など）" & nl & "'" & nl
    s = s & ind & "エクスポートが必要な関数には、" & Chr$(34) & "Export" & Chr$(34) & " 修飾子を指定します。" & nl
    AB4Proj_DllMemo$ = s & ind & "（例：Function Export FuncName() As Long）" & nl & bar & nl
End Function

' DLL の .abp（DllMain の雛形）
Function AB4Proj_DllAbp$(name As String, nl As String) As String
    Dim s As String, t As String
    t = Chr$(9)
    s = AB4Proj_Inc$(name & ".idx", nl) & nl & AB4Proj_DllMemo$(nl)
    s = s & "Function Export DllMain(hinstDLL As HINSTANCE, fdwReason As DWord, lpvReserved As VoidPtr) As Long" & nl
    s = s & t & "'DLLエントリポイント" & nl & t & "Select Case fdwReason" & nl & t & t & "Case DLL_PROCESS_ATTACH" & nl
    s = s & t & t & t & "'DLLがプロセス空間にロードされた時に実行されます。" & nl & t & t & t & "_System_StartupProgram()" & nl
    AB4Proj_DllAbp$ = s & t & t & t & "DllMain=1" & nl & t & "End Select" & nl & "End Function" & nl & nl
End Function

' 名前に使える 1 文字か（英字・_、2 文字目からは数字も）。名前は <name>_DestroyObjects などの識別子になる
Function AB4Proj_IdCh(c As String, ByVal pos As Long) As Long
    AB4Proj_IdCh = 1
    If c = "_" Or (c >= "A" And c <= "Z") Or (c >= "a" And c <= "z") Then Exit Function
    If pos > 1 And c >= "0" And c <= "9" Then Exit Function
    AB4Proj_IdCh = 0
End Function

' プロジェクト名に使えるか（ASCII の識別子で 64 文字まで）
Function AB4Proj_NameOk(name As String) As Long
    Dim i As Long
    AB4Proj_NameOk = 0
    If Len(name) = 0 Or Len(name) > 64 Then Exit Function
    For i = 1 To Len(name)
        If AB4Proj_IdCh(Mid$(name, i, 1), i) = 0 Then Exit Function
    Next
    AB4Proj_NameOk = 1
End Function

' ---- パス ----

Function AB4Proj_Sep$() As String
    AB4Proj_Sep$ = "\"
#ifdef _LINUX
    AB4Proj_Sep$ = "/"
#endif
End Function

' 末尾の \ / を 1 つにそろえる（"" はそのまま）
Function AB4Proj_DirSlash$(dir As String) As String
    AB4Proj_DirSlash$ = dir
    If Len(dir) = 0 Then Exit Function
    While Len(AB4Proj_DirSlash$) > 1 And (Right$(AB4Proj_DirSlash$, 1) = "\" Or Right$(AB4Proj_DirSlash$, 1) = "/")
        AB4Proj_DirSlash$ = Left$(AB4Proj_DirSlash$, Len(AB4Proj_DirSlash$) - 1)
    Wend
    AB4Proj_DirSlash$ = AB4Proj_DirSlash$ & AB4Proj_Sep$()
End Function

' プロジェクトのフォルダー（末尾に区切り）
Function AB4Proj_Folder$(parent As String, name As String) As String
    AB4Proj_Folder$ = AB4Proj_DirSlash$(parent) & name & AB4Proj_Sep$()
End Function

Function AB4Proj_Exists(path As String) As Long
    AB4Proj_Exists = 1
    If GetFileAttributes(StrPtr(path)) = -1 Then AB4Proj_Exists = 0
End Function
