' AB4 デザイナーの部品の絵（Ab4Design.sbp から呼ぶ）。種類ごとの描き方は Ab4D_Kind（Ab4DesignText.sbp）。
' 押しボタン・チェック・ラジオ・文字・囲み・白い欄はフォームデザイナと同じ絵（FormDesignCtlView.sbp）。
' 動かないので、スクロール バーのつまみやトラック バーのつまみは左端（上端）に置いて描く。

Const AB4D_ARROW_W = 17                     ' コンボの ▼ ボタンの幅
Const AB4D_COMBO_H = 21                     ' コンボの欄の高さ（ITEM の高さはリストを開いた高さ）

Sub Ab4D_Btn(hDC As HDC, ByVal l As Long, ByVal t As Long, ByVal r As Long, ByVal b As Long, cap As String)
    Dim rc As RECT
    FormDesign_Rect(rc, l, t, r, b)
    Ui_ButtonFrame(hDC, rc, DFCS_BUTTONPUSH)
    Ui_TextColor(hDC, Ui_SysColor(COLOR_BTNTEXT))
    Ui_TextCenter(hDC, rc, cap)
End Sub

' コンボ。上に 21 の高さの白い欄と、右に ▼ のボタン
Sub Ab4D_DrawCombo(hDC As HDC, ByRef rc As RECT, cap As String)
    Dim e As RECT, b As Long
    b = rc.top + AB4D_COMBO_H
    If b > rc.bottom Then b = rc.bottom
    FormDesign_Rect(e, rc.left, rc.top, rc.right, b)
    FormDesign_DrawEdit(hDC, e, cap)
    Ab4D_Btn(hDC, rc.right - 2 - AB4D_ARROW_W, rc.top + 2, rc.right - 2, b - 2, "▼")
End Sub

' 横のスクロール バー。地の色、両端に ◀ ▶、左につまみ
Sub Ab4D_DrawHScroll(hDC As HDC, ByRef rc As RECT)
    Dim h As Long
    h = rc.bottom - rc.top
    FormDesign_Fill(hDC, rc.left, rc.top, rc.right, rc.bottom, Ui_SysColor(COLOR_SCROLLBAR))
    Ab4D_Btn(hDC, rc.left, rc.top, rc.left + h, rc.bottom, "◀")
    Ab4D_Btn(hDC, rc.right - h, rc.top, rc.right, rc.bottom, "▶")
    Ab4D_Btn(hDC, rc.left + h, rc.top, rc.left + h * 2, rc.bottom, "")
End Sub

' 縦のスクロール バー。上下に ▲ ▼、上につまみ
Sub Ab4D_DrawVScroll(hDC As HDC, ByRef rc As RECT)
    Dim w As Long
    w = rc.right - rc.left
    FormDesign_Fill(hDC, rc.left, rc.top, rc.right, rc.bottom, Ui_SysColor(COLOR_SCROLLBAR))
    Ab4D_Btn(hDC, rc.left, rc.top, rc.right, rc.top + w, "▲")
    Ab4D_Btn(hDC, rc.left, rc.bottom - w, rc.right, rc.bottom, "▼")
    Ab4D_Btn(hDC, rc.left, rc.top + w, rc.right, rc.top + w * 2, "")
End Sub

' UpDown。縦なら ▲ / ▼ の 2 つ、UDS_HORZ（&H40）なら ◀ / ▶ の 2 つ
Sub Ab4D_DrawUpDown(hDC As HDC, ByRef rc As RECT, ByVal st As Long)
    Dim mx As Long, my As Long
    mx = (rc.left + rc.right) \ 2
    my = (rc.top + rc.bottom) \ 2
    If (st And &H40) <> 0 Then
        Ab4D_Btn(hDC, rc.left, rc.top, mx, rc.bottom, "◀")
        Ab4D_Btn(hDC, mx, rc.top, rc.right, rc.bottom, "▶")
        Exit Sub
    End If
    Ab4D_Btn(hDC, rc.left, rc.top, rc.right, my, "▲")
    Ab4D_Btn(hDC, rc.left, my, rc.right, rc.bottom, "▼")
End Sub

' ProgressBar。へこんだ枠だけ（まだ進んでいない）
Sub Ab4D_DrawProgress(hDC As HDC, ByRef rc As RECT)
    FormDesign_Fill(hDC, rc.left, rc.top, rc.right, rc.bottom, Ui_SysColor(COLOR_BTNFACE))
    Ui_Edge(hDC, rc, BDR_SUNKENOUTER, BF_RECT)
End Sub

' TrackBar。真ん中にへこんだ溝、左（縦なら上）につまみ。TBS_VERT は &H2
Sub Ab4D_DrawTrack(hDC As HDC, ByRef rc As RECT, ByVal st As Long)
    Dim g As RECT, mx As Long, my As Long
    mx = (rc.left + rc.right) \ 2
    my = (rc.top + rc.bottom) \ 2
    If (st And &H2) <> 0 Then
        FormDesign_Rect(g, mx - 2, rc.top + 8, mx + 2, rc.bottom - 8)
        Ui_Edge(hDC, g, EDGE_SUNKEN, BF_RECT)
        Ab4D_Btn(hDC, mx - 10, rc.top + 3, mx + 10, rc.top + 14, "")
        Exit Sub
    End If
    FormDesign_Rect(g, rc.left + 8, my - 2, rc.right - 8, my + 2)
    Ui_Edge(hDC, g, EDGE_SUNKEN, BF_RECT)
    Ab4D_Btn(hDC, rc.left + 3, my - 10, rc.left + 14, my + 10, "")
End Sub

' ImageBox（STATIC の絵の枠）。様式の下位 5 ビット: 7 黒、8 灰、9 白の枠。ほかはへこんだ枠
Sub Ab4D_DrawFrameBox(hDC As HDC, ByRef rc As RECT, ByVal st As Long)
    Dim k As Long
    k = st And &H1F
    If k = 7 Then Ui_Frame(hDC, rc, RGB(0, 0, 0))
    If k = 8 Then Ui_Frame(hDC, rc, RGB(128, 128, 128))
    If k = 9 Then Ui_Frame(hDC, rc, RGB(255, 255, 255))
    If k < 7 Or k > 9 Then Ui_Edge(hDC, rc, BDR_SUNKENOUTER, BF_RECT)
End Sub

' ListBox / ListView / TreeView。白地。WS_EX_CLIENTEDGE（&H200）ならへこんだ枠、なければ黒い線。名前を灰色で
Sub Ab4D_DrawList(hDC As HDC, ByRef rc As RECT, ByVal ex As Long, name As String)
    FormDesign_Fill(hDC, rc.left, rc.top, rc.right, rc.bottom, RGB(255, 255, 255))
    If (ex And &H200) <> 0 Then Ui_Edge(hDC, rc, EDGE_SUNKEN, BF_RECT)
    If (ex And &H200) = 0 Then Ui_Frame(hDC, rc, RGB(0, 0, 0))
    Ui_TextColor(hDC, Ui_SysColor(COLOR_GRAYTEXT))
    Ui_TextCenter(hDC, rc, name)
End Sub

' 部品 i を rc に描く
Sub Ab4D_DrawPart(hDC As HDC, ByRef rc As RECT, ByVal i As Long)
    Dim k As Long, st As Long
    k = Ab4D_Kind(g_riType(i))
    st = Ab4D_HexNum(g_riStyle(i))
    If k <= AB4K_LABEL Then Ab4D_DrawSimple(hDC, rc, k, g_riCaption(i))
    If k = AB4K_BOX Then Ab4D_DrawList(hDC, rc, Ab4D_HexNum(g_riExStyle(i)), g_riName(i))
    If k = AB4K_COMBO Then Ab4D_DrawCombo(hDC, rc, g_riCaption(i))
    If k >= AB4K_HSCROLL Then Ab4D_DrawBarGui(hDC, rc, k, st)
End Sub

' バーの ◀ ▶ ▲ ▼ は窓のフォントでなく、いつもの文字で描く（本物のスクロール バーもフォントを使わない）
Sub Ab4D_DrawBarGui(hDC As HDC, ByRef rc As RECT, ByVal k As Long, ByVal st As Long)
    Dim old As HFONT
    old = Ui_SelectFont(hDC, Ui_GuiFont())
    Ab4D_DrawBar(hDC, rc, k, st)
    Ui_SelectFont(hDC, old)
End Sub

' フォームデザイナと同じ絵の部品
Sub Ab4D_DrawSimple(hDC As HDC, ByRef rc As RECT, ByVal k As Long, cap As String)
    If k = AB4K_BUTTON Then FormDesign_DrawButton(hDC, rc, cap)
    If k = AB4K_CHECK Then FormDesign_DrawCheckBox(hDC, rc, cap)
    If k = AB4K_RADIO Then FormDesign_DrawRadio(hDC, rc, cap)
    If k = AB4K_EDIT Then FormDesign_DrawEdit(hDC, rc, cap)
    If k = AB4K_GROUP Then FormDesign_DrawGroup(hDC, rc, cap)
    If k = AB4K_LABEL Then FormDesign_DrawLabel(hDC, rc, cap)
End Sub

' バーと枠の部品（AB4K_HSCROLL 以降）
Sub Ab4D_DrawBar(hDC As HDC, ByRef rc As RECT, ByVal k As Long, ByVal st As Long)
    If k = AB4K_HSCROLL Then Ab4D_DrawHScroll(hDC, rc)
    If k = AB4K_VSCROLL Then Ab4D_DrawVScroll(hDC, rc)
    If k = AB4K_UPDOWN Then Ab4D_DrawUpDown(hDC, rc, st)
    If k = AB4K_PROGRESS Then Ab4D_DrawProgress(hDC, rc)
    If k = AB4K_TRACK Then Ab4D_DrawTrack(hDC, rc, st)
    If k = AB4K_FRAME Then Ab4D_DrawFrameBox(hDC, rc, st)
End Sub
