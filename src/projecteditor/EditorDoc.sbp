Dim g_docPath As String
Dim g_docDirty As Long
Dim g_docEncoding As Long

Function EditorDoc_EncodingLabel$() As String
    If g_docEncoding = ENC_UTF8_BOM Then
        EditorDoc_EncodingLabel$ = "UTF-8 BOM"
    ElseIf g_docEncoding = ENC_CP932 Then
        EditorDoc_EncodingLabel$ = "Shift-JIS"
    Else
        EditorDoc_EncodingLabel$ = "UTF-8"
    End If
End Function

Function EditorDoc_BaseTitle$() As String
    If Len(g_docPath) = 0 Then
        EditorDoc_BaseTitle$ = "editor - (untitled)"
    Else
        EditorDoc_BaseTitle$ = "editor - " + g_docPath
    End If
End Function

Sub EditorDoc_UpdateTitle(hWnd As HWND)
    Dim title As String
    title = EditorDoc_BaseTitle$()
    title = title + " [" + EditorBuild_TargetLabel$() + ", " + EditorDoc_EncodingLabel$() + "]"
    If g_docDirty <> 0 Then title = title + " *"
    MdiSetDocTitle(hWnd, title)
End Sub

Sub EditorDoc_MarkDirty()
    g_docDirty = 1
    If g_activeChild <> 0 Then EditorDoc_UpdateTitle(g_activeChild)
End Sub

Sub EditorDoc_ClearDirty()
    g_docDirty = 0
    If g_activeChild <> 0 Then EditorDoc_UpdateTitle(g_activeChild)
End Sub

Function EditorDoc_FileThere(path As *Byte) As Long
    Dim h As HANDLE
    EditorDoc_FileThere = 0
    h = FileOpenRead(path)
    If h = INVALID_HANDLE_VALUE Then Exit Function
    CloseHandle(h)
    EditorDoc_FileThere = 1
End Function

Function EditorDoc_FromBytes$(p As *Byte, n As Long) As String
    g_docEncoding = Enc_Detect(p, n)
    EditorDoc_FromBytes$ = Enc_BytesToUtf8$(p, n, g_docEncoding)
End Function

Function EditorDoc_EmptyDoc$() As String
    Dim b As Byte
    b = 0
    EditorDoc_EmptyDoc$ = EditorDoc_FromBytes$(VarPtr(b), 0)
End Function

Function EditorDoc_TakeLoad$(path As *Byte) As String
    Dim n As Long
    Dim p As *Byte
    p = LoadFile(path, n)
    EditorDoc_TakeLoad$ = EditorDoc_EmptyDoc$()
    If p = 0 Then Exit Function
    EditorDoc_TakeLoad$ = EditorDoc_FromBytes$(p, n)
    free(p)
End Function

Function EditorDoc_LoadTextFile$(path As String) As String
    EditorDoc_LoadTextFile$ = ""
    If EditorDoc_FileThere(StrPtr(path)) = 0 Then Exit Function
    EditorDoc_LoadTextFile$ = EditorDoc_TakeLoad$(StrPtr(path))
End Function

Sub EditorDoc_FreeBytes(bytes As *Byte)
    If bytes <> 0 Then free(bytes)
End Sub

Function EditorDoc_WriteTextFile(path As String, text As String) As Long
    Dim n As Long
    Dim bytes As *Byte
    EditorDoc_WriteTextFile = 0
    bytes = Enc_EncodeText(text, g_docEncoding, n)
    If bytes = 0 And n > 0 Then Exit Function
    EditorDoc_WriteTextFile = WriteAll(StrPtr(path), bytes, n)
    EditorDoc_FreeBytes(bytes)
End Function

Sub EditorDoc_New(hWnd As HWND)
    g_docPath = ""
    g_docEncoding = ENC_UTF8
    TextBuf_SetText("")
    EditorUndo_Reset()
    VirtualScroll_Init()
    EditorDoc_ClearDirty()
    EditorDoc_UpdateTitle(hWnd)
    InvalidateRect(hWnd, ByVal 0, TRUE)
End Sub

Sub EditorDoc_PutFilt(dst As *Byte, ByRef o As Long, s As String)
    Dim p As *Byte
    Dim i As Long
    p = StrPtr(s)
    For i = 0 To Len(s) - 1
        dst[o + i] = p[i]
    Next
    o = o + Len(s) + 1
End Sub

Sub EditorDoc_FiltSrc(dst As *Byte, ByRef o As Long)
    EditorDoc_PutFilt(dst, o, "Source (*.sbp;*.abp;*.bas)")
    EditorDoc_PutFilt(dst, o, "*.sbp;*.abp;*.bas")
    EditorDoc_PutFilt(dst, o, "Project (*.pj)")
    EditorDoc_PutFilt(dst, o, "*.pj")
End Sub

Sub EditorDoc_FiltRest(dst As *Byte, ByRef o As Long)
    EditorDoc_PutFilt(dst, o, "All (*.*)")
    EditorDoc_PutFilt(dst, o, "*.*")
End Sub

Sub EditorDoc_InitFilter(ByVal dst As *Byte)
    Dim o As Long
    FillMemory(dst, 128, 0)
    EditorDoc_FiltSrc(dst, o)
    EditorDoc_FiltRest(dst, o)
End Sub

Function EditorDoc_BrowseOpen$(hWnd As HWND) As String
    Dim ofn As OPENFILENAME
    Dim fileName[MAX_PATH] As Byte
    Dim filter[127] As Byte

    EditorDoc_BrowseOpen$ = ""
    FillMemory(VarPtr(fileName), MAX_PATH, 0)
    EditorDoc_InitFilter(VarPtr(filter))

    FillMemory(VarPtr(ofn), Len(ofn), 0)
    ofn.lStructSize = Len(ofn)
    ofn.hwndOwner = hWnd
    ofn.lpstrFilter = VarPtr(filter)
    ofn.nFilterIndex = 1
    ofn.lpstrFile = VarPtr(fileName)
    ofn.nMaxFile = MAX_PATH
    ofn.Flags = OFN_FILEMUSTEXIST Or OFN_PATHMUSTEXIST Or OFN_HIDEREADONLY Or OFN_EXPLORER

    If GetOpenFileName(ofn) <> 0 Then
        EditorDoc_BrowseOpen$ = Enc_DupCStr$(VarPtr(fileName), lstrlen(VarPtr(fileName)))
    End If
End Function

Function EditorDoc_BrowseSave$(hWnd As HWND) As String
    Dim ofn As OPENFILENAME
    Dim fileName[MAX_PATH] As Byte
    Dim filter[127] As Byte
    Dim defExt As String
    Dim i As Long
    Dim n As Long
    Dim p As *Byte

    EditorDoc_BrowseSave$ = ""
    FillMemory(VarPtr(fileName), MAX_PATH, 0)
    EditorDoc_InitFilter(VarPtr(filter))
    defExt = "sbp"

    If Len(g_docPath) > 0 Then
        n = Len(g_docPath)
        If n >= MAX_PATH Then n = MAX_PATH - 1
        p = StrPtr(g_docPath)
        For i = 0 To n - 1
            fileName[i] = p[i]
        Next
        fileName[n] = 0
    End If

    FillMemory(VarPtr(ofn), Len(ofn), 0)
    ofn.lStructSize = Len(ofn)
    ofn.hwndOwner = hWnd
    ofn.lpstrFilter = VarPtr(filter)
    ofn.nFilterIndex = 1
    ofn.lpstrFile = VarPtr(fileName)
    ofn.nMaxFile = MAX_PATH
    ofn.Flags = OFN_OVERWRITEPROMPT Or OFN_PATHMUSTEXIST Or OFN_HIDEREADONLY Or OFN_EXPLORER
    ofn.lpstrDefExt = StrPtr(defExt)

    If GetSaveFileName(ofn) <> 0 Then
        EditorDoc_BrowseSave$ = Enc_DupCStr$(VarPtr(fileName), lstrlen(VarPtr(fileName)))
    End If
End Function

Function EditorDoc_SaveAs(hWnd As HWND) As Long
    Dim path As String
    Dim msg As String

    EditorDoc_SaveAs = 0
    path = EditorDoc_BrowseSave$(hWnd)
    If Len(path) = 0 Then Exit Function
    If EditorDoc_WriteTextFile(path, TextBuf_GetConfirmed$()) = 0 Then
        msg = UiText$(UI_SAVE_FAILED)
        UiMsgBox(hWnd, msg, "editor")
        Exit Function
    End If
    g_docPath = path
    EditorDoc_ClearDirty()
    EditorDoc_UpdateTitle(hWnd)
    EditorDoc_SaveAs = 1
End Function

Function EditorDoc_Save(hWnd As HWND) As Long
    Dim msg As String
    EditorDoc_Save = 0
    If Len(g_docPath) = 0 Then
        EditorDoc_Save = EditorDoc_SaveAs(hWnd)
        Exit Function
    End If
    If EditorDoc_WriteTextFile(g_docPath, TextBuf_GetConfirmed$()) = 0 Then
        msg = UiText$(UI_SAVE_FAILED)
        UiMsgBox(hWnd, msg, "editor")
        Exit Function
    End If
    EditorDoc_ClearDirty()
    EditorDoc_UpdateTitle(hWnd)
    EditorDoc_Save = 1
End Function

Sub EditorDoc_OpenPath(hWnd As HWND, path As String)
    Dim text As String
    Dim attr As Long

    If Len(path) = 0 Then Exit Sub
    attr = GetFileAttributes(StrPtr(path))
    If attr = -1 Then Exit Sub
    If (attr And FILE_ATTRIBUTE_DIRECTORY) <> 0 Then Exit Sub

    text = EditorDoc_LoadTextFile$(path)
    g_docPath = path
    TextBuf_SetText(text)
    EditorUndo_Reset()
    VirtualScroll_Init()
    EditorDoc_ClearDirty()
    EditorDoc_UpdateTitle(hWnd)
    InvalidateRect(hWnd, ByVal 0, TRUE)
End Sub

Sub EditorDoc_Open(hWnd As HWND)
    Dim path As String

    path = EditorDoc_BrowseOpen$(hWnd)
    If Len(path) = 0 Then Exit Sub
    EditorDoc_OpenPath(hWnd, path)
End Sub

Sub EditorDoc_DropFiles(hWnd As HWND, ByVal hDrop As HDROP)
    Dim fileName[MAX_PATH - 1] As Byte
    Dim n As Long
    Dim path As String

    FillMemory(VarPtr(fileName), MAX_PATH, 0)
    n = DragQueryFile(hDrop, 0, VarPtr(fileName), MAX_PATH)
    DragFinish(hDrop)
    If n <= 0 Then Exit Sub
    path = Enc_DupCStr$(VarPtr(fileName), n)
    If Len(path) = 0 Then Exit Sub
    MdiOpenPath(path)
End Sub


Function EditorDoc_CmdArg$(ByVal index As Long) As String
    Dim buf[MAX_PATH - 1] As Byte
    EditorDoc_CmdArg$ = ""
    If GetCmd(index, VarPtr(buf)) = 0 Then Exit Function
    EditorDoc_CmdArg$ = Enc_DupCStr$(VarPtr(buf), lstrlen(VarPtr(buf)))
End Function

Function EditorDoc_CmdExists(path As String) As Long
    Dim attr As Long
    EditorDoc_CmdExists = 0
    If Len(path) = 0 Then Exit Function
    attr = GetFileAttributes(StrPtr(path))
    If attr = -1 Then Exit Function
    If (attr And FILE_ATTRIBUTE_DIRECTORY) <> 0 Then Exit Function
    EditorDoc_CmdExists = 1
End Function

Function EditorDoc_ResolveCmd$() As String
    Dim path As String
    path = EditorDoc_CmdArg$(1)
    EditorDoc_ResolveCmd$ = ""
    If EditorDoc_CmdExists(path) <> 0 Then EditorDoc_ResolveCmd$ = path
    If Len(EditorDoc_ResolveCmd$) > 0 Then Exit Function
    path = EditorBuild_ExeDir$() + path
    If EditorDoc_CmdExists(path) <> 0 Then EditorDoc_ResolveCmd$ = path
End Function

Sub EditorDoc_OpenFromCommandLine(hWnd As HWND)
    Dim path As String
    path = EditorDoc_ResolveCmd$()
    If Len(path) = 0 Then Exit Sub
    If ProjIsPj(path) <> 0 Then ProjOpen(path)
    If ProjIsPj(path) <> 0 Then Exit Sub
    EditorDoc_OpenPath(hWnd, path)
End Sub
