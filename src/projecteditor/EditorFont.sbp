Const FR_PRIVATE = &H10
Const EDITOR_FONT_FACE = "UDEV Gothic"
Const EDITOR_FONT_FILE = "fonts\UDEVGothic-Regular.ttf"

Declare Function AddFontResourceExA Lib "gdi32.dll" (ByVal lpszFilename As String, ByVal fl As Long, ByVal pdv As Long) As Long
Declare Function RemoveFontResourceExA Lib "gdi32.dll" (ByVal lpFileName As String, ByVal fl As Long, ByVal pdv As Long) As Long

Dim g_editorFontLoaded As Long
Dim g_editorFontPath As String
Dim g_editorFontMono As HFONT
Dim g_editorFontMonoHeight As Long

Function EditorFont_ResolvePath$() As String
    Dim dir As String
    dir = EditorBuild_ExeDir$()
    EditorFont_ResolvePath$ = EDITOR_FONT_FILE
    If Len(dir) = 0 Then Exit Function
    EditorFont_ResolvePath$ = dir + EDITOR_FONT_FILE
End Function

Sub EditorFont_Init()
    If g_editorFontLoaded <> 0 Then Exit Sub
    g_editorFontPath = EditorFont_ResolvePath$()
    If AddFontResourceExA(g_editorFontPath, FR_PRIVATE, 0) > 0 Then
        g_editorFontLoaded = 1
    End If
End Sub

Sub EditorFont_Shutdown()
    If g_editorFontMono <> 0 Then
        DeleteObject(g_editorFontMono)
        g_editorFontMono = 0
        g_editorFontMonoHeight = 0
    End If
    If g_editorFontLoaded = 0 Then Exit Sub
    RemoveFontResourceExA(g_editorFontPath, FR_PRIVATE, 0)
    g_editorFontLoaded = 0
End Sub

Function EditorFont_Create(ByVal height As Long) As HFONT
    EditorFont_Init()
    If g_editorFontMono <> 0 And g_editorFontMonoHeight = height Then
        EditorFont_Create = g_editorFontMono
        Exit Function
    End If
    If g_editorFontMono <> 0 Then
        DeleteObject(g_editorFontMono)
        g_editorFontMono = 0
    End If
    g_editorFontMonoHeight = height
    If g_editorFontLoaded <> 0 Then
        g_editorFontMono = CreateFont(height,0,0,0,400,0,0,0,1,3,2,1,49,EDITOR_FONT_FACE)
    Else
        g_editorFontMono = CreateFont(height,0,0,0,400,0,0,0,1,3,2,1,49,"Consolas")
    End If
    EditorFont_Create = g_editorFontMono
End Function
