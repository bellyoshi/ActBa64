#ifndef _LINUX
' エディタの等幅フォントは OS の MS Gothic（SHIFTJIS_CHARSET・固定ピッチ）。
' 無い環境では GDI が固定ピッチの別のフォント（Consolas など）を選ぶ
Const EDITOR_FONT_FACE = "MS Gothic"

Dim g_editorFontMono As HFONT
Dim g_editorFontMonoHeight As Long

Sub EditorFont_Shutdown()
    If g_editorFontMono = 0 Then Exit Sub
    DeleteObject(g_editorFontMono)
    g_editorFontMono = 0
    g_editorFontMonoHeight = 0
End Sub

Function EditorFont_Create(ByVal height As Long) As HFONT
    If g_editorFontMono <> 0 And g_editorFontMonoHeight = height Then
        EditorFont_Create = g_editorFontMono
        Exit Function
    End If
    If g_editorFontMono <> 0 Then DeleteObject(g_editorFontMono)
    g_editorFontMonoHeight = height
    g_editorFontMono = CreateFont(height,0,0,0,400,0,0,0,128,3,2,1,49,EDITOR_FONT_FACE)
    EditorFont_Create = g_editorFontMono
End Function
#endif
