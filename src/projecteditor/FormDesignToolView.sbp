' フォームデザイナのツールボックスの画面（RAD 第三段階）。
' デザイン画面の左の帯（幅 FD_TB_W。上のタブの帯の下）に、見出し「Toolbox」と「General」の下へ
' Pointer / Button / Image / Panel を 1 行ずつ（アイコンと名前）並べる。
' ツールを押すと選ばれ（もう一度押すか Pointer か Esc でやめる）、窓のクライアント領域を押すと
' そこへ部品を足して選ぶ（FormDesign_AddCtl$）。足すのは 1 回の編集として元に戻せる。

Const FD_TB_HEAD_H = 20             ' 見出し「Toolbox」の帯の高さ
Const FD_TB_GROUP_H = 20            ' 「General」の行の高さ
Const FD_TB_TOP = DOCTAB_H + FD_TB_HEAD_H + FD_TB_GROUP_H   ' Pointer の行の上端
Const FD_TB_ITEM_H = 22             ' ツール 1 行の高さ
Const FD_KIND_TOOL = 16             ' ツールを選んでいて、押すと部品を足せる所（カーソル）

Dim g_fdTool As Long                ' 選んでいるツール（FD_TOOL_*）。0 は選んでいない（Pointer）

' 行 row（0 は Pointer、1 からツール FD_TOOL_*）の四角
Sub FormDesign_ToolRect(ByVal row As Long, ByRef rc As RECT)
    Dim t As Long
    t = FD_TB_TOP + row * FD_TB_ITEM_H
    FormDesign_Rect(rc, 2, t, FD_TB_W - 3, t + FD_TB_ITEM_H - 1)
End Sub

' 点の上の行（0 は Pointer）。無ければ -1
Function FormDesign_ToolAt(ByVal x As Long, ByVal y As Long) As Long
    Dim i As Long, rc As RECT
    FormDesign_ToolAt = -1
    For i = 0 To FD_TOOL_COUNT
        FormDesign_ToolRect(i, rc)
        If FormDesign_In(x, y, rc.left, rc.top, rc.right - rc.left, rc.bottom - rc.top) <> 0 Then FormDesign_ToolAt = i
    Next
End Function

Function FormDesign_ToolLabel$(ByVal row As Long) As String
    FormDesign_ToolLabel$ = "Pointer"
    If row <> 0 Then FormDesign_ToolLabel$ = FormDesign_ToolName$(row)
End Function

' ---- 描画: アイコン（16 x 16。x, y は左上） ----

Sub FormDesign_IconPointer(hDC As HDC, ByVal x As Long, ByVal y As Long)
    Dim i As Long
    For i = 0 To 9
        FormDesign_Fill(hDC, x + 4, y + 1 + i, x + 5 + (i * 6) \ 9, y + 2 + i, RGB(0, 0, 0))
    Next
    For i = 0 To 4
        FormDesign_Fill(hDC, x + 7 + i \ 2, y + 9 + i, x + 9 + i \ 2, y + 10 + i, RGB(0, 0, 0))
    Next
End Sub

Sub FormDesign_IconButton(hDC As HDC, ByVal x As Long, ByVal y As Long)
    Dim rc As RECT
    FormDesign_Fill(hDC, x + 1, y + 4, x + 15, y + 12, RGB(225, 225, 225))
    FormDesign_Rect(rc, x + 1, y + 4, x + 15, y + 12)
    Ui_Frame(hDC, rc, RGB(112, 112, 112))
    FormDesign_Fill(hDC, x + 4, y + 7, x + 7, y + 9, RGB(64, 64, 64))
    FormDesign_Fill(hDC, x + 9, y + 7, x + 12, y + 9, RGB(64, 64, 64))
End Sub

' 空と丘と日の絵
Sub FormDesign_IconImage(hDC As HDC, ByVal x As Long, ByVal y As Long)
    Dim rc As RECT, i As Long
    FormDesign_Fill(hDC, x + 1, y + 2, x + 15, y + 14, RGB(200, 228, 250))
    For i = 0 To 4
        FormDesign_Fill(hDC, x + 6 - i, y + 9 + i, x + 7 + i, y + 10 + i, RGB(70, 160, 70))
    Next
    FormDesign_Fill(hDC, x + 10, y + 4, x + 13, y + 7, RGB(240, 180, 30))
    FormDesign_Rect(rc, x + 1, y + 2, x + 15, y + 14)
    Ui_Frame(hDC, rc, RGB(90, 110, 140))
End Sub

' 出っ張った板
Sub FormDesign_IconPanel(hDC As HDC, ByVal x As Long, ByVal y As Long)
    Dim rc As RECT
    FormDesign_Fill(hDC, x + 1, y + 2, x + 15, y + 14, RGB(236, 236, 236))
    FormDesign_Rect(rc, x + 1, y + 2, x + 15, y + 14)
    Ui_Frame(hDC, rc, RGB(112, 112, 112))
    FormDesign_Fill(hDC, x + 2, y + 3, x + 14, y + 4, RGB(255, 255, 255))
    FormDesign_Fill(hDC, x + 2, y + 3, x + 3, y + 13, RGB(255, 255, 255))
End Sub

Sub FormDesign_ToolIcon(hDC As HDC, ByVal row As Long, ByVal x As Long, ByVal y As Long)
    If row = 0 Then FormDesign_IconPointer(hDC, x, y)
    If row = FD_TOOL_BUTTON Then FormDesign_IconButton(hDC, x, y)
    If row = FD_TOOL_IMAGE Then FormDesign_IconImage(hDC, x, y)
    If row = FD_TOOL_PANEL Then FormDesign_IconPanel(hDC, x, y)
End Sub

' ---- 描画: 帯 ----

' 1 行。選んでいる行は水色の帯と青い枠
Sub FormDesign_DrawTool(hDC As HDC, ByVal row As Long)
    Dim rc As RECT
    FormDesign_ToolRect(row, rc)
    If row = g_fdTool Then Ui_FillRc(hDC, rc, RGB(204, 232, 255))
    If row = g_fdTool Then Ui_Frame(hDC, rc, RGB(51, 153, 255))
    FormDesign_ToolIcon(hDC, row, rc.left + 4, rc.top + (FD_TB_ITEM_H - 17) \ 2)
    SetTextColor(hDC, RGB(30, 30, 30))
    Enc_TextOutUtf8(hDC, rc.left + 25, rc.top + 4, FormDesign_ToolLabel$(row))
End Sub

' 見出しの帯「Toolbox」
Sub FormDesign_DrawTbHead(hDC As HDC)
    FormDesign_Fill(hDC, 0, DOCTAB_H, FD_TB_W - 1, DOCTAB_H + FD_TB_HEAD_H, RGB(214, 219, 233))
    FormDesign_Fill(hDC, 0, DOCTAB_H + FD_TB_HEAD_H - 1, FD_TB_W - 1, DOCTAB_H + FD_TB_HEAD_H, RGB(204, 206, 219))
    SetTextColor(hDC, RGB(30, 30, 30))
    Enc_TextOutUtf8(hDC, 6, DOCTAB_H + 3, "Toolbox")
End Sub

' 開いた組の見出し（下向きの三角と「General」）
Sub FormDesign_DrawTbGroup(hDC As HDC)
    Dim i As Long, y As Long
    y = DOCTAB_H + FD_TB_HEAD_H
    For i = 0 To 3
        FormDesign_Fill(hDC, 5 + i, y + 8 + i, 12 - i, y + 9 + i, RGB(30, 30, 30))
    Next
    SetTextColor(hDC, RGB(30, 30, 30))
    Enc_TextOutUtf8(hDC, 16, y + 3, "General")
End Sub

Sub FormDesign_DrawToolbox(hDC As HDC, ByRef rc As RECT)
    Dim i As Long
    FormDesign_Fill(hDC, 0, DOCTAB_H, FD_TB_W, rc.bottom, RGB(245, 245, 245))
    FormDesign_Fill(hDC, FD_TB_W - 1, DOCTAB_H, FD_TB_W, rc.bottom, RGB(204, 206, 219))
    FormDesign_DrawTbHead(hDC)
    FormDesign_DrawTbGroup(hDC)
    For i = 0 To FD_TOOL_COUNT
        FormDesign_DrawTool(hDC, i)
    Next
End Sub

' ---- マウス ----

' ツールを選んでいれば、窓のクライアント領域の上で FD_KIND_TOOL。ほかは 0
Function FormDesign_ToolHitAt(ByVal x As Long, ByVal y As Long, ByVal w As Long, ByVal h As Long) As Long
    FormDesign_ToolHitAt = 0
    If g_fdTool = 0 Then Exit Function
    If FormDesign_In(x, y, FormDesign_ClientX(), FormDesign_ClientY(), FD_ORG_X + w - 4 - FormDesign_ClientX(), FD_ORG_Y + h - 4 - FormDesign_ClientY()) <> 0 Then FormDesign_ToolHitAt = FD_KIND_TOOL
End Function

' ツールボックスを押した。押したツールを選ぶ（選んでいたツールか Pointer ならやめる）
Sub FormDesign_ToolClick(ByVal x As Long, ByVal y As Long)
    Dim t As Long
    t = FormDesign_ToolAt(x, y)
    If t < 0 Then Exit Sub
    If t = g_fdTool Then t = 0
    g_fdTool = t
    g_fdSel = ""
End Sub

' 押した所（デザイン画面）に、選んでいるツールの部品を足して選ぶ
Sub FormDesign_ToolPlace(ByVal x As Long, ByVal y As Long)
    Dim t As String, u As String, name As String
    t = TextBuf_GetConfirmed$()
    u = FormDesign_AddCtl$(t, g_fdTool, x - FormDesign_ClientX(), y - FormDesign_ClientY(), name)
    g_fdTool = 0
    If u = t Then Exit Sub
    FormDesign_Replace(u)
    g_fdSel = name
End Sub

' ツールボックスかツールの置き場所を押したなら扱って 1（窓の大きさ w x h）
Function FormDesign_ToolDown(ByVal x As Long, ByVal y As Long, ByVal w As Long, ByVal h As Long) As Long
    FormDesign_ToolDown = 1
    If x < FD_TB_W Then
        FormDesign_ToolClick(x, y)
        Exit Function
    End If
    If FormDesign_ToolHitAt(x, y, w, h) <> 0 Then
        FormDesign_ToolPlace(x, y)
        Exit Function
    End If
    FormDesign_ToolDown = 0
    g_fdTool = 0
End Function

' 左下の文字（ツールを選んでいるとき）
Function FormDesign_ToolInfo$() As String
    FormDesign_ToolInfo$ = FormDesign_ToolName$(g_fdTool) & ": click the form to place (Esc: cancel)"
End Function
