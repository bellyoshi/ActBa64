' AB4 デザイナーの窓のプロパティの値（Win32 を使わないので unittest でも読む）。
' WINDOW: の中の「キー = 値」の行の書き換え・足し・消し、WINDOW: の名前、FONT の値、窓の様式の行の表。

' キーを 10 桁に（.wnd の書き方「    SIZE      = ...」）
Function Ab4D_KeyPad$(key As String) As String
    Ab4D_KeyPad$ = key
    While Len(Ab4D_KeyPad$) < 10
        Ab4D_KeyPad$ = Ab4D_KeyPad$ & " "
    Wend
End Function

' 窓 win の key の値を v にした本文。行が無ければ WINDOW: の次の行に足す。窓が無ければそのまま
Function Ab4D_WinSet$(text As String, ByVal win As Long, key As String, v As String) As String
    Dim pos As Long, e As Long
    pos = Ab4D_FindLine(text, win, 4, key)
    If pos > 0 Then Ab4D_WinSet$ = Ab4D_ReplaceVal$(text, pos, v) : Exit Function
    Ab4D_WinSet$ = text
    pos = Ab4D_FindLine(text, win, 0, "")
    If pos = 0 Then Exit Function
    e = FormDesign_LineEnd(text, pos)
    Ab4D_WinSet$ = Left$(text, e) & "    " & Ab4D_KeyPad$(key) & "= " & v & FormDesign_Nl$(text) & Mid$(text, e + 1)
End Function

' 窓 win の key の行を消した本文
Function Ab4D_WinDel$(text As String, ByVal win As Long, key As String) As String
    Dim pos As Long
    Ab4D_WinDel$ = text
    pos = Ab4D_FindLine(text, win, 4, key)
    If pos = 0 Then Exit Function
    Ab4D_WinDel$ = Left$(text, pos - 1) & Mid$(text, FormDesign_LineEnd(text, pos) + 1)
End Function

' WINDOW: の名前を変えた本文（行末の CR は残す）
Function Ab4D_WinRename$(text As String, ByVal win As Long, name As String) As String
    Dim pos As Long, e As Long
    Ab4D_WinRename$ = text
    pos = Ab4D_FindLine(text, win, 0, "")
    If pos = 0 Then Exit Function
    e = FormDesign_LineEnd(text, pos)
    If e > pos Then If Mid$(text, e - 1, 1) = Chr$(13) Then e = e - 1
    Ab4D_WinRename$ = Left$(text, pos - 1) & "WINDOW:" & name & Mid$(text, e)
End Function

' ---- FONT = 高さ,幅,…,"名前" ----

Function Ab4D_FontFace$(v As String) As String
    Dim a As Long, b As Long
    Ab4D_FontFace$ = ""
    a = InStr(1, v, Chr$(34))
    If a = 0 Then Exit Function
    b = InStr(a + 1, v, Chr$(34))
    If b > a Then Ab4D_FontFace$ = Mid$(v, a + 1, b - a - 1)
End Function

Function Ab4D_FontH(v As String) As Long
    Ab4D_FontH = Val(Ab4D_Nth$(v, ",", 1))
End Function

' 高さ h と名前 face にした FONT の値（間の欄はそのまま）
Function Ab4D_FontVal$(v As String, ByVal h As Long, face As String) As String
    Dim c As Long, a As Long
    Ab4D_FontVal$ = v
    c = InStr(1, v, ",") : a = InStr(1, v, Chr$(34))
    If c = 0 Or a < c Then Exit Function
    Ab4D_FontVal$ = FormDesign_Num$(h) & Mid$(v, c, a - c) & Chr$(34) & Ab4D_NoQuote$(face) & Chr$(34)
End Function

' ---- 窓の様式の行 ----

Function Ab4D_WinRows$() As String
    Dim s As String
    s = "O;&HC0000000;ウィンドウの種類;Kind;0:オーバーラップ:Overlapped/&H80000000:ポップアップ:Popup/&H40000000:子:Child"
    s = s & "|C;&H00C00000;タイトル バー;Title bar|O;&H00040000;サイズ変更枠;Sizing border;&H40000:あり:Yes/0:なし:No"
    s = s & "|C;&H00080000;システム メニュー;System menu|C;&H00020000;最小化ボタン;Minimize box|C;&H00010000;最大化ボタン;Maximize box"
    s = s & "|C;&H20000000;最小化;Minimized|C;&H01000000;最大化;Maximized"
    s = s & "|C;&H00100000;水平スクロールバー;H scroll bar|C;&H00200000;垂直スクロールバー;V scroll bar|C;&H08000000;無効;Disabled"
    Ab4D_WinRows$ = s & "|C;&H04000000;兄弟ウィンドウをクリップ;Clip siblings|C;&H02000000;子ウィンドウをクリップ;Clip children|C;&H10000000;可視;Visible"
End Function

Function Ab4D_WinExRows$() As String
    Dim s As String
    s = "C;&H00000008;最前面;Topmost|C;&H00000080;ツール ウィンドウ;Tool window|C;&H00000200;くぼんだ枠;Client edge"
    s = s & "|C;&H00000100;浮き出た枠;Window edge|C;&H00000001;ダイアログの枠;Dialog frame"
    Ab4D_WinExRows$ = s & "|C;&H00000010;ファイルのドロップを受ける;Accept files|C;&H00040000;タスク バーに出す;App window|C;&H00010000;Tab で子に移る;Control parent"
End Function
