' Language pack loader.
' setting.ini (next to exe): Language=ja (omit file / blank / en = English built-in)
' ProjectEditor_lang_<code>.csv: UTF-8 lines "id,text" (# comments / blank skipped)
' Pack bytes live in a BSS buffer (not String/malloc) so String GC cannot touch them.

Const UI_MB_YESNO = &H4
Const UI_MB_ICONQUESTION = &H20
Const UI_IDYES = 6
Const UI_PACK_MAX = 4095

Dim g_uiPackBuf(4095) As Byte
Dim g_uiPackLen As Long

Sub UiLang_ClearOverrides()
    g_uiPackLen = 0
End Sub

Function UiLang_ConfigPath$() As String
    Dim dir As String
    dir = EditorBuild_ExeDir$()
    If Len(dir) = 0 Then
        UiLang_ConfigPath$ = "setting.ini"
    Else
        UiLang_ConfigPath$ = dir + "setting.ini"
    End If
End Function

Function UiLang_PackPath$(code As String) As String
    Dim dir As String
    dir = EditorBuild_ExeDir$()
    If Len(dir) = 0 Then
        UiLang_PackPath$ = "ProjectEditor_lang_" + code + ".csv"
    Else
        UiLang_PackPath$ = dir + "ProjectEditor_lang_" + code + ".csv"
    End If
End Function

Function UiLang_ReadBytes$(p As *Byte, n As Long) As String
    Dim encoding As Long
    encoding = Enc_Detect(p, n)
    UiLang_ReadBytes$ = Enc_BytesToUtf8$(p, n, encoding)
End Function

Function UiLang_ReadFile$(path As String) As String
    Dim n As Long
    Dim p As *Byte
    UiLang_ReadFile$ = ""
    p = LoadFile(StrPtr(path), n)
    If p = 0 Then Exit Function
    UiLang_ReadFile$ = UiLang_ReadBytes$(p, n)
    free(p)
End Function

Function UiLang_TrimCode$(s As String) As String
    Dim p As *Byte
    Dim n As Long
    Dim lo As Long
    Dim hi As Long
    Dim a As Long

    UiLang_TrimCode$ = ""
    n = Len(s)
    If n <= 0 Then Exit Function
    p = StrPtr(s)
    If p = 0 Then Exit Function
    lo = 0
    hi = n
    While lo < hi
        a = p[lo] And &HFF
        If a <> 32 And a <> 9 And a <> 13 And a <> 10 Then Exit While
        lo = lo + 1
    Wend
    While hi > lo
        a = p[hi - 1] And &HFF
        If a <> 32 And a <> 9 And a <> 13 And a <> 10 Then Exit While
        hi = hi - 1
    Wend
    If hi <= lo Then Exit Function
    UiLang_TrimCode$ = Enc_DupCStr$(VarPtr(p[lo]), hi - lo)
End Function

Function UiLang_IsCommentOrSection(line As String) As Long
    Dim p As *Byte
    Dim a As Long

    UiLang_IsCommentOrSection = 0
    If Len(line) = 0 Then Exit Function
    p = StrPtr(line)
    If p = 0 Then Exit Function
    a = p[0] And &HFF
    If a = 35 Then
        UiLang_IsCommentOrSection = 1
    ElseIf a = 59 Then
        UiLang_IsCommentOrSection = 1
    ElseIf a = 91 Then
        UiLang_IsCommentOrSection = 1
    End If
End Function

Function UiLang_IsValidCode(code As String) As Long
    Dim p As *Byte
    Dim i As Long
    Dim n As Long
    Dim a As Long
    Dim ok As Long

    UiLang_IsValidCode = 0
    n = Len(code)
    If n < 1 Then Exit Function
    If n > 16 Then Exit Function
    p = StrPtr(code)
    If p = 0 Then Exit Function
    For i = 0 To n - 1
        a = p[i] And &HFF
        ok = 0
        If a >= 65 Then
            If a <= 90 Then ok = 1
        End If
        If a >= 97 Then
            If a <= 122 Then ok = 1
        End If
        If a >= 48 Then
            If a <= 57 Then
                If i > 0 Then ok = 1
            End If
        End If
        If a = 95 Then
            If i > 0 Then ok = 1
        End If
        If ok = 0 Then Exit Function
    Next
    UiLang_IsValidCode = 1
End Function

Function UiLang_MatchLanguageKey(ByVal p As *Byte, ByVal lineStart As Long, ByVal lineEnd As Long) As Long
    Dim i As Long
    Dim a As Long
    Dim key As String
    Dim kp As *Byte

    UiLang_MatchLanguageKey = 0
    If lineEnd - lineStart < 10 Then Exit Function
    key = "language"
    kp = StrPtr(key)
    If kp = 0 Then Exit Function
    For i = 0 To 7
        a = p[lineStart + i] And &HFF
        If a >= 65 And a <= 90 Then a = a + 32
        If a <> (kp[i] And &HFF) Then Exit Function
    Next
    If (p[lineStart + 8] And &HFF) <> 61 Then Exit Function
    UiLang_MatchLanguageKey = 1
End Function

Function UiLang_CodeCharOk(ByVal a As Long, ByVal i As Long) As Long
    UiLang_CodeCharOk = 0
    If a >= 65 And a <= 90 Then UiLang_CodeCharOk = 1
    If a >= 97 And a <= 122 Then UiLang_CodeCharOk = 1
    If i <= 0 Then Exit Function
    If a >= 48 And a <= 57 Then UiLang_CodeCharOk = 1
    If a = 95 Then UiLang_CodeCharOk = 1
End Function

Sub UiLang_PutByte(p As *Byte, ByVal i As Long, ByVal a As Long)
    memcpy(VarPtr(p[i]), VarPtr(a), 1)
End Sub

Function UiLang_FillCode(p As *Byte, ByVal off As Long, ByVal ln As Long, dst As *Byte) As Long
    Dim i As Long, a As Long
    UiLang_FillCode = 0
    For i = 0 To ln - 1
        a = p[off + i] And &HFF
        If UiLang_CodeCharOk(a, i) = 0 Then Exit Function
        UiLang_PutByte(dst, i, a)
    Next
    UiLang_FillCode = 1
End Function

Function UiLang_CodeFromBytes$(ByVal p As *Byte, ByVal off As Long, ByVal ln As Long) As String
    Dim buf(16) As Byte
    UiLang_CodeFromBytes$ = ""
    If p = 0 Or ln < 1 Or ln > 16 Then Exit Function
    If UiLang_FillCode(p, off, ln, VarPtr(buf[0])) = 0 Then Exit Function
    buf[ln] = 0
    UiLang_CodeFromBytes$ = Enc_DupCStr$(VarPtr(buf[0]), ln)
End Function

Function UiLang_ReadCode$() As String
    Dim raw As String
    Dim p As *Byte
    Dim n As Long
    Dim i As Long
    Dim lineStart As Long
    Dim lineEnd As Long
    Dim a As Long
    Dim codeOff As Long
    Dim codeLen As Long
    Dim code As String

    UiLang_ReadCode$ = ""
    raw = UiLang_ReadFile$(UiLang_ConfigPath$())
    n = Len(raw)
    If n = 0 Then Exit Function
    p = StrPtr(raw)
    If p = 0 Then Exit Function
    lineStart = 0
    i = 0
    While i <= n
        If i = n Then
            a = 10
        Else
            a = p[i] And &HFF
        End If
        If a = 10 Then
            lineEnd = i
            If lineEnd > lineStart Then
                If (p[lineEnd - 1] And &HFF) = 13 Then lineEnd = lineEnd - 1
            End If
            If lineEnd > lineStart Then
                a = p[lineStart] And &HFF
                If a <> 35 And a <> 59 And a <> 91 Then
                    If UiLang_MatchLanguageKey(p, lineStart, lineEnd) <> 0 Then
                        codeOff = lineStart + 9
                        While codeOff < lineEnd
                            a = p[codeOff] And &HFF
                            If a <> 32 And a <> 9 Then Exit While
                            codeOff = codeOff + 1
                        Wend
                        codeLen = lineEnd - codeOff
                        While codeLen > 0
                            a = p[codeOff + codeLen - 1] And &HFF
                            If a <> 32 And a <> 9 Then Exit While
                            codeLen = codeLen - 1
                        Wend
                        code = UiLang_CodeFromBytes$(p, codeOff, codeLen)
                        If Len(code) > 0 Then
                            If Len(raw) = n Then UiLang_ReadCode$ = code
                            Exit Function
                        End If
                    End If
                End If
            End If
            lineStart = i + 1
        End If
        i = i + 1
    Wend
End Function

Function UiLang_Slice$(ByVal off As Long, ByVal ln As Long) As String
    Dim tmp As *Byte

    UiLang_Slice$ = ""
    If ln <= 0 Then Exit Function
    If off < 0 Then Exit Function
    If off + ln > g_uiPackLen Then Exit Function
    tmp = malloc(ln + 1)
    If tmp = 0 Then Exit Function
    memcpy(tmp, VarPtr(g_uiPackBuf[off]), ln)
    tmp[ln] = 0
    UiLang_Slice$ = Enc_DupCStr$(tmp, ln)
    free(tmp)
End Function

Function UiLang_UnquoteBytes$(ByVal off As Long, ByVal ln As Long) As String
    Dim a0 As Long
    Dim a1 As Long

    UiLang_UnquoteBytes$ = ""
    If ln <= 0 Then Exit Function
    If off < 0 Then Exit Function
    If off + ln > g_uiPackLen Then Exit Function
    If ln >= 2 Then
        a0 = g_uiPackBuf[off] And &HFF
        a1 = g_uiPackBuf[off + ln - 1] And &HFF
        If a0 = 34 And a1 = 34 Then
            UiLang_UnquoteBytes$ = UiLang_Slice$(off + 1, ln - 2)
            Exit Function
        End If
    End If
    UiLang_UnquoteBytes$ = UiLang_Slice$(off, ln)
End Function

Function UiLang_Lookup$(ByVal id As Long) As String
    Dim i As Long
    Dim lineStart As Long
    Dim lineEnd As Long
    Dim comma As Long
    Dim num As Long
    Dim a As Long
    Dim pos As Long
    Dim digit As Long

    UiLang_Lookup$ = ""
    If g_uiPackLen <= 0 Then Exit Function
    lineStart = 0
    i = 0
    While i <= g_uiPackLen
        If i = g_uiPackLen Then
            a = 10
        Else
            a = g_uiPackBuf[i] And &HFF
        End If
        If a = 10 Then
            lineEnd = i
            If lineEnd > lineStart Then
                If (g_uiPackBuf[lineEnd - 1] And &HFF) = 13 Then lineEnd = lineEnd - 1
            End If
            If lineEnd > lineStart Then
                a = g_uiPackBuf[lineStart] And &HFF
                If a >= 48 And a <= 57 Then
                    comma = -1
                    num = 0
                    digit = 0
                    For pos = lineStart To lineEnd - 1
                        a = g_uiPackBuf[pos] And &HFF
                        If a = 44 Then
                            comma = pos
                            Exit For
                        End If
                        If a >= 48 And a <= 57 Then
                            num = num * 10 + (a - 48)
                            digit = 1
                        Else
                            digit = 0
                            Exit For
                        End If
                    Next
                    If digit <> 0 And comma > lineStart Then
                        If num = id Then
                            If comma + 1 < lineEnd Then
                                UiLang_Lookup$ = UiLang_UnquoteBytes$(comma + 1, lineEnd - comma - 1)
                            End If
                            Exit Function
                        End If
                    End If
                End If
            End If
            lineStart = i + 1
        End If
        i = i + 1
    Wend
End Function

Sub UiLang_LoadPack(code As String)
    Dim path As String
    Dim raw As String
    Dim n As Long
    Dim src As *Byte

    If Len(code) = 0 Then Exit Sub
    If code = "en" Then Exit Sub
    path = UiLang_PackPath$(code)
    raw = UiLang_ReadFile$(path)
    n = Len(raw)
    If n <= 0 Then Exit Sub
    If n > UI_PACK_MAX Then n = UI_PACK_MAX
    src = StrPtr(raw)
    If src = 0 Then Exit Sub
    memcpy(VarPtr(g_uiPackBuf[0]), src, n)
    g_uiPackBuf[n] = 0
    If Len(raw) < n Then
        g_uiPackLen = 0
        Exit Sub
    End If
    g_uiPackLen = n
End Sub

Sub UiLang_Init()
    Dim code As String
    UiLang_ClearOverrides()
    g_uiLangCode = "en"
    code = UiLang_ReadCode$()
    If Len(code) = 0 Then Exit Sub
    g_uiLangCode = code
    UiLang_LoadPack(code)
End Sub

Function UiLang_ConfigText$(code As String) As String
    Dim t As String
    t = UiLang_TrimCode$(code)
    If UiLang_IsValidCode(t) = 0 Then t = "en"
    UiLang_ConfigText$ = "# ProjectEditor settings (UTF-8)" + Chr$(13) + Chr$(10)
    UiLang_ConfigText$ = UiLang_ConfigText$ + "# Omit Language or use en for built-in English UI." + Chr$(13) + Chr$(10)
    UiLang_ConfigText$ = UiLang_ConfigText$ + "# Example: ja loads ProjectEditor_lang_ja.csv next to the exe." + Chr$(13) + Chr$(10)
    UiLang_ConfigText$ = UiLang_ConfigText$ + "Language=" + t + Chr$(13) + Chr$(10)
End Function

Function UiLang_WriteCode(code As String) As Long
    Dim path As String
    Dim text As String
    path = UiLang_ConfigPath$()
    text = UiLang_ConfigText$(code)
    UiLang_WriteCode = WriteAll(StrPtr(path), StrPtr(text), Len(text))
End Function

Function UiText$(ByVal id As Long) As String
    Dim o As String
    o = UiLang_Lookup$(id)
    If Len(o) > 0 Then
        UiText$ = o
    Else
        UiText$ = UiTextDefault$(id)
    End If
End Function

Sub UiMsgBox(hWnd As HWND, msg As String, title As String)
    Dim wMsg As *Byte
    Dim wTitle As *Byte
    Dim nMsg As Long
    Dim nTitle As Long

    wMsg = Enc_Utf8ToWide(msg, nMsg)
    wTitle = Enc_Utf8ToWide(title, nTitle)
    If wMsg = 0 Or wTitle = 0 Then
        If wMsg <> 0 Then free(wMsg)
        If wTitle <> 0 Then free(wTitle)
        MessageBox(hWnd, msg, title, MB_OK)
        Exit Sub
    End If
    MessageBoxW(hWnd, wMsg, wTitle, MB_OK)
    free(wMsg)
    free(wTitle)
End Sub

Function UiMsgBoxYesNo(hWnd As HWND, msg As String, title As String) As Long
    Dim wMsg As *Byte
    Dim wTitle As *Byte
    Dim nMsg As Long
    Dim nTitle As Long
    Dim r As Long

    UiMsgBoxYesNo = 0
    wMsg = Enc_Utf8ToWide(msg, nMsg)
    wTitle = Enc_Utf8ToWide(title, nTitle)
    If wMsg = 0 Or wTitle = 0 Then
        If wMsg <> 0 Then free(wMsg)
        If wTitle <> 0 Then free(wTitle)
        r = MessageBox(hWnd, msg, title, UI_MB_YESNO Or UI_MB_ICONQUESTION)
        If r = UI_IDYES Then UiMsgBoxYesNo = 1
        Exit Function
    End If
    r = MessageBoxW(hWnd, wMsg, wTitle, UI_MB_YESNO Or UI_MB_ICONQUESTION)
    free(wMsg)
    free(wTitle)
    If r = UI_IDYES Then UiMsgBoxYesNo = 1
End Function
