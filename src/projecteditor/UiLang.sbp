' Language pack loader.
' setting.ini (next to exe): Language=ja (omit file / blank / en = English built-in)
' ProjectEditor_lang_<code>.csv: UTF-8 lines "id,text" (# comments / blank skipped)
' Pack bytes live in a BSS buffer (not String/malloc) so String GC cannot touch them.

Const UI_MB_YESNO = &H4
Const UI_MB_ICONQUESTION = &H20
Const UI_IDYES = 6
Const UI_PACK_MAX = 4095

Dim g_uiPackBuf(4095) As Byte
Dim g_uiPackLen As Long
Dim g_uiParseId As Long

Sub UiLang_ClearOverrides()
    g_uiPackLen = 0
End Sub

Function UiLang_ConfigPath$() As String
    Dim dir As String
    dir = EditorBuild_ExeDir$()
    If Len(dir) = 0 Then
        UiLang_ConfigPath$ = "setting.ini"
    Else
        UiLang_ConfigPath$ = dir + "setting.ini"
    End If
End Function

Function UiLang_PackPath$(code As String) As String
    Dim dir As String
    dir = EditorBuild_ExeDir$()
    If Len(dir) = 0 Then
        UiLang_PackPath$ = "ProjectEditor_lang_" + code + ".csv"
    Else
        UiLang_PackPath$ = dir + "ProjectEditor_lang_" + code + ".csv"
    End If
End Function

Function UiLang_ReadFile$(path As String) As String
    Dim hFile As HANDLE
    Dim fsiz As Long
    Dim nRead As DWord
    Dim p As *Byte
    Dim encoding As Long

    UiLang_ReadFile$ = ""
    hFile = CreateFile(StrPtr(path), GENERIC_READ, FILE_SHARE_READ, ByVal NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL)
    If hFile = INVALID_HANDLE_VALUE Then Exit Function
    fsiz = GetFileSize(hFile, NULL)
    If fsiz < 0 Then
        CloseHandle(hFile)
        Exit Function
    End If
    p = malloc(fsiz + 1)
    If p = 0 Then
        CloseHandle(hFile)
        Exit Function
    End If
    nRead = 0
    If fsiz > 0 Then ReadFile(hFile, p, fsiz, VarPtr(nRead), ByVal NULL)
    CloseHandle(hFile)
    p[nRead] = 0
    encoding = Enc_Detect(p, nRead)
    UiLang_ReadFile$ = Enc_BytesToUtf8$(p, nRead, encoding)
    free(p)
End Function

Function UiLang_TrimCode$(s As String) As String
    Dim t As String
    Dim c As String
    t = s
    While Len(t) > 0
        c = Left$(t, 1)
        If c <> " " And c <> Chr$(9) And c <> Chr$(13) And c <> Chr$(10) Then Exit While
        t = Mid$(t, 2)
    Wend
    While Len(t) > 0
        c = Right$(t, 1)
        If c <> " " And c <> Chr$(9) And c <> Chr$(13) And c <> Chr$(10) Then Exit While
        t = Left$(t, Len(t) - 1)
    Wend
    UiLang_TrimCode$ = t
End Function

Function UiLang_IsCommentOrSection(line As String) As Long
    Dim a As Long

    UiLang_IsCommentOrSection = 0
    If Len(line) = 0 Then Exit Function
    a = Asc(Left$(line, 1))
    If a = 35 Then
        UiLang_IsCommentOrSection = 1
    ElseIf a = 59 Then
        UiLang_IsCommentOrSection = 1
    ElseIf a = 91 Then
        UiLang_IsCommentOrSection = 1
    End If
End Function

Function UiLang_IsValidCode(code As String) As Long
    Dim i As Long
    Dim n As Long
    Dim a As Long
    Dim ok As Long

    UiLang_IsValidCode = 0
    n = Len(code)
    If n < 1 Then Exit Function
    If n > 16 Then Exit Function
    For i = 1 To n
        a = Asc(Mid$(code, i, 1))
        ok = 0
        If a >= 65 Then
            If a <= 90 Then ok = 1
        End If
        If a >= 97 Then
            If a <= 122 Then ok = 1
        End If
        If a >= 48 Then
            If a <= 57 Then
                If i > 1 Then ok = 1
            End If
        End If
        If a = 95 Then
            If i > 1 Then ok = 1
        End If
        If ok = 0 Then Exit Function
    Next
    UiLang_IsValidCode = 1
End Function

Function UiLang_IsLanguageKey(line As String) As Long
    Dim kw As String
    Dim i As Long
    Dim a As Long
    Dim b As Long
    Dim key As String

    UiLang_IsLanguageKey = 0
    If Len(line) < 9 Then Exit Function
    key = "language"
    kw = Left$(line, 8)
    For i = 1 To 8
        a = Asc(Mid$(kw, i, 1))
        b = Asc(Mid$(key, i, 1))
        If a >= 65 And a <= 90 Then a = a + 32
        If a <> b Then Exit Function
    Next
    If Mid$(line, 9, 1) <> "=" Then Exit Function
    UiLang_IsLanguageKey = 1
End Function

Function UiLang_CodeFromIniLine$(line As String) As String
    Dim t As String
    Dim code As String

    UiLang_CodeFromIniLine$ = ""
    t = UiLang_TrimCode$(line)
    If Len(t) = 0 Then Exit Function
    If UiLang_IsCommentOrSection(t) <> 0 Then Exit Function
    If UiLang_IsLanguageKey(t) = 0 Then Exit Function
    code = UiLang_TrimCode$(Mid$(t, 10))
    If UiLang_IsValidCode(code) = 0 Then Exit Function
    UiLang_CodeFromIniLine$ = Mid$(code, 1, Len(code))
End Function

Function UiLang_ReadCode$() As String
    Dim raw As String
    Dim line As String
    Dim code As String
    Dim start As Long
    Dim nl As Long
    Dim n As Long

    UiLang_ReadCode$ = ""
    raw = UiLang_ReadFile$(UiLang_ConfigPath$())
    n = Len(raw)
    If n = 0 Then Exit Function
    start = 1
    While start <= n
        nl = InStr(start, raw, Chr$(10))
        If nl = 0 Then
            line = Mid$(raw, start, n - start + 1)
            start = n + 1
        Else
            line = Mid$(raw, start, nl - start)
            start = nl + 1
        End If
        If Len(line) > 0 Then
            If Asc(Right$(line, 1)) = 13 Then line = Left$(line, Len(line) - 1)
        End If
        code = UiLang_CodeFromIniLine$(line)
        If Len(code) > 0 Then
            UiLang_ReadCode$ = code
            Exit Function
        End If
    Wend
End Function

Function UiLang_Unquote$(s As String) As String
    Dim t As String
    Dim n As Long
    t = s
    n = Len(t)
    If n >= 2 Then
        If Left$(t, 1) = Chr$(34) And Right$(t, 1) = Chr$(34) Then
            t = Mid$(t, 2, n - 2)
        End If
    End If
    UiLang_Unquote$ = t
End Function

Function UiLang_ParseCsvLine$(line As String) As String
    Dim t As String
    Dim comma As Long
    Dim i As Long
    Dim n As Long

    UiLang_ParseCsvLine$ = ""
    g_uiParseId = -1
    t = UiLang_TrimCode$(line)
    If Len(t) = 0 Then Exit Function
    If UiLang_IsCommentOrSection(t) <> 0 Then Exit Function
    If Left$(t, 2) = "id" Then Exit Function
    n = Len(t)
    comma = 0
    For i = 1 To n
        If Mid$(t, i, 1) = "," Then
            comma = i
            Exit For
        End If
    Next
    If comma <= 1 Then Exit Function
    g_uiParseId = Val(Left$(t, comma - 1))
    UiLang_ParseCsvLine$ = UiLang_Unquote$(Mid$(t, comma + 1))
End Function

Function UiLang_Slice$(ByVal off As Long, ByVal ln As Long) As String
    Dim tmp As *Byte

    UiLang_Slice$ = ""
    If ln <= 0 Then Exit Function
    If off < 0 Then Exit Function
    If off + ln > g_uiPackLen Then Exit Function
    tmp = malloc(ln + 1)
    If tmp = 0 Then Exit Function
    memcpy(tmp, VarPtr(g_uiPackBuf[off]), ln)
    tmp[ln] = 0
    UiLang_Slice$ = Enc_DupCStr$(tmp, ln)
    free(tmp)
End Function

Function UiLang_Lookup$(ByVal id As Long) As String
    Dim i As Long
    Dim lineStart As Long
    Dim lineLen As Long
    Dim line As String
    Dim text As String
    Dim c As Long

    UiLang_Lookup$ = ""
    If g_uiPackLen <= 0 Then Exit Function
    lineStart = 0
    i = 0
    While i < g_uiPackLen
        c = g_uiPackBuf[i] And &HFF
        If c = 10 Then
            lineLen = i - lineStart
            If lineLen > 0 Then
                c = g_uiPackBuf[i - 1] And &HFF
                If c = 13 Then lineLen = lineLen - 1
            End If
            line = UiLang_Slice$(lineStart, lineLen)
            text = UiLang_ParseCsvLine$(line)
            If g_uiParseId = id Then
                If Len(text) > 0 Then UiLang_Lookup$ = text
                Exit Function
            End If
            lineStart = i + 1
        End If
        i = i + 1
    Wend
    If lineStart < g_uiPackLen Then
        lineLen = g_uiPackLen - lineStart
        If lineLen > 0 Then
            c = g_uiPackBuf[g_uiPackLen - 1] And &HFF
            If c = 13 Then lineLen = lineLen - 1
        End If
        line = UiLang_Slice$(lineStart, lineLen)
        text = UiLang_ParseCsvLine$(line)
        If g_uiParseId = id Then
            If Len(text) > 0 Then UiLang_Lookup$ = text
        End If
    End If
End Function

Sub UiLang_LoadPack(code As String)
    Dim path As String
    Dim raw As String
    Dim n As Long
    Dim src As *Byte

    If Len(code) = 0 Then Exit Sub
    If code = "en" Then Exit Sub
    path = UiLang_PackPath$(code)
    raw = UiLang_ReadFile$(path)
    n = Len(raw)
    If n <= 0 Then Exit Sub
    If n > UI_PACK_MAX Then n = UI_PACK_MAX
    src = StrPtr(raw)
    If src = 0 Then Exit Sub
    memcpy(VarPtr(g_uiPackBuf[0]), src, n)
    g_uiPackBuf[n] = 0
    If Len(raw) < n Then
        g_uiPackLen = 0
        Exit Sub
    End If
    g_uiPackLen = n
End Sub

Sub UiLang_Init()
    Dim code As String
    UiLang_ClearOverrides()
    g_uiLangCode = "en"
    code = UiLang_ReadCode$()
    If Len(code) = 0 Then Exit Sub
    g_uiLangCode = code
    UiLang_LoadPack(code)
End Sub

Function UiLang_WriteCode(code As String) As Long
    Dim path As String
    Dim text As String
    Dim hFile As HANDLE
    Dim nWritten As DWord
    Dim n As Long
    Dim t As String

    UiLang_WriteCode = 0
    t = UiLang_TrimCode$(code)
    If UiLang_IsValidCode(t) = 0 Then t = "en"
    path = UiLang_ConfigPath$()
    text = "# ProjectEditor settings (UTF-8)" + Chr$(13) + Chr$(10)
    text = text + "# Omit Language or use en for built-in English UI." + Chr$(13) + Chr$(10)
    text = text + "# Example: ja loads ProjectEditor_lang_ja.csv next to the exe." + Chr$(13) + Chr$(10)
    text = text + "Language=" + t + Chr$(13) + Chr$(10)
    n = Len(text)
    hFile = CreateFile(StrPtr(path), GENERIC_WRITE, 0, ByVal NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL)
    If hFile = INVALID_HANDLE_VALUE Then Exit Function
    nWritten = 0
    If n > 0 Then WriteFile(hFile, StrPtr(text), n, VarPtr(nWritten), ByVal NULL)
    CloseHandle(hFile)
    If nWritten = n Then UiLang_WriteCode = 1
End Function

Function UiText$(ByVal id As Long) As String
    Dim o As String
    o = UiLang_Lookup$(id)
    If Len(o) > 0 Then
        UiText$ = o
    Else
        UiText$ = UiTextDefault$(id)
    End If
End Function

Sub UiMsgBox(hWnd As HWND, msg As String, title As String)
    Dim wMsg As *Byte
    Dim wTitle As *Byte
    Dim nMsg As Long
    Dim nTitle As Long

    wMsg = Enc_Utf8ToWide(msg, nMsg)
    wTitle = Enc_Utf8ToWide(title, nTitle)
    If wMsg = 0 Or wTitle = 0 Then
        If wMsg <> 0 Then free(wMsg)
        If wTitle <> 0 Then free(wTitle)
        MessageBox(hWnd, msg, title, MB_OK)
        Exit Sub
    End If
    MessageBoxW(hWnd, wMsg, wTitle, MB_OK)
    free(wMsg)
    free(wTitle)
End Sub

Function UiMsgBoxYesNo(hWnd As HWND, msg As String, title As String) As Long
    Dim wMsg As *Byte
    Dim wTitle As *Byte
    Dim nMsg As Long
    Dim nTitle As Long
    Dim r As Long

    UiMsgBoxYesNo = 0
    wMsg = Enc_Utf8ToWide(msg, nMsg)
    wTitle = Enc_Utf8ToWide(title, nTitle)
    If wMsg = 0 Or wTitle = 0 Then
        If wMsg <> 0 Then free(wMsg)
        If wTitle <> 0 Then free(wTitle)
        r = MessageBox(hWnd, msg, title, UI_MB_YESNO Or UI_MB_ICONQUESTION)
        If r = UI_IDYES Then UiMsgBoxYesNo = 1
        Exit Function
    End If
    r = MessageBoxW(hWnd, wMsg, wTitle, UI_MB_YESNO Or UI_MB_ICONQUESTION)
    free(wMsg)
    free(wTitle)
    If r = UI_IDYES Then UiMsgBoxYesNo = 1
End Function
