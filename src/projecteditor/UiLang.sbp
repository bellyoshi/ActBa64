' Language pack loader.
' setting.ini (next to exe): Language=ja (omit file / blank / en = English built-in)
' ProjectEditor_lang_<code>.csv: UTF-8 lines "id,text" (# comments / blank skipped)
' Overrides are kept as the raw CSV text (no String arrays — host-safe).

Const UI_MB_YESNO = &H4
Const UI_MB_ICONQUESTION = &H20
Const UI_IDYES = 6

Dim g_uiCsv As String

Sub UiLang_ClearOverrides()
    g_uiCsv = ""
End Sub

Function UiLang_ConfigPath$() As String
    Dim dir As String
    dir = EditorBuild_ExeDir$()
    If Len(dir) = 0 Then
        UiLang_ConfigPath$ = "setting.ini"
    Else
        UiLang_ConfigPath$ = dir + "setting.ini"
    End If
End Function

Function UiLang_PackPath$(code As String) As String
    Dim dir As String
    dir = EditorBuild_ExeDir$()
    If Len(dir) = 0 Then
        UiLang_PackPath$ = "ProjectEditor_lang_" + code + ".csv"
    Else
        UiLang_PackPath$ = dir + "ProjectEditor_lang_" + code + ".csv"
    End If
End Function

Function UiLang_ReadFile$(path As String) As String
    Dim hFile As HANDLE
    Dim fsiz As Long
    Dim nRead As DWord
    Dim p As *Byte
    Dim encoding As Long

    UiLang_ReadFile$ = ""
    hFile = CreateFile(StrPtr(path), GENERIC_READ, FILE_SHARE_READ, ByVal NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL)
    If hFile = INVALID_HANDLE_VALUE Then Exit Function
    fsiz = GetFileSize(hFile, NULL)
    If fsiz < 0 Then
        CloseHandle(hFile)
        Exit Function
    End If
    p = malloc(fsiz + 1)
    If p = 0 Then
        CloseHandle(hFile)
        Exit Function
    End If
    nRead = 0
    If fsiz > 0 Then ReadFile(hFile, p, fsiz, VarPtr(nRead), ByVal NULL)
    CloseHandle(hFile)
    p[nRead] = 0
    encoding = Enc_Detect(p, nRead)
    UiLang_ReadFile$ = Enc_BytesToUtf8$(p, nRead, encoding)
    free(p)
End Function

Function UiLang_TrimCode$(s As String) As String
    Dim t As String
    Dim c As String
    t = s
    While Len(t) > 0
        c = Left$(t, 1)
        If c <> " " And c <> Chr$(9) And c <> Chr$(13) And c <> Chr$(10) Then Exit While
        t = Mid$(t, 2)
    Wend
    While Len(t) > 0
        c = Right$(t, 1)
        If c <> " " And c <> Chr$(9) And c <> Chr$(13) And c <> Chr$(10) Then Exit While
        t = Left$(t, Len(t) - 1)
    Wend
    UiLang_TrimCode$ = t
End Function

Function UiLang_IsLanguageKey(line As String) As Long
    Dim kw As String
    Dim i As Long
    Dim a As Long
    Dim b As Long
    Dim key As String

    UiLang_IsLanguageKey = 0
    If Len(line) < 9 Then Exit Function
    key = "language"
    kw = Left$(line, 8)
    For i = 1 To 8
        a = Asc(Mid$(kw, i, 1))
        b = Asc(Mid$(key, i, 1))
        If a >= 65 And a <= 90 Then a = a + 32
        If a <> b Then Exit Function
    Next
    If Mid$(line, 9, 1) <> "=" Then Exit Function
    UiLang_IsLanguageKey = 1
End Function

Function UiLang_CodeFromIniLine$(line As String) As String
    Dim t As String

    UiLang_CodeFromIniLine$ = ""
    t = UiLang_TrimCode$(line)
    If Len(t) = 0 Then Exit Function
    If Left$(t, 1) = "#" Then Exit Function
    If Left$(t, 1) = ";" Then Exit Function
    If Left$(t, 1) = "[" Then Exit Function
    If UiLang_IsLanguageKey(t) = 0 Then Exit Function
    UiLang_CodeFromIniLine$ = UiLang_TrimCode$(Mid$(t, 10))
End Function

Function UiLang_ReadCode$() As String
    Dim raw As String
    Dim line As String
    Dim code As String
    Dim i As Long
    Dim n As Long
    Dim c As Long

    UiLang_ReadCode$ = ""
    raw = UiLang_ReadFile$(UiLang_ConfigPath$())
    If Len(raw) = 0 Then Exit Function
    n = Len(raw)
    line = ""
    For i = 1 To n
        c = Asc(Mid$(raw, i, 1))
        If c = 10 Then
            code = UiLang_CodeFromIniLine$(line)
            If Len(code) > 0 Then
                UiLang_ReadCode$ = code
                Exit Function
            End If
            line = ""
        ElseIf c <> 13 Then
            line = line + Mid$(raw, i, 1)
        End If
    Next
    code = UiLang_CodeFromIniLine$(line)
    If Len(code) > 0 Then UiLang_ReadCode$ = code
End Function

Function UiLang_Unquote$(s As String) As String
    Dim t As String
    Dim n As Long
    t = s
    n = Len(t)
    If n >= 2 Then
        If Left$(t, 1) = Chr$(34) And Right$(t, 1) = Chr$(34) Then
            t = Mid$(t, 2, n - 2)
        End If
    End If
    UiLang_Unquote$ = t
End Function

Function UiLang_LineId(line As String, ByRef textOut As String) As Long
    Dim t As String
    Dim comma As Long
    Dim i As Long
    Dim n As Long

    UiLang_LineId = -1
    textOut = ""
    t = UiLang_TrimCode$(line)
    If Len(t) = 0 Then Exit Function
    If Left$(t, 1) = "#" Then Exit Function
    If Left$(t, 2) = "id" Then Exit Function
    n = Len(t)
    comma = 0
    For i = 1 To n
        If Mid$(t, i, 1) = "," Then
            comma = i
            Exit For
        End If
    Next
    If comma <= 1 Then Exit Function
    UiLang_LineId = Val(Left$(t, comma - 1))
    textOut = UiLang_Unquote$(Mid$(t, comma + 1))
End Function

Function UiLang_Lookup$(ByVal id As Long) As String
    Dim i As Long
    Dim n As Long
    Dim c As Long
    Dim line As String
    Dim lineId As Long
    Dim text As String

    UiLang_Lookup$ = ""
    If Len(g_uiCsv) = 0 Then Exit Function
    n = Len(g_uiCsv)
    line = ""
    For i = 1 To n
        c = Asc(Mid$(g_uiCsv, i, 1))
        If c = 10 Then
            lineId = UiLang_LineId(line, text)
            If lineId = id Then
                UiLang_Lookup$ = text
                Exit Function
            End If
            line = ""
        ElseIf c <> 13 Then
            line = line + Mid$(g_uiCsv, i, 1)
        End If
    Next
    If Len(line) > 0 Then
        lineId = UiLang_LineId(line, text)
        If lineId = id Then UiLang_Lookup$ = text
    End If
End Function

Sub UiLang_LoadPack(code As String)
    Dim path As String
    Dim raw As String

    If Len(code) = 0 Then Exit Sub
    If code = "en" Then Exit Sub
    path = UiLang_PackPath$(code)
    raw = UiLang_ReadFile$(path)
    If Len(raw) = 0 Then Exit Sub
    g_uiCsv = raw
End Sub

Sub UiLang_Init()
    Dim code As String
    Dim raw As String
    Dim msg As String
    UiLang_ClearOverrides()
    g_uiLangCode = "en"
    raw = UiLang_ReadFile$(UiLang_ConfigPath$())
    code = UiLang_ReadCode$()
    msg = "cfgLen=" + Str$(Len(raw)) + " code=[" + code + "] path=" + UiLang_ConfigPath$()
    MessageBox(0, msg, "UiLang", MB_OK)
    If Len(code) = 0 Then Exit Sub
    g_uiLangCode = code
    UiLang_LoadPack(code)
    MessageBox(0, "csvLen=" + Str$(Len(g_uiCsv)), "UiLang", MB_OK)
End Sub
Function UiLang_WriteCode(code As String) As Long
    Dim path As String
    Dim text As String
    Dim hFile As HANDLE
    Dim nWritten As DWord
    Dim n As Long
    Dim t As String

    UiLang_WriteCode = 0
    t = UiLang_TrimCode$(code)
    If Len(t) = 0 Then t = "en"
    path = UiLang_ConfigPath$()
    text = "# ProjectEditor settings (UTF-8)" + Chr$(13) + Chr$(10)
    text = text + "# Without this file (or Language=en), UI is English (built-in)." + Chr$(13) + Chr$(10)
    text = text + "# Language=ja loads ProjectEditor_lang_ja.csv next to the exe." + Chr$(13) + Chr$(10)
    text = text + "Language=" + t + Chr$(13) + Chr$(10)
    n = Len(text)
    hFile = CreateFile(StrPtr(path), GENERIC_WRITE, 0, ByVal NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL)
    If hFile = INVALID_HANDLE_VALUE Then Exit Function
    nWritten = 0
    If n > 0 Then WriteFile(hFile, StrPtr(text), n, VarPtr(nWritten), ByVal NULL)
    CloseHandle(hFile)
    If nWritten = n Then UiLang_WriteCode = 1
End Function

Function UiText$(ByVal id As Long) As String
    Dim o As String
    o = UiLang_Lookup$(id)
    If Len(o) > 0 Then
        UiText$ = o
    Else
        UiText$ = UiTextDefault$(id)
    End If
End Function

Sub UiMsgBox(hWnd As HWND, msg As String, title As String)
    Dim wMsg As *Byte
    Dim wTitle As *Byte
    Dim nMsg As Long
    Dim nTitle As Long

    wMsg = Enc_Utf8ToWide(msg, nMsg)
    wTitle = Enc_Utf8ToWide(title, nTitle)
    If wMsg = 0 Or wTitle = 0 Then
        If wMsg <> 0 Then free(wMsg)
        If wTitle <> 0 Then free(wTitle)
        MessageBox(hWnd, msg, title, MB_OK)
        Exit Sub
    End If
    MessageBoxW(hWnd, wMsg, wTitle, MB_OK)
    free(wMsg)
    free(wTitle)
End Sub

Function UiMsgBoxYesNo(hWnd As HWND, msg As String, title As String) As Long
    Dim wMsg As *Byte
    Dim wTitle As *Byte
    Dim nMsg As Long
    Dim nTitle As Long
    Dim r As Long

    UiMsgBoxYesNo = 0
    wMsg = Enc_Utf8ToWide(msg, nMsg)
    wTitle = Enc_Utf8ToWide(title, nTitle)
    If wMsg = 0 Or wTitle = 0 Then
        If wMsg <> 0 Then free(wMsg)
        If wTitle <> 0 Then free(wTitle)
        r = MessageBox(hWnd, msg, title, UI_MB_YESNO Or UI_MB_ICONQUESTION)
        If r = UI_IDYES Then UiMsgBoxYesNo = 1
        Exit Function
    End If
    r = MessageBoxW(hWnd, wMsg, wTitle, UI_MB_YESNO Or UI_MB_ICONQUESTION)
    free(wMsg)
    free(wTitle)
    If r = UI_IDYES Then UiMsgBoxYesNo = 1
End Function
