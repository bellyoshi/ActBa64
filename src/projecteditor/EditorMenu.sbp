' Localize menus via ModifyMenuW / AppendMenuW (UTF-8 → UTF-16).

Sub EditorMenu_SetCmd(hMenu As HMENU, ByVal id As Long, ByVal uiId As Long)
    Dim wide As *Byte
    Dim chars As Long

    wide = Enc_Utf8ToWide(UiText$(uiId), chars)
    If wide = 0 Then Exit Sub
    ModifyMenuW(hMenu, id, MF_BYCOMMAND Or MF_STRING, id, wide)
    free(wide)
End Sub

Sub EditorMenu_SetPopup(hMenu As HMENU, ByVal pos As Long, hSub As HMENU, ByVal uiId As Long)
    Dim wide As *Byte
    Dim chars As Long

    wide = Enc_Utf8ToWide(UiText$(uiId), chars)
    If wide = 0 Then Exit Sub
    ModifyMenuW(hMenu, pos, MF_BYPOSITION Or MF_POPUP, hSub, wide)
    free(wide)
End Sub

Sub EditorMenu_ApplyFile()
    EditorMenu_SetCmd(hMenu_M_MAIN_0, IDM_FILENEW, UI_MENU_NEW)
    EditorMenu_SetCmd(hMenu_M_MAIN_0, IDM_FILEOPEN, UI_MENU_OPEN)
    EditorMenu_SetCmd(hMenu_M_MAIN_0, IDM_SAVEAS, UI_MENU_SAVEAS)
    EditorMenu_SetCmd(hMenu_M_MAIN_0, IDM_SAVE, UI_MENU_SAVE)
    EditorMenu_SetPopup(hMenu_M_MAIN, 0, hMenu_M_MAIN_0, UI_MENU_FILE)
End Sub

Sub EditorMenu_ApplyEdit()
    EditorMenu_SetCmd(hMenu_M_MAIN_1, IDM_UNDO, UI_MENU_UNDO)
    EditorMenu_SetCmd(hMenu_M_MAIN_1, IDM_REDO, UI_MENU_REDO)
    EditorMenu_SetCmd(hMenu_M_MAIN_1, IDM_CUT, UI_MENU_CUT)
    EditorMenu_SetCmd(hMenu_M_MAIN_1, IDM_COPY, UI_MENU_COPY)
    EditorMenu_SetCmd(hMenu_M_MAIN_1, IDM_PASTE, UI_MENU_PASTE)
    EditorMenu_SetCmd(hMenu_M_MAIN_1, IDM_SELECTALL, UI_MENU_SELECTALL)
    EditorMenu_SetCmd(hMenu_M_MAIN_1, IDM_DELETE, UI_MENU_DELETE)
    EditorMenu_SetPopup(hMenu_M_MAIN, 1, hMenu_M_MAIN_1, UI_MENU_EDIT)
End Sub

Sub EditorMenu_ApplyBasic()
    EditorMenu_SetCmd(hMenu_M_MAIN_2, IDM_TARGET64, UI_MENU_TARGET64)
    EditorMenu_SetCmd(hMenu_M_MAIN_2, IDM_TARGET32, UI_MENU_TARGET32)
    EditorMenu_SetCmd(hMenu_M_MAIN_2, IDM_RUN, UI_MENU_RUN)
    EditorMenu_SetCmd(hMenu_M_MAIN_2, IDM_COMPILE, UI_MENU_COMPILE)
    EditorMenu_SetPopup(hMenu_M_MAIN, 2, hMenu_M_MAIN_2, UI_MENU_BASIC)
End Sub

Sub EditorMenu_ApplyHelp()
    EditorMenu_SetCmd(hMenu_M_MAIN_3, IDM_HELP_KEYWORD, UI_MENU_HELP_KW)
    EditorMenu_SetCmd(hMenu_M_MAIN_3, IDM_HELP_ACTBA64, UI_MENU_HELP_ACTBA)
    EditorMenu_SetPopup(hMenu_M_MAIN, 3, hMenu_M_MAIN_3, UI_MENU_HELP)
End Sub

Sub EditorMenu_ApplyLang()
    EditorMenu_ApplyFile()
    EditorMenu_ApplyEdit()
    EditorMenu_ApplyBasic()
    EditorMenu_ApplyHelp()
    If hMainWnd <> 0 Then DrawMenuBar(hMainWnd)
End Sub

Sub EditorMenu_Append(hPop As HMENU, ByVal flags As Long, ByVal id As Long, ByVal uiId As Long)
    Dim wide As *Byte
    Dim chars As Long

    wide = Enc_Utf8ToWide(UiText$(uiId), chars)
    If wide = 0 Then Exit Sub
    AppendMenuW(hPop, flags, id, wide)
    free(wide)
End Sub
