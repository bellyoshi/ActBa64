' Localize menus via ModifyMenuW / AppendMenuW (UTF-8 → UTF-16).

Sub EditorMenu_SetCmd(hMenu As HMENU, ByVal id As Long, ByVal uiId As Long)
    Dim wide As *Byte
    Dim chars As Long

    wide = Enc_Utf8ToWide(UiText$(uiId), chars)
    If wide = 0 Then Exit Sub
    ModifyMenuW(hMenu, id, MF_BYCOMMAND Or MF_STRING, id, wide)
    free(wide)
End Sub

Sub EditorMenu_SetPopup(hMenu As HMENU, ByVal pos As Long, hSub As HMENU, ByVal uiId As Long)
    Dim wide As *Byte
    Dim chars As Long
    Dim subAsLong As Long

    ' USER handles fit in 32 bits; pass submenu via Long for Declare compatibility.
    subAsLong = hSub
    wide = Enc_Utf8ToWide(UiText$(uiId), chars)
    If wide = 0 Then Exit Sub
    ModifyMenuW(hMenu, pos, MF_BYPOSITION Or MF_POPUP, subAsLong, wide)
    free(wide)
End Sub

Sub EditorMenu_ApplyFile()
    EditorMenu_SetCmd(hMenu_M_MAIN_0, IDM_FILENEW, UI_MENU_NEW)
    EditorMenu_SetCmd(hMenu_M_MAIN_0, IDM_FILEOPEN, UI_MENU_OPEN)
    EditorMenu_SetCmd(hMenu_M_MAIN_0, IDM_SAVEAS, UI_MENU_SAVEAS)
    EditorMenu_SetCmd(hMenu_M_MAIN_0, IDM_SAVE, UI_MENU_SAVE)
    EditorMenu_SetPopup(hMenu_M_MAIN, 0, hMenu_M_MAIN_0, UI_MENU_FILE)
End Sub

Sub EditorMenu_ApplyEdit()
    EditorMenu_SetCmd(hMenu_M_MAIN_1, IDM_UNDO, UI_MENU_UNDO)
    EditorMenu_SetCmd(hMenu_M_MAIN_1, IDM_REDO, UI_MENU_REDO)
    EditorMenu_SetCmd(hMenu_M_MAIN_1, IDM_CUT, UI_MENU_CUT)
    EditorMenu_SetCmd(hMenu_M_MAIN_1, IDM_COPY, UI_MENU_COPY)
    EditorMenu_SetCmd(hMenu_M_MAIN_1, IDM_PASTE, UI_MENU_PASTE)
    EditorMenu_SetCmd(hMenu_M_MAIN_1, IDM_SELECTALL, UI_MENU_SELECTALL)
    EditorMenu_SetCmd(hMenu_M_MAIN_1, IDM_DELETE, UI_MENU_DELETE)
    EditorMenu_SetPopup(hMenu_M_MAIN, 1, hMenu_M_MAIN_1, UI_MENU_EDIT)
End Sub

Sub EditorMenu_ApplyBasic()
    EditorMenu_SetCmd(hMenu_M_MAIN_2, IDM_TARGET64, UI_MENU_TARGET64)
    EditorMenu_SetCmd(hMenu_M_MAIN_2, IDM_TARGET32, UI_MENU_TARGET32)
    EditorMenu_SetCmd(hMenu_M_MAIN_2, IDM_RUN, UI_MENU_RUN)
    EditorMenu_SetCmd(hMenu_M_MAIN_2, IDM_COMPILE, UI_MENU_COMPILE)
    EditorMenu_SetPopup(hMenu_M_MAIN, 2, hMenu_M_MAIN_2, UI_MENU_BASIC)
End Sub

Sub EditorMenu_ApplySetting()
    EditorMenu_SetCmd(hMenu_M_MAIN_3, IDM_SETTING, UI_MENU_SETTING_ITEM)
    EditorMenu_SetPopup(hMenu_M_MAIN, 3, hMenu_M_MAIN_3, UI_MENU_SETTING)
End Sub

Sub EditorMenu_ApplyHelp()
    EditorMenu_SetCmd(hMenu_M_MAIN_4, IDM_HELP_KEYWORD, UI_MENU_HELP_KW)
    EditorMenu_SetCmd(hMenu_M_MAIN_4, IDM_HELP_ACTBA64, UI_MENU_HELP_ACTBA)
    EditorMenu_SetPopup(hMenu_M_MAIN, 4, hMenu_M_MAIN_4, UI_MENU_HELP)
End Sub

Sub EditorMenu_ApplyWindow()
    If g_hMenuWindow = 0 Then Exit Sub
    EditorMenu_SetCmd(g_hMenuWindow, IDM_CASCADE, UI_MENU_CASCADE)
    EditorMenu_SetCmd(g_hMenuWindow, IDM_TILEHORZ, UI_MENU_TILEHORZ)
    EditorMenu_SetCmd(g_hMenuWindow, IDM_TILEVERT, UI_MENU_TILEVERT)
    EditorMenu_SetPopup(hMenu_M_MAIN, 5, g_hMenuWindow, UI_MENU_WINDOW)
End Sub

Sub EditorMenu_ApplyLang()
    EditorMenu_ApplyFile()
    EditorMenu_ApplyEdit()
    EditorMenu_ApplyBasic()
    EditorMenu_ApplySetting()
    EditorMenu_ApplyHelp()
    EditorMenu_ApplyWindow()
    If hMainWnd <> 0 Then DrawMenuBar(hMainWnd)
End Sub

Function EditorMenu_FileIs(id As Long) As Long
    EditorMenu_FileIs = 0
    If id = IDM_FILENEW Or id = IDM_FILEOPEN Then EditorMenu_FileIs = 1
    If id = IDM_SAVE Or id = IDM_SAVEAS Then EditorMenu_FileIs = 1
End Function

Function EditorMenu_FileCmd(id As Long) As Long
    EditorMenu_FileCmd = 1
    If id = IDM_FILENEW Then MdiNewDoc()
    If id = IDM_FILEOPEN Then MdiOpenDoc()
    If id = IDM_SAVE Then MainWnd_IDM_SAVE_MenuClick()
    If id = IDM_SAVEAS Then MainWnd_IDM_SAVEAS_MenuClick()
    If EditorMenu_FileIs(id) = 0 Then EditorMenu_FileCmd = 0
End Function

Function EditorMenu_EditIs(id As Long) As Long
    EditorMenu_EditIs = 0
    If id = IDM_UNDO Or id = IDM_REDO Or id = IDM_CUT Then EditorMenu_EditIs = 1
    If id = IDM_COPY Or id = IDM_PASTE Or id = IDM_DELETE Then EditorMenu_EditIs = 1
    If id = IDM_SELECTALL Then EditorMenu_EditIs = 1
End Function

Sub EditorMenu_EditRun(id As Long)
    If id = IDM_UNDO Then MainWnd_IDM_UNDO_MenuClick()
    If id = IDM_REDO Then MainWnd_IDM_REDO_MenuClick()
    If id = IDM_CUT Then MainWnd_IDM_CUT_MenuClick()
    If id = IDM_COPY Then MainWnd_IDM_COPY_MenuClick()
    If id = IDM_PASTE Then MainWnd_IDM_PASTE_MenuClick()
    If id = IDM_DELETE Then MainWnd_IDM_DELETE_MenuClick()
    If id = IDM_SELECTALL Then MainWnd_IDM_SELECTALL_MenuClick()
End Sub

Function EditorMenu_EditCmd(id As Long) As Long
    EditorMenu_EditCmd = 0
    If g_activeChild = 0 Then Exit Function
    If EditorMenu_EditIs(id) = 0 Then Exit Function
    EditorMenu_EditCmd = 1
    EditorMenu_EditRun(id)
End Function

Function EditorMenu_BasicIs(id As Long) As Long
    EditorMenu_BasicIs = 0
    If id = IDM_RUN Or id = IDM_COMPILE Then EditorMenu_BasicIs = 1
    If id = IDM_TARGET64 Or id = IDM_TARGET32 Then EditorMenu_BasicIs = 1
End Function

Function EditorMenu_BasicCmd(id As Long) As Long
    EditorMenu_BasicCmd = 1
    If id = IDM_RUN Then MainWnd_IDM_RUN_MenuClick()
    If id = IDM_COMPILE Then MainWnd_IDM_COMPILE_MenuClick()
    If id = IDM_TARGET64 Then MainWnd_IDM_TARGET64_MenuClick()
    If id = IDM_TARGET32 Then MainWnd_IDM_TARGET32_MenuClick()
    If EditorMenu_BasicIs(id) = 0 Then EditorMenu_BasicCmd = 0
End Function

Function EditorMenu_MiscCmd(id As Long) As Long
    EditorMenu_MiscCmd = 1
    If id = IDM_SETTING Then MainWnd_IDM_SETTING_MenuClick()
    If id = IDM_HELP_KEYWORD Then MainWnd_IDM_HELP_KEYWORD_MenuClick()
    If id = IDM_HELP_ACTBA64 Then MainWnd_IDM_HELP_ACTBA64_MenuClick()
    If id <> IDM_SETTING And id <> IDM_HELP_KEYWORD And id <> IDM_HELP_ACTBA64 Then EditorMenu_MiscCmd = 0
End Function

Function EditorMenu_OnCommand(id As Long) As Long
    EditorMenu_OnCommand = 0
    If EditorMenu_FileCmd(id) <> 0 Then EditorMenu_OnCommand = 1
    If EditorMenu_EditCmd(id) <> 0 Then EditorMenu_OnCommand = 1
    If EditorMenu_BasicCmd(id) <> 0 Then EditorMenu_OnCommand = 1
    If EditorMenu_MiscCmd(id) <> 0 Then EditorMenu_OnCommand = 1
End Function

Sub EditorMenu_Append(hPop As HMENU, ByVal flags As Long, ByVal id As Long, ByVal uiId As Long)
    Dim wide As *Byte
    Dim chars As Long

    wide = Enc_Utf8ToWide(UiText$(uiId), chars)
    If wide = 0 Then Exit Sub
    AppendMenuW(hPop, flags, id, wide)
    free(wide)
End Sub
