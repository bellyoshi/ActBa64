' ドロップは来ない
Function Lx_DragQueryFileA(ByVal h As VoidPtr, ByVal i As DWord, ByVal buf As *Byte, ByVal n As DWord) As DWord
    Lx_DragQueryFileA = 0
End Function

Sub Lx_DragFinish(ByVal h As VoidPtr)
End Sub

' 窓のクラス名は無い（空）
Function Lx_GetClassNameA(ByVal h As VoidPtr, ByVal buf As *Byte, ByVal n As Long) As Long
    If buf <> 0 And n > 0 Then buf[0] = 0
    Lx_GetClassNameA = 0
End Function
#endif

#ifdef _LINUX
Function Lx_SetCapture(ByVal h As VoidPtr) As VoidPtr
    Lx_SetCapture = g_uxCapture
    g_uxCapture = h As Long
End Function

Function Lx_ReleaseCapture() As Long
    g_uxCapture = 0
    Lx_ReleaseCapture = 1
End Function
