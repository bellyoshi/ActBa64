' フォームデザイナの画面（RAD 第一段階）。F12 でソースとデザインを切り替える。
' InitializeComponent の Width x Height の窓を FD_ORG_X, FD_ORG_Y に描く。
' 右辺・下辺・右下を引くと大きさが変わり、離したときに Width / Height の行を書き換える。
' 窓の中の部品（AddControl したもの）は FormDesignCtlView.sbp、左のツールボックスは FormDesignToolView.sbp。
' 書き換えは 1 回の編集として「元に戻す」が効く。デザイン中は文字を打てない。

Const FD_GUI_FONT = 17             ' DEFAULT_GUI_FONT

Dim g_fdOn As Long                  ' 前面の文書がデザイン中か
Dim g_fdSlot(7) As Long             ' 文書（Mdi のスロット）ごとのデザイン中
Dim g_fdDrag As Long                ' 引いている所（FormDesign_Hit / FormDesign_CtlHit）。0 は引いていない
Dim g_fdX0 As Long, g_fdY0 As Long  ' 押した位置
Dim g_fdW0 As Long, g_fdH0 As Long  ' 押したときの大きさ
Dim g_fdW As Long, g_fdH As Long    ' 引いている間の大きさ
Dim g_fdSel As String               ' 選んでいる部品の名前。"" は選んでいない
Dim g_fdCX0 As Long, g_fdCY0 As Long, g_fdCW0 As Long, g_fdCH0 As Long ' 押したときの部品
Dim g_fdCX As Long, g_fdCY As Long, g_fdCW As Long, g_fdCH As Long     ' 引いている間の部品

' hWnd の文書がデザイン中か（前面は g_fdOn、ほかはスロット）
Function FormDesign_IsOn(hWnd As HWND) As Long
    Dim s As Long
    FormDesign_IsOn = g_fdOn
    If hWnd = g_activeChild Then Exit Function
    FormDesign_IsOn = 0
    s = MdiSlotOf(hWnd)
    If s >= 0 Then FormDesign_IsOn = g_fdSlot(s)
End Function

' hWnd の文書の本文（前面は編集中のバッファ、ほかはスロット）
Function FormDesign_Text$(hWnd As HWND) As String
    Dim s As Long
    FormDesign_Text$ = TextBuf_GetConfirmed$()
    If hWnd = g_activeChild Then Exit Function
    FormDesign_Text$ = ""
    s = MdiSlotOf(hWnd)
    If s >= 0 Then FormDesign_Text$ = g_docText(s)
End Function

' 描く大きさ。引いている間はその大きさ
Sub FormDesign_Size(hWnd As HWND, text As String, ByRef w As Long, ByRef h As Long)
    w = FormDesign_GetNum(text, "Width", FD_DEF_W)
    h = FormDesign_GetNum(text, "Height", FD_DEF_H)
    FormDesign_DragSize(0, w, h, 0, 0, w, h)
    If g_fdDrag = 0 Or hWnd <> g_activeChild Then Exit Sub
    w = g_fdW
    h = g_fdH
End Sub

Function FormDesign_HitAt(hWnd As HWND, ByVal x As Long, ByVal y As Long) As Long
    Dim w As Long, h As Long
    FormDesign_Size(hWnd, FormDesign_Text$(hWnd), w, h)
    FormDesign_HitAt = FormDesign_ToolHitAt(x, y, w, h)
    If FormDesign_HitAt <> 0 Then Exit Function
    FormDesign_HitAt = FormDesign_CtlHitAt(hWnd, x, y)
    If FormDesign_HitAt <> 0 Then Exit Function
    FormDesign_HitAt = FormDesign_Hit(x, y, w, h)
End Function

' ---- 切り替え ----

Sub FormDesign_Refresh(hWnd As HWND)
    EditorDoc_UpdateTitle(hWnd)
    InvalidateRect(hWnd, ByVal 0, FALSE)
End Sub

' InitializeComponent が無い文書はデザインにしない（音だけ鳴らす）
Sub FormDesign_Enter(hWnd As HWND)
    EditorUndo_EndCoalesce()
    If FormDesign_IsForm(TextBuf_GetConfirmed$()) = 0 Then
        MessageBeep(0)
        Exit Sub
    End If
    g_fdOn = 1
    EditorCaret_Destroy()
    FormDesign_Refresh(hWnd)
End Sub

Sub FormDesign_Leave(hWnd As HWND)
    g_fdOn = 0
    g_fdSel = ""
    g_fdTool = 0
    If g_fdDrag <> 0 Then ReleaseCapture()
    g_fdDrag = 0
    If GetFocus() = hWnd Then EditorCaret_Create(hWnd)
    FormDesign_Refresh(hWnd)
End Sub

Sub FormDesign_Toggle(hWnd As HWND)
    If hWnd = 0 Then Exit Sub
    If g_fdOn <> 0 Then
        FormDesign_Leave(hWnd)
    Else
        FormDesign_Enter(hWnd)
    End If
End Sub

' ---- 描画 ----

Sub FormDesign_Rect(ByRef rc As RECT, ByVal l As Long, ByVal t As Long, ByVal r As Long, ByVal b As Long)
    rc.left = l
    rc.top = t
    rc.right = r
    rc.bottom = b
End Sub

Sub FormDesign_Fill(hDC As HDC, ByVal l As Long, ByVal t As Long, ByVal r As Long, ByVal b As Long, ByVal color As DWord)
    Dim rc As RECT
    Dim br As HBRUSH
    FormDesign_Rect(rc, l, t, r, b)
    br = CreateSolidBrush(color)
    FillRect(hDC, rc, br)
    DeleteObject(br)
End Sub

' 見出しの帯と文字
Sub FormDesign_DrawCaption(hDC As HDC, ByVal w As Long, cap As String)
    Dim ch As Long
    ch = GetSystemMetrics(SM_CYCAPTION)
    FormDesign_Fill(hDC, FD_ORG_X + 4, FD_ORG_Y + 4, FD_ORG_X + w - 4, FD_ORG_Y + 4 + ch, GetSysColor(COLOR_ACTIVECAPTION))
    SetTextColor(hDC, GetSysColor(COLOR_CAPTIONTEXT))
    Enc_TextOutUtf8(hDC, FD_ORG_X + 10, FD_ORG_Y + 4 + (ch - 14) \ 2, cap)
End Sub

' 窓の外枠（Width / Height は枠を含む大きさ）
Sub FormDesign_DrawWindow(hDC As HDC, ByVal w As Long, ByVal h As Long, cap As String)
    Dim rc As RECT
    FormDesign_Fill(hDC, FD_ORG_X, FD_ORG_Y, FD_ORG_X + w, FD_ORG_Y + h, GetSysColor(COLOR_BTNFACE))
    FormDesign_Rect(rc, FD_ORG_X, FD_ORG_Y, FD_ORG_X + w, FD_ORG_Y + h)
    DrawEdge(hDC, rc, EDGE_RAISED, BF_RECT)
    FormDesign_DrawCaption(hDC, w, cap)
End Sub

Sub FormDesign_Grip(hDC As HDC, ByVal x As Long, ByVal y As Long)
    FormDesign_Fill(hDC, x - 3, y - 3, x + 4, y + 4, RGB(0, 0, 0))
    FormDesign_Fill(hDC, x - 2, y - 2, x + 3, y + 3, RGB(255, 255, 255))
End Sub

Sub FormDesign_DrawGrips(hDC As HDC, ByVal w As Long, ByVal h As Long)
    FormDesign_Grip(hDC, FD_ORG_X + w, FD_ORG_Y + h \ 2)
    FormDesign_Grip(hDC, FD_ORG_X + w \ 2, FD_ORG_Y + h)
    FormDesign_Grip(hDC, FD_ORG_X + w, FD_ORG_Y + h)
End Sub

' 左下に大きさと切り替えキー
Sub FormDesign_DrawInfo(hDC As HDC, ByRef rc As RECT, t As String, ByVal w As Long, ByVal h As Long)
    Dim s As String
    s = FormDesign_InfoText$(t, w, h) & "    (F12: source)"
    SetTextColor(hDC, RGB(255, 255, 255))
    Enc_TextOutUtf8(hDC, FD_ORG_X, rc.bottom - 20, s)
End Sub

Sub FormDesign_DrawAll(hDC As HDC, hWnd As HWND, ByRef rc As RECT)
    Dim t As String, w As Long, h As Long
    t = FormDesign_Text$(hWnd)
    FormDesign_Size(hWnd, t, w, h)
    FormDesign_Fill(hDC, 0, 0, rc.right, rc.bottom, GetSysColor(COLOR_APPWORKSPACE))
    FormDesign_DrawToolbox(hDC, rc)
    FormDesign_DrawWindow(hDC, w, h, FormDesign_GetStr$(t, "Caption"))
    FormDesign_DrawCtls(hDC, t, w, h)
    FormDesign_DrawGrips(hDC, w, h)
    FormDesign_DrawInfo(hDC, rc, t, w, h)
End Sub

Sub FormDesign_Draw(hDC As HDC, hWnd As HWND, ByRef rc As RECT)
    Dim old As HFONT
    SetBkMode(hDC, TRANSPARENT)
    old = SelectObject(hDC, GetStockObject(FD_GUI_FONT))
    FormDesign_DrawAll(hDC, hWnd, rc)
    SelectObject(hDC, old)
End Sub

' 裏の画像に描いてから一度に写す（引いている間ちらつかない）
Sub FormDesign_PaintBuf(hDC As HDC, hWnd As HWND)
    Dim rc As RECT, mem As HDC
    Dim bmp As HBITMAP, old As HBITMAP
    GetClientRect(hWnd, rc)
    mem = CreateCompatibleDC(hDC)
    bmp = CreateCompatibleBitmap(hDC, rc.right + 1, rc.bottom + 1)
    old = SelectObject(mem, bmp)
    FormDesign_Draw(mem, hWnd, rc)
    FormDesign_Flush(hDC, mem, bmp, old, rc)
End Sub

Sub FormDesign_Flush(hDC As HDC, mem As HDC, bmp As HBITMAP, old As HBITMAP, ByRef rc As RECT)
    BitBlt(hDC, 0, 0, rc.right, rc.bottom, mem, 0, 0, &H00CC0020)
    SelectObject(mem, old)
    DeleteObject(bmp)
    DeleteDC(mem)
End Sub

Sub FormDesign_Paint(hWnd As HWND)
    Dim ps As PAINTSTRUCT
    Dim hDC As HDC
    hDC = BeginPaint(hWnd, ps)
    FormDesign_PaintBuf(hDC, hWnd)
    EndPaint(hWnd, ps)
End Sub

' ---- マウス ----

Function FormDesign_CursorId(ByVal kind As Long) As Long
    FormDesign_CursorId = IDC_ARROW
    If kind = FD_KIND_TOOL Then
        FormDesign_CursorId = IDC_CROSS
        Exit Function
    End If
    If kind = FD_KIND_MOVE Then FormDesign_CursorId = IDC_SIZEALL
    If kind > FD_KIND_MOVE Then kind = kind - FD_KIND_MOVE
    If kind = 1 Then FormDesign_CursorId = IDC_SIZEWE
    If kind = 2 Then FormDesign_CursorId = IDC_SIZENS
    If kind = 3 Then FormDesign_CursorId = IDC_SIZENWSE
End Function

Sub FormDesign_SetCursor(ByVal kind As Long)
    SetCursor(LoadCursor(NULL, MAKEINTRESOURCE(FormDesign_CursorId(kind))))
End Sub

' 辺の上では大きさを変える矢印にする。クライアントの外は既定どおり
Function FormDesign_OnSetCursor(hWnd As HWND, wParam As WPARAM, lParam As LPARAM) As LRESULT
    If LOWORD(lParam) <> HTCLIENT Then
        FormDesign_OnSetCursor = DefMDIChildProc(hWnd, WM_SETCURSOR, wParam, lParam)
        Exit Function
    End If
    FormDesign_SetCursor(FormDesign_HitCursor(hWnd))
    FormDesign_OnSetCursor = 1
End Function

' マウスの今の位置で掴める所
Function FormDesign_HitCursor(hWnd As HWND) As Long
    Dim pt As POINT
    GetCursorPos(pt)
    ScreenToClient(hWnd, pt)
    FormDesign_HitCursor = FormDesign_HitAt(hWnd, pt.x, pt.y)
End Function

Sub FormDesign_Begin(hWnd As HWND, ByVal x As Long, ByVal y As Long)
    g_fdX0 = x
    g_fdY0 = y
    g_fdW = g_fdW0
    g_fdH = g_fdH0
    SetCapture(hWnd)
End Sub

' ツールボックスとツールの置き場所が先。部品の上なら部品を選んで掴む。そうでなければ選びを外し、窓の辺を見る
Sub FormDesign_Down(hWnd As HWND, ByVal lParam As LPARAM)
    Dim x As Long, y As Long
    SetFocus(hWnd)
    EditorSelect_XY(lParam, x, y)
    FormDesign_Size(hWnd, FormDesign_Text$(hWnd), g_fdW0, g_fdH0)
    InvalidateRect(hWnd, ByVal 0, FALSE)
    If FormDesign_ToolDown(x, y, g_fdW0, g_fdH0) <> 0 Then Exit Sub
    g_fdDrag = FormDesign_CtlDown(hWnd, x, y)
    If g_fdDrag = 0 Then g_fdDrag = FormDesign_Hit(x, y, g_fdW0, g_fdH0)
    If g_fdDrag <> 0 Then FormDesign_Begin(hWnd, x, y)
End Sub

Sub FormDesign_Move(hWnd As HWND, ByVal lParam As LPARAM)
    Dim x As Long, y As Long
    If g_fdDrag = 0 Then Exit Sub
    EditorSelect_XY(lParam, x, y)
    FormDesign_SetCursor(g_fdDrag)
    FormDesign_DragTo(x - g_fdX0, y - g_fdY0)
    InvalidateRect(hWnd, ByVal 0, FALSE)
End Sub

' 押した位置から dx, dy 引いた。部品なら部品を、そうでなければ窓の大きさを変える
Sub FormDesign_DragTo(ByVal dx As Long, ByVal dy As Long)
    If g_fdDrag >= FD_KIND_MOVE Then
        FormDesign_CtlMove(dx, dy)
    Else
        FormDesign_DragSize(g_fdDrag, g_fdW0, g_fdH0, dx, dy, g_fdW, g_fdH)
    End If
End Sub

' 本文を u に置き換える（1 回の編集として元に戻せる）
Sub FormDesign_Replace(u As String)
    Dim c As Long
    c = TextBuf_CursorIndex()
    If c > Len(u) Then c = Len(u)
    EditorUndo_BeforeEdit()
    TextBuf_SetText(u)
    EditorCoreMoveCursorTo(c)
    EditorUndo_EndCoalesce()
    EditorDoc_MarkDirty()
End Sub

' 変わった値だけ書き換える
Sub FormDesign_Commit()
    Dim t As String, u As String
    t = TextBuf_GetConfirmed$()
    u = FormDesign_Changed$(t)
    If u <> t Then FormDesign_Replace(u)
End Sub

' 引いた部品の位置と大きさ、または窓の大きさを書いた本文
Function FormDesign_Changed$(t As String) As String
    FormDesign_Changed$ = t
    If g_fdDrag >= FD_KIND_MOVE Then
        FormDesign_Changed$ = FormDesign_CtlCommit$(t)
        Exit Function
    End If
    If g_fdW <> g_fdW0 Then FormDesign_Changed$ = FormDesign_SetNum$(FormDesign_Changed$, "Width", g_fdW)
    If g_fdH <> g_fdH0 Then FormDesign_Changed$ = FormDesign_SetNum$(FormDesign_Changed$, "Height", g_fdH)
End Function

Sub FormDesign_Up(hWnd As HWND)
    If g_fdDrag = 0 Then Exit Sub
    FormDesign_Commit()
    g_fdDrag = 0
    ReleaseCapture()
    InvalidateRect(hWnd, ByVal 0, FALSE)
End Sub

' ほかの窓にマウスを取られたら、書き換えずにやめる
Sub FormDesign_Lost(hWnd As HWND)
    If g_fdDrag = 0 Then Exit Sub
    g_fdDrag = 0
    InvalidateRect(hWnd, ByVal 0, FALSE)
End Sub

Function FormDesign_MouseIs(dwMsg As DWord) As Long
    FormDesign_MouseIs = 0
    If dwMsg = WM_LBUTTONDOWN Or dwMsg = WM_MOUSEMOVE Or dwMsg = WM_LBUTTONUP Then FormDesign_MouseIs = 1
    If dwMsg = WM_SETCURSOR Or dwMsg = WM_CAPTURECHANGED Then FormDesign_MouseIs = 1
End Function

Function FormDesign_Mouse(hWnd As HWND, dwMsg As DWord, wParam As WPARAM, lParam As LPARAM) As Long
    FormDesign_Mouse = FormDesign_MouseIs(dwMsg)
    If dwMsg = WM_LBUTTONDOWN Then FormDesign_Down(hWnd, lParam)
    If dwMsg = WM_MOUSEMOVE Then FormDesign_Move(hWnd, lParam)
    If dwMsg = WM_LBUTTONUP Then FormDesign_Up(hWnd)
    If dwMsg = WM_CAPTURECHANGED Then FormDesign_Lost(hWnd)
    If dwMsg = WM_SETCURSOR Then g_childRet = FormDesign_OnSetCursor(hWnd, wParam, lParam)
End Function

' ---- キーとそのほか ----

' デザイン中に効くキー: F12（ソースへ）、Esc（ツールをやめる）、Ctrl+S、Ctrl+Z / Ctrl+Y
Sub FormDesign_Key(hWnd As HWND, ByVal vk As Long)
    If vk = VK_F12 Then FormDesign_Toggle(hWnd)
    If vk = VK_ESCAPE Then g_fdTool = 0
    If vk = VK_ESCAPE Then InvalidateRect(hWnd, ByVal 0, FALSE)
    If EditorKeys_Ctrl() = 0 Then Exit Sub
    If EditorKeys_Save(vk) <> 0 Then Exit Sub
    If EditorKeys_Hist(vk) <> 0 Then InvalidateRect(hWnd, ByVal 0, FALSE)
End Sub

' 文字入力・IME・スクロール・右クリック・フォーカス（キャレットを出さない）は捨てる
Function FormDesign_Swallow(dwMsg As DWord) As Long
    FormDesign_Swallow = 0
    If dwMsg = WM_CHAR Or dwMsg = WM_IME_COMPOSITION Or dwMsg = WM_IME_ENDCOMPOSITION Then FormDesign_Swallow = 1
    If dwMsg = WM_IME_STARTCOMPOSITION Or dwMsg = WM_CONTEXTMENU Then FormDesign_Swallow = 1
    If dwMsg = WM_MOUSEWHEEL Or dwMsg = WM_VSCROLL Then FormDesign_Swallow = 1
    If dwMsg = WM_SETFOCUS Or dwMsg = WM_KILLFOCUS Then FormDesign_Swallow = 1
End Function

Function FormDesign_Other(hWnd As HWND, dwMsg As DWord, wParam As WPARAM) As Long
    FormDesign_Other = FormDesign_Swallow(dwMsg)
    If dwMsg = WM_PAINT Or dwMsg = WM_ERASEBKGND Or dwMsg = WM_KEYDOWN Then FormDesign_Other = 1
    If dwMsg = WM_PAINT Then FormDesign_Paint(hWnd)
    If dwMsg = WM_ERASEBKGND Then g_childRet = 1
    If dwMsg = WM_KEYDOWN Then FormDesign_Key(hWnd, wParam As Long)
End Function

' デザイン中の子のメッセージ。扱ったら 1（戻り値は g_childRet）
Function FormDesign_Handle(hWnd As HWND, dwMsg As DWord, wParam As WPARAM, lParam As LPARAM) As Long
    FormDesign_Handle = 0
    If FormDesign_IsOn(hWnd) = 0 Then Exit Function
    FormDesign_Handle = FormDesign_Mouse(hWnd, dwMsg, wParam, lParam)
    If FormDesign_Handle <> 0 Then Exit Function
    FormDesign_Handle = FormDesign_Other(hWnd, dwMsg, wParam)
End Function
