'Const GCS_RESULTSTR = &H0800
'Const GCS_COMPSTR   = &H0008

Dim g_strConfirmed As String
'Dim g_strComp As String

Sub DrawTextEngine(hDC As Long)
    Dim displayStr As String

    displayStr = g_strConfirmed ' & g_strComp

    Dim hBrush As Long, rect As RECT
    GetClientRect(GetActiveWindow(), rect)
    hBrush = CreateSolidBrush(RGB(255, 255, 255))
    FillRect(hDC, rect, hBrush)
    DeleteObject(hBrush)

    SetBkMode(hDC, TRANSPARENT)
    TextOut(hDC, 10, 10, displayStr, Len(displayStr))
End Sub

Function MainWndProc(hWnd As HWND, dwMsg As DWord, wParam As WPARAM, lParam As LPARAM) As DWord
    Select Case dwMsg

        Case WM_CHAR
            If wParam = 8 Then
                If Len(g_strConfirmed) > 0 Then
                    g_strConfirmed = Left$(g_strConfirmed, Len(g_strConfirmed) - 1)
                End If
            ElseIf wParam >= 32 Then
                g_strConfirmed = g_strConfirmed & Chr$(wParam)
            End If

            InvalidateRect(hWnd, NULL, TRUE)
            Return 0

'        Case WM_IME_COMPOSITION
'            Dim hIMC As Long
'            hIMC = ImmGetContext(hWnd)
'
'            If hIMC <> 0 Then
'                If (lParam And GCS_RESULTSTR) <> 0 Then
'                    Dim resLen As Long
'                    Dim resBuf As String
'                    resLen = ImmGetCompositionStringA(hIMC, GCS_RESULTSTR,  0, 0)
'                    If resLen > 0 Then
'                        resBuf = String$(resLen, 0)
'                        ImmGetCompositionStringA(hIMC, GCS_RESULTSTR, resBuf, resLen)
'
'                        g_strConfirmed = g_strConfirmed & resBuf
'                        g_strComp = ""
'                    End If
'
'                ElseIf (lParam And GCS_COMPSTR) <> 0 Then
'                    Dim compLen As Long
'                    Dim compBuf As String
'                    compLen = ImmGetCompositionStringA(hIMC, GCS_COMPSTR,  0, 0)
'                    If compLen > 0 Then
'                        compBuf = String$(compLen, 0)
'                        ImmGetCompositionStringA(hIMC, GCS_COMPSTR, compBuf, compLen)
'                        g_strComp = compBuf
'                    Else
'                        g_strComp = ""
'                    End If
'                End If
'
'                ImmReleaseContext(hWnd, hIMC)
'            End If
'
'            InvalidateRect(hWnd, 0, TRUE)
'            Return 0

        Case WM_PAINT
            Dim ps As PAINTSTRUCT
            Dim hDC As Long
            hDC = BeginPaint(hWnd, ps)

            DrawTextEngine(hDC)

            EndPaint(hWnd, ps)
            Return 0

        Case WM_DESTROY
            PostQuitMessage(0)
            Return 0
    End Select

	MainWndProc=EventCall_MainWnd(hWnd,dwMsg,wParam,lParam)
End Function

Sub MainWnd_Destroy()
	ProjectEditor_DestroyObjects()
	PostQuitMessage(0)
End Sub

Sub MainWnd_ExecButton_Click()
  MessageBox(0, "実行するコードはまだ未実装","ProjectEditor", MB_OK)
End Sub
