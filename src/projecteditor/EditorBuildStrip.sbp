' EditorBuildStrip - Basic メニューの「使用していない命令を削除 (-X)」
' 選ぶと actba64 に -X を付けて訳す（呼ばれない関数を消して exe を小さくする）。
' 32bit / 64bit・構文とは別に入り切りし、editor.target に " x" を付けて覚える。

Const IDM_DEADSTRIP = 1320

Dim g_buildStrip As Long
Dim g_buildStripMenu As Long

Function EditorBuild_IsStrip() As Long
    EditorBuild_IsStrip = g_buildStrip
End Function

Function EditorBuild_StripOpt$() As String
    EditorBuild_StripOpt$ = ""
    If g_buildStrip <> 0 Then EditorBuild_StripOpt$ = " -X"
End Function

' Basic メニューの -X の項目なら切り替えて 1
Function EditorBuild_StripCmd(id As Long) As Long
    EditorBuild_StripCmd = 0
    If id <> IDM_DEADSTRIP Then Exit Function
    g_buildStrip = EditorBuild_Flip(g_buildStrip)
    EditorBuild_SyntaxChanged()
    EditorBuild_StripCmd = 1
End Function

' ---- メニュー ----

' ActiveBasic2 構文の次（実行の前）に差し込む。2 回目からは表示名だけ更新
Sub EditorBuild_ApplyStripMenu()
    If g_buildStripMenu = 0 Then EditorBuild_InsertStripMenu()
    EditorMenu_SetCmd(hMenu_M_MAIN_2, IDM_DEADSTRIP, UI_MENU_DEADSTRIP)
    EditorBuild_CheckStripMenu()
End Sub

Sub EditorBuild_InsertStripMenu()
    Dim wide As *Byte
    Dim chars As Long
    wide = Enc_Utf8ToWide(UiText$(UI_MENU_DEADSTRIP), chars)
    If wide = 0 Then Exit Sub
    InsertMenuW(hMenu_M_MAIN_2, IDM_RUN, MF_BYCOMMAND Or MF_STRING, IDM_DEADSTRIP, wide)
    free(wide)
    g_buildStripMenu = 1
End Sub

Sub EditorBuild_CheckStripMenu()
    Dim flags As Long
    If g_buildStripMenu = 0 Then Exit Sub
    flags = MF_BYCOMMAND
    If g_buildStrip <> 0 Then flags = flags Or MF_CHECKED
    CheckMenuItem(hMenu_M_MAIN_2, IDM_DEADSTRIP, flags)
End Sub

' ---- 設定ファイル（editor.target の最後に " x"）----

Function EditorBuild_StripTag$() As String
    EditorBuild_StripTag$ = ""
    If g_buildStrip <> 0 Then EditorBuild_StripTag$ = " x"
End Function

Sub EditorBuild_LoadStrip(s As String)
    g_buildStrip = 0
    If InStr(1, s, " x") > 0 Then g_buildStrip = 1
End Sub
