' AB4 デザイナー（文書タブの 3 つ目）の値の計算（Win32 を使わないので unittest でも読む）。
' .wnd（ウィンドウ定義ファイル）を RadWnd_Parse で読み、窓（g_rw*）と部品（g_ri*）を描く。

Const AB4K_BUTTON = 0           ' 押しボタン
Const AB4K_CHECK = 1            ' 四角と文字
Const AB4K_RADIO = 2            ' 丸と文字
Const AB4K_EDIT = 3             ' 白い欄と文字（EditBox）
Const AB4K_GROUP = 4            ' 彫った線の枠と見出し
Const AB4K_LABEL = 5            ' 文字だけ（Static）
Const AB4K_BOX = 6              ' 白地にへこんだ枠と名前（ListBox / ListView / TreeView）
Const AB4K_COMBO = 7            ' 白い欄と右の ▼ ボタン（ComboBox）
Const AB4K_HSCROLL = 8          ' 横のスクロール バー
Const AB4K_VSCROLL = 9          ' 縦のスクロール バー
Const AB4K_UPDOWN = 10          ' 上下の 2 つのボタン（UpDown）
Const AB4K_PROGRESS = 11        ' へこんだ枠（ProgressBar）
Const AB4K_TRACK = 12           ' 溝とつまみと目盛り（TrackBar）
Const AB4K_FRAME = 13           ' 黒い枠（ImageBox）

' 拡張子が .wnd なら 1
Function Ab4D_IsWnd(path As String) As Long
    Ab4D_IsWnd = 0
    If Len(path) < 4 Then Exit Function
    If Lower$(Right$(path, 4)) = ".wnd" Then Ab4D_IsWnd = 1
End Function

' 「a,b,c,d」の k 番目（1 始まり）の数。無ければ 0
Function Ab4D_Part(s As String, ByVal k As Long) As Long
    Dim p As Long, e As Long, i As Long
    Ab4D_Part = 0
    p = 1
    For i = 2 To k
        e = InStr(p, s, ",")
        If e = 0 Then Exit Function
        p = e + 1
    Next
    If p <= Len(s) Then Ab4D_Part = Val(Trim$(Mid$(s, p)))
End Function

' 部品の種類（ITEM の最後の数、RadEvent.sbp の表）の描き方
Function Ab4D_Kind(ByVal t As Long) As Long
    Ab4D_Kind = AB4K_BOX
    If t >= 1 And t <= 16 Then Ab4D_Kind = Val(Mid$(Ab4D_KindTable$(), t * 3 - 2, 2))
End Function

' 種類 1..16 の描き方（2 桁ずつ、区切りは空白）
'   1 Button 2 CheckBox 3 ComboBox 4 EditBox 5 GroupBox 6 HScrollBar 7 ImageBox 8 ListBox
'   9 ListView 10 RadioButton 11 Static 12 TreeView 13 VScrollBar 14 UpDown 15 ProgressBar 16 TrackBar
Function Ab4D_KindTable$() As String
    Ab4D_KindTable$ = "00 01 07 03 04 08 13 06 06 02 05 06 09 10 11 12 "
End Function

' 窓の幅と高さ（SIZE = 幅,高さ。無いか 0 以下なら FormDesign の既定）
Function Ab4D_SizeW(s As String) As Long
    Ab4D_SizeW = Ab4D_Part(s, 1)
    If Ab4D_SizeW <= 0 Then Ab4D_SizeW = FD_DEF_W
End Function

Function Ab4D_SizeH(s As String) As Long
    Ab4D_SizeH = Ab4D_Part(s, 2)
    If Ab4D_SizeH <= 0 Then Ab4D_SizeH = FD_DEF_H
End Function

' ---- 引いた結果を本文に書く ----

Dim g_a4Wn As Long              ' Ab4D_FindLine が読んだ WINDOW: の数 - 1

' pos の行（前後の空白と CR を除く）
Function Ab4D_LineAt$(text As String, ByVal pos As Long) As String
    Ab4D_LineAt$ = RadWnd_Strip$(Mid$(text, pos, FormDesign_LineEnd(text, pos) - pos))
End Function

' ITEM の行の名前（最初の欄）が name なら 1（大文字小文字は区別しない）
Function Ab4D_SameName(t As String, name As String) As Long
    Dim p As Long
    p = 1
    Ab4D_SameName = 0
    If Lower$(RadWnd_Field$(RadWnd_Val$(t), p)) = Lower$(name) Then Ab4D_SameName = 1
End Function

' 行 t が窓 w の kind の行か。cur は今いる窓（WINDOW: で進み、MENU: で -1）
Function Ab4D_LineHit(t As String, ByRef cur As Long, ByVal w As Long, ByVal kind As Long, name As String) As Long
    Ab4D_LineHit = 0
    If Lower$(Left$(t, 5)) = "menu:" Then cur = -1
    If Lower$(Left$(t, 7)) = "window:" Then g_a4Wn = g_a4Wn + 1 : cur = g_a4Wn
    If cur <> w Or cur < 0 Then Exit Function
    If kind = 0 And Lower$(Left$(t, 7)) = "window:" Then Ab4D_LineHit = 1
    If kind = 1 And RadWnd_Key$(t) = "size" Then Ab4D_LineHit = 1
    If kind = 2 And RadWnd_Key$(t) = "item" Then Ab4D_LineHit = Ab4D_SameName(t, name)
End Function

' 窓 w（0 始まり）の kind の行の始まり（0: WINDOW:、1: SIZE、2: name の ITEM）。無ければ 0
Function Ab4D_FindLine(text As String, ByVal w As Long, ByVal kind As Long, name As String) As Long
    Dim pos As Long, cur As Long
    Ab4D_FindLine = 0 : pos = 1 : cur = -1 : g_a4Wn = -1
    While pos <= Len(text)
        If Ab4D_LineHit(Ab4D_LineAt$(text, pos), cur, w, kind, name) <> 0 Then Ab4D_FindLine = pos
        If Ab4D_FindLine <> 0 Then Exit Function
        pos = FormDesign_LineEnd(text, pos) + 1
    Wend
End Function

' pos の行の = のあとの値を v に置き換える（行末の CR は残す）
Function Ab4D_ReplaceVal$(text As String, ByVal pos As Long, v As String) As String
    Dim a As Long, e As Long
    a = FormDesign_SkipBlank(text, InStr(pos, text, "=") + 1)
    e = FormDesign_LineEnd(text, pos)
    If e > a Then If Mid$(text, e - 1, 1) = Chr$(13) Then e = e - 1
    Ab4D_ReplaceVal$ = Left$(text, a - 1) & v & Mid$(text, e)
End Function

' ITEM の値の、x,y,幅,高さ を書き換えたもの（名前と、文字から後ろはそのまま）
Function Ab4D_ItemVal$(t As String, ByVal x As Long, ByVal y As Long, ByVal w As Long, ByVal h As Long) As String
    Dim v As String, p As Long, i As Long, name As String
    v = RadWnd_Val$(t) : p = 1
    name = RadWnd_Field$(v, p)
    For i = 1 To 4
        RadWnd_Field$(v, p)
    Next
    Ab4D_ItemVal$ = name & "," & FormDesign_Num$(x) & "," & FormDesign_Num$(y) & "," & FormDesign_Num$(w) & "," & FormDesign_Num$(h) & "," & Mid$(v, p)
End Function

' 窓 win の部品 name の位置と大きさを書いた本文。部品が無ければそのまま
Function Ab4D_SetItemRect$(text As String, ByVal win As Long, name As String, ByVal x As Long, ByVal y As Long, ByVal w As Long, ByVal h As Long) As String
    Dim pos As Long
    Ab4D_SetItemRect$ = text
    pos = Ab4D_FindLine(text, win, 2, name)
    If pos = 0 Then Exit Function
    Ab4D_SetItemRect$ = Ab4D_ReplaceVal$(text, pos, Ab4D_ItemVal$(Ab4D_LineAt$(text, pos), x, y, w, h))
End Function

' 窓 win の SIZE を w,h にした本文。SIZE の行が無ければ WINDOW: の次の行に足す。窓が無ければそのまま
Function Ab4D_SetWinSize$(text As String, ByVal win As Long, ByVal w As Long, ByVal h As Long) As String
    Dim pos As Long, v As String
    v = FormDesign_Num$(w) & "," & FormDesign_Num$(h)
    pos = Ab4D_FindLine(text, win, 1, "")
    If pos > 0 Then
        Ab4D_SetWinSize$ = Ab4D_ReplaceVal$(text, pos, v)
        Exit Function
    End If
    Ab4D_SetWinSize$ = Ab4D_AddSize$(text, Ab4D_FindLine(text, win, 0, ""), v)
End Function

' WINDOW: の行（pos）の次に「SIZE = v」の行を足す。pos が 0 ならそのまま
Function Ab4D_AddSize$(text As String, ByVal pos As Long, v As String) As String
    Dim e As Long
    Ab4D_AddSize$ = text
    If pos = 0 Then Exit Function
    e = FormDesign_LineEnd(text, pos)
    Ab4D_AddSize$ = Left$(text, e) & "    SIZE      = " & v & FormDesign_Nl$(text) & Mid$(text, e + 1)
End Function
