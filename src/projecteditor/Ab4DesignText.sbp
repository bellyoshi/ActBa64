' AB4 デザイナー（文書タブの 3 つ目）の値の計算（Win32 を使わないので unittest でも読む）。
' .wnd（ウィンドウ定義ファイル）を RadWnd_Parse で読み、窓（g_rw*）と部品（g_ri*）を描く。

Const AB4K_BUTTON = 0           ' 押しボタン
Const AB4K_CHECK = 1            ' 四角と文字
Const AB4K_RADIO = 2            ' 丸と文字
Const AB4K_EDIT = 3             ' 白い欄と文字（EditBox / ComboBox）
Const AB4K_GROUP = 4            ' 彫った線の枠と見出し
Const AB4K_LABEL = 5            ' 文字だけ（Static）
Const AB4K_BOX = 6              ' 白地にへこんだ枠と名前（ListBox / TreeView / ImageBox など）

' 拡張子が .wnd なら 1
Function Ab4D_IsWnd(path As String) As Long
    Ab4D_IsWnd = 0
    If Len(path) < 4 Then Exit Function
    If Lower$(Right$(path, 4)) = ".wnd" Then Ab4D_IsWnd = 1
End Function

' 「a,b,c,d」の k 番目（1 始まり）の数。無ければ 0
Function Ab4D_Part(s As String, ByVal k As Long) As Long
    Dim p As Long, e As Long, i As Long
    Ab4D_Part = 0
    p = 1
    For i = 2 To k
        e = InStr(p, s, ",")
        If e = 0 Then Exit Function
        p = e + 1
    Next
    If p <= Len(s) Then Ab4D_Part = Val(Trim$(Mid$(s, p)))
End Function

' 部品の種類（ITEM の最後の数、RadEvent.sbp の表）の描き方
Function Ab4D_Kind(ByVal t As Long) As Long
    Ab4D_Kind = AB4K_BOX
    If t = 1 Then Ab4D_Kind = AB4K_BUTTON
    If t = 2 Then Ab4D_Kind = AB4K_CHECK
    If t = 3 Or t = 4 Then Ab4D_Kind = AB4K_EDIT
    If t = 5 Then Ab4D_Kind = AB4K_GROUP
    If t = 10 Then Ab4D_Kind = AB4K_RADIO
    If t = 11 Then Ab4D_Kind = AB4K_LABEL
End Function

' 窓の幅と高さ（SIZE = 幅,高さ。無いか 0 以下なら FormDesign の既定）
Function Ab4D_SizeW(s As String) As Long
    Ab4D_SizeW = Ab4D_Part(s, 1)
    If Ab4D_SizeW <= 0 Then Ab4D_SizeW = FD_DEF_W
End Function

Function Ab4D_SizeH(s As String) As Long
    Ab4D_SizeH = Ab4D_Part(s, 2)
    If Ab4D_SizeH <= 0 Then Ab4D_SizeH = FD_DEF_H
End Function
