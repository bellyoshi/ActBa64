' AB4 デザイナー（文書タブの 3 つ目）の値の計算（Win32 を使わないので unittest でも読む）。
' .wnd（ウィンドウ定義ファイル）を RadWnd_Parse で読み、窓（g_rw*）と部品（g_ri*）を描く。

Const AB4K_BUTTON = 0           ' 押しボタン
Const AB4K_CHECK = 1            ' 四角と文字
Const AB4K_RADIO = 2            ' 丸と文字
Const AB4K_EDIT = 3             ' 白い欄と文字（EditBox）
Const AB4K_GROUP = 4            ' 彫った線の枠と見出し
Const AB4K_LABEL = 5            ' 文字だけ（Static）
Const AB4K_BOX = 6              ' 白地にへこんだ枠と名前（ListBox / ListView / TreeView）
Const AB4K_COMBO = 7            ' 白い欄と右の ▼ ボタン（ComboBox）
Const AB4K_HSCROLL = 8          ' 横のスクロール バー
Const AB4K_VSCROLL = 9          ' 縦のスクロール バー
Const AB4K_UPDOWN = 10          ' 上下の 2 つのボタン（UpDown）
Const AB4K_PROGRESS = 11        ' へこんだ枠（ProgressBar）
Const AB4K_TRACK = 12           ' 溝とつまみと目盛り（TrackBar）
Const AB4K_FRAME = 13           ' 黒い枠（ImageBox）

' 拡張子が .wnd なら 1
Function Ab4D_IsWnd(path As String) As Long
    Ab4D_IsWnd = 0
    If Len(path) < 4 Then Exit Function
    If Lower$(Right$(path, 4)) = ".wnd" Then Ab4D_IsWnd = 1
End Function

' 「a,b,c,d」の k 番目（1 始まり）の数。無ければ 0
Function Ab4D_Part(s As String, ByVal k As Long) As Long
    Ab4D_Part = Val(Trim$(Ab4D_Nth$(s, ",", k)))
End Function

' 部品の種類（ITEM の最後の数、RadEvent.sbp の表）の描き方
Function Ab4D_Kind(ByVal t As Long) As Long
    Ab4D_Kind = AB4K_BOX
    If t >= 1 And t <= 16 Then Ab4D_Kind = Val(Mid$(Ab4D_KindTable$(), t * 3 - 2, 2))
End Function

' 種類 1..16 の描き方（2 桁ずつ、区切りは空白）
'   1 Button 2 CheckBox 3 ComboBox 4 EditBox 5 GroupBox 6 HScrollBar 7 ImageBox 8 ListBox
'   9 ListView 10 RadioButton 11 Static 12 TreeView 13 VScrollBar 14 UpDown 15 ProgressBar 16 TrackBar
Function Ab4D_KindTable$() As String
    Ab4D_KindTable$ = "00 01 07 03 04 08 13 06 06 02 05 06 09 10 11 12 "
End Function

' 窓の幅と高さ（SIZE = 幅,高さ。無いか 0 以下なら FormDesign の既定）
Function Ab4D_SizeW(s As String) As Long
    Ab4D_SizeW = Ab4D_Part(s, 1)
    If Ab4D_SizeW <= 0 Then Ab4D_SizeW = FD_DEF_W
End Function

Function Ab4D_SizeH(s As String) As Long
    Ab4D_SizeH = Ab4D_Part(s, 2)
    If Ab4D_SizeH <= 0 Then Ab4D_SizeH = FD_DEF_H
End Function

' ---- 引いた結果を本文に書く ----

Dim g_a4Wn As Long              ' Ab4D_FindLine が読んだ WINDOW: の数 - 1

' pos の行（前後の空白と CR を除く）
Function Ab4D_LineAt$(text As String, ByVal pos As Long) As String
    Ab4D_LineAt$ = RadWnd_Strip$(Mid$(text, pos, FormDesign_LineEnd(text, pos) - pos))
End Function

' ITEM の行の名前（最初の欄）が name なら 1（大文字小文字は区別しない）
Function Ab4D_SameName(t As String, name As String) As Long
    Dim p As Long
    p = 1
    Ab4D_SameName = 0
    If Lower$(RadWnd_Field$(RadWnd_Val$(t), p)) = Lower$(name) Then Ab4D_SameName = 1
End Function

' 行 t が窓 w の kind の行か。cur は今いる窓（WINDOW: で進み、MENU: で -1）
Function Ab4D_LineHit(t As String, ByRef cur As Long, ByVal w As Long, ByVal kind As Long, name As String) As Long
    Ab4D_LineHit = 0
    Ab4D_LineWin(t, cur)
    If cur <> w Or cur < 0 Then Exit Function
    If kind = 0 And Lower$(Left$(t, 7)) = "window:" Then Ab4D_LineHit = 1
    If kind = 1 And RadWnd_Key$(t) = "size" Then Ab4D_LineHit = 1
    If kind = 2 And RadWnd_Key$(t) = "item" Then Ab4D_LineHit = Ab4D_SameName(t, name)
    If kind = 3 And Lower$(t) = "end" Then Ab4D_LineHit = 1
    If kind = 4 And RadWnd_Key$(t) = Lower$(name) And Lower$(Left$(t, 7)) <> "window:" Then Ab4D_LineHit = 1
End Function

' WINDOW: で窓の番号を進め、MENU: からは窓の外（-1）にする
Sub Ab4D_LineWin(t As String, ByRef cur As Long)
    If Lower$(Left$(t, 5)) = "menu:" Then cur = -1
    If Lower$(Left$(t, 7)) = "window:" Then g_a4Wn = g_a4Wn + 1 : cur = g_a4Wn
End Sub

' 窓 w（0 始まり）の kind の行の始まり（0: WINDOW:、1: SIZE、2: name の ITEM、3: END、4: キーが name の行）。無ければ 0
Function Ab4D_FindLine(text As String, ByVal w As Long, ByVal kind As Long, name As String) As Long
    Dim pos As Long, cur As Long
    Ab4D_FindLine = 0 : pos = 1 : cur = -1 : g_a4Wn = -1
    While pos <= Len(text)
        If Ab4D_LineHit(Ab4D_LineAt$(text, pos), cur, w, kind, name) <> 0 Then Ab4D_FindLine = pos
        If Ab4D_FindLine <> 0 Then Exit Function
        pos = FormDesign_LineEnd(text, pos) + 1
    Wend
End Function

' pos の行の = のあとの値を v に置き換える（行末の CR は残す）
Function Ab4D_ReplaceVal$(text As String, ByVal pos As Long, v As String) As String
    Dim a As Long, e As Long
    a = FormDesign_SkipBlank(text, InStr(pos, text, "=") + 1)
    e = FormDesign_LineEnd(text, pos)
    If e > a Then If Mid$(text, e - 1, 1) = Chr$(13) Then e = e - 1
    Ab4D_ReplaceVal$ = Left$(text, a - 1) & v & Mid$(text, e)
End Function

' ITEM の値の、x,y,幅,高さ を書き換えたもの（名前と、文字から後ろはそのまま）
Function Ab4D_ItemVal$(t As String, ByVal x As Long, ByVal y As Long, ByVal w As Long, ByVal h As Long) As String
    Dim v As String, p As Long, i As Long, name As String
    v = RadWnd_Val$(t) : p = 1
    name = RadWnd_Field$(v, p)
    For i = 1 To 4
        RadWnd_Field$(v, p)
    Next
    Ab4D_ItemVal$ = name & "," & FormDesign_Num$(x) & "," & FormDesign_Num$(y) & "," & FormDesign_Num$(w) & "," & FormDesign_Num$(h) & "," & Mid$(v, p)
End Function

' 窓 win の部品 name の位置と大きさを書いた本文。部品が無ければそのまま
Function Ab4D_SetItemRect$(text As String, ByVal win As Long, name As String, ByVal x As Long, ByVal y As Long, ByVal w As Long, ByVal h As Long) As String
    Dim pos As Long
    Ab4D_SetItemRect$ = text
    pos = Ab4D_FindLine(text, win, 2, name)
    If pos = 0 Then Exit Function
    Ab4D_SetItemRect$ = Ab4D_ReplaceVal$(text, pos, Ab4D_ItemVal$(Ab4D_LineAt$(text, pos), x, y, w, h))
End Function

' 窓 win の SIZE を w,h にした本文。SIZE の行が無ければ WINDOW: の次の行に足す。窓が無ければそのまま
Function Ab4D_SetWinSize$(text As String, ByVal win As Long, ByVal w As Long, ByVal h As Long) As String
    Dim pos As Long, v As String
    v = FormDesign_Num$(w) & "," & FormDesign_Num$(h)
    pos = Ab4D_FindLine(text, win, 1, "")
    If pos > 0 Then
        Ab4D_SetWinSize$ = Ab4D_ReplaceVal$(text, pos, v)
        Exit Function
    End If
    Ab4D_SetWinSize$ = Ab4D_AddSize$(text, Ab4D_FindLine(text, win, 0, ""), v)
End Function

' WINDOW: の行（pos）の次に「SIZE = v」の行を足す。pos が 0 ならそのまま
Function Ab4D_AddSize$(text As String, ByVal pos As Long, v As String) As String
    Dim e As Long
    Ab4D_AddSize$ = text
    If pos = 0 Then Exit Function
    e = FormDesign_LineEnd(text, pos)
    Ab4D_AddSize$ = Left$(text, e) & "    SIZE      = " & v & FormDesign_Nl$(text) & Mid$(text, e + 1)
End Function

' ---- 部品を足す・消す ----

Dim g_a4Added As String         ' Ab4D_AddItem$ が足した部品の名前

' 種類 1..16 の、名前の頭,文字の頭,様式,拡張様式,幅,高さ（AB 4.20 が新しい部品に付ける値）
Function Ab4D_DefTable$() As String
    Ab4D_DefTable$ = Ab4D_DefTableA$() & Ab4D_DefTableB$()
End Function

Function Ab4D_DefTableA$() As String
    Dim s As String
    s = "|CommandButton,Button,&H50000000,&H00000000,75,24|CheckBox,Check,&H50000003,&H00000000,90,16"
    s = s & "|ComboBox,,&H50200102,&H00000000,100,100|EditBox,,&H50000000,&H00000200,100,20"
    s = s & "|GroupBox,Group,&H50000007,&H00000000,120,80|HScrollBar,,&H50000000,&H00000000,100,17"
    Ab4D_DefTableA$ = s & "|ImageBox,,&H50000007,&H00000000,64,64|ListBox,,&H50200003,&H00000200,100,80"
End Function

Function Ab4D_DefTableB$() As String
    Dim s As String
    s = "|ListView,,&H50000000,&H00000200,120,80|RadioButton,Radio,&H50000009,&H00000000,90,16"
    s = s & "|Static,Text,&H50000000,&H00000000,50,12|TreeView,,&H50000000,&H00000200,120,80"
    s = s & "|VScrollBar,,&H50000001,&H00000000,17,100|UpDown,,&H50000000,&H00000000,17,40"
    Ab4D_DefTableB$ = s & "|ProgressBar,,&H50000000,&H00020000,120,20|TrackBar,,&H50000018,&H00000000,120,24|"
End Function

' s を sep で区切った n 番目（1 始まり）。無ければ ""
Function Ab4D_Nth$(s As String, sep As String, ByVal n As Long) As String
    Dim p As Long, e As Long
    Ab4D_Nth$ = ""
    p = Ab4D_NthPos(s, sep, n)
    If p = 0 Then Exit Function
    e = InStr(p, s, sep)
    If e = 0 Then e = Len(s) + 1
    Ab4D_Nth$ = Mid$(s, p, e - p)
End Function

' n 番目の欄の始まり（1 から。無ければ 0）
Function Ab4D_NthPos(s As String, sep As String, ByVal n As Long) As Long
    Dim i As Long, p As Long
    p = 1
    For i = 2 To n
        p = InStr(p, s, sep)
        If p = 0 Then Ab4D_NthPos = 0 : Exit Function
        p = p + Len(sep)
    Next
    Ab4D_NthPos = p
End Function

' 種類 t の k 番目の値（1 名前の頭、2 文字の頭、3 様式、4 拡張様式、5 幅、6 高さ）
Function Ab4D_Def$(ByVal t As Long, ByVal k As Long) As String
    Ab4D_Def$ = Ab4D_Nth$(Ab4D_Nth$(Ab4D_DefTable$(), "|", t + 1), ",", k)
End Function

Function Ab4D_DefW(ByVal t As Long) As Long
    Ab4D_DefW = Val(Ab4D_Def$(t, 5))
End Function

Function Ab4D_DefH(ByVal t As Long) As Long
    Ab4D_DefH = Val(Ab4D_Def$(t, 6))
End Function

' 窓 win（RadWnd_Parse 済み）に無い、種類 t の名前（頭 + 1 からの番号）
Function Ab4D_NextName$(ByVal win As Long, ByVal t As Long) As String
    Dim n As Long
    n = 1
    While RadWnd_FindItem(win, Ab4D_Def$(t, 1) & FormDesign_Num$(n)) >= 0
        n = n + 1
    Wend
    Ab4D_NextName$ = Ab4D_Def$(t, 1) & FormDesign_Num$(n)
End Function

' 新しい部品の ITEM の行（改行なし）。文字は頭 + 名前と同じ番号。ImageBox は ,0,"" を足す
Function Ab4D_ItemLine$(name As String, ByVal t As Long, ByVal x As Long, ByVal y As Long, ByVal w As Long, ByVal h As Long) As String
    Dim cap As String, q As String, s As String
    q = Chr$(34)
    cap = Ab4D_Def$(t, 2)
    If Len(cap) > 0 Then cap = cap & Mid$(name, Len(Ab4D_Def$(t, 1)) + 1)
    s = "    ITEM      = " & name & "," & FormDesign_Num$(x) & "," & FormDesign_Num$(y) & "," & FormDesign_Num$(w) & "," & FormDesign_Num$(h)
    s = s & "," & q & cap & q & "," & Ab4D_Def$(t, 3) & "," & Ab4D_Def$(t, 4) & "," & FormDesign_Num$(t)
    If t = 7 Then s = s & ",0," & q & q
    Ab4D_ItemLine$ = s
End Function

' 窓 win の END の前に、種類 t の部品（x, y に w x h）を足した本文。名前は Ab4D_LastAdded$
Function Ab4D_AddItemRect$(text As String, ByVal win As Long, ByVal t As Long, ByVal x As Long, ByVal y As Long, ByVal w As Long, ByVal h As Long) As String
    Dim pos As Long
    Ab4D_AddItemRect$ = text
    RadWnd_Parse(text)
    g_a4Added = Ab4D_NextName$(win, t)
    pos = Ab4D_FindLine(text, win, 3, "")
    If pos = 0 Then Exit Function
    Ab4D_AddItemRect$ = Left$(text, pos - 1) & Ab4D_ItemLine$(g_a4Added, t, x, y, w, h) & FormDesign_Nl$(text) & Mid$(text, pos)
End Function

' 既定の大きさで足す
Function Ab4D_AddItem$(text As String, ByVal win As Long, ByVal t As Long, ByVal x As Long, ByVal y As Long) As String
    Ab4D_AddItem$ = Ab4D_AddItemRect$(text, win, t, x, y, Ab4D_DefW(t), Ab4D_DefH(t))
End Function

Function Ab4D_LastAdded$() As String
    Ab4D_LastAdded$ = g_a4Added
End Function

' 窓 win の部品 name の行を消した本文。無ければそのまま
Function Ab4D_DelItem$(text As String, ByVal win As Long, name As String) As String
    Dim pos As Long
    Ab4D_DelItem$ = text
    pos = Ab4D_FindLine(text, win, 2, name)
    If pos = 0 Then Exit Function
    Ab4D_DelItem$ = Left$(text, pos - 1) & Mid$(text, FormDesign_LineEnd(text, pos) + 1)
End Function
