' EditorBuildAB2 - Basic メニューの「ActiveBasic2構文 (-pAB2)」
' 選ぶと actba64 に -pAB2 を付けて訳す（32bit / 64bit とは別に入り切りする）。
' -pN88 とは同時に選べない。片方を入れると、もう片方は外れる。

Const IDM_SYNTAXAB2 = 1310

Dim g_buildAB2 As Long
Dim g_buildAB2Menu As Long

Function EditorBuild_IsAB2() As Long
    EditorBuild_IsAB2 = g_buildAB2
End Function

Function EditorBuild_AB2Opt$() As String
    EditorBuild_AB2Opt$ = ""
    If g_buildAB2 <> 0 Then EditorBuild_AB2Opt$ = " -pAB2"
End Function

' 0 なら 1、それ以外なら 0
Function EditorBuild_Flip(v As Long) As Long
    EditorBuild_Flip = 0
    If v = 0 Then EditorBuild_Flip = 1
End Function

Sub EditorBuild_ToggleAB2()
    g_buildAB2 = EditorBuild_Flip(g_buildAB2)
    If g_buildAB2 <> 0 Then g_buildN88 = 0
    EditorBuild_SyntaxChanged()
End Sub

Sub EditorBuild_ToggleN88()
    g_buildN88 = EditorBuild_Flip(g_buildN88)
    If g_buildN88 <> 0 Then g_buildAB2 = 0
    EditorBuild_SyntaxChanged()
End Sub

' 構文を切り替えたあと: 覚えて、チェックと題名を直す
Sub EditorBuild_SyntaxChanged()
    EditorBuild_SaveTarget()
    EditorBuild_UpdateTargetMenu()
    EditorDoc_UpdateFrameTitle()
End Sub

' Basic メニューの構文の項目なら切り替えて 1
Function EditorBuild_SyntaxCmd(id As Long) As Long
    EditorBuild_SyntaxCmd = 1
    If id = IDM_SYNTAXN88 Then EditorBuild_ToggleN88()
    If id = IDM_SYNTAXAB2 Then EditorBuild_ToggleAB2()
    If id <> IDM_SYNTAXN88 And id <> IDM_SYNTAXAB2 Then EditorBuild_SyntaxCmd = 0
End Function

' ---- メニュー ----

' N88BASIC 構文の次（実行の前）に差し込む。2 回目からは表示名だけ更新
Sub EditorBuild_ApplyAB2Menu()
    If g_buildAB2Menu = 0 Then EditorBuild_InsertAB2Menu()
    EditorMenu_SetCmd(hMenu_M_MAIN_2, IDM_SYNTAXAB2, UI_MENU_SYNTAXAB2)
    EditorBuild_CheckAB2Menu()
End Sub

Sub EditorBuild_InsertAB2Menu()
    Dim wide As *Byte
    Dim chars As Long
    wide = Enc_Utf8ToWide(UiText$(UI_MENU_SYNTAXAB2), chars)
    If wide = 0 Then Exit Sub
    InsertMenuW(hMenu_M_MAIN_2, IDM_RUN, MF_BYCOMMAND Or MF_STRING, IDM_SYNTAXAB2, wide)
    free(wide)
    g_buildAB2Menu = 1
End Sub

Sub EditorBuild_CheckAB2Menu()
    Dim flags As Long
    If g_buildAB2Menu = 0 Then Exit Sub
    flags = MF_BYCOMMAND
    If g_buildAB2 <> 0 Then flags = flags Or MF_CHECKED
    CheckMenuItem(hMenu_M_MAIN_2, IDM_SYNTAXAB2, flags)
End Sub

' ---- 設定ファイル（editor.target の "64" / "32" の後ろに " ab2"）----

Function EditorBuild_AB2Tag$() As String
    EditorBuild_AB2Tag$ = ""
    If g_buildAB2 <> 0 Then EditorBuild_AB2Tag$ = " ab2"
End Function

Sub EditorBuild_LoadAB2(s As String)
    g_buildAB2 = 0
    If Mid$(s, 4, 3) = "ab2" Then g_buildAB2 = 1
    If g_buildAB2 <> 0 Then g_buildN88 = 0
End Sub
