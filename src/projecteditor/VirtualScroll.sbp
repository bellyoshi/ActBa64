Const VS_LINE_HEIGHT = 18
Const VS_MARGIN_X = 10
Const VS_MARGIN_Y = 10

Dim g_viewTopLine As Long

Sub VirtualScroll_Init()
    g_viewTopLine = 1
End Sub

Function VirtualScroll_VisibleRows(hWnd As HWND) As Long
    Dim rc As RECT
    Dim rows As Long

    GetClientRect(hWnd, rc)
    rows = (rc.bottom - rc.top - VS_MARGIN_Y) \ VS_LINE_HEIGHT
    If rows < 1 Then rows = 1
    VirtualScroll_VisibleRows = rows
End Function

Sub VirtualScroll_Clamp(hWnd As HWND)
    Dim lineCount As Long
    Dim visibleRows As Long
    Dim maxTop As Long

    lineCount = TextBuf_LineCount()
    visibleRows = VirtualScroll_VisibleRows(hWnd)
    maxTop = lineCount - visibleRows + 1
    If maxTop < 1 Then maxTop = 1

    If g_viewTopLine < 1 Then g_viewTopLine = 1
    If g_viewTopLine > maxTop Then g_viewTopLine = maxTop
End Sub

Sub VirtualScroll_By(hWnd As HWND, ByVal deltaLines As Long)
    g_viewTopLine = g_viewTopLine + deltaLines
    VirtualScroll_Clamp(hWnd)
End Sub

Sub VirtualScroll_EnsureCursorVisible(hWnd As HWND)
    Dim curLine As Long
    Dim visibleRows As Long
    Dim bottom As Long

    curLine = TextBuf_CursorLine()
    visibleRows = VirtualScroll_VisibleRows(hWnd)
    bottom = g_viewTopLine + visibleRows - 1

    If curLine < g_viewTopLine Then
        g_viewTopLine = curLine
    ElseIf curLine > bottom Then
        g_viewTopLine = curLine - visibleRows + 1
    End If

    VirtualScroll_Clamp(hWnd)
End Sub
