' テキスト編集エリアの右クリック コンテキストメニュー

Sub EditorContext_Show(hWnd As HWND, ByVal lParam As LPARAM)
    Dim hPop As HMENU
    Dim pt As POINTAPI
    Dim x As Long
    Dim y As Long
    Dim cmd As Long
    Dim kw As String
    Dim flags As Long
    Dim helpCap As String

    pt.x = 0
    pt.y = 0
    If GetCursorPos(pt) <> 0 Then
        x = pt.x
        y = pt.y
    Else
        x = LOWORD(lParam)
        y = (lParam \ 65536) And 65535
        If x >= 32768 Then x = x - 65536
        If y >= 32768 Then y = y - 65536
        If x < 0 Or y < 0 Then
            x = 200
            y = 200
        End If
    End If

    hPop = CreatePopupMenu()
    If hPop = 0 Then Exit Sub

    AppendMenu(hPop, MF_STRING, IDM_UNDO, "元に戻す(&U)")
    AppendMenu(hPop, MF_SEPARATOR, 0, "")
    AppendMenu(hPop, MF_STRING, IDM_CUT, "切り取り(&T)")
    AppendMenu(hPop, MF_STRING, IDM_COPY, "コピー(&C)")
    If IsClipboardFormatAvailable(CF_TEXT) <> 0 Then
        flags = MF_STRING
    Else
        flags = MF_STRING Or MF_GRAYED
    End If
    AppendMenu(hPop, flags, IDM_PASTE, "貼り付け(&P)")
    AppendMenu(hPop, MF_STRING, IDM_DELETE, "削除(&D)")
    AppendMenu(hPop, MF_SEPARATOR, 0, "")
    AppendMenu(hPop, MF_STRING, IDM_SELECTALL, "すべて選択(&A)")
    AppendMenu(hPop, MF_SEPARATOR, 0, "")
    AppendMenu(hPop, MF_STRING, IDM_HELP_ACTBA64, "actba64 言語リファレンス")
    kw = EditorHelp_KeywordAtCursor$()
    If Len(kw) > 0 Then
        helpCap = "Keyword help"
        AppendMenu(hPop, MF_STRING, IDM_HELP_KEYWORD, helpCap)
    End If

    cmd = TrackPopupMenu(hPop, TPM_LEFTALIGN Or TPM_RIGHTBUTTON Or TPM_RETURNCMD, x, y, 0, hWnd, ByVal 0)
    DestroyMenu(hPop)

    If cmd = IDM_UNDO Then
        MainWnd_IDM_UNDO_MenuClick()
    ElseIf cmd = IDM_CUT Then
        MainWnd_IDM_CUT_MenuClick()
    ElseIf cmd = IDM_COPY Then
        MainWnd_IDM_COPY_MenuClick()
    ElseIf cmd = IDM_PASTE Then
        MainWnd_IDM_PASTE_MenuClick()
    ElseIf cmd = IDM_DELETE Then
        MainWnd_IDM_DELETE_MenuClick()
    ElseIf cmd = IDM_SELECTALL Then
        MainWnd_IDM_SELECTALL_MenuClick()
    ElseIf cmd = IDM_HELP_KEYWORD Then
        EditorHelp_Show(kw)
    ElseIf cmd = IDM_HELP_ACTBA64 Then
        EditorHelp_Show("")
    End If
End Sub
