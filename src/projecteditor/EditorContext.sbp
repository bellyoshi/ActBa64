Sub EditorContext_Show(hWnd As HWND, ByVal lParam As LPARAM)
    Dim hPop As HMENU
    Dim x As Long
    Dim y As Long
    Dim cmd As Long
    Dim kw As String

    EditorContext_GetPos(lParam, x, y)
    hPop = CreatePopupMenu()
    If hPop = 0 Then Exit Sub

    kw = EditorHelp_KeywordAtCursor$()
    EditorContext_BuildMenu(hPop, kw)
    cmd = TrackPopupMenu(hPop, TPM_LEFTALIGN Or TPM_RIGHTBUTTON Or TPM_RETURNCMD, x, y, 0, hWnd, ByVal 0)
    DestroyMenu(hPop)
    EditorContext_Dispatch(cmd, kw)
End Sub

Sub EditorContext_GetPos(ByVal lParam As LPARAM, ByRef x As Long, ByRef y As Long)
    Dim pt As POINTAPI
    pt.x = 0
    pt.y = 0
    If GetCursorPos(pt) <> 0 Then
        x = pt.x
        y = pt.y
        Exit Sub
    End If
    x = LOWORD(lParam)
    y = (lParam \ 65536) And 65535
    If x >= 32768 Then x = x - 65536
    If y >= 32768 Then y = y - 65536
    If x < 0 Or y < 0 Then
        x = 200
        y = 200
    End If
End Sub

Sub EditorContext_BuildMenu(hPop As HMENU, kw As String)
    Dim flags As Long
    EditorMenu_Append(hPop, MF_STRING, IDM_UNDO, UI_MENU_UNDO)
    AppendMenu(hPop, MF_SEPARATOR, 0, "")
    EditorMenu_Append(hPop, MF_STRING, IDM_CUT, UI_MENU_CUT)
    EditorMenu_Append(hPop, MF_STRING, IDM_COPY, UI_MENU_COPY)
    If IsClipboardFormatAvailable(CF_UNICODETEXT) <> 0 Or IsClipboardFormatAvailable(CF_TEXT) <> 0 Then
        flags = MF_STRING
    Else
        flags = MF_STRING Or MF_GRAYED
    End If
    EditorMenu_Append(hPop, flags, IDM_PASTE, UI_MENU_PASTE)
    EditorMenu_Append(hPop, MF_STRING, IDM_DELETE, UI_MENU_DELETE)
    AppendMenu(hPop, MF_SEPARATOR, 0, "")
    EditorMenu_Append(hPop, MF_STRING, IDM_SELECTALL, UI_MENU_SELECTALL)
    AppendMenu(hPop, MF_SEPARATOR, 0, "")
    EditorMenu_Append(hPop, MF_STRING, IDM_HELP_ACTBA64, UI_MENU_HELP_ACTBA)
    If Len(kw) > 0 Then
        EditorMenu_Append(hPop, MF_STRING, IDM_HELP_KEYWORD, UI_MENU_CTX_HELP_KW)
    End If
End Sub

Sub EditorContext_Dispatch(ByVal cmd As Long, kw As String)
    If cmd = IDM_UNDO Then
        MainWnd_IDM_UNDO_MenuClick()
    ElseIf cmd = IDM_CUT Then
        MainWnd_IDM_CUT_MenuClick()
    ElseIf cmd = IDM_COPY Then
        MainWnd_IDM_COPY_MenuClick()
    ElseIf cmd = IDM_PASTE Then
        MainWnd_IDM_PASTE_MenuClick()
    ElseIf cmd = IDM_DELETE Then
        MainWnd_IDM_DELETE_MenuClick()
    ElseIf cmd = IDM_SELECTALL Then
        MainWnd_IDM_SELECTALL_MenuClick()
    ElseIf cmd = IDM_HELP_KEYWORD Then
        EditorHelp_Show(kw)
    ElseIf cmd = IDM_HELP_ACTBA64 Then
        EditorHelp_Show("")
    End If
End Sub
