Function EditorBuild_CompileCmd$(actba As String) As String
    Dim cmd As String
    cmd = EditorBuild_QuoteArg$(actba) + EditorBuild_TargetOpt$()
    EditorBuild_CompileCmd$ = cmd + " " + EditorBuild_CompileArgs$()
End Function

Function EditorBuild_DoCompile(hWnd As HWND) As Long
    Dim actba As String
    Dim toolName As String
    EditorBuild_DoCompile = 0
    toolName = EditorBuild_CompilerName$()
    actba = EditorBuild_CompilerPath$()
    If ProjSaveForBuild(hWnd) = 0 Then Exit Function
    If EditorBuild_BeginCompile(hWnd, actba, toolName) = 0 Then Exit Function
    EditorBuild_DoCompile = EditorBuild_RunCompiler(actba, toolName)
End Function

Function EditorBuild_BeginCompile(hWnd As HWND, actba As String, toolName As String) As Long
    Dim head As String
    EditorBuild_BeginCompile = 0
    MessageWnd_Open(hWnd)
    head = "Compiling (" + EditorBuild_TargetLabel$() + ") with " + toolName
    head = head + EditorBuild_TargetOpt$() + "..." + Chr$(13) + Chr$(10)
    MessageWnd_SetText(head)
    EditorBuild_BeginCompile = EditorBuild_EnsureCompiler(actba, toolName)
End Function

Function EditorBuild_RunCompiler(actba As String, toolName As String) As Long
    Dim cmd As String
    Dim exitCode As Long
    Dim outText As String
    EditorBuild_RunCompiler = 0
    cmd = EditorBuild_CompileCmd$(actba)
    If EditorBuild_CaptureCompile(cmd, toolName, outText, exitCode) = 0 Then Exit Function
    EditorBuild_RunCompiler = EditorBuild_ApplyCompile(outText, exitCode)
End Function

Function EditorBuild_CaptureCompile(cmd As String, toolName As String, ByRef outText As String, ByRef exitCode As Long) As Long
    EditorBuild_CaptureCompile = 0
    If EditorBuild_RunCapture(cmd, outText, exitCode) = 0 Then
        MessageWnd_SetText("Failed to launch " + toolName + "." + Chr$(13) + Chr$(10))
        Exit Function
    End If
    EditorBuild_CaptureCompile = 1
End Function

Function EditorBuild_ApplyCompile(outText As String, ByVal exitCode As Long) As Long
    EditorBuild_ApplyCompile = 0
    MessageWnd_SetText(EditorBuild_FormatResult$(outText, exitCode))
    If exitCode = 0 Then EditorBuild_ApplyCompile = 1
End Function

Function EditorBuild_EnsureCompiler(actba As String, toolName As String) As Long
    Dim attr As Long
    EditorBuild_EnsureCompiler = 0
    attr = GetFileAttributes(StrPtr(actba))
    If attr <> -1 Then
        EditorBuild_EnsureCompiler = 1
        Exit Function
    End If
    EditorBuild_ReportMissing(toolName)
End Function

Sub EditorBuild_ReportMissing(toolName As String)
    Dim msg As String
    msg = "Failed to find " + toolName + " (place beside editor.exe)."
    msg = msg + Chr$(13) + Chr$(10)
    MessageWnd_SetText(msg)
End Sub
