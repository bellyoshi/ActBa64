' actba64 言語リファレンス（HTML）を既定ブラウザで開く

Function EditorHelp_IsIdentChar(ByVal c As Long) As Long
    EditorHelp_IsIdentChar = 0
    If c >= 48 And c <= 57 Then EditorHelp_IsIdentChar = 1
    If c >= 65 And c <= 90 Then EditorHelp_IsIdentChar = 1
    If c >= 97 And c <= 122 Then EditorHelp_IsIdentChar = 1
    If c = 95 Or c = 36 Or c = 35 Then EditorHelp_IsIdentChar = 1
End Function

Function EditorHelp_LowerCopy$(s As String) As String
    Dim n As Long
    Dim i As Long
    Dim c As Byte
    Dim out As *Byte
    Dim bp As *Byte

    EditorHelp_LowerCopy$ = ""
    n = Len(s)
    If n <= 0 Then Exit Function
    out = malloc(n + 1)
    If out = 0 Then Exit Function
    bp = StrPtr(s)
    For i = 0 To n - 1
        c = bp[i]
        If c >= 65 And c <= 90 Then c = c + 32
        out[i] = c
    Next
    out[n] = 0
    EditorHelp_LowerCopy$ = Enc_DupCStr$(out, n)
    free(out)
End Function

Function EditorHelp_KeywordAtCursor$() As String
    Dim lineNo As Long
    Dim lineText As String
    Dim lineStart As Long
    Dim col As Long
    Dim n As Long
    Dim identStart As Long
    Dim identEnd As Long
    Dim bp As *Byte

    EditorHelp_KeywordAtCursor$ = ""
    lineNo = TextBuf_CursorLine()
    lineText = TextBuf_GetLineText$(lineNo)
    n = Len(lineText)
    If n <= 0 Then Exit Function
    lineStart = TextBuf_GetLineStart(lineNo)
    col = TextBuf_CursorIndex() - lineStart
    If col < 0 Then col = 0
    If col > n Then col = n
    If col = n And col > 0 Then col = col - 1
    bp = StrPtr(lineText)
    col = EditorHelp_SnapIdentCol(bp, col, n)
    If col < 0 Then Exit Function
    identStart = EditorHelp_IdentStart(bp, col)
    identEnd = EditorHelp_IdentEnd(bp, col, n)
    EditorHelp_KeywordAtCursor$ = EditorHelp_SliceBytes$(bp, identStart, identEnd - identStart)
End Function

Function EditorHelp_SnapIdentCol(bp As *Byte, ByVal col As Long, ByVal n As Long) As Long
    EditorHelp_SnapIdentCol = -1
    If EditorHelp_IsIdentChar(bp[col]) <> 0 Then
        EditorHelp_SnapIdentCol = col
        Exit Function
    End If
    If col > 0 Then
        If EditorHelp_IsIdentChar(bp[col - 1]) <> 0 Then
            EditorHelp_SnapIdentCol = col - 1
        End If
    End If
End Function

Function EditorHelp_IdentStart(bp As *Byte, ByVal col As Long) As Long
    Dim identStart As Long
    identStart = col
    While identStart > 0
        If EditorHelp_IsIdentChar(bp[identStart - 1]) = 0 Then Exit While
        identStart = identStart - 1
    Wend
    EditorHelp_IdentStart = identStart
End Function

Function EditorHelp_IdentEnd(bp As *Byte, ByVal col As Long, ByVal n As Long) As Long
    Dim identEnd As Long
    identEnd = col + 1
    While identEnd < n
        If EditorHelp_IsIdentChar(bp[identEnd]) = 0 Then Exit While
        identEnd = identEnd + 1
    Wend
    EditorHelp_IdentEnd = identEnd
End Function

Function EditorHelp_SliceBytes$(bp As *Byte, ByVal startOff As Long, ByVal byteLen As Long) As String
    Dim out As *Byte
    Dim i As Long
    EditorHelp_SliceBytes$ = ""
    If byteLen <= 0 Then Exit Function
    out = malloc(byteLen + 1)
    If out = 0 Then Exit Function
    For i = 0 To byteLen - 1
        out[i] = bp[startOff + i]
    Next
    out[byteLen] = 0
    EditorHelp_SliceBytes$ = Enc_DupCStr$(out, byteLen)
    free(out)
End Function

Function EditorHelp_Anchor$(keyword As String) As String
    Dim kw As String
    Dim bp As *Byte
    EditorHelp_Anchor$ = ""
    kw = EditorHelp_LowerCopy$(keyword)
    If Len(kw) = 0 Then Exit Function
    bp = StrPtr(kw)
    If bp <> 0 Then
        If bp[0] = 35 Then kw = Mid$(kw, 2)
    End If
    EditorHelp_Anchor$ = EditorHelp_AnchorLookup$(kw)
End Function

Function EditorHelp_AnchorLookup$(kw As String) As String
    Dim out As String
    out = ""
    If kw = "byte" Then out = "byte"
    If kw = "word" Then out = "word"
    If kw = "long" Then out = "long"
    If kw = "dword" Then out = "dword"
    If kw = "integer" Then out = "integer"
    If kw = "string" Then out = "string"
    If kw = "handle" Then out = "handle"
    If kw = "hwnd" Or kw = "hdc" Or kw = "hmenu" Or kw = "hfont" Or kw = "hinstance" Or kw = "hicon" Or kw = "hbrush" Or kw = "hbitmap" Or kw = "hcursor" Or kw = "hpen" Or kw = "hrgn" Or kw = "hkey" Or kw = "hdrop" Then out = "hwnd"
    If kw = "voidptr" Or kw = "byteptr" Or kw = "lpstr" Or kw = "lpcstr" Then out = "voidptr"
    If kw = "long_ptr" Or kw = "ulong_ptr" Or kw = "longptr" Or kw = "ulongptr" Then out = "long_ptr"
    If kw = "wparam" Or kw = "lparam" Or kw = "lresult" Then out = "wparam"
    If kw = "longlong" Or kw = "qword" Or kw = "dword64" Or kw = "qword64" Then out = "longlong"
    EditorHelp_AnchorLookupKw2(kw, out)
    EditorHelp_AnchorLookup$ = out
End Function

Sub EditorHelp_AnchorLookupKw2(kw As String, ByRef out As String)
    If kw = "typedef" Then out = "typedef"
    If kw = "type" Then out = "type"
    If kw = "dim" Then out = "dim"
    If kw = "const" Then out = "const"
    If kw = "declare" Then out = "declare"
    If kw = "lib" Then out = "lib"
    If kw = "alias" Then out = "alias"
    If kw = "byval" Then out = "byval"
    If kw = "byref" Then out = "byref"
    If kw = "function" Then out = "function"
    If kw = "sub" Then out = "sub"
    If kw = "if" Or kw = "then" Or kw = "else" Or kw = "elseif" Then out = "if"
    If kw = "select" Or kw = "case" Then out = "select"
    If kw = "while" Or kw = "wend" Then out = "while"
    If kw = "for" Or kw = "to" Or kw = "next" Then out = "for"
    If kw = "do" Or kw = "loop" Then out = "do"
    If kw = "print" Then out = "print"
    If kw = "input" Then out = "input"
    If kw = "sleep" Then out = "sleep"
    If kw = "end" Then out = "end"
    If kw = "and" Or kw = "or" Then out = "and"
    EditorHelp_AnchorLookupKw3(kw, out)
End Sub

Sub EditorHelp_AnchorLookupKw3(kw As String, ByRef out As String)
    If kw = "varptr" Then out = "varptr"
    If kw = "sizeof" Then out = "sizeof"
    If kw = "addressof" Then out = "addressof"
    If kw = "left$" Or kw = "left" Or kw = "mid$" Or kw = "mid" Then out = "left$"
    If kw = "right$" Or kw = "right" Then out = "right$"
    If kw = "chr$" Or kw = "chr" Then out = "chr$"
    If kw = "rgb" Then out = "rgb"
    If kw = "loword" Then out = "loword"
    If kw = "include" Then out = "include"
    If kw = "usewindow" Then out = "usewindow"
    If kw = "console" Then out = "console"
    If kw = "strict" Then out = "strict"
    If kw = "source" Then out = "source"
    If kw = "n88basic" Or kw = "n88" Or kw = "prompt" Then out = "n88basic"
    If kw = "line" Or kw = "bf" Then out = "line"
    If kw = "circle" Then out = "circle"
    If kw = "locate" Then out = "locate"
    If kw = "paint" Then out = "paint"
    If kw = "class" Then out = "class"
    If kw = "math" Or kw = "mathdiv" Or kw = "mathmod" Or kw = "math_one" Or kw = "math_pi" Or kw = "math_hpi" Or kw = "math_pi2" Or kw = "math_e" Or kw = "degtorad" Or kw = "radtodeg" Then out = "math"
    If kw = "sin" Or kw = "cos" Or kw = "tan" Or kw = "sindeg" Or kw = "cosdeg" Then out = "sin"
    If kw = "sqr" Then out = "sqr"
    If kw = "abs" Or kw = "sgn" Or kw = "min" Or kw = "max" Then out = "abs"
    If kw = "atn" Then out = "atn"
    If kw = "exp" Then out = "exp"
    If kw = "insmenu" Then out = "insmenu"
    If kw = "malloc" Or kw = "calloc" Or kw = "free" Or kw = "memcpy" Or kw = "fillmemory" Then out = "varptr"
    If kw = "len" Or kw = "asc" Or kw = "str$" Or kw = "str" Or kw = "strptr" Or kw = "makestr" Or kw = "makeintresource" Then out = "varptr"
    If kw = "actba64" Then out = "overview"
End Sub

Function EditorHelp_FileExists(path As String) As Long
    Dim attrs As Long
    EditorHelp_FileExists = 0
    attrs = GetFileAttributes(path)
    If attrs <> -1 Then EditorHelp_FileExists = 1
End Function

Function EditorHelp_FindPath$() As String
    Dim dir As String
    Dim path As String

    EditorHelp_FindPath$ = ""
    dir = EditorBuild_ExeDir$()
    If Len(dir) > 0 Then
        path = dir + "help\actba64_ref.html"
        If EditorHelp_FileExists(path) <> 0 Then
            EditorHelp_FindPath$ = path
            Exit Function
        End If
        path = dir + "..\help\actba64_ref.html"
        If EditorHelp_FileExists(path) <> 0 Then
            EditorHelp_FindPath$ = path
            Exit Function
        End If
    End If
    path = "help\actba64_ref.html"
    If EditorHelp_FileExists(path) <> 0 Then EditorHelp_FindPath$ = path
End Function

Function EditorHelp_ToFileUrl$(path As String, anchor As String) As String
    Dim n As Long
    Dim i As Long
    Dim c As Byte
    Dim bp As *Byte
    Dim out As *Byte
    Dim url As String

    EditorHelp_ToFileUrl$ = ""
    n = Len(path)
    If n <= 0 Then Exit Function
    out = malloc(n + 16)
    If out = 0 Then Exit Function
    bp = StrPtr(path)
    out[0] = 102
    out[1] = 105
    out[2] = 108
    out[3] = 101
    out[4] = 58
    out[5] = 47
    out[6] = 47
    out[7] = 47
    For i = 0 To n - 1
        c = bp[i]
        If c = 92 Then c = 47
        out[8 + i] = c
    Next
    out[8 + n] = 0
    url = Enc_DupCStr$(out, 8 + n)
    free(out)
    If Len(anchor) > 0 Then url = url + "#" + anchor
    EditorHelp_ToFileUrl$ = url
End Function

Sub EditorHelp_Show(keyword As String)
    Dim path As String
    Dim url As String
    Dim anchor As String
    Dim msg As String
    Dim title As String
    Dim r As HINSTANCE

    path = EditorHelp_FindPath$()
    If Len(path) = 0 Then
        msg = UiText$(UI_HELP_NOT_FOUND)
        title = UiText$(UI_HELP_TITLE)
        UiMsgBox(hMainWnd, msg, title)
        Exit Sub
    End If
    anchor = EditorHelp_Anchor$(keyword)
    url = EditorHelp_ToFileUrl$(path, anchor)
    r = ShellExecute(hMainWnd, "open", url, "", "", SW_SHOWNORMAL)
    If r <= 32 Then
        r = ShellExecute(hMainWnd, "open", path, "", "", SW_SHOWNORMAL)
        If r <= 32 Then
            msg = UiText$(UI_HELP_OPEN_FAILED) + path
            title = UiText$(UI_HELP_TITLE)
            UiMsgBox(hMainWnd, msg, title)
        End If
    End If
End Sub

