' actba64 言語リファレンス（HTML）を既定ブラウザで開く

Function EditorHelp_IsIdentChar(ByVal c As Long) As Long
    EditorHelp_IsIdentChar = 0
    If c >= 48 And c <= 57 Then EditorHelp_IsIdentChar = 1
    If c >= 65 And c <= 90 Then EditorHelp_IsIdentChar = 1
    If c >= 97 And c <= 122 Then EditorHelp_IsIdentChar = 1
    If c = 95 Or c = 36 Or c = 35 Then EditorHelp_IsIdentChar = 1
End Function

Function EditorHelp_LowerCopy$(s As String) As String
    Dim n As Long
    Dim i As Long
    Dim c As Byte
    Dim out As *Byte
    Dim sp As *Byte

    EditorHelp_LowerCopy$ = ""
    n = Len(s)
    If n <= 0 Then Exit Function
    out = malloc(n + 1)
    If out = 0 Then Exit Function
    sp = StrPtr(s)
    For i = 0 To n - 1
        c = sp[i]
        If c >= 65 And c <= 90 Then c = c + 32
        out[i] = c
    Next
    out[n] = 0
    EditorHelp_LowerCopy$ = MakeStr(out)
    free(out)
End Function

Function EditorHelp_KeywordAtCursor$() As String
    Dim lineNo As Long
    Dim lineText As String
    Dim s As Long
    Dim col As Long
    Dim n As Long
    Dim i As Long
    Dim a As Long
    Dim b As Long
    Dim c As Long
    Dim sp As *Byte
    Dim out As *Byte
    Dim klen As Long

    EditorHelp_KeywordAtCursor$ = ""
    lineNo = TextBuf_CursorLine()
    lineText = TextBuf_GetLineText$(lineNo)
    n = Len(lineText)
    If n <= 0 Then Exit Function
    s = TextBuf_GetLineStart(lineNo)
    col = TextBuf_CursorIndex() - s
    If col < 0 Then col = 0
    If col > n Then col = n
    If col = n And col > 0 Then col = col - 1
    sp = StrPtr(lineText)
    If EditorHelp_IsIdentChar(sp[col]) = 0 Then
        If col > 0 Then
            If EditorHelp_IsIdentChar(sp[col - 1]) <> 0 Then
                col = col - 1
            Else
                Exit Function
            End If
        Else
            Exit Function
        End If
    End If
    a = col
    While a > 0
        If EditorHelp_IsIdentChar(sp[a - 1]) = 0 Then
            Exit While
        End If
        a = a - 1
    Wend
    b = col + 1
    While b < n
        If EditorHelp_IsIdentChar(sp[b]) = 0 Then
            Exit While
        End If
        b = b + 1
    Wend
    klen = b - a
    If klen <= 0 Then Exit Function
    out = malloc(klen + 1)
    If out = 0 Then Exit Function
    For i = 0 To klen - 1
        out[i] = sp[a + i]
    Next
    out[klen] = 0
    EditorHelp_KeywordAtCursor$ = MakeStr(out)
    free(out)
End Function

Function EditorHelp_Anchor$(keyword As String) As String
    Dim k As String
    Dim sp As *Byte

    EditorHelp_Anchor$ = ""
    k = EditorHelp_LowerCopy$(keyword)
    If Len(k) = 0 Then Exit Function
    sp = StrPtr(k)
    If sp <> 0 Then
        If sp[0] = 35 Then k = Mid$(k, 2)
    End If
    If k = "byte" Then EditorHelp_Anchor$ = "byte"
    If k = "word" Then EditorHelp_Anchor$ = "word"
    If k = "long" Then EditorHelp_Anchor$ = "long"
    If k = "dword" Then EditorHelp_Anchor$ = "dword"
    If k = "integer" Then EditorHelp_Anchor$ = "integer"
    If k = "string" Then EditorHelp_Anchor$ = "string"
    If k = "handle" Then EditorHelp_Anchor$ = "handle"
    If k = "hwnd" Or k = "hdc" Or k = "hmenu" Or k = "hfont" Or k = "hinstance" Or k = "hicon" Or k = "hbrush" Or k = "hbitmap" Or k = "hcursor" Or k = "hpen" Or k = "hrgn" Or k = "hkey" Or k = "hdrop" Then EditorHelp_Anchor$ = "hwnd"
    If k = "voidptr" Or k = "byteptr" Or k = "lpstr" Or k = "lpcstr" Then EditorHelp_Anchor$ = "voidptr"
    If k = "long_ptr" Or k = "ulong_ptr" Or k = "longptr" Or k = "ulongptr" Then EditorHelp_Anchor$ = "long_ptr"
    If k = "wparam" Or k = "lparam" Or k = "lresult" Then EditorHelp_Anchor$ = "wparam"
    If k = "longlong" Or k = "qword" Or k = "dword64" Or k = "qword64" Then EditorHelp_Anchor$ = "longlong"
    If k = "typedef" Then EditorHelp_Anchor$ = "typedef"
    If k = "type" Then EditorHelp_Anchor$ = "type"
    If k = "dim" Then EditorHelp_Anchor$ = "dim"
    If k = "const" Then EditorHelp_Anchor$ = "const"
    If k = "declare" Then EditorHelp_Anchor$ = "declare"
    If k = "lib" Then EditorHelp_Anchor$ = "lib"
    If k = "alias" Then EditorHelp_Anchor$ = "alias"
    If k = "byval" Then EditorHelp_Anchor$ = "byval"
    If k = "byref" Then EditorHelp_Anchor$ = "byref"
    If k = "function" Then EditorHelp_Anchor$ = "function"
    If k = "sub" Then EditorHelp_Anchor$ = "sub"
    If k = "if" Or k = "then" Or k = "else" Or k = "elseif" Then EditorHelp_Anchor$ = "if"
    If k = "select" Or k = "case" Then EditorHelp_Anchor$ = "select"
    If k = "while" Or k = "wend" Then EditorHelp_Anchor$ = "while"
    If k = "for" Or k = "to" Or k = "next" Then EditorHelp_Anchor$ = "for"
    If k = "do" Or k = "loop" Then EditorHelp_Anchor$ = "do"
    If k = "print" Then EditorHelp_Anchor$ = "print"
    If k = "input" Then EditorHelp_Anchor$ = "input"
    If k = "sleep" Then EditorHelp_Anchor$ = "sleep"
    If k = "end" Then EditorHelp_Anchor$ = "end"
    If k = "and" Or k = "or" Then EditorHelp_Anchor$ = "and"
    If k = "varptr" Then EditorHelp_Anchor$ = "varptr"
    If k = "sizeof" Then EditorHelp_Anchor$ = "sizeof"
    If k = "addressof" Then EditorHelp_Anchor$ = "addressof"
    If k = "left$" Or k = "left" Or k = "mid$" Or k = "mid" Then EditorHelp_Anchor$ = "left$"
    If k = "right$" Or k = "right" Then EditorHelp_Anchor$ = "right$"
    If k = "chr$" Or k = "chr" Then EditorHelp_Anchor$ = "chr$"
    If k = "rgb" Then EditorHelp_Anchor$ = "rgb"
    If k = "loword" Then EditorHelp_Anchor$ = "loword"
    If k = "include" Then EditorHelp_Anchor$ = "include"
    If k = "usewindow" Then EditorHelp_Anchor$ = "usewindow"
    If k = "console" Then EditorHelp_Anchor$ = "console"
    If k = "strict" Then EditorHelp_Anchor$ = "strict"
    If k = "source" Then EditorHelp_Anchor$ = "source"
    If k = "n88basic" Or k = "n88" Or k = "prompt" Then EditorHelp_Anchor$ = "n88basic"
    If k = "line" Then EditorHelp_Anchor$ = "line"
    If k = "circle" Then EditorHelp_Anchor$ = "circle"
    If k = "locate" Then EditorHelp_Anchor$ = "locate"
    If k = "paint" Then EditorHelp_Anchor$ = "paint"
    If k = "class" Then EditorHelp_Anchor$ = "class"
    If k = "bf" Then EditorHelp_Anchor$ = "line"
    If k = "math" Then EditorHelp_Anchor$ = "math"
    If k = "sin" Or k = "cos" Or k = "tan" Or k = "sindeg" Or k = "cosdeg" Then EditorHelp_Anchor$ = "sin"
    If k = "sqr" Then EditorHelp_Anchor$ = "sqr"
    If k = "abs" Or k = "sgn" Or k = "min" Or k = "max" Then EditorHelp_Anchor$ = "abs"
    If k = "atn" Then EditorHelp_Anchor$ = "atn"
    If k = "exp" Then EditorHelp_Anchor$ = "exp"
    If k = "math" Then EditorHelp_Anchor$ = "math"
    If k = "mathdiv" Or k = "mathmod" Or k = "math_one" Or k = "math_pi" Or k = "math_hpi" Or k = "math_pi2" Or k = "math_e" Or k = "degtorad" Or k = "radtodeg" Then EditorHelp_Anchor$ = "math"
    If k = "insmenu" Then EditorHelp_Anchor$ = "insmenu"
    If k = "malloc" Or k = "calloc" Or k = "free" Or k = "memcpy" Or k = "fillmemory" Then EditorHelp_Anchor$ = "varptr"
    If k = "len" Or k = "asc" Or k = "str$" Or k = "str" Or k = "strptr" Or k = "makestr" Or k = "makeintresource" Then EditorHelp_Anchor$ = "varptr"
    If k = "actba64" Then EditorHelp_Anchor$ = "overview"
End Function

Function EditorHelp_FileExists(path As String) As Long
    Dim a As Long
    EditorHelp_FileExists = 0
    a = GetFileAttributes(path)
    If a <> -1 Then EditorHelp_FileExists = 1
End Function

Function EditorHelp_FindPath$() As String
    Dim dir As String
    Dim path As String

    EditorHelp_FindPath$ = ""
    dir = EditorBuild_ExeDir$()
    If Len(dir) > 0 Then
        path = dir + "help\actba64_ref.html"
        If EditorHelp_FileExists(path) <> 0 Then
            EditorHelp_FindPath$ = path
            Exit Function
        End If
        path = dir + "..\help\actba64_ref.html"
        If EditorHelp_FileExists(path) <> 0 Then
            EditorHelp_FindPath$ = path
            Exit Function
        End If
    End If
    path = "help\actba64_ref.html"
    If EditorHelp_FileExists(path) <> 0 Then EditorHelp_FindPath$ = path
End Function

Function EditorHelp_ToFileUrl$(path As String, anchor As String) As String
    Dim n As Long
    Dim i As Long
    Dim c As Byte
    Dim sp As *Byte
    Dim out As *Byte
    Dim url As String

    EditorHelp_ToFileUrl$ = ""
    n = Len(path)
    If n <= 0 Then Exit Function
    out = malloc(n + 16)
    If out = 0 Then Exit Function
    sp = StrPtr(path)
    out[0] = 102
    out[1] = 105
    out[2] = 108
    out[3] = 101
    out[4] = 58
    out[5] = 47
    out[6] = 47
    out[7] = 47
    For i = 0 To n - 1
        c = sp[i]
        If c = 92 Then c = 47
        out[8 + i] = c
    Next
    out[8 + n] = 0
    url = MakeStr(out)
    free(out)
    If Len(anchor) > 0 Then url = url + "#" + anchor
    EditorHelp_ToFileUrl$ = url
End Function

Sub EditorHelp_Show(keyword As String)
    Dim path As String
    Dim url As String
    Dim anchor As String
    Dim msg As String
    Dim title As String
    Dim r As HINSTANCE

    path = EditorHelp_FindPath$()
    If Len(path) = 0 Then
        msg = UiText$(UI_HELP_NOT_FOUND)
        title = UiText$(UI_HELP_TITLE)
        MessageBox(hMainWnd, msg, title, MB_OK)
        Exit Sub
    End If
    anchor = EditorHelp_Anchor$(keyword)
    url = EditorHelp_ToFileUrl$(path, anchor)
    r = ShellExecute(hMainWnd, "open", url, "", "", SW_SHOWNORMAL)
    If r <= 32 Then
        r = ShellExecute(hMainWnd, "open", path, "", "", SW_SHOWNORMAL)
        If r <= 32 Then
            msg = UiText$(UI_HELP_OPEN_FAILED) + path
            title = UiText$(UI_HELP_TITLE)
            MessageBox(hMainWnd, msg, title, MB_OK)
        End If
    End If
End Sub

