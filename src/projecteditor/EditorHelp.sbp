' actba64 言語リファレンス（HTML）を既定ブラウザで開く

Function EditorHelp_IsIdentChar(ByVal c As Long) As Long
    EditorHelp_IsIdentChar = 0
    If c >= 48 And c <= 57 Then EditorHelp_IsIdentChar = 1
    If c >= 65 And c <= 90 Then EditorHelp_IsIdentChar = 1
    If c >= 97 And c <= 122 Then EditorHelp_IsIdentChar = 1
    If c = 95 Or c = 36 Or c = 35 Then EditorHelp_IsIdentChar = 1
End Function

Function EditorHelp_LowerCopy$(s As String) As String
    Dim n As Long
    Dim i As Long
    Dim c As Byte
    Dim out As *Byte
    Dim sp As *Byte

    EditorHelp_LowerCopy$ = ""
    n = Len(s)
    If n <= 0 Then Exit Function
    out = malloc(n + 1)
    If out = 0 Then Exit Function
    sp = StrPtr(s)
    For i = 0 To n - 1
        c = sp[i]
        If c >= 65 And c <= 90 Then c = c + 32
        out[i] = c
    Next
    out[n] = 0
    EditorHelp_LowerCopy$ = Enc_DupCStr$(out, n)
    free(out)
End Function

Function EditorHelp_KeywordAtCursor$() As String
    Dim lineNo As Long
    Dim lineText As String
    Dim s As Long
    Dim col As Long
    Dim n As Long
    Dim a As Long
    Dim b As Long
    Dim sp As *Byte

    EditorHelp_KeywordAtCursor$ = ""
    lineNo = TextBuf_CursorLine()
    lineText = TextBuf_GetLineText$(lineNo)
    n = Len(lineText)
    If n <= 0 Then Exit Function
    s = TextBuf_GetLineStart(lineNo)
    col = TextBuf_CursorIndex() - s
    If col < 0 Then col = 0
    If col > n Then col = n
    If col = n And col > 0 Then col = col - 1
    sp = StrPtr(lineText)
    col = EditorHelp_SnapIdentCol(sp, col, n)
    If col < 0 Then Exit Function
    a = EditorHelp_IdentStart(sp, col)
    b = EditorHelp_IdentEnd(sp, col, n)
    EditorHelp_KeywordAtCursor$ = EditorHelp_SliceBytes$(sp, a, b - a)
End Function

Function EditorHelp_SnapIdentCol(sp As *Byte, ByVal col As Long, ByVal n As Long) As Long
    EditorHelp_SnapIdentCol = -1
    If EditorHelp_IsIdentChar(sp[col]) <> 0 Then
        EditorHelp_SnapIdentCol = col
        Exit Function
    End If
    If col > 0 Then
        If EditorHelp_IsIdentChar(sp[col - 1]) <> 0 Then
            EditorHelp_SnapIdentCol = col - 1
        End If
    End If
End Function

Function EditorHelp_IdentStart(sp As *Byte, ByVal col As Long) As Long
    Dim a As Long
    a = col
    While a > 0
        If EditorHelp_IsIdentChar(sp[a - 1]) = 0 Then Exit While
        a = a - 1
    Wend
    EditorHelp_IdentStart = a
End Function

Function EditorHelp_IdentEnd(sp As *Byte, ByVal col As Long, ByVal n As Long) As Long
    Dim b As Long
    b = col + 1
    While b < n
        If EditorHelp_IsIdentChar(sp[b]) = 0 Then Exit While
        b = b + 1
    Wend
    EditorHelp_IdentEnd = b
End Function

Function EditorHelp_SliceBytes$(sp As *Byte, ByVal a As Long, ByVal klen As Long) As String
    Dim out As *Byte
    Dim i As Long
    EditorHelp_SliceBytes$ = ""
    If klen <= 0 Then Exit Function
    out = malloc(klen + 1)
    If out = 0 Then Exit Function
    For i = 0 To klen - 1
        out[i] = sp[a + i]
    Next
    out[klen] = 0
    EditorHelp_SliceBytes$ = Enc_DupCStr$(out, klen)
    free(out)
End Function

Function EditorHelp_Anchor$(keyword As String) As String
    Dim k As String
    Dim sp As *Byte
    EditorHelp_Anchor$ = ""
    k = EditorHelp_LowerCopy$(keyword)
    If Len(k) = 0 Then Exit Function
    sp = StrPtr(k)
    If sp <> 0 Then
        If sp[0] = 35 Then k = Mid$(k, 2)
    End If
    EditorHelp_Anchor$ = EditorHelp_AnchorLookup$(k)
End Function

Function EditorHelp_AnchorLookup$(k As String) As String
    Dim out As String
    out = ""
    If k = "byte" Then out = "byte"
    If k = "word" Then out = "word"
    If k = "long" Then out = "long"
    If k = "dword" Then out = "dword"
    If k = "integer" Then out = "integer"
    If k = "string" Then out = "string"
    If k = "handle" Then out = "handle"
    If k = "hwnd" Or k = "hdc" Or k = "hmenu" Or k = "hfont" Or k = "hinstance" Or k = "hicon" Or k = "hbrush" Or k = "hbitmap" Or k = "hcursor" Or k = "hpen" Or k = "hrgn" Or k = "hkey" Or k = "hdrop" Then out = "hwnd"
    If k = "voidptr" Or k = "byteptr" Or k = "lpstr" Or k = "lpcstr" Then out = "voidptr"
    If k = "long_ptr" Or k = "ulong_ptr" Or k = "longptr" Or k = "ulongptr" Then out = "long_ptr"
    If k = "wparam" Or k = "lparam" Or k = "lresult" Then out = "wparam"
    If k = "longlong" Or k = "qword" Or k = "dword64" Or k = "qword64" Then out = "longlong"
    EditorHelp_AnchorLookupKw2(k, out)
    EditorHelp_AnchorLookup$ = out
End Function

Sub EditorHelp_AnchorLookupKw2(k As String, ByRef out As String)
    If k = "typedef" Then out = "typedef"
    If k = "type" Then out = "type"
    If k = "dim" Then out = "dim"
    If k = "const" Then out = "const"
    If k = "declare" Then out = "declare"
    If k = "lib" Then out = "lib"
    If k = "alias" Then out = "alias"
    If k = "byval" Then out = "byval"
    If k = "byref" Then out = "byref"
    If k = "function" Then out = "function"
    If k = "sub" Then out = "sub"
    If k = "if" Or k = "then" Or k = "else" Or k = "elseif" Then out = "if"
    If k = "select" Or k = "case" Then out = "select"
    If k = "while" Or k = "wend" Then out = "while"
    If k = "for" Or k = "to" Or k = "next" Then out = "for"
    If k = "do" Or k = "loop" Then out = "do"
    If k = "print" Then out = "print"
    If k = "input" Then out = "input"
    If k = "sleep" Then out = "sleep"
    If k = "end" Then out = "end"
    If k = "and" Or k = "or" Then out = "and"
    EditorHelp_AnchorLookupKw3(k, out)
End Sub

Sub EditorHelp_AnchorLookupKw3(k As String, ByRef out As String)
    If k = "varptr" Then out = "varptr"
    If k = "sizeof" Then out = "sizeof"
    If k = "addressof" Then out = "addressof"
    If k = "left$" Or k = "left" Or k = "mid$" Or k = "mid" Then out = "left$"
    If k = "right$" Or k = "right" Then out = "right$"
    If k = "chr$" Or k = "chr" Then out = "chr$"
    If k = "rgb" Then out = "rgb"
    If k = "loword" Then out = "loword"
    If k = "include" Then out = "include"
    If k = "usewindow" Then out = "usewindow"
    If k = "console" Then out = "console"
    If k = "strict" Then out = "strict"
    If k = "source" Then out = "source"
    If k = "n88basic" Or k = "n88" Or k = "prompt" Then out = "n88basic"
    If k = "line" Or k = "bf" Then out = "line"
    If k = "circle" Then out = "circle"
    If k = "locate" Then out = "locate"
    If k = "paint" Then out = "paint"
    If k = "class" Then out = "class"
    If k = "math" Or k = "mathdiv" Or k = "mathmod" Or k = "math_one" Or k = "math_pi" Or k = "math_hpi" Or k = "math_pi2" Or k = "math_e" Or k = "degtorad" Or k = "radtodeg" Then out = "math"
    If k = "sin" Or k = "cos" Or k = "tan" Or k = "sindeg" Or k = "cosdeg" Then out = "sin"
    If k = "sqr" Then out = "sqr"
    If k = "abs" Or k = "sgn" Or k = "min" Or k = "max" Then out = "abs"
    If k = "atn" Then out = "atn"
    If k = "exp" Then out = "exp"
    If k = "insmenu" Then out = "insmenu"
    If k = "malloc" Or k = "calloc" Or k = "free" Or k = "memcpy" Or k = "fillmemory" Then out = "varptr"
    If k = "len" Or k = "asc" Or k = "str$" Or k = "str" Or k = "strptr" Or k = "makestr" Or k = "makeintresource" Then out = "varptr"
    If k = "actba64" Then out = "overview"
End Sub

Function EditorHelp_FileExists(path As String) As Long
    Dim a As Long
    EditorHelp_FileExists = 0
    a = GetFileAttributes(path)
    If a <> -1 Then EditorHelp_FileExists = 1
End Function

Function EditorHelp_FindPath$() As String
    Dim dir As String
    Dim path As String

    EditorHelp_FindPath$ = ""
    dir = EditorBuild_ExeDir$()
    If Len(dir) > 0 Then
        path = dir + "help\actba64_ref.html"
        If EditorHelp_FileExists(path) <> 0 Then
            EditorHelp_FindPath$ = path
            Exit Function
        End If
        path = dir + "..\help\actba64_ref.html"
        If EditorHelp_FileExists(path) <> 0 Then
            EditorHelp_FindPath$ = path
            Exit Function
        End If
    End If
    path = "help\actba64_ref.html"
    If EditorHelp_FileExists(path) <> 0 Then EditorHelp_FindPath$ = path
End Function

Function EditorHelp_ToFileUrl$(path As String, anchor As String) As String
    Dim n As Long
    Dim i As Long
    Dim c As Byte
    Dim sp As *Byte
    Dim out As *Byte
    Dim url As String

    EditorHelp_ToFileUrl$ = ""
    n = Len(path)
    If n <= 0 Then Exit Function
    out = malloc(n + 16)
    If out = 0 Then Exit Function
    sp = StrPtr(path)
    out[0] = 102
    out[1] = 105
    out[2] = 108
    out[3] = 101
    out[4] = 58
    out[5] = 47
    out[6] = 47
    out[7] = 47
    For i = 0 To n - 1
        c = sp[i]
        If c = 92 Then c = 47
        out[8 + i] = c
    Next
    out[8 + n] = 0
    url = Enc_DupCStr$(out, 8 + n)
    free(out)
    If Len(anchor) > 0 Then url = url + "#" + anchor
    EditorHelp_ToFileUrl$ = url
End Function

Sub EditorHelp_Show(keyword As String)
    Dim path As String
    Dim url As String
    Dim anchor As String
    Dim msg As String
    Dim title As String
    Dim r As HINSTANCE

    path = EditorHelp_FindPath$()
    If Len(path) = 0 Then
        msg = UiText$(UI_HELP_NOT_FOUND)
        title = UiText$(UI_HELP_TITLE)
        MessageBox(hMainWnd, msg, title, MB_OK)
        Exit Sub
    End If
    anchor = EditorHelp_Anchor$(keyword)
    url = EditorHelp_ToFileUrl$(path, anchor)
    r = ShellExecute(hMainWnd, "open", url, "", "", SW_SHOWNORMAL)
    If r <= 32 Then
        r = ShellExecute(hMainWnd, "open", path, "", "", SW_SHOWNORMAL)
        If r <= 32 Then
            msg = UiText$(UI_HELP_OPEN_FAILED) + path
            title = UiText$(UI_HELP_TITLE)
            MessageBox(hMainWnd, msg, title, MB_OK)
        End If
    End If
End Sub

