' AB4 デザイナーの道具箱の絵（AB 4.20 の道具箱のような小さな線画）。
' 絵は Ui_* だけで描く（ビットマップの資源は使わない。Windows 版も Linux 版も同じ）。
' Ab4D_DrawIcon(hDC, x, y, t) が 20 x 20 の四角（左上 x, y）に種類 t（0 はポインタ）の絵を描く。

Function Ab4D_Ink() As DWord
    Ab4D_Ink = RGB(0, 0, 0)
End Function

Function Ab4D_Gray() As DWord
    Ab4D_Gray = RGB(128, 128, 128)
End Function

Sub Ab4D_Px(hDC As HDC, ByVal x As Long, ByVal y As Long, ByVal w As Long, ByVal h As Long, ByVal c As DWord)
    FormDesign_Fill(hDC, x, y, x + w, y + h, c)
End Sub

' 白い箱と灰色の枠
Sub Ab4D_IBox(hDC As HDC, ByVal x As Long, ByVal y As Long, ByVal w As Long, ByVal h As Long)
    Dim r As RECT
    Ab4D_Px(hDC, x, y, w, h, RGB(255, 255, 255))
    FormDesign_Rect(r, x, y, x + w, y + h)
    Ui_Frame(hDC, r, Ab4D_Gray())
End Sub

' 小さな出っ張ったボタン
Sub Ab4D_IBtn(hDC As HDC, ByVal l As Long, ByVal t As Long, ByVal r As Long, ByVal b As Long, ByVal st As DWord)
    Dim rc As RECT
    FormDesign_Rect(rc, l, t, r, b)
    Ui_ButtonFrame(hDC, rc, st)
End Sub

' 3 段の三角（dir 0 上、1 下、2 左、3 右）。cx, cy はとがった先
Sub Ab4D_Tri(hDC As HDC, ByVal cx As Long, ByVal cy As Long, ByVal dir As Long)
    Dim i As Long
    For i = 0 To 2
        If dir = 0 Then Ab4D_Px(hDC, cx - i, cy + i, i * 2 + 1, 1, Ab4D_Ink())
        If dir = 1 Then Ab4D_Px(hDC, cx - i, cy - i, i * 2 + 1, 1, Ab4D_Ink())
        If dir = 2 Then Ab4D_Px(hDC, cx + i, cy - i, 1, i * 2 + 1, Ab4D_Ink())
        If dir = 3 Then Ab4D_Px(hDC, cx - i, cy - i, 1, i * 2 + 1, Ab4D_Ink())
    Next
End Sub

' 四角の真ん中に文字
Sub Ab4D_IText(hDC As HDC, ByVal x As Long, ByVal y As Long, s As String)
    Dim r As RECT
    FormDesign_Rect(r, x, y, x + 20, y + 20)
    Ui_TextColor(hDC, Ab4D_Ink())
    Ui_TextCenter(hDC, r, s)
End Sub

' ---- 1 つずつ ----

' 矢印のポインタ
Sub Ab4D_IPointer(hDC As HDC, ByVal x As Long, ByVal y As Long)
    Dim i As Long
    For i = 0 To 10
        Ab4D_Px(hDC, x + 6, y + 2 + i, i * 6 \ 10 + 1, 1, Ab4D_Ink())
    Next
    Ab4D_Px(hDC, x + 8, y + 12, 2, 5, Ab4D_Ink())
    Ab4D_Px(hDC, x + 10, y + 15, 2, 3, Ab4D_Ink())
End Sub

' ab| の欄（EditBox）
Sub Ab4D_IEdit(hDC As HDC, ByVal x As Long, ByVal y As Long)
    Ab4D_IBox(hDC, x, y + 3, 20, 14)
    Ab4D_IText(hDC, x - 3, y, "ab")
    Ab4D_Px(hDC, x + 15, y + 6, 1, 8, Ab4D_Ink())
End Sub

' 点線の枠と左上の見出し（GroupBox）
Sub Ab4D_IGroup(hDC As HDC, ByVal x As Long, ByVal y As Long)
    Dim i As Long
    For i = 0 To 18 Step 2
        Ab4D_Px(hDC, x + 1 + i, y + 18, 1, 1, Ab4D_Ink())
        Ab4D_Px(hDC, x + 1, y + 5 + i * 13 \ 18, 1, 1, Ab4D_Ink())
        Ab4D_Px(hDC, x + 19, y + 5 + i * 13 \ 18, 1, 1, Ab4D_Ink())
        If i >= 12 Then Ab4D_Px(hDC, x + 1 + i, y + 5, 1, 1, Ab4D_Ink())
    Next
    Ab4D_Px(hDC, x + 3, y + 4, 8, 3, Ab4D_Gray())
End Sub

' 押しボタン
Sub Ab4D_IButton(hDC As HDC, ByVal x As Long, ByVal y As Long)
    Ab4D_IBtn(hDC, x + 1, y + 5, x + 19, y + 15, DFCS_BUTTONPUSH)
End Sub

' チェックした四角（CheckBox）と、点の入った丸（RadioButton）
Sub Ab4D_IMark(hDC As HDC, ByVal x As Long, ByVal y As Long, ByVal st As DWord)
    Ab4D_IBtn(hDC, x + 3, y + 3, x + 16, y + 16, st Or DFCS_CHECKED)
End Sub

' 横のスクロール バー
Sub Ab4D_IHScroll(hDC As HDC, ByVal x As Long, ByVal y As Long)
    Ab4D_Px(hDC, x, y + 6, 20, 8, Ui_SysColor(COLOR_SCROLLBAR))
    Ab4D_IBtn(hDC, x, y + 6, x + 8, y + 14, DFCS_BUTTONPUSH)
    Ab4D_IBtn(hDC, x + 12, y + 6, x + 20, y + 14, DFCS_BUTTONPUSH)
    Ab4D_Tri(hDC, x + 3, y + 10, 2)
    Ab4D_Tri(hDC, x + 16, y + 10, 3)
End Sub

' 縦のスクロール バー
Sub Ab4D_IVScroll(hDC As HDC, ByVal x As Long, ByVal y As Long)
    Ab4D_Px(hDC, x + 6, y, 8, 20, Ui_SysColor(COLOR_SCROLLBAR))
    Ab4D_IBtn(hDC, x + 6, y, x + 14, y + 8, DFCS_BUTTONPUSH)
    Ab4D_IBtn(hDC, x + 6, y + 12, x + 14, y + 20, DFCS_BUTTONPUSH)
    Ab4D_Tri(hDC, x + 10, y + 3, 0)
    Ab4D_Tri(hDC, x + 10, y + 16, 1)
End Sub

' 上下の三角（UpDown）
Sub Ab4D_IUpDown(hDC As HDC, ByVal x As Long, ByVal y As Long)
    Ab4D_IBtn(hDC, x + 5, y + 1, x + 15, y + 10, DFCS_BUTTONPUSH)
    Ab4D_IBtn(hDC, x + 5, y + 10, x + 15, y + 19, DFCS_BUTTONPUSH)
    Ab4D_Tri(hDC, x + 10, y + 4, 0)
    Ab4D_Tri(hDC, x + 10, y + 16, 1)
End Sub

' 線の上のつまみ（TrackBar）
Sub Ab4D_ITrack(hDC As HDC, ByVal x As Long, ByVal y As Long)
    Ab4D_Px(hDC, x + 1, y + 9, 18, 1, Ab4D_Gray())
    Ab4D_Px(hDC, x + 1, y + 10, 18, 1, RGB(255, 255, 255))
    Ab4D_IBtn(hDC, x + 7, y + 3, x + 12, y + 17, DFCS_BUTTONPUSH)
    Ab4D_Px(hDC, x + 2, y + 18, 1, 2, Ab4D_Ink())
    Ab4D_Px(hDC, x + 17, y + 18, 1, 2, Ab4D_Ink())
End Sub

' 塗ったブロックの並ぶ帯（ProgressBar）
Sub Ab4D_IProgress(hDC As HDC, ByVal x As Long, ByVal y As Long)
    Dim r As RECT, i As Long
    FormDesign_Rect(r, x, y + 5, x + 20, y + 15)
    Ui_Edge(hDC, r, BDR_SUNKENOUTER, BF_RECT)
    For i = 0 To 2
        Ab4D_Px(hDC, x + 2 + i * 5, y + 7, 4, 6, RGB(0, 0, 160))
    Next
End Sub

' 升目の並ぶ一覧（ListView）
Sub Ab4D_IListView(hDC As HDC, ByVal x As Long, ByVal y As Long)
    Dim i As Long, j As Long
    Ab4D_IBox(hDC, x, y + 1, 20, 18)
    For i = 0 To 2
        For j = 0 To 1
            Ab4D_Px(hDC, x + 3 + i * 5, y + 4 + j * 7, 3, 3, RGB(0, 0, 160))
            Ab4D_Px(hDC, x + 2 + i * 5, y + 8 + j * 7, 5, 1, Ab4D_Gray())
        Next
    Next
End Sub

' 行とスクロール バーのある箱（ListBox）
Sub Ab4D_IListBox(hDC As HDC, ByVal x As Long, ByVal y As Long)
    Dim i As Long
    Ab4D_IBox(hDC, x, y + 1, 20, 18)
    For i = 0 To 3
        Ab4D_Px(hDC, x + 3, y + 4 + i * 4, 9, 1, Ab4D_Ink())
    Next
    Ab4D_Px(hDC, x + 14, y + 2, 5, 16, Ui_SysColor(COLOR_SCROLLBAR))
    Ab4D_Px(hDC, x + 14, y + 2, 1, 16, Ab4D_Gray())
End Sub

' 欄と ▼ のボタン（ComboBox）
Sub Ab4D_ICombo(hDC As HDC, ByVal x As Long, ByVal y As Long)
    Ab4D_IBox(hDC, x, y + 5, 20, 10)
    Ab4D_Px(hDC, x + 3, y + 9, 6, 1, Ab4D_Ink())
    Ab4D_IBtn(hDC, x + 12, y + 6, x + 19, y + 14, DFCS_BUTTONPUSH)
    Ab4D_Tri(hDC, x + 15, y + 11, 1)
End Sub

' 下がっていく枝（TreeView）
Sub Ab4D_ITree(hDC As HDC, ByVal x As Long, ByVal y As Long)
    Dim i As Long
    Ab4D_IBox(hDC, x, y + 1, 20, 18)
    Ab4D_Px(hDC, x + 4, y + 5, 1, 11, Ab4D_Gray())
    For i = 0 To 2
        Ab4D_Px(hDC, x + 4, y + 5 + i * 5, 4, 1, Ab4D_Gray())
        Ab4D_Px(hDC, x + 9, y + 4 + i * 5, 7, 3, Ab4D_Ink())
    Next
End Sub

' ---- 種類で選ぶ ----

Sub Ab4D_DrawIcon(hDC As HDC, ByVal x As Long, ByVal y As Long, ByVal t As Long)
    If t = 0 Then Ab4D_IPointer(hDC, x, y)
    If t = 11 Then Ab4D_IText(hDC, x, y, "text")
    If t = 4 Then Ab4D_IEdit(hDC, x, y)
    If t = 5 Then Ab4D_IGroup(hDC, x, y)
    If t = 1 Then Ab4D_IButton(hDC, x, y)
    If t = 2 Then Ab4D_IMark(hDC, x, y, DFCS_BUTTONCHECK)
    If t = 10 Then Ab4D_IMark(hDC, x, y, DFCS_BUTTONRADIO)
    If t = 7 Then Ab4D_IText(hDC, x, y, "Img")
    Ab4D_DrawIcon2(hDC, x, y, t)
End Sub

Sub Ab4D_DrawIcon2(hDC As HDC, ByVal x As Long, ByVal y As Long, ByVal t As Long)
    If t = 6 Then Ab4D_IHScroll(hDC, x, y)
    If t = 13 Then Ab4D_IVScroll(hDC, x, y)
    If t = 14 Then Ab4D_IUpDown(hDC, x, y)
    If t = 16 Then Ab4D_ITrack(hDC, x, y)
    If t = 15 Then Ab4D_IProgress(hDC, x, y)
    If t = 9 Then Ab4D_IListView(hDC, x, y)
    If t = 8 Then Ab4D_IListBox(hDC, x, y)
    If t = 3 Then Ab4D_ICombo(hDC, x, y)
    If t = 12 Then Ab4D_ITree(hDC, x, y)
End Sub
