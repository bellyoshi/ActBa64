' Ctrl shortcuts for the source child. Letter keys are ASCII virtual-key codes.

Function EditorKeys_Down(ByVal vk As Long) As Long
    Dim st As Long
    EditorKeys_Down = 0
    st = GetKeyState(vk)
    st = st And &H8000
    If st <> 0 Then EditorKeys_Down = 1
End Function

Function EditorKeys_Ctrl() As Long
    EditorKeys_Ctrl = EditorKeys_Down(VK_CONTROL)
End Function

Function EditorKeys_Shift() As Long
    EditorKeys_Shift = EditorKeys_Down(VK_SHIFT)
End Function

Function EditorKeys_CutCopy(ByVal vk As Long) As Long
    EditorKeys_CutCopy = 1
    If vk = 67 Then MainWnd_IDM_COPY_MenuClick()
    If vk = 88 Then MainWnd_IDM_CUT_MenuClick()
    If vk <> 67 And vk <> 88 Then EditorKeys_CutCopy = 0
End Function

Function EditorKeys_PasteAll(ByVal vk As Long) As Long
    EditorKeys_PasteAll = 1
    If vk = 86 Then MainWnd_IDM_PASTE_MenuClick()
    If vk = 65 Then MainWnd_IDM_SELECTALL_MenuClick()
    If vk <> 86 And vk <> 65 Then EditorKeys_PasteAll = 0
End Function

Function EditorKeys_Hist(ByVal vk As Long) As Long
    EditorKeys_Hist = 1
    If vk = 90 Then MainWnd_IDM_UNDO_MenuClick()
    If vk = 89 Then MainWnd_IDM_REDO_MenuClick()
    If vk <> 90 And vk <> 89 Then EditorKeys_Hist = 0
End Function

Function EditorKeys_Save(ByVal vk As Long) As Long
    EditorKeys_Save = 0
    If vk <> 83 Then Exit Function
    MainWnd_IDM_SAVE_MenuClick()
    EditorKeys_Save = 1
End Function

Function EditorKeys_Edit(ByVal vk As Long) As Long
    EditorKeys_Edit = EditorKeys_CutCopy(vk)
    If EditorKeys_Edit <> 0 Then Exit Function
    EditorKeys_Edit = EditorKeys_PasteAll(vk)
    If EditorKeys_Edit <> 0 Then Exit Function
    EditorKeys_Edit = EditorKeys_Hist(vk)
End Function

Function EditorKeys_Try(ByVal vk As Long) As Long
    EditorKeys_Try = 0
    If EditorKeys_Ctrl() = 0 Then Exit Function
    EditorKeys_Try = EditorKeys_Edit(vk)
    If EditorKeys_Try <> 0 Then Exit Function
    EditorKeys_Try = EditorKeys_Save(vk)
End Function
