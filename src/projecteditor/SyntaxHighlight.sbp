Const HL_KEYWORD = 1
Const HL_COMMENT = 2
Const HL_STRING = 3
Const HL_NUMBER = 4
Const HL_NORMAL = 0

Dim g_hlStateLine As Long
Dim g_hlInBlock As Long

Function Hl_IsIdentStart(ByVal b As Long) As Long
    If (b >= 65 And b <= 90) Or (b >= 97 And b <= 122) Or b = 95 Then
        Hl_IsIdentStart = 1
    Else
        Hl_IsIdentStart = 0
    End If
End Function

Function Hl_IsDigit(ByVal b As Long) As Long
    If b >= 48 And b <= 57 Then
        Hl_IsDigit = 1
    Else
        Hl_IsDigit = 0
    End If
End Function

Function Hl_IsHexDigit(ByVal b As Long) As Long
    If Hl_IsDigit(b) <> 0 Then
        Hl_IsHexDigit = 1
    ElseIf (b >= 65 And b <= 70) Or (b >= 97 And b <= 102) Then
        Hl_IsHexDigit = 1
    Else
        Hl_IsHexDigit = 0
    End If
End Function

Function Hl_IsAlnum(ByVal b As Long) As Long
    If Hl_IsIdentStart(b) <> 0 Or Hl_IsDigit(b) <> 0 Then
        Hl_IsAlnum = 1
    Else
        Hl_IsAlnum = 0
    End If
End Function

Function Hl_Lower$(s As String) As String
    Dim n As Long
    Dim i As Long
    Dim p As *Byte
    Dim ch As Byte
    Dim r As String

    Hl_Lower$ = ""
    n = Len(s)
    If n <= 0 Then Exit Function
    r = Mid$(s, 1, n)
    p = StrPtr(r)
    For i = 0 To n - 1
        ch = p[i]
        If ch >= 65 And ch <= 90 Then
            ch = ch + 32
        End If
        p[i] = ch
    Next
    Hl_Lower$ = r
End Function

Function Hl_IsKeyword(s As String) As Long
    Dim kw As String
    Hl_IsKeyword = 0
    kw = Hl_Lower$(s)
    If kw = "and" Or kw = "or" Or kw = "xor" Or kw = "mod" Then Hl_IsKeyword = 1
    If kw = "if" Or kw = "then" Or kw = "elseif" Or kw = "else" Or kw = "end" Then Hl_IsKeyword = 1
    If kw = "dim" Or kw = "const" Or kw = "typedef" Or kw = "type" Then Hl_IsKeyword = 1
    If kw = "sub" Or kw = "function" Or kw = "declare" Or kw = "lib" Or kw = "alias" Then Hl_IsKeyword = 1
    If kw = "while" Or kw = "wend" Or kw = "for" Or kw = "next" Then Hl_IsKeyword = 1
    If kw = "do" Or kw = "loop" Or kw = "until" Or kw = "select" Or kw = "case" Then Hl_IsKeyword = 1
    If kw = "exit" Or kw = "return" Or kw = "print" Or kw = "input" Then Hl_IsKeyword = 1
    If kw = "as" Or kw = "byref" Or kw = "byval" Or kw = "to" Or kw = "step" Then Hl_IsKeyword = 1
    If kw = "varptr" Or kw = "addressof" Or kw = "sizeof" Then Hl_IsKeyword = 1
    If kw = "long" Or kw = "byte" Or kw = "word" Or kw = "string" Or kw = "integer" Or kw = "dword" Then Hl_IsKeyword = 1
    If kw = "hwnd" Or kw = "hdc" Or kw = "true" Or kw = "false" Or kw = "null" Then Hl_IsKeyword = 1
    If kw = "line" Or kw = "circle" Or kw = "sleep" Or kw = "locate" Or kw = "paint" Then Hl_IsKeyword = 1
    If kw = "class" Or kw = "public" Or kw = "private" Then Hl_IsKeyword = 1
    If kw = "sin" Or kw = "cos" Or kw = "tan" Or kw = "abs" Or kw = "sqr" Or kw = "atn" Then Hl_IsKeyword = 1
End Function

Function Hl_IsDirective(s As String) As Long
    Dim kw As String
    Hl_IsDirective = 0
    kw = Hl_Lower$(s)
    If kw = "#n88basic" Or kw = "#prompt" Then Hl_IsDirective = 1
    If kw = "#console" Or kw = "#strict" Or kw = "#include" Or kw = "#usewindow" Then Hl_IsDirective = 1
End Function

Function Hl_ColorOf(ByVal kind As Long) As Long
    If kind = HL_KEYWORD Then
        Hl_ColorOf = RGB(0, 0, 200)
    ElseIf kind = HL_COMMENT Then
        Hl_ColorOf = RGB(0, 128, 0)
    ElseIf kind = HL_STRING Then
        Hl_ColorOf = RGB(163, 21, 21)
    Else
        Hl_ColorOf = RGB(0, 0, 0)
    End If
End Function

Function Hl_MidBytes$(s As String, ByVal start1 As Long, ByVal n As Long) As String
    Dim slen As Long

    Hl_MidBytes$ = ""
    slen = Len(s)
    If start1 < 1 Or n <= 0 Or start1 > slen Then Exit Function
    If start1 + n - 1 > slen Then n = slen - start1 + 1
    Hl_MidBytes$ = Mid$(s, start1, n)
End Function

Sub Hl_Emit(hDC As HDC, ByRef x As Long, ByVal y As Long, seg As String, ByVal kind As Long, ByVal doDraw As Long)
    Dim sz As SIZE
    If Len(seg) <= 0 Then Exit Sub
    If doDraw = 0 Then Exit Sub
    SetTextColor(hDC, Hl_ColorOf(kind))
    sz.cx = 0
    sz.cy = 0
    Enc_TextExtentUtf8(hDC, seg, sz)
    Enc_TextOutUtf8(hDC, x, y, seg)
    x = x + sz.cx
End Sub

Function Hl_AdvanceUtf8(ByVal b As Long, ByVal i As Long, ByVal n As Long) As Long
    Dim charBytes As Long
    charBytes = Enc_Utf8CharBytes(b)
    If charBytes > 1 And i + charBytes <= n Then
        Hl_AdvanceUtf8 = i + charBytes
    Else
        Hl_AdvanceUtf8 = i + 1
    End If
End Function

Function Hl_PeekByte(p As *Byte, ByVal i As Long) As Long
    Dim tmp As Long
    Dim bp As *Byte
    bp = VarPtr(tmp)
    bp[0] = p[i]
    Hl_PeekByte = tmp And &HFF
End Function

Sub Hl_ScanBlockComment(p As *Byte, ByRef i As Long, ByVal n As Long, ByRef inBlock As Long)
    Dim b As Long
    Dim b2 As Long
    While i < n
        b = Hl_PeekByte(p, i)
        If b = 42 And i + 1 < n Then
            b2 = Hl_PeekByte(p, i + 1)
            If b2 = 47 Then
                i = i + 2
                inBlock = 0
                Exit Sub
            End If
        End If
        i = Hl_AdvanceUtf8(b, i, n)
    Wend
End Sub

Sub Hl_DrawInBlock(hDC As HDC, ByRef x As Long, ByVal y As Long, lineStr As String, p As *Byte, ByRef i As Long, ByVal n As Long, ByRef inBlock As Long, ByVal doDraw As Long)
    Dim startI As Long
    Dim seg As String
    startI = i
    Hl_ScanBlockComment(p, i, n, inBlock)
    If inBlock <> 0 Then
        seg = Hl_MidBytes$(lineStr, startI + 1, n - startI)
        Hl_Emit(hDC, x, y, seg, HL_COMMENT, doDraw)
        i = n
    Else
        seg = Hl_MidBytes$(lineStr, startI + 1, i - startI)
        Hl_Emit(hDC, x, y, seg, HL_COMMENT, doDraw)
    End If
End Sub

Sub Hl_DrawSlash(hDC As HDC, ByRef x As Long, ByVal y As Long, lineStr As String, p As *Byte, ByRef i As Long, ByVal n As Long, ByRef inBlock As Long, ByVal doDraw As Long)
    Dim startI As Long
    Dim seg As String
    Dim b2 As Long
    b2 = Hl_PeekByte(p, i + 1)
    If b2 <> 42 Then
        seg = Hl_MidBytes$(lineStr, i + 1, 1)
        Hl_Emit(hDC, x, y, seg, HL_NORMAL, doDraw)
        i = i + 1
        Exit Sub
    End If
    startI = i
    i = i + 2
    inBlock = 1
    Hl_ScanBlockComment(p, i, n, inBlock)
    seg = Hl_MidBytes$(lineStr, startI + 1, i - startI)
    Hl_Emit(hDC, x, y, seg, HL_COMMENT, doDraw)
End Sub

Sub Hl_DrawStringLit(hDC As HDC, ByRef x As Long, ByVal y As Long, lineStr As String, p As *Byte, ByRef i As Long, ByVal n As Long, ByVal doDraw As Long)
    Dim startI As Long
    Dim seg As String
    Dim b As Long
    startI = i
    i = i + 1
    While i < n
        b = Hl_PeekByte(p, i)
        If b = 34 Then
            i = i + 1
            Exit While
        End If
        i = Hl_AdvanceUtf8(b, i, n)
    Wend
    seg = Hl_MidBytes$(lineStr, startI + 1, i - startI)
    Hl_Emit(hDC, x, y, seg, HL_STRING, doDraw)
End Sub

Sub Hl_DrawDirective(hDC As HDC, ByRef x As Long, ByVal y As Long, lineStr As String, p As *Byte, ByRef i As Long, ByVal n As Long, ByVal doDraw As Long)
    Dim startI As Long
    Dim word As String
    Dim b As Long
    Dim kind As Long
    startI = i
    i = i + 1
    While i < n
        b = Hl_PeekByte(p, i)
        If Hl_IsAlnum(b) = 0 Then Exit While
        i = i + 1
    Wend
    word = Hl_MidBytes$(lineStr, startI + 1, i - startI)
    kind = HL_NORMAL
    If Hl_IsDirective(word) <> 0 Then kind = HL_KEYWORD
    Hl_Emit(hDC, x, y, word, kind, doDraw)
End Sub

Sub Hl_DrawIdent(hDC As HDC, ByRef x As Long, ByVal y As Long, lineStr As String, p As *Byte, ByRef i As Long, ByVal n As Long, ByVal doDraw As Long)
    Dim startI As Long
    Dim word As String
    Dim b As Long
    Dim kind As Long
    startI = i
    i = i + 1
    While i < n
        b = Hl_PeekByte(p, i)
        If Hl_IsAlnum(b) = 0 And b <> 36 Then Exit While
        i = i + 1
    Wend
    word = Hl_MidBytes$(lineStr, startI + 1, i - startI)
    kind = HL_NORMAL
    If Hl_IsKeyword(word) <> 0 Then kind = HL_KEYWORD
    Hl_Emit(hDC, x, y, word, kind, doDraw)
End Sub

Sub Hl_DrawNumber(hDC As HDC, ByRef x As Long, ByVal y As Long, lineStr As String, p As *Byte, ByRef i As Long, ByVal n As Long, ByVal b0 As Long, ByVal doDraw As Long)
    Dim startI As Long
    Dim seg As String
    Dim b As Long
    startI = i
    If b0 = 38 Then
        i = i + 1
        If i < n Then
            b = Hl_PeekByte(p, i)
            If b = 72 Or b = 104 Then i = i + 1
        End If
    End If
    While i < n
        b = Hl_PeekByte(p, i)
        If Hl_IsHexDigit(b) = 0 Then Exit While
        i = i + 1
    Wend
    seg = Hl_MidBytes$(lineStr, startI + 1, i - startI)
    Hl_Emit(hDC, x, y, seg, HL_NUMBER, doDraw)
End Sub

Sub Hl_DrawLine(hDC As HDC, ByVal x As Long, ByVal y As Long, lineStr As String, ByRef inBlock As Long, ByVal doDraw As Long)
    Dim n As Long
    Dim i As Long
    Dim b As Long
    Dim seg As String
    Dim p As *Byte
    Dim charBytes As Long

    n = Len(lineStr)
    If n <= 0 Then Exit Sub
    p = StrPtr(lineStr)
    i = 0

    While i < n
        b = Hl_PeekByte(p, i)

        If inBlock <> 0 Then
            Hl_DrawInBlock(hDC, x, y, lineStr, p, i, n, inBlock, doDraw)
        ElseIf b = 39 Then
            seg = Hl_MidBytes$(lineStr, i + 1, n - i)
            Hl_Emit(hDC, x, y, seg, HL_COMMENT, doDraw)
            i = n
        ElseIf b = 47 And i + 1 < n Then
            Hl_DrawSlash(hDC, x, y, lineStr, p, i, n, inBlock, doDraw)
        ElseIf b = 34 Then
            Hl_DrawStringLit(hDC, x, y, lineStr, p, i, n, doDraw)
        ElseIf b = 35 Then
            Hl_DrawDirective(hDC, x, y, lineStr, p, i, n, doDraw)
        ElseIf Hl_IsIdentStart(b) <> 0 Then
            Hl_DrawIdent(hDC, x, y, lineStr, p, i, n, doDraw)
        ElseIf Hl_IsDigit(b) <> 0 Or b = 38 Then
            Hl_DrawNumber(hDC, x, y, lineStr, p, i, n, b, doDraw)
        ElseIf Enc_Utf8CharBytes(b) > 1 And i + Enc_Utf8CharBytes(b) <= n Then
            charBytes = Enc_Utf8CharBytes(b)
            seg = Hl_MidBytes$(lineStr, i + 1, charBytes)
            Hl_Emit(hDC, x, y, seg, HL_NORMAL, doDraw)
            i = i + charBytes
        Else
            seg = Hl_MidBytes$(lineStr, i + 1, 1)
            Hl_Emit(hDC, x, y, seg, HL_NORMAL, doDraw)
            i = i + 1
        End If
    Wend

    If doDraw <> 0 Then SetTextColor(hDC, Hl_ColorOf(HL_NORMAL))
End Sub

Sub Hl_ResetCache()
    g_hlStateLine = 1
    g_hlInBlock = 0
End Sub

Sub Hl_EnsureStateThrough(ByVal targetLine As Long)
    Dim lineStr As String
    If targetLine < 1 Then targetLine = 1
    If targetLine < g_hlStateLine Then
        Hl_ResetCache()
    End If
    While g_hlStateLine < targetLine
        lineStr = TextBuf_GetLineText$(g_hlStateLine)
        If Len(lineStr) > 0 Then
            Hl_DrawLine(0, 0, 0, lineStr, g_hlInBlock, 0)
        End If
        g_hlStateLine = g_hlStateLine + 1
    Wend
End Sub