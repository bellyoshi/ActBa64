' EditorDbgParse - abdbg の答えの 1 行を分ける（最初の語・その後ろ・行末の CR）。
' 窓を使わないので src\dbgtest で試す

Function EditorDbg_Word$(s As String) As String
    EditorDbg_Word$ = Left$(s, InStr(1, s + " ", " ") - 1)
End Function

Function EditorDbg_After$(s As String) As String
    EditorDbg_After$ = Mid$(s, InStr(1, s + " ", " ") + 1)
End Function

Function EditorDbg_NoCr$(s As String) As String
    EditorDbg_NoCr$ = s
    If Right$(s, 1) = Chr$(13) Then EditorDbg_NoCr$ = Left$(s, Len(s) - 1)
End Function
