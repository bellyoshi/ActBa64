#include "ProjectEditor.idx"

'---------------------------
'  Window Message Loop
'---------------------------
#ifdef _LINUX
LxShell_Run()
#else
Dim msgMain As MSG, iResult As Long
Do
	iResult=GetMessage(msgMain,0,0,0)
	If iResult=0 or iResult=-1 Then Exit Do
	' デバッガーの答えを読む（EditorDbg。hwnd の無いスレッドタイマー）
	If msgMain.hwnd = 0 And msgMain.message = WM_TIMER Then EditorDbg_OnTimer()
	If TranslateMDISysAccel(g_hClient, msgMain) = 0 Then
		TranslateMessage(msgMain)
		DispatchMessage(msgMain)
	End If
Loop
#endif

' Call destructores and exit process
End
