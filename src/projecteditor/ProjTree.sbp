' プロジェクト ウィンドウのツリー（WC_TREEVIEW、Windows 版だけ）。
' ルートは .pj のファイル名、その下に #SOURCE のファイル。相対パスにフォルダーがあれば
' フォルダーのノード（"..\common" など）にまとめる。文字は TVM_INSERTITEMW（UTF-8 → UTF-16）。
' <.pj の名前>.wnd があれば、<.pj の名前>.abp のノードの下にぶら下げる（無ければルートの末尾）。
' 各ノードの lParam は g_projRel / g_projFull の番号（ルートとフォルダーは -1、.wnd は PT_WND）。
' 選んだら（TVN_SELCHANGED）かダブルクリックしたら（NM_DBLCLK）、そのファイルを開くか前面にする（ProjOpenIndex）。
' アイコンはシェルのシステム イメージ リスト（SHGetFileInfoW、拡張子だけで引く）。フォルダーのノードはフォルダーの絵。
' Linux 版は LxFrame.sbp の自前描画のリストのまま。

#ifndef _LINUX
Const PT_TVM_INSERTITEMW = &H1132   ' TV_FIRST + 50
Const PT_TVM_GETITEMA = &H110C      ' TV_FIRST + 12
Const PT_TVGN_CARET = 9
Const PT_TVN_SELCHANGEDW = -451     ' TVN_FIRST - 51
Const PT_WND = -2                   ' .wnd のノードの lParam
Const PT_NOMENU = -3                ' 右クリックのメニューを出さない（ProjTree_MenuIndex）
Const PT_STYLE = &H27               ' TVS_HASBUTTONS | TVS_HASLINES | TVS_LINESATROOT | TVS_SHOWSELALWAYS
Const PT_TVM_HITTEST = &H1111       ' TV_FIRST + 17
Const PT_TVM_SELECTITEM = &H110B    ' TV_FIRST + 11
Const PT_TVGN_DROPHILITE = 8
Const PT_TVHT_ONITEM = &H46         ' TVHT_ONITEMICON | TVHT_ONITEMLABEL | TVHT_ONITEMSTATEICON

Const PT_SHGFI_SMALLICON = &H1
Const PT_SHGFI_USEFILEATTRIBUTES = &H10
Const PT_SHGFI_SYSICONINDEX = &H4000
Const PT_FA_DIRECTORY = &H10
Const PT_FA_NORMAL = &H80

' SHFILEINFOW（szDisplayName は WCHAR 260、szTypeName は WCHAR 80）
Type PT_SHFILEINFOW
    hIcon As VoidPtr
    iIcon As Long
    dwAttributes As DWord
    szDisplayName(519) As Byte
    szTypeName(159) As Byte
End Type

Declare Function PT_SHGetFileInfoW Lib "shell32.dll" Alias "SHGetFileInfoW" (ByVal pszPath As *Byte, ByVal dwFileAttributes As DWord, ByRef psfi As PT_SHFILEINFOW, ByVal cbFileInfo As DWord, ByVal uFlags As DWord) As LONG_PTR

Type PT_TVHITTESTINFO
    pt As POINTAPI
    flags As DWord
    hItem As HTREEITEM
End Type

Dim g_ptRoot As HTREEITEM
Dim g_ptDirCount As Long
Dim g_ptDirName(127) As String
Dim g_ptDirItem(127) As VoidPtr
Dim g_ptIns As TVINSERTSTRUCT
Dim g_ptItem As TVITEM
Dim g_ptInited As Long
Dim g_ptWndAt As VoidPtr            ' .wnd をぶら下げたノード（まだなら 0）
Dim g_ptSfi As PT_SHFILEINFOW
Dim g_ptDirIcon As Long             ' フォルダーの絵の番号（-1 ならまだ引いていない）

Sub ProjTree_InitCtl()
    Dim icc As INITCOMMONCONTROLSEX
    If g_ptInited <> 0 Then Exit Sub
    g_ptInited = 1
    icc.dwSize = SizeOf(INITCOMMONCONTROLSEX)
    icc.dwICC = ICC_TREEVIEW_CLASSES
    InitCommonControlsEx(icc)
End Sub

Sub ProjTree_Make(hWnd As HWND)
    Dim style As DWord
    ProjTree_InitCtl()
    style = WS_CHILD Or WS_VISIBLE Or WS_BORDER Or PT_STYLE
    g_hProjList = CreateWindowEx(0, "SysTreeView32", "", style, 0, 0, 100, 100, hWnd, ID_PROJLIST As HMENU, g_hInst, 0)
    SendMessage(g_hProjList, WM_SETFONT, GetStockObject(DEFAULT_GUI_FONT) As WPARAM, 0)
    g_ptDirIcon = -1
    ProjTree_SetImages()
End Sub

' 名前（拡張子だけ見る）と属性から、システム イメージ リスト（小さい絵）を引く。戻り値はリストのハンドル、
' 絵の番号は g_ptSfi.iIcon
Function ProjTree_ShInfo(name As String, ByVal attr As DWord) As LONG_PTR
    Dim wide As *Byte, chars As Long, flags As DWord
    FillMemory(VarPtr(g_ptSfi), SizeOf(PT_SHFILEINFOW), 0)
    flags = PT_SHGFI_SYSICONINDEX Or PT_SHGFI_SMALLICON Or PT_SHGFI_USEFILEATTRIBUTES
    wide = Enc_Utf8ToWide(name, chars)
    ProjTree_ShInfo = PT_SHGetFileInfoW(wide, attr, g_ptSfi, SizeOf(PT_SHFILEINFOW), flags)
    If wide <> 0 Then free(wide)
End Function

' ツリーにシステム イメージ リストを付ける（ツリーはこのリストを壊さない）
Sub ProjTree_SetImages()
    Dim himl As LONG_PTR
    himl = ProjTree_ShInfo("a.txt", PT_FA_NORMAL)
    If himl <> 0 Then SendMessage(g_hProjList, TVM_SETIMAGELIST, TVSIL_NORMAL, himl As LPARAM)
End Sub

' ファイルの絵の番号（引けなければ 0）
Function ProjTree_FileIcon(name As String) As Long
    ProjTree_FileIcon = 0
    If ProjTree_ShInfo(name, PT_FA_NORMAL) <> 0 Then ProjTree_FileIcon = g_ptSfi.iIcon
End Function

' フォルダーの絵の番号（一度だけ引く）
Function ProjTree_DirIcon() As Long
    If g_ptDirIcon < 0 Then
        g_ptDirIcon = 0
        If ProjTree_ShInfo("folder", PT_FA_DIRECTORY) <> 0 Then g_ptDirIcon = g_ptSfi.iIcon
    End If
    ProjTree_DirIcon = g_ptDirIcon
End Function

' TVI_ROOT / TVI_LAST（負の数）のハンドル。Long から LONG_PTR（VoidPtr）へは上位が 0 で
' 広がる（64bit で FFFF0000 になり、TVI_ROOT と見なされない）ので、Int64 を通して符号を広げる
Function ProjTree_Special(ByVal v As Int64) As LONG_PTR
    ProjTree_Special = v As LONG_PTR
End Function

' 挿入の形を g_ptIns に作る（末尾に足す）
Sub ProjTree_FillIns(parent As HTREEITEM, wide As *Byte, ByVal idx As Long, ByVal img As Long)
    FillMemory(VarPtr(g_ptIns), SizeOf(TVINSERTSTRUCT), 0)
    g_ptIns.hParent = parent
    g_ptIns.hInsertAfter = ProjTree_Special(TVI_LAST) As HTREEITEM
    g_ptIns.item.mask = TVIF_TEXT Or TVIF_PARAM Or TVIF_IMAGE Or TVIF_SELECTEDIMAGE
    g_ptIns.item.pszText = wide
    g_ptIns.item.lParam = idx As LPARAM
    g_ptIns.item.iImage = img
    g_ptIns.item.iSelectedImage = img
End Sub

' ファイルのノード（絵は拡張子から）
Function ProjTree_Insert(parent As HTREEITEM, text As String, ByVal idx As Long) As HTREEITEM
    ProjTree_Insert = ProjTree_InsertImg(parent, text, idx, ProjTree_FileIcon(text))
End Function

Function ProjTree_InsertImg(parent As HTREEITEM, text As String, ByVal idx As Long, ByVal img As Long) As HTREEITEM
    Dim wide As *Byte, chars As Long
    wide = Enc_Utf8ToWide(text, chars)
    ProjTree_FillIns(parent, wide, idx, img)
    ProjTree_InsertImg = SendMessage(g_hProjList, PT_TVM_INSERTITEMW, 0, VarPtr(g_ptIns) As LPARAM) As HTREEITEM
    If wide <> 0 Then free(wide)
End Function

' フォルダーのノード（無ければルートの下に作る）
Function ProjTree_DirNode(dir As String) As HTREEITEM
    Dim i As Long
    For i = 0 To g_ptDirCount - 1
        If ProjTree_SameDir(g_ptDirName(i), dir) <> 0 Then ProjTree_DirNode = g_ptDirItem(i) : Exit Function
    Next
    ProjTree_DirNode = ProjTree_NewDir(dir)
End Function

' フォルダーのノードを足して覚える（128 個まで）
Function ProjTree_NewDir(dir As String) As HTREEITEM
    ProjTree_NewDir = ProjTree_InsertImg(g_ptRoot, dir, -1, ProjTree_DirIcon())
    If g_ptDirCount >= 128 Then Exit Function
    g_ptDirName(g_ptDirCount) = dir
    g_ptDirItem(g_ptDirCount) = ProjTree_NewDir
    g_ptDirCount = g_ptDirCount + 1
End Function

Function ProjTree_HasWnd() As Long
    ProjTree_HasWnd = 0
    If g_ptWndAt <> 0 Then Exit Function
    ProjTree_HasWnd = AB4Proj_Exists(EditorProjCmd_WndPath$(g_projectPath))
End Function

' .wnd のノードを parent の下に足す（.wnd が無いか、もう足したなら何もしない）
Sub ProjTree_AddWnd(parent As HTREEITEM)
    If ProjTree_HasWnd() = 0 Then Exit Sub
    ProjTree_Insert(parent, ProjTree_WndName$(g_projectPath), PT_WND)
    g_ptWndAt = parent As VoidPtr
End Sub

Sub ProjTree_AddFile(ByVal i As Long)
    Dim dir As String, parent As HTREEITEM, h As HTREEITEM
    dir = ProjTree_Dir$(g_projRel(i))
    parent = g_ptRoot
    If Len(dir) > 0 Then parent = ProjTree_DirNode(dir)
    h = ProjTree_Insert(parent, ProjTree_Name$(g_projRel(i)), i)
    If ProjTree_IsMainSrc(g_projRel(i), g_projectPath) <> 0 Then ProjTree_AddWnd(h)
End Sub

Sub ProjTree_Expand(h As HTREEITEM)
    If h <> 0 Then SendMessage(g_hProjList, TVM_EXPAND, TVE_EXPAND, h As LPARAM)
End Sub

Sub ProjTree_ExpandAll()
    Dim i As Long
    For i = 0 To g_ptDirCount - 1
        ProjTree_Expand(g_ptDirItem(i))
    Next
    ProjTree_Expand(g_ptWndAt)
    ProjTree_Expand(g_ptRoot)
End Sub

Sub ProjTree_Clear()
    SendMessage(g_hProjList, TVM_DELETEITEM, 0, ProjTree_Special(TVI_ROOT) As LPARAM)
    g_ptDirCount = 0
    g_ptRoot = 0
    g_ptWndAt = 0
End Sub

' 一覧を作り直す
Sub ProjFillList()
    If g_hProjList = 0 Then Exit Sub
    ProjTree_Clear()
    g_ptRoot = ProjTree_Insert(0, ProjTree_Name$(g_projectPath), -1)
    ProjTree_AddFiles()
    ProjTree_AddWnd(g_ptRoot)
    ProjTree_ExpandAll()
End Sub

Sub ProjTree_AddFiles()
    Dim i As Long
    For i = 0 To g_projCount - 1
        ProjTree_AddFile(i)
    Next
End Sub

' 今選んでいるノードの番号（ルート・フォルダー・無しなら -1）
Function ProjTree_SelIndex() As Long
    Dim h As HTREEITEM
    ProjTree_SelIndex = -1
    h = SendMessage(g_hProjList, TVM_GETNEXTITEM, PT_TVGN_CARET, 0) As HTREEITEM
    If h <> 0 Then ProjTree_SelIndex = ProjTree_ItemParam(h)
End Function

' ノードの lParam（ファイルの番号。読めなければ -1）
Function ProjTree_ItemParam(h As HTREEITEM) As Long
    ProjTree_ItemParam = -1
    FillMemory(VarPtr(g_ptItem), SizeOf(TVITEM), 0)
    g_ptItem.mask = TVIF_PARAM Or TVIF_HANDLE
    g_ptItem.hItem = h
    If SendMessage(g_hProjList, PT_TVM_GETITEMA, 0, VarPtr(g_ptItem) As LPARAM) = 0 Then Exit Function
    ProjTree_ItemParam = g_ptItem.lParam As Long
End Function

' 選んでいるノードのファイルを開く（開いていれば前面にする。ルートとフォルダーは何もしない）
Sub ProjTree_OpenSel()
    Dim i As Long
    i = ProjTree_SelIndex()
    If i = PT_WND Then
        ProjOpenPath(EditorProjCmd_WndPath$(g_projectPath))
    Else
        ProjOpenIndex(i)
    End If
End Sub

' ノードを開く通知なら 1。選んだノードが変わった時と、ダブルクリックの時
' （選んだままのノードは選び直しても TVN_SELCHANGED が来ない。文書をすべて閉じた後など）
Function ProjTree_IsOpenCode(ByVal code As Long) As Long
    ProjTree_IsOpenCode = 0
    If code = TVN_SELCHANGED Or code = PT_TVN_SELCHANGEDW Or code = NM_DBLCLK Then ProjTree_IsOpenCode = 1
End Function

' マウスの下のノード（無ければ 0）
Function ProjTree_HitItem() As HTREEITEM
    Dim ht As PT_TVHITTESTINFO
    ProjTree_HitItem = 0
    GetCursorPos(ht.pt)
    ScreenToClient(g_hProjList, ht.pt)
    If SendMessage(g_hProjList, PT_TVM_HITTEST, 0, VarPtr(ht) As LPARAM) = 0 Then Exit Function
    If (ht.flags And PT_TVHT_ONITEM) = 0 Then Exit Function
    ProjTree_HitItem = ht.hItem
End Function

' 右クリックのメニューの番号（ProjEdit_Menu の idx）。ルートは PROJEDIT_ROOT、ファイルはその番号、
' フォルダー・.wnd・ノードの外は PT_NOMENU
Function ProjTree_MenuIndex(h As HTREEITEM) As Long
    Dim idx As Long
    ProjTree_MenuIndex = PT_NOMENU
    If h = 0 Then Exit Function
    If h = g_ptRoot Then ProjTree_MenuIndex = PROJEDIT_ROOT : Exit Function
    idx = ProjTree_ItemParam(h)
    If idx >= 0 Then ProjTree_MenuIndex = idx
End Function

' h を薄く強調する（0 なら強調を消す）
Sub ProjTree_DropHilite(h As HTREEITEM)
    If g_hProjList <> 0 Then SendMessage(g_hProjList, PT_TVM_SELECTITEM, PT_TVGN_DROPHILITE, h As LPARAM)
End Sub

' 右クリック: ルートなら「ファイルを挿入」、ファイルなら「プロジェクトから削除」「プロパティ」（ProjEdit.sbp）。
' 選んでいるノードは変えない（変えるとそのファイルが開く）。メニューを出す間だけ薄く強調する
Sub ProjTree_RClick()
    Dim h As HTREEITEM, idx As Long, pt As POINTAPI
    h = ProjTree_HitItem()
    idx = ProjTree_MenuIndex(h)
    If idx = PT_NOMENU Then Exit Sub
    GetCursorPos(pt)
    ProjTree_DropHilite(h)
    ProjEdit_Menu(g_hProject, idx, pt.x, pt.y)
    ProjTree_DropHilite(0)
End Sub

' WM_NOTIFY。右クリックを受け持ったら 1（既定の WM_CONTEXTMENU を出さない）
Function ProjOnNotify(lParam As LPARAM) As Long
    Dim nm As *NMHDR
    ProjOnNotify = 0
    nm = lParam As *NMHDR
    If nm = 0 Then Exit Function
    If nm->hwndFrom <> g_hProjList Then Exit Function
    If ProjTree_IsOpenCode(nm->code As Long) <> 0 Then ProjTree_OpenSel()
    If nm->code = NM_RCLICK Then
        ProjTree_RClick()
        ProjOnNotify = 1
    End If
End Function
#endif
