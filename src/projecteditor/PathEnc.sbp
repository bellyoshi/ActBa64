' 外から来たパスのバイト列を UTF-8 の String に。妥当な UTF-8 ならそのまま、違えば CP932 とみて直す。
' GetCmd（GetCommandLineA）・DragQueryFile・GetModuleFileName は CP932 を返す。

Function PathEnc_Bytes$(p As *Byte, n As Long) As String
    Dim s As String
    s = ZeroString(n)
    memcpy(StrPtr(s), p, n)
    PathEnc_Bytes$ = s
End Function

Function PathEnc_Utf8$(p As *Byte, n As Long) As String
    Dim u As *Byte, m As Long
    If n <= 0 Then Exit Function
    PathEnc_Utf8$ = PathEnc_Bytes$(p, n)
    If BasicUtf8Chars(p, n) > 0 Then Exit Function
    u = BasicCpToUtf8(p, n, m)
    If u = 0 Then Exit Function
    PathEnc_Utf8$ = PathEnc_Bytes$(u, m)
    free(u)
End Function
