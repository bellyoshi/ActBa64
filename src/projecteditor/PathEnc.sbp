' 外から来たパスのバイト列を UTF-8 の String に。妥当な UTF-8 ならそのまま、違えば CP932 とみて直す。
' GetCmd（GetCommandLineA）・DragQueryFile・GetModuleFileName は CP932 を返す。

Function PathEnc_Bytes$(p As *Byte, n As Long) As String
    Dim s As String
    s = ZeroString(n)
    memcpy(StrPtr(s), p, n)
    PathEnc_Bytes$ = s
End Function

Function PathEnc_Utf8$(p As *Byte, n As Long) As String
    Dim u As *Byte, m As Long
    If n <= 0 Then Exit Function
    PathEnc_Utf8$ = PathEnc_Bytes$(p, n)
    If BasicUtf8Chars(p, n) > 0 Then Exit Function
    u = BasicCpToUtf8(p, n, m)
    If u = 0 Then Exit Function
    PathEnc_Utf8$ = PathEnc_Bytes$(u, m)
    free(u)
End Function

' s の st バイト目（0 始まり）から en の手前までを PathEnc_Utf8$ に
Function PathEnc_Line$(s As String, st As Long, en As Long) As String
    Dim t As String
    t = Mid$(s, st + 1, en - st)
    PathEnc_Line$ = PathEnc_Utf8$(StrPtr(t), Len(t))
End Function

' コンパイラの出力を行（LF まで）ごとに UTF-8 へ。コンパイラは GetCommandLineA の CP932 のパスをそのまま出す。
Function PathEnc_Lines$(s As String) As String
    Dim i As Long, st As Long, out As String
    st = 0
    For i = 0 To Len(s) - 1
        If s[i] = 10 Then out = out + PathEnc_Line$(s, st, i + 1)
        If s[i] = 10 Then st = i + 1
    Next
    PathEnc_Lines$ = out + PathEnc_Line$(s, st, Len(s))
End Function
