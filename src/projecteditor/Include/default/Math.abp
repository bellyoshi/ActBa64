' Math.abp — IEEE Double 数学ライブラリ（default 常時読込）
'
' 角度はラジアン（Double）。例: Sin(1.5707963267948966) ≒ 1.0
' Sin/Cos はマクローリン展開（範囲還元付き）
'
' ネスト呼び出しは一時変数経由が安全。
'
' 整数ヘルパ MathDiv / MathMod / Abs(Long 用途は Double 版 Abs) も提供。

' ---------- 定数（Const は整数のみのため Function）----------

Function MathPi() As Double
    MathPi = 3.141592653589793
End Function

Function MathE() As Double
    MathE = 2.718281828459045
End Function

' ---------- 整数ヘルパ ----------

Function MathDiv(a As Long, b As Long) As Long
    Dim neg As Long
    Dim n As Long
    Dim d As Long
    Dim q As Long

    MathDiv = 0
    If b = 0 Then Exit Function
    neg = 0
    n = a
    d = b
    If n < 0 Then
        neg = 1
        n = 0 - n
    End If
    If d < 0 Then
        If neg <> 0 Then
            neg = 0
        Else
            neg = 1
        End If
        d = 0 - d
    End If
    q = 0
    While n >= d
        n = n - d
        q = q + 1
    Wend
    If neg <> 0 Then
        MathDiv = 0 - q
    Else
        MathDiv = q
    End If
End Function

Function MathMod(a As Long, b As Long) As Long
    Dim q As Long
    If b = 0 Then
        MathMod = 0
        Exit Function
    End If
    q = MathDiv(a, b)
    MathMod = a - q * b
End Function

Function Abs(n As Double) As Double
    If n < 0 Then
        Abs = 0 - n
    Else
        Abs = n
    End If
End Function

Function Sgn(n As Long) As Long
    If n > 0 Then
        Sgn = 1
    ElseIf n < 0 Then
        Sgn = -1
    Else
        Sgn = 0
    End If
End Function

Function Min(a As Long, b As Long) As Long
    If a < b Then
        Min = a
    Else
        Min = b
    End If
End Function

Function Max(a As Long, b As Long) As Long
    If a > b Then
        Max = a
    Else
        Max = b
    End If
End Function

' ---------- 変換・床 ----------

Function Fix(n As Double) As Double
    Dim t As Long
    t = n
    Fix = t
End Function

Function Int(n As Double) As Double
    Dim t As Long
    Dim f As Double
    t = n
    f = t
    If n < 0 Then
        If n <> f Then
            Int = f - 1
        Else
            Int = f
        End If
    Else
        Int = f
    End If
End Function

Function DegToRad(deg As Double) As Double
    Dim pi As Double
    pi = MathPi()
    DegToRad = deg * pi / 180
End Function

Function RadToDeg(rad As Double) As Double
    Dim pi As Double
    pi = MathPi()
    RadToDeg = rad * 180 / pi
End Function

' ---------- 平方根・指数・対数 ----------

Function Sqr(n As Double) As Double
    Dim x As Double
    Dim y As Double
    Sqr = 0
    If n <= 0 Then Exit Function
    x = n
    If x < 1 Then x = 1
    Do
        y = (x + n / x) / 2
        If y >= x Then Exit Do
        If x - y < 0.0000000001 Then Exit Do
        x = y
    Loop
    Sqr = x
End Function

Function Exp(x As Double) As Double
    Dim t As Double
    Dim s As Double
    Dim k As Long
    Dim xx As Double
    xx = x
    If xx > 20 Then xx = 20
    If xx < 0 - 20 Then xx = 0 - 20
    t = 1
    s = 1
    k = 1
    Do
        t = t * xx / k
        If t = 0 Then Exit Do
        s = s + t
        k = k + 1
        If k > 40 Then Exit Do
    Loop
    Exp = s
End Function

Function Log(n As Double) As Double
    Dim x As Double
    Dim e As Long
    Dim z As Double
    Dim z2 As Double
    Dim t As Double
    Dim s As Double
    Dim k As Long
    Dim ln2 As Double

    Log = 0
    If n <= 0 Then Exit Function
    ln2 = 0.6931471805599453
    x = n
    e = 0
    While x >= 2
        x = x / 2
        e = e + 1
    Wend
    While x < 1
        x = x * 2
        e = e - 1
    Wend
    z = (x - 1) / (x + 1)
    z2 = z * z
    t = z
    s = z
    k = 3
    Do
        t = t * z2
        s = s + t / k
        k = k + 2
        If k > 40 Then Exit Do
    Loop
    s = s + s
    Log = s + e * ln2
End Function

Function Log10(n As Double) As Double
    Dim ln10 As Double
    Log10 = 0
    If n <= 0 Then Exit Function
    ln10 = 2.302585092994046
    Log10 = Log(n) / ln10
End Function

' ---------- 三角 ----------

Function MathNormPi(ang As Double) As Double
    Dim a As Double
    Dim pi As Double
    Dim twopi As Double
    pi = MathPi()
    twopi = pi + pi
    a = ang
    While a > pi
        a = a - twopi
    Wend
    While a < 0 - pi
        a = a + twopi
    Wend
    MathNormPi = a
End Function

Function MathSinSeries(x As Double) As Double
    Dim t As Double
    Dim s As Double
    Dim x2 As Double
    Dim k As Long
    Dim den As Long
    t = x
    s = x
    x2 = x * x
    k = 1
    Do
        den = (k + k) * (k + k + 1)
        t = 0 - t * x2 / den
        If t = 0 Then Exit Do
        s = s + t
        k = k + 1
        If k > 24 Then Exit Do
    Loop
    MathSinSeries = s
End Function

Function MathCosSeries(x As Double) As Double
    Dim t As Double
    Dim s As Double
    Dim x2 As Double
    Dim k As Long
    Dim den As Long
    t = 1
    s = 1
    x2 = x * x
    k = 1
    Do
        den = (k + k - 1) * (k + k)
        t = 0 - t * x2 / den
        If t = 0 Then Exit Do
        s = s + t
        k = k + 1
        If k > 24 Then Exit Do
    Loop
    MathCosSeries = s
End Function

Function Sin(ang As Double) As Double
    Dim x As Double
    Dim neg As Long
    Dim v As Double
    Dim pi As Double
    Dim hpi As Double
    x = MathNormPi(ang)
    neg = 0
    If x < 0 Then
        neg = 1
        x = 0 - x
    End If
    pi = MathPi()
    hpi = pi / 2
    If x > hpi Then x = pi - x
    v = MathSinSeries(x)
    If v > 1 Then v = 1
    If neg <> 0 Then
        Sin = 0 - v
    Else
        Sin = v
    End If
End Function

Function Cos(ang As Double) As Double
    Dim x As Double
    Dim sign As Long
    Dim v As Double
    Dim pi As Double
    Dim hpi As Double
    x = MathNormPi(ang)
    sign = 1
    If x < 0 Then x = 0 - x
    pi = MathPi()
    hpi = pi / 2
    If x > hpi Then
        x = pi - x
        sign = -1
    End If
    v = MathCosSeries(x)
    If v > 1 Then v = 1
    If v < 0 Then v = 0
    Cos = sign * v
End Function

Function Tan(ang As Double) As Double
    Dim c As Double
    Dim s As Double
    c = Cos(ang)
    s = Sin(ang)
    If c = 0 Then
        If s >= 0 Then
            Tan = 1000000000
        Else
            Tan = 0 - 1000000000
        End If
        Exit Function
    End If
    Tan = s / c
End Function

Function SinDeg(deg As Double) As Double
    Dim r As Double
    r = DegToRad(deg)
    SinDeg = Sin(r)
End Function

Function CosDeg(deg As Double) As Double
    Dim r As Double
    r = DegToRad(deg)
    CosDeg = Cos(r)
End Function

Function MathAtnSeries(x As Double) As Double
    Dim t As Double
    Dim s As Double
    Dim x2 As Double
    Dim n As Long
    t = x
    s = x
    x2 = x * x
    n = 3
    Do
        t = 0 - t * x2
        s = s + t / n
        n = n + 2
        If n > 40 Then Exit Do
    Loop
    MathAtnSeries = s
End Function

Function Atn(x As Double) As Double
    Dim ax As Double
    Dim v As Double
    Dim inv As Double
    Dim hpi As Double
    ax = Abs(x)
    hpi = MathPi() / 2
    If ax <= 1 Then
        v = MathAtnSeries(ax)
    Else
        inv = 1 / ax
        v = MathAtnSeries(inv)
        v = hpi - v
    End If
    If x < 0 Then
        Atn = 0 - v
    Else
        Atn = v
    End If
End Function

' ---------- 乱数 ----------

Dim g_rndSeed As Long

Sub Randomize()
    g_rndSeed = GetTickCount()
    If g_rndSeed = 0 Then g_rndSeed = 1
End Sub

Sub RandomizeSeed(n As Long)
    g_rndSeed = n
End Sub

' [0, 1) の Double
Function Rnd() As Double
    If g_rndSeed = 0 Then Randomize()
    g_rndSeed = g_rndSeed * 1103515245 + 12345
    g_rndSeed = g_rndSeed And 2147483647
    Rnd = (g_rndSeed And 65535) / 65536
End Function
