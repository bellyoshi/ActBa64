' DoubleStr.abp — IEEE Double → 文字列（default 常時読込）
'
' Print が Double 式を表示するとき StrD$ を呼ぶ。
' ネストした関数呼び出しを避けるため、一時変数経由で連結する。
' 小数は 6 桁に丸めてから出力し、末尾の 0 は落とす。
' |d| が Long 範囲（約 2^31）を超える場合は簡略表示。
'
' 注意: この関数内で Chr$ を While と組み合わせると、未使用でも
' Input 文字列比較が壊れる事例があるため、桁は Mid$ で取る。

Function StrDFrac$(ByRef s As String, n As Long, digits As String) As String
    Dim digit As Long
    Dim i As Long
    Dim last As Long
    Dim t As String
    Dim fracBuf(7) As Byte

    StrDFrac$ = s
    If n <= 0 Then Exit Function
    i = 5
    While i >= 0
        digit = MathMod(n, 10)
        fracBuf[i] = digit
        n = MathDiv(n, 10)
        i = i - 1
    Wend
    last = 5
    While last > 0
        If fracBuf[last] <> 0 Then
            Exit While
        End If
        last = last - 1
    Wend
    s = s + "."
    i = 0
    While i <= last
        t = Mid$(digits, fracBuf[i] + 1, 1)
        s = s + t
        i = i + 1
    Wend
    StrDFrac$ = s
End Function

Function StrDParts(ByRef x As Double, ByRef ip As Long, ByRef n As Long) As Long
    Dim one As Double
    Dim half As Double
    Dim scale As Double
    Dim ipAsD As Double
    Dim frac As Double
    one = 1
    half = one / 2
    scale = 1000000
    ip = x
    ipAsD = ip
    frac = x - ipAsD
    frac = frac * scale + half
    n = frac
    If n >= 1000000 Then
        ip = ip + 1
        n = 0
    End If
    StrDParts = 1
End Function

Function StrD$(d As Double) As String
    Dim x As Double
    Dim zero As Double
    Dim maxIp As Double
    Dim ip As Long
    Dim n As Long
    Dim neg As Long
    Dim sign As String
    Dim s As String
    Dim t As String
    Dim digits As String

    digits = "0123456789"
    zero = 0
    maxIp = 2147483647
    x = d
    neg = 0
    If x < zero Then
        neg = 1
        x = zero - x
    End If
    If x > maxIp Then
        If neg <> 0 Then
            StrD$ = "-inf"
        Else
            StrD$ = "inf"
        End If
        Exit Function
    End If
    StrDParts(x, ip, n)
    sign = ""
    If neg <> 0 Then
        sign = "-"
    End If
    t = Str$(ip)
    s = sign + t
    s = StrDFrac$(s, n, digits)
    StrD$ = s
End Function
