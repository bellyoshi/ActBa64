' Space$ — 指定した文字数分の空白文字列を返す
'
' 仕様:
'   Space$(length)
'   length が 0 以下の場合は空文字列を返す
Function Space$(length As Long) As String
    Dim result As String
    Dim i As Long

    result = ""
    If length <= 0 Then
        Space$ = result
        Exit Function
    End If

    For i = 1 To length
        result = result + " "
    Next
    Space$ = result
End Function
