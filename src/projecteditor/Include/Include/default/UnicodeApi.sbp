' Unicode APIs needed by actba64 programs.
' ActiveBasic 4.20 already provides these declarations in its standard headers.

Declare Function MultiByteToWideChar Lib "kernel32.dll" (ByVal CodePage As DWord, ByVal dwFlags As DWord, ByVal lpMultiByteStr As *Byte, ByVal cbMultiByte As Long, ByVal lpWideCharStr As *Byte, ByVal cchWideChar As Long) As Long
Declare Function WideCharToMultiByte Lib "kernel32.dll" (ByVal CodePage As DWord, ByVal dwFlags As DWord, ByVal lpWideCharStr As *Byte, ByVal cchWideChar As Long, ByVal lpMultiByteStr As *Byte, ByVal cbMultiByte As Long, ByVal lpDefaultChar As *Byte, ByVal lpUsedDefaultChar As *Byte) As Long
Declare Function TextOutW Lib "gdi32.dll" (ByVal hdc As HDC, ByVal x As Long, ByVal y As Long, ByVal lpString As *Byte, ByVal c As Long) As Long
Declare Function GetTextExtentPoint32W Lib "gdi32.dll" (ByVal hdc As HDC, ByVal lpString As *Byte, ByVal c As Long, ByRef lpSize As SIZE) As Long
