' dx_graphics.sbp - D3D11 共通 API（AB 4.20 dx_graphics.sbp の D3D11 最小相当）
' 使用前に #include "d3d11.sbp" すること。

Dim g_pDevice As *ID3D11Device
Dim g_pContext As *ID3D11DeviceContext
Dim g_pSwapChain As *IDXGISwapChain
Dim g_pRTV As *ID3D11RenderTargetView
Dim g_dxHwnd As HWND
Dim g_vpW As Long
Dim g_vpH As Long

Dim IID_ID3D11Texture2D As GUID

Declare Function lstrlenA Lib "kernel32.dll" (lpString As BytePtr) As Long

Sub dx_SetupTexture2dIid()
	IID_ID3D11Texture2D.Data1 = &H6F15AAF2
	IID_ID3D11Texture2D.Data2 = &HD208
	IID_ID3D11Texture2D.Data3 = &H4E89
	IID_ID3D11Texture2D.Data4[0] = &H9A
	IID_ID3D11Texture2D.Data4[1] = &HB4
	IID_ID3D11Texture2D.Data4[2] = &H48
	IID_ID3D11Texture2D.Data4[3] = &H95
	IID_ID3D11Texture2D.Data4[4] = &H35
	IID_ID3D11Texture2D.Data4[5] = &HD3
	IID_ID3D11Texture2D.Data4[6] = &H4F
	IID_ID3D11Texture2D.Data4[7] = &H9C
End Sub

Function D3DCOLOR_XRGB(r As DWord, g As DWord, b As DWord) As DWord
	D3DCOLOR_XRGB = &HFF000000 Or (r And &HFF) Or ((g And &HFF) * &H100) Or ((b And &HFF) * &H10000)
End Function

Function dx_D3dColorToGdi(c As DWord) As DWord
	Dim r As DWord
	Dim g As DWord
	Dim b As DWord
	r = c And &HFF
	g = (c \ &H100) And &HFF
	b = (c \ &H10000) And &HFF
	dx_D3dColorToGdi = r Or (g * &H100) Or (b * &H10000)
End Function

Function dx_Init(hWnd As DWord, ScreenX As Long, ScreenY As Long, bWindowMode As Long) As Long
	CoInitialize(NULL)
	g_dxHwnd = hWnd

	Dim rc As RECT
	GetClientRect(hWnd, rc)
	Dim w As Long
	Dim h As Long
	w = rc.right - rc.left
	h = rc.bottom - rc.top
	If ScreenX > 0 Then w = ScreenX
	If ScreenY > 0 Then h = ScreenY
	If w < 1 Then w = 640
	If h < 1 Then h = 480
	g_vpW = w
	g_vpH = h

	Dim sd As DXGI_SWAP_CHAIN_DESC
	ZeroMemory(VarPtr(sd), Len(sd))
	sd.BufferDesc.Width = w
	sd.BufferDesc.Height = h
	sd.BufferDesc.RefreshRate.Numerator = 60
	sd.BufferDesc.RefreshRate.Denominator = 1
	sd.BufferDesc.Format = DXGI_FORMAT_R8G8B8A8_UNORM
	sd.SampleDesc.Count = 1
	sd.SampleDesc.Quality = 0
	sd.BufferUsage = DXGI_USAGE_RENDER_TARGET_OUTPUT
	sd.BufferCount = 1
	sd.OutputWindow = hWnd
	If bWindowMode Then
		sd.Windowed = TRUE
	Else
		sd.Windowed = FALSE
	End If
	sd.SwapEffect = DXGI_SWAP_EFFECT_DISCARD

	Dim fl[1] As DWord
	fl[0] = D3D_FEATURE_LEVEL_11_0
	fl[1] = D3D_FEATURE_LEVEL_10_0

	Dim hr As DWord
	hr = D3D11CreateDeviceAndSwapChain(0, D3D_DRIVER_TYPE_HARDWARE, 0, 0, VarPtr(fl[0]), 2, D3D11_SDK_VERSION, VarPtr(sd), g_pSwapChain, g_pDevice, 0, g_pContext)
	If hr Then
		hr = D3D11CreateDeviceAndSwapChain(0, D3D_DRIVER_TYPE_WARP, 0, 0, VarPtr(fl[0]), 2, D3D11_SDK_VERSION, VarPtr(sd), g_pSwapChain, g_pDevice, 0, g_pContext)
	End If
	If hr Then
		MessageBox(hWnd, "D3D11CreateDeviceAndSwapChain failed.", "Error", MB_OK or MB_ICONSTOP)
		dx_Init = 0
		Exit Function
	End If

	Dim pBackBuffer As *IUnknown
	pBackBuffer = 0
	dx_SetupTexture2dIid()
	hr = g_pSwapChain->GetBuffer(0, IID_ID3D11Texture2D, VarPtr(pBackBuffer))
	If hr Then
		MessageBox(hWnd, "IDXGISwapChain::GetBuffer failed.", "Error", MB_OK or MB_ICONSTOP)
		dx_Quit()
		dx_Init = 0
		Exit Function
	End If

	hr = g_pDevice->CreateRenderTargetView(pBackBuffer, 0, VarPtr(g_pRTV))
	pBackBuffer->Release()
	If hr Then
		MessageBox(hWnd, "CreateRenderTargetView failed.", "Error", MB_OK or MB_ICONSTOP)
		dx_Quit()
		dx_Init = 0
		Exit Function
	End If

	dx_Init = 1
End Function

Function dx_GetDevice() As *ID3D11Device
	dx_GetDevice = g_pDevice
End Function

Sub dx_BeginScene()
	Dim vp[5] As Single
	If g_pContext = 0 Then Exit Sub
	vp[0] = 0.0
	vp[1] = 0.0
	vp[2] = g_vpW
	vp[3] = g_vpH
	vp[4] = 0.0
	vp[5] = 1.0
	g_pContext->OMSetRenderTargets(1, VarPtr(g_pRTV), 0)
	g_pContext->RSSetViewports(1, VarPtr(vp[0]))
End Sub

Sub dx_Clear()
	Dim clearColor[3] As Single
	If g_pContext = 0 Then Exit Sub
	clearColor[0] = 0.05
	clearColor[1] = 0.10
	clearColor[2] = 0.20
	clearColor[3] = 1.0
	dx_BeginScene()
	g_pContext->ClearRenderTargetView(g_pRTV, VarPtr(clearColor[0]))
End Sub

Sub dx_EndScene()
End Sub

Sub dx_Present()
	If g_pSwapChain Then g_pSwapChain->Present(1, 0)
End Sub

Sub dx_DrawText(x As Long, y As Long, psz As BytePtr, d3dColor As DWord)
	Dim hdc As HDC
	Dim n As Long
	If g_dxHwnd = 0 Then Exit Sub
	If psz = 0 Then Exit Sub
	n = lstrlenA(psz)
	If n <= 0 Then Exit Sub
	hdc = GetDC(g_dxHwnd)
	If hdc = 0 Then Exit Sub
	SetBkMode(hdc, TRANSPARENT)
	SetTextColor(hdc, dx_D3dColorToGdi(d3dColor))
	TextOutA(hdc, x, y, psz, n)
	ReleaseDC(g_dxHwnd, hdc)
End Sub

Sub dx_Quit()
	If g_pRTV Then
		g_pRTV->Release()
		g_pRTV = 0
	End If
	If g_pContext Then
		g_pContext->Release()
		g_pContext = 0
	End If
	If g_pSwapChain Then
		g_pSwapChain->Release()
		g_pSwapChain = 0
	End If
	If g_pDevice Then
		g_pDevice->Release()
		g_pDevice = 0
	End If
	g_dxHwnd = 0
	CoUninitialize()
End Sub
