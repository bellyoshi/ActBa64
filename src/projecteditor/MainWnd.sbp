Const GCS_RESULTSTR = &H0800
Const GCS_COMPSTR   = &H0008

Type POINT
    x As Long
    y As Long
End Type

Type COMPOSITIONFORM
    dwStyle As Long
    ptCurrentPos As POINT
    rcArea As RECT
End Type

Const CFS_POINT = &H0002

Dim g_imeSkipChar As Long
Dim g_cp932Lead As Long

Sub EditorAppendAnsiChar(ByVal ch As Long)
    Dim s As String
    If ch < 128 Then
        If g_cp932Lead <> 0 Then
            s = Enc_Cp932CharToUtf8$(g_cp932Lead, 0)
            If Len(s) > 0 Then TextBuf_Append(s)
            g_cp932Lead = 0
        End If
        TextBuf_AppendChar(ch)
        Exit Sub
    End If
    If g_cp932Lead = 0 Then
        If Enc_IsSjisLead(ch) <> 0 Then
            g_cp932Lead = ch
        Else
            s = Enc_Cp932CharToUtf8$(ch, 0)
            If Len(s) > 0 Then TextBuf_Append(s)
        End If
    Else
        s = Enc_Cp932CharToUtf8$(g_cp932Lead, ch)
        If Len(s) > 0 Then TextBuf_Append(s)
        g_cp932Lead = 0
    End If
End Sub

Sub UpdateImePosition(hWnd As HWND, x As Long, y As Long)
    Dim hIMC As Long
    Dim cf As COMPOSITIONFORM

    hIMC = ImmGetContext(hWnd)
    If hIMC <> 0 Then
        cf.dwStyle = CFS_POINT
        cf.ptCurrentPos.x = x
        cf.ptCurrentPos.y = y
        ImmSetCompositionWindow(hIMC, VarPtr(cf))
        ImmReleaseContext(hWnd, hIMC)
    End If
End Sub

Function ImeCompToUtf8$(hIMC As Long, dwIndex As Long) As String
    Dim n As Long
    Dim chars As Long
    Dim buf As *Byte

    ImeCompToUtf8$ = ""
    n = ImmGetCompositionStringW(hIMC, dwIndex, 0, 0)
    If n <= 0 Then Exit Function

    chars = n \ 2
    buf = malloc(n + 2)
    If buf = 0 Then Exit Function

    ImmGetCompositionStringW(hIMC, dwIndex, buf, n)
    buf[n] = 0
    buf[n + 1] = 0
    ImeCompToUtf8$ = Enc_WideToUtf8$(buf, chars)
    free(buf)
End Function

Function WheelDeltaFromWParam(ByVal wParam As WPARAM) As Long
    Dim d As Long
    d = (wParam \ 65536) And 65535
    If d >= 32768 Then d = d - 65536
    WheelDeltaFromWParam = d
End Function

Sub EditorInvalidate(hWnd As HWND)
    If hWnd = 0 Then Exit Sub
    EditorUndo_EndCoalesce()
    EditorCoreEnsureCursorVisible(hWnd)
    InvalidateRect(hWnd, ByVal 0, FALSE)
End Sub

Sub MainWnd_OnChar(hWnd As HWND, ByVal wParam As WPARAM)
    If wParam = VK_BACK Then
        g_cp932Lead = 0
        EditorCoreDeleteCharBeforeCursor()
    ElseIf wParam = 13 Then
        g_cp932Lead = 0
        TextBuf_AppendChar(10)
    ElseIf wParam >= 32 Then
        If g_imeSkipChar <> 0 Then
            g_imeSkipChar = 0
        Else
            EditorAppendAnsiChar(wParam)
        End If
    End If
    EditorInvalidate(hWnd)
End Sub

Sub MainWnd_OnKeyDown(hWnd As HWND, ByVal wParam As WPARAM)
    If wParam = VK_LEFT Then
        EditorCoreMoveCursor("left")
        EditorInvalidate(hWnd)
    ElseIf wParam = VK_RIGHT Then
        EditorCoreMoveCursor("right")
        EditorInvalidate(hWnd)
    ElseIf wParam = VK_UP Then
        EditorCoreMoveCursor("up")
        EditorInvalidate(hWnd)
    ElseIf wParam = VK_DOWN Then
        EditorCoreMoveCursor("down")
        EditorInvalidate(hWnd)
    ElseIf wParam = VK_PRIOR Then
        EditorCoreScrollBy(hWnd, -VirtualScroll_VisibleRows(hWnd))
        InvalidateRect(hWnd, ByVal 0, FALSE)
    ElseIf wParam = VK_NEXT Then
        EditorCoreScrollBy(hWnd, VirtualScroll_VisibleRows(hWnd))
        InvalidateRect(hWnd, ByVal 0, FALSE)
    ElseIf wParam = VK_F1 Then
        EditorHelp_Show(EditorHelp_KeywordAtCursor$())
    ElseIf wParam = VK_DELETE Then
        MainWnd_IDM_DELETE_MenuClick()
    End If
End Sub

Function MainWnd_OnLButtonDown(hWnd As HWND, ByVal lParam As LPARAM) As Long
    Dim clickX As Long
    Dim clickY As Long
    clickX = lParam And 65535
    If clickX >= 32768 Then clickX = clickX - 65536
    clickY = (lParam \ 65536) And 65535
    If clickY >= 32768 Then clickY = clickY - 65536
    SetFocus(hWnd)
    EditorCoreClick(hWnd, clickX, clickY)
    EditorInvalidate(hWnd)
    MainWnd_OnLButtonDown = 0
End Function

Function MainWnd_OnMouseWheel(hWnd As HWND, ByVal wParam As WPARAM) As Long
    If WheelDeltaFromWParam(wParam) > 0 Then
        EditorCoreScrollBy(hWnd, -3)
    Else
        EditorCoreScrollBy(hWnd, 3)
    End If
    InvalidateRect(hWnd, ByVal 0, FALSE)
    MainWnd_OnMouseWheel = 0
End Function

Function MainWnd_OnImeComposition(hWnd As HWND, ByVal lParam As LPARAM) As Long
    Dim hIMC As Long
    hIMC = ImmGetContext(hWnd)
    If hIMC <> 0 Then
        If (lParam And GCS_RESULTSTR) <> 0 Then
            TextBuf_Append(ImeCompToUtf8$(hIMC, GCS_RESULTSTR))
            TextBuf_ClearImeComposition()
            g_imeSkipChar = 1
            g_cp932Lead = 0
        ElseIf (lParam And GCS_COMPSTR) <> 0 Then
            TextBuf_SetImeComposition(ImeCompToUtf8$(hIMC, GCS_COMPSTR))
        End If
        ImmReleaseContext(hWnd, hIMC)
    End If
    EditorInvalidate(hWnd)
    MainWnd_OnImeComposition = 0
End Function

Sub MainWnd_OnPaint(hWnd As HWND)
    Dim ps As PAINTSTRUCT
    Dim hDC As HDC
    hDC = BeginPaint(hWnd, ps)
    DrawTextEngine(hDC, hWnd)
    EndPaint(hWnd, ps)
End Sub

Function MdiChildKeysIs(dwMsg As DWord) As Long
    MdiChildKeysIs = 0
    If dwMsg = WM_CHAR Or dwMsg = WM_KEYDOWN Then MdiChildKeysIs = 1
    If dwMsg = WM_IME_COMPOSITION Or dwMsg = WM_IME_ENDCOMPOSITION Then MdiChildKeysIs = 1
    If dwMsg = WM_IME_STARTCOMPOSITION Then MdiChildKeysIs = 1
End Function

Function MdiChildKeys(hWnd As HWND, dwMsg As DWord, wParam As WPARAM, lParam As LPARAM) As Long
    MdiChildKeys = 1
    If dwMsg = WM_CHAR Then MainWnd_OnChar(hWnd, wParam)
    If dwMsg = WM_KEYDOWN Then MainWnd_OnKeyDown(hWnd, wParam)
    If dwMsg = WM_IME_COMPOSITION Then g_childRet = MainWnd_OnImeComposition(hWnd, lParam)
    If dwMsg = WM_IME_ENDCOMPOSITION Then TextBuf_ClearImeComposition()
    If dwMsg = WM_IME_ENDCOMPOSITION Then EditorInvalidate(hWnd)
    If dwMsg = WM_IME_STARTCOMPOSITION Then UpdateImePosition(hWnd, g_caretX, g_caretY)
    If MdiChildKeysIs(dwMsg) = 0 Then MdiChildKeys = 0
End Function

Function MdiChildMouseIs(dwMsg As DWord) As Long
    MdiChildMouseIs = 0
    If dwMsg = WM_CONTEXTMENU Or dwMsg = WM_LBUTTONDOWN Then MdiChildMouseIs = 1
    If dwMsg = WM_MOUSEWHEEL Or dwMsg = WM_VSCROLL Or dwMsg = WM_DROPFILES Then MdiChildMouseIs = 1
End Function

Function MdiChildMouse(hWnd As HWND, dwMsg As DWord, wParam As WPARAM, lParam As LPARAM) As Long
    MdiChildMouse = 1
    If dwMsg = WM_CONTEXTMENU Then EditorContext_Show(hWnd, lParam)
    If dwMsg = WM_LBUTTONDOWN Then g_childRet = MainWnd_OnLButtonDown(hWnd, lParam)
    If dwMsg = WM_MOUSEWHEEL Then g_childRet = MainWnd_OnMouseWheel(hWnd, wParam)
    If dwMsg = WM_VSCROLL Then VirtualScroll_OnVScroll(hWnd, wParam)
    If dwMsg = WM_DROPFILES Then EditorDoc_DropFiles(hWnd, wParam As HDROP)
    If MdiChildMouseIs(dwMsg) = 0 Then MdiChildMouse = 0
End Function

Function MdiChildDraw(hWnd As HWND, dwMsg As DWord) As Long
    MdiChildDraw = 1
    If dwMsg = WM_PAINT Then MainWnd_OnPaint(hWnd)
    If dwMsg = WM_ERASEBKGND Then g_childRet = 1
    If dwMsg <> WM_PAINT And dwMsg <> WM_ERASEBKGND Then MdiChildDraw = 0
End Function

Function MdiChildFocusIs(dwMsg As DWord) As Long
    MdiChildFocusIs = 0
    If dwMsg = WM_SETFOCUS Or dwMsg = WM_KILLFOCUS Then MdiChildFocusIs = 1
End Function

Function MdiChildFocus(hWnd As HWND, dwMsg As DWord) As Long
    MdiChildFocus = 1
    If dwMsg = WM_SETFOCUS Then EditorCaret_Create(hWnd)
    If dwMsg = WM_SETFOCUS Then InvalidateRect(hWnd, ByVal 0, FALSE)
    If dwMsg = WM_KILLFOCUS Then EditorCaret_Destroy()
    If MdiChildFocusIs(dwMsg) = 0 Then MdiChildFocus = 0
End Function

Function MdiChildInput(hWnd As HWND, dwMsg As DWord, wParam As WPARAM, lParam As LPARAM) As Long
    MdiChildInput = MdiChildKeys(hWnd, dwMsg, wParam, lParam)
    If MdiChildInput <> 0 Then Exit Function
    MdiChildInput = MdiChildMouse(hWnd, dwMsg, wParam, lParam)
    If MdiChildInput <> 0 Then Exit Function
    MdiChildInput = MdiChildDraw(hWnd, dwMsg)
    If MdiChildInput <> 0 Then Exit Function
    MdiChildInput = MdiChildFocus(hWnd, dwMsg)
End Function

Function MdiChildHandled(hWnd As HWND, dwMsg As DWord, wParam As WPARAM, lParam As LPARAM) As Long
    g_childRet = 0
    MdiChildHandled = MdiChildInput(hWnd, dwMsg, wParam, lParam)
End Function

Function MainWndProc(hWnd As HWND, dwMsg As DWord, wParam As WPARAM, lParam As LPARAM) As DWord
    If dwMsg = WM_CREATE Or dwMsg = WM_DESTROY Then MdiChildLife(hWnd, dwMsg, lParam)
    If dwMsg = WM_SIZE Then MdiChildSize(hWnd)
    If dwMsg = WM_MDIACTIVATE Then MdiOnActivate(hWnd, wParam, lParam)
    If MdiChildHandled(hWnd, dwMsg, wParam, lParam) <> 0 Then
        MainWndProc = g_childRet
        Exit Function
    End If
    MainWndProc = DefMDIChildProc(hWnd, dwMsg, wParam, lParam)
End Function

Sub MainWnd_Destroy()
	EditorCaret_Destroy()
	EditorFont_Shutdown()
	TextBuf_Destroy()
	ProjectEditor_DestroyObjects()
	PostQuitMessage(0)
End Sub

