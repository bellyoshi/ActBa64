'  ıCıxıııg ıvıııVı[ıWıı
'-----------------------------------------------------------------------------
' ıııtı@ıCıııBAAıEıBıııhıE [MainWnd] ıJıEııCıxıııgıııRı[ıfıBıııOıııııB
' ıEıBıııhıE ınıııhıı: hMainWnd

' TODO: ııııuıCOııı[ıoııııııAı\ıııAııAııEııı`ıııııB


Dim g_strConfirmed As String
'Dim g_strComp As String

Sub DrawTextEngine(hDC As HDC)
    Dim displayStr As String

    displayStr = g_strConfirmed ' & g_strComp

    Dim hBrush As HBRUSH, rect As RECT
    GetClientRect(GetActiveWindow(), rect)
    hBrush = CreateSolidBrush(RGB(255, 255, 255))
    FillRect(hDC, rect, hBrush)
    DeleteObject(hBrush)

    SetBkMode(hDC, TRANSPARENT)
    TextOut(hDC, 10, 10, displayStr, Len(displayStr))
End Sub

'-----------------------------------------------------------------------------
' ıEıBıııhıEıııbıZı[ıWıııııııııııRı[ıııoıbıNııE

Function MainWndProc(hWnd As HWND, dwMsg As DWord, wParam As WPARAM, lParam As LPARAM) As DWord
	' TODO: ııııuıCEıBıııhıEıııbıZı[ıWıııııııııııRı[ıhıııLıqıııııB
    Select Case dwMsg

        Case WM_CHAR
            If wParam = VK_BACK Then
                If Len(g_strConfirmed) > 0 Then
                    g_strConfirmed = Left$(g_strConfirmed, Len(g_strConfirmed) - 1)
                End If
            ElseIf wParam >= 32 Then
                g_strConfirmed = g_strConfirmed & Chr$(wParam)
            End If
                        InvalidateRect(hWnd, ByVal 0, TRUE)
 '           Return 0
        Case WM_PAINT
            Dim ps As PAINTSTRUCT
            Dim hDC As HDC
            hDC = BeginPaint(hWnd, ps)

            DrawTextEngine(hDC)

            EndPaint(hWnd, ps)
    End Select
	' ıEıCıEıxıEııEıï¿½Eï¿½gï¿½Eï¿½vï¿½Eï¿½ï¿½Eï¿½ï¿½Eï¿½Vï¿½Eï¿½[ï¿½Eï¿½Wï¿½Eï¿½ï¿½Eï¿½ï¿½Eï¿½ÌŒÄ‚Ñoï¿½Eï¿½ï¿½Eï¿½ï¿½Eï¿½ï¿½Eï¿½ï¿½Eï¿½sï¿½Eï¿½ï¿½Eï¿½ï¿½Eï¿½Ü‚ï¿½ï¿½Eï¿½B
	MainWndProc=EventCall_MainWnd(hWnd,dwMsg,wParam,lParam)
End Function


'-----------------------------------------------------------------------------
' ï¿½Eï¿½ï¿½Eï¿½ï¿½Eï¿½ï¿½Eï¿½ï¿½Eï¿½ï¿½Eï¿½ï¿½Eï¿½ç‰ºï¿½Eï¿½ÍAï¿½Eï¿½Cï¿½Eï¿½xï¿½Eï¿½ï¿½Eï¿½ï¿½Eï¿½gï¿½Eï¿½vï¿½Eï¿½ï¿½Eï¿½ï¿½Eï¿½Vï¿½Eï¿½[ï¿½Eï¿½Wï¿½Eï¿½ï¿½Eï¿½ï¿½Eï¿½ï¿½Eï¿½ï¿½Eï¿½Lï¿½Eï¿½qï¿½Eï¿½ï¿½Eï¿½ï¿½Eï¿½é‚½ï¿½Eï¿½ß‚Ì—Ìˆï¿½É‚È‚ï¿½Ü‚ï¿½ï¿½Eï¿½B

Sub MainWnd_Destroy()
	editor_DestroyObjects()
	PostQuitMessage(0)
End Sub