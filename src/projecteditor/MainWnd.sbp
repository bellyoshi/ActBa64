Sub MainWnd_Create(ByRef CreateStruct As CREATESTRUCT)
    If hMainWnd = 0 Then Exit Sub
    VirtualScroll_Init()
    EditorBuild_Init(hMainWnd)
    DragAcceptFiles(hMainWnd, TRUE)
    MainWnd_OpenStartup(hMainWnd)
End Sub
