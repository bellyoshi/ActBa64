' 実行する exe の作業ディレクトリ。exe のあるフォルダ（末尾の区切りを含む）を返す。
' 区切り（\ または /）が無ければ "" で、ShellExecute はエディタの作業ディレクトリを継ぐ。

Function RunDir_IsSep(ByVal c As Long) As Long
    RunDir_IsSep = 0
    If c = &H5C Or c = &H2F Then RunDir_IsSep = 1
End Function

Function RunDir_Of$(path As String) As String
    Dim i As Long
    RunDir_Of$ = ""
    For i = Len(path) To 1 Step -1
        If RunDir_IsSep(path[i - 1]) <> 0 Then
            RunDir_Of$ = Left$(path, i)
            Exit Function
        End If
    Next
End Function
