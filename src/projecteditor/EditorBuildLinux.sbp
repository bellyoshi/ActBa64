' EditorBuildLinux - Basic メニューの「Linux (ELF)」（訳し先の 3 つ目。64bit / 32bit とどれか 1 つ）。
' 選ぶと actba64 に -linux を付けて訳し、出力の名前に .exe を付けない（#OUTPUT_RELEASE の .exe も外す）。
' editor.target に " lx" を付けて覚える。メニューの項目は Linux 版のエディタだけに出し、
' Linux 版では editor.target が無ければこれが既定。実行できるのは Linux 版のエディタで Linux の訳し先のときだけ。

Const IDM_TARGETLINUX = 1340

Dim g_buildLinux As Long
Dim g_buildLinuxMenu As Long

Function EditorBuild_IsLinux() As Long
    EditorBuild_IsLinux = g_buildLinux
End Function

' editor.target が無いときの訳し先（Linux 版のエディタは Linux）
Sub EditorBuild_DefaultLinux()
#ifdef _LINUX
    g_buildLinux = 1
#else
    g_buildLinux = 0
#endif
End Sub

Sub EditorBuild_SetLinux(ByVal on As Long)
    g_buildLinux = 0
    If on <> 0 Then g_buildLinux = 1
End Sub

' Basic メニューの Linux の項目なら訳し先を Linux にして 1
Function EditorBuild_LinuxCmd(id As Long) As Long
    EditorBuild_LinuxCmd = 0
    If id <> IDM_TARGETLINUX Then Exit Function
    g_buildLinux = 1
    EditorBuild_SaveTarget()
    EditorBuild_UpdateTargetMenu()
    EditorDoc_UpdateFrameTitle()
    EditorBuild_LinuxCmd = 1
End Function

' 出力の拡張子（Linux は無し）
Function EditorBuild_ExeExt$() As String
    EditorBuild_ExeExt$ = ".exe"
    If g_buildLinux <> 0 Then EditorBuild_ExeExt$ = ""
End Function

' Linux の訳し先なら、末尾の .exe（大文字・小文字は問わない）を外す
Function EditorBuild_OutForTarget$(path As String) As String
    EditorBuild_OutForTarget$ = path
    If g_buildLinux = 0 Or Len(path) < 4 Then Exit Function
    If FormDesign_EqCI(Right$(path, 4), ".exe") <> 0 Then EditorBuild_OutForTarget$ = Left$(path, Len(path) - 4)
End Function

' 出来上がったものをこのエディタから動かせるか（Linux 版は ELF だけ、Windows 版は exe だけ）
Function EditorBuild_CanRun() As Long
#ifdef _LINUX
    EditorBuild_CanRun = g_buildLinux
#else
    EditorBuild_CanRun = 1
    If g_buildLinux <> 0 Then EditorBuild_CanRun = 0
#endif
End Function

' ---- メニュー（Linux 版だけ。32bit の次に差し込む） ----

Sub EditorBuild_ApplyLinuxMenu()
#ifdef _LINUX
    Dim wide As *Byte
    Dim chars As Long
    If g_buildLinuxMenu = 0 Then
        wide = Enc_Utf8ToWide(UiText$(UI_MENU_TARGETLINUX), chars)
        If wide = 0 Then Exit Sub
        InsertMenuW(hMenu_M_MAIN_2, 2, MF_BYPOSITION Or MF_STRING, IDM_TARGETLINUX, wide)
        free(wide)
        g_buildLinuxMenu = 1
    End If
    EditorMenu_SetCmd(hMenu_M_MAIN_2, IDM_TARGETLINUX, UI_MENU_TARGETLINUX)
    EditorBuild_CheckLinuxMenu()
#endif
End Sub

Sub EditorBuild_CheckLinuxMenu()
    Dim flags As Long
    If g_buildLinuxMenu = 0 Then Exit Sub
    flags = MF_BYCOMMAND
    If g_buildLinux <> 0 Then flags = flags Or MF_CHECKED
    CheckMenuItem(hMenu_M_MAIN_2, IDM_TARGETLINUX, flags)
End Sub

' ---- 設定ファイル（editor.target の最後に " lx"）----

Function EditorBuild_LinuxTag$() As String
    EditorBuild_LinuxTag$ = ""
    If g_buildLinux <> 0 Then EditorBuild_LinuxTag$ = " lx"
End Function

Sub EditorBuild_LoadLinux(s As String)
    g_buildLinux = 0
    If InStr(1, s, " lx") > 0 Then g_buildLinux = 1
End Sub
