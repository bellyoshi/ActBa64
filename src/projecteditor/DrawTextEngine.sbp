Dim g_caretX As Long
Dim g_caretY As Long
Dim g_caretCreated As Long

Sub EditorCaret_Create(hWnd As HWND)
    If g_caretCreated <> 0 Then Exit Sub
    CreateCaret(hWnd, NULL, 2, VS_LINE_HEIGHT - 2)
    g_caretCreated = 1
    ShowCaret(hWnd)
End Sub

Sub EditorCaret_Destroy()
    If g_caretCreated = 0 Then Exit Sub
    DestroyCaret()
    g_caretCreated = 0
End Sub

Sub EditorCaret_Update(hDC As HDC, hWnd As HWND)
    Dim curLine As Long
    Dim prefix As String
    Dim sz As SIZE
    Dim visibleRows As Long
    Dim lastLine As Long

    curLine = TextBuf_CursorLine()
    visibleRows = VirtualScroll_VisibleRows(hWnd)
    lastLine = g_viewTopLine + visibleRows - 1

    If curLine < g_viewTopLine Or curLine > lastLine Then
        g_caretX = -10
        g_caretY = -10
    Else
        prefix = TextBuf_GetTextBeforeCursorOnLine$()
        If Len(g_strComp) > 0 Then
            prefix = prefix & g_strComp
        End If

        sz.cx = 0
        sz.cy = 0
        If Len(prefix) > 0 Then
            Enc_TextExtentUtf8(hDC, prefix, sz)
        End If

        g_caretX = VS_MARGIN_X + sz.cx
        g_caretY = VS_MARGIN_Y + (curLine - g_viewTopLine) * VS_LINE_HEIGHT
    End If

    If g_caretCreated <> 0 Then
        SetCaretPos(g_caretX, g_caretY)
    End If
End Sub

Sub EditorHitTestClick(hWnd As HWND, ByVal x As Long, ByVal y As Long)
    Dim lineNo As Long
    Dim lineCount As Long
    Dim lineStart As Long
    Dim targetX As Long

    lineCount = TextBuf_LineCount()
    If lineCount < 1 Then Exit Sub

    If y < VS_MARGIN_Y Then
        lineNo = g_viewTopLine
    Else
        lineNo = g_viewTopLine + (y - VS_MARGIN_Y) \ VS_LINE_HEIGHT
    End If
    If lineNo < 1 Then lineNo = 1
    If lineNo > lineCount Then lineNo = lineCount

    lineStart = TextBuf_GetLineStart(lineNo)
    targetX = x - VS_MARGIN_X
    If targetX <= 0 Then
        TextBuf_MoveCursorTo(lineStart)
        TextBuf_SyncPreferredCol()
        Exit Sub
    End If

    TextBuf_MoveCursorTo(EditorHitTestCol(hWnd, lineNo, targetX))
    TextBuf_SyncPreferredCol()
End Sub

Function EditorHitTestCol(hWnd As HWND, ByVal lineNo As Long, ByVal targetX As Long) As Long
    Dim hDC As HDC
    Dim hFontMono As HFONT
    Dim hFontOld As HFONT
    Dim lineStart As Long
    Dim lineEnd As Long
    Dim i As Long
    Dim n As Long
    Dim b As Long
    Dim best As Long
    Dim prev As Long
    Dim prefix As String
    Dim sz As SIZE
    Dim prevCx As Long

    lineStart = TextBuf_GetLineStart(lineNo)
    lineEnd = TextBuf_GetLineEnd(lineNo)
    hDC = GetDC(hWnd)
    hFontMono = EditorFont_Create(-16)
    hFontOld = SelectObject(hDC, hFontMono)
    best = lineStart
    prev = lineStart
    prevCx = 0
    i = lineStart
    While i < lineEnd
        b = TextBuf_GetByte(i)
        n = Enc_Utf8CharBytes(b)
        If i + n > lineEnd Then n = 1
        prev = i
        i = i + n
        prefix = TextBuf_GetLinePrefix$(lineNo, i)
        sz.cx = 0
        sz.cy = 0
        If Len(prefix) > 0 Then Enc_TextExtentUtf8(hDC, prefix, sz)
        If sz.cx >= targetX Then
            If targetX - prevCx <= sz.cx - targetX Then best = prev Else best = i
            Exit While
        End If
        best = i
        prevCx = sz.cx
    Wend
    SelectObject(hDC, hFontOld)
    ReleaseDC(hWnd, hDC)
    EditorHitTestCol = best
End Function

Function DrawText_BeginBuffer(hDC As HDC, hWnd As HWND, ByRef rect As RECT, ByRef memDC As HDC, ByRef memBmp As HBITMAP, ByRef oldBmp As HBITMAP) As HDC
    Dim w As Long
    Dim h As Long
    GetClientRect(hWnd, rect)
    w = rect.right - rect.left
    h = rect.bottom - rect.top
    If w < 1 Then w = 1
    If h < 1 Then h = 1
    memDC = CreateCompatibleDC(hDC)
    memBmp = CreateCompatibleBitmap(hDC, w, h)
    If memDC = 0 Or memBmp = 0 Then
        memDC = 0
        memBmp = 0
        oldBmp = 0
        DrawText_BeginBuffer = hDC
        Exit Function
    End If
    oldBmp = SelectObject(memDC, memBmp)
    DrawText_BeginBuffer = memDC
End Function

Sub DrawText_EndBuffer(hDC As HDC, ByVal memDC As HDC, ByVal memBmp As HBITMAP, ByVal oldBmp As HBITMAP, ByRef rect As RECT)
    Dim w As Long
    Dim h As Long
    If memDC = 0 Then Exit Sub
    w = rect.right - rect.left
    h = rect.bottom - rect.top
    If w < 1 Then w = 1
    If h < 1 Then h = 1
    BitBlt(hDC, 0, 0, w, h, memDC, 0, 0, &H00CC0020)
    SelectObject(memDC, oldBmp)
    DeleteObject(memBmp)
    DeleteDC(memDC)
End Sub

Sub DrawText_PaintLines(drawDC As HDC, hWnd As HWND)
    Dim lineCount As Long
    Dim visibleRows As Long
    Dim lineNo As Long
    Dim lastLine As Long
    Dim y As Long
    Dim lineStr As String
    Dim curLine As Long
    Dim inBlock As Long

    VirtualScroll_Clamp(hWnd)
    lineCount = TextBuf_LineCount()
    visibleRows = VirtualScroll_VisibleRows(hWnd)
    lastLine = g_viewTopLine + visibleRows - 1
    If lastLine > lineCount Then lastLine = lineCount
    curLine = TextBuf_CursorLine()

    Hl_EnsureStateThrough(g_viewTopLine)
    inBlock = g_hlInBlock

    lineNo = g_viewTopLine
    While lineNo <= lastLine
        y = VS_MARGIN_Y + (lineNo - g_viewTopLine) * VS_LINE_HEIGHT
        DrawText_SelBg(drawDC, hWnd, lineNo, y)
        lineStr = TextBuf_GetLineText$(lineNo)
        If lineNo = curLine And Len(g_strComp) > 0 Then
            lineStr = lineStr & g_strComp
        End If
        If Len(lineStr) > 0 Then
            Hl_DrawLine(drawDC, VS_MARGIN_X, y, lineStr, inBlock, 1)
        End If
        lineNo = lineNo + 1
    Wend
End Sub

Sub DrawTextEngine(hDC As HDC, hWnd As HWND)
    Dim hFontMono As HFONT
    Dim hFontOld As HFONT
    Dim hBrush As HBRUSH
    Dim rect As RECT
    Dim memDC As HDC
    Dim memBmp As HBITMAP
    Dim oldBmp As HBITMAP
    Dim drawDC As HDC

    drawDC = DrawText_BeginBuffer(hDC, hWnd, rect, memDC, memBmp, oldBmp)

    hBrush = CreateSolidBrush(RGB(255, 255, 255))
    FillRect(drawDC, rect, hBrush)
    DeleteObject(hBrush)

    hFontMono = EditorFont_Create(-16)
    hFontOld = SelectObject(drawDC, hFontMono)
    SetBkMode(drawDC, TRANSPARENT)

    DrawText_PaintLines(drawDC, hWnd)
    EditorCaret_Update(drawDC, hWnd)

    SelectObject(drawDC, hFontOld)
    DrawText_EndBuffer(hDC, memDC, memBmp, oldBmp, rect)
End Sub

Sub DrawText_SelBg(hDC As HDC, hWnd As HWND, ByVal lineNo As Long, ByVal y As Long)
    Dim a As Long
    Dim b As Long
    Dim lineS As Long
    Dim lineE As Long
    Dim leftS As String
    Dim rightS As String
    Dim sz0 As SIZE
    Dim sz1 As SIZE
    Dim rc As RECT
    Dim cli As RECT
    Dim hBrush As HBRUSH

    If TextBuf_HasSelection() = 0 Then Exit Sub
    a = TextBuf_SelStart()
    b = TextBuf_SelEnd()
    lineS = TextBuf_GetLineStart(lineNo)
    lineE = TextBuf_GetLineEnd(lineNo)
    If b <= lineS Then Exit Sub
    If a >= lineE And a <> lineS Then
        If b <= lineE Then Exit Sub
    End If
    If a < lineS Then a = lineS
    If b > lineE Then b = lineE
    If b < a Then Exit Sub

    sz0.cx = 0
    sz0.cy = 0
    sz1.cx = 0
    sz1.cy = 0
    If a > lineS Then
        leftS = TextBuf_GetLinePrefix$(lineNo, a)
        If Len(leftS) > 0 Then Enc_TextExtentUtf8(hDC, leftS, sz0)
    End If
    If b > lineS Then
        rightS = TextBuf_GetLinePrefix$(lineNo, b)
        If Len(rightS) > 0 Then Enc_TextExtentUtf8(hDC, rightS, sz1)
    End If

    GetClientRect(hWnd, cli)
    rc.left = VS_MARGIN_X + sz0.cx
    rc.top = y
    rc.right = VS_MARGIN_X + sz1.cx
    rc.bottom = y + VS_LINE_HEIGHT
    If TextBuf_SelEnd() > lineE Then rc.right = cli.right
    If rc.right <= rc.left Then rc.right = rc.left + 4
    hBrush = CreateSolidBrush(RGB(173, 214, 255))
    FillRect(hDC, rc, hBrush)
    DeleteObject(hBrush)
End Sub
