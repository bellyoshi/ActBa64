' Screen gutter for source line numbers. Not the language's line-number statements.

Dim g_textLeft As Long

Function EditorGutter_Digits(ByVal n As Long) As Long
    EditorGutter_Digits = 1
    If n < 1 Then n = 1
    While n >= 10
        n = n \ 10
        EditorGutter_Digits = EditorGutter_Digits + 1
    Wend
End Function

Function EditorGutter_DigitPx(hDC As HDC) As Long
    Dim sz As SIZE
    sz.cx = 8
    Enc_TextExtentUtf8(hDC, "8", sz)
    EditorGutter_DigitPx = sz.cx
    If EditorGutter_DigitPx < 1 Then EditorGutter_DigitPx = 8
End Function

Sub EditorGutter_Bind(hDC As HDC)
    Dim d As Long
    Dim px As Long
    d = EditorGutter_Digits(TextBuf_LineCount())
    If d < 2 Then d = 2
    px = EditorGutter_DigitPx(hDC)
    g_textLeft = d * px + 14
    g_textLeft = g_textLeft + VS_MARGIN_X
End Sub

Sub EditorGutter_Measure(hWnd As HWND)
    Dim hDC As HDC
    Dim oldFont As HFONT
    hDC = GetDC(hWnd)
    oldFont = SelectObject(hDC, EditorFont_Create(-16))
    EditorGutter_Bind(hDC)
    SelectObject(hDC, oldFont)
    ReleaseDC(hWnd, hDC)
End Sub

Sub EditorGutter_Fill(hDC As HDC, hWnd As HWND)
    Dim rc As RECT
    Dim br As HBRUSH
    GetClientRect(hWnd, rc)
    rc.right = g_textLeft - VS_MARGIN_X
    If rc.right < 1 Then Exit Sub
    br = CreateSolidBrush(RGB(245, 245, 248))
    FillRect(hDC, rc, br)
    DeleteObject(br)
End Sub

Sub EditorGutter_Edge(hDC As HDC, hWnd As HWND)
    Dim rc As RECT
    Dim br As HBRUSH
    GetClientRect(hWnd, rc)
    rc.left = g_textLeft - VS_MARGIN_X - 1
    rc.right = rc.left + 1
    br = CreateSolidBrush(RGB(210, 210, 220))
    FillRect(hDC, rc, br)
    DeleteObject(br)
End Sub

Sub EditorGutter_Prepare(hDC As HDC, hWnd As HWND)
    EditorGutter_Bind(hDC)
    EditorGutter_Fill(hDC, hWnd)
    EditorGutter_Edge(hDC, hWnd)
End Sub

Function EditorGutter_Num$(ByVal n As Long) As String
    Dim s As String
    s = Str$(n)
    If Left$(s, 1) = " " Then s = Mid$(s, 2)
    EditorGutter_Num$ = s
End Function

Function EditorGutter_NumX(hDC As HDC, s As String) As Long
    Dim sz As SIZE
    Dim x As Long
    sz.cx = 0
    Enc_TextExtentUtf8(hDC, s, sz)
    x = g_textLeft - VS_MARGIN_X
    x = x - 6 - sz.cx
    If x < 2 Then x = 2
    EditorGutter_NumX = x
End Function

Sub EditorGutter_Color(hDC As HDC, ByVal lineNo As Long)
    If lineNo = TextBuf_CursorLine() Then
        SetTextColor(hDC, RGB(40, 60, 120))
    Else
        SetTextColor(hDC, RGB(140, 150, 170))
    End If
End Sub

Sub EditorGutter_DrawNum(hDC As HDC, ByVal lineNo As Long, ByVal y As Long)
    Dim s As String
    s = EditorGutter_Num$(lineNo)
    EditorGutter_Color(hDC, lineNo)
    Enc_TextOutUtf8(hDC, EditorGutter_NumX(hDC, s), y, s)
End Sub
