End Sub

Function EventCall_MainWnd(hWnd As HWND, message As DWord, wParam As WPARAM, lParam As LPARAM) As LRESULT
	Select Case message
		Case WM_DESTROY
			MainWnd_Destroy()
		Case WM_CREATE
			hMainWnd=hWnd
			SetMenu(hWnd,hMenu_M_MAIN)
			EditorBuild_Init(hWnd)
			DragAcceptFiles(hWnd, TRUE)
			MainWnd_OpenStartup(hWnd)
		Case WM_DROPFILES
			MainWnd_DropFiles(hWnd, wParam As HDROP)
		Case WM_CLOSE
			Dim cancel=0 As Integer
			If cancel=0 Then DestroyWindow(hWnd)
		Case WM_CONTEXTMENU
			EditorContext_Show(hWnd, lParam)
		Case WM_COMMAND
			Select Case LOWORD(wParam)
				Case IDM_FILENEW
					MainWnd_IDM_FILENEW_MenuClick()
				Case IDM_FILEOPEN
					MainWnd_IDM_FILEOPEN_MenuClick()
				Case IDM_UNDO
					MainWnd_IDM_UNDO_MenuClick()
				Case IDM_REDO
					MainWnd_IDM_REDO_MenuClick()
				Case IDM_CUT
					MainWnd_IDM_CUT_MenuClick()
				Case IDM_COPY
					MainWnd_IDM_COPY_MenuClick()
				Case IDM_PASTE
					MainWnd_IDM_PASTE_MenuClick()
				Case IDM_DELETE
					MainWnd_IDM_DELETE_MenuClick()
				Case IDM_SELECTALL
					MainWnd_IDM_SELECTALL_MenuClick()
				Case IDM_RUN
					MainWnd_IDM_RUN_MenuClick()
				Case IDM_COMPILE
					MainWnd_IDM_COMPILE_MenuClick()
				Case IDM_TARGET64
					MainWnd_IDM_TARGET64_MenuClick()
				Case IDM_TARGET32
					MainWnd_IDM_TARGET32_MenuClick()
				Case IDM_SAVEAS
					MainWnd_IDM_SAVEAS_MenuClick()
				Case IDM_SAVE
					MainWnd_IDM_SAVE_MenuClick()
				Case IDM_HELP_ACTBA64
					MainWnd_IDM_HELP_ACTBA64_MenuClick()
			End Select
		Case Else
			EventCall_MainWnd=DefWindowProc(hWnd,message,wParam,lParam)
			Exit Function
	End Select
	EventCall_MainWnd=0
End Function

Function EventCall_MessageWnd(hWnd As HWND, message As DWord, wParam As WPARAM, lParam As LPARAM) As LRESULT
	Select Case message
		Case WM_INITDIALOG
			hMessageWnd=hWnd
			CreateWindowEx(&H00000200,"EDIT","",&H50000000,7,7,456,317,hWnd,EditBox1 As HMENU,GetModuleHandle(0),0)
			SendMessage(GetDlgItem(hWnd,EditBox1),WM_SETFONT,hFont_MessageWnd As WPARAM,0)
		Case WM_DESTROY
			If hWnd = hMessageWnd Then hMessageWnd = 0
		Case WM_CLOSE
			ShowWindow(hWnd, SW_HIDE)
		Case Else
			EventCall_MessageWnd=DefWindowProc(hWnd,message,wParam,lParam)
			Exit Function
	End Select
	EventCall_MessageWnd=0
End Function

Function DefaultCallProc(hWnd As HWND, message As DWord, wParam As WPARAM, lParam As LPARAM) As LRESULT
	DefaultCallProc=DefWindowProc(hWnd,message,wParam,lParam)
End Function

Dim _RadSys_dlgwcl As WNDCLASSEX
FillMemory(VarPtr(_RadSys_dlgwcl),Len(_RadSys_dlgwcl),0)
_RadSys_dlgwcl.cbSize=Len(_RadSys_dlgwcl)
_RadSys_dlgwcl.hInstance=GetModuleHandle(0)
_RadSys_dlgwcl.style=CS_HREDRAW or CS_VREDRAW or CS_DBLCLKS
_RadSys_dlgwcl.hIcon=LoadIcon(NULL,MAKEINTRESOURCE(IDI_APPLICATION))
_RadSys_dlgwcl.hIconSm=LoadIcon(NULL,MAKEINTRESOURCE(IDI_WINLOGO))
_RadSys_dlgwcl.hCursor=LoadCursor(NULL,MAKEINTRESOURCE(IDC_ARROW))
_RadSys_dlgwcl.lpszClassName="NORMALDLG"
_RadSys_dlgwcl.hbrBackground=h3DFaceBrush
_RadSys_dlgwcl.lpfnWndProc=AddressOf(DefaultCallProc)
RegisterClassEx(_RadSys_dlgwcl)

Function DialogBox(hOwnerWnd As HWND, TemplateName As LPSTR) As LONG_PTR
	If lstrcmp(TemplateName,"MessageWnd")=0 Then
		hMessageWnd=CreateWindowEx(&H00000000,"NORMALDLG","MessageWnd",&H00c80000,-1,-1,480,360,hOwnerWnd,0 As HMENU,GetModuleHandle(0),0)
		SetWindowLong(hMessageWnd,GWL_WNDPROC,AddressOf(MessageWndProc) As LONG_PTR)
		SendMessage(hMessageWnd,WM_INITDIALOG,0,0)
		ShowWindow(hMessageWnd,SW_SHOW)
	Else
		Exit Function
	End If
	EnableWindow(hOwnerWnd,0)

	Dim msg As MSG, iResult As Long
	Do
		iResult=GetMessage(msg,0,0,0)
		If iResult=0 or iResult=-1 Then Exit Do
		TranslateMessage(msg)
		DispatchMessage(msg)
	Loop
	DialogBox=msg.wParam
End Function
Sub EndDialog(hWnd As HWND, lResult As Long)
	EnableWindow(GetWindow(hWnd,GW_OWNER),1)
	ShowWindow(hWnd, SW_HIDE)
End Sub

Function CreateDialog(hOwnerWnd As HWND, TemplateName As LPSTR) As HWND
End Function
