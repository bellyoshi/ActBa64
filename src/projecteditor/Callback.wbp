'このファイルはウィンドウ定義ファイル（*.wnd）をもとに生成されています

Const IDM_FILENEW=1000
Const IDM_FILEOPEN=1001
Const IDM_SAVEAS=1002
Const IDM_SAVE=1003
Const IDM_UNDO=1004
Const IDM_REDO=1005
Const IDM_CUT=1006
Const IDM_COPY=1007
Const IDM_PASTE=1008
Const IDM_RUN=1009
Const IDM_COMPILE=1010
Const IDM_HELP=1011

Dim hMainWnd As HWND
Dim hFont_MainWnd As HFONT
hFont_MainWnd=CreateFont(-12,0,0,0,400,0,0,0,128,3,2,1,32,"ＭＳ Ｐゴシック")
Dim h3DFaceBrush As HBRUSH
h3DFaceBrush=CreateSolidBrush(GetSysColor(COLOR_3DFACE))


Dim hMenu_M_MAIN As HMENU
hMenu_M_MAIN=CreateMenu()
InsMenu hMenu_M_MAIN,0,MF_BYPOSITION,Ex"ヘルプ",IDM_HELP,0,0
Dim hMenu_M_MAIN_2 As HMENU
hMenu_M_MAIN_2=CreatePopupMenu()
InsMenu hMenu_M_MAIN_2,0,MF_BYPOSITION,Ex"コンパイル",IDM_COMPILE,0,0
InsMenu hMenu_M_MAIN_2,0,MF_BYPOSITION,Ex"実行",IDM_RUN,0,0
InsMenu hMenu_M_MAIN,0,MF_BYPOSITION,Ex"ベーシック",0,hMenu_M_MAIN_2,0
Dim hMenu_M_MAIN_1 As HMENU
hMenu_M_MAIN_1=CreatePopupMenu()
InsMenu hMenu_M_MAIN_1,0,MF_BYPOSITION,Ex"貼り付け",IDM_PASTE,0,0
InsMenu hMenu_M_MAIN_1,0,MF_BYPOSITION,Ex"コピー",IDM_COPY,0,0
InsMenu hMenu_M_MAIN_1,0,MF_BYPOSITION,Ex"切り取り",IDM_CUT,0,0
InsMenu hMenu_M_MAIN_1,0,MF_BYPOSITION
InsMenu hMenu_M_MAIN_1,0,MF_BYPOSITION,Ex"やり直す",IDM_REDO,0,0
InsMenu hMenu_M_MAIN_1,0,MF_BYPOSITION,Ex"元に戻す",IDM_UNDO,0,0
InsMenu hMenu_M_MAIN,0,MF_BYPOSITION,Ex"編集",0,hMenu_M_MAIN_1,0
Dim hMenu_M_MAIN_0 As HMENU
hMenu_M_MAIN_0=CreatePopupMenu()
InsMenu hMenu_M_MAIN_0,0,MF_BYPOSITION,Ex"上書き保存",IDM_SAVE,0,0
InsMenu hMenu_M_MAIN_0,0,MF_BYPOSITION,Ex"保存",IDM_SAVEAS,0,0
InsMenu hMenu_M_MAIN_0,0,MF_BYPOSITION,Ex"ファイルを開く",IDM_FILEOPEN,0,0
InsMenu hMenu_M_MAIN_0,0,MF_BYPOSITION,Ex"新規作成",IDM_FILENEW,0,0
InsMenu hMenu_M_MAIN,0,MF_BYPOSITION,Ex"ファイル",0,hMenu_M_MAIN_0,0

Sub editor_DestroyObjects()
	DestroyMenu(hMenu_M_MAIN)
	DestroyMenu(hMenu_M_MAIN_2)
	DestroyMenu(hMenu_M_MAIN_1)
	DestroyMenu(hMenu_M_MAIN_0)
	DeleteObject(hFont_MainWnd)
	DeleteObject(h3DFaceBrush)
End Sub

Function EventCall_MainWnd(hWnd As HWND, message As DWord, wParam As WPARAM, lParam As LPARAM) As LRESULT
	Select Case message
		Case WM_DESTROY
			MainWnd_Destroy()
		Case WM_CREATE
			hMainWnd=hWnd
			SetMenu(hWnd,hMenu_M_MAIN)
		Case WM_CLOSE
			Dim cancel=0 As Integer
			If cancel=0 Then DestroyWindow(hWnd)
		Case WM_COMMAND
			Select Case LOWORD(wParam)
				Case IDM_FILENEW
					MainWnd_IDM_FILENEW_MenuClick()
				Case IDM_FILEOPEN
					MainWnd_IDM_FILEOPEN_MenuClick()
				Case IDM_UNDO
					MainWnd_IDM_UNDO_MenuClick()
				Case IDM_REDO
					MainWnd_IDM_REDO_MenuClick()
				Case IDM_CUT
					MainWnd_IDM_CUT_MenuClick()
				Case IDM_COPY
					MainWnd_IDM_COPY_MenuClick()
				Case IDM_PASTE
					MainWnd_IDM_PASTE_MenuClick()
				Case IDM_RUN
					MainWnd_IDM_RUN_MenuClick()
				Case IDM_COMPILE
					MainWnd_IDM_COMPILE_MenuClick()
				Case IDM_SAVEAS
					MainWnd_IDM_SAVEAS_MenuClick()
				Case IDM_SAVE
					MainWnd_IDM_SAVE_MenuClick()
			End Select
		Case Else
			EventCall_MainWnd=DefWindowProc(hWnd,message,wParam,lParam)
			Exit Function
	End Select
	EventCall_MainWnd=0
End Function

Function DefaultCallProc(hWnd As HWND, message As DWord, wParam As WPARAM, lParam As LPARAM) As LRESULT
	DefaultCallProc=DefWindowProc(hWnd,message,wParam,lParam)
End Function

Dim _RadSys_dlgwcl As WNDCLASSEX
FillMemory(VarPtr(_RadSys_dlgwcl),Len(_RadSys_dlgwcl),0)
_RadSys_dlgwcl.cbSize=Len(_RadSys_dlgwcl)
_RadSys_dlgwcl.hInstance=GetModuleHandle(0)
_RadSys_dlgwcl.style=CS_HREDRAW or CS_VREDRAW or CS_DBLCLKS
_RadSys_dlgwcl.hIcon=LoadIcon(NULL,MAKEINTRESOURCE(IDI_APPLICATION))
_RadSys_dlgwcl.hIconSm=LoadIcon(NULL,MAKEINTRESOURCE(IDI_WINLOGO))
_RadSys_dlgwcl.hCursor=LoadCursor(NULL,MAKEINTRESOURCE(IDC_ARROW))
_RadSys_dlgwcl.lpszClassName="NORMALDLG"
_RadSys_dlgwcl.hbrBackground=h3DFaceBrush
_RadSys_dlgwcl.lpfnWndProc=AddressOf(DefaultCallProc)
RegisterClassEx(_RadSys_dlgwcl)

Function DialogBox(hOwnerWnd As HWND, TemplateName As LPSTR) As LONG_PTR
End Function
Sub EndDialog(hWnd As HWND, lResult As Long)
	EnableWindow(GetWindow(hWnd,GW_OWNER),1)
	DestroyWindow(hWnd)
	PostMessage(0,WM_QUIT,lResult,0)
End Sub

Function CreateDialog(hOwnerWnd As HWND, TemplateName As LPSTR) As HWND
End Function
