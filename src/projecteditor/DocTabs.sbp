' 文書ウィンドウの上の「コード」「デザイナー」のタブ（高さ DOCTAB_H。定数は FormDesign.sbp）。
' コードの画面（DrawTextEngine）とデザイン画面（FormDesign_DrawAll）の両方の上に描き、
' 押すとその画面に切り替える（F12 と同じ）。InitializeComponent の無い文書では
' デザイナーを灰色で描き、押しても音が鳴るだけ（FormDesign_Enter）。
' 文字とデザインの中身は、帯の下から描く（VS_MARGIN_Y と FD_ORG_Y が DOCTAB_H を足している）。

Const DOCTAB_W = 96                 ' タブ 1 つの幅
Const DOCTAB_X = 4                  ' 最初のタブの左端

' タブ i（0: コード、1: デザイナー）の四角
Sub DocTabs_Rect(ByVal i As Long, ByRef rc As RECT)
    FormDesign_Rect(rc, DOCTAB_X + i * DOCTAB_W, 3, DOCTAB_X + (i + 1) * DOCTAB_W - 2, DOCTAB_H)
End Sub

' 点の上のタブ。0: コード、1: デザイナー、-1: 無い
Function DocTabs_At(ByVal x As Long, ByVal y As Long) As Long
    Dim i As Long, rc As RECT
    DocTabs_At = -1
    For i = 0 To 1
        DocTabs_Rect(i, rc)
        If FormDesign_In(x, y, rc.left, rc.top, rc.right - rc.left, rc.bottom - rc.top) <> 0 Then DocTabs_At = i
    Next
End Function

' ---- 描画 ----

' タブ 1 つ。今の画面のタブは白く、帯の下の線を切る
Sub DocTabs_DrawTab(hDC As HDC, ByVal i As Long, ByVal cur As Long, ByVal enabled As Long)
    Dim rc As RECT, bg As DWord
    DocTabs_Rect(i, rc)
    bg = Ui_SysColor(COLOR_BTNFACE)
    If i = cur Then bg = RGB(255, 255, 255)
    Ui_Fill(hDC, rc.left, rc.top, rc.right, rc.bottom, bg)
    Ui_Frame(hDC, rc, RGB(160, 160, 170))
    If i = cur Then Ui_Fill(hDC, rc.left + 1, rc.bottom - 1, rc.right - 1, rc.bottom, RGB(255, 255, 255))
    Ui_TextColor(hDC, Ui_SysColor(COLOR_BTNTEXT))
    If enabled = 0 Then Ui_TextColor(hDC, Ui_SysColor(COLOR_GRAYTEXT))
    Ui_TextCenter(hDC, rc, UiText$(UI_TAB_CODE + i))
End Sub

' 帯とタブを描く（hWnd の文書がデザイン中ならデザイナーのタブを選んだ形）
Sub DocTabs_Draw(hDC As HDC, hWnd As HWND)
    Dim rc As RECT, old As HFONT, cur As Long
    Ui_ClientRect(hWnd, rc)
    Ui_Fill(hDC, 0, 0, rc.right, DOCTAB_H, Ui_SysColor(COLOR_BTNFACE))
    Ui_Fill(hDC, 0, DOCTAB_H - 1, rc.right, DOCTAB_H, RGB(160, 160, 170))
    old = Ui_SelectFont(hDC, Ui_GuiFont())
    Ui_Transparent(hDC)
    cur = FormDesign_IsOn(hWnd)
    DocTabs_DrawTab(hDC, 0, cur, 1)
    DocTabs_DrawTab(hDC, 1, cur, FormDesign_IsForm(FormDesign_Text$(hWnd)))
    Ui_SelectFont(hDC, old)
End Sub

' ---- マウス ----

' 帯の上を押したなら、押したタブの画面にして 1（タブの外でも帯の上なら何もせず 1）
Function DocTabs_Down(hWnd As HWND, ByVal lParam As LPARAM) As Long
    Dim x As Long, y As Long, t As Long
    DocTabs_Down = 0
    EditorSelect_XY(lParam, x, y)
    If y >= DOCTAB_H Then Exit Function
    DocTabs_Down = 1
    t = DocTabs_At(x, y)
    If t < 0 Or t = FormDesign_IsOn(hWnd) Then Exit Function
    If hWnd <> g_activeChild Then Exit Function
    FormDesign_Toggle(hWnd)
    Ui_Invalidate(hWnd)
End Function

' 文書ウィンドウのメッセージのうち、帯を押した（ダブルクリックも）ものを扱って 1
Function DocTabs_Handle(hWnd As HWND, dwMsg As DWord, lParam As LPARAM) As Long
    DocTabs_Handle = 0
    If dwMsg <> WM_LBUTTONDOWN And dwMsg <> WM_LBUTTONDBLCLK Then Exit Function
    DocTabs_Handle = DocTabs_Down(hWnd, lParam)
End Function
