' LxCallback - Linux 版での Callback.wbp / MakeWindow.wbp の代わり（-linux のときだけ）。
' Callback.wbp は RAD ツールが ProjectEditor.wnd から作る Windows 用のファイルなので、
' Linux 版で要る分（ID、窓のハンドルの変数、メニューの組み立て、WM_COMMAND の振り分け）をここに写す。
' ProjectEditor.wnd のメニューや ID を変えたら、ここも合わせる。

#ifdef _LINUX

Const EditBox1=1000
Const LangCmb=1001
Const Static1=1002
Const OkButton=1003
Const IDM_FILENEW=1004
Const IDM_FILEOPEN=1005
Const IDM_SAVEAS=1006
Const IDM_SAVE=1007
Const IDM_UNDO=1008
Const IDM_REDO=1009
Const IDM_CUT=1010
Const IDM_COPY=1011
Const IDM_PASTE=1012
Const IDM_SELECTALL=1013
Const IDM_DELETE=1014
Const IDM_TARGET64=1015
Const IDM_TARGET32=1016
Const IDM_RUN=1017
Const IDM_RUNWAIT=1018
Const IDM_COMPILE=1019
Const IDM_SETTING=1020
Const IDM_name=1021
Const IDM_HELP_KEYWORD=1022
Const IDM_HELP_ACTBA64=1023

Dim hMainWnd As HWND
Dim hMessageWnd As HWND
Dim hSetting As HWND

Dim hMenu_M_MAIN As HMENU
Dim hMenu_M_MAIN_0 As HMENU
Dim hMenu_M_MAIN_1 As HMENU
Dim hMenu_M_MAIN_2 As HMENU
Dim hMenu_M_MAIN_3 As HMENU
Dim hMenu_M_MAIN_4 As HMENU

' Callback.wbp と同じ形のメニュー（文字は EditorMenu_ApplyLang が入れ直す）
Sub LxCallback_BuildMenus()
    hMenu_M_MAIN = CreateMenu()
    hMenu_M_MAIN_4 = CreatePopupMenu()
    InsMenu hMenu_M_MAIN_4, 0, MF_BYPOSITION, "ACTBA64Help", IDM_HELP_ACTBA64, 0, 0
    InsMenu hMenu_M_MAIN_4, 0, MF_BYPOSITION, "KeyWord", IDM_HELP_KEYWORD, 0, 0
    InsMenu hMenu_M_MAIN, 0, MF_BYPOSITION, "Help", 0, hMenu_M_MAIN_4, 0
    hMenu_M_MAIN_3 = CreatePopupMenu()
    InsMenu hMenu_M_MAIN_3, 0, MF_BYPOSITION, "Setting", IDM_SETTING, 0, 0
    InsMenu hMenu_M_MAIN, 0, MF_BYPOSITION, "Setting(&S)", 0, hMenu_M_MAIN_3, 0
    hMenu_M_MAIN_2 = CreatePopupMenu()
    InsMenu hMenu_M_MAIN_2, 0, MF_BYPOSITION, "Compile(&C)", IDM_COMPILE, 0, 0
    InsMenu hMenu_M_MAIN_2, 0, MF_BYPOSITION, "RunWait", IDM_RUNWAIT, 0, 0
    InsMenu hMenu_M_MAIN_2, 0, MF_BYPOSITION, "Run(&R)", IDM_RUN, 0, 0
    InsMenu hMenu_M_MAIN_2, 0, MF_BYPOSITION, "32bit", IDM_TARGET32, 0, 0
    InsMenu hMenu_M_MAIN_2, 0, MF_BYPOSITION, "64bit", IDM_TARGET64, 0, 0
    InsMenu hMenu_M_MAIN, 0, MF_BYPOSITION, "Basic", 0, hMenu_M_MAIN_2, 0
    hMenu_M_MAIN_1 = CreatePopupMenu()
    InsMenu hMenu_M_MAIN_1, 0, MF_BYPOSITION, "Delete(&D)", IDM_DELETE, 0, 0
    InsMenu hMenu_M_MAIN_1, 0, MF_BYPOSITION, "SelectAll(&A)", IDM_SELECTALL, 0, 0
    InsMenu hMenu_M_MAIN_1, 0, MF_BYPOSITION, "Paste(&P)", IDM_PASTE, 0, 0
    InsMenu hMenu_M_MAIN_1, 0, MF_BYPOSITION, "Copy(&C)", IDM_COPY, 0, 0
    InsMenu hMenu_M_MAIN_1, 0, MF_BYPOSITION, "Cut(&C)", IDM_CUT, 0, 0
    InsMenu hMenu_M_MAIN_1, 0, MF_BYPOSITION
    InsMenu hMenu_M_MAIN_1, 0, MF_BYPOSITION, "Redo(&R)", IDM_REDO, 0, 0
    InsMenu hMenu_M_MAIN_1, 0, MF_BYPOSITION, "Undo(&U)", IDM_UNDO, 0, 0
    InsMenu hMenu_M_MAIN, 0, MF_BYPOSITION, "Edit(&E)", 0, hMenu_M_MAIN_1, 0
    hMenu_M_MAIN_0 = CreatePopupMenu()
    InsMenu hMenu_M_MAIN_0, 0, MF_BYPOSITION, "Save(&S)", IDM_SAVE, 0, 0
    InsMenu hMenu_M_MAIN_0, 0, MF_BYPOSITION, "SaveAs(&A)", IDM_SAVEAS, 0, 0
    InsMenu hMenu_M_MAIN_0, 0, MF_BYPOSITION, "Open(&O)", IDM_FILEOPEN, 0, 0
    InsMenu hMenu_M_MAIN_0, 0, MF_BYPOSITION, "New(&N)", IDM_FILENEW, 0, 0
    InsMenu hMenu_M_MAIN, 0, MF_BYPOSITION, "File(&F)", 0, hMenu_M_MAIN_0, 0
End Sub

Sub ProjectEditor_DestroyObjects()
End Sub

' Callback.wbp の EventCall_MainWnd の WM_COMMAND と同じ振り分け
Sub LxCallback_Command(ByVal id As Long)
    Select Case id
        Case IDM_FILENEW
            MainWnd_IDM_FILENEW_MenuClick()
        Case IDM_FILEOPEN
            MainWnd_IDM_FILEOPEN_MenuClick()
        Case IDM_UNDO
            MainWnd_IDM_UNDO_MenuClick()
        Case IDM_REDO
            MainWnd_IDM_REDO_MenuClick()
        Case IDM_CUT
            MainWnd_IDM_CUT_MenuClick()
        Case IDM_COPY
            MainWnd_IDM_COPY_MenuClick()
        Case IDM_PASTE
            MainWnd_IDM_PASTE_MenuClick()
        Case IDM_DELETE
            MainWnd_IDM_DELETE_MenuClick()
        Case IDM_SELECTALL
            MainWnd_IDM_SELECTALL_MenuClick()
        Case IDM_RUN
            MainWnd_IDM_RUN_MenuClick()
        Case IDM_RUNWAIT
            MainWnd_IDM_RUNWAIT_MenuClick()
        Case IDM_COMPILE
            MainWnd_IDM_COMPILE_MenuClick()
        Case IDM_TARGET64
            MainWnd_IDM_TARGET64_MenuClick()
        Case IDM_TARGET32
            MainWnd_IDM_TARGET32_MenuClick()
        Case IDM_SAVEAS
            MainWnd_IDM_SAVEAS_MenuClick()
        Case IDM_SAVE
            MainWnd_IDM_SAVE_MenuClick()
        Case IDM_HELP_ACTBA64
            MainWnd_IDM_HELP_ACTBA64_MenuClick()
        Case IDM_HELP_KEYWORD
            MainWnd_IDM_HELP_KEYWORD_MenuClick()
        Case IDM_SETTING
            MainWnd_IDM_SETTING_MenuClick()
    End Select
End Sub

#endif
