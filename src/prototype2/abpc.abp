#include "abpc.idx"

#console

' abpc - ABP ビルドドライバ
' 使い方:
'   abpc <input.abp> [output.exe]   ' 単一ソース（互換）
'   abpc <project.pj>               ' #SOURCE 結合 → abc → asm → obj → exe
'
' 呼び出し順:
'   1. abc         (.abp -> .asm)
'   2. abassembler (.asm -> .obj)
'   3. ablinker    (.obj -> .exe)

Const MAX_CMDLINE = 1024
Const MAX_SOURCES = 32

Dim gSources(31) As String
Dim gNSources As Long
Dim gOutExe As String
Dim gPlatform As Long
Dim gProjDir As String
Dim gProjName As String

Sub USAGE()
    Print "abpc - ABP build driver"
    Print "usage: abpc <input.abp> [output.exe]"
    Print "       abpc <project.pj>"
    Print "  runs: abc -> abassembler -> ablinker"
    End
End Sub

Function ToolDir$() As String
    Dim buf[MAX_PATH] As Byte
    Dim s As String
    Dim i As Long
    Dim n As Long
    Dim ch As String
    Dim slashPos As Long

    GetModuleFileName(NULL, buf, MAX_PATH)
    s = MakeStr(buf)
    n = Len(s)
    slashPos = 0
    For i = 1 To n
        ch = Mid$(s, i, 1)
        If ch = "\" Or ch = "/" Then
            slashPos = i
        End If
    Next
    If slashPos > 0 Then
        ToolDir$ = Left$(s, slashPos)
    Else
        ToolDir$ = ""
    End If
End Function

Function StripCommentPj$(s As String) As String
    Dim n As Long
    Dim i As Long
    Dim inQ As Long
    Dim c As Long
    Dim p As *Byte
    Dim t As String
    n = Len(s)
    If n = 0 Then
        StripCommentPj$ = ""
        Exit Function
    End If
    p = StrPtr(s)
    inQ = 0
    For i = 0 To n - 1
        c = p[i]
        If inQ <> 0 Then
            If c = 34 Then inQ = 0
        ElseIf c = 34 Then
            inQ = 1
        ElseIf c = Asc("'") Then
            t = Left$(s, i)
            StripCommentPj$ = Trim$(t)
            Exit Function
        End If
    Next
    StripCommentPj$ = Trim$(s)
End Function

Function NormalizeOutPath$(p As String) As String
    Dim t As String
    t = Trim$(p)
    If Len(t) >= 2 Then
        If Left$(t, 2) = ".\" Then
            t = Mid$(t, 3, Len(t) - 2)
        End If
    End If
    NormalizeOutPath$ = t
End Function

Function JoinPath$(dir As String, name As String) As String
    If Len(DirOf$(name)) > 0 Then
        JoinPath$ = name
    ElseIf Len(dir) = 0 Then
        JoinPath$ = name
    Else
        JoinPath$ = dir + name
    End If
End Function

Function ParseProject(pjPath As String) As Long
    Dim text As String
    Dim oneLine As String
    Dim i As Long
    Dim start As Long
    Dim n As Long
    Dim c As Long
    Dim p As *Byte
    Dim inSource As Long
    Dim low As String
    Dim eq As Long
    Dim key As String
    Dim value As String
    Dim tmp As String

    ParseProject = 0
    gNSources = 0
    gOutExe = ""
    gPlatform = 0
    gProjDir = DirOf$(pjPath)
    tmp = BaseName$(pjPath)
    gProjName = FileNameOnly$(tmp)

    text = LoadTextFile$(pjPath)
    If text = "" Then
        If FileExists(pjPath) = 0 Then Exit Function
    End If

    n = Len(text)
    p = StrPtr(text)
    i = 0
    inSource = 0
    While i < n
        start = i
        While i < n
            c = p[i]
            If c = 10 Or c = 13 Then Exit While
            i = i + 1
        Wend
        oneLine = StripCommentPj$(Mid$(text, start + 1, i - start))
        While i < n
            c = p[i]
            If c <> 10 And c <> 13 Then Exit While
            i = i + 1
        Wend
        If oneLine = "" Then
            ' skip
        Else
            If Left$(oneLine, 1) = "#" Then
                low = Lower$(oneLine)
                If low = "#source" Then
                    inSource = 1
                Else
                    inSource = 0
                    eq = InStr(1, oneLine, "=")
                    If eq > 1 Then
                        tmp = Left$(oneLine, eq - 1)
                        tmp = Trim$(tmp)
                        key = Lower$(tmp)
                        tmp = Mid$(oneLine, eq + 1, Len(oneLine) - eq)
                        value = Trim$(tmp)
                        If key = "#output_release" Then
                            gOutExe = NormalizeOutPath$(value)
                        ElseIf key = "#platform" Then
                            If value = "32" Then
                                gPlatform = 32
                            Else
                                Print "unsupported #PLATFORM: " + value
                                Exit Function
                            End If
                        ElseIf key = "#name" Then
                            If value <> "" Then
                                gProjName = value
                            End If
                        End If
                    End If
                End If
            Else
                If inSource <> 0 Then
                    If gNSources >= MAX_SOURCES Then
                        Print "too many #SOURCE files"
                        Exit Function
                    End If
                    gSources(gNSources) = oneLine
                    gNSources = gNSources + 1
                End If
            End If
        End If
    Wend

    If gNSources <= 0 Then
        Print "no #SOURCE in " + pjPath
        Exit Function
    End If
    If gOutExe = "" Then
        gOutExe = gProjName + ".exe"
    End If
    If gPlatform = 0 Then
        gPlatform = 32
    End If
    gOutExe = JoinPath$(gProjDir, gOutExe)
    ParseProject = 1
End Function

Function StripIncludeLines$(text As String) As String
    Dim outText As String
    Dim oneLine As String
    Dim i As Long
    Dim start As Long
    Dim n As Long
    Dim c As Long
    Dim p As *Byte
    Dim low As String

    outText = ""
    n = Len(text)
    p = StrPtr(text)
    i = 0
    While i < n
        start = i
        While i < n
            c = p[i]
            If c = 10 Or c = 13 Then Exit While
            i = i + 1
        Wend
        oneLine = Mid$(text, start + 1, i - start)
        low = Lower$(Trim$(oneLine))
        If StartsWith(low, "#include") = 0 Then
            outText = outText + oneLine
            outText = outText + Chr$(13) + Chr$(10)
        End If
        While i < n
            c = p[i]
            If c <> 10 And c <> 13 Then Exit While
            i = i + 1
        Wend
    Wend
    StripIncludeLines$ = outText
End Function

Function AppendSourceChunk(ByRef all As String, srcName As String) As Long
    Dim srcPath As String
    Dim chunk As String
    AppendSourceChunk = 0
    srcPath = JoinPath$(gProjDir, srcName)
    If FileExists(srcPath) = 0 Then
        Print "missing source: " + srcPath
        Exit Function
    End If
    chunk = LoadTextFile$(srcPath)
    chunk = StripIncludeLines$(chunk)
    all = all + "' ---- " + srcName + " ----" + Chr$(13) + Chr$(10)
    all = all + chunk
    If Right$(all, 2) <> Chr$(13) + Chr$(10) Then
        all = all + Chr$(13) + Chr$(10)
    End If
    AppendSourceChunk = 1
End Function

Function SourceHasInclude(srcName As String) As Long
    Dim srcPath As String
    Dim chunk As String
    Dim low As String
    SourceHasInclude = 0
    srcPath = JoinPath$(gProjDir, srcName)
    chunk = LoadTextFile$(srcPath)
    low = Lower$(chunk)
    If InStr(1, low, "#include") > 0 Then
        SourceHasInclude = 1
    End If
End Function

Function CombineSources(ByRef outCombinedPath As String) As Long
    Dim i As Long
    Dim all As String
    Dim combined As String
    Dim reorder As Long

    CombineSources = 0
    all = ""
    ' #SOURCE 先頭が #include を持つ main のときだけ、依存ファイルを先に出す。
    ' （t7 のように lib→main の順はそのまま）
    reorder = 0
    If gNSources > 1 Then
        reorder = SourceHasInclude(gSources(0))
    End If
    If reorder <> 0 Then
        For i = 1 To gNSources - 1
            If AppendSourceChunk(all, gSources(i)) = 0 Then Exit Function
        Next
        If AppendSourceChunk(all, gSources(0)) = 0 Then Exit Function
    Else
        For i = 0 To gNSources - 1
            If AppendSourceChunk(all, gSources(i)) = 0 Then Exit Function
        Next
    End If

    combined = JoinPath$(gProjDir, gProjName + "_combined.abp")
    If WriteTextFile(combined, all) = 0 Then
        Print "cannot write: " + combined
        Exit Function
    End If
    outCombinedPath = combined
    CombineSources = 1
End Function

Function RunTool(toolName As String, arg1 As String, arg2 As String) As Long
    Dim toolPath As String
    Dim cmdStr As String
    Dim cmdBuf[1023] As Byte
    Dim si As STARTUPINFO
    Dim pi As PROCESS_INFORMATION
    Dim sa As SECURITY_ATTRIBUTES
    Dim ok As Long

    toolPath = ToolDir$() + toolName
    cmdStr = toolPath + " " + arg1 + " " + arg2
    Print ">> " + cmdStr

    If Len(cmdStr) >= MAX_CMDLINE Then
        Print "command line too long"
        RunTool = 0
        Exit Function
    End If

    If FileExists(toolPath) = 0 Then
        Print "not found: " + toolPath
        RunTool = 0
        Exit Function
    End If

    ZeroMemory(VarPtr(cmdBuf(0)), MAX_CMDLINE)
    lstrcpy(cmdBuf, StrPtr(cmdStr))

    ZeroMemory(VarPtr(si), SizeOf(STARTUPINFO))
    si.cb = SizeOf(STARTUPINFO)

    sa.nLength = SizeOf(SECURITY_ATTRIBUTES)
    sa.lpSecurityDescriptor = 0
    sa.bInheritHandle = 0

    ZeroMemory(VarPtr(pi), SizeOf(PROCESS_INFORMATION))

    ok = CreateProcess(NULL, cmdBuf, sa, sa, 0, 0, NULL, NULL, si, pi)
    If ok = 0 Then
        Print "cannot run: " + toolPath
        RunTool = 0
        Exit Function
    End If

    WaitForSingleObject(pi.hProcess, INFINITE)
    CloseHandle(pi.hThread)
    CloseHandle(pi.hProcess)
    RunTool = 1
End Function

Function BuildOne(abpPath As String, exePath As String) As Long
    Dim base As String
    Dim asmPath As String
    Dim objPath As String

    BuildOne = 0
    base = BaseName$(abpPath)
    asmPath = base + ".asm"
    objPath = base + ".obj"

    Print "abpc: " + abpPath + " -> " + exePath

    DeleteFile(StrPtr(asmPath))
    If RunTool("abc.exe", abpPath, asmPath) = 0 Then Exit Function
    If FileExists(asmPath) = 0 Then
        Print "abc failed: no output " + asmPath
        Exit Function
    End If

    DeleteFile(StrPtr(objPath))
    If RunTool("abassembler.exe", asmPath, objPath) = 0 Then Exit Function
    If FileExists(objPath) = 0 Then
        Print "abassembler failed: no output " + objPath
        Exit Function
    End If

    DeleteFile(StrPtr(exePath))
    If RunTool("ablinker.exe", objPath, exePath) = 0 Then Exit Function
    If FileExists(exePath) = 0 Then
        Print "ablinker failed: no output " + exePath
        Exit Function
    End If

    Print "OK: " + abpPath + " -> " + exePath
    BuildOne = 1
End Function

' --- メイン ---
Dim inPath[MAX_PATH] As Byte
Dim outPath[MAX_PATH] As Byte
Dim inName As String
Dim exePath As String
Dim combinedPath As String
Dim i As Long
Dim tmp As String

If GetCmd(1, inPath) = 0 Then
    USAGE()
End If

inName = MakeStr(inPath)

' .pj 判定は EndsWithExt に頼らずインライン（AB の UDF 解決揺れ対策）
i = Len(inName)
tmp = ""
If i >= 3 Then
    tmp = Mid$(inName, i - 2, 3)
End If
If tmp = ".pj" Or tmp = ".PJ" Or tmp = ".Pj" Or tmp = ".pJ" Then
    If ParseProject(inName) = 0 Then
        End
    End If
    Print "project: " + inName
    tmp = Str$(gNSources)
    tmp = Trim$(tmp)
    Print "  sources: " + tmp
    For i = 0 To gNSources - 1
        Print "    " + gSources(i)
    Next
    Print "  output: " + gOutExe
    If CombineSources(combinedPath) = 0 Then
        End
    End If
    If BuildOne(combinedPath, gOutExe) = 0 Then
        End
    End If
Else
    If GetCmd(2, outPath) = 0 Then
        exePath = BaseName$(inName) + ".exe"
    Else
        exePath = MakeStr(outPath)
    End If
    If BuildOne(inName, exePath) = 0 Then
        End
    End If
End If

End
