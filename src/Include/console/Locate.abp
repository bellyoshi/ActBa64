' コンソールのカーソル移動。#console のときだけ入る。
' COORD は下位ワードが桁、上位ワードが行。

Function ConCursorPos(x As Long, y As Long) As DWord
    Dim pos As DWord
    pos = y And 65535
    pos = pos << 16
    pos = pos Or (x And 65535)
    ConCursorPos = pos
End Function

Sub Locate(x As Long, y As Long)
    SetConsoleCursorPosition(GetStdHandle(&HFFFFFFF5), ConCursorPos(x, y))
End Sub
