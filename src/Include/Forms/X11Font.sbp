' Forms/X11Font.sbp - -linux の Form の文字（FreeType で OS のフォントを開き、画素バッファに字を重ねる）。
' Forms.sbp が #include する（単独では include しない）。
' 文字は OS のフォント（FORMS_FONT_PATHS の候補の最初に見つかったもの）。日本語の字のあるフォントを先に探す。
' 文字列は UTF-8。描く先と切り抜きは Forms/X11Draw.sbp の FormsTarget / FormsClip。

#ifdef _LINUX

Declare Function FT_Init_FreeType Lib "libfreetype.so.6" (lib As VoidPtr) As Long
Declare Function FT_New_Face Lib "libfreetype.so.6" (lib As VoidPtr, path As BytePtr, index As Long, face As VoidPtr) As Long
Declare Function FT_Set_Pixel_Sizes Lib "libfreetype.so.6" (face As VoidPtr, w As Long, h As Long) As Long
Declare Function FT_Load_Char Lib "libfreetype.so.6" (face As VoidPtr, code As VoidPtr, flags As Long) As Long

Const FORMS_FONT_PX = 13            ' 文字の大きさ（画素。Windows の DEFAULT_GUI_FONT くらい）
Const FORMS_FONT_PATHS = 14         ' FormsFontPath$ の候補の数

Dim g_fxFtLib As VoidPtr
Dim g_fxFace As VoidPtr
Dim g_fxFontTried As Long
Dim g_fxAsc As Long                 ' 上端から基線まで
Dim g_fxFontH As Long               ' 1 行の高さ

' == フォントを開く ==

' 候補。日本語の字のある P（文字ごとの幅）のゴシックを先に、無ければ欧文のサンセリフ
Function FormsFontPath$(i As Long) As String
    If i < 8 Then
        FormsFontPath$ = "/usr/share/fonts/" + FormsFontJa$(i)
    Else
        FormsFontPath$ = "/usr/share/fonts/" + FormsFontLatin$(i)
    End If
End Function

' 候補の 0〜7（日本語の字のあるゴシック）
Function FormsFontJa$(i As Long) As String
    FormsFontJa$ = "opentype/ipafont-gothic/ipagp.ttf"
    If i = 1 Then FormsFontJa$ = "opentype/ipaexfont-gothic/ipaexg.ttf"
    If i = 2 Then FormsFontJa$ = "opentype/noto/NotoSansCJK-Regular.ttc"
    If i = 3 Then FormsFontJa$ = "google-noto-cjk/NotoSansCJK-Regular.ttc"
    If i = 4 Then FormsFontJa$ = "truetype/takao-gothic/TakaoPGothic.ttf"
    If i = 5 Then FormsFontJa$ = "truetype/vlgothic/VL-PGothic-Regular.ttf"
    If i = 6 Then FormsFontJa$ = "ipa-pgothic/ipagp.ttf"
    If i = 7 Then FormsFontJa$ = "opentype/ipafont-gothic/ipag.ttf"
End Function

' 候補の 8〜13（欧文のサンセリフ）
Function FormsFontLatin$(i As Long) As String
    FormsFontLatin$ = ""
    If i = 8 Then FormsFontLatin$ = "truetype/dejavu/DejaVuSans.ttf"
    If i = 9 Then FormsFontLatin$ = "dejavu-sans-fonts/DejaVuSans.ttf"
    If i = 10 Then FormsFontLatin$ = "TTF/DejaVuSans.ttf"
    If i = 11 Then FormsFontLatin$ = "truetype/liberation/LiberationSans-Regular.ttf"
    If i = 12 Then FormsFontLatin$ = "liberation-sans/LiberationSans-Regular.ttf"
    If i = 13 Then FormsFontLatin$ = "truetype/freefont/FreeSans.ttf"
End Function

' 1 度だけ FreeType を始め、候補の最初に開けたフォントを使う（無ければ文字は描かない）
Sub FormsFontInit()
    If g_fxFontTried <> 0 Then Exit Sub
    g_fxFontTried = 1
    g_fxAsc = FORMS_FONT_PX
    g_fxFontH = FORMS_FONT_PX + 3
    g_fxFtLib = FormsFtLib()
    If g_fxFtLib <> 0 Then FormsFontOpen()
End Sub

' FreeType を始める。始められなければ 0
Function FormsFtLib() As VoidPtr
    Dim lib As VoidPtr
    lib = 0
    FormsFtLib = 0
    If FT_Init_FreeType(VarPtr(lib)) = 0 Then FormsFtLib = lib
End Function

' 候補を順に開き、最初に開けたものを使う
Sub FormsFontOpen()
    Dim face As VoidPtr, i As Long
    For i = 0 To FORMS_FONT_PATHS - 1
        face = FormsFtFace(FormsFontPath$(i))
        If face <> 0 Then Exit For
    Next
    If face <> 0 Then FormsFontUse(face)
End Sub

' path のフォントの face。開けなければ 0
Function FormsFtFace(path As String) As VoidPtr
    Dim face As VoidPtr
    face = 0
    FormsFtFace = 0
    If FT_New_Face(g_fxFtLib, StrPtr(path), 0, VarPtr(face)) = 0 Then FormsFtFace = face
End Function

' face を FORMS_FONT_PX の大きさで使う。基線の位置と 1 行の高さを face から読む
' （FT_FaceRec: units_per_EM +136、ascender +138（short）、size +160。FT_Size_Metrics.height +64（26.6））
Sub FormsFontUse(face As VoidPtr)
    Dim em As Long, asc As Long, size As VoidPtr
    FT_Set_Pixel_Sizes(face, 0, FORMS_FONT_PX)
    g_fxFace = face
    em = FormsW16(face, 136)
    asc = FormsI16(face, 138)
    If em > 0 Then g_fxAsc = (asc * FORMS_FONT_PX + em \ 2) \ em
    size = LxGetQ(face, 160)
    If size <> 0 Then g_fxFontH = (FormsL(size, 64) + 32) \ 64
End Sub

' 2 バイト（リトルエンディアン）。符号なし・符号つき
Function FormsW16(buf As VoidPtr, off As Long) As Long
    FormsW16 = FormsB(buf, off) + FormsB(buf, off + 1) * 256
End Function

Function FormsI16(buf As VoidPtr, off As Long) As Long
    Dim v As Long
    v = FormsW16(buf, off)
    If v >= 32768 Then v = v - 65536
    FormsI16 = v
End Function

' 1 行の高さ
Function FormsFontH() As Long
    FormsFontInit()
    FormsFontH = g_fxFontH
End Function

' == UTF-8 ==

' UTF-8 の 1 文字。戻り値はバイト数（壊れていれば 1 で U+FFFD）
Function FormsNextCp(p As *Byte, i As Long, n As Long, ByRef cp As Long) As Long
    Dim b As Long
    b = p[i]
    FormsNextCp = 1
    cp = b
    If b < &H80 Then Exit Function
    FormsNextCp = FormsUtf8Seq(p, i, n, FormsUtf8Len(b), cp)
End Function

' 先頭のバイト b の後ろに続くバイトの数（先頭のバイトでなければ 0）
Function FormsUtf8Len(b As Long) As Long
    FormsUtf8Len = 0
    If (b And &HE0) = &HC0 Then FormsUtf8Len = 1
    If (b And &HF0) = &HE0 Then FormsUtf8Len = 2
    If (b And &HF8) = &HF0 Then FormsUtf8Len = 3
End Function

' p[i] から後ろに k バイト続く字を cp に読む。戻り値はバイト数（壊れていれば 1 で U+FFFD）
Function FormsUtf8Seq(p As *Byte, i As Long, n As Long, k As Long, ByRef cp As Long) As Long
    FormsUtf8Seq = 1
    cp = &HFFFD
    If FormsUtf8Ok(p, i, n, k) = 0 Then Exit Function
    cp = FormsUtf8Cp(p, i, k)
    FormsUtf8Seq = k + 1
End Function

' p[i] の後ろに、続きのバイトが k 個（1〜3）、長さ n の中にあるか
Function FormsUtf8Ok(p As *Byte, i As Long, n As Long, k As Long) As Long
    Dim j As Long
    FormsUtf8Ok = 0
    If k = 0 Or i + k >= n Then Exit Function
    For j = 1 To k
        If FormsIsTrail(p, i + j) = 0 Then Exit Function
    Next
    FormsUtf8Ok = 1
End Function

' 先頭と k 個の続きのバイトから字の番号
Function FormsUtf8Cp(p As *Byte, i As Long, k As Long) As Long
    Dim j As Long, c As Long
    c = p[i] And (&H3F >> k)
    For j = 1 To k
        c = (c << 6) Or (p[i + j] And &H3F)
    Next
    FormsUtf8Cp = c
End Function

' p[j] が続きのバイト（10xxxxxx）なら 1
Function FormsIsTrail(p As *Byte, j As Long) As Long
    FormsIsTrail = 0
    If (p[j] And &HC0) = &H80 Then FormsIsTrail = 1
End Function

' == 字を描く ==

' FT_Load_Char で描いた字（face->glyph）を、左上 (x, y) の行の基線に合わせて色 c で重ねる
' （draw = 0 なら描かない）。戻り値は送り幅。
' FT_GlyphSlotRec: advance.x +128、pixel_mode +178、bitmap_left +192、bitmap_top +196
Function FormsGlyph(cp As Long, ByVal x As Long, ByVal y As Long, ByVal c As DWord, ByVal draw As Long) As Long
    Dim g As VoidPtr
    FormsGlyph = FORMS_FONT_PX \ 2
    If g_fxFace = 0 Then Exit Function
    If FT_Load_Char(g_fxFace, cp, 4) <> 0 Then Exit Function     ' FT_LOAD_RENDER
    g = LxGetQ(g_fxFace, 152)
    FormsGlyph = (FormsL(g, 128) + 32) \ 64
    If draw = 0 Or g_fxBuf = 0 Then Exit Function
    If FormsB(g, 178) = 2 Then FormsBlit(g, x + FormsL(g, 192), y + g_fxAsc - FormsL(g, 196), c)   ' 灰色の段階のときだけ
End Function

' 字の灰色の絵（FT_GlyphSlotRec g の bitmap）を左上 (gx, gy) に色 c で重ねる
' （bitmap.rows +152、width +156、pitch +160、buffer +168）
Sub FormsBlit(g As VoidPtr, gx As Long, gy As Long, c As DWord)
    Dim r As Long, yy As Long
    For r = 0 To FormsL(g, 152) - 1
        yy = gy + r
        If yy >= g_fxClipT And yy < g_fxClipB Then FormsBlitRow(FormsAt(LxGetQ(g, 168), r * FormsL(g, 160)), FormsRow(yy), gx, FormsL(g, 156), c)
    Next
End Sub

' 字の 1 行（濃さ sp[0] から sp[w - 1]）を row の x = gx から重ねる
Sub FormsBlitRow(sp As *Byte, row As *DWord, gx As Long, w As Long, c As DWord)
    Dim k As Long, xx As Long
    For k = 0 To w - 1
        xx = gx + k
        If sp[k] <> 0 And xx >= g_fxClipL And xx < g_fxClipR Then row[xx] = FormsBlend(row[xx], c, sp[k])
    Next
End Sub

' 文字列の幅（draw <> 0 なら左上 (x, y) に色 c で描く）
Function FormsTextRun(s As String, ByVal x As Long, ByVal y As Long, ByVal c As DWord, ByVal draw As Long) As Long
    Dim i As Long, w As Long
    FormsFontInit()
    i = 0
    w = 0
    While i < Len(s)
        w = w + FormsGlyphAt(s, i, x + w, y, c, draw)
    Wend
    FormsTextRun = w
End Function

' s の i バイト目の字を (x, y) に描き（draw <> 0 のとき）、i を次の字へ進める。戻り値は送り幅
Function FormsGlyphAt(s As String, ByRef i As Long, x As Long, y As Long, c As DWord, draw As Long) As Long
    Dim cp As Long
    i = i + FormsNextCp(StrPtr(s), i, Len(s), cp)
    FormsGlyphAt = FormsGlyph(cp, x, y, c, draw)
End Function

Sub FormsText(s As String, ByVal x As Long, ByVal y As Long, ByVal c As DWord)
    FormsTextRun(s, x, y, c, 1)
End Sub

Function FormsTextW(s As String) As Long
    FormsTextW = FormsTextRun(s, 0, 0, 0, 0)
End Function

#endif
