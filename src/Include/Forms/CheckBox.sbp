' Forms/CheckBox.sbp - チェックボックス CheckBox。
' Forms.sbp が #include する（単独では include しない）。

#ifdef _LINUX

' チェックボックス。押すと印が切り替わり、親の WndProc に WM_COMMAND（BN_CLICKED）が届く。
' X11 版は印を Checked に持つ（押して変わった印も Checked に入る）
Class CheckBox
    Inherits Control
Public
    Override Function LxKind() As Long
        LxKind = FORMS_K_CHECK
    End Function

    ' 印が付いているか（True / False）
    Function GetChecked() As Long
        GetChecked = Checked
    End Function

    ' 印を付ける・外す
    Sub SetChecked(b As Long)
        Checked = b
        FormsCtlChanged(Owner)
    End Sub
End Class

#else

' チェックボックス（BUTTON の BS_AUTOCHECKBOX。Lazarus の TCheckBox）。押すと印が切り替わり、
' 親の WndProc に WM_COMMAND（BN_CLICKED）が届く。Checked は窓ができる前の初めの値。
' 窓ができたあとの印は GetChecked / SetChecked で読み書きする（押して変わった印は Checked に入らない）
Class CheckBox
    Inherits Control
Public
    Checked As Long

    Override Sub CreateHandle(parent As HWND)
        Handle = CreateWindowEx(0, "BUTTON", StrPtr(Caption), WS_CHILD Or WS_VISIBLE Or WS_TABSTOP Or BS_AUTOCHECKBOX, Left, Top, Width, Height, parent, 0, GetModuleHandle(0), 0)
        AfterCreate()
        If Checked <> False Then SendMessage(Handle, BM_SETCHECK, BST_CHECKED, 0)
    End Sub

    ' 印が付いているか（True / False）
    Function GetChecked() As Long
        GetChecked = Checked
        If Handle = 0 Then Exit Function
        GetChecked = False
        If SendMessage(Handle, BM_GETCHECK, 0, 0) = BST_CHECKED Then GetChecked = True
    End Function

    ' 印を付ける・外す。窓がもうあれば窓も変える
    Sub SetChecked(b As Long)
        Checked = b
        If Handle = 0 Then Exit Sub
        If b <> False Then
            SendMessage(Handle, BM_SETCHECK, BST_CHECKED, 0)
        Else
            SendMessage(Handle, BM_SETCHECK, BST_UNCHECKED, 0)
        End If
    End Sub
End Class

#endif
