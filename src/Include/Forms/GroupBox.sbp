' Forms/GroupBox.sbp - 囲みの枠 GroupBox。
' Forms.sbp が #include する（単独では include しない）。

#ifdef _LINUX

' 囲みの枠。X11 版は値を覚えるだけ
Class GroupBox
    Inherits Control
End Class

#else

' 囲みの枠（BUTTON の BS_GROUPBOX。Lazarus の TGroupBox）。彫った線の枠と、左上に Caption を出す。
' 押しても何も届かない。中に部品を載せることはまだできない（枠の上に置いた部品もフォームに載る）。
' ラジオボタンの組も分けない（フォームのラジオボタンはすべて 1 つの組のまま）
Class GroupBox
    Inherits Control
Public
    Override Sub CreateHandle(parent As HWND)
        Handle = CreateWindowEx(0, "BUTTON", StrPtr(Caption), WS_CHILD Or WS_VISIBLE Or BS_GROUPBOX, Left, Top, Width, Height, parent, 0, GetModuleHandle(0), 0)
        AfterCreate()
    End Sub
End Class

#endif
