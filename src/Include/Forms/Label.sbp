' Forms/Label.sbp - 文字だけの部品 Label。
' Forms.sbp が #include する（単独では include しない）。

#ifdef _LINUX

' 文字だけの部品。押しても何も届かない
Class Label
    Inherits Control
Public
    Override Function LxKind() As Long
        LxKind = FORMS_K_LABEL
    End Function
End Class

#else

' 文字だけの部品（STATIC）。押しても何も届かない
Class Label
    Inherits Control
Public
    Override Sub CreateHandle(parent As HWND)
        Handle = CreateWindowEx(0, "STATIC", StrPtr(Caption), WS_CHILD Or WS_VISIBLE Or SS_LEFT, Left, Top, Width, Height, parent, 0, GetModuleHandle(0), 0)
        AfterCreate()
    End Sub
End Class

#endif
