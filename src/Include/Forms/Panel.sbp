' Forms/Panel.sbp - 板 Panel。
' Forms.sbp が #include する（単独では include しない）。

#ifdef _LINUX

' 板。縁がへこみ、見出しを真ん中に出す。押しても何も届かない
Class Panel
    Inherits Control
Public
    Override Function LxKind() As Long
        LxKind = FORMS_K_PANEL
    End Function
End Class

#else

' 板（STATIC。Lazarus の TPanel）。縁がへこみ、見出しを真ん中に出す。中に部品を載せることはまだできない
Class Panel
    Inherits Control
Public
    Override Sub CreateHandle(parent As HWND)
        Handle = CreateWindowEx(WS_EX_STATICEDGE, "STATIC", StrPtr(Caption), WS_CHILD Or WS_VISIBLE Or SS_CENTER Or SS_CENTERIMAGE, Left, Top, Width, Height, parent, 0, GetModuleHandle(0), 0)
        AfterCreate()
    End Sub
End Class

#endif
