' Forms/FormEdit.sbp - -linux の EditBox の文字の編集（キャレット、← → Home End BackSpace Delete、1 文字）。
' Forms.sbp が #include する（単独では include しない）。
' 文字は UTF-8 で、キャレット（LxCaret）は Caption のバイト位置。打ち込めるのは英数字・記号だけ。

#ifdef _LINUX

' EditBox の文字が変わった（p は部品）。窓があれば親へ EN_CHANGE
Sub FormsEditChanged(p As VoidPtr)
    Dim c As *Control, f As *Form
    c = p As *Control
    If c->Owner = 0 Then Exit Sub
    f = c->Owner As *Form
    If f->Handle = 0 Then Exit Sub
    FormsNotify(f, c, EN_CHANGE)
End Sub

' 前の文字の先頭のバイト位置
Function FormsPrevPos(s As String, i As Long) As Long
    Dim j As Long
    FormsPrevPos = 0
    If i <= 0 Then Exit Function
    j = i - 1
    While j > 0 And FormsIsTrail(StrPtr(s), j) <> 0
        j = j - 1
    Wend
    FormsPrevPos = j
End Function

' 次の文字の先頭のバイト位置
Function FormsNextPos(s As String, i As Long) As Long
    Dim cp As Long, n As Long
    n = Len(s)
    FormsNextPos = n
    If i >= n Then Exit Function
    FormsNextPos = i + FormsNextCp(StrPtr(s), i, n, cp)
End Function

' s の i バイト目から後ろ
Function FormsTail$(s As String, i As Long) As String
    FormsTail$ = ""
    If i < Len(s) Then FormsTail$ = Mid$(s, i + 1, Len(s) - i)
End Function

' 押した x に近い、文字の間のバイト位置
Function FormsEditPos(c As *Control, x As Long) As Long
    FormsFontInit()
    FormsEditPos = FormsTextPos(c->Caption, x - (c->Left + 4 - c->LxScroll))
End Function

' s の左端から rel 画素に近い、文字の間のバイト位置
Function FormsTextPos(s As String, rel As Long) As Long
    Dim i As Long
    i = 0
    While i < Len(s)
        If FormsTextStep(s, i, rel) <> 0 Then Exit While
    Wend
    FormsTextPos = i
End Function

' i バイト目の字の幅の半分より rel が左なら 1。そうでなければ i と rel を次の字へ進めて 0
Function FormsTextStep(s As String, ByRef i As Long, ByRef rel As Long) As Long
    Dim k As Long, cp As Long, gw As Long
    k = FormsNextCp(StrPtr(s), i, Len(s), cp)
    gw = FormsGlyph(cp, 0, 0, 0, 0)
    FormsTextStep = 1
    If rel < gw \ 2 Then Exit Function
    FormsTextStep = 0
    rel = rel - gw
    i = i + k
End Function

' EditBox のキー（← → Home End BackSpace Delete と、英数字・記号の 1 文字）。ほかは 0
Function FormsEditKey(f As *Form, c As *Control, ks As Long, n As Long) As Long
    Dim s As String, i As Long, r As Long
    s = c->Caption
    i = c->LxCaret
    If i > Len(s) Then i = Len(s)
    r = FormsEditDo(s, i, ks, n)
    FormsEditKey = FormsEditApply(f, c, s, i, r)
End Function

' r = 0（扱わないキー）なら 0。ほかは文字 s とキャレット i を入れて描き直し、
' r = 2（文字が変わった）なら親へ EN_CHANGE。戻り値 1
Function FormsEditApply(f As *Form, c As *Control, s As String, i As Long, r As Long) As Long
    FormsEditApply = 0
    If r = 0 Then Exit Function
    FormsEditApply = 1
    c->Caption = s
    c->LxCaret = i
    FormsPaint(f As VoidPtr)
    If r = 2 Then FormsNotify(f, c, EN_CHANGE)
End Function

' キー ks を文字 s とキャレット i に当てる。戻り値 0 = 扱わない、1 = 文字は変わらない、2 = 変わった
Function FormsEditDo(ByRef s As String, ByRef i As Long, ks As Long, n As Long) As Long
    FormsEditDo = 1
    If FormsEditMove(s, i, ks) <> 0 Then Exit Function
    If ks = &HFF08 Then
        FormsEditDo = FormsEditBack(s, i)
    ElseIf ks = &HFFFF Or ks = &HFF9F Then
        FormsEditDo = FormsEditDel(s, i)
    Else
        FormsEditDo = FormsEditChar(s, i, n)
    End If
End Function

' ← → Home End（テンキーのも）。キャレットを動かしたら 1
Function FormsEditMove(s As String, ByRef i As Long, ks As Long) As Long
    Dim j As Long
    j = FormsMoveTo(s, i, ks)
    FormsEditMove = 0
    If j < 0 Then Exit Function
    i = j
    FormsEditMove = 1
End Function

' 動かすキーの行き先のバイト位置。動かすキーでなければ -1
Function FormsMoveTo(s As String, i As Long, ks As Long) As Long
    FormsMoveTo = -1
    If ks = &HFF51 Or ks = &HFF96 Then FormsMoveTo = FormsPrevPos(s, i)
    If ks = &HFF53 Or ks = &HFF98 Then FormsMoveTo = FormsNextPos(s, i)
    If ks = &HFF50 Or ks = &HFF95 Then FormsMoveTo = 0
    If ks = &HFF57 Or ks = &HFF9C Then FormsMoveTo = Len(s)
End Function

' BackSpace。前の字を消したら 2、キャレットが先頭なら 1
Function FormsEditBack(ByRef s As String, ByRef i As Long) As Long
    Dim j As Long
    FormsEditBack = 1
    If i <= 0 Then Exit Function
    j = FormsPrevPos(s, i)
    s = Left$(s, j) + FormsTail$(s, i)
    i = j
    FormsEditBack = 2
End Function

' Delete。次の字を消したら 2、キャレットが末尾なら 1
Function FormsEditDel(ByRef s As String, i As Long) As Long
    FormsEditDel = 1
    If i >= Len(s) Then Exit Function
    s = Left$(s, i) + FormsTail$(s, FormsNextPos(s, i))
    FormsEditDel = 2
End Function

' 英数字・記号の 1 文字（g_formsKey(0)）をキャレットに入れたら 2。ほかの文字とキーは 0
Function FormsEditChar(ByRef s As String, ByRef i As Long, n As Long) As Long
    Dim ch As Long
    FormsEditChar = 0
    If n < 1 Then Exit Function
    ch = g_formsKey(0)
    If ch < 32 Or ch > 126 Then Exit Function
    s = Left$(s, i) + Chr$(ch) + FormsTail$(s, i)
    i = i + 1
    FormsEditChar = 2
End Function

#endif
