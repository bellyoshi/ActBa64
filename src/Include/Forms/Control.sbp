' Forms/Control.sbp - 部品の基底 Control。
' Forms.sbp が #include する（単独では include しない）。

#ifdef _LINUX

' 部品の種類（LxKind）
Const FORMS_K_NONE = 0
Const FORMS_K_BUTTON = 1
Const FORMS_K_CHECK = 2
Const FORMS_K_RADIO = 3
Const FORMS_K_EDIT = 4
Const FORMS_K_LABEL = 5
Const FORMS_K_PANEL = 6
Const FORMS_K_GROUP = 7
Const FORMS_K_PICTURE = 8

Dim g_formsNextId As Long           ' 部品の Handle（窓ではない番号）の次の値

' 部品。X11 版は子窓を作らず、Form の画素バッファに描き（FormsPaintCtl、Forms/FormPaint.sbp）、
' Form がマウスとキーを部品へ配る。Handle は窓ではないが、部品ごとに違う 0 でない値
' （WndProc の WM_COMMAND の lParam と比べられる）
Class Control
Public
    Left As Long
    Top As Long
    Width As Long
    Height As Long
    Caption As String
    Handle As HWND
    Enabled As Long             ' 使えるか（初めは True）
    NextControl As *Control     ' 同じ Form に載せた次の部品（Forms.sbp が使う）
    Checked As Long             ' CheckBox / RadioButton の印（X11 版はここに持つ）
    Owner As VoidPtr            ' 載っている Form（*Form。CreateHandle で決まる）
    LxCaret As Long             ' EditBox: キャレットの位置（Caption のバイト）
    LxScroll As Long            ' EditBox: 横に流した画素

    Sub Control()
        Enabled = True
    End Sub

    ' 種類（FORMS_K_*）。子のクラスが Override する
    Virtual Function LxKind() As Long
        LxKind = FORMS_K_NONE
    End Function

    ' Form の窓ができたときに Form が呼ぶ。番号を Handle にし、Form を覚える
    Virtual Sub CreateHandle(parent As HWND)
        g_formsNextId = g_formsNextId + 1
        Handle = (&H10000 + g_formsNextId) As HWND
        Owner = FormsFind(parent As VoidPtr)
        LxCaret = Len(Caption)
        LxScroll = 0
    End Sub

    ' 文字を変える。窓がもうあれば描き直す
    Sub SetCaption(s As String)
        Caption = s
        If LxCaret > Len(Caption) Then LxCaret = Len(Caption)
        FormsCtlChanged(Owner)
    End Sub

    ' 使える・使えないを変える（使えない部品は灰色で、押せない）
    Sub SetEnabled(b As Long)
        Enabled = b
        FormsCtlChanged(Owner)
    End Sub

    ' 位置と大きさを変える
    Sub SetBounds(x As Long, y As Long, w As Long, h As Long)
        Left = x
        Top = y
        Width = w
        Height = h
        FormsCtlChanged(Owner)
    End Sub
End Class

#else

' 部品。子のクラスが CreateHandle で子窓を作る
Class Control
Public
    Left As Long
    Top As Long
    Width As Long
    Height As Long
    Caption As String
    Handle As HWND
    Enabled As Long             ' 使えるか（初めは True）
    NextControl As *Control     ' 同じ Form に載せた次の部品（Forms.sbp が使う）

    Sub Control()
        Enabled = True
    End Sub

    ' parent の中に子窓を作る
    Virtual Sub CreateHandle(parent As HWND)
    End Sub

    ' 文字を変える。窓がもうあれば窓の文字も変える
    Sub SetCaption(s As String)
        Caption = s
        If Handle <> 0 Then SetWindowText(Handle, StrPtr(Caption))
    End Sub

    ' 使える・使えないを変える。窓がもうあれば窓も変える
    Sub SetEnabled(b As Long)
        Enabled = b
        If Handle <> 0 Then EnableWindow(Handle, b)
    End Sub

    ' 位置と大きさを変える。窓がもうあれば窓も動かす
    Sub SetBounds(x As Long, y As Long, w As Long, h As Long)
        Left = x
        Top = y
        Width = w
        Height = h
        If Handle <> 0 Then MoveWindow(Handle, x, y, w, h, TRUE)
    End Sub

    ' 子窓を作った直後に、文字（DEFAULT_GUI_FONT）と Enabled を窓へ
    Sub AfterCreate()
        FormsSetFont(Handle)
        If Enabled = False Then EnableWindow(Handle, FALSE)
    End Sub
End Class

' 子窓の文字を、システムの文字（DEFAULT_GUI_FONT）にする
Sub FormsSetFont(h As HWND)
    SendMessage(h, WM_SETFONT, GetStockObject(DEFAULT_GUI_FONT) As WPARAM, 0)
End Sub

#endif
