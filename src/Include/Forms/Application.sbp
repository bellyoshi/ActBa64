' Forms/Application.sbp - メッセージループ FormsApplication と Application。
' Forms.sbp が #include する（単独では include しない）。

#ifdef _LINUX

Class FormsApplication
Public
    ' 今は何もしない（Lazarus の Application.Initialize に合わせた入口）
    Sub Initialize()
    End Sub

    ' フォームを表示し、窓が閉じるまでメッセージを回す
    Sub Run(ByRef f As Form)
        g_formsQuit = 0
        f.Show()
        While g_formsQuit = 0
            XNextEvent(g_formsDpy, VarPtr(g_formsEv(0)))
            FormsDispatch()
        Wend
        XCloseDisplay(g_formsDpy)
        g_formsDpy = 0
    End Sub
End Class

Dim Application As FormsApplication

#else

Class FormsApplication
Public
    ' 今は何もしない（Lazarus の Application.Initialize に合わせた入口）
    Sub Initialize()
    End Sub

    ' フォームを表示し、窓が閉じるまでメッセージを回す
    Sub Run(ByRef f As Form)
        Dim msg As MSG
        f.Show()
        While GetMessage(msg, 0, 0, 0) > 0
            TranslateMessage(msg)
            DispatchMessage(msg)
        Wend
    End Sub
End Class

Dim Application As FormsApplication

#endif
