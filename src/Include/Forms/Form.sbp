' Forms/Form.sbp - 窓 Form と、窓を作る・メッセージを配るための関数。
' Forms.sbp が #include する（単独では include しない）。

#ifdef _LINUX

Class Form
Private
    firstControl As *Control        ' AddControl で載せた部品（NextControl でつなぐ）
    lastControl As *Control
    componentsDone As Long          ' InitializeComponent を呼んだか
Public
    Left As Long
    Top As Long
    Width As Long
    Height As Long
    Caption As String
    Handle As HWND
    ' X11 版の絵と入力（Forms/X11Draw.sbp と下の Forms* が使う）
    LxBuf As VoidPtr                ' 窓の大きさの画素バッファ（&HRRGGBB）
    LxImg As VoidPtr                ' LxBuf の XImage
    LxBufW As Long
    LxBufH As Long
    LxStride As Long
    LxFocus As *Control             ' キーを受ける部品。0 は Form
    LxPress As *Control             ' マウスを押している部品
    LxPressIn As Long               ' マウスが LxPress の上にあるか

    Sub Form()
        Left = CW_USEDEFAULT
        Top = CW_USEDEFAULT
        Width = CW_USEDEFAULT
        Height = CW_USEDEFAULT
    End Sub

    ' フォームデザイナが Override して、位置・大きさ・見出し・部品を入れる。最初の Show で 1 度だけ呼ばれる
    Virtual Sub InitializeComponent()
    End Sub

    ' まだなら InitializeComponent を呼ぶ（Show が呼ぶ。窓を出す前に値を読みたいときにも使える）
    Sub InitComponents()
        If componentsDone <> 0 Then Exit Sub
        componentsDone = 1
        InitializeComponent()
    End Sub

    ' 部品を載せる。窓がもうあれば、すぐ子窓を作る
    Sub AddControl(ByRef c As Control)
        Dim p As *Control, q As *Control
        p = VarPtr(c)
        p->NextControl = 0
        If lastControl = 0 Then
            firstControl = p
        Else
            q = lastControl
            q->NextControl = p
        End If
        lastControl = p
        If Handle <> 0 Then
            c.CreateHandle(Handle)
            FormsPaint(This)
        End If
    End Sub

    ' 載せた最初の部品（あとは NextControl）
    Function FirstCtl() As *Control
        FirstCtl = firstControl
    End Function

    ' 載せた部品に Handle を付ける（窓ができたときに Forms.sbp が呼ぶ）
    Sub CreateControls()
        Dim c As *Control
        c = firstControl
        While c <> 0
            c->CreateHandle(Handle)
            c = c->NextControl
        Wend
    End Sub

    ' 窓のメッセージ。既定は、WM_CLOSE で窓を壊し、窓が壊れたらメッセージループを終わらせる
    Virtual Function WndProc(msg As DWord, wParam As WPARAM, lParam As LPARAM) As LRESULT
        If msg = WM_CLOSE Then FormsDestroy(This)
        If msg = WM_DESTROY Then g_formsQuit = 1
        WndProc = 0
    End Function

    ' 窓がまだ無ければ作って、表示する
    Sub Show()
        InitComponents()
        If Handle = 0 Then FormsCreate(This)
        XMapWindow(g_formsDpy, Handle)
        XFlush(g_formsDpy)
    End Sub

    ' 窓を閉じる（WM_CLOSE をメッセージとして自分へ送る）
    Sub Close()
        If Handle <> 0 Then FormsPostClose(Handle)
    End Sub

    ' 見出しを変える。窓がもうあれば窓の見出しも変える。
    ' 先に InitializeComponent を済ませる（あとで呼ばれて Caption を上書きしないように）
    Sub SetCaption(s As String)
        InitComponents()
        Caption = s
        If Handle <> 0 Then FormsTitle(Handle As VoidPtr, Caption)
    End Sub
End Class

' 8 バイト・4 バイトの読み書き（VoidPtr 配列は使わない）
Function FormsQ(buf As VoidPtr, off As Long) As VoidPtr
    FormsQ = LxGetQ(buf, off)
End Function

Function FormsL(buf As VoidPtr, off As Long) As Long
    Dim p As *Long
    p = buf + off
    FormsL = p[0]
End Function

Sub FormsSetL(buf As VoidPtr, off As Long, v As Long)
    Dim p As *Long
    p = buf + off
    p[0] = v
End Sub

Function FormsAtom(i As Long) As VoidPtr
    FormsAtom = LxGetQ(VarPtr(g_formsAtom(0)), i * 8)
End Function

' 1 度だけ X サーバーへつなぐ。つながらなければ終わる
Sub FormsOpen()
    If FormsTryOpen() <> 0 Then Exit Sub
    Print "Forms: cannot open X display (DISPLAY is not set?)"
    ExitProcess(1)
End Sub

' X サーバーへつなぐ（つないであればそのまま）。つながらなければ 0
Function FormsTryOpen() As Long
    FormsTryOpen = 1
    If g_formsDpy <> 0 Then Exit Function
    FormsTryOpen = 0
    g_formsDpy = XOpenDisplay(0)
    If g_formsDpy = 0 Then Exit Function
    FormsTryOpen = 1
    g_formsScr = XDefaultScreen(g_formsDpy)
    LxSetQ(VarPtr(g_formsAtom(0)), 0, XInternAtom(g_formsDpy, "WM_DELETE_WINDOW", 0))
    LxSetQ(VarPtr(g_formsAtom(0)), 8, XInternAtom(g_formsDpy, "WM_PROTOCOLS", 0))
End Function

' 窓 → Form の表。無ければ 0
Function FormsFind(w As VoidPtr) As *Form
    Dim i As Long
    FormsFind = 0
    If w = 0 Then Exit Function
    For i = 0 To FORMS_MAX - 1
        If FormsQ(VarPtr(g_formsTab(0)), i * 16) = w Then
            FormsFind = FormsQ(VarPtr(g_formsTab(0)), i * 16 + 8) As *Form
            Exit Function
        End If
    Next
End Function

Sub FormsBind(w As VoidPtr, f As VoidPtr)
    Dim i As Long
    For i = 0 To FORMS_MAX - 1
        If FormsQ(VarPtr(g_formsTab(0)), i * 16) = 0 Then
            LxSetQ(VarPtr(g_formsTab(0)), i * 16, w)
            LxSetQ(VarPtr(g_formsTab(0)), i * 16 + 8, f)
            Exit Sub
        End If
    Next
End Sub

Sub FormsUnbind(w As VoidPtr)
    Dim i As Long
    For i = 0 To FORMS_MAX - 1
        If FormsQ(VarPtr(g_formsTab(0)), i * 16) = w Then
            LxSetQ(VarPtr(g_formsTab(0)), i * 16, 0)
            LxSetQ(VarPtr(g_formsTab(0)), i * 16 + 8, 0)
        End If
    Next
End Sub

' 窓を作り、見出し・位置・閉じるボタンを設定して WM_CREATE を送る
Sub FormsCreate(p As VoidPtr)
    Dim f As *Form
    Dim w As VoidPtr, x As Long, y As Long, cx As Long, cy As Long
    Dim flags As Long, n As Long
    f = p As *Form
    FormsOpen()
    x = f->Left : y = f->Top : cx = f->Width : cy = f->Height
    flags = 3                       ' USPosition | USSize
    If x = CW_USEDEFAULT Or y = CW_USEDEFAULT Then
        x = 0 : y = 0 : flags = 2
    End If
    If cx = CW_USEDEFAULT Or cx <= 0 Then cx = 400
    If cy = CW_USEDEFAULT Or cy <= 0 Then cy = 300
    f->Width = cx                   ' 描くときの大きさ（あとは ConfigureNotify が変える）
    f->Height = cy
    w = XCreateSimpleWindow(g_formsDpy, XRootWindow(g_formsDpy, g_formsScr), x, y, cx, cy, 0, 0, &HF0F0F0)
    f->Handle = w As HWND
    FormsBind(w, p)

    FormsTitle(w, f->Caption)

    ' 位置と大きさ（WM が従うように USPosition / USSize）
    RtlFillMemory(VarPtr(g_formsHint(0)), 80, 0)
    FormsSetL(VarPtr(g_formsHint(0)), 0, flags)
    FormsSetL(VarPtr(g_formsHint(0)), 8, x)
    FormsSetL(VarPtr(g_formsHint(0)), 12, y)
    FormsSetL(VarPtr(g_formsHint(0)), 16, cx)
    FormsSetL(VarPtr(g_formsHint(0)), 20, cy)
    XSetWMNormalHints(g_formsDpy, w, VarPtr(g_formsHint(0)))

    XSetWMProtocols(g_formsDpy, w, VarPtr(g_formsAtom(0)), 1)
    XSelectInput(g_formsDpy, w, FORMS_X_MASK)
    f->CreateControls()
    f->WndProc(WM_CREATE, 0, 0)
End Sub

' 見出し。_NET_WM_NAME は UTF-8（日本語も出る）、WM_NAME は古い WM 向け
Sub FormsTitle(w As VoidPtr, cap As String)
    XStoreName(g_formsDpy, w, StrPtr(cap))
    XChangeProperty(g_formsDpy, w, XInternAtom(g_formsDpy, "_NET_WM_NAME", 0), XInternAtom(g_formsDpy, "UTF8_STRING", 0), 8, 0, StrPtr(cap), FormsStrLen(StrPtr(cap)))
    XFlush(g_formsDpy)
End Sub

' WM_DESTROY を送ってから窓を壊す（Windows の DestroyWindow と同じ順）
Sub FormsDestroy(p As VoidPtr)
    Dim f As *Form
    Dim w As VoidPtr
    f = p As *Form
    w = f->Handle As VoidPtr
    If w = 0 Then Exit Sub
    f->WndProc(WM_DESTROY, 0, 0)
    FormsUnbind(w)
    f->Handle = 0
    f->LxFocus = 0
    f->LxPress = 0
    FormsFreeImage(f->LxImg)
    f->LxImg = 0
    If f->LxBuf <> 0 Then free(f->LxBuf)
    f->LxBuf = 0
    XDestroyWindow(g_formsDpy, w)
    XFlush(g_formsDpy)
End Sub

' 閉じるボタンと同じ ClientMessage（WM_DELETE_WINDOW）を自分へ送る
Sub FormsPostClose(h As HWND)
    Dim b As VoidPtr
    b = VarPtr(g_formsSend(0))
    RtlFillMemory(b, 192, 0)
    FormsSetL(b, 0, 33)             ' ClientMessage
    LxSetQ(b, 32, h As VoidPtr)     ' window
    LxSetQ(b, 40, FormsAtom(1))     ' message_type = WM_PROTOCOLS
    FormsSetL(b, 48, 32)            ' format
    LxSetQ(b, 56, FormsAtom(0))     ' data.l[0] = WM_DELETE_WINDOW
    XSendEvent(g_formsDpy, h As VoidPtr, 0, 0, b)
    XFlush(g_formsDpy)
End Sub

' 位置 → lParam（MAKELPARAM(x, y)）
Function FormsXY(x As Long, y As Long) As LPARAM
    FormsXY = ((y And &HFFFF) * &H10000 + (x And &HFFFF)) As LPARAM
End Function

' KeySym → 仮想キー（英数字・空白・Enter・Esc・BS・Tab・矢印・Home / End / PageUp / PageDown・
' Insert / Delete・F1〜F12・Shift / Ctrl / Alt・テンキーの数字。ほかは KeySym のまま）
Function FormsVk(ks As Long) As Long
    FormsVk = ks
    If ks >= &H61 And ks <= &H7A Then FormsVk = ks - &H20
    If ks = &HFF0D Or ks = &HFF8D Then FormsVk = 13       ' VK_RETURN（テンキーの Enter も）
    If ks = &HFF1B Then FormsVk = 27
    If ks = &HFF08 Then FormsVk = 8
    If ks = &HFF09 Or ks = &HFE20 Then FormsVk = 9        ' VK_TAB（Shift+Tab の ISO_Left_Tab も）
    If ks >= &HFF51 And ks <= &HFF54 Then FormsVk = ks - &HFF51 + 37
    If ks = &HFF50 Then FormsVk = &H24                    ' VK_HOME
    If ks = &HFF57 Then FormsVk = &H23                    ' VK_END
    If ks = &HFF55 Then FormsVk = &H21                    ' VK_PRIOR
    If ks = &HFF56 Then FormsVk = &H22                    ' VK_NEXT
    If ks = &HFF63 Then FormsVk = &H2D                    ' VK_INSERT
    If ks = &HFFFF Then FormsVk = &H2E                    ' VK_DELETE
    If ks >= &HFFBE And ks <= &HFFC9 Then FormsVk = ks - &HFFBE + &H70   ' VK_F1〜VK_F12
    If ks = &HFFE1 Or ks = &HFFE2 Then FormsVk = &H10     ' VK_SHIFT
    If ks = &HFFE3 Or ks = &HFFE4 Then FormsVk = &H11     ' VK_CONTROL
    If ks = &HFFE9 Or ks = &HFFEA Then FormsVk = &H12     ' VK_MENU（Alt）
    If ks >= &HFFB0 And ks <= &HFFB9 Then FormsVk = ks - &HFFB0 + &H60   ' VK_NUMPAD0〜9
End Function

' マウスのボタン → WM_?BUTTONDOWN（up = 1 なら UP）。ホイールなどは 0
Function FormsButtonMsg(button As Long, up As Long) As DWord
    FormsButtonMsg = 0
    If button = 1 Then FormsButtonMsg = WM_LBUTTONDOWN + up
    If button = 2 Then FormsButtonMsg = WM_MBUTTONDOWN + up
    If button = 3 Then FormsButtonMsg = WM_RBUTTONDOWN + up
End Function

' XEvent 1 つを、その窓の Form の WndProc へ
Sub FormsDispatch()
    Dim e As VoidPtr, t As Long, n As Long, ks As Long
    Dim msg As DWord
    Dim f As *Form
    e = VarPtr(g_formsEv(0))
    t = FormsL(e, 0)
    f = FormsFind(FormsQ(e, 32))
    If f = 0 Then Exit Sub
    Select Case t
        Case 12                     ' Expose（まとめの最後だけ）。部品を描いてから WM_PAINT
            If FormsL(e, 56) = 0 Then
                FormsPaint(f As VoidPtr)
                f->WndProc(WM_PAINT, 0, 0)
            End If
        Case 22                     ' ConfigureNotify
            If FormsL(e, 56) <> f->Width Or FormsL(e, 60) <> f->Height Then
                f->Width = FormsL(e, 56)
                f->Height = FormsL(e, 60)
                f->WndProc(WM_SIZE, 0, FormsXY(f->Width, f->Height))
            End If
        Case 4                      ' ButtonPress（部品の上の左ボタンは部品へ）
            If FormsL(e, 84) = 1 Then
                If FormsCtlDown(f, FormsL(e, 64), FormsL(e, 68)) <> 0 Then Exit Sub
            End If
            msg = FormsButtonMsg(FormsL(e, 84), 0)
            If msg <> 0 Then f->WndProc(msg, 0, FormsXY(FormsL(e, 64), FormsL(e, 68)))
        Case 5                      ' ButtonRelease
            If FormsL(e, 84) = 1 Then
                If FormsCtlUp(f, FormsL(e, 64), FormsL(e, 68)) <> 0 Then Exit Sub
            End If
            msg = FormsButtonMsg(FormsL(e, 84), 1)
            If msg <> 0 Then f->WndProc(msg, 0, FormsXY(FormsL(e, 64), FormsL(e, 68)))
        Case 6                      ' MotionNotify
            If FormsCtlMove(f, FormsL(e, 64), FormsL(e, 68)) <> 0 Then Exit Sub
            f->WndProc(WM_MOUSEMOVE, 0, FormsXY(FormsL(e, 64), FormsL(e, 68)))
        Case 2                      ' KeyPress（キーを受ける部品があればそちらへ）
            n = XLookupString(e, VarPtr(g_formsKey(0)), 16, VarPtr(g_formsSym(0)), 0)
            ks = FormsL(VarPtr(g_formsSym(0)), 0)
            If FormsCtlKey(f, ks, n, FormsL(e, 80)) <> 0 Then Exit Sub
            f->WndProc(WM_KEYDOWN, FormsVk(ks) As WPARAM, 0)
            If n >= 1 Then f->WndProc(WM_CHAR, g_formsKey(0) As WPARAM, 0)
        Case 33                     ' ClientMessage（閉じるボタン）
            If FormsQ(e, 56) = FormsAtom(0) Then f->WndProc(WM_CLOSE, 0, 0)
    End Select
End Sub

' ==== X11 版の部品：描く ====
' 部品は子窓を作らず、Form の画素バッファ（LxBuf）に載せた順に描く（後に載せたものが上）。

' 部品を描いて窓へ写す（p は *Form。窓が無ければ何もしない）
Sub FormsPaint(p As VoidPtr)
    Dim f As *Form, c As *Control
    Dim w As Long, h As Long
    Dim old As VoidPtr
    If p = 0 Or g_formsDpy = 0 Then Exit Sub
    f = p As *Form
    If f->Handle = 0 Then Exit Sub
    w = f->Width
    h = f->Height
    If w < 1 Then w = 1
    If h < 1 Then h = 1
    If f->LxBuf = 0 Or w <> f->LxBufW Or h <> f->LxBufH Then
        old = f->LxBuf
        FormsFreeImage(f->LxImg)
        f->LxBuf = malloc(w * h * 4)
        f->LxBufW = w
        f->LxBufH = h
        f->LxImg = 0
        f->LxStride = w * 4
        If f->LxBuf <> 0 Then f->LxImg = XCreateImage(g_formsDpy, XDefaultVisual(g_formsDpy, g_formsScr), XDefaultDepth(g_formsDpy, g_formsScr), 2, 0, f->LxBuf, w, h, 32, 0)
        If f->LxImg <> 0 Then f->LxStride = FormsL(f->LxImg, 44)      ' XImage.bytes_per_line
        If old <> 0 Then free(old)
    End If
    If f->LxImg = 0 Then Exit Sub
    FormsTarget(f->LxBuf, w, h, f->LxStride)
    FormsFill(0, 0, w, h, FORMS_C_FACE)
    c = f->FirstCtl()
    While c <> 0
        FormsPaintCtl(f, c)
        c = c->NextControl
    Wend
    FormsClipAll()
    XPutImage(g_formsDpy, f->Handle As VoidPtr, XDefaultGC(g_formsDpy, g_formsScr), f->LxImg, 0, 0, 0, 0, w, h)
    XFlush(g_formsDpy)
End Sub

' 部品の値が変わった（p は載っている Form。まだ載っていなければ 0）
Sub FormsCtlChanged(p As VoidPtr)
    FormsPaint(p)
End Sub

Sub FormsPaintCtl(f As *Form, c As *Control)
    Dim l As Long, t As Long, r As Long, b As Long, k As Long
    Dim tc As DWord
    l = c->Left
    t = c->Top
    r = l + c->Width
    b = t + c->Height
    tc = FORMS_C_TEXT
    If c->Enabled = False Then tc = FORMS_C_GRAY
    k = c->LxKind()
    FormsClipAll()
    FormsClip(l, t, r, b)
    If k = FORMS_K_BUTTON Then FormsPaintButton(f, c, l, t, r, b, tc)
    If k = FORMS_K_CHECK Or k = FORMS_K_RADIO Then FormsPaintMark(f, c, l, t, r, b, tc, k)
    If k = FORMS_K_EDIT Then FormsPaintEdit(f, c, l, t, r, b, tc)
    If k = FORMS_K_LABEL Then FormsText(c->Caption, l, t, tc)
    If k = FORMS_K_PANEL Then
        ' WS_EX_STATICEDGE: 1 画素のへこんだ縁、見出しは真ん中
        FormsFill(l, t, r, b, FORMS_C_FACE)
        FormsBevel(l, t, r, b, FORMS_C_SHADOW, FORMS_C_WHITE)
        FormsTextMid(c->Caption, l, t, r, b, tc, 0)
    End If
    If k = FORMS_K_GROUP Then FormsPaintGroup(c, l, t, r, b, tc)
    FormsClipAll()
End Sub

' 四角の真ん中に 1 行（d だけ右下へずらす）
Sub FormsTextMid(s As String, l As Long, t As Long, r As Long, b As Long, c As DWord, d As Long)
    FormsText(s, l + (r - l - FormsTextW(s)) \ 2 + d, t + (b - t - FormsFontH()) \ 2 + d, c)
End Sub

' 点線の枠（キーを受けている部品の印）
Sub FormsFocusRect(l As Long, t As Long, r As Long, b As Long)
    Dim i As Long
    i = l
    While i < r
        FormsFill(i, t, i + 1, t + 1, FORMS_C_TEXT)
        FormsFill(i, b - 1, i + 1, b, FORMS_C_TEXT)
        i = i + 2
    Wend
    i = t
    While i < b
        FormsFill(l, i, l + 1, i + 1, FORMS_C_TEXT)
        FormsFill(r - 1, i, r, i + 1, FORMS_C_TEXT)
        i = i + 2
    Wend
End Sub

' 押している間はへこむ
Sub FormsPaintButton(f As *Form, c As *Control, l As Long, t As Long, r As Long, b As Long, tc As DWord)
    Dim dn As Long
    dn = 0
    If f->LxPress = c And f->LxPressIn <> 0 Then dn = 1
    FormsFill(l, t, r, b, FORMS_C_FACE)
    If dn <> 0 Then
        FormsBevel(l, t, r, b, FORMS_C_DKSHADOW, FORMS_C_WHITE)
        FormsBevel(l + 1, t + 1, r - 1, b - 1, FORMS_C_SHADOW, FORMS_C_LIGHT)
    Else
        FormsRaised(l, t, r, b)
    End If
    FormsClip(l + 2, t + 2, r - 2, b - 2)
    FormsTextMid(c->Caption, l, t, r, b, tc, dn)
    If f->LxFocus = c Then FormsFocusRect(l + 3, t + 3, r - 3, b - 3)
End Sub

' 直径 13 の丸の、上から i 行目（0 から 12）の半分の幅
Function FormsRoundW(i As Long) As Long
    FormsRoundW = 6
    If i = 0 Or i = 12 Then FormsRoundW = 2
    If i = 1 Or i = 11 Then FormsRoundW = 4
    If i = 2 Or i = 10 Then FormsRoundW = 5
End Function

' チェックボックス（四角）とラジオボタン（丸）。左に 13 x 13 の印（上下は真ん中）、右に左寄せの 1 行
Sub FormsPaintMark(f As *Form, c As *Control, l As Long, t As Long, r As Long, b As Long, tc As DWord, k As Long)
    Dim y As Long, i As Long, d As Long, ty As Long, fh As Long
    Dim back As DWord
    y = t + (b - t - 13) \ 2
    back = FORMS_C_WHITE
    If c->Enabled = False Then back = FORMS_C_FACE
    If f->LxPress = c And f->LxPressIn <> 0 Then back = FORMS_C_FACE
    If k = FORMS_K_CHECK Then
        FormsFill(l, y, l + 13, y + 13, back)
        FormsSunken(l, y, l + 13, y + 13)
        If c->Checked <> False Then
            For i = 0 To 2
                FormsFill(l + 3 + i, y + 5 + i, l + 4 + i, y + 8 + i, tc)
            Next
            For i = 0 To 3
                FormsFill(l + 6 + i, y + 7 - i, l + 7 + i, y + 10 - i, tc)
            Next
        End If
    Else
        For i = 0 To 12
            d = FormsRoundW(i)
            FormsFill(l + 6 - d, y + i, l + 7 + d, y + i + 1, FORMS_C_SHADOW)
            If i > 0 And i < 12 Then FormsFill(l + 7 - d, y + i, l + 6 + d, y + i + 1, back)
        Next
        If c->Checked <> False Then
            FormsFill(l + 4, y + 5, l + 9, y + 8, tc)
            FormsFill(l + 5, y + 4, l + 8, y + 9, tc)
        End If
    End If
    fh = FormsFontH()
    ty = t + (b - t - fh) \ 2
    FormsText(c->Caption, l + 17, ty, tc)
    If f->LxFocus = c Then FormsFocusRect(l + 15, ty - 1, l + 19 + FormsTextW(c->Caption), ty + fh + 1)
End Sub

' 白地にへこんだ縁、左寄せの 1 行。キーを受けていればキャレット。長い文字は横に流す
Sub FormsPaintEdit(f As *Form, c As *Control, l As Long, t As Long, r As Long, b As Long, tc As DWord)
    Dim x0 As Long, cx As Long, iw As Long, y As Long, fh As Long
    If c->Enabled = False Then
        FormsFill(l, t, r, b, FORMS_C_FACE)
    Else
        FormsFill(l, t, r, b, FORMS_C_WHITE)
    End If
    FormsSunken(l, t, r, b)
    FormsClip(l + 2, t + 2, r - 2, b - 2)
    fh = FormsFontH()
    y = t + (b - t - fh) \ 2
    If c->LxCaret > Len(c->Caption) Then c->LxCaret = Len(c->Caption)
    cx = FormsTextW(Left$(c->Caption, c->LxCaret))
    iw = r - l - 8
    If iw < 1 Then iw = 1
    If cx - c->LxScroll > iw Then c->LxScroll = cx - iw
    If cx < c->LxScroll Then c->LxScroll = cx
    x0 = l + 4 - c->LxScroll
    FormsText(c->Caption, x0, y, tc)
    If f->LxFocus = c Then FormsFill(x0 + cx, y, x0 + cx + 1, y + fh, FORMS_C_TEXT)
End Sub

' 彫った線の枠（上辺は見出しの高さの真ん中）と、左上の見出し（下の線を消して）。中は塗らない
Sub FormsPaintGroup(c As *Control, l As Long, t As Long, r As Long, b As Long, tc As DWord)
    Dim fh As Long, tw As Long
    fh = FormsFontH()
    FormsEtched(l, t + fh \ 2, r, b)
    If c->Caption = "" Then Exit Sub
    tw = FormsTextW(c->Caption)
    FormsFill(l + 6, t, l + 10 + tw, t + fh, FORMS_C_FACE)
    FormsText(c->Caption, l + 8, t, tc)
End Sub

' ==== X11 版の部品：マウスとキー ====
' 部品の上の左ボタンと、キーを受ける部品があるときのキーは部品へ行き、Form の WndProc には届かない
' （Windows の子窓と同じ）。押せるのは Button / CheckBox / RadioButton / EditBox で Enabled のもの。

Function FormsCtlLive(c As *Control) As Long
    Dim k As Long
    FormsCtlLive = 0
    If c = 0 Then Exit Function
    If c->Enabled = False Then Exit Function
    k = c->LxKind()
    If k >= FORMS_K_BUTTON And k <= FORMS_K_EDIT Then FormsCtlLive = 1
End Function

Function FormsIn(c As *Control, x As Long, y As Long) As Long
    FormsIn = 0
    If x >= c->Left And x < c->Left + c->Width And y >= c->Top And y < c->Top + c->Height Then FormsIn = 1
End Function

' (x, y) の押せる部品（重なっていれば後に載せたもの）。無ければ 0
Function FormsHit(f As *Form, x As Long, y As Long) As *Control
    Dim c As *Control
    FormsHit = 0
    c = f->FirstCtl()
    While c <> 0
        If FormsCtlLive(c) <> 0 And FormsIn(c, x, y) <> 0 Then FormsHit = c
        c = c->NextControl
    Wend
End Function

' 親の WndProc へ WM_COMMAND（HIWORD(wParam) = code、lParam = 部品の Handle）
Sub FormsNotify(f As *Form, c As *Control, code As Long)
    f->WndProc(WM_COMMAND, ((code And &HFFFF) * &H10000) As WPARAM, c->Handle As LPARAM)
End Sub

' 左ボタンを押した。押せる部品の上なら、キーを受ける部品にして 1
Function FormsCtlDown(f As *Form, x As Long, y As Long) As Long
    Dim c As *Control
    FormsCtlDown = 0
    c = FormsHit(f, x, y)
    If c = 0 Then Exit Function
    FormsCtlDown = 1
    f->LxFocus = c
    f->LxPress = c
    f->LxPressIn = 1
    If c->LxKind() = FORMS_K_EDIT Then c->LxCaret = FormsEditPos(c, x)
    FormsPaint(f As VoidPtr)
End Function

' 押している間のマウス。部品の上から出入りしたら描き直す
Function FormsCtlMove(f As *Form, x As Long, y As Long) As Long
    Dim c As *Control, inside As Long
    FormsCtlMove = 0
    c = f->LxPress
    If c = 0 Then Exit Function
    FormsCtlMove = 1
    inside = FormsIn(c, x, y)
    If inside = f->LxPressIn Then Exit Function
    f->LxPressIn = inside
    FormsPaint(f As VoidPtr)
End Function

' 左ボタンを離した。部品の上で離したら押したことにする
Function FormsCtlUp(f As *Form, x As Long, y As Long) As Long
    Dim c As *Control
    FormsCtlUp = 0
    c = f->LxPress
    If c = 0 Then Exit Function
    FormsCtlUp = 1
    f->LxPress = 0
    f->LxPressIn = 0
    If FormsIn(c, x, y) <> 0 Then FormsCtlClick(f, c)
    FormsPaint(f As VoidPtr)
End Function

' 部品を押した。印を変えてから親へ BN_CLICKED（EditBox は何もしない）
Sub FormsCtlClick(f As *Form, c As *Control)
    Dim k As Long
    k = c->LxKind()
    If k = FORMS_K_EDIT Then Exit Sub
    If k = FORMS_K_CHECK Then
        If c->Checked <> False Then
            c->Checked = False
        Else
            c->Checked = True
        End If
    End If
    If k = FORMS_K_RADIO Then
        FormsRadioClear(f As VoidPtr, c As VoidPtr)
        c->Checked = True
    End If
    FormsNotify(f, c, BN_CLICKED)
End Sub

' 同じフォームの、keep のほかのラジオボタンの印を外す（フォームのラジオボタンはすべて 1 つの組）
Sub FormsRadioClear(fp As VoidPtr, keep As VoidPtr)
    Dim f As *Form, c As *Control
    If fp = 0 Then Exit Sub
    f = fp As *Form
    c = f->FirstCtl()
    While c <> 0
        If (c As VoidPtr) <> keep And c->LxKind() = FORMS_K_RADIO Then c->Checked = False
        c = c->NextControl
    Wend
End Sub

' EditBox の文字が変わった（p は部品）。窓があれば親へ EN_CHANGE
Sub FormsEditChanged(p As VoidPtr)
    Dim c As *Control, f As *Form
    c = p As *Control
    If c->Owner = 0 Then Exit Sub
    f = c->Owner As *Form
    If f->Handle = 0 Then Exit Sub
    FormsNotify(f, c, EN_CHANGE)
End Sub

' 前の文字の先頭のバイト位置
Function FormsPrevPos(s As String, i As Long) As Long
    Dim p As *Byte, j As Long
    FormsPrevPos = 0
    If i <= 0 Then Exit Function
    p = StrPtr(s)
    j = i - 1
    While j > 0 And (p[j] And &HC0) = &H80
        j = j - 1
    Wend
    FormsPrevPos = j
End Function

' 次の文字の先頭のバイト位置
Function FormsNextPos(s As String, i As Long) As Long
    Dim cp As Long, n As Long
    n = Len(s)
    FormsNextPos = n
    If i >= n Then Exit Function
    FormsNextPos = i + FormsNextCp(StrPtr(s), i, n, cp)
End Function

' s の i バイト目から後ろ
Function FormsTail$(s As String, i As Long) As String
    FormsTail$ = ""
    If i < Len(s) Then FormsTail$ = Mid$(s, i + 1, Len(s) - i)
End Function

' 押した x に近い、文字の間のバイト位置
Function FormsEditPos(c As *Control, x As Long) As Long
    Dim s As String, p As *Byte
    Dim n As Long, i As Long, k As Long, cp As Long, w As Long, gw As Long, rel As Long
    FormsFontInit()
    s = c->Caption
    n = Len(s)
    FormsEditPos = n
    If n = 0 Then Exit Function
    rel = x - (c->Left + 4 - c->LxScroll)
    p = StrPtr(s)
    i = 0
    w = 0
    While i < n
        k = FormsNextCp(p, i, n, cp)
        gw = FormsGlyph(cp, 0, 0, 0, 0)
        If rel < w + gw \ 2 Then
            FormsEditPos = i
            Exit Function
        End If
        w = w + gw
        i = i + k
    Wend
End Function

' キーを受ける部品へ。扱ったら 1（Form の WndProc へは送らない）。n は XLookupString の文字数
Function FormsCtlKey(f As *Form, ks As Long, n As Long, st As Long) As Long
    Dim c As *Control
    FormsCtlKey = 0
    c = f->LxFocus
    If FormsCtlLive(c) = 0 Then Exit Function
    If c->LxKind() = FORMS_K_EDIT Then
        FormsCtlKey = FormsEditKey(f, c, ks, n)
        Exit Function
    End If
    ' 押せる部品は空白キーで押す
    If ks <> &H20 Then Exit Function
    FormsCtlKey = 1
    FormsCtlClick(f, c)
    FormsPaint(f As VoidPtr)
End Function

' EditBox のキー（← → Home End BackSpace Delete と、英数字・記号の 1 文字）。ほかは 0
Function FormsEditKey(f As *Form, c As *Control, ks As Long, n As Long) As Long
    Dim s As String
    Dim i As Long, j As Long, ch As Long, changed As Long
    s = c->Caption
    i = c->LxCaret
    If i > Len(s) Then i = Len(s)
    FormsEditKey = 1
    changed = 0
    If ks = &HFF51 Or ks = &HFF96 Then
        i = FormsPrevPos(s, i)
    ElseIf ks = &HFF53 Or ks = &HFF98 Then
        i = FormsNextPos(s, i)
    ElseIf ks = &HFF50 Or ks = &HFF95 Then
        i = 0
    ElseIf ks = &HFF57 Or ks = &HFF9C Then
        i = Len(s)
    ElseIf ks = &HFF08 Then
        If i > 0 Then
            j = FormsPrevPos(s, i)
            s = Left$(s, j) + FormsTail$(s, i)
            i = j
            changed = 1
        End If
    ElseIf ks = &HFFFF Or ks = &HFF9F Then
        If i < Len(s) Then
            j = FormsNextPos(s, i)
            s = Left$(s, i) + FormsTail$(s, j)
            changed = 1
        End If
    Else
        FormsEditKey = 0
        If n < 1 Then Exit Function
        ch = g_formsKey(0)
        If ch < 32 Or ch > 126 Then Exit Function
        s = Left$(s, i) + Chr$(ch) + FormsTail$(s, i)
        i = i + 1
        changed = 1
        FormsEditKey = 1
    End If
    c->Caption = s
    c->LxCaret = i
    FormsPaint(f As VoidPtr)
    If changed <> 0 Then FormsNotify(f, c, EN_CHANGE)
End Function

' 窓の見出しを読む（X サーバーにあるもの）。テスト用
Function FormsGetTitle(h As HWND, buf As *Byte, n As Long) As Long
    Dim s As VoidPtr, src As *Byte, i As Long
    FormsGetTitle = 0
    buf[0] = 0
    s = 0
    If XFetchName(g_formsDpy, h As VoidPtr, VarPtr(s)) = 0 Then Exit Function
    If s = 0 Then Exit Function
    src = s
    i = 0
    While i < n - 1 And src[i] <> 0
        buf[i] = src[i]
        i = i + 1
    Wend
    buf[i] = 0
    XFree(s)
    FormsGetTitle = 1
End Function

#else

Dim g_formsWc As WNDCLASSEX
Dim g_formsClass(31) As Byte
Dim g_formsReg As Long
Dim g_formsNew As VoidPtr           ' CreateWindowEx のあいだだけ、窓を作っている Form

Class Form
Private
    firstControl As *Control        ' AddControl で載せた部品（NextControl でつなぐ）
    lastControl As *Control
    componentsDone As Long          ' InitializeComponent を呼んだか
Public
    Left As Long
    Top As Long
    Width As Long
    Height As Long
    Caption As String
    Handle As HWND

    Sub Form()
        Left = CW_USEDEFAULT
        Top = CW_USEDEFAULT
        Width = CW_USEDEFAULT
        Height = CW_USEDEFAULT
    End Sub

    ' フォームデザイナが Override して、位置・大きさ・見出し・部品を入れる。最初の Show で 1 度だけ呼ばれる
    Virtual Sub InitializeComponent()
    End Sub

    ' まだなら InitializeComponent を呼ぶ（Show が呼ぶ。窓を出す前に値を読みたいときにも使える）
    Sub InitComponents()
        If componentsDone <> 0 Then Exit Sub
        componentsDone = 1
        InitializeComponent()
    End Sub

    ' 部品を載せる。窓がもうあれば、すぐ子窓を作る
    Sub AddControl(ByRef c As Control)
        Dim p As *Control, q As *Control
        p = VarPtr(c)
        p->NextControl = 0
        If lastControl = 0 Then
            firstControl = p
        Else
            q = lastControl
            q->NextControl = p
        End If
        lastControl = p
        If Handle <> 0 Then c.CreateHandle(Handle)
    End Sub

    ' 載せた部品の子窓を作る（WM_CREATE の前に Forms.sbp が呼ぶ）
    Sub CreateControls()
        Dim c As *Control
        c = firstControl
        While c <> 0
            c->CreateHandle(Handle)
            c = c->NextControl
        Wend
    End Sub

    ' 窓のメッセージ。既定は、窓が壊れたらメッセージループを終わらせる
    Virtual Function WndProc(msg As DWord, wParam As WPARAM, lParam As LPARAM) As LRESULT
        If msg = WM_DESTROY Then PostQuitMessage(0)
        WndProc = DefWindowProc(Handle, msg, wParam, lParam)
    End Function

    ' 窓がまだ無ければ作って、表示する
    Sub Show()
        InitComponents()
        If Handle = 0 Then CreateHandle()
        ShowWindow(Handle, SW_SHOW)
        UpdateWindow(Handle)
    End Sub

    ' 窓を閉じる（WM_CLOSE を送る。既定の WndProc が窓を壊す）
    Sub Close()
        If Handle <> 0 Then PostMessage(Handle, WM_CLOSE, 0, 0)
    End Sub

    ' 見出しを変える。窓がもうあれば窓の見出しも変える。
    ' 先に InitializeComponent を済ませる（あとで呼ばれて Caption を上書きしないように）
    Sub SetCaption(s As String)
        InitComponents()
        Caption = s
        If Handle <> 0 Then SetWindowText(Handle, StrPtr(Caption))
    End Sub

Private
    Sub CreateHandle()
        FormsRegister()
        g_formsNew = This
        CreateWindowEx(0, VarPtr(g_formsClass), StrPtr(Caption), WS_OVERLAPPEDWINDOW, Left, Top, Width, Height, 0, 0, GetModuleHandle(0), 0)
        g_formsNew = 0
    End Sub
End Class

' 窓に結びつけた Form。最初のメッセージ（CreateWindowEx の中）で、作っている Form を結びつける
Function FormsOf(hWnd As HWND) As *Form
    Dim f As *Form
    f = GetWindowLong(hWnd, GWL_USERDATA) As *Form
    If f = 0 And g_formsNew <> 0 Then
        f = g_formsNew As *Form
        f->Handle = hWnd
        SetWindowLongPtr(hWnd, GWL_USERDATA, f As LONG_PTR)
    End If
    FormsOf = f
End Function

' すべての Form の窓の WndProc。結びつけた Form の WndProc（Virtual）を呼ぶ
Function FormsWndProc(hWnd As HWND, msg As DWord, wParam As WPARAM, lParam As LPARAM) As LRESULT
    Dim f As *Form
    f = FormsOf(hWnd)
    If f = 0 Then
        FormsWndProc = DefWindowProc(hWnd, msg, wParam, lParam)
        Exit Function
    End If
    If msg = WM_CREATE Then f->CreateControls()
    FormsWndProc = f->WndProc(msg, wParam, lParam)
End Function

' Form の窓クラスを 1 度だけ登録する
Sub FormsRegister()
    If g_formsReg <> 0 Then Exit Sub
    lstrcpy(VarPtr(g_formsClass), "ActBa64Form")
    FormsFillClass()
    g_formsReg = RegisterClassEx(g_formsWc)
End Sub

Sub FormsFillClass()
    g_formsWc.cbSize = SizeOf(WNDCLASSEX)
    g_formsWc.lpfnWndProc = AddressOf(FormsWndProc)
    g_formsWc.hInstance = GetModuleHandle(0)
    g_formsWc.hCursor = LoadCursor(0, IDC_ARROW)
    g_formsWc.hbrBackground = COLOR_BTNFACE + 1
    g_formsWc.lpszClassName = VarPtr(g_formsClass)
End Sub

#endif
