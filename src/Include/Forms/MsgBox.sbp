' Forms/MsgBox.sbp - -linux の MsgBox / MessageBox の窓（ボタンと本文を決めて窓を出し、閉じるまで待つ）。
' Forms.sbp が #include する（単独では include しない）。
' Include/linux の Lx_MessageBoxA は g_lxMsgBox があればそちらを呼ぶ（無ければ標準エラーへ 1 行）。
' Forms.sbp を使うプログラムでは、ここで g_lxMsgBox に FormsMsgBox を入れるので、窓が出る。
' 窓は閉じるまでほかの Form の入力を止める（Form の描き直しだけは続ける）。X につながらなければ 0 を返し、
' 標準エラーへ書く方になる。ボタンの文字は英語（OK / Cancel / Abort / Retry / Ignore / Yes / No）。
' 押した印: Enter は今のボタン、Esc と閉じるボタンは Cancel（MB_OK は OK）。Tab・←→ でボタンを移る。
' 描くのと XEvent は Forms/MsgBoxEvent.sbp。

#ifdef _LINUX

Declare Function XSetTransientForHint Lib "libX11.so.6" (d As VoidPtr, w As VoidPtr, parent As VoidPtr) As Long
Declare Function XDisplayWidth Lib "libX11.so.6" (d As VoidPtr, scr As Long) As Long
Declare Function XDisplayHeight Lib "libX11.so.6" (d As VoidPtr, scr As Long) As Long

Const FORMS_MB_PAD = 12             ' 縁から文字まで
Const FORMS_MB_BTN_W = 75
Const FORMS_MB_BTN_H = 23
Const FORMS_MB_GAP = 8              ' ボタンの間

' 窓 1 つ分（MsgBox は入れ子にしない）
Dim g_mbEv(191) As Byte             ' XNextEvent で受ける XEvent（FormsDispatch の g_formsEv とは別）
Dim g_mbKey(15) As Byte
Dim g_mbSym(7) As Byte
Dim g_mbHint(79) As Byte
Dim g_mbWin As VoidPtr
Dim g_mbBuf As VoidPtr
Dim g_mbImg As VoidPtr
Dim g_mbStride As Long
Dim g_mbW As Long, g_mbH As Long
Dim g_mbText As String
Dim g_mbN As Long                   ' ボタンの数
Dim g_mbId(2) As Long               ' ボタンの戻り値（IDOK ほか）
Dim g_mbFocus As Long               ' 今のボタン（0 から）
Dim g_mbPress As Long               ' 押しているボタン（-1 は無い）
Dim g_mbPressIn As Long
Dim g_mbCancel As Long              ' Esc・閉じるボタンの戻り値（0 は効かない）

' Lx_MessageBoxA から呼ばれる
g_lxMsgBox = AddressOf(FormsMsgBox)

' MessageBox の窓。戻り値は IDOK ほか。X につながらなければ 0（標準エラーへ書く方になる）
Function FormsMsgBox(hWnd As VoidPtr, text As *Byte, caption As *Byte, typ As DWord) As Long
    FormsMsgBox = 0
    If g_mbWin <> 0 Then Exit Function         ' 入れ子は標準エラーへ
    If FormsTryOpen() = 0 Then Exit Function
    g_mbText = FormsMakeStr$(text)
    FormsMbButtons(typ)
    FormsMbCreate(FormsMbParent(hWnd), FormsMakeStr$(caption))
    FormsMsgBox = FormsMbLoop()
End Function

' 0 で終わる文字列（p = 0 なら ""）
Function FormsMakeStr$(p As *Byte) As String
    FormsMakeStr$ = ""
    If p <> 0 Then FormsMakeStr$ = MakeStr(p)
End Function

' hWnd が Form の窓なら、その上に出す
Function FormsMbParent(hWnd As VoidPtr) As VoidPtr
    FormsMbParent = 0
    If FormsFind(hWnd) <> 0 Then FormsMbParent = hWnd
End Function

' 決まるまで XEvent を回してから窓を壊す。戻り値は決まった値
Function FormsMbLoop() As Long
    Dim r As Long
    r = 0
    While r = 0
        XNextEvent(g_formsDpy, VarPtr(g_mbEv(0)))
        r = FormsMbEvent()
    Wend
    FormsMbClose()
    FormsMbLoop = r
End Function

Sub FormsMbClose()
    XDestroyWindow(g_formsDpy, g_mbWin)
    XFlush(g_formsDpy)
    g_mbWin = 0
    FormsFreeImage(g_mbImg)
    g_mbImg = 0
    If g_mbBuf <> 0 Then free(g_mbBuf)
    g_mbBuf = 0
End Sub

' ==== ボタン ====

Function FormsMbLabel$(id As Long) As String
    FormsMbLabel$ = "OK"
    If id = 2 Then FormsMbLabel$ = "Cancel"
    If id = 3 Then FormsMbLabel$ = "Abort"
    If id = 4 Then FormsMbLabel$ = "Retry"
    If id = 5 Then FormsMbLabel$ = "Ignore"
    If id = 6 Then FormsMbLabel$ = "Yes"
    If id = 7 Then FormsMbLabel$ = "No"
End Function

' MB_OK など（typ の下 4 ビット）からボタンを決め、どれも押していない状態にする。
' 最初のボタンが既定（MB_DEFBUTTON2 / 3 で変わる）
Sub FormsMbButtons(typ As DWord)
    Dim d As Long
    FormsMbSet((typ And &HF) As Long)
    d = ((typ >> 8) And &HF) As Long          ' MB_DEFBUTTON2 = &H100、3 = &H200
    g_mbFocus = 0
    If d >= 1 And d < g_mbN Then g_mbFocus = d
    g_mbPress = -1
    g_mbPressIn = 0
End Sub

' ボタンの組（MB_OKCANCEL = 1 ほか。0 と 6 以上は MB_OK）
Sub FormsMbSet(k As Long)
    If k = 1 Then FormsMbAdd3(1, 2, 0, 2)
    If k = 2 Then FormsMbAdd3(3, 4, 5, 0)
    If k = 3 Then FormsMbAdd3(6, 7, 2, 2)
    If k = 4 Then FormsMbAdd3(6, 7, 0, 0)
    If k = 5 Then FormsMbAdd3(4, 2, 0, 2)
    If k < 1 Or k > 5 Then FormsMbAdd3(1, 0, 0, 1)
End Sub

' ボタンの戻り値を 3 つまで（0 は無し）と、Esc・閉じるボタンの戻り値
Sub FormsMbAdd3(a As Long, b As Long, c As Long, cancel As Long)
    g_mbN = 0
    FormsMbAdd(a)
    If b <> 0 Then FormsMbAdd(b)
    If c <> 0 Then FormsMbAdd(c)
    g_mbCancel = cancel
End Sub

Sub FormsMbAdd(id As Long)
    g_mbId(g_mbN) = id
    g_mbN = g_mbN + 1
End Sub

' ==== 本文 ====

' 本文の i 行目（0 から。行の終わりの CR は捨てる）。無ければ "" で、more = 0
Function FormsMbLine$(i As Long, ByRef more As Long) As String
    Dim st As Long
    FormsMbLine$ = ""
    more = 0
    st = FormsMbLineStart(i)
    If st < 0 Then Exit Function
    more = 1
    FormsMbLine$ = FormsMbCut$(st, FormsMbLineEnd(st))
End Function

' i 行目の先頭のバイト位置。無ければ -1
Function FormsMbLineStart(i As Long) As Long
    Dim st As Long, row As Long
    st = 0
    For row = 1 To i
        If st >= 0 Then st = FormsMbNextLine(st)
    Next
    FormsMbLineStart = st
End Function

' st から始まる行の、次の行の先頭。無ければ -1
Function FormsMbNextLine(st As Long) As Long
    Dim e As Long
    e = FormsMbLineEnd(st)
    FormsMbNextLine = -1
    If e < Len(g_mbText) Then FormsMbNextLine = e + 1
End Function

' st から始まる行の終わり（LF の位置か、本文の長さ）
Function FormsMbLineEnd(st As Long) As Long
    Dim p As *Byte, k As Long
    p = StrPtr(g_mbText)
    k = st
    While k < Len(g_mbText)
        If p[k] = &H0A Then Exit While
        k = k + 1
    Wend
    FormsMbLineEnd = k
End Function

' 本文の st から en の前まで（終わりの CR は捨てる）
Function FormsMbCut$(st As Long, en As Long) As String
    Dim s As String
    s = ""
    If en > st Then s = Mid$(g_mbText, st + 1, en - st)
    If Len(s) > 0 Then
        If Mid$(s, Len(s), 1) = Chr$(13) Then s = Left$(s, Len(s) - 1)
    End If
    FormsMbCut$ = s
End Function

' 本文の行の数（LF の数 + 1）
Function FormsMbRows() As Long
    Dim st As Long, n As Long
    st = 0
    n = 0
    While st >= 0
        n = n + 1
        st = FormsMbNextLine(st)
    Wend
    FormsMbRows = n
End Function

' 本文の幅と行の数
Sub FormsMbMeasure(ByRef w As Long, ByRef rows As Long)
    Dim i As Long, more As Long
    rows = FormsMbRows()
    w = 0
    For i = 0 To rows - 1
        w = FormsMax(w, FormsTextW(FormsMbLine$(i, more)))
    Next
End Sub

' ==== 窓 ====

' 窓を作って出す（画面の真ん中。parent があればその上）
Sub FormsMbCreate(parent As VoidPtr, cap As String)
    Dim x As Long, y As Long
    FormsMbSize()
    x = FormsMax((XDisplayWidth(g_formsDpy, g_formsScr) - g_mbW) \ 2, 0)
    y = FormsMax((XDisplayHeight(g_formsDpy, g_formsScr) - g_mbH) \ 2, 0)
    FormsMbWindow(parent, cap, x, y)
    FormsMbHints(x, y)
    FormsMbShow()
End Sub

' 本文とボタンの数から窓の大きさ（g_mbW / g_mbH）を決める
Sub FormsMbSize()
    Dim tw As Long, rows As Long, bw As Long
    FormsMbMeasure(tw, rows)
    If rows < 1 Then rows = 1
    bw = g_mbN * FORMS_MB_BTN_W + (g_mbN - 1) * FORMS_MB_GAP
    g_mbW = FormsMax(FormsMax(tw + FORMS_MB_PAD * 2 + 8, bw + FORMS_MB_PAD * 2), 180)
    g_mbH = FORMS_MB_PAD + 4 + rows * FormsFontH() + FORMS_MB_PAD + 4 + FORMS_MB_PAD * 2 + FORMS_MB_BTN_H
End Sub

Sub FormsMbWindow(parent As VoidPtr, cap As String, x As Long, y As Long)
    g_mbWin = XCreateSimpleWindow(g_formsDpy, XRootWindow(g_formsDpy, g_formsScr), x, y, g_mbW, g_mbH, 0, 0, &HF0F0F0)
    If parent <> 0 Then XSetTransientForHint(g_formsDpy, g_mbWin, parent)
    FormsTitle(g_mbWin, cap)
End Sub

' 位置と大きさ（大きさは変えられない）: USPosition | USSize | PMinSize | PMaxSize。閉じるボタンとイベントも
Sub FormsMbHints(x As Long, y As Long)
    Dim h As VoidPtr
    h = VarPtr(g_mbHint(0))
    FormsSizeHints(h, 3 Or 16 Or 32, x, y, g_mbW, g_mbH)
    FormsMinMax(h, g_mbW, g_mbH)
    XSetWMNormalHints(g_formsDpy, g_mbWin, h)
    FormsWmInput(g_mbWin)
End Sub

' XSizeHints の min / max の大きさを cx x cy に
Sub FormsMinMax(h As VoidPtr, cx As Long, cy As Long)
    FormsSetL(h, 24, cx)
    FormsSetL(h, 28, cy)
    FormsSetL(h, 32, cx)
    FormsSetL(h, 36, cy)
End Sub

' 画素バッファと XImage を作って、窓を出す
Sub FormsMbShow()
    g_mbBuf = malloc(g_mbW * g_mbH * 4)
    g_mbStride = g_mbW * 4
    g_mbImg = FormsNewImage(g_mbBuf, g_mbW, g_mbH)
    If g_mbImg <> 0 Then g_mbStride = FormsL(g_mbImg, 44)
    XMapWindow(g_formsDpy, g_mbWin)
    XFlush(g_formsDpy)
End Sub

#endif
