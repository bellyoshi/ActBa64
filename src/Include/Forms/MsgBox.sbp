' Forms/MsgBox.sbp - -linux の MsgBox / MessageBox の窓。
' Forms.sbp が #include する（単独では include しない）。
' Include/linux の Lx_MessageBoxA は g_lxMsgBox があればそちらを呼ぶ（無ければ標準エラーへ 1 行）。
' Forms.sbp を使うプログラムでは、ここで g_lxMsgBox に FormsMsgBox を入れるので、窓が出る。
' 窓は閉じるまでほかの Form の入力を止める（Form の描き直しだけは続ける）。X につながらなければ 0 を返し、
' 標準エラーへ書く方になる。ボタンの文字は英語（OK / Cancel / Abort / Retry / Ignore / Yes / No）。
' 押した印: Enter は今のボタン、Esc と閉じるボタンは Cancel（MB_OK は OK）。Tab・←→ でボタンを移る。

#ifdef _LINUX

Declare Function XSetTransientForHint Lib "libX11.so.6" (d As VoidPtr, w As VoidPtr, parent As VoidPtr) As Long
Declare Function XDisplayWidth Lib "libX11.so.6" (d As VoidPtr, scr As Long) As Long
Declare Function XDisplayHeight Lib "libX11.so.6" (d As VoidPtr, scr As Long) As Long

Const FORMS_MB_PAD = 12             ' 縁から文字まで
Const FORMS_MB_BTN_W = 75
Const FORMS_MB_BTN_H = 23
Const FORMS_MB_GAP = 8              ' ボタンの間

' 窓 1 つ分（MsgBox は入れ子にしない）
Dim g_mbEv(191) As Byte             ' XNextEvent で受ける XEvent（FormsDispatch の g_formsEv とは別）
Dim g_mbKey(15) As Byte
Dim g_mbSym(7) As Byte
Dim g_mbHint(79) As Byte
Dim g_mbWin As VoidPtr
Dim g_mbBuf As VoidPtr
Dim g_mbImg As VoidPtr
Dim g_mbStride As Long
Dim g_mbW As Long, g_mbH As Long
Dim g_mbText As String
Dim g_mbN As Long                   ' ボタンの数
Dim g_mbId(2) As Long               ' ボタンの戻り値（IDOK ほか）
Dim g_mbFocus As Long               ' 今のボタン（0 から）
Dim g_mbPress As Long               ' 押しているボタン（-1 は無い）
Dim g_mbPressIn As Long
Dim g_mbCancel As Long              ' Esc・閉じるボタンの戻り値（0 は効かない）

' Lx_MessageBoxA から呼ばれる
g_lxMsgBox = AddressOf(FormsMsgBox)

Function FormsMbLabel$(id As Long) As String
    FormsMbLabel$ = "OK"
    If id = 2 Then FormsMbLabel$ = "Cancel"
    If id = 3 Then FormsMbLabel$ = "Abort"
    If id = 4 Then FormsMbLabel$ = "Retry"
    If id = 5 Then FormsMbLabel$ = "Ignore"
    If id = 6 Then FormsMbLabel$ = "Yes"
    If id = 7 Then FormsMbLabel$ = "No"
End Function

Sub FormsMbAdd(id As Long)
    g_mbId(g_mbN) = id
    g_mbN = g_mbN + 1
End Sub

' MB_OK など（typ の下 4 ビット）からボタンを決める。最初のボタンが既定（MB_DEFBUTTON2 / 3 で変わる）
Sub FormsMbButtons(typ As DWord)
    Dim k As Long, d As Long
    k = (typ And &HF) As Long
    g_mbN = 0
    g_mbCancel = 0
    If k = 1 Then
        FormsMbAdd(1)
        FormsMbAdd(2)
        g_mbCancel = 2
    ElseIf k = 2 Then
        FormsMbAdd(3)
        FormsMbAdd(4)
        FormsMbAdd(5)
    ElseIf k = 3 Then
        FormsMbAdd(6)
        FormsMbAdd(7)
        FormsMbAdd(2)
        g_mbCancel = 2
    ElseIf k = 4 Then
        FormsMbAdd(6)
        FormsMbAdd(7)
    ElseIf k = 5 Then
        FormsMbAdd(4)
        FormsMbAdd(2)
        g_mbCancel = 2
    Else
        FormsMbAdd(1)
        g_mbCancel = 1
    End If
    d = ((typ >> 8) And &HF) As Long          ' MB_DEFBUTTON2 = &H100、3 = &H200
    g_mbFocus = 0
    If d >= 1 And d < g_mbN Then g_mbFocus = d
End Sub

' 本文の i 行目（0 から。CR は捨てる）。無ければ "" で、more = 0
Function FormsMbLine$(i As Long, ByRef more As Long) As String
    Dim p As *Byte, n As Long, k As Long, row As Long, st As Long
    Dim s As String
    FormsMbLine$ = ""
    more = 0
    n = Len(g_mbText)
    p = StrPtr(g_mbText)
    row = 0
    st = 0
    For k = 0 To n
        If k = n Or p[k] = &H0A Then
            If row = i Then
                more = 1
                s = ""
                If k > st Then s = Mid$(g_mbText, st + 1, k - st)
                If Len(s) > 0 Then
                    If p[k - 1] = &H0D Then s = Left$(s, Len(s) - 1)
                End If
                FormsMbLine$ = s
                Exit Function
            End If
            row = row + 1
            st = k + 1
        End If
    Next
End Function

' 本文の幅と行の数
Sub FormsMbMeasure(ByRef w As Long, ByRef rows As Long)
    Dim s As String, more As Long, tw As Long
    w = 0
    rows = 0
    s = FormsMbLine$(0, more)
    While more <> 0
        tw = FormsTextW(s)
        If tw > w Then w = tw
        rows = rows + 1
        s = FormsMbLine$(rows, more)
    Wend
End Sub

' ボタン i の四角（右寄せで並べる）
Sub FormsMbBtnRect(i As Long, ByRef l As Long, ByRef t As Long, ByRef r As Long, ByRef b As Long)
    l = g_mbW - FORMS_MB_PAD - (g_mbN - i) * FORMS_MB_BTN_W - (g_mbN - 1 - i) * FORMS_MB_GAP
    t = g_mbH - FORMS_MB_PAD - FORMS_MB_BTN_H + 2
    r = l + FORMS_MB_BTN_W
    b = t + FORMS_MB_BTN_H
End Sub

Function FormsMbHit(x As Long, y As Long) As Long
    Dim i As Long, l As Long, t As Long, r As Long, b As Long
    FormsMbHit = -1
    For i = 0 To g_mbN - 1
        FormsMbBtnRect(i, l, t, r, b)
        If x >= l And x < r And y >= t And y < b Then FormsMbHit = i
    Next
End Function

Sub FormsMbPaint()
    Dim i As Long, l As Long, t As Long, r As Long, b As Long, dn As Long
    Dim more As Long, fh As Long, strip As Long
    Dim s As String
    If g_mbImg = 0 Then Exit Sub
    FormsTarget(g_mbBuf, g_mbW, g_mbH, g_mbStride)
    strip = g_mbH - FORMS_MB_BTN_H - FORMS_MB_PAD * 2 + 2
    FormsFill(0, 0, g_mbW, strip, FORMS_C_WHITE)
    FormsFill(0, strip, g_mbW, g_mbH, FORMS_C_FACE)
    fh = FormsFontH()
    i = 0
    s = FormsMbLine$(0, more)
    While more <> 0
        FormsText(s, FORMS_MB_PAD + 4, FORMS_MB_PAD + 4 + i * fh, FORMS_C_TEXT)
        i = i + 1
        s = FormsMbLine$(i, more)
    Wend
    For i = 0 To g_mbN - 1
        FormsMbBtnRect(i, l, t, r, b)
        dn = 0
        If g_mbPress = i And g_mbPressIn <> 0 Then dn = 1
        FormsClipAll()
        FormsFill(l, t, r, b, FORMS_C_FACE)
        If dn <> 0 Then
            FormsBevel(l, t, r, b, FORMS_C_DKSHADOW, FORMS_C_WHITE)
            FormsBevel(l + 1, t + 1, r - 1, b - 1, FORMS_C_SHADOW, FORMS_C_LIGHT)
        Else
            FormsRaised(l, t, r, b)
        End If
        If i = g_mbFocus Then
            ' 既定のボタンは青い縁
            FormsBevel(l - 1, t - 1, r + 1, b + 1, &H0078D7, &H0078D7)
            FormsFocusRect(l + 3, t + 3, r - 3, b - 3)
        End If
        FormsClip(l + 2, t + 2, r - 2, b - 2)
        FormsTextMid(FormsMbLabel$(g_mbId(i)), l, t, r, b, FORMS_C_TEXT, dn)
    Next
    FormsClipAll()
    XPutImage(g_formsDpy, g_mbWin, XDefaultGC(g_formsDpy, g_formsScr), g_mbImg, 0, 0, 0, 0, g_mbW, g_mbH)
    XFlush(g_formsDpy)
End Sub

' 窓を作って出す
Sub FormsMbCreate(parent As VoidPtr, cap As String)
    Dim tw As Long, rows As Long, bw As Long, x As Long, y As Long
    FormsMbMeasure(tw, rows)
    If rows < 1 Then rows = 1
    bw = g_mbN * FORMS_MB_BTN_W + (g_mbN - 1) * FORMS_MB_GAP
    g_mbW = tw + FORMS_MB_PAD * 2 + 8
    If g_mbW < bw + FORMS_MB_PAD * 2 Then g_mbW = bw + FORMS_MB_PAD * 2
    If g_mbW < 180 Then g_mbW = 180
    g_mbH = FORMS_MB_PAD + 4 + rows * FormsFontH() + FORMS_MB_PAD + 4 + FORMS_MB_PAD * 2 + FORMS_MB_BTN_H
    x = (XDisplayWidth(g_formsDpy, g_formsScr) - g_mbW) \ 2
    y = (XDisplayHeight(g_formsDpy, g_formsScr) - g_mbH) \ 2
    If x < 0 Then x = 0
    If y < 0 Then y = 0
    g_mbWin = XCreateSimpleWindow(g_formsDpy, XRootWindow(g_formsDpy, g_formsScr), x, y, g_mbW, g_mbH, 0, 0, &HF0F0F0)
    If parent <> 0 Then XSetTransientForHint(g_formsDpy, g_mbWin, parent)
    FormsTitle(g_mbWin, cap)
    ' 位置と大きさ（大きさは変えられない）: USPosition | USSize | PMinSize | PMaxSize
    RtlFillMemory(VarPtr(g_mbHint(0)), 80, 0)
    FormsSetL(VarPtr(g_mbHint(0)), 0, 3 Or 16 Or 32)
    FormsSetL(VarPtr(g_mbHint(0)), 8, x)
    FormsSetL(VarPtr(g_mbHint(0)), 12, y)
    FormsSetL(VarPtr(g_mbHint(0)), 16, g_mbW)
    FormsSetL(VarPtr(g_mbHint(0)), 20, g_mbH)
    FormsSetL(VarPtr(g_mbHint(0)), 24, g_mbW)
    FormsSetL(VarPtr(g_mbHint(0)), 28, g_mbH)
    FormsSetL(VarPtr(g_mbHint(0)), 32, g_mbW)
    FormsSetL(VarPtr(g_mbHint(0)), 36, g_mbH)
    XSetWMNormalHints(g_formsDpy, g_mbWin, VarPtr(g_mbHint(0)))
    XSetWMProtocols(g_formsDpy, g_mbWin, VarPtr(g_formsAtom(0)), 1)
    XSelectInput(g_formsDpy, g_mbWin, FORMS_X_MASK)
    g_mbBuf = malloc(g_mbW * g_mbH * 4)
    g_mbImg = 0
    g_mbStride = g_mbW * 4
    If g_mbBuf <> 0 Then g_mbImg = XCreateImage(g_formsDpy, XDefaultVisual(g_formsDpy, g_formsScr), XDefaultDepth(g_formsDpy, g_formsScr), 2, 0, g_mbBuf, g_mbW, g_mbH, 32, 0)
    If g_mbImg <> 0 Then g_mbStride = FormsL(g_mbImg, 44)
    XMapWindow(g_formsDpy, g_mbWin)
    XFlush(g_formsDpy)
End Sub

' キー。決まったら戻り値（IDOK ほか）、まだなら 0
Function FormsMbKey(ks As Long) As Long
    FormsMbKey = 0
    If ks = &HFF0D Or ks = &HFF8D Or ks = &H20 Then
        FormsMbKey = g_mbId(g_mbFocus)
    ElseIf ks = &HFF1B Then
        FormsMbKey = g_mbCancel
    ElseIf ks = &HFF09 Or ks = &HFF53 Then
        g_mbFocus = (g_mbFocus + 1) Mod g_mbN
        FormsMbPaint()
    ElseIf ks = &HFE20 Or ks = &HFF51 Then
        g_mbFocus = (g_mbFocus + g_mbN - 1) Mod g_mbN
        FormsMbPaint()
    End If
End Function

' 窓の XEvent 1 つ。決まったら戻り値、まだなら 0
Function FormsMbEvent() As Long
    Dim e As VoidPtr, t As Long, i As Long
    Dim f As *Form
    FormsMbEvent = 0
    e = VarPtr(g_mbEv(0))
    t = FormsL(e, 0)
    If FormsQ(e, 32) <> g_mbWin Then
        ' ほかの Form は描き直すだけ（入力は捨てる）
        If t = 12 And FormsL(e, 56) = 0 Then
            f = FormsFind(FormsQ(e, 32))
            If f <> 0 Then FormsPaint(f As VoidPtr)
        End If
        Exit Function
    End If
    Select Case t
        Case 12                     ' Expose
            If FormsL(e, 56) = 0 Then FormsMbPaint()
        Case 4                      ' ButtonPress
            If FormsL(e, 84) = 1 Then
                i = FormsMbHit(FormsL(e, 64), FormsL(e, 68))
                If i >= 0 Then
                    g_mbPress = i
                    g_mbPressIn = 1
                    g_mbFocus = i
                    FormsMbPaint()
                End If
            End If
        Case 6                      ' MotionNotify
            If g_mbPress >= 0 Then
                i = 0
                If FormsMbHit(FormsL(e, 64), FormsL(e, 68)) = g_mbPress Then i = 1
                If i <> g_mbPressIn Then
                    g_mbPressIn = i
                    FormsMbPaint()
                End If
            End If
        Case 5                      ' ButtonRelease
            If FormsL(e, 84) = 1 And g_mbPress >= 0 Then
                i = g_mbPress
                g_mbPress = -1
                If FormsMbHit(FormsL(e, 64), FormsL(e, 68)) = i Then FormsMbEvent = g_mbId(i)
                FormsMbPaint()
            End If
        Case 2                      ' KeyPress
            XLookupString(e, VarPtr(g_mbKey(0)), 16, VarPtr(g_mbSym(0)), 0)
            FormsMbEvent = FormsMbKey(FormsL(VarPtr(g_mbSym(0)), 0))
        Case 33                     ' ClientMessage（閉じるボタン）
            If FormsQ(e, 56) = FormsAtom(0) Then FormsMbEvent = g_mbCancel
    End Select
End Function

' MessageBox の窓。戻り値は IDOK ほか。X につながらなければ 0（標準エラーへ書く方になる）
Function FormsMsgBox(hWnd As VoidPtr, text As *Byte, caption As *Byte, typ As DWord) As Long
    Dim r As Long, cap As String, parent As VoidPtr
    FormsMsgBox = 0
    If g_mbWin <> 0 Then Exit Function         ' 入れ子は標準エラーへ
    If FormsTryOpen() = 0 Then Exit Function
    g_mbText = ""
    If text <> 0 Then g_mbText = MakeStr(text)
    cap = ""
    If caption <> 0 Then cap = MakeStr(caption)
    parent = 0
    If FormsFind(hWnd) <> 0 Then parent = hWnd
    FormsMbButtons(typ)
    g_mbPress = -1
    g_mbPressIn = 0
    FormsMbCreate(parent, cap)
    r = 0
    While r = 0
        XNextEvent(g_formsDpy, VarPtr(g_mbEv(0)))
        r = FormsMbEvent()    Wend
    XDestroyWindow(g_formsDpy, g_mbWin)
    XFlush(g_formsDpy)
    g_mbWin = 0
    ' XImage は壊さない（XDestroyImage は libc の free で data を解放するため）
    If g_mbBuf <> 0 Then free(g_mbBuf)
    g_mbBuf = 0
    g_mbImg = 0
    FormsMsgBox = r
End Function

#endif
