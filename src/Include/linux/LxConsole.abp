' LxConsole - 標準入出力と終了（Win32 API の代わり。Win64 規約で呼ばれる）
' 内部の文字列は UTF-8。Linux の端末へはそのまま書く（CP932 へは変えない）

Function LxFdOf(h As VoidPtr) As VoidPtr
    LxFdOf = h - LX_FD_BIAS
End Function

Sub Lx_ExitProcess(ByVal code As DWord)
    Lx_Syscall(LX_SYS_EXIT_GROUP, code, 0, 0, 0, 0, 0)
End Sub

' STD_INPUT_HANDLE(-10) → fd 0、-11 → 1、-12 → 2
Function Lx_GetStdHandle(ByVal n As DWord) As VoidPtr
    Dim fd As Long
    fd = -10 - (n As Long)
    Lx_GetStdHandle = fd + LX_FD_BIAS
End Function

' FILE_TYPE_DISK。FILE_TYPE_CHAR(2) を返すと Print が CP932 へ変える
Function Lx_GetFileType(ByVal h As VoidPtr) As DWord
    Lx_GetFileType = 1
End Function

' CP_UTF8
Function Lx_GetConsoleOutputCP() As DWord
    Lx_GetConsoleOutputCP = 65001
End Function

Sub LxSetDoneCount(done As *DWord, r As VoidPtr)
    If done = 0 Then Exit Sub
    done[0] = r As DWord
End Sub

Function Lx_WriteFile(ByVal h As VoidPtr, ByVal buf As VoidPtr, ByVal n As DWord, ByVal done As *DWord, ByVal ov As VoidPtr) As Long
    Dim r As VoidPtr
    r = Lx_Syscall(LX_SYS_WRITE, LxFdOf(h), buf, n, 0, 0, 0)
    Lx_WriteFile = 0
    If (r As Long) < 0 Then Exit Function
    LxSetDoneCount(done, r)
    Lx_WriteFile = 1
End Function

' 読めた数を done へ。終端（0 バイト）でも成功（Windows と同じ）。Input は 1 バイトずつ呼ぶ
Function Lx_ReadFile(ByVal h As VoidPtr, ByVal buf As VoidPtr, ByVal n As DWord, ByVal done As *DWord, ByVal ov As VoidPtr) As Long
    Dim r As VoidPtr
    LxSetDoneCount(done, 0)
    r = Lx_Syscall(LX_SYS_READ, LxFdOf(h), buf, n, 0, 0, 0)
    Lx_ReadFile = 0
    If (r As Long) < 0 Then Exit Function
    LxSetDoneCount(done, r)
    Lx_ReadFile = 1
End Function
