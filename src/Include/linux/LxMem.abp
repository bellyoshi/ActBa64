' LxMem - メモリと C 文字列（OS を呼ばない Win32 API の代わり）

Function Lx_lstrlenA(ByVal s As *Byte) As Long
    Dim n As Long
    n = 0
    If s = 0 Then Exit Function
    While s[n] <> 0
        n = n + 1
    Wend
    Lx_lstrlenA = n
End Function

Function Lx_lstrcpyA(ByVal dst As *Byte, ByVal src As *Byte) As *Byte
    Dim i As Long
    i = 0
    Do
        dst[i] = src[i]
        If src[i] = 0 Then Exit Do
        i = i + 1
    Loop
    Lx_lstrcpyA = dst
End Function

Function Lx_lstrcatA(ByVal dst As *Byte, ByVal src As *Byte) As *Byte
    Lx_lstrcpyA(VarPtr(dst[Lx_lstrlenA(dst)]), src)
    Lx_lstrcatA = dst
End Function

' バイト順の比較（Windows のロケール順ではない）。-1 / 0 / 1
Function Lx_lstrcmpA(ByVal a As *Byte, ByVal b As *Byte) As Long
    Dim i As Long
    i = 0
    While a[i] = b[i] And a[i] <> 0
        i = i + 1
    Wend
    Lx_lstrcmpA = LxSign(a[i] - b[i])
End Function

Function LxSign(d As Long) As Long
    LxSign = 0
    If d < 0 Then LxSign = -1
    If d > 0 Then LxSign = 1
End Function

Sub Lx_RtlFillMemory(ByVal p As *Byte, ByVal n As Long, ByVal v As Long)
    Dim i As Long
    i = 0
    While i < n
        p[i] = v As Byte
        i = i + 1
    Wend
End Sub

' 重なりがあっても正しく写す（memmove）
Sub Lx_RtlMoveMemory(ByVal dst As *Byte, ByVal src As *Byte, ByVal n As Long)
    If dst < src Then
        LxCopyUp(dst, src, n)
    Else
        LxCopyDown(dst, src, n)
    End If
End Sub

Sub LxCopyUp(dst As *Byte, src As *Byte, n As Long)
    Dim i As Long
    i = 0
    While i < n
        dst[i] = src[i]
        i = i + 1
    Wend
End Sub

Sub LxCopyDown(dst As *Byte, src As *Byte, n As Long)
    Dim i As Long
    i = n
    While i > 0
        i = i - 1
        dst[i] = src[i]
    Wend
End Sub

' *VoidPtr / *Word の添字と VoidPtr 配列は 4 バイト刻みになる（*Long と同じ扱い）。
' 8 バイト・2 バイトの読み書きは p + off（バイト）でこれを使う
Function LxGetQ(p As VoidPtr, off As Long) As VoidPtr
    Dim r As VoidPtr
    Dim s As *Long, d As *Long
    s = p + off
    d = VarPtr(r)
    d[0] = s[0]
    d[1] = s[1]
    LxGetQ = r
End Function

Sub LxSetQ(p As VoidPtr, off As Long, v As VoidPtr)
    Dim s As *Long, d As *Long
    s = VarPtr(v)
    d = p + off
    d[0] = s[0]
    d[1] = s[1]
End Sub

Sub LxSetW(p As *Byte, i As Long, v As Long)
    p[i * 2] = v And 255
    p[i * 2 + 1] = (v \ 256) And 255
End Sub
