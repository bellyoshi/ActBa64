' LxFile - ファイルとディレクトリ（パスは UTF-8 のまま渡す。BasicPath は -linux で A 版を呼ぶ）
' パスの \ は / として扱う（コンパイラなどが "Include\" のように組み立てるため。LxPath）
' HANDLE は fd + LX_FD_BIAS。失敗は INVALID_HANDLE_VALUE / 0（Win32 と同じ）

Const LX_O_CREAT = &H40
Const LX_O_EXCL = &H80
Const LX_O_TRUNC = &H200
Const LX_FILE_MODE = 420
Const LX_DIR_MODE = 493
Const LX_PATH_MAX = 4096

' syscall の戻り値が 0 以上なら 1（-errno なら 0）
Function LxOk(r As VoidPtr) As Long
    LxOk = 1
    If (r As Long) < 0 Then LxOk = 0
End Function

Function LxLow(r As VoidPtr) As DWord
    Dim w As *DWord
    w = VarPtr(r)
    LxLow = w[0]
End Function

' name を dst へ写し、\ を / にする（dst は LX_PATH_MAX バイト）
Function LxPath(name As *Byte, dst As *Byte) As *Byte
    Dim i As Long
    i = 0
    While name[i] <> 0 And i < LX_PATH_MAX - 1
        dst[i] = name[i]
        If name[i] = &H5C Then dst[i] = &H2F
        i = i + 1
    Wend
    dst[i] = 0
    LxPath = dst
End Function

' GENERIC_READ / GENERIC_WRITE → O_RDONLY / O_WRONLY / O_RDWR
Function LxOpenAccess(access As DWord) As Long
    LxOpenAccess = 0
    If (access And GENERIC_WRITE) <> 0 Then LxOpenAccess = 1
    If (access And GENERIC_WRITE) <> 0 And (access And GENERIC_READ) <> 0 Then LxOpenAccess = 2
End Function

' CREATE_NEW / CREATE_ALWAYS / OPEN_EXISTING / OPEN_ALWAYS / TRUNCATE_EXISTING
Function LxOpenDisp(disp As DWord) As Long
    LxOpenDisp = 0
    If disp = 1 Then LxOpenDisp = LX_O_CREAT Or LX_O_EXCL
    If disp = 2 Then LxOpenDisp = LX_O_CREAT Or LX_O_TRUNC
    If disp = 4 Then LxOpenDisp = LX_O_CREAT
    If disp = 5 Then LxOpenDisp = LX_O_TRUNC
End Function

Function Lx_CreateFileA(ByVal name As *Byte, ByVal access As DWord, ByVal share As DWord, ByVal sa As VoidPtr, ByVal disp As DWord, ByVal flags As DWord, ByVal tmpl As VoidPtr) As VoidPtr
    Dim path(LX_PATH_MAX - 1) As Byte
    Dim r As VoidPtr
    r = Lx_Syscall(LX_SYS_OPEN, LxPath(name, VarPtr(path(0))), LxOpenAccess(access) Or LxOpenDisp(disp), LX_FILE_MODE, 0, 0, 0)
    Lx_CreateFileA = -1
    If LxOk(r) = 0 Then Exit Function
    Lx_CreateFileA = r + LX_FD_BIAS
End Function

Function Lx_CloseHandle(ByVal h As VoidPtr) As Long
    Lx_CloseHandle = 1
    If (h As Long) >= LX_PROC_BIAS Then Exit Function
    Lx_CloseHandle = LxOk(Lx_Syscall(LX_SYS_CLOSE, LxFdOf(h), 0, 0, 0, 0, 0))
End Function

' struct stat の st_size は +48、st_mode は +24
Function Lx_GetFileSize(ByVal h As VoidPtr, ByVal hi As *DWord) As DWord
    Dim st(143) As Byte
    Dim p As *DWord
    Lx_GetFileSize = &HFFFFFFFF
    If LxOk(Lx_Syscall(LX_SYS_FSTAT, LxFdOf(h), VarPtr(st(0)), 0, 0, 0, 0)) = 0 Then Exit Function
    p = VarPtr(st(48))
    If hi <> 0 Then hi[0] = p[1]
    Lx_GetFileSize = p[0]
End Function

' 下位 dist と上位 hi[0]（hi=0 なら符号拡張）から 64bit の位置
Function LxSeekOff(dist As Long, hi As *Long) As VoidPtr
    Dim off As VoidPtr
    Dim w As *Long
    w = VarPtr(off)
    w[0] = dist
    w[1] = 0
    If dist < 0 Then w[1] = -1
    If hi <> 0 Then w[1] = hi[0]
    LxSeekOff = off
End Function

' FILE_BEGIN / FILE_CURRENT / FILE_END は SEEK_SET / SEEK_CUR / SEEK_END と同じ値
Function Lx_SetFilePointer(ByVal h As VoidPtr, ByVal dist As Long, ByVal hi As *Long, ByVal method As DWord) As DWord
    Dim r As VoidPtr
    Dim w As *Long
    r = Lx_Syscall(LX_SYS_LSEEK, LxFdOf(h), LxSeekOff(dist, hi), method, 0, 0, 0)
    Lx_SetFilePointer = &HFFFFFFFF
    If LxOk(r) = 0 Then Exit Function
    w = VarPtr(r)
    If hi <> 0 Then hi[0] = w[1]
    Lx_SetFilePointer = LxLow(r)
End Function

' 無ければ INVALID_FILE_ATTRIBUTES。ディレクトリは FILE_ATTRIBUTE_DIRECTORY、他は NORMAL
Function Lx_GetFileAttributesA(ByVal name As *Byte) As DWord
    Dim path(LX_PATH_MAX - 1) As Byte
    Dim st(143) As Byte
    Dim m As *DWord
    Lx_GetFileAttributesA = &HFFFFFFFF
    If LxOk(Lx_Syscall(LX_SYS_STAT, LxPath(name, VarPtr(path(0))), VarPtr(st(0)), 0, 0, 0, 0)) = 0 Then Exit Function
    m = VarPtr(st(24))
    Lx_GetFileAttributesA = &H80
    If (m[0] And &HF000) = &H4000 Then Lx_GetFileAttributesA = FILE_ATTRIBUTE_DIRECTORY
End Function

Function Lx_DeleteFileA(ByVal name As *Byte) As Long
    Dim path(LX_PATH_MAX - 1) As Byte
    Lx_DeleteFileA = LxOk(Lx_Syscall(LX_SYS_UNLINK, LxPath(name, VarPtr(path(0))), 0, 0, 0, 0, 0))
End Function

Function Lx_CreateDirectoryA(ByVal name As *Byte, ByVal sa As VoidPtr) As Long
    Dim path(LX_PATH_MAX - 1) As Byte
    Lx_CreateDirectoryA = LxOk(Lx_Syscall(LX_SYS_MKDIR, LxPath(name, VarPtr(path(0))), LX_DIR_MODE, 0, 0, 0, 0))
End Function

Function Lx_RemoveDirectoryA(ByVal name As *Byte) As Long
    Dim path(LX_PATH_MAX - 1) As Byte
    Lx_RemoveDirectoryA = LxOk(Lx_Syscall(LX_SYS_RMDIR, LxPath(name, VarPtr(path(0))), 0, 0, 0, 0, 0))
End Function

Function Lx_SetCurrentDirectoryA(ByVal name As *Byte) As Long
    Dim path(LX_PATH_MAX - 1) As Byte
    Lx_SetCurrentDirectoryA = LxOk(Lx_Syscall(LX_SYS_CHDIR, LxPath(name, VarPtr(path(0))), 0, 0, 0, 0, 0))
End Function

' 戻り値は NUL を除く長さ（入らなければ 0）
Function Lx_GetCurrentDirectoryA(ByVal n As DWord, ByVal buf As *Byte) As DWord
    Lx_GetCurrentDirectoryA = 0
    If LxOk(Lx_Syscall(LX_SYS_GETCWD, buf, n, 0, 0, 0, 0)) = 0 Then Exit Function
    Lx_GetCurrentDirectoryA = Lx_lstrlenA(buf)
End Function

' 絶対パス（/ で始まる）はそのまま、ほかはカレントディレクトリ + "/" + name。. / .. は残す
' 戻り値は NUL を除く長さ。入らなければ要る大きさ（NUL を含む）。filePart は使わない
Function Lx_GetFullPathNameA(ByVal name As *Byte, ByVal n As DWord, ByVal buf As *Byte, ByVal filePart As VoidPtr) As DWord
    Dim full(LX_PATH_MAX - 1) As Byte
    Dim path(LX_PATH_MAX - 1) As Byte
    LxPath(name, VarPtr(path(0)))
    full(0) = 0
    If path(0) <> &H2F Then LxCwdSlash(VarPtr(full(0)))
    Lx_lstrcatA(VarPtr(full(0)), VarPtr(path(0)))
    Lx_GetFullPathNameA = LxCopyOut(VarPtr(full(0)), n, buf)
End Function

Sub LxCwdSlash(full As *Byte)
    If Lx_GetCurrentDirectoryA(LX_PATH_MAX - 2, full) = 0 Then Exit Sub
    If full[Lx_lstrlenA(full) - 1] <> &H2F Then Lx_lstrcatA(full, "/")
End Sub

Function LxCopyOut(src As *Byte, n As DWord, buf As *Byte) As DWord
    Dim k As DWord
    k = Lx_lstrlenA(src)
    LxCopyOut = k + 1
    If k + 1 > n Then Exit Function
    Lx_lstrcpyA(buf, src)
    LxCopyOut = k
End Function
