' Include/linux 自動読み込み一覧（-linux のとき default.idx / api.idx の後に Preproc が挿入）
' Lx_<API名> の関数は、同じ名前の Win32 API の呼び出しスロットに入る（actba64 LinuxRt）。
' 無い API を呼ぶと "unsupported API: 名前" を出して終了コード 127。
#include "LxSys.sbp"
#include "LxConsole.abp"
#include "LxMem.abp"
#include "LxHeap.abp"
#include "LxFile.abp"
#include "LxTime.abp"
#include "LxCmd.abp"
#include "LxUnicode.abp"
