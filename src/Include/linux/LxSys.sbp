' LxSys.sbp - Linux x86-64 システムコール（actba64 LinuxStub の機械語スタブ）
' Lx_Syscall(番号, a1, a2, a3, a4, a5, a6)。戻り値が負なら -errno。
' Lx_StackBase() は起動時の rsp。[+0]=argc、[+8]=argv[0]...

Declare Function Lx_Syscall Lib "linux" (ByVal nr As VoidPtr, ByVal a1 As VoidPtr, ByVal a2 As VoidPtr, ByVal a3 As VoidPtr, ByVal a4 As VoidPtr, ByVal a5 As VoidPtr, ByVal a6 As VoidPtr) As VoidPtr
Declare Function Lx_StackBase Lib "linux" () As VoidPtr

Const LX_SYS_READ = 0
Const LX_SYS_WRITE = 1
Const LX_SYS_OPEN = 2
Const LX_SYS_CLOSE = 3
Const LX_SYS_STAT = 4
Const LX_SYS_FSTAT = 5
Const LX_SYS_LSEEK = 8
Const LX_SYS_MMAP = 9
Const LX_SYS_MUNMAP = 11
Const LX_SYS_NANOSLEEP = 35
Const LX_SYS_GETCWD = 79
Const LX_SYS_CHDIR = 80
Const LX_SYS_MKDIR = 83
Const LX_SYS_RMDIR = 84
Const LX_SYS_UNLINK = 87
Const LX_SYS_READLINK = 89
Const LX_SYS_CLOCK_GETTIME = 228
Const LX_SYS_EXIT_GROUP = 231

' HANDLE と fd の対応。fd 0（標準入力）が NULL ハンドルにならないよう 1 ずらす
Const LX_FD_BIAS = 1
