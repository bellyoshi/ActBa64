' Forms.sbp - Form と Application（ActiveBasic 風の窓）
'
'   #include <Forms.sbp>
'
'   Class Form1
'       Inherits Form
'   Private
'       Override Sub InitializeComponent()
'           Left = 100
'           Top = 100
'           Width = 320
'           Height = 240
'           Caption = "Form1"
'       End Sub
'   End Class
'
'   Dim mainForm As Form1           ' InitializeComponent は最初の Show（Application.Run）で呼ばれる
'   Application.Initialize()
'   Application.Run(mainForm)       ' 窓を出し、閉じるまでメッセージを回す
'
' メッセージは Override Function WndProc(msg, wParam, lParam) で受け取り、
' 自分で扱わないものは Super.WndProc(msg, wParam, lParam) に渡す。
'
' 部品（Button / Label / PictureBox）はメンバーにして、InitializeComponent で AddControl する。
' 窓ができたあとで文字を変えるときは SetCaption(s)、使える・使えないは SetEnabled(b) を使う
' （Caption / Enabled に入れるだけでは窓は変わらない）。Enabled の初めの値は True。
' 位置と大きさを窓ができたあとで変えるのは SetBounds(x, y, w, h)。
' PictureBox.SetBitmap(hbmp) は絵を出し、その HBITMAP の持ち主になる（前の絵は DeleteObject）。
'
' ファイルを開くダイアログは OpenFileDialog（窓を持たないので AddControl しない）:
'   OpenDialog1.Filter = "PDFファイル|*.pdf|すべてのファイル|*.*"
'   If OpenDialog1.Execute(Handle) Then Label1.SetCaption(ExtractFileName(OpenDialog1.FileName))
' フォームの見出しを窓ができたあとで変えるのは、部品と同じ SetCaption(s)。
'
' InitializeComponent は ctor ではなく最初の Show で呼ぶ。メンバーの部品の ctor は
' Form の ctor のあとに走るので、ctor の中で値を入れると部品の ctor に上書きされるため。
' 子窓はフォームの窓ができたとき（WM_CREATE の前）に作られる。
' 押されたことは、フォームの WndProc に WM_COMMAND（HIWORD(wParam) = BN_CLICKED、
' lParam = ボタンの Handle）として届く。
'
'   Class Form1
'       Inherits Form
'   Public
'       Override Function WndProc(msg As DWord, wParam As WPARAM, lParam As LPARAM) As LRESULT
'           If msg = WM_COMMAND Then
'               If HIWORD(wParam) = BN_CLICKED And lParam = Button1.Handle Then Button1Click()
'           End If
'           WndProc = Super.WndProc(msg, wParam, lParam)
'       End Function
'   Private
'       Button1 As Button
'       Sub Button1Click()
'           ...
'       End Sub
'       Override Sub InitializeComponent()
'           Button1.Left = 8 : Button1.Top = 8 : Button1.Width = 100 : Button1.Height = 30
'           Button1.Caption = "Button1"
'           AddControl(Button1)
'       End Sub
'   End Class
'
' -linux では X11（libX11.so.6）の窓になる（ELF は動的リンク）。WndProc に届くのは
' WM_CREATE / WM_PAINT / WM_SIZE / WM_KEYDOWN / WM_CHAR / WM_?BUTTONDOWN・UP /
' WM_MOUSEMOVE / WM_CLOSE / WM_DESTROY。Super.WndProc は WM_CLOSE で窓を壊し、
' WM_DESTROY でメッセージループを終わらせる。

Const FORMS_PATH_MAX = 780          ' OpenFileDialog の FileName のバイト数の上限（MAX_PATH の UTF-8）

' パスの区切り（\ / :）か。UTF-8 では 2 バイト目以降に &H5C は来ない
Function FormsIsSep(c As String) As Long
    FormsIsSep = 0
    If c = "\" Or c = "/" Or c = ":" Then FormsIsSep = 1
End Function

' パスからファイル名だけ（Lazarus の ExtractFileName）。区切りが無ければそのまま
Function ExtractFileName(path As String) As String
    Dim i As Long
    i = Len(path)
    While i > 0 And FormsIsSep(Mid$(path, i, 1)) = 0
        i = i - 1
    Wend
    ExtractFileName = Mid$(path, i + 1, Len(path) - i)
End Function

#ifdef _LINUX
' ---- X11 版 ----
' Window / Atom / Display* は 64bit（VoidPtr）。XEvent（192 バイト）はバイト列から読む

Declare Function XOpenDisplay Lib "libX11.so.6" (name As VoidPtr) As VoidPtr
Declare Function XCloseDisplay Lib "libX11.so.6" (d As VoidPtr) As Long
Declare Function XDefaultScreen Lib "libX11.so.6" (d As VoidPtr) As Long
Declare Function XRootWindow Lib "libX11.so.6" (d As VoidPtr, scr As Long) As VoidPtr
Declare Function XCreateSimpleWindow Lib "libX11.so.6" (d As VoidPtr, parent As VoidPtr, x As Long, y As Long, w As Long, h As Long, bw As Long, border As VoidPtr, back As VoidPtr) As VoidPtr
Declare Function XDestroyWindow Lib "libX11.so.6" (d As VoidPtr, w As VoidPtr) As Long
Declare Function XStoreName Lib "libX11.so.6" (d As VoidPtr, w As VoidPtr, name As BytePtr) As Long
Declare Function XInternAtom Lib "libX11.so.6" (d As VoidPtr, name As BytePtr, onlyIfExists As Long) As VoidPtr
Declare Function XChangeProperty Lib "libX11.so.6" (d As VoidPtr, w As VoidPtr, prop As VoidPtr, typ As VoidPtr, fmt As Long, mode As Long, data As BytePtr, n As Long) As Long
Declare Function XSetWMProtocols Lib "libX11.so.6" (d As VoidPtr, w As VoidPtr, atoms As VoidPtr, n As Long) As Long
Declare Function XSetWMNormalHints Lib "libX11.so.6" (d As VoidPtr, w As VoidPtr, hints As VoidPtr) As Long
Declare Function XSelectInput Lib "libX11.so.6" (d As VoidPtr, w As VoidPtr, mask As VoidPtr) As Long
Declare Function XMapWindow Lib "libX11.so.6" (d As VoidPtr, w As VoidPtr) As Long
Declare Function XNextEvent Lib "libX11.so.6" (d As VoidPtr, ev As VoidPtr) As Long
Declare Function XSendEvent Lib "libX11.so.6" (d As VoidPtr, w As VoidPtr, propagate As Long, mask As VoidPtr, ev As VoidPtr) As Long
Declare Function XFlush Lib "libX11.so.6" (d As VoidPtr) As Long
Declare Function XFetchName Lib "libX11.so.6" (d As VoidPtr, w As VoidPtr, name As VoidPtr) As Long
Declare Function XFree Lib "libX11.so.6" (p As VoidPtr) As Long
Declare Function XLookupString Lib "libX11.so.6" (ev As VoidPtr, buf As VoidPtr, n As Long, keysym As VoidPtr, status As VoidPtr) As Long
Declare Function FormsStrLen Lib "libc.so.6" Alias "strlen" (s As BytePtr) As Long

Const FORMS_MAX = 16                ' 同時に開ける Form の数
Const FORMS_X_MASK = &H2804F        ' KeyPress | ButtonPress | ButtonRelease | PointerMotion | Exposure | StructureNotify

Dim g_formsDpy As VoidPtr
Dim g_formsScr As Long
Dim g_formsQuit As Long
Dim g_formsTab(255) As Byte         ' FORMS_MAX 個の (Window, *Form)。16 バイトずつ
Dim g_formsAtom(15) As Byte         ' 0: WM_DELETE_WINDOW, 8: WM_PROTOCOLS
Dim g_formsEv(191) As Byte          ' XNextEvent で受ける XEvent
Dim g_formsSend(191) As Byte        ' Close で自分へ送る ClientMessage
Dim g_formsHint(79) As Byte         ' XSizeHints
Dim g_formsKey(15) As Byte          ' XLookupString の文字
Dim g_formsSym(7) As Byte           ' KeySym

' 部品。X11 版ではまだ子窓を作らない（AddControl は通るが、窓には出ない）
Class Control
Public
    Left As Long
    Top As Long
    Width As Long
    Height As Long
    Caption As String
    Handle As HWND
    Enabled As Long             ' 使えるか（初めは True）
    NextControl As *Control     ' 同じ Form に載せた次の部品（Forms.sbp が使う）

    Sub Control()
        Enabled = True
    End Sub

    Virtual Sub CreateHandle(parent As HWND)
    End Sub

    ' 文字を変える（X11 版は Caption を変えるだけ）
    Sub SetCaption(s As String)
        Caption = s
    End Sub

    ' 使える・使えないを変える（X11 版は Enabled を変えるだけ）
    Sub SetEnabled(b As Long)
        Enabled = b
    End Sub

    ' 位置と大きさを変える（X11 版は値を変えるだけ）
    Sub SetBounds(x As Long, y As Long, w As Long, h As Long)
        Left = x
        Top = y
        Width = w
        Height = h
    End Sub
End Class

' 絵を出す部品。X11 版は Bitmap を覚えるだけで、描かず、前の絵も消さない
Class PictureBox
    Inherits Control
Public
    Bitmap As HBITMAP

    Sub SetBitmap(h As HBITMAP)
        Bitmap = h
    End Sub
End Class

Class Button
    Inherits Control
End Class

Class Label
    Inherits Control
End Class

Class Form
Private
    firstControl As *Control        ' AddControl で載せた部品（NextControl でつなぐ）
    lastControl As *Control
    componentsDone As Long          ' InitializeComponent を呼んだか
Public
    Left As Long
    Top As Long
    Width As Long
    Height As Long
    Caption As String
    Handle As HWND

    Sub Form()
        Left = CW_USEDEFAULT
        Top = CW_USEDEFAULT
        Width = CW_USEDEFAULT
        Height = CW_USEDEFAULT
    End Sub

    ' フォームデザイナが Override して、位置・大きさ・見出し・部品を入れる。最初の Show で 1 度だけ呼ばれる
    Virtual Sub InitializeComponent()
    End Sub

    ' まだなら InitializeComponent を呼ぶ（Show が呼ぶ。窓を出す前に値を読みたいときにも使える）
    Sub InitComponents()
        If componentsDone <> 0 Then Exit Sub
        componentsDone = 1
        InitializeComponent()
    End Sub

    ' 部品を載せる。窓がもうあれば、すぐ子窓を作る
    Sub AddControl(ByRef c As Control)
        Dim p As *Control, q As *Control
        p = VarPtr(c)
        p->NextControl = 0
        If lastControl = 0 Then
            firstControl = p
        Else
            q = lastControl
            q->NextControl = p
        End If
        lastControl = p
        If Handle <> 0 Then c.CreateHandle(Handle)
    End Sub

    ' 載せた部品の子窓を作る（窓ができたときに Forms.sbp が呼ぶ）
    Sub CreateControls()
        Dim c As *Control
        c = firstControl
        While c <> 0
            c->CreateHandle(Handle)
            c = c->NextControl
        Wend
    End Sub

    ' 窓のメッセージ。既定は、WM_CLOSE で窓を壊し、窓が壊れたらメッセージループを終わらせる
    Virtual Function WndProc(msg As DWord, wParam As WPARAM, lParam As LPARAM) As LRESULT
        If msg = WM_CLOSE Then FormsDestroy(This)
        If msg = WM_DESTROY Then g_formsQuit = 1
        WndProc = 0
    End Function

    ' 窓がまだ無ければ作って、表示する
    Sub Show()
        InitComponents()
        If Handle = 0 Then FormsCreate(This)
        XMapWindow(g_formsDpy, Handle)
        XFlush(g_formsDpy)
    End Sub

    ' 窓を閉じる（WM_CLOSE をメッセージとして自分へ送る）
    Sub Close()
        If Handle <> 0 Then FormsPostClose(Handle)
    End Sub

    ' 見出しを変える。窓がもうあれば窓の見出しも変える。
    ' 先に InitializeComponent を済ませる（あとで呼ばれて Caption を上書きしないように）
    Sub SetCaption(s As String)
        InitComponents()
        Caption = s
        If Handle <> 0 Then FormsTitle(Handle As VoidPtr, Caption)
    End Sub
End Class

' ファイルを開くダイアログ。X11 版はまだ無いので、Execute はいつも False
Class OpenFileDialog
Public
    Filter As String
    FileName As String
    Title As String

    Function Execute(hOwner As HWND) As Long
        Execute = False
    End Function
End Class

' 8 バイト・4 バイトの読み書き（VoidPtr 配列は使わない）
Function FormsQ(buf As VoidPtr, off As Long) As VoidPtr
    FormsQ = LxGetQ(buf, off)
End Function

Function FormsL(buf As VoidPtr, off As Long) As Long
    Dim p As *Long
    p = buf + off
    FormsL = p[0]
End Function

Sub FormsSetL(buf As VoidPtr, off As Long, v As Long)
    Dim p As *Long
    p = buf + off
    p[0] = v
End Sub

Function FormsAtom(i As Long) As VoidPtr
    FormsAtom = LxGetQ(VarPtr(g_formsAtom(0)), i * 8)
End Function

' 1 度だけ X サーバーへつなぐ
Sub FormsOpen()
    If g_formsDpy <> 0 Then Exit Sub
    g_formsDpy = XOpenDisplay(0)
    If g_formsDpy = 0 Then
        Print "Forms: cannot open X display (DISPLAY is not set?)"
        ExitProcess(1)
    End If
    g_formsScr = XDefaultScreen(g_formsDpy)
    LxSetQ(VarPtr(g_formsAtom(0)), 0, XInternAtom(g_formsDpy, "WM_DELETE_WINDOW", 0))
    LxSetQ(VarPtr(g_formsAtom(0)), 8, XInternAtom(g_formsDpy, "WM_PROTOCOLS", 0))
End Sub

' 窓 → Form の表。無ければ 0
Function FormsFind(w As VoidPtr) As *Form
    Dim i As Long
    FormsFind = 0
    If w = 0 Then Exit Function
    For i = 0 To FORMS_MAX - 1
        If FormsQ(VarPtr(g_formsTab(0)), i * 16) = w Then
            FormsFind = FormsQ(VarPtr(g_formsTab(0)), i * 16 + 8) As *Form
            Exit Function
        End If
    Next
End Function

Sub FormsBind(w As VoidPtr, f As VoidPtr)
    Dim i As Long
    For i = 0 To FORMS_MAX - 1
        If FormsQ(VarPtr(g_formsTab(0)), i * 16) = 0 Then
            LxSetQ(VarPtr(g_formsTab(0)), i * 16, w)
            LxSetQ(VarPtr(g_formsTab(0)), i * 16 + 8, f)
            Exit Sub
        End If
    Next
End Sub

Sub FormsUnbind(w As VoidPtr)
    Dim i As Long
    For i = 0 To FORMS_MAX - 1
        If FormsQ(VarPtr(g_formsTab(0)), i * 16) = w Then
            LxSetQ(VarPtr(g_formsTab(0)), i * 16, 0)
            LxSetQ(VarPtr(g_formsTab(0)), i * 16 + 8, 0)
        End If
    Next
End Sub

' 窓を作り、見出し・位置・閉じるボタンを設定して WM_CREATE を送る
Sub FormsCreate(p As VoidPtr)
    Dim f As *Form
    Dim w As VoidPtr, x As Long, y As Long, cx As Long, cy As Long
    Dim flags As Long, n As Long
    f = p As *Form
    FormsOpen()
    x = f->Left : y = f->Top : cx = f->Width : cy = f->Height
    flags = 3                       ' USPosition | USSize
    If x = CW_USEDEFAULT Or y = CW_USEDEFAULT Then
        x = 0 : y = 0 : flags = 2
    End If
    If cx = CW_USEDEFAULT Or cx <= 0 Then cx = 400
    If cy = CW_USEDEFAULT Or cy <= 0 Then cy = 300
    w = XCreateSimpleWindow(g_formsDpy, XRootWindow(g_formsDpy, g_formsScr), x, y, cx, cy, 0, 0, &HF0F0F0)
    f->Handle = w As HWND
    FormsBind(w, p)

    FormsTitle(w, f->Caption)

    ' 位置と大きさ（WM が従うように USPosition / USSize）
    RtlFillMemory(VarPtr(g_formsHint(0)), 80, 0)
    FormsSetL(VarPtr(g_formsHint(0)), 0, flags)
    FormsSetL(VarPtr(g_formsHint(0)), 8, x)
    FormsSetL(VarPtr(g_formsHint(0)), 12, y)
    FormsSetL(VarPtr(g_formsHint(0)), 16, cx)
    FormsSetL(VarPtr(g_formsHint(0)), 20, cy)
    XSetWMNormalHints(g_formsDpy, w, VarPtr(g_formsHint(0)))

    XSetWMProtocols(g_formsDpy, w, VarPtr(g_formsAtom(0)), 1)
    XSelectInput(g_formsDpy, w, FORMS_X_MASK)
    f->CreateControls()
    f->WndProc(WM_CREATE, 0, 0)
End Sub

' 見出し。_NET_WM_NAME は UTF-8（日本語も出る）、WM_NAME は古い WM 向け
Sub FormsTitle(w As VoidPtr, cap As String)
    XStoreName(g_formsDpy, w, StrPtr(cap))
    XChangeProperty(g_formsDpy, w, XInternAtom(g_formsDpy, "_NET_WM_NAME", 0), XInternAtom(g_formsDpy, "UTF8_STRING", 0), 8, 0, StrPtr(cap), FormsStrLen(StrPtr(cap)))
    XFlush(g_formsDpy)
End Sub

' WM_DESTROY を送ってから窓を壊す（Windows の DestroyWindow と同じ順）
Sub FormsDestroy(p As VoidPtr)
    Dim f As *Form
    Dim w As VoidPtr
    f = p As *Form
    w = f->Handle As VoidPtr
    If w = 0 Then Exit Sub
    f->WndProc(WM_DESTROY, 0, 0)
    FormsUnbind(w)
    f->Handle = 0
    XDestroyWindow(g_formsDpy, w)
    XFlush(g_formsDpy)
End Sub

' 閉じるボタンと同じ ClientMessage（WM_DELETE_WINDOW）を自分へ送る
Sub FormsPostClose(h As HWND)
    Dim b As VoidPtr
    b = VarPtr(g_formsSend(0))
    RtlFillMemory(b, 192, 0)
    FormsSetL(b, 0, 33)             ' ClientMessage
    LxSetQ(b, 32, h As VoidPtr)     ' window
    LxSetQ(b, 40, FormsAtom(1))     ' message_type = WM_PROTOCOLS
    FormsSetL(b, 48, 32)            ' format
    LxSetQ(b, 56, FormsAtom(0))     ' data.l[0] = WM_DELETE_WINDOW
    XSendEvent(g_formsDpy, h As VoidPtr, 0, 0, b)
    XFlush(g_formsDpy)
End Sub

' 位置 → lParam（MAKELPARAM(x, y)）
Function FormsXY(x As Long, y As Long) As LPARAM
    FormsXY = ((y And &HFFFF) * &H10000 + (x And &HFFFF)) As LPARAM
End Function

' KeySym → 仮想キー（英数字・Enter・Esc・BS・Tab・空白・矢印。ほかは KeySym のまま）
Function FormsVk(ks As Long) As Long
    FormsVk = ks
    If ks >= &H61 And ks <= &H7A Then FormsVk = ks - &H20
    If ks = &HFF0D Then FormsVk = 13
    If ks = &HFF1B Then FormsVk = 27
    If ks = &HFF08 Then FormsVk = 8
    If ks = &HFF09 Then FormsVk = 9
    If ks >= &HFF51 And ks <= &HFF54 Then FormsVk = ks - &HFF51 + 37
End Function

' マウスのボタン → WM_?BUTTONDOWN（up = 1 なら UP）。ホイールなどは 0
Function FormsButtonMsg(button As Long, up As Long) As DWord
    FormsButtonMsg = 0
    If button = 1 Then FormsButtonMsg = WM_LBUTTONDOWN + up
    If button = 2 Then FormsButtonMsg = WM_MBUTTONDOWN + up
    If button = 3 Then FormsButtonMsg = WM_RBUTTONDOWN + up
End Function

' XEvent 1 つを、その窓の Form の WndProc へ
Sub FormsDispatch()
    Dim e As VoidPtr, t As Long, n As Long, ks As Long
    Dim msg As DWord
    Dim f As *Form
    e = VarPtr(g_formsEv(0))
    t = FormsL(e, 0)
    f = FormsFind(FormsQ(e, 32))
    If f = 0 Then Exit Sub
    Select Case t
        Case 12                     ' Expose（まとめの最後だけ）
            If FormsL(e, 56) = 0 Then f->WndProc(WM_PAINT, 0, 0)
        Case 22                     ' ConfigureNotify
            If FormsL(e, 56) <> f->Width Or FormsL(e, 60) <> f->Height Then
                f->Width = FormsL(e, 56)
                f->Height = FormsL(e, 60)
                f->WndProc(WM_SIZE, 0, FormsXY(f->Width, f->Height))
            End If
        Case 4                      ' ButtonPress
            msg = FormsButtonMsg(FormsL(e, 84), 0)
            If msg <> 0 Then f->WndProc(msg, 0, FormsXY(FormsL(e, 64), FormsL(e, 68)))
        Case 5                      ' ButtonRelease
            msg = FormsButtonMsg(FormsL(e, 84), 1)
            If msg <> 0 Then f->WndProc(msg, 0, FormsXY(FormsL(e, 64), FormsL(e, 68)))
        Case 6                      ' MotionNotify
            f->WndProc(WM_MOUSEMOVE, 0, FormsXY(FormsL(e, 64), FormsL(e, 68)))
        Case 2                      ' KeyPress
            n = XLookupString(e, VarPtr(g_formsKey(0)), 16, VarPtr(g_formsSym(0)), 0)
            ks = FormsL(VarPtr(g_formsSym(0)), 0)
            f->WndProc(WM_KEYDOWN, FormsVk(ks) As WPARAM, 0)
            If n >= 1 Then f->WndProc(WM_CHAR, g_formsKey(0) As WPARAM, 0)
        Case 33                     ' ClientMessage（閉じるボタン）
            If FormsQ(e, 56) = FormsAtom(0) Then f->WndProc(WM_CLOSE, 0, 0)
    End Select
End Sub

' 窓の見出しを読む（X サーバーにあるもの）。テスト用
Function FormsGetTitle(h As HWND, buf As *Byte, n As Long) As Long
    Dim s As VoidPtr, src As *Byte, i As Long
    FormsGetTitle = 0
    buf[0] = 0
    s = 0
    If XFetchName(g_formsDpy, h As VoidPtr, VarPtr(s)) = 0 Then Exit Function
    If s = 0 Then Exit Function
    src = s
    i = 0
    While i < n - 1 And src[i] <> 0
        buf[i] = src[i]
        i = i + 1
    Wend
    buf[i] = 0
    XFree(s)
    FormsGetTitle = 1
End Function

Class FormsApplication
Public
    ' 今は何もしない（Lazarus の Application.Initialize に合わせた入口）
    Sub Initialize()
    End Sub

    ' フォームを表示し、窓が閉じるまでメッセージを回す
    Sub Run(ByRef f As Form)
        g_formsQuit = 0
        f.Show()
        While g_formsQuit = 0
            XNextEvent(g_formsDpy, VarPtr(g_formsEv(0)))
            FormsDispatch()
        Wend
        XCloseDisplay(g_formsDpy)
        g_formsDpy = 0
    End Sub
End Class

Dim Application As FormsApplication

#else

Dim g_formsWc As WNDCLASSEX
Dim g_formsClass(31) As Byte
Dim g_formsReg As Long
Dim g_formsNew As VoidPtr           ' CreateWindowEx のあいだだけ、窓を作っている Form

' 部品。子のクラスが CreateHandle で子窓を作る
Class Control
Public
    Left As Long
    Top As Long
    Width As Long
    Height As Long
    Caption As String
    Handle As HWND
    Enabled As Long             ' 使えるか（初めは True）
    NextControl As *Control     ' 同じ Form に載せた次の部品（Forms.sbp が使う）

    Sub Control()
        Enabled = True
    End Sub

    ' parent の中に子窓を作る
    Virtual Sub CreateHandle(parent As HWND)
    End Sub

    ' 文字を変える。窓がもうあれば窓の文字も変える
    Sub SetCaption(s As String)
        Caption = s
        If Handle <> 0 Then SetWindowText(Handle, StrPtr(Caption))
    End Sub

    ' 使える・使えないを変える。窓がもうあれば窓も変える
    Sub SetEnabled(b As Long)
        Enabled = b
        If Handle <> 0 Then EnableWindow(Handle, b)
    End Sub

    ' 位置と大きさを変える。窓がもうあれば窓も動かす
    Sub SetBounds(x As Long, y As Long, w As Long, h As Long)
        Left = x
        Top = y
        Width = w
        Height = h
        If Handle <> 0 Then MoveWindow(Handle, x, y, w, h, TRUE)
    End Sub

    ' 子窓を作った直後に、文字（DEFAULT_GUI_FONT）と Enabled を窓へ
    Sub AfterCreate()
        FormsSetFont(Handle)
        If Enabled = False Then EnableWindow(Handle, FALSE)
    End Sub
End Class

' 押しボタン。押されると、親の WndProc に WM_COMMAND（BN_CLICKED）が届く
Class Button
    Inherits Control
Public
    Override Sub CreateHandle(parent As HWND)
        Handle = CreateWindowEx(0, "BUTTON", StrPtr(Caption), WS_CHILD Or WS_VISIBLE Or WS_TABSTOP Or BS_PUSHBUTTON, Left, Top, Width, Height, parent, 0, GetModuleHandle(0), 0)
        AfterCreate()
    End Sub
End Class

' 文字だけの部品（STATIC）。押しても何も届かない
Class Label
    Inherits Control
Public
    Override Sub CreateHandle(parent As HWND)
        Handle = CreateWindowEx(0, "STATIC", StrPtr(Caption), WS_CHILD Or WS_VISIBLE Or SS_LEFT, Left, Top, Width, Height, parent, 0, GetModuleHandle(0), 0)
        AfterCreate()
    End Sub
End Class

' 絵を出す部品（STATIC の SS_BITMAP。Lazarus の TImage）。絵は左上に、元の大きさで出る
' （SS_BITMAP の STATIC は絵の大きさに縮む。SetBounds で広げても、次の SetBitmap でまた絵の大きさになる）
Class PictureBox
    Inherits Control
Public
    Bitmap As HBITMAP           ' 出している絵。SetBitmap で渡したものの持ち主

    Override Sub CreateHandle(parent As HWND)
        Handle = CreateWindowEx(0, "STATIC", 0, WS_CHILD Or WS_VISIBLE Or SS_BITMAP, Left, Top, Width, Height, parent, 0, GetModuleHandle(0), 0)
        AfterCreate()
        If Bitmap <> 0 Then FormsSetImage(Handle, Bitmap, 0)
    End Sub

    ' 絵を出す。h の持ち主になり、前の絵は DeleteObject する（0 なら絵を消す）
    Sub SetBitmap(h As HBITMAP)
        Dim prev As HBITMAP
        prev = Bitmap
        Bitmap = h
        If Handle <> 0 Then FormsSetImage(Handle, h, prev)
        If prev <> 0 And prev <> h Then DeleteObject(prev)
    End Sub
End Class

' STATIC に絵 h を渡す（prev は前に渡した絵）。戻ってきた前の絵が prev でなければ、
' コントロールが作った写し（コモンコントロール 6 は 32bit の絵を写す）なので、ここで消す
Sub FormsSetImage(hWnd As HWND, h As HBITMAP, prev As HBITMAP)
    Dim got As HBITMAP
    got = SendMessage(hWnd, STM_SETIMAGE, IMAGE_BITMAP, h As LPARAM) As HBITMAP
    If got <> 0 And got <> prev Then DeleteObject(got)
End Sub

' ファイルを開くダイアログ（GetOpenFileName）。窓を持たないので AddControl しない
Class OpenFileDialog
Public
    Filter As String            ' "説明|*.pdf|説明|*.*"（Lazarus と同じ | 区切り）
    FileName As String          ' 選んだファイルのパス（UTF-8）。初めの値はダイアログの初めのファイル名
    Title As String             ' ダイアログの見出し。"" なら Windows の既定

    ' ダイアログを出す（hOwner は持ち主の窓。フォームの中なら Handle）。選んだら True で FileName に入る
    Function Execute(hOwner As HWND) As Long
        Dim ofn As OPENFILENAME
        Dim filt(1023) As Byte
        Dim buf(FORMS_PATH_MAX) As Byte
        FormsFilter(Filter, VarPtr(filt(0)), 1024)
        FormsCopyZ(FileName, VarPtr(buf(0)), FORMS_PATH_MAX)
        FormsFillOfn(ofn, hOwner, VarPtr(filt(0)), VarPtr(buf(0)), Title)
        Execute = False
        If GetOpenFileName(ofn) = 0 Then Exit Function
        FileName = MakeStr(VarPtr(buf(0)))
        Execute = True
    End Function
End Class

' "a|b|c" を GetOpenFileName の "a NUL b NUL c NUL NUL" にして dst（n バイト）へ
Sub FormsFilter(s As String, dst As *Byte, n As Long)
    Dim i As Long, p As *Byte
    p = StrPtr(s)
    i = 0
    While i < Len(s) And i < n - 2
        dst[i] = p[i]
        If p[i] = &H7C Then dst[i] = 0
        i = i + 1
    Wend
    dst[i] = 0
    dst[i + 1] = 0
End Sub

' s を dst（n バイト）へ、末尾の 0 込みで（長すぎれば切る）
Sub FormsCopyZ(s As String, dst As *Byte, n As Long)
    Dim i As Long, p As *Byte
    p = StrPtr(s)
    i = 0
    While i < Len(s) And i < n - 1
        dst[i] = p[i]
        i = i + 1
    Wend
    dst[i] = 0
End Sub

Sub FormsFillOfn(ByRef ofn As OPENFILENAME, hOwner As HWND, filt As *Byte, buf As *Byte, title As String)
    RtlFillMemory(VarPtr(ofn), SizeOf(OPENFILENAME), 0)
    ofn.lStructSize = SizeOf(OPENFILENAME)
    ofn.hwndOwner = hOwner
    ofn.lpstrFilter = filt
    ofn.nFilterIndex = 1
    ofn.lpstrFile = buf
    ofn.nMaxFile = FORMS_PATH_MAX
    If title <> "" Then ofn.lpstrTitle = StrPtr(title)
    ofn.Flags = OFN_FILEMUSTEXIST Or OFN_PATHMUSTEXIST Or OFN_HIDEREADONLY Or OFN_EXPLORER
End Sub

' 子窓の文字を、システムの文字（DEFAULT_GUI_FONT）にする
Sub FormsSetFont(h As HWND)
    SendMessage(h, WM_SETFONT, GetStockObject(DEFAULT_GUI_FONT) As WPARAM, 0)
End Sub

Class Form
Private
    firstControl As *Control        ' AddControl で載せた部品（NextControl でつなぐ）
    lastControl As *Control
    componentsDone As Long          ' InitializeComponent を呼んだか
Public
    Left As Long
    Top As Long
    Width As Long
    Height As Long
    Caption As String
    Handle As HWND

    Sub Form()
        Left = CW_USEDEFAULT
        Top = CW_USEDEFAULT
        Width = CW_USEDEFAULT
        Height = CW_USEDEFAULT
    End Sub

    ' フォームデザイナが Override して、位置・大きさ・見出し・部品を入れる。最初の Show で 1 度だけ呼ばれる
    Virtual Sub InitializeComponent()
    End Sub

    ' まだなら InitializeComponent を呼ぶ（Show が呼ぶ。窓を出す前に値を読みたいときにも使える）
    Sub InitComponents()
        If componentsDone <> 0 Then Exit Sub
        componentsDone = 1
        InitializeComponent()
    End Sub

    ' 部品を載せる。窓がもうあれば、すぐ子窓を作る
    Sub AddControl(ByRef c As Control)
        Dim p As *Control, q As *Control
        p = VarPtr(c)
        p->NextControl = 0
        If lastControl = 0 Then
            firstControl = p
        Else
            q = lastControl
            q->NextControl = p
        End If
        lastControl = p
        If Handle <> 0 Then c.CreateHandle(Handle)
    End Sub

    ' 載せた部品の子窓を作る（WM_CREATE の前に Forms.sbp が呼ぶ）
    Sub CreateControls()
        Dim c As *Control
        c = firstControl
        While c <> 0
            c->CreateHandle(Handle)
            c = c->NextControl
        Wend
    End Sub

    ' 窓のメッセージ。既定は、窓が壊れたらメッセージループを終わらせる
    Virtual Function WndProc(msg As DWord, wParam As WPARAM, lParam As LPARAM) As LRESULT
        If msg = WM_DESTROY Then PostQuitMessage(0)
        WndProc = DefWindowProc(Handle, msg, wParam, lParam)
    End Function

    ' 窓がまだ無ければ作って、表示する
    Sub Show()
        InitComponents()
        If Handle = 0 Then CreateHandle()
        ShowWindow(Handle, SW_SHOW)
        UpdateWindow(Handle)
    End Sub

    ' 窓を閉じる（WM_CLOSE を送る。既定の WndProc が窓を壊す）
    Sub Close()
        If Handle <> 0 Then PostMessage(Handle, WM_CLOSE, 0, 0)
    End Sub

    ' 見出しを変える。窓がもうあれば窓の見出しも変える。
    ' 先に InitializeComponent を済ませる（あとで呼ばれて Caption を上書きしないように）
    Sub SetCaption(s As String)
        InitComponents()
        Caption = s
        If Handle <> 0 Then SetWindowText(Handle, StrPtr(Caption))
    End Sub

Private
    Sub CreateHandle()
        FormsRegister()
        g_formsNew = This
        CreateWindowEx(0, VarPtr(g_formsClass), StrPtr(Caption), WS_OVERLAPPEDWINDOW, Left, Top, Width, Height, 0, 0, GetModuleHandle(0), 0)
        g_formsNew = 0
    End Sub
End Class

' 窓に結びつけた Form。最初のメッセージ（CreateWindowEx の中）で、作っている Form を結びつける
Function FormsOf(hWnd As HWND) As *Form
    Dim f As *Form
    f = GetWindowLong(hWnd, GWL_USERDATA) As *Form
    If f = 0 And g_formsNew <> 0 Then
        f = g_formsNew As *Form
        f->Handle = hWnd
        SetWindowLongPtr(hWnd, GWL_USERDATA, f As LONG_PTR)
    End If
    FormsOf = f
End Function

' すべての Form の窓の WndProc。結びつけた Form の WndProc（Virtual）を呼ぶ
Function FormsWndProc(hWnd As HWND, msg As DWord, wParam As WPARAM, lParam As LPARAM) As LRESULT
    Dim f As *Form
    f = FormsOf(hWnd)
    If f = 0 Then
        FormsWndProc = DefWindowProc(hWnd, msg, wParam, lParam)
        Exit Function
    End If
    If msg = WM_CREATE Then f->CreateControls()
    FormsWndProc = f->WndProc(msg, wParam, lParam)
End Function

' Form の窓クラスを 1 度だけ登録する
Sub FormsRegister()
    If g_formsReg <> 0 Then Exit Sub
    lstrcpy(VarPtr(g_formsClass), "ActBa64Form")
    FormsFillClass()
    g_formsReg = RegisterClassEx(g_formsWc)
End Sub

Sub FormsFillClass()
    g_formsWc.cbSize = SizeOf(WNDCLASSEX)
    g_formsWc.lpfnWndProc = AddressOf(FormsWndProc)
    g_formsWc.hInstance = GetModuleHandle(0)
    g_formsWc.hCursor = LoadCursor(0, IDC_ARROW)
    g_formsWc.hbrBackground = COLOR_BTNFACE + 1
    g_formsWc.lpszClassName = VarPtr(g_formsClass)
End Sub

Class FormsApplication
Public
    ' 今は何もしない（Lazarus の Application.Initialize に合わせた入口）
    Sub Initialize()
    End Sub

    ' フォームを表示し、窓が閉じるまでメッセージを回す
    Sub Run(ByRef f As Form)
        Dim msg As MSG
        f.Show()
        While GetMessage(msg, 0, 0, 0) > 0
            TranslateMessage(msg)
            DispatchMessage(msg)
        Wend
    End Sub
End Class

Dim Application As FormsApplication

#endif
