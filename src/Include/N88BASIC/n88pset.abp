' PSET (x,y)[,color] — 指定した 1 ドットを描く
' 色省略時はパーサが 7（白）を渡す。実行後 LP はその点
' #n88basic / #N88BASIC / #prompt のときだけ n88basic.idx から入る

Sub N88_DotOn(hdc As HDC, x As Long, y As Long, pix As Long)
    If hdc = 0 Then Exit Sub
    SetPixel(hdc, x, y, pix)
End Sub

Sub N88_DotMem(x As Long, y As Long, pix As Long)
    If g_n88MemDC = 0 Then Exit Sub
    N88_DotOn(g_n88MemDC, x, y, pix)
End Sub

Sub N88_DotWnd(x As Long, y As Long, pix As Long)
    Dim hdc As HDC
    hdc = GetDC(g_n88Hwnd)
    N88_DotOn(hdc, x, y, pix)
    ReleaseDC(g_n88Hwnd, hdc)
End Sub

Sub N88_DotLp(x As Long, y As Long)
    g_n88LPx = x
    g_n88LPy = y
End Sub

Sub N88_PSetDraw(x As Long, y As Long, color As Long)
    Dim pix As Long
    If g_n88Hwnd = 0 Then Exit Sub
    pix = N88_Rgb(color)
    N88_DotMem(x, y, pix)
    N88_DotWnd(x, y, pix)
End Sub

Sub PSet(x As Long, y As Long, color As Long)
    N88_EnsureWindow()
    N88_PSetDraw(x, y, color)
    N88_DotLp(x, y)
End Sub
