' --- split from n88graph.abp (part 2) ---
Sub Circle(cx As Long, cy As Long, r As Long, color As Long, startAng As Double, endAng As Double, aspect As Double, flags As Long, fillColor As Long)
    Dim hdc As HDC
    Dim x As Long
    Dim y As Long

    N88_EnsureWindow()
    If g_n88Hwnd = 0 Then Exit Sub

    x = cx
    y = cy
    If (flags And 16) <> 0 Then
        x = g_n88LPx
        y = g_n88LPy
    ElseIf (flags And 8) <> 0 Then
        x = g_n88LPx + cx
        y = g_n88LPy + cy
    End If

    If g_n88MemDC <> 0 Then
        N88_DrawCircleOn(g_n88MemDC, x, y, r, color, startAng, endAng, aspect, flags, fillColor)
    End If
    hdc = GetDC(g_n88Hwnd)
    N88_DrawCircleOn(hdc, x, y, r, color, startAng, endAng, aspect, flags, fillColor)
    ReleaseDC(g_n88Hwnd, hdc)

    g_n88LPx = x
    g_n88LPy = y
End Sub

Sub N88_Run()
    Dim msg As MSG
    Dim r As Long

    N88_EnsureWindow()
    Do
        r = GetMessageA(VarPtr(msg), 0, 0, 0)
        If r = 0 Then Exit Do
        If r = -1 Then Exit Do
        TranslateMessage(VarPtr(msg))
        DispatchMessageA(VarPtr(msg))
    Loop
End Sub

Sub N88_End()
    N88_Run()
    ExitProcess(0)
End Sub

Sub Locate(x As Long, y As Long)
    N88_EnsureWindow()
    g_n88CurX = x
    g_n88CurY = y
End Sub

Sub N88_TextOutOn(hdc As HDC, s As *Byte)
    Dim px As Long
    Dim py As Long
    Dim n As Long
    Dim old As HANDLE
    If hdc = 0 Then Exit Sub
    If s = 0 Then Exit Sub
    old = 0
    If g_n88Font <> 0 Then
        old = SelectObject(hdc, g_n88Font)
    End If
    px = g_n88CurX * N88_CHAR_W
    py = g_n88CurY * N88_CHAR_H
    n = lstrlen(s)
    SetBkMode(hdc, N88_TRANSPARENT)
    SetTextColor(hdc, N88_Rgb(7))
    TextOutA(hdc, px, py, s, n)
    If old <> 0 Then
        SelectObject(hdc, old)
    End If
End Sub

Sub N88_PutText(s As *Byte)
    Dim hdc As HDC

    N88_EnsureWindow()
    If g_n88Hwnd = 0 Then Exit Sub
    If g_n88MemDC <> 0 Then
        N88_TextOutOn(g_n88MemDC, s)
    End If
    hdc = GetDC(g_n88Hwnd)
    N88_TextOutOn(hdc, s)
    ReleaseDC(g_n88Hwnd, hdc)
End Sub

' #n88basic 時の Print → 窓へ描画し、次行へ
Sub N88_Print(s As *Byte)
    N88_PutText(s)
    g_n88CurY = g_n88CurY + 1
End Sub

Sub N88_PrintStay(s As *Byte)
    N88_PutText(s)
End Sub

Sub N88_FloodOn(hdc As HDC, x As Long, y As Long, fillRgb As Long, borderRgb As Long)
    Dim brush As HBRUSH
    Dim old As HANDLE
    If hdc = 0 Then Exit Sub
    brush = CreateSolidBrush(fillRgb)
    If brush = 0 Then Exit Sub
    old = SelectObject(hdc, brush)
    ExtFloodFill(hdc, x, y, borderRgb, N88_FLOODFILLBORDER)
    SelectObject(hdc, old)
    DeleteObject(brush)
End Sub

' PAINT (x,y), color1 [, color2] — color1=塗り, color2=境界（省略時 color1）
Sub Paint(x As Long, y As Long, color1 As Long, color2 As Long)
    Dim hdc As HDC
    Dim fr As Long
    Dim br As Long

    N88_EnsureWindow()
    If g_n88Hwnd = 0 Then Exit Sub
    fr = N88_Rgb(color1)
    br = N88_Rgb(color2)
    If g_n88MemDC <> 0 Then
        N88_FloodOn(g_n88MemDC, x, y, fr, br)
    End If
    hdc = GetDC(g_n88Hwnd)
    N88_FloodOn(hdc, x, y, fr, br)
    ReleaseDC(g_n88Hwnd, hdc)
    g_n88LPx = x
    g_n88LPy = y
End Sub
