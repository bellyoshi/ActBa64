' SCREEN / CLS — -pN88 では N88-BASIC の命令がこの Sub の呼び出しになる
' PRINT の , と数値の整形もここ
'   SCREEN mode  — 画面モードを覚える。窓は 640x480 固定
'   CLS mode     — 1 文字 / 2 図形 / 3 両方。文字と図形は同じ面なので、どれでも全体を消す

Dim g_n88Screen As Long

Sub Screen(i As Long)
    N88_EnsureWindow()
    g_n88Screen = i
End Sub

Sub N88_ClearWindow()
    Dim hdc As HDC
    If g_n88MemDC <> 0 Then N88_ClearSurface(g_n88MemDC)
    hdc = GetDC(g_n88Hwnd)
    N88_ClearSurface(hdc)
    ReleaseDC(g_n88Hwnd, hdc)
End Sub

Sub Cls(mode As Long)
    N88_EnsureWindow()
    If g_n88Hwnd = 0 Then Exit Sub
    N88_Lock()
    N88_ClearWindow()
    N88_Unlock()
    If mode <> 2 Then g_n88CurX = 0
    If mode <> 2 Then g_n88CurY = 0
End Sub

' PRINT の , → 次の 14 桁の区切りへ（改行しない）
Const N88_TAB_ZONE = 14

Function N88_IsTab(s As *Byte) As Long
    N88_IsTab = 0
    If s = 0 Then Exit Function
    If s[0] = 9 And s[1] = 0 Then N88_IsTab = 1
End Function

Sub N88_TabZone()
    g_n88CurX = g_n88CurX - (g_n88CurX Mod N88_TAB_ZONE) + N88_TAB_ZONE
End Sub

' -pN88 の数値の PRINT。正の数は先頭に符号の空白、どの数も後ろに空白 1 つ
Function N88_NumStr$(s As String) As String
    Dim t As String
    t = s
    If Left$(t, 1) = " " Then t = Mid$(t, 2)
    If Left$(t, 1) <> "-" Then t = " " + t
    N88_NumStr$ = t + " "
End Function
