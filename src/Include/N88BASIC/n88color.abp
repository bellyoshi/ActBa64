' COLOR textcolor [, backcolor] — プロンプト（N88 窓）の文字色
' 第2引数を省略した呼び出しは COLOR_OMIT（パーサが -2 を渡す。背景は変えない）
' backcolor が -1 のときは背景を透明にする
' カラーコード: 0黒 1青 2赤 3紫 4緑 5水色 6黄 7白

Const COLOR_OMIT = -2
Const COLOR_BK_TRANS = 1
Const COLOR_BK_OPAQUE = 2

Dim g_n88TextCol As Long
Dim g_n88BackCol As Long
Dim g_n88ColorOn As Long

Function ColorBlack() As Long
    ColorBlack = 0
End Function

Function ColorBlue() As Long
    ColorBlue = 1
End Function

Function ColorRed() As Long
    ColorRed = 2
End Function

Function ColorPurple() As Long
    ColorPurple = 3
End Function

Function ColorGreen() As Long
    ColorGreen = 4
End Function

Function ColorLightBlue() As Long
    ColorLightBlue = 5
End Function

Function ColorYellow() As Long
    ColorYellow = 6
End Function

Function ColorWhite() As Long
    ColorWhite = 7
End Function

Function ColorCodeLo(code As Long) As Long
    ColorCodeLo = &HFF00FF
    If code = ColorBlack() Then ColorCodeLo = 0
    If code = ColorBlue() Then ColorCodeLo = &HFF0000
    If code = ColorRed() Then ColorCodeLo = &H0000FF
End Function

Function ColorCodeHi(code As Long) As Long
    ColorCodeHi = &HFFFFFF
    If code = ColorGreen() Then ColorCodeHi = &H00FF00
    If code = ColorLightBlue() Then ColorCodeHi = &HFFFF00
    If code = ColorYellow() Then ColorCodeHi = &H00FFFF
End Function

Function ColorCode(code As Long) As Long
    Dim c As Long
    c = code And 7
    If c < 4 Then
        ColorCode = ColorCodeLo(c)
    Else
        ColorCode = ColorCodeHi(c)
    End If
End Function

Sub N88_InitColor()
    If g_n88ColorOn <> 0 Then Exit Sub
    g_n88TextCol = ColorWhite()
    g_n88BackCol = -1
    g_n88ColorOn = 1
End Sub

Sub Color(textcolor As Long, backcolor As Long)
    N88_InitColor()
    g_n88TextCol = textcolor
    If backcolor = COLOR_OMIT Then Exit Sub
    g_n88BackCol = backcolor
End Sub

Sub N88_ApplyTextFg(hdc As HDC)
    N88_InitColor()
    SetTextColor(hdc, ColorCode(g_n88TextCol))
End Sub

Sub N88_ApplyTextBg(hdc As HDC)
    If g_n88BackCol < 0 Then
        SetBkMode(hdc, COLOR_BK_TRANS)
        Exit Sub
    End If
    SetBkMode(hdc, COLOR_BK_OPAQUE)
    SetBkColor(hdc, ColorCode(g_n88BackCol))
End Sub

Sub N88_ApplyTextColor(hdc As HDC)
    N88_ApplyTextFg(hdc)
    N88_ApplyTextBg(hdc)
End Sub
