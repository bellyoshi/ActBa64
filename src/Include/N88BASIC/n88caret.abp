' n88caret - Input の入力中、入力位置に点滅するカーソル（キャレット）を出す。
'   キャレットは窓の UI スレッドのものなので、ほかのスレッドからは N88_WM_CARET を送る（wParam 1 = 出す、0 = 消す）。
'   文字を窓に描くときは、いったん隠してから描き、描いた後の位置に出し直す。

Const N88_WM_CARET = &H8088

Dim g_n88CaretOn As Long

' どのスレッドからでも呼べる
Sub N88_CaretRequest(onOff As Long)
    If g_n88Hwnd = 0 Then Exit Sub
    PostMessage(g_n88Hwnd, N88_WM_CARET, onOff, 0)
End Sub

' ---- ここから UI スレッド ----

Sub N88_CaretPlace()
    SetCaretPos(g_n88CurX * N88_CHAR_W, g_n88CurY * N88_CHAR_H)
End Sub

Sub N88_CaretShow()
    If g_n88CaretOn <> 0 Then Exit Sub
    If CreateCaret(g_n88Hwnd, 0, N88_CHAR_W, N88_CHAR_H) = 0 Then Exit Sub
    N88_CaretPlace()
    ShowCaret(g_n88Hwnd)
    g_n88CaretOn = 1
End Sub

Sub N88_CaretHide()
    If g_n88CaretOn = 0 Then Exit Sub
    DestroyCaret()
    g_n88CaretOn = 0
End Sub

' 窓へ文字を描く前
Sub N88_CaretBeforeDraw()
    If g_n88CaretOn <> 0 Then HideCaret(g_n88Hwnd)
End Sub

' 窓へ文字を描いた後。新しい入力位置に出し直す
Sub N88_CaretAfterDraw()
    If g_n88CaretOn = 0 Then Exit Sub
    N88_CaretPlace()
    ShowCaret(g_n88Hwnd)
End Sub

' N88_WM_CARET なら処理して 1
Function N88_CaretMsg(message As DWord, wParam As WPARAM) As Long
    N88_CaretMsg = 0
    If message <> N88_WM_CARET Then Exit Function
    If wParam <> 0 Then N88_CaretShow()
    If wParam = 0 Then N88_CaretHide()
    N88_CaretMsg = 1
End Function
