' Inkey$ / Input$ — #n88basic / #prompt のときだけ入る
' 窓の WM_KEYDOWN を 1 文字として扱う（AB Prompt と同じ）

Function N88_PumpKey() As Long
    Dim msg As MSG
    N88_PumpKey = PeekMessageA(VarPtr(msg), 0, 0, 0, PM_REMOVE)
    If N88_PumpKey = 0 Then Exit Function
    TranslateMessage(VarPtr(msg))
    DispatchMessageA(VarPtr(msg))
End Function

Sub N88_Drain()
    While N88_PumpKey() <> 0
    Wend
End Sub

Function Inkey$() As String
    N88_EnsureWindow()
    N88_Drain()
    If g_n88Key = 0 Then Exit Function
    Inkey$ = Chr$(g_n88Key)
    g_n88Key = 0
End Function

Function N88_InputStep$(s As String, ByRef i As Long) As String
    N88_InputStep$ = s
    N88_PumpKey()
    If g_n88Key = 0 Then Sleep(1)
    If g_n88Key = 0 Then Exit Function
    N88_InputStep$ = s + Chr$(g_n88Key)
    g_n88Key = 0
    i = i + 1
End Function

Function N88_InputLoop$(n As Long) As String
    Dim s As String
    Dim i As Long
    s = ""
    While i < n
        s = N88_InputStep$(s, i)
    Wend
    N88_InputLoop$ = s
End Function

Function Input$(length As Long) As String
    N88_EnsureWindow()
    If length <= 0 Then Exit Function
    Input$ = N88_InputLoop$(length)
End Function
