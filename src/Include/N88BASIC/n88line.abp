' N88 Input の 1 行。Win32 には触れない。
' Enter（CR/LF）で完成。Backspace は 1 文字消す。

Const N88_LINE_CAP = 255
Const N88_CH_BS = 8
Const N88_CH_CR = 13
Const N88_CH_LF = 10

Dim g_n88Line(255) As Byte
Dim g_n88LineLen As Long
Dim g_n88LineDone As Long

Sub N88_LineReset()
    g_n88LineLen = 0
    g_n88LineDone = 0
    g_n88Line[0] = 0
End Sub

Function N88_LineDone() As Long
    N88_LineDone = g_n88LineDone
End Function

Function N88_LineEnter() As Long
    g_n88LineDone = 1
    g_n88Line[g_n88LineLen] = 0
    N88_LineEnter = 1
End Function

Function N88_LineBack() As Long
    N88_LineBack = 0
    If g_n88LineDone <> 0 Then Exit Function
    If g_n88LineLen <= 0 Then Exit Function
    g_n88LineLen = g_n88LineLen - 1
    g_n88Line[g_n88LineLen] = 0
    N88_LineBack = 1
End Function

Function N88_LineAdd(ch As Long) As Long
    N88_LineAdd = 0
    If g_n88LineDone <> 0 Then Exit Function
    If g_n88LineLen >= N88_LINE_CAP Then Exit Function
    g_n88Line[g_n88LineLen] = ch
    g_n88LineLen = g_n88LineLen + 1
    g_n88Line[g_n88LineLen] = 0
    N88_LineAdd = 1
End Function

Function N88_LinePush(ch As Long) As Long
    Dim n As Long
    N88_LinePush = 0
    If ch = N88_CH_CR Or ch = N88_CH_LF Then N88_LinePush = N88_LineEnter()
    If ch = N88_CH_BS Then n = N88_LineBack()
    If ch >= 32 Then n = N88_LineAdd(ch)
End Function

Function N88_LineText$() As String
    N88_LineText$ = MakeStr(VarPtr(g_n88Line))
End Function
