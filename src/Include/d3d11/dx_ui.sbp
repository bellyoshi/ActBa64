' dx_ui.sbp - D3D サンプル共通（キーボード / UTF-8 テキスト）
' VK_ADD / VK_SUBTRACT / CP_UTF8 等は AB4.20・WinConsts 側の定義を使う（ここでは再定義しない）。

Function dx_KeyDown(vk As Long) As Long
	Dim st As Long
	st = GetAsyncKeyState(vk)
	If (st And &H8000) <> 0 Then
		dx_KeyDown = 1
	Else
		dx_KeyDown = 0
	End If
End Function

' UTF-8 String → UTF-16（スタックバッファ）。戻り値は文字数。
Function dx_Utf8ToWide(s As String, wideBuf As VoidPtr, maxChars As Long) As Long
	Dim n As Long
	Dim chars As Long
	dx_Utf8ToWide = 0
	n = Len(s)
	If n <= 0 Then Exit Function
	chars = MultiByteToWideChar(CP_UTF8, 0, StrPtr(s), n, 0, 0)
	If chars <= 0 Then Exit Function
	If chars > maxChars Then chars = maxChars
	MultiByteToWideChar(CP_UTF8, 0, StrPtr(s), n, wideBuf, chars)
	dx_Utf8ToWide = chars
End Function

Sub dx_TextOutUtf8(hdc As HDC, x As Long, y As Long, s As String)
	Dim wide[511] As Byte
	Dim chars As Long
	chars = dx_Utf8ToWide(s, VarPtr(wide[0]), 255)
	If chars > 0 Then TextOutW(hdc, x, y, VarPtr(wide[0]), chars)
End Sub
