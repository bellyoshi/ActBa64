Const TV_FIRST = &H1100             'TreeView messages

Const TVM_INSERTITEM  = TV_FIRST + 0

Function TreeView_InsertItem(hWnd As HWND, ByRef ref_is As TV_INSERTSTRUCT) As BytePtr
TreeView_InsertItem=SendMessage(hWnd,TVM_INSERTITEM,0,VarPtr(ref_is))
End Function

Const TVM_DELETEITEM  = TV_FIRST + 1

Function TreeView_DeleteItem(hWnd As HWND, hitem As HTREEITEM) As BOOL
TreeView_DeleteItem=SendMessage(hWnd,TVM_DELETEITEM,0,hitem)
End Function
