' ダイアログ項目

Const IDOK =              1

Const IDCANCEL =          2

Const IDABORT =           3

Const IDRETRY =           4

Const IDIGNORE =          5

Const IDCLOSE =           8

Const IDHELP =            9

Declare Function GetDlgCtrlID Lib "user32.dll" (hWnd As HWND) As Long

Declare Function GetDlgItemText Lib "user32.dll" Alias "GetDlgItemTextA" (hDlg As HWND, nIDDlgItem As Long, lpString As BytePtr, nMaxCount As Long) As Long

Declare Function SendDlgItemMessage Lib "user32.dll" Alias "SendDlgItemMessageA" (hDlg As HWND, nIDDlgItem As Long, Msg As DWord, wParam As WPARAM, lParam As LPARAM) As LRESULT

Declare Function SetDlgItemText Lib "user32.dll" Alias "SetDlgItemTextA" (hDlg As HWND, nIDDlgItem As Long, lpString As BytePtr) As Long

