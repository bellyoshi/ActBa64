' カーネル共通の構造体

Type LARGE_INTEGER
    LowPart As DWord
    HighPart As Long
End Type

Type ULARGE_INTEGER
    LowPart As DWord
    HighPart As DWord
End Type

Type GUID
    Data1 As DWord
    Data2 As Word
    Data3 As Word
    Data4(7) As Byte
End Type

Type OVERLAPPED
    Internal As VoidPtr
    InternalHigh As VoidPtr
    Offset As Long
    OffsetHigh As Long
    hEvent As HANDLE
End Type

Type FILETIME
    dwLowDateTime As Long
    dwHighDateTime As Long
End Type

Type SYSTEMTIME
    wYear As Word
    wMonth As Word
    wDayOfWeek As Word
    wDay As Word
    wHour As Word
    wMinute As Word
    wSecond As Word
    wMilliseconds As Word
End Type

Type CRITICAL_SECTION
    DebugInfo As VoidPtr
    LockCount As Long
    RecursionCount As Long
    OwningThread As VoidPtr
    LockSemaphore As VoidPtr
    SpinCount As VoidPtr
End Type

TypeDef LPTHREAD_START_ROUTINE = *Function(lpThreadParameter As VoidPtr) As DWord

Type WIN32_FIND_DATA
    dwFileAttributes As Long
    ftCreationTime As FILETIME
    ftLastAccessTime As FILETIME
    ftLastWriteTime As FILETIME
    nFileSizeHigh As Long
    nFileSizeLow As Long
    dwReserved0 As Long
    dwReserved1 As Long
    cFileName(259) As Byte
    cAlternateFileName(13) As Byte
End Type

TypeDef LPWIN32_FIND_DATA = *WIN32_FIND_DATA

Type SYSTEM_INFO
    dwOemId As Long
    dwPageSize As Long
    lpMinimumApplicationAddress As VoidPtr
    lpMaximumApplicationAddress As VoidPtr
    dwActiveProcessorMask As ULONG_PTR
    dwNumberOfProcessors As Long
    dwProcessorType As Long
    dwAllocationGranularity As Long
    wProcessorLevel As Integer
    wProcessorRevision As Integer
End Type

Type OSVERSIONINFO
    dwOSVersionInfoSize As DWord
    dwMajorVersion As DWord
    dwMinorVersion As DWord
    dwBuildNumber As DWord
    dwPlatformId As DWord
    szCSDVersion(127) As Byte
End Type

Type MEMORYSTATUS
    dwLength As DWord
    dwMemoryLoad As DWord
    dwTotalPhys As SIZE_T
    dwAvailPhys As SIZE_T
    dwTotalPageFile As SIZE_T
    dwAvailPageFile As SIZE_T
    dwTotalVirtual As SIZE_T
    dwAvailVirtual As SIZE_T
End Type

