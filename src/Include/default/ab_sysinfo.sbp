' システムディレクトリとバージョン

Const MAX_COMPUTERNAME_LENGTH=15

Declare Function GetComputerNameA Lib "kernel32.dll" (lpBuffer As BytePtr, ByRef nSize As Long) As Long

Declare Function GetSystemDirectoryA Lib "kernel32.dll" (lpBuffer As BytePtr, uSize As DWord) As DWord

Declare Sub GetSystemInfo Lib "kernel32.dll" (ByRef lpSystemInfo As SYSTEM_INFO)

Declare Function GetUserNameA Lib "advapi32.dll" (lpBuffer As BytePtr, ByRef nSize As Long) As Long

Const VER_PLATFORM_WIN32s        = 0

Const VER_PLATFORM_WIN32_WINDOWS = 1

Const VER_PLATFORM_WIN32_NT      = 2

Declare Function GetVersionEx Lib "kernel32.dll" Alias "GetVersionExA" (ByRef lpVersionInformation As OSVERSIONINFO) As Long

Declare Function GetWindowsDirectoryA Lib "kernel32.dll" (lpBuffer As BytePtr, uSize As DWord) As DWord

Declare Function SetComputerNameA Lib "kernel32.dll" (lpComputerName As BytePtr) As Long

Declare Function SetLocalTime Lib "kernel32.dll" (ByRef lpSystemTime As SYSTEMTIME) As Long

