' システムディレクトリとバージョン

Const MAX_COMPUTERNAME_LENGTH=15

Declare Function GetComputerName Lib "kernel32.dll" Alias "GetComputerNameA" (lpBuffer As BytePtr, ByRef nSize As Long) As Long

Declare Function GetSystemDirectory Lib "kernel32.dll" Alias "GetSystemDirectoryA" (lpBuffer As BytePtr, uSize As DWord) As DWord

Declare Sub GetSystemInfo Lib "kernel32.dll" (ByRef lpSystemInfo As SYSTEM_INFO)

Declare Function GetUserName Lib "advapi32.dll" Alias "GetUserNameA" (lpBuffer As BytePtr, ByRef nSize As Long) As Long

Const VER_PLATFORM_WIN32s        = 0

Const VER_PLATFORM_WIN32_WINDOWS = 1

Const VER_PLATFORM_WIN32_NT      = 2

Declare Function GetVersionEx Lib "kernel32.dll" Alias "GetVersionExA" (ByRef lpVersionInformation As OSVERSIONINFO) As Long

Declare Function GetWindowsDirectory Lib "kernel32.dll" Alias "GetWindowsDirectoryA" (lpBuffer As BytePtr, uSize As DWord) As DWord

Declare Function SetComputerName Lib "kernel32.dll" Alias "SetComputerNameA" (lpComputerName As BytePtr) As Long

Declare Function SetLocalTime Lib "kernel32.dll" (ByRef lpSystemTime As SYSTEMTIME) As Long

