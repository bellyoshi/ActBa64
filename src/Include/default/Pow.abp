' Pow.abp — 累乗と C 互換 rand（default 常時読込）
' ldexp / frexp / ipow / pow。rand / srand は Rnd とは別の種。

Function PowScale(x As Double, w As Double, k As Long) As Double
    While k <> 0
        If (k And 1) <> 0 Then x = x * w
        w = w * w
        k = k \ 2
    Wend
    PowScale = x
End Function

Function ldexp(x As Double, k As Long) As Double
    Dim w As Double
    Dim a As Long
    w = 2
    a = k
    If k < 0 Then w = 0.5
    If k < 0 Then a = 0 - k
    ldexp = PowScale(x, w, a)
End Function

Function ipow(x As Double, n As Long) As Double
    Dim k As Long
    Dim r As Double
    k = Abs(n)
    r = PowScale(1, x, k)
    ipow = r
    If n < 0 Then ipow = 1 / r
End Function

Function FrexpShrink(x As Double, ByRef n As Long) As Double
    While Abs(x) >= 1
        x = x / 2
        n = n + 1
    Wend
    FrexpShrink = x
End Function

Function FrexpGrow(x As Double, ByRef n As Long) As Double
    While x <> 0 And Abs(x) < 0.5
        x = x * 2
        n = n - 1
    Wend
    FrexpGrow = x
End Function

Function frexp(x As Double, ByRef n As Long) As Double
    Dim m As Double
    n = 0
    frexp = 0
    If x = 0 Then Exit Function
    m = FrexpShrink(x, n)
    frexp = FrexpGrow(m, n)
End Function

Function PowIy(y As Double) As Long
    PowIy = 0
    If y > 2147483647 Or y < 0 - 2147483647 Then Exit Function
    PowIy = y
End Function

Function PowIsInt(y As Double, iy As Long) As Long
    Dim t As Double
    PowIsInt = 0
    If y > 2147483647 Or y < 0 - 2147483647 Then Exit Function
    t = iy
    If y = t Then PowIsInt = 1
End Function

Function PowExp(x As Double, y As Double) As Double
    Dim t As Double
    PowExp = 0
    If x <= 0 Then Exit Function
    t = Log(x)
    PowExp = Exp(y * t)
End Function

Function pow(x As Double, y As Double) As Double
    Dim iy As Long
    iy = PowIy(y)
    If PowIsInt(y, iy) <> 0 Then
        pow = ipow(x, iy)
        Exit Function
    End If
    pow = PowExp(x, y)
End Function

Dim g_randNext As Long

Function rand() As DWord
    g_randNext = g_randNext * 1103515245 + 12345
    rand = (g_randNext >> 16) And 32767
End Function

Sub srand(dwSeek As DWord)
    g_randNext = dwSeek
End Sub
