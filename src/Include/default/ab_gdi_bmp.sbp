' ビットマップ

Type RGBQUAD
    rgbBlue As Byte
    rgbGreen As Byte
    rgbRed As Byte
    rgbReserved As Byte
End Type

Type BITMAP
    bmType As Long
    bmWidth As Long
    bmHeight As Long
    bmWidthBytes As Long
    bmPlanes As Integer
    bmBitsPixel As Integer
    bmBits As Long
End Type

Type BITMAPINFOHEADER
    biSize As Long
    biWidth As Long
    biHeight As Long
    biPlanes As Integer
    biBitCount As Integer
    biCompression As Long
    biSizeImage As Long
    biXPelsPerMeter As Long
    biYPelsPerMeter As Long
    biClrUsed As Long
    biClrImportant As Long
End Type

Type BITMAPINFO
    bmiHeader As BITMAPINFOHEADER
    bmpColors(255) As RGBQUAD
End Type

Type BITMAPFILEHEADER Align(2)
    bfType As Integer
    bfSize As Long
    bfReserved1 As Integer
    bfReserved2 As Integer
    bfOffBits As Long
End Type

Type PALETTEENTRY
    peRed As Byte
    peGreen As Byte
    peBlue As Byte
    peFlags As Byte
End Type

Const BI_RGB =       0

Const BI_RLE8 =      1

Const BI_RLE4 =      2

Const BI_BITFIELDS = 3

Const BI_JPEG =      4

Const BI_PNG =       5

Declare Function CreateBitmap Lib "gdi32.dll" (nWidth As Long, nHeight As Long, cPlanes As Long, cBitsPerPel As Long, lpvBits As VoidPtr) As HBITMAP

Declare Function CreateBitmapIndirect Lib "gdi32.dll" (ByRef lpbm As BITMAP) As HBITMAP

Const DIB_RGB_COLORS =    0

Const DIB_PAL_COLORS =    1

Const CBM_INIT = &H04

Declare Function CreateDIBitmap Lib "gdi32.dll" (hdc As HDC, ByRef lpbmih As BITMAPINFOHEADER, fdwInit As Long, lpbInit As VoidPtr, ByRef lpbmi As BITMAPINFO, fuUsage As Long) As HBITMAP

Declare Function GetBitmapBits Lib "gdi32.dll" (hbmp As HBITMAP, cbBuffer As Long, lpvBits As VoidPtr) As Long

Declare Function GetDIBits Lib "gdi32.dll" (hdc As HDC, hbmp As HBITMAP, uStartScan As DWord, cScanLines As DWord, lpvBits As VoidPtr, ByRef lpbi As BITMAPINFO, uUsage As DWord) As Long

Declare Function SetDIBits Lib "gdi32.dll" (hdc As HDC, hbmp As HBITMAP, uStartScan As DWord, cScanLines As DWord, lpvBits As VoidPtr, ByRef lpbmi As BITMAPINFO, fuColorUse As DWord) As Long

