' Sleep — 常時利用（#n88basic 不要）
' 待ち時間中も PeekMessage / DispatchMessage でウインドウを処理する
' 呼び出し: Sleep(100)

Const SLEEP_PM_REMOVE = 1
Const SLEEP_QS_ALLINPUT = &H04FF

' ms ミリ秒待つ。GUI があっても固まらない
' GetTickCount は DWORD。差分は 32bit ラップで正しいが、符号付き比較だと
' 経過 >= 2^31ms で負に見える。その場合は十分待ったとみなす
Sub Sleep(ms As Long)
    Dim start As DWord
    Dim now As DWord
    Dim elapsed As Long
    Dim left As Long
    Dim msg As MSG
    Dim r As Long

    If ms <= 0 Then Exit Sub
    start = GetTickCount()
    Do
        now = GetTickCount()
        elapsed = now - start
        If elapsed < 0 Then Exit Do
        If elapsed >= ms Then Exit Do
        left = ms - elapsed

        r = MsgWaitForMultipleObjects(0, 0, 0, left, SLEEP_QS_ALLINPUT)

        Do
            If PeekMessageA(VarPtr(msg), 0, 0, 0, SLEEP_PM_REMOVE) = 0 Then Exit Do
            If msg.message = WM_QUIT Then
                PostQuitMessage(0)
                Exit Sub
            End If
            TranslateMessage(VarPtr(msg))
            DispatchMessageA(VarPtr(msg))
        Loop
    Loop
End Sub
