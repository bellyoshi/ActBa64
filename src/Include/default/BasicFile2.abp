' --- split from BasicFile.abp (part 2) ---
Function BaFileLof(num As Long) As Long
    Dim h As Long
    Dim fsiz As Long
    Dim flen As Long
    BaFileLof = 0
    If BaFileValidNum(num) = 0 Then Exit Function
    If g_baOpen(num) = 0 Then Exit Function
    h = g_baH(num)
    If h = 0 Then
        BaFileLof = Len(g_baBuf(num))
        Exit Function
    End If
    If h = INVALID_HANDLE_VALUE Then Exit Function
    fsiz = GetFileSize(h, 0)
    If fsiz < 0 Then Exit Function
    flen = g_baField(num)
    If flen > 0 Then
        BaFileLof = fsiz \ flen
    Else
        BaFileLof = fsiz
    End If
End Function

Function Eof(num As Long) As Long
    Eof = BaFileEof(num)
End Function

Function Loc(num As Long) As Long
    Loc = BaFileLoc(num)
End Function

Function Lof(num As Long) As Long
    Lof = BaFileLof(num)
End Function

Sub BaFileWriteSp(num As Long)
    BaFileWriteRaw(num, " ")
End Sub

Sub BaFileWriteNl(num As Long)
    Dim buf(3) As Byte
    Dim h As Long
    Dim nWritten As Long
    Dim std As Long

    buf[0] = 13
    buf[1] = 10
    buf[2] = 0
    If num = 0 Then
        std = GetStdHandle(&HFFFFFFF5)
        WriteFile(std, VarPtr(buf), 2, VarPtr(nWritten), 0)
        Exit Sub
    End If
    If BaFileValidNum(num) = 0 Then Exit Sub
    If g_baOpen(num) = 0 Then Exit Sub
    h = g_baH(num)
    If h = 0 Then Exit Sub
    If h = INVALID_HANDLE_VALUE Then Exit Sub
    WriteFile(h, VarPtr(buf), 2, VarPtr(nWritten), 0)
End Sub
