' objbase.sbp から ActBa64 に無かった宣言。64bit の並びへ合わせ、既存の同名は残している

Type STATSTG
    pwcsName As BytePtr
    dwType As DWord
    cbSize As ULARGE_INTEGER
    ntime As FILETIME
    ctime As FILETIME
    atime As FILETIME
    grfMode As DWord
    grfLocksSupported As DWord
    clsid As GUID
    grfStateBits As DWord
    reserved As DWord
End Type

Const CLSCTX_INPROC_SERVER     = &H01

Const CLSCTX_INPROC_HANDLER    = &H02

Const CLSCTX_LOCAL_SERVER      = &H4

Const CLSCTX_INPROC_SERVER16   = &H8

Const CLSCTX_REMOTE_SERVER     = &H10

Const CLSCTX_INPROC_HANDLER16  = &H20

Const CLSCTX_INPROC_SERVERX86  = &H40

Const CLSCTX_INPROC_HANDLERX86 = &H80

Const CLSCTX_ESERVER_HANDLER   = &H100

Const CLSCTX_INPROC = CLSCTX_INPROC_SERVER or CLSCTX_INPROC_HANDLER

Const CLSCTX_ALL    = CLSCTX_INPROC_SERVER or CLSCTX_INPROC_HANDLER or CLSCTX_LOCAL_SERVER or CLSCTX_REMOTE_SERVER

Const CLSCTX_SERVER = CLSCTX_INPROC_SERVER or CLSCTX_LOCAL_SERVER or CLSCTX_REMOTE_SERVER

Declare Function CoCreateInstance Lib "ole32.dll" (ByRef CLSID As GUID, lpUnknown As Long, dwClsContext As Long, ByRef REFIID As GUID, pObj As VoidPtr) As DWord

Declare Function CoInitialize Lib "ole32.dll" (pvReserved As VoidPtr) As DWord

Declare Sub CoUninitialize Lib "ole32.dll" ()
