' デバイスコンテキストの作成と保存

Declare Function CancelDC Lib "gdi32.dll" (hdc As HDC) As Long

Declare Function CreateDC Lib "gdi32.dll" Alias "CreateDCA" (lpszDriver As BytePtr, lpszDevice As BytePtr, lpszOutput As Long, ByRef lpInitData As DEVMODE) As HDC

Declare Function GetCurrentPositionEx Lib "gdi32.dll" (hdc As HDC, ByRef lpPoint As POINTAPI) As Long

Declare Function ResetDC Lib "gdi32.dll" Alias "ResetDCA" (hdc As HDC, ByRef lpInitData As DEVMODE) As HDC

Declare Function RestoreDC Lib "gdi32.dll" (hdc As HDC, nSavedDC As Long) As Long

Declare Function SaveDC Lib "gdi32.dll" (hdc As HDC) As Long

