Const TVN_BEGINRDRAG =        TVN_FIRST-8

Const TVN_DELETEITEM =        TVN_FIRST-9

Const TVN_BEGINLABELEDIT =    TVN_FIRST-10

Const TVN_ENDLABELEDIT =      TVN_FIRST-11

