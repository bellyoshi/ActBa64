Declare Function CheckMenuRadioItem Lib "user32.dll" (hMenu As HMENU, idFirst As DWord, idLast As DWord, idCheck As DWord, uFlags As DWord) As Long

Declare Function DeleteMenu Lib "user32.dll" (hMenu As HMENU, uPosition As DWord, uFlags As DWord) As Long

Declare Function DrawMenuBar Lib "user32.dll" (hMenu As HMENU) As Long

Declare Function EnableMenuItem Lib "user32.dll" (hMenu As HMENU, uIDEnableItem As DWord, uEnable As DWord) As DWord

Declare Function GetMenu Lib "user32.dll" (hWnd As HWND) As HMENU

Const GMDI_USEDISABLED  = &H0001

Const GMDI_GOINTOPOPUPS = &H0002

Declare Function GetMenuDefaultItem Lib "user32.dll" (hMenu As HMENU, fByPos As DWord, gmdiFlags As DWord) As DWord

Declare Function GetMenuItemInfo Lib "user32.dll" Alias "GetMenuItemInfoA" (hMenu As HMENU, uItem As DWord, fByPosition As DWord, ByRef lpmii As MENUITEMINFO) As Long

Declare Function GetSubMenu Lib "user32.dll" (hMenu As HMENU, nPos As Long) As HMENU

Declare Function GetSystemMenu Lib "user32.dll" (hWnd As HWND, bRevert As Long) As HMENU

Declare Function InsertMenuItem Lib "user32.dll" Alias "InsertMenuItemA" (hMenu As HMENU, uItem As DWord, fByPosition As DWord, ByRef lpmii As MENUITEMINFO) As Long

Declare Function RemoveMenu Lib "user32.dll" (hMenu As HMENU, uPosition As DWord, uFlags As DWord) As Long

Declare Function SetMenuDefaultItem Lib "user32.dll" (hMenu As HMENU, uItem As DWord, fByPos As DWord) As Long

Declare Function SetMenuItemInfo Lib "user32.dll" Alias "SetMenuItemInfoA" (hMenu As HMENU, uItem As DWord, fByPosition As Long, ByRef lpmii As MENUITEMINFO) As Long

