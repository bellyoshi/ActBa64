Const MFT_STRING =        MF_STRING

Const MFT_BITMAP =        MF_BITMAP

Const MFT_MENUBARBREAK =  MF_MENUBARBREAK

Const MFT_MENUBREAK =     MF_MENUBREAK

Const MFT_OWNERDRAW =     MF_OWNERDRAW

