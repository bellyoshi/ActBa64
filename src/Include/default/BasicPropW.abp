' 窓のプロパティ（GetProp / SetProp / RemoveProp）の名前と GetStartupInfo の文字列を UTF-8 で。
' プロパティの名前は UTF-8（CP932 のバイト列も読む）をワイドにして W 版へ（65535 以下はアトムなのでそのまま）。
' GetStartupInfo は W 版で読み、lpReserved / lpDesktop / lpTitle を UTF-8 の文字列（プロセスのあいだ持っておく）にして返す。
' -linux は A 版のまま。

Dim g_siReserved As *Byte
Dim g_siDesktop As *Byte
Dim g_siTitle As *Byte

Function GetProp(hWnd As HWND, lpString As *Byte) As HANDLE
#ifdef _LINUX
    GetProp = GetPropA(hWnd, lpString)
#else
    Dim w As *Byte
    w = BasicWidePtr(lpString)
    GetProp = GetPropW(hWnd, w)
    BasicFreeAnsi(w, lpString)
#endif
End Function

Function SetProp(hWnd As HWND, lpString As *Byte, hData As HANDLE) As Long
#ifdef _LINUX
    SetProp = SetPropA(hWnd, lpString, hData)
#else
    Dim w As *Byte
    w = BasicWidePtr(lpString)
    SetProp = SetPropW(hWnd, w, hData)
    BasicFreeAnsi(w, lpString)
#endif
End Function

Function RemoveProp(hWnd As HWND, lpString As *Byte) As HANDLE
#ifdef _LINUX
    RemoveProp = RemovePropA(hWnd, lpString)
#else
    Dim w As *Byte
    w = BasicWidePtr(lpString)
    RemoveProp = RemovePropW(hWnd, w)
    BasicFreeAnsi(w, lpString)
#endif
End Function

' ---------- GetStartupInfo ----------

Sub GetStartupInfo(ByRef lpStartupInfo As STARTUPINFO)
#ifdef _LINUX
    GetStartupInfoA(lpStartupInfo)
#else
    GetStartupInfoW(lpStartupInfo)
    lpStartupInfo.lpReserved = BasicKeepUtf8(g_siReserved, lpStartupInfo.lpReserved)
    lpStartupInfo.lpDesktop = BasicKeepUtf8(g_siDesktop, lpStartupInfo.lpDesktop)
    lpStartupInfo.lpTitle = BasicKeepUtf8(g_siTitle, lpStartupInfo.lpTitle)
#endif
End Sub
