' ウィンドウの再描画

Declare Function GetUpdateRect Lib "user32.dll" (hWnd As HWND, ByRef lpRect As RECT, bErase As Long) As Long

Declare Function GetUpdateRgn Lib "user32.dll" (hWnd As HWND, hRgn As HRGN, bErase As Long) As Long

Declare Function InvalidateRgn Lib "user32.dll" (hWnd As HWND, hRgn As HRGN, bErase As Long) As Long

Const RDW_INVALIDATE =        &H0001

Const RDW_INTERNALPAINT =     &H0002

Const RDW_ERASE =             &H0004

Const RDW_VALIDATE =          &H0008

Const RDW_NOINTERNALPAINT =   &H0010

Const RDW_NOERASE =           &H0020

Const RDW_NOCHILDREN =        &H0040

Const RDW_ALLCHILDREN =       &H0080

Const RDW_UPDATENOW =         &H0100

Const RDW_ERASENOW =          &H0200

Const RDW_FRAME =             &H0400

Const RDW_NOFRAME =           &H0800

Declare Function RedrawWindow Lib "user32.dll" (hWnd As HWND, ByRef lprcUpdate As RECT, hrgnUpdate As HRGN, flags As DWord) As Long

Declare Function ValidateRect Lib "user32.dll" (hWnd As HWND, ByRef lpRect As RECT) As Long

Declare Function ValidateRgn Lib "user32.dll" (hWnd As HWND, hRgn As HRGN) As Long

