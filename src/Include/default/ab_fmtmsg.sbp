Const FORMAT_MESSAGE_FROM_HMODULE =    &H00000800

Const FORMAT_MESSAGE_FROM_SYSTEM =     &H00001000

Const FORMAT_MESSAGE_ARGUMENT_ARRAY =  &H00002000

Declare Function FormatMessage Lib "kernel32.dll" Alias "FormatMessageA" (dwFlags As DWord, lpSource As VoidPtr, dwMessageId As DWord, dwLanguageId As DWord, lpBuffer As BytePtr, nSize As DWord, Arguments As DWordPtr) As DWord

