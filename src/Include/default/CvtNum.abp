' CvtNum.abp — 数値の型変換（default 常時読込）
'
' CDbl は倍精度、CSng は単精度で返す。
' CInt は四捨五入した整数。0.5 は 0 から遠い側（1.5 → 2、-1.5 → -2）。
' 引数は数値。呼び出し時に Double へ変換される。

Function CDbl(n As Double) As Double
    CDbl = n
End Function

Function CSng(n As Double) As Single
    CSng = n
End Function

Function CInt(n As Double) As Long
    Dim t As Double
    t = n + 0.5
    If n < 0 Then t = n - 0.5
    CInt = t
End Function
