' Memory.abp - ポインタ経由の読み書き（AB GetByte / SetByte 相当）

Function GetByte(p As BytePtr) As Long
    If p = 0 Then
        GetByte = 0
        Exit Function
    End If
    GetByte = p[0]
End Function

Sub SetByte(p As BytePtr, v As Long)
    If p = 0 Then Exit Sub
    p[0] = v And 255
End Sub

Function GetWord(p As BytePtr) As Long
    If p = 0 Then
        GetWord = 0
        Exit Function
    End If
    GetWord = p[0] Or (p[1] * 256)
End Function

Sub SetWord(p As BytePtr, v As Long)
    If p = 0 Then Exit Sub
    p[0] = v And 255
    p[1] = (v \ 256) And 255
End Sub

Function GetDWord(p As BytePtr) As DWord
    If p = 0 Then
        GetDWord = 0
        Exit Function
    End If
    GetDWord = p[0] Or (p[1] * 256) Or (p[2] * 65536) Or (p[3] * 16777216)
End Function

Sub SetDWord(p As BytePtr, v As DWord)
    If p = 0 Then Exit Sub
    p[0] = v And 255
    p[1] = (v \ 256) And 255
    p[2] = (v \ 65536) And 255
    p[3] = (v \ 16777216) And 255
End Sub
