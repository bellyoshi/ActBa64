' Memory.abp - ポインタ経由の読み書き（AB GetByte / SetByte 相当）

Function GetByte(p As BytePtr) As Long
    If p = 0 Then
        GetByte = 0
        Exit Function
    End If
    GetByte = p[0]
End Function

Sub SetByte(p As BytePtr, v As Long)
    If p = 0 Then Exit Sub
    p[0] = v And 255
End Sub

Function GetWord(p As *Word) As Long
    If p = 0 Then
        GetWord = 0
        Exit Function
    End If
    GetWord = p[0]
End Function

Sub SetWord(p As *Word, v As Long)
    If p = 0 Then Exit Sub
    p[0] = v And 65535
End Sub

Function GetDWord(p As *DWord) As DWord
    If p = 0 Then
        GetDWord = 0
        Exit Function
    End If
    GetDWord = p[0]
End Function

Sub SetDWord(p As *DWord, v As DWord)
    If p = 0 Then Exit Sub
    p[0] = v
End Sub
