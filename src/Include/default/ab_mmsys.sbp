' api_mmsys.sbp から ActBa64 に無かった宣言。64bit の並びへ合わせ、既存の同名は残している

Type MCI_OPEN_PARMS
    dwCallback As DWord
    wDeviceID As DWord
    lpstrDeviceType As BytePtr
    lpstrElementName As BytePtr
    lpstrAlias As BytePtr
End Type

Type MCI_PLAY_PARMS
    dwCallback As DWord
    dwFrom As DWord
    dwTo As DWord
End Type

Type MCI_SEEK_PARMS
    dwCallback As DWord
    dwTo As DWord
End Type

Type MCI_SET_PARMS
    dwCallback As DWord
    dwTimeFormat As DWord
    dwAudio As DWord
End Type

Type MCI_STATUS_PARMS
    dwCallback As DWord
    dwReturn As DWord
    dwItem As DWord
    dwTrack As DWord
End Type

Type WAVEFORMATEX
    wFormatTag As Word
    nChannels As Word
    nSamplesPerSec As DWord
    nAvgBytesPerSec As DWord
    nBlockAlign As Word
    wBitsPerSample As Word
    cbSize As Word
End Type

