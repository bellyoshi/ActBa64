Declare Function BringWindowToTop Lib "user32.dll" (hWnd As HWND) As Long

Declare Function CallWindowProc Lib "user32.dll" Alias "CallWindowProcA" (lpPrevWndFunc As VoidPtr, hWnd As HWND, Msg As DWord, wParam As WPARAM, lParam As LPARAM) As LRESULT

Declare Function CharLower Lib "user32.dll" Alias "CharLowerA" (lpsz As BytePtr) As DWord

Declare Function CharUpper Lib "user32.dll" Alias "CharUpperA" (lpsz As BytePtr) As DWord

Declare Function CheckMenuRadioItem Lib "user32.dll" (hMenu As HMENU, idFirst As DWord, idLast As DWord, idCheck As DWord, uFlags As DWord) As Long

