' ファイルの作成、属性、検索

Declare Function CopyFile Lib "kernel32.dll" Alias "CopyFileA" (lpExistingFileName As BytePtr, lpNewFileName As BytePtr, bFailIfExists As Long) As Long

Declare Function CreateDirectory Lib "kernel32.dll" Alias "CreateDirectoryA" (lpPathName As BytePtr, ByRef lpSecurityAttributes As SECURITY_ATTRIBUTES) As Long

Const FILE_SHARE_DELETE =             &H00000004

Const CREATE_NEW =        1

Const TRUNCATE_EXISTING = 5

Const FILE_ATTRIBUTE_READONLY =            &H00000001

Const FILE_ATTRIBUTE_HIDDEN =              &H00000002

Const FILE_ATTRIBUTE_SYSTEM =              &H00000004

Const FILE_ATTRIBUTE_ARCHIVE =             &H00000020

Const FILE_ATTRIBUTE_ENCRYPTED =           &H00000040

Const FILE_ATTRIBUTE_TEMPORARY =           &H00000100

Const FILE_ATTRIBUTE_SPARSE_FILE =         &H00000200

Const FILE_ATTRIBUTE_REPARSE_POINT =       &H00000400

Const FILE_ATTRIBUTE_COMPRESSED =          &H00000800

Const FILE_ATTRIBUTE_OFFLINE =             &H00001000

Const FILE_FLAG_WRITE_THROUGH =       &H80000000

Const FILE_FLAG_OVERLAPPED =          &H40000000

Const FILE_FLAG_NO_BUFFERING =        &H20000000

Const FILE_FLAG_RANDOM_ACCESS =       &H10000000

Const FILE_FLAG_SEQUENTIAL_SCAN =     &H08000000

Const FILE_FLAG_DELETE_ON_CLOSE =     &H04000000

Const FILE_FLAG_BACKUP_SEMANTICS =    &H02000000

Const FILE_FLAG_POSIX_SEMANTICS =     &H01000000

Const FILE_FLAG_OPEN_REPARSE_POINT =  &H00200000

Const FILE_FLAG_OPEN_NO_RECALL =      &H00100000

Const MAILSLOT_WAIT_FOREVER = &HFFFFFFFF

Declare Function CreateMailslot Lib "kernel32.dll" Alias "CreateMailslotA" (lpName As *Byte, nMaxMessageSize As DWord, lReadTimeout As DWord, ByRef lpSecurityAttributes As SECURITY_ATTRIBUTES) As HANDLE

Declare Function DeleteFile Lib "kernel32.dll" Alias "DeleteFileA" (lpFileName As BytePtr) As Long

Declare Function FindClose Lib "kernel32.dll" (hFindFile As HANDLE) As Long

Declare Function FindFirstFile Lib "kernel32.dll" Alias "FindFirstFileA" (lpFileName As BytePtr, ByRef lpFindFildData As WIN32_FIND_DATA) As HANDLE

Declare Function FindNextFile Lib "kernel32.dll" Alias "FindNextFileA" (hFindFile As HANDLE, ByRef lpFindFildData As WIN32_FIND_DATA) As DWord

Declare Function FlushFileBuffers Lib "kernel32.dll" (hFile As HANDLE) As Long

Declare Function GetCompressedFileSize Lib "kernel32.dll" Alias "GetCompressedFileSizeA" (lpFileName As BytePtr, ByRef lpFileSizeHigh As DWord) As DWord

Declare Function GetCurrentDirectory Lib "kernel32.dll" Alias "GetCurrentDirectoryA" (nBufferLength As DWord, lpBuffer As BytePtr) As DWord

Const FILE_TYPE_UNKNOWN = &H0000

Const FILE_TYPE_DISK =    &H0001

Const FILE_TYPE_CHAR =    &H0002

Const FILE_TYPE_PIPE =    &H0003

Const FILE_TYPE_REMOTE =  &H8000

Declare Function GetFileType Lib "kernel32.dll" (hFile As HANDLE) As DWord

Declare Function GetFullPathName Lib "kernel32.dll" Alias "GetFullPathNameA" (lpFileName As BytePtr, nBufferLength As DWord, lpBuffer As BytePtr, lpFilePart As DWordPtr) As DWord

Declare Function GetTempPath Lib "kernel32.dll" Alias "GetTempPathA" (nBufferLength As DWord, lpBuffer As BytePtr) As DWord

