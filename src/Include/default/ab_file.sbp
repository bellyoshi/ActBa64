Declare Function RemoveDirectory Lib "kernel32.dll" Alias "RemoveDirectoryA" (lpPathName As BytePtr) As Long

Declare Function SetCurrentDirectory Lib "kernel32.dll" Alias "SetCurrentDirectoryA" (lpPathName As BytePtr) As Long

Declare Function SetEndOfFile Lib "kernel32.dll" (hFile As HANDLE) As Long

