' api_window.sbp から ActBa64 に無かった宣言。64bit の並びへ合わせ、既存の同名は残している

Const SPI_GETMENUUNDERLINES =             &H100A

Const SPI_SETMENUUNDERLINES =             &H100B

Const SPI_GETACTIVEWNDTRKZORDER =         &H100C

Const SPI_SETACTIVEWNDTRKZORDER =         &H100D

Const SPI_GETHOTTRACKING =                &H100E

Const SPI_SETHOTTRACKING =                &H100F

Const SPI_GETFOREGROUNDLOCKTIMEOUT =      &H2000

Const SPI_SETFOREGROUNDLOCKTIMEOUT =      &H2001

Const SPI_GETACTIVEWNDTRKTIMEOUT =        &H2002

Const SPI_SETACTIVEWNDTRKTIMEOUT =        &H2003

Const SPI_GETFOREGROUNDFLASHCOUNT =       &H2004

Const SPI_SETFOREGROUNDFLASHCOUNT =       &H2005

Const SPIF_UPDATEINIFILE =    &H0001

Const SPIF_SENDWININICHANGE = &H0002

Const SPIF_SENDCHANGE =       SPIF_SENDWININICHANGE

Declare Function SystemParametersInfo Lib "user32.dll" Alias "SystemParametersInfoA" (uiAction As DWord, uiParam As DWord, pvParam As VoidPtr, fWinIni As DWord) As Long

Const TPM_LEFTBUTTON =   &H0000

Const TPM_CENTERALIGN =  &H0004

Const TPM_RIGHTALIGN =   &H0008

Const TPM_TOPALIGN =     &H0000

Const TPM_VCENTERALIGN = &H0010

Const TPM_BOTTOMALIGN =  &H0020

Const TPM_HORIZONTAL =   &H0000

Const TPM_VERTICAL =     &H0040

Const TPM_NONOTIFY =     &H0080

Const TPM_RECURSE =      &H0001

Declare Function UnregisterClass Lib "user32.dll" Alias "UnregisterClassA" (lpClassName As BytePtr, hInst As HINSTANCE) As Long

Declare Function ValidateRect Lib "user32.dll" (hWnd As HWND, ByRef lpRect As RECT) As Long

Declare Function ValidateRgn Lib "user32.dll" (hWnd As HWND, hRgn As HRGN) As Long

Const WAIT_TIMEOUT = &H00000102

Declare Function WaitForInputIdle Lib "user32.dll" (hProcess As HANDLE, dwMilliseconds As DWord) As DWord

Declare Function WaitMessage Lib "user32.dll" () As Long

Declare Function WindowFromPoint Lib "user32.dll" (ptX As Long, ptY As Long) As HWND

Declare Function wsprintf cdecl Lib "user32.dll" Alias "wsprintfA" (lpText As BytePtr, lpFormat As BytePtr, ...) As Long

Declare Function wvsprintf Lib "user32.dll" Alias "wvsprintfA" (lpOutput As BytePtr, lpFormat As BytePtr, arglist As DWordPtr) As Long
