' Global / Local メモリ

Const GMEM_FIXED =          &H0000

Const GMEM_NOCOMPACT =      &H0010

Const GMEM_NODISCARD =      &H0020

Const GMEM_ZEROINIT =       &H0040

Const GMEM_MODIFY =         &H0080

Const GMEM_DISCARDABLE =    &H0100

Const GMEM_NOT_BANKED =     &H1000

Const GMEM_SHARE =          &H2000

Const GMEM_DDESHARE =       &H2000

Const GMEM_INVALID_HANDLE = &H8000

Const GHND =                GMEM_MOVEABLE or GMEM_ZEROINIT

Const GPTR =                GMEM_FIXED or GMEM_ZEROINIT

Const GMEM_DISCARDED =      &H4000

Declare Function GlobalFree Lib "kernel32.dll" (hMem As HGLOBAL) As HGLOBAL

Declare Sub GlobalMemoryStatus Lib "kernel32.dll" (ByRef lpMemStatus As MEMORYSTATUS)

Declare Function GlobalReAlloc Lib "kernel32.dll" (hMem As HGLOBAL, dwBytes As SIZE_T, uFlags As DWord) As HGLOBAL

Declare Function GlobalSize Lib "kernel32.dll" (hMem As HGLOBAL) As SIZE_T

Declare Function IsBadReadPtr Lib "kernel32.dll" (lp As VoidPtr, ucb As DWord) As Long

Declare Function IsBadWritePtr Lib "kernel32.dll" (lp As VoidPtr, ucb As DWord) As Long

Declare Function LocalAlloc Lib "kernel32.dll" (uFlags As DWord, uBytes As SIZE_T) As HLOCAL

Declare Function LocalFree Lib "kernel32.dll" (hMem As HLOCAL) As HLOCAL

Declare Sub ZeroMemory Lib "kernel32.dll" Alias "RtlZeroMemory" (Destination As VoidPtr, dwLength As DWord)
