' UsingDig.abp — Print Using の数字づくり（桁数・丸め・整数部・小数部・埋め）

Function PuCountHash(p As *Byte, n As Long, ByRef i As Long) As Long
    Dim c As Long
    c = 0
    While i < n And p[i] = Asc("#")
        c = c + 1
        i = i + 1
    Wend
    PuCountHash = c
End Function

Function PuHalf(frac As Long) As Double
    Dim s As Double
    Dim k As Long
    s = 0.5
    For k = 1 To frac
        s = s / 10
    Next
    PuHalf = s
End Function

' 0 以上の n に、小数 frac 桁の位置で四捨五入するための半分を足す（桁は後で切り捨てる）
Function PuRound(n As Double, frac As Long) As Double
    Dim s As Double
    s = PuHalf(frac)
    If n < 0 Then s = 0 - s
    PuRound = n + s
End Function

Function PuPow10(k As Long) As Double
    Dim s As Double
    Dim i As Long
    s = 1
    For i = 1 To k
        s = s * 10
    Next
    PuPow10 = s
End Function

Function PuIntDigAt(x As Double, c As Long) As Long
    While x >= 10
        x = x / 10
        c = c + 1
    Wend
    PuIntDigAt = c
End Function

Function PuIntDigits(n As Double) As Long
    Dim x As Double
    x = Abs(n)
    PuIntDigits = PuIntDigAt(x, 1)
End Function

Function PuFracN(fh As Long) As Long
    PuFracN = 0
    If fh > 0 Then PuFracN = fh
End Function

Function PuDigStep(ByRef x As Double, ByRef scale As Double) As Long
    Dim d As Long
    d = Fix(x / scale)
    If d > 9 Then d = 9
    If d < 0 Then d = 0
    x = x - d * scale
    scale = scale / 10
    PuDigStep = d
End Function

Function PuDigLoop$(ByRef x As Double, ByRef scale As Double, k As Long) As String
    Dim s As String
    s = ""
    While k > 0
        s = s + Chr$(Asc("0") + PuDigStep(x, scale))
        k = k - 1
    Wend
    PuDigLoop$ = s
End Function

Function PuDigits(n As Double, scale As Double, k As Long) As String
    Dim x As Double
    x = n
    PuDigits = PuDigLoop$(x, scale, k)
End Function

' 0 以上の整数部の十進（0 は "0"）
Function PuIntStr(n As Double) As String
    Dim x As Double
    Dim k As Long
    k = PuIntDigits(n)
    x = PuPow10(k - 1)
    PuIntStr = PuDigits(n, x, k)
End Function

Function PuFracStr(n As Double, fh As Long) As String
    Dim x As Double
    Dim ip As Double
    Dim scale As Double
    ip = Fix(n)
    x = (n - ip) * PuPow10(fh)
    scale = PuPow10(fh - 1)
    PuFracStr = PuDigits(x, scale, fh)
End Function

Function PuFracPart(n As Double, fh As Long) As String
    PuFracPart = ""
    If fh <= 0 Then Exit Function
    PuFracPart = PuFracStr(n, fh)
End Function

' c（1 文字）を k 回
Function PuRep(k As Long, c As String) As String
    Dim s As String
    Dim i As Long
    s = ""
    For i = 1 To k
        s = s + c
    Next
    PuRep = s
End Function

Function PuPad(k As Long) As String
    PuPad = PuRep(k, " ")
End Function

Function PuSkipSp(p As *Byte, m As Long, j As Long) As Long
    While j < m And p[j] = Asc(" ")
        j = j + 1
    Wend
    PuSkipSp = j
End Function

' s を幅 w に（長ければ切り、短ければ右を空白で埋める）
Function PuFitStr(s As String, w As Long) As String
    Dim t As String
    If Len(s) >= w Then
        PuFitStr = Left$(s, w)
        Exit Function
    End If
    t = PuPad(w - Len(s))
    PuFitStr = s + t
End Function
