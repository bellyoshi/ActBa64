' Print の数値。正なら先頭空白（符号の桁）、常に末尾空白。
Function BaPrintLead$(s As String) As String
    BaPrintLead$ = ""
    If Len(s) = 0 Then Exit Function
    If Mid$(s, 1, 1) = "-" Then Exit Function
    BaPrintLead$ = " "
End Function

Function BaPrintNum$(s As String) As String
    BaPrintNum$ = BaPrintLead$(s) + s + " "
End Function
