' ウィンドウの取得と親子関係

Type WINDOWPLACEMENT
    length As Long
    flags As Long
    showCmd As Long
    ptMinPosition As POINTAPI
    ptMaxPosition As POINTAPI
    rcNormalPosition As RECT
End Type

Declare Function BringWindowToTop Lib "user32.dll" (hWnd As HWND) As Long

Declare Function ChildWindowFromPoint Lib "user32.dll" (hWndParent As HWND, x As Long, y As Long) As HWND

Const CWP_ALL =             &H0000

Const CWP_SKIPINVISIBLE =   &H0001

Const CWP_SKIPDISABLED =    &H0002

Const CWP_SKIPTRANSPARENT = &H0004

Declare Function ChildWindowFromPointEx Lib "user32.dll" (hWndParent As HWND, x As Long, y As Long, uFlags As DWord) As HWND

Declare Function CloseWindow Lib "user32.dll" (hWnd As HWND) As Long

Const CW_USEDEFAULT = &H80000000

Declare Function FindWindow Lib "user32.dll" Alias "FindWindowA" (lpClassName As BytePtr, lpWindowName As BytePtr) As HWND

Declare Function FlashWindow Lib "user32.dll" (hWnd As HWND, bInvert As Long) As Long

Declare Function GetActiveWindow Lib "user32.dll" () As HWND

Declare Function GetDesktopWindow Lib "user32.dll" () As HWND

Declare Function GetFocus Lib "user32.dll" () As HWND

Declare Function GetForegroundWindow Lib "user32.dll" () As HWND

Declare Function GetParent Lib "user32.dll" (hWnd As HWND) As HWND

Declare Function GetProp Lib "user32.dll" Alias "GetPropA" (hWnd As HWND, lpString As *Byte) As HANDLE

Const GW_HWNDFIRST =      0

Const GW_HWNDLAST =       1

Const GW_HWNDNEXT =       2

Const GW_HWNDPREV =       3

Const GW_CHILD =          5

Const GWL_HINSTANCE =     -6

Const GWL_HWNDPARENT =    -8

Const GWL_STYLE =         -16

Const GWL_EXSTYLE =       -20

Const GWL_USERDATA =      -21

Const GWL_ID =            -12

Declare Function GetWindowLong Lib "user32.dll" Alias "GetWindowLongPtrA" (hWnd As HWND, nIndex As Long) As LONG_PTR

Const WPF_SETMINPOSITION =     &H0001

Const WPF_RESTORETOMAXIMIZED = &H0002

Declare Function GetWindowPlacement Lib "user32.dll" (hWnd As HWND, ByRef lpwndpl As WINDOWPLACEMENT) As Long

Declare Function GetWindowRect Lib "user32.dll" (hWnd As HWND, ByRef lpRect As RECT) As Long

Declare Function GetWindowRgn Lib "user32.dll" (hWnd As HWND, hRgn As HRGN) As Long

Declare Function GetWindowThreadProcessId Lib "user32.dll" (hWnd As HWND, lpdwProcessId As DWordPtr) As DWord

Declare Function IsChild Lib "user32.dll" (hWndParent As HWND, hWnd As HWND) As Long

Declare Function IsIconic Lib "user32.dll" (hWnd As HWND) As Long

Declare Function IsWindowEnabled Lib "user32.dll" (hWnd As HWND) As Long

Declare Function IsWindowVisible Lib "user32.dll" (hWnd As HWND) As Long

Declare Function IsZoomed Lib "user32.dll" (hWnd As HWND) As Long

Declare Function LockWindowUpdate Lib "user32.dll" (hWnd As HWND) As Long

Declare Function OpenIcon Lib "user32.dll" (hWnd As HWND) As Long

Declare Function RemoveProp Lib "user32.dll" Alias "RemovePropA" (hWnd As HWND, lpString As *Byte) As HANDLE

Declare Function SetActiveWindow Lib "user32.dll" (hWnd As HWND) As HWND

Declare Function SetParent Lib "user32.dll" (hWndChild As HWND, hWndNewParent As HWND) As HWND

Declare Function SetProp Lib "user32.dll" Alias "SetPropA" (hWnd As HWND, lpString As *Byte, hData As HANDLE) As Long

Declare Function SetWindowPlacement Lib "user32.dll" (hWnd As HWND, ByRef lpwndpl As WINDOWPLACEMENT) As Long

Const HWND_TOP =       0

Const HWND_BOTTOM =    1

Const HWND_TOPMOST =   -1

Const HWND_NOTOPMOST = -2

Declare Function SetWindowRgn Lib "user32.dll" (hWnd As HWND, hRgn As HRGN, bRedraw As Long) As Long

Declare Function WindowFromPoint Lib "user32.dll" (ptX As Long, ptY As Long) As HWND

