' DLL の読み込み

Declare Function FreeLibrary Lib "kernel32.dll" (hLibModule As DWord) As Long

Declare Function GetProcAddress Lib "kernel32.dll" (hModule As HINSTANCE, lpProcName As BytePtr) As DWord

Declare Function LoadLibrary Lib "kernel32.dll" Alias "LoadLibraryA" (lpLibFileName As BytePtr) As DWord

