Const CCS_RIGHT =         CCS_VERT or CCS_BOTTOM

Const CCS_NOMOVEX =       CCS_VERT or CCS_NOMOVEY

Const CCM_FIRST =             &H2000

Const CCM_SETBKCOLOR =        CCM_FIRST+1

