' ハンドルの複製

Const DUPLICATE_CLOSE_SOURCE = 1

Const DUPLICATE_SAME_ACCESS  = 2

Declare Function DuplicateHandle Lib "kernel32.dll" (hSourceProcessHandle As DWord, hSourceHandle As DWord, hTargetProcessHandle As DWord, lpTargetHandle As DWordPtr, dwDesiredAccess As DWord, bInheritHandle As Long, dwOptions As DWord) As Long

