' Input の複数変数。残りの行をカンマで切る。空なら次の行を読む。
Dim g_inHold As String

Sub InHoldReset()
    g_inHold = ""
End Sub

Function InHoldEmpty() As Long
    InHoldEmpty = 0
    If Len(g_inHold) = 0 Then InHoldEmpty = 1
End Function

Sub InHoldSet(s As String)
    g_inHold = s
End Sub

Function InHoldComma() As Long
    InHoldComma = InStr(1, g_inHold, ",")
End Function

Function InHoldHead$() As String
    Dim i As Long
    i = InHoldComma()
    InHoldHead$ = g_inHold
    If i <= 0 Then Exit Function
    InHoldHead$ = Mid$(g_inHold, 1, i - 1)
End Function

Sub InHoldTailMid(i As Long)
    Dim n As Long
    n = Len(g_inHold)
    g_inHold = Mid$(g_inHold, i + 1, n - i)
End Sub

Sub InHoldTail()
    Dim i As Long
    i = InHoldComma()
    If i <= 0 Then
        InHoldReset()
        Exit Sub
    End If
    InHoldTailMid(i)
End Sub

Function InHoldMoreComma(i As Long) As Long
    InHoldMoreComma = 0
    If i <= 0 Then Exit Function
    InHoldMoreComma = InStr(i + 1, g_inHold, ",")
End Function

Function InHoldCountAt(i As Long, n As Long) As Long
    InHoldCountAt = n
    If i <= 0 Then Exit Function
    InHoldCountAt = InHoldCountAt(InHoldMoreComma(i), n + 1)
End Function

' 空行は 0。カンマ区切りの個数（末尾カンマも数える）。
Function InHoldFields() As Long
    InHoldFields = 0
    If Len(g_inHold) = 0 Then Exit Function
    InHoldFields = InHoldCountAt(InHoldComma(), 1)
End Function
