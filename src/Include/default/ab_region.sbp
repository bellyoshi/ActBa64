' リージョン

Type RGNDATAHEADER
    dwSize As DWord
    iType As DWord
    nCount As DWord
    nRgnSize As DWord
    rcBound As RECT
End Type

Type RGNDATA
    rdh As RGNDATAHEADER
    Buffer As Byte
End Type

Const NULLREGION =    1

Const SIMPLEREGION =  2

Const COMPLEXREGION = 3

Const RGN_AND =  1

Const RGN_OR =   2

Const RGN_XOR =  3

Const RGN_DIFF = 4

Const RGN_COPY = 5

Declare Function CombineRgn Lib "gdi32.dll" (hrgnDest As HRGN, hrgnSrc1 As HRGN, hrgnSrc2 As HRGN, fnCombineMode As Long) As Long

Declare Function CreateEllipticRgn Lib "gdi32.dll" (nLeftRect As Long, nTopRect As Long, nRightRect As Long, nBottomRect As Long) As HRGN

Declare Function CreateEllipticRgnIndirect Lib "gdi32.dll" (ByRef lpRect As RECT) As HRGN

Declare Function CreatePolygonRgn Lib "gdi32.dll" (ByRef lpPoints As POINTAPI, cPoints As Long, fnPolyFillMode As Long) As HRGN

Declare Function CreateRectRgn Lib "gdi32.dll" (nLeftRect As Long, nTopRect As Long, nRightRect As Long, nBottomRect As Long) As HRGN

Declare Function CreateRectRgnIndirect Lib "gdi32.dll" (ByRef lpRect As RECT) As HRGN

Declare Function CreateRoundRectRgn Lib "gdi32.dll" (nLeftRect As Long, nTopRect As Long, nRightRect As Long, nBottomRect As Long, nWidthEllipse As Long, nHeightEllipse As Long) As HRGN

Declare Function EqualRgn Lib "gdi32.dll" (hSrcRgn1 As HRGN, hSrcRgn2 As HRGN) As Long

Declare Function FillRgn Lib "gdi32.dll" (hdc As HDC, hRgn As HRGN, hBrush As HBRUSH) As Long

Declare Function FrameRgn Lib "gdi32.dll" (hdc As HDC, hRgn As HRGN, hBrush As HBRUSH, nWidth As Long, nHeight As Long) As Long

Declare Function GetRgnBox Lib "gdi32.dll" (hRgn As HRGN, ByRef lpRect As RECT) As Long

Declare Function InvertRgn Lib "gdi32.dll" (hdc As HDC, hRgn As HRGN) As Long

Declare Function OffsetRgn Lib "gdi32.dll" (hRgn As HRGN, nXOffset As Long, nYOffset As Long) As Long

Declare Function PaintRgn Lib "gdi32.dll" (hdc As HDC, hRgn As HRGN) As Long

Declare Function PtInRegion Lib "gdi32.dll" (hRgn As HRGN, x As Long, y As Long) As Long

Declare Function RectInRegion Lib "gdi32.dll" (hRgn As HRGN, ByRef lpRect As RECT) As Long

Declare Function SetRectRgn Lib "gdi32.dll" (hRgn As HRGN, nLeftRect As Long, nTopRect As Long, nRightRect As Long, nBottomRect As Long) As Long

