' Using.abp — Print Using の書式（default 常時読込）
' Print Using f; a, b は PuUseEnd$(PuUseVal$(PuUseVal$(PuUseBeg$(f), a), b)) になる。
' 値ごとに書式を前から当てはめ、書式の終わりまで来たら先頭へ戻る。最後の値のあとは次の欄の手前まで出す。
' 欄: 数値（UsingNum.abp）、! は 1 文字、& & は幅つき、@ は文字列全体。_ の次の 1 文字はそのまま出す。
' 文字列は UTF-8。2 バイト目以降は 80h 以上なので欄の文字と取り違えない。
Const PU_F_NONE = 0
Const PU_F_NUM = 1
Const PU_F_BANG = 2
Const PU_F_AMP = 3
Const PU_F_AT = 4

Dim g_puFmt As String
Dim g_puPos As Long

' UTF-8 の先頭バイト c から 1 文字のバイト数
Function PuU8Len(c As Long) As Long
    PuU8Len = 1
    If c >= 192 Then PuU8Len = 2
    If c >= 224 Then PuU8Len = 3
    If c >= 240 Then PuU8Len = 4
End Function

' & から閉じの & までの幅。閉じがなければ -1
Function PuAmpW(p As *Byte, i As Long) As Long
    Dim j As Long
    j = PuSkipSp(p, PU_BIG, i + 1)
    PuAmpW = -1
    If p[j] = Asc("&") Then PuAmpW = j - i + 1
End Function

Function PuFieldAt(p As *Byte, i As Long) As Long
    PuFieldAt = PU_F_NONE
    If PuNumAt(p, i) <> 0 Then PuFieldAt = PU_F_NUM
    If p[i] = Asc("!") Then PuFieldAt = PU_F_BANG
    If p[i] = Asc("@") Then PuFieldAt = PU_F_AT
    If p[i] <> Asc("&") Then Exit Function
    If PuAmpW(p, i) > 0 Then PuFieldAt = PU_F_AMP
End Function

Function PuCurKind() As Long
    PuCurKind = PU_F_NONE
    If g_puPos >= Len(g_puFmt) Then Exit Function
    PuCurKind = PuFieldAt(StrPtr(g_puFmt), g_puPos)
End Function

' 欄でない 1 文字（_x は x。UTF-8 の 1 文字ごと）
Function PuLit1(p As *Byte, acc As String) As String
    Dim k As Long
    If p[g_puPos] = Asc("_") Then g_puPos = g_puPos + 1
    k = PuU8Len(p[g_puPos])
    PuLit1 = acc + Mid$(g_puFmt, g_puPos + 1, k)
    g_puPos = g_puPos + k
End Function

Function PuLitMore() As Long
    PuLitMore = 0
    If g_puPos >= Len(g_puFmt) Then Exit Function
    If PuCurKind() = PU_F_NONE Then PuLitMore = 1
End Function

' 次の欄の手前（または書式の終わり）まで文字をそのまま足す
Function PuLitRun(acc As String) As String
    Dim s As String
    s = acc
    While PuLitMore() <> 0
        s = PuLit1(StrPtr(g_puFmt), s)
    Wend
    PuLitRun = s
End Function

Function PuHasField() As Long
    Dim keep As Long
    Dim t As String
    keep = g_puPos
    g_puPos = 0
    t = PuLitRun("")
    PuHasField = 0
    If g_puPos < Len(g_puFmt) Then PuHasField = 1
    g_puPos = keep
End Function

' 次の欄まで進む。書式の終わりまで来たら先頭へ戻る（欄が 1 つもなければ終わりのまま）
Function PuLitToField(acc As String) As String
    Dim s As String
    s = PuLitRun(acc)
    PuLitToField = s
    If g_puPos < Len(g_puFmt) Then Exit Function
    If PuHasField() = 0 Then Exit Function
    g_puPos = 0
    PuLitToField = PuLitRun(s)
End Function

' 数値欄を読み飛ばして v を返す（PuSpec の結果は g_pu* に残る）
Function PuSkipNum(v As String) As String
    Dim i As Long
    i = g_puPos
    PuSpec(StrPtr(g_puFmt), i)
    g_puPos = i
    PuSkipNum = v
End Function

Function PuNumField(v As Double) As String
    Dim t As String
    t = PuSkipNum("")
    PuNumField = PuNumFmt(v)
End Function

Function PuFieldEnd(p As *Byte, k As Long) As Long
    PuFieldEnd = g_puPos + 1
    If k = PU_F_AMP Then PuFieldEnd = g_puPos + PuAmpW(p, g_puPos)
End Function

Function PuStrField(s As String) As String
    Dim p As *Byte
    Dim k As Long
    p = StrPtr(g_puFmt)
    k = PuCurKind()
    PuStrField = s
    If k = PU_F_BANG Then PuStrField = PuFitStr(s, 1)
    If k = PU_F_AMP Then PuStrField = PuFitStr(s, PuAmpW(p, g_puPos))
    g_puPos = PuFieldEnd(p, k)
End Function

' 文字列欄に数値が来たときと、欄がない書式のときの書き方
Function PuNumRaw(v As Double) As String
    PuNumRaw = StrD$(v)
End Function

Function PuValNumT(v As Double, k As Long) As String
    Dim t As String
    t = PuNumRaw(v)
    PuValNumT = t
    If k = PU_F_NUM Then PuValNumT = PuNumField(v)
    If k > PU_F_NUM Then PuValNumT = PuStrField(t)
End Function

Function PuValNum(acc As String, v As Double) As String
    Dim s As String
    Dim t As String
    s = PuLitToField(acc)
    t = PuValNumT(v, PuCurKind())
    PuValNum = s + t
End Function

Function PuValStrT(v As String, k As Long) As String
    PuValStrT = v
    If k = PU_F_NUM Then PuValStrT = PuSkipNum(v)
    If k > PU_F_NUM Then PuValStrT = PuStrField(v)
End Function

Function PuValStr(acc As String, v As String) As String
    Dim s As String
    Dim t As String
    s = PuLitToField(acc)
    t = PuValStrT(v, PuCurKind())
    PuValStr = s + t
End Function

Function PuUseBeg$(fmt As String) As String
    g_puFmt = fmt
    g_puPos = 0
    PuUseBeg$ = ""
End Function

' 引数の型で呼び分ける（Double を先に置く。整数でも Double でもない型は Double へ）
Function PuUseVal$(acc As String, v As Double) As String
    PuUseVal$ = PuValNum(acc, v)
End Function

Function PuUseVal$(acc As String, v As Long) As String
    Dim d As Double
    d = v
    PuUseVal$ = PuValNum(acc, d)
End Function

Function PuUseVal$(acc As String, v As String) As String
    PuUseVal$ = PuValStr(acc, v)
End Function

Function PuUseEnd$(acc As String) As String
    PuUseEnd$ = PuLitRun(acc)
End Function

' 値 1 つの Using（数値）
Function Using$(fmt As String, n As Double) As String
    Dim s As String
    s = PuUseBeg$(fmt)
    s = PuValNum(s, n)
    Using$ = PuUseEnd$(s)
End Function

' 値 1 つの Using（文字列）
Function UsingStr$(fmt As String, s As String) As String
    Dim t As String
    t = PuUseBeg$(fmt)
    t = PuValStr(t, s)
    UsingStr$ = PuUseEnd$(t)
End Function
