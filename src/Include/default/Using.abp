' Using.abp — Print Using の書式（default 常時読込）
' # は数値、@ は文字列の埋め込み、& & は幅つき文字列。値は 1 つ。

Function PuCountHash(p As *Byte, n As Long, ByRef i As Long) As Long
    Dim c As Long
    c = 0
    While i < n And p[i] = Asc("#")
        c = c + 1
        i = i + 1
    Wend
    PuCountHash = c
End Function

Function PuHalf(frac As Long) As Double
    Dim s As Double
    Dim k As Long
    s = 0.5
    For k = 1 To frac
        s = s / 10
    Next
    PuHalf = s
End Function

Function PuRound(n As Double, frac As Long) As Double
    Dim s As Double
    s = PuHalf(frac)
    If n < 0 Then s = 0 - s
    PuRound = n + s
End Function

Function PuPow10(k As Long) As Double
    Dim s As Double
    Dim i As Long
    s = 1
    For i = 1 To k
        s = s * 10
    Next
    PuPow10 = s
End Function

Function PuIntDigAt(x As Double, c As Long) As Long
    While x >= 10
        x = x / 10
        c = c + 1
    Wend
    PuIntDigAt = c
End Function

Function PuIntDigits(n As Double) As Long
    Dim x As Double
    x = Abs(n)
    PuIntDigits = PuIntDigAt(x, 1)
End Function

Function PuFracN(fh As Long) As Long
    PuFracN = 0
    If fh > 0 Then PuFracN = fh
End Function

Function PuHashN(k As Long) As String
    Dim s As String
    Dim i As Long
    s = ""
    For i = 1 To k
        s = s + "#"
    Next
    PuHashN = s
End Function

Function PuCatDot(s As String, a As String) As String
    Dim t As String
    t = "." + a
    PuCatDot = s + t
End Function

Function PuHashDot(s As String, fh As Long) As String
    Dim a As String
    Dim k As Long
    k = PuFracN(fh)
    a = PuHashN(k)
    PuHashDot = PuCatDot(s, a)
End Function

Function PuHashes(ih As Long, fh As Long) As String
    Dim s As String
    s = PuHashN(ih)
    If fh >= 0 Then s = PuHashDot(s, fh)
    PuHashes = s
End Function

Function PuTooWide(n As Double, ih As Long) As Long
    Dim need As Long
    need = PuIntDigits(Abs(n))
    If n < 0 Then need = need + 1
    PuTooWide = 0
    If need > ih Then PuTooWide = 1
End Function

Function PuDigStep(ByRef x As Double, ByRef scale As Double) As Long
    Dim d As Long
    d = x / scale
    If d > 9 Then d = 9
    If d < 0 Then d = 0
    x = x - d * scale
    scale = scale / 10
    PuDigStep = d
End Function

Function PuDigLoop$(ByRef x As Double, ByRef scale As Double, k As Long) As String
    Dim s As String
    s = ""
    While k > 0
        s = s + Chr$(Asc("0") + PuDigStep(x, scale))
        k = k - 1
    Wend
    PuDigLoop$ = s
End Function

Function PuDigits(n As Double, scale As Double, k As Long) As String
    Dim x As Double
    x = n
    PuDigits = PuDigLoop$(x, scale, k)
End Function

Function PuIntStr(n As Double) As String
    Dim x As Double
    Dim k As Long
    k = PuIntDigits(n)
    x = PuPow10(k - 1)
    PuIntStr = PuDigits(n, x, k)
End Function

Function PuFracStr(n As Double, fh As Long) As String
    Dim x As Double
    Dim ip As Double
    Dim scale As Double
    ip = Fix(n)
    x = (n - ip) * PuPow10(fh)
    scale = PuPow10(fh - 1)
    PuFracStr = PuDigits(x, scale, fh)
End Function

Function PuFracPart(n As Double, fh As Long) As String
    PuFracPart = ""
    If fh <= 0 Then Exit Function
    PuFracPart = PuFracStr(n, fh)
End Function

Function PuPad(k As Long) As String
    Dim s As String
    Dim i As Long
    s = ""
    For i = 1 To k
        s = s + " "
    Next
    PuPad = s
End Function

Function PuLead(n As Double, ih As Long, sign As Long) As String
    Dim s As String
    s = PuPad(ih - PuIntDigits(Abs(n)) - sign)
    If sign <> 0 Then s = s + "-"
    PuLead = s
End Function

Function PuFitCore(n As Double, ih As Long, sign As Long) As String
    Dim a As String
    Dim b As String
    Dim x As Double
    a = PuLead(n, ih, sign)
    x = Abs(n)
    b = PuIntStr(x)
    PuFitCore = a + b
End Function

Function PuFitDot(s As String, n As Double, fh As Long) As String
    Dim a As String
    Dim x As Double
    x = Abs(n)
    a = PuFracPart(x, fh)
    PuFitDot = PuCatDot(s, a)
End Function

Function PuFit(n As Double, ih As Long, fh As Long) As String
    Dim s As String
    Dim sign As Long
    sign = 0
    If n < 0 Then sign = 1
    s = PuFitCore(n, ih, sign)
    If fh >= 0 Then s = PuFitDot(s, n, fh)
    PuFit = s
End Function

Function PuFormat(n As Double, ih As Long, fh As Long) As String
    Dim r As Double
    r = PuRound(n, PuFracN(fh))
    If PuTooWide(r, ih) <> 0 Then
        PuFormat = PuHashes(ih, fh)
    Else
        PuFormat = PuFit(r, ih, fh)
    End If
End Function

Function PuFracHash(p As *Byte, m As Long, ByRef i As Long) As Long
    PuFracHash = -1
    If i >= m Or p[i] <> Asc(".") Then Exit Function
    i = i + 1
    PuFracHash = PuCountHash(p, m, i)
End Function

Function PuNumFmt(fmt As String, ByRef i As Long, n As Double) As String
    Dim p As *Byte
    Dim ih As Long
    Dim fh As Long
    p = StrPtr(fmt)
    ih = PuCountHash(p, Len(fmt), i)
    fh = PuFracHash(p, Len(fmt), i)
    PuNumFmt = PuFormat(n, ih, fh)
End Function

Function PuNumField(fmt As String, ByRef i As Long, s As String, n As Double) As String
    Dim t As String
    t = PuNumFmt(fmt, i, n)
    PuNumField = s + t
End Function

Function PuCopy1(fmt As String, ByRef i As Long, s As String) As String
    Dim p As *Byte
    p = StrPtr(fmt)
    PuCopy1 = s + Chr$(p[i])
    i = i + 1
End Function

Function PuRoute(fmt As String, ByRef i As Long, s As String, n As Double, p As *Byte) As String
    If p[i] = Asc("#") Then
        PuRoute = PuNumField(fmt, i, s, n)
        Exit Function
    End If
    PuRoute = PuCopy1(fmt, i, s)
End Function

Function PuStep(fmt As String, ByRef i As Long, ByRef s As String, n As Double) As Long
    Dim p As *Byte
    p = StrPtr(fmt)
    PuStep = 0
    If i >= Len(fmt) Then Exit Function
    s = PuRoute(fmt, i, s, n, p)
    PuStep = 1
End Function

Function Using$(fmt As String, n As Double) As String
    Dim s As String
    Dim i As Long
    s = ""
    i = 0
    While PuStep(fmt, i, s, n) <> 0
        s = s
    Wend
    Using$ = s
End Function

Function PuSkipSp(p As *Byte, m As Long, j As Long) As Long
    While j < m And p[j] = Asc(" ")
        j = j + 1
    Wend
    PuSkipSp = j
End Function

Function PuAmpSpan(p As *Byte, m As Long, ByRef i As Long) As Long
    Dim j As Long
    j = PuSkipSp(p, m, i + 1)
    PuAmpSpan = -1
    If j >= m Or p[j] <> Asc("&") Then Exit Function
    PuAmpSpan = j - i + 1
    i = j + 1
End Function

Function PuFitStr(s As String, w As Long) As String
    Dim t As String
    If Len(s) >= w Then
        PuFitStr = Left$(s, w)
        Exit Function
    End If
    t = PuPad(w - Len(s))
    PuFitStr = s + t
End Function

Function PuAmpPut(out As String, s As String, w As Long) As String
    Dim t As String
    t = PuFitStr(s, w)
    PuAmpPut = out + t
End Function

Function PuAmpField(fmt As String, ByRef i As Long, out As String, ByRef s As String) As String
    Dim w As Long
    w = PuAmpSpan(StrPtr(fmt), Len(fmt), i)
    If w < 0 Then
        PuAmpField = PuCopy1(fmt, i, out)
        Exit Function
    End If
    PuAmpField = PuAmpPut(out, s, w)
    s = ""
End Function

Function PuAt(fmt As String, ByRef i As Long, out As String, ByRef s As String) As String
    i = i + 1
    PuAt = out + s
    s = ""
End Function

Function PuAmpOr1(fmt As String, ByRef i As Long, out As String, ByRef s As String) As String
    Dim p As *Byte
    p = StrPtr(fmt)
    If p[i] <> Asc("&") Then
        PuAmpOr1 = PuCopy1(fmt, i, out)
        Exit Function
    End If
    PuAmpOr1 = PuAmpField(fmt, i, out, s)
End Function

Function PuStrRoute(fmt As String, ByRef i As Long, out As String, ByRef s As String, p As *Byte) As String
    If p[i] = Asc("@") Then
        PuStrRoute = PuAt(fmt, i, out, s)
        Exit Function
    End If
    PuStrRoute = PuAmpOr1(fmt, i, out, s)
End Function

Function PuStrStep(fmt As String, ByRef i As Long, ByRef out As String, ByRef s As String) As Long
    Dim p As *Byte
    p = StrPtr(fmt)
    PuStrStep = 0
    If i >= Len(fmt) Then Exit Function
    out = PuStrRoute(fmt, i, out, s, p)
    PuStrStep = 1
End Function

Function UsingStr$(fmt As String, s As String) As String
    Dim out As String
    Dim i As Long
    out = ""
    i = 0
    While PuStrStep(fmt, i, out, s) <> 0
        out = out
    Wend
    UsingStr$ = out
End Function
