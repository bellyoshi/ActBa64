' ウィンドウクラス

Const CS_OWNDC =           &H0020

Const CS_CLASSDC =         &H0040

Const CS_PARENTDC =        &H0080

Const CS_NOCLOSE =         &H0200

Const CS_SAVEBITS =        &H0800

Const CS_BYTEALIGNCLIENT = &H1000

Const CS_BYTEALIGNWINDOW = &H2000

Const CS_GLOBALCLASS =     &H4000

Declare Function GetClassInfoExA Lib "user32.dll" (hInst As HINSTANCE, lpszClass As BytePtr, ByRef lpwcx As WNDCLASSEX) As Long
Declare Function GetClassInfoExW Lib "user32.dll" (hInst As HINSTANCE, lpszClass As BytePtr, ByRef lpwcx As WNDCLASSEX) As Long

Function BasicInfoCls(cls As *Byte, owned As *Byte) As *Byte
    BasicInfoCls = cls
    If cls <> owned Then Exit Function
    BasicInfoCls = 0
End Function

Function GetClassInfoEx(inst As HINSTANCE, name As *Byte, ByRef wc As WNDCLASSEX) As Long
    Dim w As *Byte
    w = BasicWidePtr(name)
    GetClassInfoEx = GetClassInfoExW(inst, w, wc)
    wc.lpszClassName = BasicInfoCls(wc.lpszClassName, w)
    BasicFreeAnsi(w, name)
    If GetClassInfoEx = 0 Then Exit Function
    wc.lpszClassName = BasicClassOut(g_clsName, wc.lpszClassName, name)
    wc.lpszMenuName = BasicKeepUtf8(g_clsMenu, wc.lpszMenuName)
End Function

Const GCL_MENUNAME =      -8

Const GCL_HBRBACKGROUND = -10

Const GCL_HCURSOR =       -12

Const GCL_HICON =         -14

Const GCL_HMODULE =       -16

Const GCL_CBWNDEXTRA =    -18

Const GCL_CBCLSEXTRA =    -20

Const GCL_WNDPROC =       -24

Const GCL_STYLE =         -26

Const GCW_ATOM =          -32

Const GCL_HICONSM =       -34

' *LongPtrA は 64bit の user32 にしか無い。32bit は *LongA
#ifdef _WIN64
Declare Function GetClassLong Lib "user32.dll" Alias "GetClassLongPtrA" (hWnd As HWND, nIndex As Long) As LONG_PTR
#else
Declare Function GetClassLong Lib "user32.dll" Alias "GetClassLongA" (hWnd As HWND, nIndex As Long) As LONG_PTR
#endif

Declare Function GetClassNameA Lib "user32.dll" (hWnd As HWND, lpClassName As BytePtr, nMaxCount As Long) As Long
Declare Function GetClassNameW Lib "user32.dll" (hWnd As HWND, lpClassName As BytePtr, nMaxCount As Long) As Long

Function GetClassName(hWnd As HWND, buf As *Byte, nMax As Long) As Long
    Dim chars As Long, wide As *Byte
    GetClassName = 0
    If GwReady(buf, nMax) = 0 Then Exit Function
    wide = GwAlloc(nMax)
    If wide = 0 Then Exit Function
    chars = GetClassNameW(hWnd, wide, nMax)
    GetClassName = GwFinish(wide, chars, buf, nMax)
End Function

' *LongPtrA は 64bit の user32 にしか無い。32bit は *LongA
#ifdef _WIN64
Declare Function SetClassLong Lib "user32.dll" Alias "SetClassLongPtrA" (hWnd As HWND, nIndex As Long, NewLong As LONG_PTR) As LONG_PTR
#else
Declare Function SetClassLong Lib "user32.dll" Alias "SetClassLongA" (hWnd As HWND, nIndex As Long, NewLong As LONG_PTR) As LONG_PTR
#endif

Declare Function UnregisterClassA Lib "user32.dll" (lpClassName As BytePtr, hInst As HINSTANCE) As Long
Declare Function UnregisterClassW Lib "user32.dll" (lpClassName As BytePtr, hInst As HINSTANCE) As Long

Function UnregisterClass(name As *Byte, inst As HINSTANCE) As Long
    Dim w As *Byte
    w = BasicWidePtr(name)
    UnregisterClass = UnregisterClassW(w, inst)
    BasicFreeAnsi(w, name)
End Function

