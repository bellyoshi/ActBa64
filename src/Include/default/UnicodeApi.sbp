' Unicode APIs needed by actba64 programs.
' ActiveBasic 4.20 already provides these declarations in its standard headers.

Declare Function MultiByteToWideChar Lib "kernel32.dll" (ByVal CodePage As DWord, ByVal dwFlags As DWord, ByVal lpMultiByteStr As *Byte, ByVal cbMultiByte As Long, ByVal lpWideCharStr As *Word, ByVal cchWideChar As Long) As Long
Declare Function WideCharToMultiByte Lib "kernel32.dll" (ByVal CodePage As DWord, ByVal dwFlags As DWord, ByVal lpWideCharStr As *Word, ByVal cchWideChar As Long, ByVal lpMultiByteStr As *Byte, ByVal cbMultiByte As Long, ByVal lpDefaultChar As *Byte, ByVal lpUsedDefaultChar As *Byte) As Long
Declare Function SetWindowTextW Lib "user32.dll" (ByVal hWnd As HWND, ByVal lpString As *Byte) As Long
Declare Function GetWindowTextW Lib "user32.dll" (ByVal hWnd As HWND, ByVal lpString As *Byte, ByVal nMaxCount As Long) As Long
Declare Function GetWindowTextLengthW Lib "user32.dll" (ByVal hWnd As HWND) As Long
Declare Function CreateWindowExW Lib "user32.dll" (ByVal dwExStyle As DWord, ByVal lpClassName As *Byte, ByVal lpWindowName As *Byte, ByVal dwStyle As DWord, ByVal x As Long, ByVal y As Long, ByVal nWidth As Long, ByVal nHeight As Long, ByVal hWndParent As HWND, ByVal hMenu As HMENU, ByVal hInstance As HINSTANCE, ByVal lpParam As Long) As HWND
Declare Function CreateFontW Lib "gdi32.dll" (ByVal nHeight As Long, ByVal nWidth As Long, ByVal nEscapement As Long, ByVal nOrientation As Long, ByVal fnWeight As Long, ByVal fdwItalic As DWord, ByVal fdwUnderline As DWord, ByVal fdwStrikeOut As DWord, ByVal fdwCharSet As DWord, ByVal fdwOutputPrecision As DWord, ByVal fdwClipPrecision As DWord, ByVal fdwQuality As DWord, ByVal fdwPitchAndFamily As DWord, ByVal lpszFace As *Byte) As HFONT
Declare Function TextOutW Lib "gdi32.dll" (ByVal hdc As HDC, ByVal x As Long, ByVal y As Long, ByVal lpString As *Byte, ByVal c As Long) As Long
Declare Function GetTextExtentPoint32W Lib "gdi32.dll" (ByVal hdc As HDC, ByVal lpString As *Byte, ByVal c As Long, ByRef lpSize As SIZE) As Long
