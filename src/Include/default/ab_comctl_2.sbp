' api_commctrl.sbp から ActBa64 に無かった宣言。64bit の並びへ合わせ、既存の同名は残している

Function ListView_InsertItem(hwnd As HWND, ByRef ref_lvItem As LVITEM) As Long
ListView_InsertItem=SendMessage(hwnd,LVM_INSERTITEM,0,VarPtr(ref_lvItem))
End Function

Const LVM_DELETEITEM =        LVM_FIRST+8

Function ListView_DeleteItem(hwnd As HWND, iItem As Long) As BOOL
ListView_DeleteItem=SendMessage(hwnd,LVM_DELETEITEM,iItem,0)
End Function

