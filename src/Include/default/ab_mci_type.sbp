' MCI の構造体（dwCallback は Windows と同じくポインタ幅の DWORD_PTR）

Type MCI_OPEN_PARMS
    dwCallback As DWORD_PTR
    wDeviceID As DWord
    lpstrDeviceType As BytePtr
    lpstrElementName As BytePtr
    lpstrAlias As BytePtr
End Type

Type MCI_PLAY_PARMS
    dwCallback As DWORD_PTR
    dwFrom As DWord
    dwTo As DWord
End Type

Type MCI_SEEK_PARMS
    dwCallback As DWORD_PTR
    dwTo As DWord
End Type

Type MCI_SET_PARMS
    dwCallback As DWORD_PTR
    dwTimeFormat As DWord
    dwAudio As DWord
End Type

Type MCI_STATUS_PARMS
    dwCallback As DWORD_PTR
    dwReturn As DWord
    dwItem As DWord
    dwTrack As DWord
End Type

