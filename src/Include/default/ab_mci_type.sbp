' MCI の構造体（dwCallback は Windows と同じくポインタ幅の DWORD_PTR）
' mmsystem.h はバイト詰め（pshpack1）なので Pack(1)。64bit で wDeviceID の後ろに詰め物を入れない

Type MCI_OPEN_PARMS Pack(1)
    dwCallback As DWORD_PTR
    wDeviceID As DWord
    lpstrDeviceType As BytePtr
    lpstrElementName As BytePtr
    lpstrAlias As BytePtr
End Type

Type MCI_PLAY_PARMS Pack(1)
    dwCallback As DWORD_PTR
    dwFrom As DWord
    dwTo As DWord
End Type

Type MCI_SEEK_PARMS Pack(1)
    dwCallback As DWORD_PTR
    dwTo As DWord
End Type

Type MCI_SET_PARMS Pack(1)
    dwCallback As DWORD_PTR
    dwTimeFormat As DWord
    dwAudio As DWord
End Type

Type MCI_STATUS_PARMS Pack(1)
    dwCallback As DWORD_PTR
    dwReturn As DWord
    dwItem As DWord
    dwTrack As DWord
End Type

