' MCI の構造体

Type MCI_OPEN_PARMS
    dwCallback As DWord
    wDeviceID As DWord
    lpstrDeviceType As BytePtr
    lpstrElementName As BytePtr
    lpstrAlias As BytePtr
End Type

Type MCI_PLAY_PARMS
    dwCallback As DWord
    dwFrom As DWord
    dwTo As DWord
End Type

Type MCI_SEEK_PARMS
    dwCallback As DWord
    dwTo As DWord
End Type

Type MCI_SET_PARMS
    dwCallback As DWord
    dwTimeFormat As DWord
    dwAudio As DWord
End Type

Type MCI_STATUS_PARMS
    dwCallback As DWord
    dwReturn As DWord
    dwItem As DWord
    dwTrack As DWord
End Type

