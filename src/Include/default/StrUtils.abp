' StrUtils.abp - string / path helpers (default 自動読込)
' Note: do not use "\" string literals (lexer eats closing quote).

Const STRU_CH_SP = 32
Const STRU_CH_TAB = 9
Const STRU_CH_CR = 13
Const STRU_CH_NL = 10
Const STRU_CH_BSLASH = 92
Const STRU_CH_SLASH = 47
Const STRU_CH_DOT = 46

Function StrU_ToLowerChar(c As Long) As Long
    If c >= Asc("A") And c <= Asc("Z") Then
        StrU_ToLowerChar = c + 32
    Else
        StrU_ToLowerChar = c
    End If
End Function

Function IsSpace(c As Long) As Long
    If c = STRU_CH_SP Or c = STRU_CH_TAB Or c = STRU_CH_CR Or c = STRU_CH_NL Then
        IsSpace = 1
    Else
        IsSpace = 0
    End If
End Function

Function Trim$(s As String) As String
    Dim p As *Byte
    Dim i As Long
    Dim j As Long
    Dim n As Long
    n = Len(s)
    If n = 0 Then
        Trim$ = ""
        Exit Function
    End If
    p = StrPtr(s)
    i = 0
    While i < n And IsSpace(p[i]) <> 0
        i = i + 1
    Wend
    j = n - 1
    While j >= i And IsSpace(p[j]) <> 0
        j = j - 1
    Wend
    If j < i Then
        Trim$ = ""
    Else
        Trim$ = Mid$(s, i + 1, j - i + 1)
    End If
End Function

Function Lower$(s As String) As String
    Dim p As *Byte
    Dim i As Long
    Dim n As Long
    Dim c As Long
    Dim r As String
    n = Len(s)
    If n = 0 Then
        Lower$ = ""
        Exit Function
    End If
    r = Mid$(s, 1, n)
    p = StrPtr(r)
    For i = 0 To n - 1
        c = p[i]
        If c >= Asc("A") And c <= Asc("Z") Then p[i] = c + 32
    Next
    Lower$ = r
End Function

Function Hex$(n As Long) As String
    Dim digits As String
    Dim i As Long
    Dim d As Long
    Dim c As Long
    Dim out As String
    digits = "0123456789abcdef"
    If n = 0 Then
        Hex$ = "0"
        Exit Function
    End If
    out = ""
    While n <> 0
        d = n And 15
        n = n \ 16
        out = Mid$(digits, d + 1, 1) + out
    Wend
    Hex$ = out
End Function

Function Val(s As String) As Long
    Dim p As *Byte
    Dim i As Long
    Dim n As Long
    Dim c As Long
    Dim sign As Long
    Dim v As Long
    Val = 0
    n = Len(s)
    If n = 0 Then Exit Function
    p = StrPtr(s)
    i = 0
    While i < n And IsSpace(p[i]) <> 0
        i = i + 1
    Wend
    If i >= n Then Exit Function
    sign = 1
    If p[i] = Asc("-") Then
        sign = -1
        i = i + 1
    ElseIf p[i] = Asc("+") Then
        i = i + 1
    End If
    v = 0
    While i < n
        c = p[i]
        If c < Asc("0") Or c > Asc("9") Then Exit While
        v = v * 10 + (c - Asc("0"))
        i = i + 1
    Wend
    Val = v * sign
End Function

Function InStr(start As Long, hay As String, needle As String) As Long
    Dim hayPtr As *Byte
    Dim needlePtr As *Byte
    Dim i As Long
    Dim j As Long
    Dim nh As Long
    Dim nn As Long
    Dim ok As Long
    InStr = 0
    nh = Len(hay)
    nn = Len(needle)
    If nh = 0 Then Exit Function
    If nn = 0 Then
        InStr = start
        Exit Function
    End If
    If start < 1 Then start = 1
    If start > nh Then Exit Function
    If nn > nh Then Exit Function
    hayPtr = StrPtr(hay)
    needlePtr = StrPtr(needle)
    i = start - 1
    While i <= nh - nn
        ok = 1
        j = 0
        While j < nn
            If hayPtr[i + j] <> needlePtr[j] Then
                ok = 0
                j = nn
            Else
                j = j + 1
            End If
        Wend
        If ok <> 0 Then
            InStr = i + 1
            Exit Function
        End If
        i = i + 1
    Wend
End Function

Function StrEqCI(a As String, b As String) As Long
    If Lower$(a) = Lower$(b) Then
        StrEqCI = 1
    Else
        StrEqCI = 0
    End If
End Function

Function StartsWith(s As String, prefix As String) As Long
    Dim n As Long
    Dim m As Long
    Dim i As Long
    Dim srcPtr As *Byte
    Dim prefixPtr As *Byte
    StartsWith = 0
    n = Len(s)
    m = Len(prefix)
    If n < m Then Exit Function
    If m = 0 Then
        StartsWith = 1
        Exit Function
    End If
    srcPtr = StrPtr(s)
    prefixPtr = StrPtr(prefix)
    For i = 0 To m - 1
        If srcPtr[i] <> prefixPtr[i] Then Exit Function
    Next
    StartsWith = 1
End Function

Function StartsWithCI(s As String, prefix As String) As Long
    Dim n As Long
    Dim m As Long
    Dim i As Long
    Dim ca As Long
    Dim cb As Long
    Dim srcPtr As *Byte
    Dim prefixPtr As *Byte
    StartsWithCI = 0
    n = Len(s)
    m = Len(prefix)
    If n < m Then Exit Function
    If m = 0 Then
        StartsWithCI = 1
        Exit Function
    End If
    srcPtr = StrPtr(s)
    prefixPtr = StrPtr(prefix)
    For i = 0 To m - 1
        ca = StrU_ToLowerChar(srcPtr[i])
        cb = StrU_ToLowerChar(prefixPtr[i])
        If ca <> cb Then Exit Function
    Next
    StartsWithCI = 1
End Function

Function InStrCI(hay As String, needle As String) As Long
    Dim h As String
    Dim n As String
    h = Lower$(hay)
    n = Lower$(needle)
    InStrCI = InStr(1, h, n)
End Function

Function BaseName$(inPath As String) As String
    Dim i As Long
    Dim n As Long
    Dim c As Long
    Dim p As *Byte
    Dim dotPos As Long
    Dim slashPos As Long
    n = Len(inPath)
    dotPos = 0
    slashPos = 0
    If n > 0 Then
        p = StrPtr(inPath)
        For i = 0 To n - 1
            c = p[i]
            If c = STRU_CH_BSLASH Or c = STRU_CH_SLASH Then
                slashPos = i + 1
                dotPos = 0
            ElseIf c = STRU_CH_DOT Then
                dotPos = i + 1
            End If
        Next
    End If
    If dotPos > slashPos Then
        BaseName$ = Left$(inPath, dotPos - 1)
    Else
        BaseName$ = inPath
    End If
End Function

Function DirOf$(path As String) As String
    Dim i As Long
    Dim n As Long
    Dim c As Long
    Dim p As *Byte
    Dim slashPos As Long
    n = Len(path)
    slashPos = 0
    If n > 0 Then
        p = StrPtr(path)
        For i = 0 To n - 1
            c = p[i]
            If c = STRU_CH_BSLASH Or c = STRU_CH_SLASH Then
                slashPos = i + 1
            End If
        Next
    End If
    If slashPos > 0 Then
        DirOf$ = Left$(path, slashPos)
    Else
        DirOf$ = ""
    End If
End Function

Function FileNameOnly$(path As String) As String
    Dim d As String
    Dim n As Long
    d = DirOf$(path)
    n = Len(d)
    If n = 0 Then
        FileNameOnly$ = path
    Else
        FileNameOnly$ = Mid$(path, n + 1, Len(path) - n)
    End If
End Function

Function EndsWithExt(path As String, ext As String) As Long
    Dim n As Long
    Dim m As Long
    Dim i As Long
    Dim ca As Long
    Dim cb As Long
    Dim pathPtr As *Byte
    Dim extPtr As *Byte
    n = Len(path)
    m = Len(ext)
    EndsWithExt = 0
    If n < m Then Exit Function
    If m = 0 Then
        EndsWithExt = 1
        Exit Function
    End If
    pathPtr = StrPtr(path)
    extPtr = StrPtr(ext)
    For i = 0 To m - 1
        ca = StrU_ToLowerChar(pathPtr[n - m + i])
        cb = StrU_ToLowerChar(extPtr[i])
        If ca <> cb Then Exit Function
    Next
    EndsWithExt = 1
End Function

Function ChangeExtension$(inPath As String, newExt As String) As String
    ChangeExtension$ = BaseName$(inPath) + newExt
End Function
