' StringGc.abp — String ヒープ GC（default 常時読込）
'
' 公開: StrHeapAlloc / StrGcMarkPrecise / StrGcMarkCons / StrCollect
' 組込（コンパイラ注入）: StrGcRegion / StrGcGlobals / StrGcUserBssSize /
'   StrGcInRange / GcMarkUserBss / GcMarkStack
'
' BSS レイアウトはコンパイラの GC_HDR_* と一致（docs/string-gc.md）。
' 見出しは各 8 バイト枠（32/64 共通）。blocks[]（8 バイト枠）と marks[]（1 バイト）は
' ヒープに置き、満ちたら StrGcGrow が倍にする（数の上限は無い）。
' conservative 走査（BSS/スタック）は IR スタブ（stdcall 安定・軽量）。

Const STRGC_INIT_CAP = 1024
Const STRGC_SLOT = 8
Const STRGC_HEAP_ZERO = &H8
Const STRGC_HDR_COUNT = 0
Const STRGC_HDR_CAP = 8
Const STRGC_HDR_BLOCKS = 16
Const STRGC_HDR_MARKS = 24
Const STRGC_HDR_PRECISE_COUNT = 32
Const STRGC_HDR_PRECISE_ROOTS = 40

Type StrGcSlot
    p As VoidPtr
End Type

Function StrGcByteAt(region As VoidPtr, off As Long) As BytePtr
    Dim b As BytePtr
    b = region
    StrGcByteAt = VarPtr(b[off])
End Function

' 見出しの 8 バイト枠の Long（上位は 0 のまま）
Function StrGcHdrLong(off As Long) As Long
    Dim p As *Long
    p = StrGcByteAt(StrGcRegion(), off)
    StrGcHdrLong = p[0]
End Function

Sub StrGcSetHdrLong(off As Long, n As Long)
    Dim p As *Long
    p = StrGcByteAt(StrGcRegion(), off)
    p[0] = n
    p[1] = 0
End Sub

' 見出しの 8 バイト枠のポインタ（blocks[] / marks[] の先頭）
Function StrGcHdrPtr(off As Long) As BytePtr
    Dim s As *StrGcSlot
    s = StrGcByteAt(StrGcRegion(), off)
    StrGcHdrPtr = s[0].p
End Function

Sub StrGcSetHdrPtr(off As Long, p As VoidPtr)
    Dim s As *StrGcSlot
    s = StrGcByteAt(StrGcRegion(), off)
    s[0].p = p
End Sub

Function StrGcGetCount() As Long
    StrGcGetCount = StrGcHdrLong(STRGC_HDR_COUNT)
End Function

Sub StrGcSetCount(n As Long)
    StrGcSetHdrLong(STRGC_HDR_COUNT, n)
End Sub

Function StrGcGetBlock(i As Long) As VoidPtr
    Dim s As *StrGcSlot
    s = StrGcByteAt(StrGcHdrPtr(STRGC_HDR_BLOCKS), i * STRGC_SLOT)
    StrGcGetBlock = s[0].p
End Function

Sub StrGcSetBlock(i As Long, base As VoidPtr)
    Dim s As *StrGcSlot
    s = StrGcByteAt(StrGcHdrPtr(STRGC_HDR_BLOCKS), i * STRGC_SLOT)
    s[0].p = base
End Sub

Function StrGcGetMark(i As Long) As Long
    Dim m As BytePtr
    m = StrGcHdrPtr(STRGC_HDR_MARKS)
    StrGcGetMark = m[i]
End Function

Sub StrGcSetMark(i As Long, v As Long)
    Dim m As BytePtr
    m = StrGcHdrPtr(STRGC_HDR_MARKS)
    m[i] = v And 255
End Sub

' 見出し off の表（n バイト）を nw に写し、古い表を解放して nw に差し替える
Sub StrGcMoveTable(off As Long, nw As VoidPtr, n As Long)
    Dim old As VoidPtr
    old = StrGcHdrPtr(off)
    If old <> 0 Then
        memcpy(nw, old, n)
        HeapFree(GetProcessHeap(), 0, old)
    End If
    StrGcSetHdrPtr(off, nw)
End Sub

' blocks[] と marks[] を倍にする。戻り値 0 : メモリが足りない（表はそのまま）
Function StrGcGrow() As Long
    Dim heap As HANDLE
    Dim cap As Long, newCap As Long
    Dim nb As VoidPtr, nm As VoidPtr
    StrGcGrow = 0
    heap = GetProcessHeap()
    cap = StrGcHdrLong(STRGC_HDR_CAP)
    newCap = cap * 2
    If newCap < STRGC_INIT_CAP Then newCap = STRGC_INIT_CAP
    nb = HeapAlloc(heap, STRGC_HEAP_ZERO, newCap * STRGC_SLOT)
    nm = HeapAlloc(heap, STRGC_HEAP_ZERO, newCap)
    If nb = 0 Or nm = 0 Then
        If nb <> 0 Then HeapFree(heap, 0, nb)
        If nm <> 0 Then HeapFree(heap, 0, nm)
        Exit Function
    End If
    StrGcMoveTable(STRGC_HDR_BLOCKS, nb, cap * STRGC_SLOT)
    StrGcMoveTable(STRGC_HDR_MARKS, nm, cap)
    StrGcSetHdrLong(STRGC_HDR_CAP, newCap)
    StrGcGrow = 1
End Function

Function StrGcGetPrecCount() As Long
    Dim p As *Long
    p = StrGcByteAt(StrGcRegion(), STRGC_HDR_PRECISE_COUNT)
    StrGcGetPrecCount = p[0]
End Function

Function StrGcGetPrecRoot(i As Long) As Long
    Dim pr As *Long
    pr = StrGcByteAt(StrGcRegion(), STRGC_HDR_PRECISE_ROOTS)
    StrGcGetPrecRoot = pr[i]
End Function

Function StrHeapAlloc(nbytes As Long) As VoidPtr
    Dim heap As HANDLE
    Dim base As VoidPtr
    Dim n As Long

    StrHeapAlloc = 0
    heap = GetProcessHeap()
    base = HeapAlloc(heap, 0, nbytes)
    If base = 0 Then Exit Function
    n = StrGcGetCount()
    If n >= StrGcHdrLong(STRGC_HDR_CAP) Then StrGcGrow()
    If n < StrGcHdrLong(STRGC_HDR_CAP) Then
        StrGcSetBlock(n, base)
        StrGcSetCount(n + 1)
    End If
    StrHeapAlloc = base
End Function

Sub StrGcMarkOne(ptr As VoidPtr)
    Dim i As Long
    Dim n As Long
    Dim base As VoidPtr
    Dim bp As BytePtr
    Dim hdr As *Long
    Dim ln As Long
    Dim user As VoidPtr
    Dim endp As VoidPtr
    Dim ub As BytePtr

    If ptr = 0 Then Exit Sub
    n = StrGcGetCount()
    i = 0
    While i < n
        base = StrGcGetBlock(i)
        If base <> 0 Then
            bp = base
            hdr = VarPtr(bp[0])
            ln = hdr[0] And 2147483647
            user = VarPtr(bp[4])
            ub = user
            endp = VarPtr(ub[ln])
            If StrGcInRange(ptr, user, endp) <> 0 Then
                StrGcSetMark(i, 1)
                Exit Sub
            End If
        End If
        i = i + 1
    Wend
End Sub

Sub StrGcMarkPrecise(p As VoidPtr)
    StrGcMarkOne(p)
End Sub

Sub StrGcMarkCons(p As VoidPtr)
    StrGcMarkOne(p)
End Sub

Sub StrGcMarkPrecRoots()
    Dim i As Long
    Dim n As Long
    Dim off As Long
    Dim g As BytePtr
    Dim s As *StrGcSlot

    n = StrGcGetPrecCount()
    g = StrGcGlobals()
    i = 0
    While i < n
        off = StrGcGetPrecRoot(i)
        s = VarPtr(g[off])
        StrGcMarkPrecise(s[0].p)
        i = i + 1
    Wend
End Sub

Sub StrGcSweepOne(i As Long)
    Dim last As Long
    Dim base As VoidPtr

    base = StrGcGetBlock(i)
    HeapFree(GetProcessHeap(), 0, base)
    last = StrGcGetCount() - 1
    StrGcSetBlock(i, StrGcGetBlock(last))
    StrGcSetMark(i, StrGcGetMark(last))
    StrGcSetCount(last)
End Sub

Sub StrGcSweep()
    Dim i As Long
    Dim n As Long

    i = StrGcGetCount() - 1
    While i >= 0
        n = StrGcGetCount()
        If i >= n Then
            i = n - 1
        ElseIf StrGcGetMark(i) = 0 Then
            StrGcSweepOne(i)
        Else
            i = i - 1
        End If
    Wend
End Sub

Sub StrGcClearMarks()
    Dim i As Long
    Dim n As Long

    n = StrGcGetCount()
    i = 0
    While i < n
        StrGcSetMark(i, 0)
        i = i + 1
    Wend
End Sub

Sub StrCollect()
    StrGcMarkPrecRoots()
    GcMarkUserBss()
    GcMarkStack()
    StrGcSweep()
    StrGcClearMarks()
End Sub
