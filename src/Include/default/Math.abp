' Math.abp — IEEE754 Double 数学ライブラリ（default 常時読込）
'
' 角度はラジアン（Double）。Sin(1.570796) ≒ 1.0
'
' 注意: actba64 はネストした関数呼び出しが壊れるため、呼び出しは一時変数経由にする

' 定数（Const は小数未対応のため Dim + 代入）
Dim MATH_PI As Double
Dim MATH_HPI As Double
Dim MATH_PI2 As Double
Dim MATH_E As Double

MATH_PI = 3.142
MATH_HPI = 1.571
MATH_PI2 = 6.283
MATH_E = 2.718

' 整数除算（グラフィック等のピクセル演算用）
Function MathDiv(a As Long, b As Long) As Long
    Dim neg As Long
    Dim n As Long
    Dim d As Long
    Dim q As Long

    MathDiv = 0
    If b = 0 Then Exit Function
    neg = 0
    n = a
    d = b
    If n < 0 Then
        neg = 1
        n = 0 - n
    End If
    If d < 0 Then
        If neg <> 0 Then
            neg = 0
        Else
            neg = 1
        End If
        d = 0 - d
    End If
    q = 0
    While n >= d
        n = n - d
        q = q + 1
    Wend
    If neg <> 0 Then
        MathDiv = 0 - q
    Else
        MathDiv = q
    End If
End Function

Function AbsLong(n As Long) As Long
    If n < 0 Then
        AbsLong = 0 - n
    Else
        AbsLong = n
    End If
End Function

Function Abs(n As Double) As Double
    If n < 0 Then
        Abs = 0 - n
    Else
        Abs = n
    End If
End Function

Function Sgn(n As Double) As Double
    If n > 0 Then
        Sgn = 1
    ElseIf n < 0 Then
        Sgn = -1
    Else
        Sgn = 0
    End If
End Function

Function Min(a As Double, b As Double) As Double
    If a < b Then
        Min = a
    Else
        Min = b
    End If
End Function

Function Max(a As Double, b As Double) As Double
    If a > b Then
        Max = a
    Else
        Max = b
    End If
End Function

Function Sqr(n As Double) As Double
    Dim x As Double
    Dim y As Double
    Dim i As Long

    Sqr = 0
    If n <= 0 Then Exit Function
    x = n
    i = 0
    Do
        y = (x + n / x) / 2
        If y >= x Then Exit Do
        x = y
        i = i + 1
        If i > 24 Then Exit Do
    Loop
    Sqr = x
End Function

Function DegToRad(deg As Double) As Double
    DegToRad = deg * MATH_PI / 180
End Function

Function RadToDeg(rad As Double) As Double
    RadToDeg = rad * 180 / MATH_PI
End Function

Function MathNormPi(ang As Double) As Double
    Dim a As Double
    a = ang
    While a >= MATH_PI2
        a = a - MATH_PI2
    Wend
    While a < 0
        a = a + MATH_PI2
    Wend
    If a > MATH_PI Then a = a - MATH_PI2
    MathNormPi = a
End Function

Function MathSinMac(x As Double) As Double
    Dim t As Double
    Dim s As Double
    Dim x2 As Double
    Dim k As Long
    Dim den As Double

    t = x
    s = x
    x2 = x * x
    k = 1
    Do
        den = (k + k) * (k + k + 1)
        t = 0 - t * x2 / den
        If t = 0 Then Exit Do
        s = s + t
        k = k + 1
        If k > 16 Then Exit Do
    Loop
    MathSinMac = s
End Function

Function MathCosMac(x As Double) As Double
    Dim t As Double
    Dim s As Double
    Dim x2 As Double
    Dim k As Long
    Dim den As Double

    t = 1
    s = 1
    x2 = x * x
    k = 1
    Do
        den = (k + k - 1) * (k + k)
        t = 0 - t * x2 / den
        If t = 0 Then Exit Do
        s = s + t
        k = k + 1
        If k > 16 Then Exit Do
    Loop
    MathCosMac = s
End Function

Function Sin(ang As Double) As Double
    Dim x As Double
    Dim neg As Long
    Dim v As Double

    x = MathNormPi(ang)
    neg = 0
    If x < 0 Then
        neg = 1
        x = 0 - x
    End If
    If x > MATH_HPI Then x = MATH_PI - x
    v = MathSinMac(x)
    If v > 1 Then v = 1
    If neg <> 0 Then
        Sin = 0 - v
    Else
        Sin = v
    End If
End Function

Function Cos(ang As Double) As Double
    Dim x As Double
    Dim sign As Double
    Dim v As Double

    x = MathNormPi(ang)
    sign = 1
    If x < 0 Then x = 0 - x
    If x > MATH_HPI Then
        x = MATH_PI - x
        sign = -1
    End If
    v = MathCosMac(x)
    If v > 1 Then v = 1
    If v < 0 Then v = 0
    Cos = sign * v
End Function

Function Tan(ang As Double) As Double
    Dim c As Double
    Dim s As Double
    c = Cos(ang)
    s = Sin(ang)
    If c = 0 Then
        If s >= 0 Then
            Tan = 1000000
        Else
            Tan = -1000000
        End If
        Exit Function
    End If
    Tan = s / c
End Function

Function SinDeg(deg As Double) As Double
    Dim r As Double
    r = DegToRad(deg)
    SinDeg = Sin(r)
End Function

Function CosDeg(deg As Double) As Double
    Dim r As Double
    r = DegToRad(deg)
    CosDeg = Cos(r)
End Function

Function MathAtnMac(x As Double) As Double
    Dim t As Double
    Dim s As Double
    Dim x2 As Double
    Dim n As Double
    Dim term As Double

    t = x
    s = x
    x2 = x * x
    n = 3
    Do
        t = 0 - t * x2
        term = t / n
        If term = 0 Then Exit Do
        s = s + term
        n = n + 2
        If n > 40 Then Exit Do
    Loop
    MathAtnMac = s
End Function

Function Atn(x As Double) As Double
    Dim ax As Double
    Dim v As Double
    Dim inv As Double

    ax = Abs(x)
    If ax <= 1 Then
        v = MathAtnMac(ax)
    Else
        inv = 1 / ax
        v = MathAtnMac(inv)
        v = MATH_HPI - v
    End If
    If x < 0 Then
        Atn = 0 - v
    Else
        Atn = v
    End If
End Function

Function Exp(x As Double) As Double
    Dim t As Double
    Dim s As Double
    Dim k As Long
    Dim xx As Double

    xx = x
    If xx > 40 Then xx = 40
    If xx < -40 Then xx = -40

    t = 1
    s = 1
    k = 1
    Do
        t = t * xx / k
        If t = 0 Then Exit Do
        s = s + t
        k = k + 1
        If k > 32 Then Exit Do
    Loop
    If s < 0 Then s = 0
    Exp = s
End Function
