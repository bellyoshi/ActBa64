' BasicCmd - MsgBox / Window / Cls / Beep / パス / Date$ / Time$
' Inkey$ / Input$ は N88BASIC モードのみ（Include\N88BASIC\n88key.abp）

Dim g_basicWndOk As Long
Dim g_basicClsName As String
Dim g_clsInfo(31) As Byte
Dim g_st(15) As Byte

Const BASIC_STD_OUT = &HFFFFFFF5

Sub BasicBeep()
    MessageBeep(0)
End Sub

' UTF-8 のバイト列を、ANSI API へ渡す CP932（末尾 0）へ。変換できないときは元のポインタ。
Function BasicUtf8Chars(p As *Byte, n As Long) As Long
    BasicUtf8Chars = 0
    If n <= 0 Then Exit Function
    BasicUtf8Chars = MultiByteToWideChar(65001, 8, p, n, 0, 0)
End Function

Function BasicWideBuf(chars As Long) As *Byte
    BasicWideBuf = 0
    If chars <= 0 Then Exit Function
    BasicWideBuf = malloc((chars + 1) * 2)
End Function

Function BasicToWide(p As *Byte, n As Long, chars As Long) As *Byte
    Dim wide As *Byte
    BasicToWide = 0
    wide = BasicWideBuf(chars)
    If wide = 0 Then Exit Function
    BasicToWide = wide
    If MultiByteToWideChar(65001, 8, p, n, wide, chars) > 0 Then Exit Function
    free(wide)
    BasicToWide = 0
End Function

Function BasicCpLen(wide As *Byte, chars As Long) As Long
    BasicCpLen = 0
    If chars <= 0 Then Exit Function
    BasicCpLen = WideCharToMultiByte(932, 0, wide As *Word, chars, 0, 0, 0, 0)
End Function

Function BasicCpBuf(n As Long) As *Byte
    Dim p As *Byte
    BasicCpBuf = 0
    If n <= 0 Then Exit Function
    p = malloc(n + 1)
    BasicCpBuf = p
    If p = 0 Then Exit Function
    p[n] = 0
End Function

Function BasicFillCp(wide As *Byte, chars As Long, p As *Byte, n As Long) As Long
    BasicFillCp = 0
    If p = 0 Then Exit Function
    BasicFillCp = WideCharToMultiByte(932, 0, wide As *Word, chars, p, n, 0, 0)
End Function

Function BasicCpKeep(p As *Byte, ok As Long) As *Byte
    BasicCpKeep = 0
    If ok > 0 Then BasicCpKeep = p
    If ok > 0 Then Exit Function
    If p <> 0 Then free(p)
End Function

Function BasicCpOfWide(wide As *Byte, chars As Long) As *Byte
    Dim n As Long, p As *Byte
    n = BasicCpLen(wide, chars)
    p = BasicCpBuf(n)
    BasicCpOfWide = BasicCpKeep(p, BasicFillCp(wide, chars, p, n))
End Function

Function BasicCpFree(wide As *Byte, chars As Long) As *Byte
    BasicCpFree = BasicCpOfWide(wide, chars)
    free(wide)
End Function

Function BasicAnsiPtr(raw As *Byte) As *Byte
    Dim n As Long, chars As Long, wide As *Byte
    BasicAnsiPtr = raw
    If raw = 0 Then Exit Function
    n = lstrlen(raw)
    chars = BasicUtf8Chars(raw, n)
    wide = BasicToWide(raw, n, chars)
    If wide = 0 Then Exit Function
    BasicAnsiPtr = BasicCpFree(wide, chars)
End Function

Sub BasicFreeAnsi(p As *Byte, raw As *Byte)
    If p = 0 Or p = raw Then Exit Sub
    free(p)
End Sub

' 二重 NUL までのバイト数。フィルタの区間区切りを残すため lstrlen は使わない。
Function BasicMultiSpan(p As *Byte) As Long
    Dim i As Long
    BasicMultiSpan = 0
    If p = 0 Then Exit Function
    i = 0
    While (p[i] <> 0) Or (p[i + 1] <> 0)
        i = i + 1
    Wend
    BasicMultiSpan = i + 2
End Function

Function BasicSegLen(p As *Byte, at As Long) As Long
    Dim i As Long
    i = at
    While p[i] <> 0
        i = i + 1
    Wend
    BasicSegLen = i - at
End Function

Function BasicCopyAt(dst As *Byte, at As Long, src As *Byte, n As Long) As Long
    Dim i As Long
    i = 0
    While i < n
        dst[at + i] = src[i]
        i = i + 1
    Wend
    dst[at + n] = 0
    BasicCopyAt = at + n + 1
End Function

Function BasicAnsiSeg(p As *Byte, at As Long, n As Long) As *Byte
    Dim chars As Long, wide As *Byte
    chars = BasicUtf8Chars(VarPtr(p[at]), n)
    wide = BasicToWide(VarPtr(p[at]), n, chars)
    BasicAnsiSeg = 0
    If wide = 0 Then Exit Function
    BasicAnsiSeg = BasicCpFree(wide, chars)
End Function

Function BasicTakeSeg(raw As *Byte, i As Long, ByRef n As Long) As *Byte
    n = BasicSegLen(raw, i)
    BasicTakeSeg = BasicAnsiSeg(raw, i, n)
End Function

Function BasicMultiStep(raw As *Byte, dst As *Byte, ByRef at As Long, ByRef i As Long) As Long
    Dim n As Long, seg As *Byte
    seg = BasicTakeSeg(raw, i, n)
    BasicMultiStep = 0
    If seg = 0 Then Exit Function
    at = BasicCopyAt(dst, at, seg, lstrlen(seg))
    free(seg)
    i = i + n + 1
    BasicMultiStep = 1
End Function

Function BasicMultiRun(raw As *Byte, dst As *Byte, n As Long, ByRef at As Long) As Long
    Dim i As Long
    i = 0
    at = 0
    BasicMultiRun = 0
    While i < n - 2
        If BasicMultiStep(raw, dst, at, i) = 0 Then Exit Function
    Wend
    BasicMultiRun = 1
End Function

Function BasicMultiDrop(dst As *Byte, ok As Long) As *Byte
    BasicMultiDrop = dst
    If ok <> 0 Then Exit Function
    free(dst)
    BasicMultiDrop = 0
End Function

Function BasicMultiStore(raw As *Byte, n As Long) As *Byte
    Dim dst As *Byte, at As Long
    dst = malloc(n)
    BasicMultiStore = 0
    If dst = 0 Then Exit Function
    dst = BasicMultiDrop(dst, BasicMultiRun(raw, dst, n, at))
    If dst = 0 Then Exit Function
    dst[at] = 0
    BasicMultiStore = dst
End Function

Function BasicAnsiMulti(raw As *Byte) As *Byte
    Dim n As Long, p As *Byte
    BasicAnsiMulti = raw
    If raw = 0 Then Exit Function
    n = BasicMultiSpan(raw)
    If n <= 2 Then Exit Function
    p = BasicMultiStore(raw, n)
    If p <> 0 Then BasicAnsiMulti = p
End Function

Function BasicOfnConv(raw As VoidPtr, multi As Long) As VoidPtr
    BasicOfnConv = raw
    If raw = 0 Then Exit Function
    If multi <> 0 Then BasicOfnConv = BasicAnsiMulti(raw As *Byte)
    If multi = 0 Then BasicOfnConv = BasicAnsiPtr(raw As *Byte)
End Function

Sub BasicOfnPrep(ByRef ofn As OPENFILENAME, ByRef f As VoidPtr, ByRef t As VoidPtr, ByRef d As VoidPtr, ByRef e As VoidPtr)
    f = ofn.lpstrFilter
    t = ofn.lpstrTitle
    d = ofn.lpstrInitialDir
    e = ofn.lpstrDefExt
    ofn.lpstrFilter = BasicOfnConv(f, 1)
    ofn.lpstrTitle = BasicOfnConv(t, 0)
    ofn.lpstrInitialDir = BasicOfnConv(d, 0)
    ofn.lpstrDefExt = BasicOfnConv(e, 0)
End Sub

Sub BasicOfnUndo(ByRef ofn As OPENFILENAME, f As VoidPtr, t As VoidPtr, d As VoidPtr, e As VoidPtr)
    BasicFreeAnsi(ofn.lpstrFilter As *Byte, f As *Byte)
    BasicFreeAnsi(ofn.lpstrTitle As *Byte, t As *Byte)
    BasicFreeAnsi(ofn.lpstrInitialDir As *Byte, d As *Byte)
    BasicFreeAnsi(ofn.lpstrDefExt As *Byte, e As *Byte)
    ofn.lpstrFilter = f
    ofn.lpstrTitle = t
    ofn.lpstrInitialDir = d
    ofn.lpstrDefExt = e
End Sub

Function GetOpenFileName(ByRef lpofn As OPENFILENAME) As Long
    Dim f As VoidPtr, t As VoidPtr, d As VoidPtr, e As VoidPtr
    BasicOfnPrep(lpofn, f, t, d, e)
    GetOpenFileName = GetOpenFileNameA(lpofn)
    BasicOfnUndo(lpofn, f, t, d, e)
End Function

Function GetSaveFileName(ByRef lpofn As OPENFILENAME) As Long
    Dim f As VoidPtr, t As VoidPtr, d As VoidPtr, e As VoidPtr
    BasicOfnPrep(lpofn, f, t, d, e)
    GetSaveFileName = GetSaveFileNameA(lpofn)
    BasicOfnUndo(lpofn, f, t, d, e)
End Function

Function MessageBox(hWnd As HWND, text As *Byte, title As *Byte, typ As DWord) As Long
    Dim a As *Byte, b As *Byte
    a = BasicAnsiPtr(text)
    b = BasicAnsiPtr(title)
    MessageBox = MessageBoxA(hWnd, a, b, typ)
    BasicFreeAnsi(a, text)
    BasicFreeAnsi(b, title)
End Function

Function BasicMsgBox(hWnd As HWND, text As String, title As String, typ As DWord) As Long
    BasicMsgBox = MessageBox(hWnd, StrPtr(text), StrPtr(title), typ)
End Function

Function BasicDelWnd(hWnd As HWND) As Long
    BasicDelWnd = DestroyWindow(hWnd)
End Function

Function BasicChDir(path As String) As Long
    BasicChDir = SetCurrentDirectoryA(StrPtr(path))
End Function

Function BasicMkDir(path As String) As Long
    BasicMkDir = CreateDirectoryA(StrPtr(path), 0)
End Function

Function BasicKill(path As String) As Long
    BasicKill = DeleteFileA(StrPtr(path))
End Function

Function BasicExec(path As String, cmd As String) As Long
    Dim op(7) As Byte
    lstrcpy(VarPtr(op), "open")
    BasicExec = ShellExecuteA(0, VarPtr(op), StrPtr(path), StrPtr(cmd), 0, SW_SHOWNORMAL)
End Function

Function BasicWndProc(hWnd As HWND, msg As DWord, wParam As WPARAM, lParam As LPARAM) As LRESULT
    BasicWndProc = DefWindowProc(hWnd, msg, wParam, lParam)
End Function

Sub BasicInitClsName()
    If Len(g_basicClsName) <> 0 Then Exit Sub
    g_basicClsName = "ActBa64Wnd"
End Sub

Sub BasicFillWnd(ByRef wc As WNDCLASSEX)
    FillMemory(VarPtr(wc), Len(wc), 0)
    wc.cbSize = Len(wc)
    wc.lpfnWndProc = AddressOf(BasicWndProc)
    wc.hInstance = GetModuleHandle(0)
    wc.style = CS_HREDRAW Or CS_VREDRAW
    wc.lpszClassName = StrPtr(g_basicClsName)
End Sub

Sub BasicEnsureWnd()
    Dim wc As WNDCLASSEX
    If g_basicWndOk <> 0 Then Exit Sub
    BasicInitClsName()
    BasicFillWnd(wc)
    If RegisterClassEx(wc) <> 0 Then g_basicWndOk = 1
End Sub

Function BasicWndClass$(className As String) As String
    If Len(className) <> 0 Then BasicWndClass$ = className
    If Len(className) <> 0 Then Exit Function
    BasicEnsureWnd()
    BasicWndClass$ = g_basicClsName
End Function

Function BasicWindow(ByRef hWnd As HWND, hOwner As HWND, x As Long, y As Long, w As Long, h As Long, title As String, style As DWord, className As String, id As HMENU, proc As Long, exStyle As DWord) As HWND
    Dim wndCls As String
    wndCls = BasicWndClass$(className)
    hWnd = CreateWindowEx(exStyle, StrPtr(wndCls), StrPtr(title), style, x, y, w, h, hOwner, id, GetModuleHandle(0), proc)
    BasicWindow = hWnd
End Function

Function BasicClsWord(off As Long) As Long
    BasicClsWord = g_clsInfo[off] + g_clsInfo[off + 1] * 256
End Function

Function BasicClsCells() As Long
    BasicClsCells = BasicClsWord(0) * BasicClsWord(2)
End Function

Function BasicClsFill(h As HANDLE, cells As Long) As Long
    Dim wrote As DWord
    FillConsoleOutputCharacterA(h, 32, cells, 0, wrote)
    BasicClsFill = SetConsoleCursorPosition(h, 0)
End Function

Function BasicClsGo(h As HANDLE) As Long
    BasicClsGo = 0
    If GetConsoleScreenBufferInfo(h, VarPtr(g_clsInfo)) = 0 Then Exit Function
    BasicClsGo = BasicClsFill(h, BasicClsCells())
End Function

Function BasicCls(n As Long) As Long
    BasicCls = 0
    If n < 0 Then Exit Function
    BasicCls = BasicClsGo(GetStdHandle(BASIC_STD_OUT))
End Function

Function BasicDig$(n As Long, place As Long) As String
    BasicDig$ = Chr$(48 + ((n \ place) Mod 10))
End Function

Function Basic2$(n As Long) As String
    Basic2$ = BasicDig$(n, 10) + BasicDig$(n, 1)
End Function

Function Basic4$(n As Long) As String
    Basic4$ = BasicDig$(n, 1000) + BasicDig$(n, 100) + Basic2$(n)
End Function

Function BasicStWord(off As Long) As Long
    BasicStWord = g_st[off] + g_st[off + 1] * 256
End Function

Function Date$() As String
    GetLocalTime(VarPtr(g_st))
    Date$ = Basic4$(BasicStWord(0)) + "/" + Basic2$(BasicStWord(2)) + "/" + Basic2$(BasicStWord(6))
End Function

Function Time$() As String
    GetLocalTime(VarPtr(g_st))
    Time$ = Basic2$(BasicStWord(8)) + ":" + Basic2$(BasicStWord(10)) + ":" + Basic2$(BasicStWord(12))
End Function

' N88 色番号 0..7。0 は黒（未設定の戻りと同じ）
Function GetBasicColor(code As Long) As Long
    If code = 1 Then GetBasicColor = 16711680
    If code = 2 Then GetBasicColor = 255
    If code = 3 Then GetBasicColor = 16711935
    If code = 4 Then GetBasicColor = 65280
    If code = 5 Then GetBasicColor = 16776960
    If code = 6 Then GetBasicColor = 65535
    If code = 7 Then GetBasicColor = 16777215
End Function
