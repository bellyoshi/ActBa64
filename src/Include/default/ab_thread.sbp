' スレッド

Declare Function CreateThread Lib "kernel32.dll" Alias "CreateThread" (ByRef lpThreadAttributes As SECURITY_ATTRIBUTES, dwStackSize As DWord, lpStartAddress As VoidPtr, lpParameter As VoidPtr, dwCreationFlags As DWord, lpThreadId As DWordPtr) As HANDLE

Declare Sub ExitThread Lib "kernel32.dll" (dwExitCode As DWord)

Declare Function GetCurrentThread Lib "kernel32.dll" () As HANDLE

Declare Function GetCurrentThreadId Lib "kernel32.dll" () As DWord

Const STILL_ACTIVE = &H00000103

Declare Function GetExitCodeThread Lib "kernel32.dll" (hThread As HANDLE, ByRef lpExitCode As DWord) As Long

Const THREAD_BASE_PRIORITY_LOWRT =  15

Const THREAD_BASE_PRIORITY_MAX =    2

Const THREAD_BASE_PRIORITY_MIN =   -2

Const THREAD_BASE_PRIORITY_IDLE =  -15

Const THREAD_PRIORITY_LOWEST =        THREAD_BASE_PRIORITY_MIN

Const THREAD_PRIORITY_BELOW_NORMAL =  THREAD_PRIORITY_LOWEST+1

Const THREAD_PRIORITY_NORMAL =        0

Const THREAD_PRIORITY_HIGHEST =       THREAD_BASE_PRIORITY_MAX

Const THREAD_PRIORITY_ABOVE_NORMAL =  THREAD_PRIORITY_HIGHEST-1

Const THREAD_PRIORITY_ERROR_RETURN =  LONG_MAX

Const THREAD_PRIORITY_TIME_CRITICAL = THREAD_BASE_PRIORITY_LOWRT

Const THREAD_PRIORITY_IDLE =          THREAD_BASE_PRIORITY_IDLE

Declare Function GetThreadPriority Lib "kernel32.dll" (hThread As HANDLE) As DWord

Declare Function ResumeThread Lib "kernel32.dll" (hThread As HANDLE) As DWord

Declare Function SetThreadPriority Lib "kernel32.dll" (hThread As HANDLE, nPriority As Long) As Long

Declare Function SuspendThread Lib "kernel32.dll" (hThread As HANDLE) As DWord

Declare Function TerminateThread Lib "kernel32.dll" (hThread As HANDLE, dwExitCode As DWord) As Long

