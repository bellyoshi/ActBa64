' ウィンドウメッセージの構造体

Type MINMAXINFO
    ptReserved As POINTAPI
    ptMaxSize As POINTAPI
    ptMaxPosition As POINTAPI
    ptMinTrackSize As POINTAPI
    ptMaxTrackSize As POINTAPI
End Type

Type DELETEITEMSTRUCT
    CtlType As DWord
    CtlID As DWord
    itemID As DWord
    hwndItem As HWND
    itemData As DWord
End Type

Type COMPAREITEMSTRUCT
    CtlType As DWord
    CtlID As DWord
    hwndItem As HWND
    itemID1 As DWord
    itemData1 As DWord
    itemID2 As DWord
    itemData2 As DWord
    dwLocaleId As DWord
End Type

Type WINDOWPOS
    hwnd As HWND
    hwndInsertAfter As HWND
    x As Long
    y As Long
    cx As Long
    cy As Long
    flags As DWord
End Type

Type COPYDATASTRUCT
    dwData As DWord
    cbData As DWord
    lpData As VoidPtr
End Type

Type HELPINFO
    cbSize As DWord
    iContextType As Long
    iCtrlId As Long
    hItemHandle As HANDLE
    dwContextId As DWord
    MousePos As POINTAPI
End Type

