' 仮想メモリ

Const PAGE_NOACCESS =          &H01

Const PAGE_READONLY =          &H02

Const PAGE_READWRITE =         &H04

Const PAGE_WRITECOPY =         &H08

Const PAGE_EXECUTE =           &H10

Const PAGE_EXECUTE_READ =      &H20

Const PAGE_EXECUTE_READWRITE = &H40

Const PAGE_EXECUTE_WRITECOPY = &H80

Const PAGE_GUARD =             &H100

Const PAGE_NOCACHE =           &H200

Const PAGE_WRITECOMBINE =      &H400

Const MEM_COMMIT =    &H1000

Const MEM_RESERVE =   &H2000

Const MEM_DECOMMIT =  &H4000

Const MEM_RELEASE =   &H8000

Const MEM_FREE =      &H10000

Const MEM_PRIVATE =   &H20000

Const MEM_MAPPED =    &H40000

Const MEM_RESET =     &H80000

Const MEM_TOP_DOWN =  &H100000

Const MEM_4MB_PAGES = &H80000000

Declare Function VirtualAlloc Lib "kernel32.dll" (lpAddress As VoidPtr, dwSize As SIZE_T, flAllocationType As DWord, flProtect As DWord) As VoidPtr

Declare Function VirtualFree Lib "kernel32.dll" (lpAddress As VoidPtr, dwSize As SIZE_T, dwFreeType As DWord) As Long

Declare Function VirtualLock Lib "kernel32.dll" (lpAddress As VoidPtr, dwSize As SIZE_T) As BOOL

Declare Function VirtualUnlock Lib "kernel32.dll" (lpAddress As VoidPtr, dwSize As SIZE_T) As BOOL

