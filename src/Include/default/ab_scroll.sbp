' スクロールバー

Type SCROLLINFO
    cbSize As Long
    fMask As Long
    nMin As Long
    nMax As Long
    nPage As Long
    nPos As Long
    nTrackPos As Long
End Type

Const SB_HORZ = 0

Const SB_CTL =  2

Const SB_BOTH = 3

Const ESB_ENABLE_BOTH =   &H0000

Const ESB_DISABLE_BOTH =  &H0003

Const ESB_DISABLE_LEFT =  &H0001

Const ESB_DISABLE_RIGHT = &H0002

Const ESB_DISABLE_UP =    &H0001

Const ESB_DISABLE_DOWN =  &H0002

Const ESB_DISABLE_LTUP =  ESB_DISABLE_LEFT

Const ESB_DISABLE_RTDN =  ESB_DISABLE_RIGHT

Declare Function EnableScrollBar Lib "user32.dll" (hWnd As HWND, dwSBflags As DWord, dwArrows As DWord) As Long

Declare Function GetScrollInfo Lib "user32.dll" (hWnd As HWND, fnBar As Long, ByRef lpsi As SCROLLINFO) As Long

Declare Function ScrollDC Lib "user32.dll" (hdc As HDC, dx As Long, dy As Long, ByRef lprcScroll As RECT, ByRef lprcClip As RECT, hrgnUpdate As HRGN, ByRef lprcUpdate As RECT) As Long

Const SW_SCROLLCHILDREN = &H0001

Const SW_INVALIDATE =     &H0002

Const SW_ERASE =          &H0004

Declare Function ScrollWindowEx Lib "user32.dll" (hWnd As HWND, dx As Long, dy As Long, ByRef lprcScroll As RECT, ByRef lprcClip As RECT, hrgnUpdate As HRGN, ByRef lprcUpdate As RECT, flags As DWord) As Long

Declare Function SetScrollInfo Lib "user32.dll" (hWnd As HWND, fnBar As Long, ByRef lpsi As SCROLLINFO, bRedraw As Long) As Long

Declare Function ShowScrollBar Lib "user32.dll" (hWnd As HWND, wBar As Long, bShow As Long) As Long

