' Data - Data / Read（-pN88 と -pAB2 のときだけ読む）
'   Data の項目はパーサがプログラムの先頭へ移す（Data_Str / Data_Num）。
'   Read はパーサが 変数 = Read_Str$() / Read_Num() にする。

Const DATA_MAX = 8192

Dim g_dataS(DATA_MAX - 1) As *Byte
Dim g_dataD(DATA_MAX - 1) As Double
Dim g_dataIsNum(DATA_MAX - 1) As Long
Dim g_dataN As Long
Dim g_dataPos As Long

' 何もしない文（Data の跡）
Sub Data_Nop()
End Sub

Sub Data_Str(s As *Byte)
    Dim p As *Byte
    If g_dataN >= DATA_MAX Then Exit Sub
    p = malloc(lstrlen(s) + 1)
    If p = 0 Then Exit Sub
    lstrcpy(p, s)
    g_dataS(g_dataN) = p
    g_dataIsNum(g_dataN) = 0
    g_dataN = g_dataN + 1
End Sub

Sub Data_Num(d As Double)
    If g_dataN >= DATA_MAX Then Exit Sub
    g_dataD(g_dataN) = d
    g_dataIsNum(g_dataN) = 1
    g_dataN = g_dataN + 1
End Sub

' Read 変数$ … 項目が尽きたら ""
Function Read_Str$() As String
    Dim i As Long
    Read_Str$ = ""
    If g_dataPos >= g_dataN Then Exit Function
    i = g_dataPos
    g_dataPos = i + 1
    If g_dataIsNum(i) <> 0 Then Read_Str$ = Str$(g_dataD(i))
    If g_dataIsNum(i) = 0 Then Read_Str$ = MakeStr(g_dataS(i))
End Function

' Read 変数 … 項目が尽きたら 0
Function Read_Num() As Double
    Dim i As Long
    Read_Num = 0
    If g_dataPos >= g_dataN Then Exit Function
    i = g_dataPos
    g_dataPos = i + 1
    If g_dataIsNum(i) <> 0 Then Read_Num = g_dataD(i)
    If g_dataIsNum(i) = 0 Then Read_Num = Val(MakeStr(g_dataS(i)))
End Function
