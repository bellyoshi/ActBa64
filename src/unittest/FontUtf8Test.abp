' CreateFontIndirect の書体名は UTF-8。GetObjectA で読むと CP932。
Dim lf As LOGFONT
Dim got As LOGFONT
Dim h As HFONT

FillMemory(VarPtr(lf), Len(lf), 0)
lf.lfHeight = -16
lf.lfWeight = FW_NORMAL
lf.lfCharSet = 128
lstrcpy(VarPtr(lf.lfFaceName), "ＭＳ ゴシック")
h = CreateFontIndirect(lf)
If h = 0 Then Assert(1, 0, "font")
FillMemory(VarPtr(got), Len(got), 0)
GetObject(h, Len(got), VarPtr(got))
Assert(&H82, got.lfFaceName[0], "f0")
Assert(&H6C, got.lfFaceName[1], "f1")
Assert(&H82, got.lfFaceName[2], "f2")
Assert(&H72, got.lfFaceName[3], "f3")
Assert(&H20, got.lfFaceName[4], "f4")
Assert(&H83, got.lfFaceName[5], "f5")
Assert(&H53, got.lfFaceName[6], "f6")
DeleteObject(h)
