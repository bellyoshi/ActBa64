' CreateFontIndirect の書体名は UTF-8。GetObjectA で読むと CP932、無印の GetObject で読むと UTF-8。
Dim lf As LOGFONT
Dim got As LOGFONT
Dim h As HFONT

FillMemory(VarPtr(lf), Len(lf), 0)
lf.lfHeight = -16
lf.lfWeight = FW_NORMAL
lf.lfCharSet = 128
lstrcpy(VarPtr(lf.lfFaceName), "ＭＳ ゴシック")
h = CreateFontIndirect(lf)
If h = 0 Then Assert(1, 0, "font")
FillMemory(VarPtr(got), Len(got), 0)
GetObjectA(h, Len(got), VarPtr(got))
AssertCp932(&H82, got.lfFaceName[0], "f0")
AssertCp932(&H6C, got.lfFaceName[1], "f1")
AssertCp932(&H82, got.lfFaceName[2], "f2")
AssertCp932(&H72, got.lfFaceName[3], "f3")
AssertCp932(&H20, got.lfFaceName[4], "f4")
AssertCp932(&H83, got.lfFaceName[5], "f5")
AssertCp932(&H53, got.lfFaceName[6], "f6")
FillMemory(VarPtr(got), Len(got), 0)
Assert(Len(got), GetObject(h, Len(got), VarPtr(got)), "fu len")
Assert(-1, MakeStr(VarPtr(got.lfFaceName)) = "ＭＳ ゴシック", "fu utf8")
Assert(-16, got.lfHeight, "fu height")
Assert(128, got.lfCharSet, "fu charset")
Assert(Len(got), GetObject(h, 0, 0), "fu need")
DeleteObject(h)
