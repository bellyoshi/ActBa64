' HPEN と HBITMAP はハンドル値のまま GDI へ渡す。赤い線が残る。
Dim screen As HDC
Dim mem As HDC
Dim bmp As HBITMAP
Dim pen As HPEN
Dim pix As Long

screen = GetDC(0)
mem = CreateCompatibleDC(screen)
bmp = CreateCompatibleBitmap(screen, 16, 16)
SelectObject(mem, bmp)
pen = CreatePen(0, 1, &H0000FF)
SelectObject(mem, pen)
MoveToEx(mem, 0, 4, 0)
LineTo(mem, 15, 4)
pix = GetPixel(mem, 8, 4)
Assert(&H0000FF, pix, "pen line")
DeleteObject(pen)
DeleteObject(bmp)
DeleteDC(mem)
ReleaseDC(0, screen)
