' 実数リテラルは Double の精度で読む。以前は小数部 9 桁で打ち切っていて、π や 1e-10 がずれていた。
Function FlpHi(d As Double) As Long
    Dim bits(1) As Long
    memcpy(VarPtr(bits), VarPtr(d), 8)
    FlpHi = bits[1]
End Function

Function FlpLo(d As Double) As Long
    Dim bits(1) As Long
    memcpy(VarPtr(bits), VarPtr(d), 8)
    FlpLo = bits[0]
End Function

Sub FlpCheck(d As Double, hi As Long, lo As Long, name As String)
    Assert(hi, FlpHi(d), name & " hi")
    Assert(lo, FlpLo(d), name & " lo")
End Sub

FlpCheck(0.1, &H3FB99999, &H9999999A, "0.1")
FlpCheck(3.141592653589793, &H400921FB, &H54442D18, "pi")
FlpCheck(2.718281828459045, &H4005BF0A, &H8B145769, "e")
FlpCheck(0.0000000001, &H3DDB7CDF, &HD9D7BDBB, "1e-10")
FlpCheck(0.30000000000000004, &H3FD33333, &H33333334, "0.30000000000000004")
FlpCheck(12345678901234567890.5, &H43E56A95, &H319D63E1, "12345678901234567890.5")
FlpCheck(0.000000000931322574615478515625, &H3E100000, 0, "2^-30")
FlpCheck(1.7976931348623157, &H3FFCC359, &HE067A348, "1.7976931348623157")
FlpCheck(123456.789012345678901, &H40FE240C, &H9FCB68CD, "123456.789012345678901")
FlpCheck(.5, &H3FE00000, 0, ".5")
FlpCheck(1., &H3FF00000, 0, "1.")
FlpCheck(0.0, 0, 0, "0.0")
