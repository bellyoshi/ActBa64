' EditorNewForm_*Text$ と EditorNewForm_AddSource$（「新しいフォーム」が書くファイルの中身）。

Dim nfNl As String
Dim nfCr As String
Dim nfS As String
nfNl = Chr$(10)
nfCr = Chr$(13) & Chr$(10)

' フォーム: Form を継承し、フォームデザイナで開ける
nfS = EditorNewForm_FormText$("Form2", nfCr)
Assert(-1, Left$(nfS, 13) = "Class Form2" & nfCr, "nf form class")
Assert(1, FormDesign_IsForm(nfS), "nf form is form")
Assert(-1, FormDesign_GetStr$(nfS, "Caption") = "Form2", "nf form caption")
Assert(400, FormDesign_GetNum(nfS, "Width", 0), "nf form width")
Assert(0, InStr(1, nfS, "#include"), "nf form no include")

' メイン
nfS = EditorNewForm_MainText$(nfCr)
Assert(1, InStr(1, nfS, "#include <Forms.sbp>"), "nf main include")
Assert(-1, InStr(1, nfS, nfCr & "Application.Initialize()" & nfCr & "Application.Run(mainForm)") > 0, "nf main run")

' プロジェクト
nfS = EditorNewForm_PjText$("app", "32", nfCr)
Assert(-1, InStr(1, nfS, "#NAME=app" & nfCr) > 0, "nf pj name")
Assert(-1, InStr(1, nfS, "#PLATFORM=32" & nfCr) > 0, "nf pj platform")
Assert(-1, InStr(1, nfS, "#OUTPUT_RELEASE=.\app.exe" & nfCr) > 0, "nf pj output")
Assert(-1, Mid$(nfS, Len(nfS) - 28) = "#SOURCE" & nfCr & "app.abp" & nfCr & "Form1.abp" & nfCr, "nf pj source")

' #SOURCE の最後（空行と次の # の前）に足す。改行は元のまま
nfS = "#NAME=a" & nfCr & "#SOURCE" & nfCr & "a.abp" & nfCr & "Form1.abp" & nfCr & nfCr & "#X=1" & nfCr
Assert(-1, EditorNewForm_AddSource$(nfS, "Form2.abp") = "#NAME=a" & nfCr & "#SOURCE" & nfCr & "a.abp" & nfCr & "Form1.abp" & nfCr & "Form2.abp" & nfCr & nfCr & "#X=1" & nfCr, "nf add mid")
Assert(-1, EditorNewForm_AddSource$("#source" & nfNl & "a.abp", "B.abp") = "#source" & nfNl & "a.abp" & nfNl & "B.abp" & nfNl, "nf add no last nl")
Assert(-1, EditorNewForm_AddSource$("#SOURCE" & nfNl, "B.abp") = "#SOURCE" & nfNl & "B.abp" & nfNl, "nf add empty source")
Assert(-1, EditorNewForm_AddSource$("#NAME=a" & nfNl, "B.abp") = "#NAME=a" & nfNl & "#SOURCE" & nfNl & "B.abp" & nfNl, "nf add no source")

' 一時プロジェクトを移すときの名前の書き換え（改行と、ほかの行はそのまま）
nfS = EditorNewForm_PjText$("project1", "64", nfCr) & "Form2.abp" & nfCr
Assert(-1, EditorNewForm_RenamePj$(nfS, "project1", "app") = EditorNewForm_PjText$("app", "64", nfCr) & "Form2.abp" & nfCr, "nf rename pj")
Assert(-1, EditorNewForm_RenamePj$("#NAME=project1" & nfNl & "x.abp", "project1", "b") = "#NAME=b" & nfNl & "x.abp", "nf rename lf")
Assert(-1, EditorNewForm_RenamePj$("#OPTION=project1" & nfCr, "project1", "b") = "#OPTION=project1" & nfCr, "nf rename keep")
Assert(-1, EditorNewForm_MovedRel$("Project1.abp", "project1", "app") = "app.abp", "nf moved main")
Assert(-1, EditorNewForm_MovedRel$("Form1.abp", "project1", "app") = "Form1.abp", "nf moved form")
