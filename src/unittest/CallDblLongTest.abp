' Double の実引数は Long 仮引数へ切り捨てる。
' ビット列のままだと Circle (x+100,y+100) の中心がずれる。
Dim g_callCx As Long
Dim g_callCy As Long

Sub TakeLong2(a As Long, b As Long)
    g_callCx = a
    g_callCy = b
End Sub

Dim x As Double
Dim y As Double
x = 187.585
y = 171.931
TakeLong2(x + 100.0, y + 100.0)
Assert(287, g_callCx, "cx")
Assert(271, g_callCy, "cy")
