' Long の For で To / 初期値 / Step が Double のとき、代入と同じく Long へ変換して回す。
' ビット列のまま比べると Len(s) / 2 - 1 が巨大値や負になり回数がずれる。
Function ForLD_CountTo(s As String) As Long
    Dim i As Long, c As Long
    For i = 0 To Len(s) / 2 - 1
        c = c + 1
    Next
    ForLD_CountTo = c
End Function

Function ForLD_CountFromStep(s As String) As Long
    Dim i As Long, c As Long
    For i = Len(s) / 2 To 1 Step -(Len(s) / 10)
        c = c + 1
        If c > 100 Then Exit For
    Next
    ForLD_CountFromStep = c
End Function

Dim g_forLdI As Long, g_forLdC As Long, g_forLdS As String
g_forLdS = "433A5C955C"
For g_forLdI = 0 To Len(g_forLdS) / 2 - 1
    g_forLdC = g_forLdC + 1
Next
Assert(5, g_forLdC, "for long to dbl global")
Assert(5, ForLD_CountTo(g_forLdS), "for long to dbl sub")
Assert(5, ForLD_CountFromStep(g_forLdS), "for long from/step dbl")
