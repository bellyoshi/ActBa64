' GetProp / SetProp / RemoveProp の名前は UTF-8 をワイドにして W 版へ（CP932 にない 𠮷 も）。
' GetStartupInfo の lpTitle / lpDesktop は UTF-8（BasicPropW.abp）。

Dim ppH As HWND
Dim ppW As *Byte
Dim ppSi As STARTUPINFO
Dim ppSiW As STARTUPINFO
Dim ppU As *Byte

ppH = CreateWindowEx(0, "STATIC", "", 0, 0, 0, 10, 10, 0, 0, GetModuleHandle(0), 0)
If ppH = 0 Then Assert(1, 0, "prop hwnd")
Assert(-1, SetProp(ppH, "名前𠮷", 123 As HANDLE) <> 0, "prop set utf8")
Assert(123, GetProp(ppH, "名前𠮷") As Long, "prop get utf8")
ppW = BasicWidePtr("名前𠮷")
Assert(123, GetPropW(ppH, ppW) As Long, "prop stored wide")
free(ppW)
Assert(0, GetProp(ppH, "名前") As Long, "prop other name")
Assert(123, RemoveProp(ppH, "名前𠮷") As Long, "prop remove utf8")
Assert(0, GetProp(ppH, "名前𠮷") As Long, "prop removed")
DestroyWindow(ppH)

FillMemory(VarPtr(ppSi), Len(ppSi), 0)
FillMemory(VarPtr(ppSiW), Len(ppSiW), 0)
GetStartupInfo(ppSi)
GetStartupInfoW(ppSiW)
Assert(Len(ppSi), ppSi.cb, "startup cb")
Assert(ppSiW.dwFlags, ppSi.dwFlags, "startup flags")
If ppSiW.lpTitle <> 0 Then
    ppU = BasicUtf8OfWide(ppSiW.lpTitle)
    Assert(-1, MakeStr(ppSi.lpTitle) = MakeStr(ppU), "startup title utf8")
    free(ppU)
End If
If ppSiW.lpDesktop <> 0 Then
    ppU = BasicUtf8OfWide(ppSiW.lpDesktop)
    Assert(-1, MakeStr(ppSi.lpDesktop) = MakeStr(ppU), "startup desktop utf8")
    free(ppU)
End If
