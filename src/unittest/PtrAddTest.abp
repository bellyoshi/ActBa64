' ポインタ + 整数 は 64bit でアドレスの上位 32bit を落とさない。
' グローバルは 4GB より上（image base 0x140000000）にある。
Dim ptrAddBuf(15) As Byte
Dim ptrAddP As *Byte
Dim ptrAddQ As *Byte
Dim ptrAddV As VoidPtr
Dim ptrAddN As Long

lstrcpy(VarPtr(ptrAddBuf), "0123456789")
Assert(0, lstrcmp(MakeStr(VarPtr(ptrAddBuf) + 7), "789"), "VarPtr + n")
ptrAddP = VarPtr(ptrAddBuf)
ptrAddQ = ptrAddP + 2
Assert(0, lstrcmp(MakeStr(ptrAddQ), "23456789"), "ptr + n")
Assert(0, lstrcmp(MakeStr(3 + ptrAddP), "3456789"), "n + ptr")
ptrAddN = -1
Assert(0, lstrcmp(MakeStr(ptrAddQ + ptrAddN), "123456789"), "ptr + negative")
Assert(0, lstrcmp(MakeStr(ptrAddQ - 1), "123456789"), "ptr - n")
Assert(0, lstrcmp(MakeStr(ptrAddP + 4 + 4), "89"), "ptr + n + n")
ptrAddV = VarPtr(ptrAddBuf)
Assert(0, lstrcmp(MakeStr(ptrAddV + 5), "56789"), "VoidPtr + n")
lstrcpy(ptrAddP + 2, "abc")
Assert(0, lstrcmp(MakeStr(VarPtr(ptrAddBuf)), "01abc"), "write via ptr + n")
Assert(2, ptrAddQ - ptrAddP, "ptr - ptr")
