' 内部の文字列は UTF-8。SetWindowText / GetWindowText は UTF-8。
' A 版は変換しない。Window の中身を A で読むと CP932。
Dim h As Long
Dim buf(15) As Byte
Dim raw(15) As Byte
Dim p As *Byte

Window h, 0, 0, 0, 80, 24, "編集", 0, "STATIC"
If h = 0 Then Assert(1, 0, "hwnd")
GetWindowTextA(h, VarPtr(buf), 16)
Assert(&H95, buf[0], "w0")
Assert(&HD2, buf[1], "w1")
Assert(&H8F, buf[2], "w2")
Assert(&H57, buf[3], "w3")
GetWindowText(h, VarPtr(buf), 16)
Assert(&HE7, buf[0], "u0")
Assert(&HB7, buf[1], "u1")
Assert(&HA8, buf[2], "u2")
Assert(&HE9, buf[3], "u3")
Assert(&H9B, buf[4], "u4")
Assert(&H86, buf[5], "u5")
Assert(0, buf[6], "u6")
SetWindowText(h, "編集")
GetWindowTextA(h, VarPtr(buf), 16)
Assert(&H95, buf[0], "s0")
GetWindowText(h, VarPtr(buf), 16)
Assert(&HE7, buf[0], "s1")
Assert(&H86, buf[5], "s5")
Assert(6, GetWindowTextLength(h), "ulen")
raw[0] = &HF0
raw[1] = &H9F
raw[2] = &H99
raw[3] = &H82
raw[4] = 0
SetWindowText(h, VarPtr(raw))
GetWindowText(h, VarPtr(buf), 16)
Assert(&HF0, buf[0], "j0")
Assert(&H9F, buf[1], "j1")
Assert(&H99, buf[2], "j2")
Assert(&H82, buf[3], "j3")
Assert(0, buf[4], "j4")
DelWnd h
h = CreateWindowEx(0, "STATIC", "あ", 0, 0, 0, 80, 24, 0, 0, GetModuleHandle(0), 0)
If h = 0 Then Assert(1, 0, "hwnd2")
GetWindowText(h, VarPtr(buf), 16)
Assert(&HE3, buf[0], "k0")
Assert(&H81, buf[1], "k1")
Assert(&H82, buf[2], "k2")
GetWindowTextA(h, VarPtr(buf), 16)
Assert(&H82, buf[0], "k3")
Assert(&HA0, buf[1], "k4")
DelWnd h

p = BasicAnsiPtr("編集")
Assert(&H95, p[0], "m0")
Assert(&HD2, p[1], "m1")
Assert(&H8F, p[2], "m2")
Assert(&H57, p[3], "m3")
Assert(0, p[4], "m4")
free(p)

' フィルタは区間の \0 を残す。すべて の CP932 のあと \0*.*\0\0。
raw[0] = &HE3
raw[1] = &H81
raw[2] = &H99
raw[3] = &HE3
raw[4] = &H81
raw[5] = &HB9
raw[6] = &HE3
raw[7] = &H81
raw[8] = &HA6
raw[9] = 0
raw[10] = &H2A
raw[11] = &H2E
raw[12] = &H2A
raw[13] = 0
raw[14] = 0
p = BasicAnsiMulti(VarPtr(raw))
Assert(&H82, p[0], "f0")
Assert(&HB7, p[1], "f1")
Assert(&H82, p[2], "f2")
Assert(&HD7, p[3], "f3")
Assert(&H82, p[4], "f4")
Assert(&HC4, p[5], "f5")
Assert(0, p[6], "f6")
Assert(&H2A, p[7], "f7")
Assert(&H2E, p[8], "f8")
Assert(&H2A, p[9], "f9")
Assert(0, p[10], "f10")
Assert(0, p[11], "f11")
free(p)

p = BasicAnsiMulti(Ex"すべて\0*.*\0\0")
Assert(&H82, p[0], "e0")
Assert(&HC4, p[5], "e5")
Assert(0, p[6], "e6")
Assert(&H2A, p[7], "e7")
Assert(&H2E, p[8], "e8")
Assert(&H2A, p[9], "e9")
Assert(0, p[10], "e10")
Assert(0, p[11], "e11")
free(p)
