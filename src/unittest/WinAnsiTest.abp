' 内部の文字列は UTF-8。Window のタイトルと MessageBox へ渡すバイトは CP932。
Dim h As Long
Dim buf(15) As Byte
Dim p As *Byte

Window h, 0, 0, 0, 80, 24, "編集", 0, "STATIC"
If h = 0 Then Assert(1, 0, "hwnd")
GetWindowText(h, VarPtr(buf), 16)
Assert(&H95, buf[0], "w0")
Assert(&HD2, buf[1], "w1")
Assert(&H8F, buf[2], "w2")
Assert(&H57, buf[3], "w3")
DelWnd h

p = BasicAnsiPtr("編集")
Assert(&H95, p[0], "m0")
Assert(&HD2, p[1], "m1")
Assert(&H8F, p[2], "m2")
Assert(&H57, p[3], "m3")
Assert(0, p[4], "m4")
free(p)
