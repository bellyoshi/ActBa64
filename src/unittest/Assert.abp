' 失敗時は expected と actual を赤字で出す。プロセスは終了しない。
' 件数は AssertFails。AssertQuiet が true のあいだは表示しない。

Const ASSERT_RED = 12
Const ASSERT_GRAY = 7

Dim AssertFails As Long
Dim AssertQuiet As boolean

Declare Function SetConsoleTextAttribute Lib "kernel32.dll" (ByVal hConsoleOutput As HANDLE, ByVal wAttributes As Long) As Long

Function AssertNum$(ByVal n As Long) As String
    Dim s As String
    s = Str$(n)
    AssertNum$ = s
    If Left$(s, 1) <> " " Then Exit Function
    AssertNum$ = Mid$(s, 2)
End Function

Function AssertLine$(ByVal expected As Long, ByVal actual As Long) As String
    AssertLine$ = "expected " & AssertNum$(expected) & " but " & AssertNum$(actual)
End Function

Function AssertHasFail() As boolean
    AssertHasFail = false
    If AssertFails = 0 Then Exit Function
    AssertHasFail = true
End Function

Sub AssertColor(ByVal attr As Long)
    SetConsoleTextAttribute(GetStdHandle(STD_OUTPUT_HANDLE), attr)
End Sub

Sub AssertShow(ByVal expected As Long, ByVal actual As Long, msg As String)
    AssertColor(ASSERT_RED)
    Print AssertLine$(expected, actual)
    Print msg
    AssertColor(ASSERT_GRAY)
End Sub

Sub AssertFail(ByVal expected As Long, ByVal actual As Long, msg As String)
    AssertFails = AssertFails + 1
    If AssertQuiet Then Exit Sub
    AssertShow(expected, actual, msg)
End Sub

Sub Assert(ByVal expected As Long, ByVal actual As Long, msg As String)
    If expected = actual Then Exit Sub
    AssertFail(expected, actual, msg)
End Sub

Function AssertDblLine$(ByVal expected As Double, ByVal actual As Double) As String
    Dim e As String
    Dim a As String
    e = StrD$(expected)
    a = StrD$(actual)
    AssertDblLine$ = "expected " & e & " but " & a
End Function

Sub AssertDblShow(ByVal expected As Double, ByVal actual As Double, msg As String)
    AssertColor(ASSERT_RED)
    Print AssertDblLine$(expected, actual)
    Print msg
    AssertColor(ASSERT_GRAY)
End Sub

Sub AssertDblFail(ByVal expected As Double, ByVal actual As Double, msg As String)
    AssertFails = AssertFails + 1
    If AssertQuiet Then Exit Sub
    AssertDblShow(expected, actual, msg)
End Sub

Sub AssertDbl(ByVal expected As Double, ByVal actual As Double, msg As String)
    If expected = actual Then Exit Sub
    AssertDblFail(expected, actual, msg)
End Sub
