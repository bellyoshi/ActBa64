' ZeroString は指定長の 0 バイト列。0 以下は空文字。1 バイトを書き換えても長さは残る。
Dim s As String
Dim p As *Byte

s = ZeroString(3)
Assert(3, Len(s), "len3")
p = StrPtr(s)
Assert(0, GetByte(p), "b0")
Assert(0, GetByte(p + 1), "b1")
Assert(0, GetByte(p + 2), "b2")
Assert(0, Len(ZeroString(0)), "len0")
Assert(0, Len(ZeroString(-1)), "lenneg")
SetByte(p, Asc("A"))
Assert(Asc("A"), Asc(s), "asc")
Assert(3, Len(s), "lenkeep")
