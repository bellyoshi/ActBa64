' 長さ指定の文字列は UTF-8。無印はワイド文字数で測る。A はそのまま。
Dim h As Long
Dim hdc As HDC
Dim wide(5) As Byte
Dim sz As SIZE
Dim szW As SIZE
Dim szA As SIZE
Dim rc As RECT
Dim rcW As RECT
Dim dtp As DRAWTEXTPARAMS
Dim fmt As DWord
Dim buf(15) As Byte
Dim st As HWND

Declare Function DrawTextW Lib "user32.dll" (ByVal hdc As HDC, ByVal lpStr As *Byte, ByVal nCount As Long, ByRef lpRect As RECT, ByVal dwFormat As DWord) As Long
Declare Function DrawTextExW Lib "user32.dll" (ByVal hdc As HDC, ByVal lpchText As *Byte, ByVal cchText As Long, ByRef lpRect As RECT, ByVal dwDTFormat As DWord, ByRef lpDTParams As DRAWTEXTPARAMS) As Long

Window h, 0, 0, 0, 80, 24, "t", 0, "STATIC"
If h = 0 Then Assert(1, 0, "hwnd")
hdc = GetDC(h)
If hdc = 0 Then Assert(1, 0, "hdc")
wide[0] = &HE8
wide[1] = &H7D
wide[2] = &HC6
wide[3] = &H96
wide[4] = 0
wide[5] = 0
GetTextExtentPoint32W(hdc, VarPtr(wide), 2, szW)
GetTextExtentPoint32(hdc, "編集", 6, sz)
Assert(szW.cx, sz.cx, "cx")
Assert(szW.cy, sz.cy, "cy")
GetTextExtentPoint32A(hdc, "編集", 6, szA)
If szA.cx = szW.cx Then Assert(0, 1, "aCx")
fmt = DT_SINGLELINE Or DT_NOPREFIX Or DT_CALCRECT
rc.left = 0
rc.top = 0
rc.right = 200
rc.bottom = 40
rcW.left = 0
rcW.top = 0
rcW.right = 200
rcW.bottom = 40
DrawTextW(hdc, VarPtr(wide), 2, rcW, fmt)
DrawText(hdc, "編集", 6, rc, fmt)
Assert(rcW.right, rc.right, "dtR")
Assert(rcW.bottom, rc.bottom, "dtB")
rc.right = 200
rc.bottom = 40
DrawText(hdc, "編集", -1, rc, fmt)
Assert(rcW.right, rc.right, "dtN")
dtp.cbSize = Len(dtp)
dtp.iTabLength = 0
dtp.iLeftMargin = 0
dtp.iRightMargin = 0
dtp.uiLengthDrawn = 0
rc.right = 200
rc.bottom = 40
rcW.right = 200
rcW.bottom = 40
DrawTextExW(hdc, VarPtr(wide), 2, rcW, fmt, dtp)
DrawTextEx(hdc, "編集", -1, rc, fmt, dtp)
Assert(rcW.right, rc.right, "exR")
ReleaseDC(h, hdc)
DelWnd h

InitCommonControls()
Window h, 0, 0, 0, 200, 80, "t", 0, "STATIC"
If h = 0 Then Assert(1, 0, "stPar")
st = CreateStatusWindow(&H50000000, "編集", h, 1)
If st = 0 Then Assert(1, 0, "status")
buf[0] = 0
SendMessage(st, SB_GETTEXT, 0, VarPtr(buf))
Assert(&H95, buf[0], "sb0")
Assert(&HD2, buf[1], "sb1")
Assert(&H8F, buf[2], "sb2")
Assert(&H57, buf[3], "sb3")
' SB_SETTEXT の UTF-8 はワイドにして SB_SETTEXTW で送る（SB_GETTEXTW で読んで比べる）
Dim sbText[63] As Byte
Dim sbGot[127] As Byte
Dim sbWant As *Byte
Dim sbI As Long
wsprintf(sbText, "ウィンドウ: %d×%d", 640, 480)
SendMessage(st, SB_SETTEXT, 0, sbText)
sbWant = BasicWideOf(sbText, lstrlen(sbText))
If sbWant = 0 Then Assert(1, 0, "sbWant")
SendMessageW(st, &H040D, 0, VarPtr(sbGot))
For sbI = 0 To 29
    Assert(sbWant[sbI], sbGot[sbI], "sbW")
Next
free(sbWant)
DelWnd h
