' RunDir_Of$ は exe のパスから作業ディレクトリ（末尾の区切りを含む）を返す。
' 相対の date1.txt を開くプログラムを Run してもプロジェクトのフォルダで見つかるようにする。

Assert(-1, RunDir_Of$("C:\work\TextList\TextList.exe") = "C:\work\TextList\", "rundir backslash")
Assert(-1, RunDir_Of$("C:/work/a.exe") = "C:/work/", "rundir slash")
Assert(-1, RunDir_Of$("C:\a\b/c.exe") = "C:\a\b/", "rundir last sep")
Assert(-1, RunDir_Of$("C:\a.exe") = "C:\", "rundir root")
Assert(-1, RunDir_Of$("a.exe") = "", "rundir bare")
Assert(-1, RunDir_Of$("") = "", "rundir empty")
Assert(-1, RunDir_Of$("C:\日本語\x.exe") = "C:\日本語\", "rundir utf8")
