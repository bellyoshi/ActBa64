' FormDesign_*（フォームデザイナの文字列処理）。
' InitializeComponent の中の「名前 = 値」を読み書きする。名前は大文字小文字を区別しない。
' コメント行と、InitializeComponent の外の行は見ない。無い名前を書くと End Sub の直前に足す。

Dim fdNl As String
Dim fdQ As String
Dim fdSrc As String
Dim fdOut As String
Dim fdCrlf As String
Dim fdW As Long
Dim fdH As Long
fdNl = Chr$(10)
fdQ = Chr$(34)
fdSrc = "Class Form1" & fdNl & "    Inherits Form" & fdNl & "Private" & fdNl
fdSrc = fdSrc & "    Override Sub InitializeComponent()" & fdNl
fdSrc = fdSrc & "        ' Width = 5" & fdNl
fdSrc = fdSrc & "        Left = 673" & fdNl & "        Width = 320 ' w" & fdNl
fdSrc = fdSrc & "        height=240" & fdNl & "        WidthX = 3" & fdNl
fdSrc = fdSrc & "        Caption = " & fdQ & "Form1" & fdQ & fdNl
fdSrc = fdSrc & "    End Sub" & fdNl & "    Sub Other()" & fdNl & "        Top = 9" & fdNl
fdSrc = fdSrc & "    End Sub" & fdNl & "End Class" & fdNl

Assert(1, FormDesign_IsForm(fdSrc), "fd is form")
Assert(0, FormDesign_IsForm("Class A" & fdNl & "End Class"), "fd not form")
Assert(0, FormDesign_IsForm(""), "fd empty")
Assert(320, FormDesign_GetNum(fdSrc, "Width", -1), "fd width")
Assert(240, FormDesign_GetNum(fdSrc, "Height", -1), "fd height lower")
Assert(673, FormDesign_GetNum(fdSrc, "left", -1), "fd left ci")
Assert(-1, FormDesign_GetNum(fdSrc, "Top", -1), "fd top outside")
Assert(-1, FormDesign_GetNum("", "Width", -1), "fd empty num")
Assert(-1, FormDesign_GetStr$(fdSrc, "Caption") = "Form1", "fd caption")
Assert(-1, FormDesign_GetStr$(fdSrc, "Width") = "", "fd caption not str")

fdOut = FormDesign_SetNum$(fdSrc, "Width", 400)
Assert(400, FormDesign_GetNum(fdOut, "Width", -1), "fd set width")
Assert(-1, InStr(1, fdOut, "        Width = 400 ' w" & fdNl) > 0, "fd set keeps comment")
Assert(3, FormDesign_GetNum(fdOut, "WidthX", -1), "fd set widthx kept")
fdOut = FormDesign_SetNum$(fdSrc, "Height", 1234)
Assert(-1, InStr(1, fdOut, "        height=1234" & fdNl) > 0, "fd set no space")
fdOut = FormDesign_SetNum$(fdSrc, "Top", 50)
Assert(50, FormDesign_GetNum(fdOut, "Top", -1), "fd add top")
Assert(-1, InStr(1, fdOut, fdQ & fdNl & "        Top = 50" & fdNl & "    End Sub") > 0, "fd add before end")
Assert(-1, FormDesign_SetNum$("Dim a", "Width", 1) = "Dim a", "fd set not form")

fdCrlf = "Class F" & Chr$(13) & fdNl & "Sub InitializeComponent()" & Chr$(13) & fdNl & "End Sub"
fdOut = FormDesign_SetNum$(fdCrlf, "Width", 77)
Assert(-1, fdOut = "Class F" & Chr$(13) & fdNl & "Sub InitializeComponent()" & Chr$(13) & fdNl & "    Width = 77" & Chr$(13) & fdNl & "End Sub", "fd add crlf")
fdOut = FormDesign_SetNum$(fdOut, "Width", 8)
Assert(8, FormDesign_GetNum(fdOut, "Width", -1), "fd set crlf")
Assert(-1, InStr(1, fdOut, "Width = 8" & Chr$(13) & fdNl) > 0, "fd set crlf keeps cr")

' 掴む所: 右辺 1、下辺 2、右下 3、それ以外 0（窓の左上は FD_ORG_X, FD_ORG_Y）
Assert(1, FormDesign_Hit(FD_ORG_X + 320, FD_ORG_Y + 100, 320, 240), "fd hit right")
Assert(2, FormDesign_Hit(FD_ORG_X + 100, FD_ORG_Y + 241, 320, 240), "fd hit bottom")
Assert(3, FormDesign_Hit(FD_ORG_X + 322, FD_ORG_Y + 238, 320, 240), "fd hit corner")
Assert(0, FormDesign_Hit(FD_ORG_X + 100, FD_ORG_Y + 100, 320, 240), "fd hit inside")
Assert(0, FormDesign_Hit(FD_ORG_X + 400, FD_ORG_Y + 100, 320, 240), "fd hit outside")

' 引いた分だけ大きさを変える。最小は FD_MIN_W x FD_MIN_H
FormDesign_DragSize(1, 320, 240, 30, 50, fdW, fdH)
Assert(350, fdW, "fd drag right w")
Assert(240, fdH, "fd drag right h")
FormDesign_DragSize(2, 320, 240, 30, -40, fdW, fdH)
Assert(320, fdW, "fd drag bottom w")
Assert(200, fdH, "fd drag bottom h")
FormDesign_DragSize(3, 320, 240, -1000, -1000, fdW, fdH)
Assert(FD_MIN_W, fdW, "fd drag min w")
Assert(FD_MIN_H, fdH, "fd drag min h")
