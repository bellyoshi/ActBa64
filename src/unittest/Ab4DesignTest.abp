' Ab4DesignText（文書タブの「AB4 デザイナー」: .wnd の窓と部品を描くための値）。

Assert(1, Ab4D_IsWnd("C:\d\hello2.wnd"), "ab4d wnd")
Assert(1, Ab4D_IsWnd("C:\d\HELLO2.WND"), "ab4d wnd upper")
Assert(0, Ab4D_IsWnd("C:\d\hello2.abp"), "ab4d not wnd")
Assert(0, Ab4D_IsWnd(""), "ab4d empty")

' 「x,y,幅,高さ」「幅,高さ」の k 番目（1 始まり）。無ければ 0
Assert(10, Ab4D_Part("10, 20,30,40", 1), "ab4d part 1")
Assert(40, Ab4D_Part("10, 20,30,40", 4), "ab4d part 4")
Assert(360, Ab4D_Part("480,360", 2), "ab4d part size")
Assert(0, Ab4D_Part("480,360", 3), "ab4d part none")

' 部品の種類（ITEM の最後の数）から描き方
Assert(AB4K_BUTTON, Ab4D_Kind(1), "ab4d button")
Assert(AB4K_CHECK, Ab4D_Kind(2), "ab4d check")
Assert(AB4K_COMBO, Ab4D_Kind(3), "ab4d combo")
Assert(AB4K_EDIT, Ab4D_Kind(4), "ab4d edit")
Assert(AB4K_GROUP, Ab4D_Kind(5), "ab4d group")
Assert(AB4K_RADIO, Ab4D_Kind(10), "ab4d radio")
Assert(AB4K_LABEL, Ab4D_Kind(11), "ab4d static")
Assert(AB4K_BOX, Ab4D_Kind(8), "ab4d listbox")
Assert(AB4K_HSCROLL, Ab4D_Kind(6), "ab4d hscroll")
Assert(AB4K_FRAME, Ab4D_Kind(7), "ab4d image")
Assert(AB4K_BOX, Ab4D_Kind(9), "ab4d listview")
Assert(AB4K_BOX, Ab4D_Kind(12), "ab4d treeview")
Assert(AB4K_VSCROLL, Ab4D_Kind(13), "ab4d vscroll")
Assert(AB4K_UPDOWN, Ab4D_Kind(14), "ab4d updown")
Assert(AB4K_PROGRESS, Ab4D_Kind(15), "ab4d progress")
Assert(AB4K_TRACK, Ab4D_Kind(16), "ab4d track")
Assert(AB4K_BOX, Ab4D_Kind(99), "ab4d other")

' 窓の大きさ（SIZE が無いか 0 なら既定）
Assert(480, Ab4D_SizeW("480,360"), "ab4d size w")
Assert(360, Ab4D_SizeH("480,360"), "ab4d size h")
Assert(FD_DEF_W, Ab4D_SizeW(""), "ab4d size w def")
Assert(FD_DEF_H, Ab4D_SizeH("0,0"), "ab4d size h def")

' RadWnd で読んだ ITEM の四角
Dim ab4dT As String
ab4dT = "WINDOW:MainWnd" + Chr$(10) + "    SIZE = 300,200" + Chr$(10)
ab4dT = ab4dT + "    ITEM = Button1,8,16,80,24," + Chr$(34) + "OK" + Chr$(34) + ",&H50000000,&H00000000,1" + Chr$(10) + "END" + Chr$(10)
RadWnd_Parse(ab4dT)
Assert(1, g_riCount, "ab4d items")
Assert(16, Ab4D_Part(g_riRect(0), 2), "ab4d item y")
Assert(80, Ab4D_Part(g_riRect(0), 3), "ab4d item w")
Assert(-1, g_riCaption(0) = "OK", "ab4d item caption")
Assert(300, Ab4D_SizeW(g_rwSize(0)), "ab4d win w")

' AB4デザイナーで引いた結果を .wnd の本文に書く（ITEM の x,y,幅,高さ / SIZE）
Dim ab4dN As String, ab4dS As String, ab4dU As String
ab4dN = Chr$(13) + Chr$(10)
ab4dS = "WINDOW:MainWnd" + ab4dN + "    SIZE      = 280,120" + ab4dN + "    CAPTION   = " + Chr$(34) + "hel4" + Chr$(34) + ab4dN
ab4dS = ab4dS + "    ITEM      = CommandButton1,81,23,117,24," + Chr$(34) + "Button1" + Chr$(34) + ",&H50000000,&H00000000,1" + ab4dN + "END" + ab4dN
ab4dS = ab4dS + "WINDOW:Sub" + ab4dN + "    ITEM      = CommandButton1,1,2,3,4," + Chr$(34) + "x" + Chr$(34) + ",&H50000000,&H00000000,1" + ab4dN + "END" + ab4dN
ab4dU = Ab4D_SetItemRect$(ab4dS, 0, "commandbutton1", 90, 30, 100, 26)
Assert(-1, InStr(1, ab4dU, "    ITEM      = CommandButton1,90,30,100,26," + Chr$(34) + "Button1" + Chr$(34) + ",&H50000000,&H00000000,1" + ab4dN) > 0, "ab4d set item")
Assert(-1, InStr(1, ab4dU, "CommandButton1,1,2,3,4,") > 0, "ab4d other win kept")
Assert(Len(ab4dS), Len(ab4dU), "ab4d set item len")
ab4dU = Ab4D_SetItemRect$(ab4dS, 1, "CommandButton1", 5, 6, 7, 8)
Assert(-1, InStr(1, ab4dU, "CommandButton1,5,6,7,8," + Chr$(34) + "x") > 0, "ab4d set item win1")
Assert(-1, InStr(1, ab4dU, "CommandButton1,81,23,117,24,") > 0, "ab4d win0 kept")
Assert(-1, Ab4D_SetItemRect$(ab4dS, 0, "Nothing", 1, 1, 1, 1) = ab4dS, "ab4d no item")
ab4dU = Ab4D_SetWinSize$(ab4dS, 0, 300, 150)
Assert(-1, InStr(1, ab4dU, "    SIZE      = 300,150" + ab4dN) > 0, "ab4d set size")
' SIZE の無い窓には WINDOW: の次の行に足す
ab4dU = Ab4D_SetWinSize$(ab4dS, 1, 200, 100)
Assert(-1, InStr(1, ab4dU, "WINDOW:Sub" + ab4dN + "    SIZE      = 200,100" + ab4dN + "    ITEM") > 0, "ab4d add size")
Assert(-1, Ab4D_SetWinSize$(ab4dS, 5, 1, 1) = ab4dS, "ab4d no win")

' 部品を足す・消す
Dim ab4dW As String
ab4dW = "WINDOW:MainWnd" + ab4dN + "    SIZE      = 280,120" + ab4dN
ab4dW = ab4dW + "    ITEM      = CommandButton1,81,23,117,24," + Chr$(34) + "Button1" + Chr$(34) + ",&H50000000,&H00000000,1" + ab4dN + "END" + ab4dN
RadWnd_Parse(ab4dW)
Assert(-1, Ab4D_NextName$(0, 1) = "CommandButton2", "ab4d next name")
Assert(-1, Ab4D_NextName$(0, 11) = "Static1", "ab4d next name static")
Assert(-1, Ab4D_ItemLine$("CommandButton2", 1, 10, 20, 75, 24) = "    ITEM      = CommandButton2,10,20,75,24," + Chr$(34) + "Button2" + Chr$(34) + ",&H50000000,&H00000000,1", "ab4d item line")
Assert(-1, Ab4D_ItemLine$("ImageBox1", 7, 1, 2, 3, 4) = "    ITEM      = ImageBox1,1,2,3,4," + Chr$(34) + Chr$(34) + ",&H50000007,&H00000000,7,0," + Chr$(34) + Chr$(34), "ab4d item line image")
Assert(-1, Ab4D_ItemLine$("EditBox3", 4, 1, 2, 3, 4) = "    ITEM      = EditBox3,1,2,3,4," + Chr$(34) + Chr$(34) + ",&H50000000,&H00000200,4", "ab4d item line edit")
Assert(-1, Ab4D_ItemLine$("RadioButton2", 10, 1, 2, 3, 4) = "    ITEM      = RadioButton2,1,2,3,4," + Chr$(34) + "Radio2" + Chr$(34) + ",&H50000009,&H00000000,10", "ab4d item line radio")
Assert(75, Ab4D_DefW(1), "ab4d def w")
Assert(24, Ab4D_DefH(1), "ab4d def h")
' 窓の END の前に足す
ab4dU = Ab4D_AddItem$(ab4dW, 0, 11, 5, 6)
Assert(-1, InStr(1, ab4dU, ",1" + ab4dN + "    ITEM      = Static1,5,6," + FormDesign_Num$(Ab4D_DefW(11)) + "," + FormDesign_Num$(Ab4D_DefH(11)) + "," + Chr$(34) + "Text1" + Chr$(34) + ",&H50000000,&H00000000,11" + ab4dN + "END" + ab4dN) > 0, "ab4d add item")
Assert(-1, Ab4D_LastAdded$() = "Static1", "ab4d last added")
Assert(-1, Ab4D_AddItem$(ab4dW, 3, 11, 5, 6) = ab4dW, "ab4d add no win")
' 消す（その行だけ）
Assert(-1, Ab4D_DelItem$(ab4dW, 0, "commandbutton1") = "WINDOW:MainWnd" + ab4dN + "    SIZE      = 280,120" + ab4dN + "END" + ab4dN, "ab4d del item")
Assert(-1, Ab4D_DelItem$(ab4dW, 0, "Nothing") = ab4dW, "ab4d del none")

' プロパティ: ITEM の名前・文字・様式・拡張様式を書き換える（文字に , があってもよい）
Dim ab4dP As String, ab4dQ As String
ab4dQ = Chr$(34)
ab4dP = "WINDOW:MainWnd" + ab4dN + "    ITEM      = Static1,61,51,50,12," + ab4dQ + "a, b" + ab4dQ + ",&H50000000,&H00000000,11" + ab4dN
ab4dP = ab4dP + "    ITEM      = ImageBox1,30,411,87,71," + ab4dQ + ab4dQ + ",&H50000007,&H00000000,7,0," + ab4dQ + ab4dQ + ab4dN + "END" + ab4dN
ab4dU = Ab4D_ItemSet$(ab4dP, 0, "Static1", AB4P_NAME, "Label1")
Assert(-1, InStr(1, ab4dU, "= Label1,61,51,50,12," + ab4dQ + "a, b" + ab4dQ + ",&H50000000,") > 0, "ab4d set name")
ab4dU = Ab4D_ItemSet$(ab4dP, 0, "Static1", AB4P_CAPTION, "日本語, x")
Assert(-1, InStr(1, ab4dU, "= Static1,61,51,50,12," + ab4dQ + "日本語, x" + ab4dQ + ",&H50000000,&H00000000,11" + ab4dN) > 0, "ab4d set caption")
ab4dU = Ab4D_ItemSet$(ab4dP, 0, "ImageBox1", AB4P_STYLE, "&H50000008")
Assert(-1, InStr(1, ab4dU, "= ImageBox1,30,411,87,71," + ab4dQ + ab4dQ + ",&H50000008,&H00000000,7,0," + ab4dQ + ab4dQ + ab4dN) > 0, "ab4d set style")
ab4dU = Ab4D_ItemSet$(ab4dP, 0, "ImageBox1", AB4P_EXSTYLE, "&H00000200")
Assert(-1, InStr(1, ab4dU, ",&H50000007,&H00000200,7,0,") > 0, "ab4d set exstyle")
Assert(-1, Ab4D_ItemSet$(ab4dP, 0, "None", AB4P_NAME, "x") = ab4dP, "ab4d set none")
' 文字の " は ' にする（.wnd の文字は " で囲むだけ）
ab4dU = Ab4D_ItemSet$(ab4dP, 0, "Static1", AB4P_CAPTION, "say " + ab4dQ + "hi" + ab4dQ)
Assert(-1, InStr(1, ab4dU, ab4dQ + "say 'hi'" + ab4dQ) > 0, "ab4d caption quote")

' 様式のチェックと選択肢（mask の中を val にする）
Assert(&H50000004, Ab4D_StyleSet(&H50000000, &H4, &H4), "ab4d style on")
Assert(&H50000000, Ab4D_StyleSet(&H50000004, &H4, 0), "ab4d style off")
Assert(&H50000002, Ab4D_StyleSet(&H50000001, &H3, &H2), "ab4d style option")
Assert(1, Ab4D_StyleHas(&H50000004, &H4, &H4), "ab4d style has")
Assert(0, Ab4D_StyleHas(&H50000004, &H3, &H1), "ab4d style has not")

' 名前に使えるか（英字か _ で始まり、英数字と _）
Assert(1, Ab4D_NameOk("Button_2"), "ab4d name ok")
Assert(0, Ab4D_NameOk("2Button"), "ab4d name digit")
Assert(0, Ab4D_NameOk("a b"), "ab4d name space")
Assert(0, Ab4D_NameOk(""), "ab4d name empty")

' 種類ごとの行の表（1 行目はどの種類も 無効）
Assert(-1, Ab4D_RowKind$(Ab4D_StyleRow$(1, 0)) = "C", "ab4d row kind")
Assert(&H08000000, Ab4D_RowMask(Ab4D_StyleRow$(1, 0)), "ab4d row mask")
Assert(-1, Len(Ab4D_StyleRow$(4, Ab4D_StyleCount(4))) = 0, "ab4d row end")
Assert(-1, Ab4D_StyleCount(15) > 4, "ab4d progress rows")

' 窓のプロパティ: キー = 値 の行を書き換える・足す・消す、WINDOW: の名前、FONT
Dim ab4dV As String
ab4dV = "WINDOW:MainWnd" + ab4dN + "    HANDLE    = hMainWnd" + ab4dN + "    CAPTION   = " + ab4dQ + "a1" + ab4dQ + ab4dN
ab4dV = ab4dV + "    FONT      = -12,0,0,0,400,0,0,0,128,3,2,1,32," + ab4dQ + "ＭＳ Ｐゴシック" + ab4dQ + ab4dN + "    TYPE      = 0" + ab4dN + "END" + ab4dN
Assert(-1, InStr(1, Ab4D_WinSet$(ab4dV, 0, "TYPE", "1"), "    TYPE      = 1" + ab4dN) > 0, "ab4d win set")
Assert(-1, InStr(1, Ab4D_WinSet$(ab4dV, 0, "MENUID", "MainMenu"), "WINDOW:MainWnd" + ab4dN + "    MENUID    = MainMenu" + ab4dN + "    HANDLE") > 0, "ab4d win add")
Assert(-1, InStr(1, Ab4D_WinSet$(ab4dV, 0, "CAPTION", ab4dQ + "x" + ab4dQ), "    CAPTION   = " + ab4dQ + "x" + ab4dQ + ab4dN) > 0, "ab4d win caption")
Assert(0, InStr(1, Ab4D_WinDel$(ab4dV, 0, "TYPE"), "TYPE"), "ab4d win del")
Assert(-1, Ab4D_WinDel$(ab4dV, 0, "MENUID") = ab4dV, "ab4d win del none")
Assert(-1, Left$(Ab4D_WinRename$(ab4dV, 0, "Main2"), 18) = "WINDOW:Main2" + ab4dN + "    ", "ab4d win rename")
Assert(-1, Ab4D_FontFace$("-12,0,0,0,400,0,0,0,128,3,2,1,32," + ab4dQ + "ＭＳ Ｐゴシック" + ab4dQ) = "ＭＳ Ｐゴシック", "ab4d font face")
Assert(-12, Ab4D_FontH("-12,0,0,0,400,0,0,0,128,3,2,1,32," + ab4dQ + "x" + ab4dQ), "ab4d font h")
Assert(-1, Ab4D_FontVal$("-12,0,0,0,400,0,0,0,128,3,2,1,32," + ab4dQ + "x" + ab4dQ, -16, "MS UI Gothic") = "-16,0,0,0,400,0,0,0,128,3,2,1,32," + ab4dQ + "MS UI Gothic" + ab4dQ, "ab4d font val")
' 窓の様式の行の表（種類 -1 は窓、-2 は窓の拡張様式）
Assert(-1, Ab4D_RowKind$(Ab4D_StyleRow$(-1, 0)) = "O", "ab4d win rows")
Assert(-1, Ab4D_StyleCount(-1) > 10, "ab4d win row count")
Assert(-1, Ab4D_StyleCount(-2) > 4, "ab4d win ex rows")
Assert(&HC0000000, Ab4D_RowMask(Ab4D_StyleRow$(-1, 0)), "ab4d win kind mask")
Assert(&H80000000, Ab4D_OptVal(Ab4D_StyleRow$(-1, 0), 1), "ab4d popup val")
Assert(-1, RadHex$(Ab4D_StyleSet(&H10cf0000, &HC0000000, &H80000000)) = "&H90cf0000", "ab4d popup hex")
Assert(&H90cf0000, Ab4D_HexNum("&H90cf0000"), "ab4d hexnum")
Assert(&H10cf0000, Ab4D_HexNum("&H10cf0000"), "ab4d hexnum pos")
Assert(15, Ab4D_HexNum("15"), "ab4d hexnum dec")
' FONT の 13 個の数（高さ,幅,傾き,向き,太さ,斜体,下線,打消し,文字セット,出力精度,切り取り精度,品質,ピッチとファミリ）と名前
Dim ab4dF As String
ab4dF = "-12,0,0,0,400,0,0,0,128,3,2,1,32," + Chr$(34) + "ＭＳ Ｐゴシック" + Chr$(34)
Assert(-12, Ab4D_FontNum(ab4dF, 1), "ab4d font num h")
Assert(400, Ab4D_FontNum(ab4dF, 5), "ab4d font num weight")
Assert(128, Ab4D_FontNum(ab4dF, 9), "ab4d font num charset")
Assert(32, Ab4D_FontNum(ab4dF, 13), "ab4d font num pitch")
Assert(-1, Ab4D_FontFrom$(-12, 0, 0, 0, 400, 0, 0, 0, 128, 3, 2, 1, 32, "ＭＳ Ｐゴシック") = ab4dF, "ab4d font from")
Assert(-1, Ab4D_FontFrom$(-16, 0, 0, 0, 700, 1, 0, 0, 0, 3, 2, 1, 34, "Arial") = "-16,0,0,0,700,1,0,0,0,3,2,1,34," + Chr$(34) + "Arial" + Chr$(34), "ab4d font from bold")

' イベント処理: 種類ごとのイベント（RadEvent の表）、対応メッセージ、概要、プロシージャ名と引数、ソースに足す
Assert(2, Ab4D_EvCount(1), "ab4d ev count button")
Assert(-1, Ab4D_EvName$(1, 0) = "Click", "ab4d ev name")
Assert(-1, Ab4D_EvMsg$(1, 0) = "BN_CLICKED", "ab4d ev msg")
Assert(-1, Ab4D_EvMsg$(1, 1) = "BN_DBLCLK", "ab4d ev msg 2")
Assert(-1, Ab4D_EvDesc$("BN_CLICKED", 1) = "ボタンがクリックされた時", "ab4d ev desc")
Assert(-1, Ab4D_EvDesc$("BN_DBLCLK", 1) = "ボタンがダブル クリックされた時", "ab4d ev desc dbl")
' ラベル（Static）は STN_CLICKED / STN_DBLCLK で、概要は「スタティック テキストが…」
Assert(2, Ab4D_EvCount(11), "ab4d ev count static")
Assert(-1, Ab4D_EvName$(11, 0) = "Click" And Ab4D_EvMsg$(11, 0) = "STN_CLICKED", "ab4d ev static click")
Assert(-1, Ab4D_EvName$(11, 1) = "DblClick" And Ab4D_EvMsg$(11, 1) = "STN_DBLCLK", "ab4d ev static dbl")
Assert(-1, Ab4D_EvDesc$("STN_CLICKED", 1) = "スタティック テキストがクリックされた時", "ab4d ev desc stn")
Assert(-1, Ab4D_EvDesc$("STN_DBLCLK", 1) = "スタティック テキストがダブル クリックされた時", "ab4d ev desc stn dbl")
Assert(-1, Len(Ab4D_EvDesc$("LBN_SELCHANGE", 1)) > 0, "ab4d ev desc lb")
Assert(-1, Len(Ab4D_EvDesc$("WM_RBUTTONDBLCLK", 0)) > 0, "ab4d ev desc mouse")
Assert(-1, Ab4D_EvName$(0, 0) = "Create" And Ab4D_EvMsg$(0, 0) = "WM_CREATE", "ab4d ev window")
Assert(-1, Ab4D_EvCount(0) > 20, "ab4d ev window count")
Assert(0, Ab4D_EvCount(5), "ab4d ev group none")
Assert(-1, Ab4D_EvProc$("MainWnd", "CommandButton1", "Click") = "MainWnd_CommandButton1_Click", "ab4d ev proc")
Assert(-1, Ab4D_EvProc$("MainWnd", "", "Paint") = "MainWnd_Paint", "ab4d ev proc win")
Assert(-1, Ab4D_EvParams$(0, "Paint") = "hDC As HDC", "ab4d ev params paint")
Assert(-1, Ab4D_EvParams$(0, "Create") = "ByRef CreateStruct As CREATESTRUCT", "ab4d ev params create")
Assert(-1, Ab4D_EvParams$(1, "Click") = "", "ab4d ev params click")
Assert(-1, Ab4D_EvParams$(12, "Click") = "ByRef nmHdr As NMHDR", "ab4d ev params notify")
' ソースのプロシージャ（行頭の Sub 名前(、大文字小文字は区別しない）
Dim ab4dS2 As String
ab4dS2 = "' x" + ab4dN + "Sub MainWnd_Destroy()" + ab4dN + "End Sub" + ab4dN
Assert(6, Ab4D_FindProc(ab4dS2, "mainwnd_destroy"), "ab4d find proc")
Assert(0, Ab4D_FindProc(ab4dS2, "MainWnd_Destroy2"), "ab4d find proc none")
Assert(0, Ab4D_FindProc("' Sub MainWnd_Destroy()" + ab4dN, "MainWnd_Destroy"), "ab4d find proc comment")
Assert(-1, Ab4D_AddProc$(ab4dS2, "MainWnd_CommandButton1_Click", "") = ab4dS2 + ab4dN + "Sub MainWnd_CommandButton1_Click()" + ab4dN + ab4dN + "End Sub" + ab4dN, "ab4d add proc")
Assert(-1, Ab4D_AddProc$("End Sub", "P", "a As Long") = "End Sub" + Chr$(10) + Chr$(10) + "Sub P(a As Long)" + Chr$(10) + Chr$(10) + "End Sub" + Chr$(10), "ab4d add proc no nl")
