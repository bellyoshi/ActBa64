' #SOURCE の最後に置く。失敗が残っていれば異常終了。
If AssertCp932Skips > 0 Then Print "CP932 でないので飛ばした " & AssertNum$(AssertCp932Skips) & " 件（ANSI コードページ " & AssertNum$(GetACP()) & "）"
If Not AssertHasFail() Then
    Print "正常終了"
    ExitProcess(0)
End If
AssertColor(ASSERT_RED)
Print "失敗 " & AssertNum$(AssertFails)
AssertColor(ASSERT_GRAY)
ExitProcess(1)
