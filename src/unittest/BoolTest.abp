#console

Assert(true, (true = true), "true = true")
Assert(false, (Not true), "Not true")
Assert(true, (Not false), "Not false")
Assert(true, (true And true), "true And true")
Assert(false, (true And false), "true And false")
Assert(false, (false And true), "false And true")
Assert(false, (false And false), "false And false")
Assert(true, (true Or true), "true Or true")
Assert(true, (true Or false), "true Or false")
Assert(true, (false Or true), "false Or true")
Assert(false, (false Or false), "false Or false")
Assert(2, 1 + 1, "1 + 1")
