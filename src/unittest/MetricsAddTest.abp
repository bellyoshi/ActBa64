' 定数 + API呼び出し はスタックを 16 バイト境界に戻してから呼ぶ。
' FileChecker の 400+GetSystemMetrics(...)*2 がここで落ちていた。
Dim m As Long
m = GetSystemMetrics(SM_CXFIXEDFRAME)
Assert(400 + m, 400 + GetSystemMetrics(SM_CXFIXEDFRAME), "metrics add")
Assert(400 + m * 2, 400 + GetSystemMetrics(SM_CXFIXEDFRAME) * 2, "metrics in add")
