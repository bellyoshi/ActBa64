' MENUITEMINFO の見出しは UTF-8。A で読むと CP932。GetMenuItemInfo は UTF-8。
Dim h As HMENU
Dim mii As MENUITEMINFO
Dim buf(15) As Byte
Dim p As *Byte

Declare Function GetMenuStringA Lib "user32.dll" (ByVal hMenu As HMENU, ByVal uIDItem As DWord, ByVal lpString As *Byte, ByVal cchMax As Long, ByVal flags As DWord) As Long
Declare Function GetMenuItemCount Lib "user32.dll" (ByVal hMenu As HMENU) As Long

h = CreateMenu()
If h = 0 Then Assert(1, 0, "hmenu")
FillMemory(VarPtr(mii), Len(mii), 0)
mii.cbSize = Len(mii)
mii.fMask = MIIM_FTYPE
mii.fType = MFT_SEPARATOR
InsertMenuItem(h, 0, 1, mii)
mii.fMask = MIIM_STRING Or MIIM_ID
mii.fType = MFT_STRING
mii.wID = 100
p = "編集"
mii.dwTypeData = p
mii.cch = 0
InsertMenuItem(h, 1, 1, mii)
Assert(2, GetMenuItemCount(h), "count")
GetMenuStringA(h, 1, VarPtr(buf), 16, MF_BYPOSITION)
Assert(&H95, buf[0], "a0")
Assert(&H57, buf[3], "a3")
mii.dwTypeData = p
mii.cch = 0
SetMenuItemInfo(h, 1, 1, mii)
GetMenuStringA(h, 1, VarPtr(buf), 16, MF_BYPOSITION)
Assert(&H95, buf[0], "s0")
Assert(&HD2, buf[1], "s1")
buf[0] = 0
mii.dwTypeData = VarPtr(buf)
mii.cch = 16
mii.fMask = MIIM_STRING
GetMenuItemInfo(h, 1, 1, mii)
Assert(&HE7, buf[0], "u0")
Assert(&HB7, buf[1], "u1")
Assert(&HA8, buf[2], "u2")
Assert(&HE9, buf[3], "u3")
Assert(&H9B, buf[4], "u4")
Assert(&H86, buf[5], "u5")
Assert(0, buf[6], "u6")
DestroyMenu(h)
