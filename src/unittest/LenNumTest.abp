' Len は文字列なら文字数、数値の変数・配列・式ならバイト数（ActiveBasic と同じ）。
' AB 4.20: Dim len(2) As Long : Len(len(0)) = 4（len( は組み込み Len）、Len(len) = 12
Dim lenG(2) As Long
Dim lenD As Double
Dim lenL As Long
Dim lenS As String

Sub LenLocal(n As Long)
    Dim len(2) As Long
    Dim la(4) As Double
    Dim lx As Single
    Assert(4, Len(len(0)), "Len(len(0))")
    Assert(12, Len(len), "Len(len)")
    Assert(40, Len(la), "local Double array")
    Assert(4, Len(lx), "local Single")
    Assert(4, Len(n), "ByVal Long param")
End Sub

Assert(12, Len(lenG), "global Long array")
Assert(8, Len(lenD), "Double")
Assert(4, Len(lenL), "Long")
Assert(4, Len(0), "Len(0)")
Assert(8, Len(1.5), "Len(1.5)")
Assert(4, Len(lenL + 1), "Long expr")
lenS = "abcd"
Assert(4, Len(lenS), "String var")
Assert(3, Len("abc"), "String literal")
LenLocal(5)
