' Lang（actba64\Lang.abp）: actba_lang_ja.csv（id,text）の読み込みと訳

Sub LangCheck(actual As String, expected As String, msg As String)
    If actual = expected Then Exit Sub
    Print "expected [" & expected & "] but [" & actual & "]"
    Assert(1, 0, msg)
End Sub

Function LangTestText() As String
    Dim q As String, nl As String
    q = Chr$(34) : nl = Chr$(13) + Chr$(10)
    LangTestText = Chr$(&HEF) + Chr$(&HBB) + Chr$(&HBF) + "# c,omment" + nl + "id,text" + nl
    LangTestText = LangTestText + "1," + q + "A{0}" + q + q + "B, C" + q + nl + "2,PLAIN,extra" + nl + nl
    LangTestText = LangTestText + "3," + nl + "x9,bad" + nl + "12345678901,big" + nl
    LangTestText = LangTestText + "4,エラー {0} 件" + Chr$(10) + "5,LAST" + nl + "1,dup"
End Function

Sub LangTestLoad()
    Dim s As String
    Dim buf As *Byte
    s = LangTestText()
    buf = malloc(Len(s) + 1)
    memcpy(buf, StrPtr(s), Len(s) + 1)
    LangLoadText(buf)
End Sub

LangCheck(Tr$(2, "plain"), "plain", "lang before load")
LangTestLoad()
Assert(5, g_langN, "lang count")
LangCheck(Tr$(1, "en"), "A{0}" + Chr$(34) + "B, C", "lang quoted")
LangCheck(Tr1$(1, "en", "z"), "Az" + Chr$(34) + "B, C", "lang format")
LangCheck(Tr$(2, "plain"), "PLAIN", "lang bare")
LangCheck(Tr$(3, "noja"), "noja", "lang empty text")
LangCheck(Tr1$(4, "{0} errors", "3"), "エラー 3 件", "lang utf8")
LangCheck(Tr$(5, "last"), "LAST", "lang last line")
LangCheck(Tr$(9, "missing"), "missing", "lang missing id")
LangCheck(Tr1$(9, "{0} errors", "3"), "3 errors", "lang missing id format")
