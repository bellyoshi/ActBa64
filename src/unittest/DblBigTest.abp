' Long の範囲を超える Double。以前は Str$ / Print が inf になり、
' 4294967296 のような整数リテラルは 32bit に切り詰められ、1.5e10 は字句エラーだった。

Sub DblBigStr(expected As String, actual As String, msg As String)
    If expected = actual Then Exit Sub
    AssertFail(0, 1, msg & ": " & actual)
End Sub

Sub DblBigStrTest()
    Dim d As Double
    d = 3000000000.0
    DblBigStr("3000000000", Str$(d), "3000000000.0")
    d = 2147483648.0
    DblBigStr("2147483648", Str$(d), "2^31")
    d = 0.0 - 2147483648.0
    DblBigStr("-2147483648", Str$(d), "-2^31")
    d = 29828014080.5
    DblBigStr("29828014080.5", Str$(d), "29828014080.5")
    d = 999999999999999.0
    DblBigStr("999999999999999", Str$(d), "1e15-1")
    d = 150000000000000000000.0
    DblBigStr("1.5E+20", Str$(d), "1.5e20")
    d = 0.0 - 1000000000000000.0
    DblBigStr("-1E+15", Str$(d), "-1e15")
End Sub

Sub DblBigLitTest()
    AssertDbl(65536.0 * 65536.0, 4294967296, "4294967296")
    AssertDbl(65536.0 * 65536.0 * 4, 17179869184, "17179869184")
    AssertDbl(1000.0, 1e3, "1e3")
    AssertDbl(1000.0, 1E+3, "1E+3")
    AssertDbl(0.0025, 2.5e-3, "2.5e-3")
    AssertDbl(15000000000.0, 1.5e10, "1.5e10")
    Assert(-1, 4294967295, "4294967295 stays a 32-bit bit pattern")
    Dim n As Long
    n = 1e1
    Assert(10, n, "Long = 1e1")
End Sub

DblBigStrTest()
DblBigLitTest()
