' 32bit の大きさを書いたままの lStructSize（AB2 のプログラムの 76 / 60 など）は 64bit では今の大きさに直す。
' 直さないと GetSaveFileName / ChooseFont は CDERR_STRUCTSIZE で何も出さずに失敗する。
Dim ssOfn As OPENFILENAME
Dim ssFont As CHOOSEFONT

ssOfn.lStructSize = 76
BasicFixOfnSize(ssOfn)
ssFont.lStructSize = 60
BasicFixCfSize(ssFont)
#ifdef _WIN64
Assert(Len(ssOfn), ssOfn.lStructSize, "OPENFILENAME 76 -> Len")
Assert(104, ssFont.lStructSize, "CHOOSEFONT 60 -> 104")
ssOfn.lStructSize = 88
BasicFixOfnSize(ssOfn)
Assert(Len(ssOfn), ssOfn.lStructSize, "OPENFILENAME 88 -> Len")
#else
Assert(76, ssOfn.lStructSize, "OPENFILENAME 76 stays on 32bit")
Assert(60, ssFont.lStructSize, "CHOOSEFONT 60 stays on 32bit")
#endif
