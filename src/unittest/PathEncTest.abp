' PathEnc_Utf8$: GetCmd / DragQueryFile / GetModuleFileName の CP932 を UTF-8 に。UTF-8 と ASCII はそのまま。
Dim pencBuf(31) As Byte

FillMemory(VarPtr(pencBuf), 32, 0)
PathT_Hex(VarPtr(pencBuf), "433A5C955C5C82A02E616270")
Assert(-1, PathEnc_Utf8$(VarPtr(pencBuf), 12) = "C:\表\あ.abp", "penc cp932")
Assert(-1, PathEnc_Utf8$(StrPtr("C:\表\あ.abp"), 14) = "C:\表\あ.abp", "penc utf8")
Assert(-1, PathEnc_Utf8$(StrPtr("C:\a\b.abp"), 10) = "C:\a\b.abp", "penc ascii")
Assert(-1, PathEnc_Utf8$(VarPtr(pencBuf), 0) = "", "penc empty")
Assert(10, Len(PathEnc_Utf8$(StrPtr("C:\a\b.abp"), 10)), "penc len")

' PathEnc_Lines$: コンパイラ出力の行ごとに、妥当な UTF-8 でない行（CP932 のパスを含む行）だけを UTF-8 に直す。
Dim pencOut As String
pencOut = "ok" + Chr$(13) + Chr$(10) + PathEnc_Bytes$(VarPtr(pencBuf), 12) + "(3): x" + Chr$(13) + Chr$(10) + "日本"
Assert(-1, PathEnc_Lines$(pencOut) = "ok" + Chr$(13) + Chr$(10) + "C:\表\あ.abp(3): x" + Chr$(13) + Chr$(10) + "日本", "penc lines")
Assert(-1, PathEnc_Lines$("") = "", "penc lines empty")
Assert(-1, PathEnc_Lines$("a" + Chr$(10)) = "a" + Chr$(10), "penc lines lf")
