' DWord（符号なし 32bit）を Double にするときは 0..4294967295 として読む。
' 以前は Long と同じ符号つきで、&HF0000000 が -268435456 になっていた。
Type DwdT
    a As DWord
    b As Long
End Type

Function DwdParam(x As DWord) As Double
    DwdParam = x
End Function

Sub DwdByRef(ByRef x As DWord)
    x = &HFFFFFFFE
End Sub

Sub DWordDblVarTest()
    Dim x As DWord
    Dim y As DWord
    Dim d As Double
    x = &HF0000000
    d = x
    AssertDbl(4026531840.0, d, "DWord var -> Double")
    AssertDbl(4026531840.5, x + 0.5, "DWord + Double")
    AssertDbl(2013265920.0, x / 2, "DWord / 2")
    AssertDbl(4026531840.0, DwdParam(x), "DWord param")
    y = &H10000000
    AssertDbl(3758096384.0, CDbl(x - y), "DWord - DWord")
    DwdByRef(y)
    d = y
    AssertDbl(4294967294.0, d, "ByRef DWord")
End Sub

Sub DWordDblMemberTest()
    Dim t As DwdT
    Dim d As Double
    t.a = &HFFFFFFFF
    d = t.a
    AssertDbl(4294967295.0, d, "DWord member -> Double")
    AssertDbl(4294967295.0, CDbl(t.a), "CDbl(DWord member)")
    t.b = -1
    d = t.b
    AssertDbl(-1.0, d, "Long member stays signed")
End Sub

Sub DWordDblLongTest()
    Dim l As Long
    Dim d As Double
    l = &HF0000000
    d = l
    AssertDbl(-268435456.0, d, "Long stays signed")
End Sub

DWordDblVarTest()
DWordDblMemberTest()
DWordDblLongTest()
