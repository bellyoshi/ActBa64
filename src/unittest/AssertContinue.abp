' 失敗しても戻る。件数を戻してから後続のテストへ進む。

Sub AssertClearHasNoFail()
    Dim saved As Long
    Dim failed As boolean
    saved = AssertFails
    AssertFails = 0
    failed = AssertHasFail()
    AssertFails = saved
    Assert(false, failed, "clear means no fail")
End Sub

Sub AssertProbeTwo()
    AssertQuiet = true
    Assert(false, true, "continue-a")
    Assert(false, true, "continue-b")
    AssertQuiet = false
    Assert(true, AssertHasFail(), "fails are recorded")
End Sub

Sub AssertContinueCheck(ByVal before As Long)
    Dim after As Long
    after = AssertFails
    AssertFails = before
    Assert(before + 2, after, "two fails counted")
    If before <> 0 Then Exit Sub
    Assert(false, AssertHasFail(), "clear means no fail")
End Sub

Sub AssertContinueTest()
    Dim before As Long
    AssertClearHasNoFail()
    before = AssertFails
    AssertProbeTwo()
    AssertContinueCheck(before)
End Sub

AssertContinueTest()
