' メニュー見出しは UTF-8。無印はワイド API へ渡すので A で読むと CP932。
' 末尾 A は変換しない。区切りは項目数に残る。
Dim h As HMENU
Dim subm As HMENU
Dim buf(15) As Byte

Declare Function GetMenuStringA Lib "user32.dll" (ByVal hMenu As HMENU, ByVal uIDItem As DWord, ByVal lpString As *Byte, ByVal cchMax As Long, ByVal flags As DWord) As Long
Declare Function GetMenuItemCount Lib "user32.dll" (ByVal hMenu As HMENU) As Long

h = CreateMenu()
If h = 0 Then Assert(1, 0, "hmenu")
InsMenu h, 0, MF_SEPARATOR
InsMenu h, 1, MF_BYPOSITION, "編集", 100
Assert(2, GetMenuItemCount(h), "count")
GetMenuStringA(h, 1, VarPtr(buf), 16, MF_BYPOSITION)
Assert(&H95, buf[0], "i0")
Assert(&HD2, buf[1], "i1")
Assert(&H8F, buf[2], "i2")
Assert(&H57, buf[3], "i3")
Assert(0, buf[4], "i4")
subm = CreatePopupMenu()
If subm = 0 Then Assert(1, 0, "popup")
InsMenu h, 2, MF_BYPOSITION, "編集", 0, subm
GetMenuStringA(h, 2, VarPtr(buf), 16, MF_BYPOSITION)
Assert(&H95, buf[0], "p0")
Assert(&H57, buf[3], "p3")
Assert(3, GetMenuItemCount(h), "count2")
DestroyMenu(h)

h = CreateMenu()
If h = 0 Then Assert(1, 0, "hmenu2")
InsertMenu h, 0, MF_SEPARATOR, 0, 0
InsertMenu h, 1, MF_BYPOSITION, 200, "編集"
Assert(2, GetMenuItemCount(h), "ins")
GetMenuStringA(h, 1, VarPtr(buf), 16, MF_BYPOSITION)
Assert(&H95, buf[0], "n0")
Assert(&H57, buf[3], "n3")
InsertMenuA h, 2, MF_BYPOSITION, 201, "編集"
GetMenuStringA(h, 2, VarPtr(buf), 16, MF_BYPOSITION)
Assert(&HE7, buf[0], "a0")
Assert(&HB7, buf[1], "a1")
Assert(&HA8, buf[2], "a2")
Assert(&HE9, buf[3], "a3")
Assert(&H9B, buf[4], "a4")
DestroyMenu(h)

h = CreateMenu()
If h = 0 Then Assert(1, 0, "hmenu3")
AppendMenu h, MF_SEPARATOR, 0, ""
AppendMenu h, MF_STRING, 300, "編集"
Assert(2, GetMenuItemCount(h), "app")
GetMenuStringA(h, 1, VarPtr(buf), 16, MF_BYPOSITION)
Assert(&H95, buf[0], "b0")
Assert(&HD2, buf[1], "b1")
Assert(&H8F, buf[2], "b2")
Assert(&H57, buf[3], "b3")
AppendMenuA h, MF_STRING, 301, "編集"
GetMenuStringA(h, 2, VarPtr(buf), 16, MF_BYPOSITION)
Assert(&HE7, buf[0], "c0")
Assert(&H9B, buf[4], "c4")
DestroyMenu(h)
