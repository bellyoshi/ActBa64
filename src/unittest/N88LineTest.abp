' N88 の行入力。Enter まで未完成。Backspace は 1 文字消す。
Dim n88LineS As String

N88_LineReset()
Assert(0, N88_LinePush(Asc("1")), "1 pending")
Assert(0, N88_LinePush(Asc("2")), "2 pending")
Assert(0, N88_LineDone(), "before enter")
Assert(1, N88_LinePush(13), "enter 12")
Assert(1, N88_LineDone(), "after enter")
n88LineS = N88_LineText$()
Assert(2, Len(n88LineS), "len 12")
Assert(Asc("1"), n88LineS[0], "12[0]")
Assert(Asc("2"), n88LineS[1], "12[1]")

N88_LineReset()
Assert(0, N88_LinePush(Asc("1")), "bs push")
Assert(0, N88_LinePush(8), "bs")
Assert(0, N88_LinePush(Asc("3")), "bs 3")
Assert(0, N88_LineDone(), "bs before enter")
Assert(1, N88_LinePush(13), "bs enter")
n88LineS = N88_LineText$()
Assert(1, Len(n88LineS), "len bs")
Assert(Asc("3"), n88LineS[0], "bs[0]")
