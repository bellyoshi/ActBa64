' 配列名のキャスト（sbSize As LPARAM）は配列の先頭アドレス。ActiveBasic と同じ。
Dim castG[3] As Long

Sub CastArrLocal()
    Dim a[3] As Long
    a[0] = 100
    Assert(-1, (a As LPARAM) = VarPtr(a), "local array cast")
End Sub

castG[0] = 100
Assert(-1, (castG As LPARAM) = VarPtr(castG), "global array cast")
CastArrLocal()
Dim castX As Long
castX = 7
Assert(7, castX As LPARAM, "scalar cast is value")
