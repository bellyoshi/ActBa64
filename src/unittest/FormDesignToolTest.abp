' FormDesign_AddCtl$ ほか（フォームデザイナのツールボックスの文字列処理）。
' ツールの部品を足すと、フィールドに「名前 As 型」、InitializeComponent に位置・大きさと AddControl を書く。

Dim ftNl As String
Dim ftQ As String
Dim ftSrc As String
Dim ftOut As String
Dim ftName As String
Dim ftNm As String
Dim ftX As Long, ftY As Long, ftW As Long, ftH As Long
ftNl = Chr$(10)
ftQ = Chr$(34)
ftSrc = "Class Form1" & ftNl & "    Inherits Form" & ftNl & "Private" & ftNl
ftSrc = ftSrc & "    Button1 As Button" & ftNl & "    Image1 As PictureBox" & ftNl
ftSrc = ftSrc & "    viewer As *PdfViewer" & ftNl
ftSrc = ftSrc & "    Override Sub InitializeComponent()" & ftNl
ftSrc = ftSrc & "        Width = 320" & ftNl
ftSrc = ftSrc & "        Button1.Left = 8" & ftNl & "        AddControl(Button1)" & ftNl
ftSrc = ftSrc & "        AddControl(Image1)" & ftNl
ftSrc = ftSrc & "        OpenDialog1.Filter = " & ftQ & "x" & ftQ & ftNl
ftSrc = ftSrc & "    End Sub" & ftNl & "End Class" & ftNl

Assert(-1, FormDesign_DeclOf$("Button1 As Button", ftNm) = "Button", "ft decl")
Assert(-1, ftNm = "Button1", "ft decl name")
Assert(-1, FormDesign_DeclOf$("p   as *Foo ' c", ftNm) = "*Foo", "ft decl ptr")
Assert(-1, FormDesign_DeclOf$("' B As Button", ftNm) = "", "ft decl comment")
Assert(-1, FormDesign_DeclOf$("Sub Foo()", ftNm) = "", "ft decl sub")
Assert(-1, FormDesign_CtlType$(ftSrc, "image1") = "PictureBox", "ft type")
Assert(-1, FormDesign_CtlType$(ftSrc, "Nothing") = "", "ft type none")
Assert(-1, FormDesign_NewName$(ftSrc, FD_TOOL_BUTTON) = "Button2", "ft new name button")
Assert(-1, FormDesign_NewName$(ftSrc, FD_TOOL_IMAGE) = "Image2", "ft new name image")
Assert(-1, FormDesign_NewName$(ftSrc, FD_TOOL_PANEL) = "Panel1", "ft new name panel")

' Panel を足す: 宣言は最後の部品の宣言の次、行は最後の AddControl の次
ftOut = FormDesign_AddCtl$(ftSrc, FD_TOOL_PANEL, 10, 20, ftName)
Assert(-1, ftName = "Panel1", "ft add name")
Assert(-1, InStr(1, ftOut, "    Image1 As PictureBox" & ftNl & "    Panel1 As Panel" & ftNl & "    viewer") > 0, "ft add decl")
Assert(-1, InStr(1, ftOut, "AddControl(Image1)" & ftNl & ftNl & "        Panel1.Left = 10" & ftNl & "        Panel1.Top = 20" & ftNl) > 0, "ft add lines")
Assert(-1, InStr(1, ftOut, "        Panel1.Caption = " & ftQ & "Panel1" & ftQ & ftNl & "        AddControl(Panel1)" & ftNl & "        OpenDialog1") > 0, "ft add addcontrol")
Assert(1, FormDesign_CtlHas(ftOut, "Panel1"), "ft add has")
Assert(-1, FormDesign_CtlType$(ftOut, "Panel1") = "Panel", "ft add type")
FormDesign_CtlRect(ftOut, "Panel1", ftX, ftY, ftW, ftH)
Assert(-1, ftX = 10 And ftY = 20 And ftW = 200 And ftH = 100, "ft add rect")
Assert(-1, FormDesign_NewName$(ftOut, FD_TOOL_PANEL) = "Panel2", "ft add next name")

' Image は Caption を書かない。型は PictureBox
ftOut = FormDesign_AddCtl$(ftSrc, FD_TOOL_IMAGE, 0, 0, ftName)
Assert(-1, ftName = "Image2", "ft image name")
Assert(-1, InStr(1, ftOut, "Image2 As PictureBox") > 0, "ft image decl")
Assert(0, InStr(1, ftOut, "Image2.Caption"), "ft image no caption")

' 部品も AddControl も無いフォーム: 宣言は Inherits の次、行は End Sub の直前で字下げは End Sub + 4（CRLF のまま）
ftNl = Chr$(13) & Chr$(10)
ftSrc = "Class F" & ftNl & "  Inherits Form" & ftNl & "  Override Sub InitializeComponent()" & ftNl
ftSrc = ftSrc & "    Width = 300" & ftNl & "  End Sub" & ftNl & "End Class" & ftNl
ftOut = FormDesign_AddCtl$(ftSrc, FD_TOOL_BUTTON, 5, 6, ftName)
Assert(-1, ftName = "Button1", "ft empty name")
Assert(-1, InStr(1, ftOut, "  Inherits Form" & ftNl & "  Button1 As Button" & ftNl & "  Override") > 0, "ft empty decl")
Assert(-1, InStr(1, ftOut, "Width = 300" & ftNl & ftNl & "      Button1.Left = 5" & ftNl) > 0, "ft empty lines")
Assert(-1, InStr(1, ftOut, "      AddControl(Button1)" & ftNl & "  End Sub") > 0, "ft empty end")

' 部品の宣言が無く Private があれば、最後の Private の次（字下げは Private + 4）
ftNl = Chr$(10)
ftSrc = "Class Form1" & ftNl & "    Inherits Form" & ftNl & "Public" & ftNl & "    Sub A()" & ftNl & "    End Sub" & ftNl
ftSrc = ftSrc & "Private" & ftNl & "    Override Sub InitializeComponent()" & ftNl & "    End Sub" & ftNl & "End Class" & ftNl
ftOut = FormDesign_AddCtl$(ftSrc, FD_TOOL_BUTTON, 0, 0, ftName)
Assert(-1, InStr(1, ftOut, "Private" & ftNl & "    Button1 As Button" & ftNl & "    Override Sub") > 0, "ft private decl")
' 部品の宣言があれば、後ろの Private より宣言の次
ftSrc = "Class F" & ftNl & "    Inherits Form" & ftNl & "Private" & ftNl & "    B1 As Button" & ftNl & "Public" & ftNl
ftSrc = ftSrc & "Private" & ftNl & "    Override Sub InitializeComponent()" & ftNl & "        AddControl(B1)" & ftNl & "    End Sub" & ftNl & "End Class" & ftNl
ftOut = FormDesign_AddCtl$(ftSrc, FD_TOOL_PANEL, 0, 0, ftName)
Assert(-1, InStr(1, ftOut, "    B1 As Button" & ftNl & "    Panel1 As Panel" & ftNl & "Public") > 0, "ft decl over private")

' デザインできない文書はそのまま
Assert(-1, FormDesign_AddCtl$("Dim a", FD_TOOL_BUTTON, 0, 0, ftName) = "Dim a", "ft not form")
Assert(-1, ftName = "", "ft not form name")
