Assert(true, IsLower(Asc("a")), "IsLower a")
Assert(true, IsLower(Asc("m")), "IsLower m")
Assert(true, IsLower(Asc("z")), "IsLower z")
Assert(false, IsLower(Asc("`")), "IsLower before a")
Assert(false, IsLower(Asc("{")), "IsLower after z")
Assert(false, IsLower(Asc("A")), "IsLower A")
Assert(false, IsLower(Asc("Z")), "IsLower Z")
Assert(false, IsLower(Asc("0")), "IsLower 0")
Assert(false, IsLower(Asc(" ")), "IsLower space")
