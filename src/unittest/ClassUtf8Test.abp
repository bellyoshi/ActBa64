' クラス名は UTF-8。登録はワイド。A で読むと CP932。無印の GetClassName は UTF-8。
Dim wc As WNDCLASSEX
Dim info As WNDCLASSEX
Dim h As HWND
Dim atom As Long
Dim buf(15) As Byte
Dim p As *Byte

Declare Function GetClassNameA Lib "user32.dll" (ByVal hWnd As HWND, ByVal lpClassName As *Byte, ByVal nMaxCount As Long) As Long
Declare Function GetWindowTextA Lib "user32.dll" (ByVal hWnd As HWND, ByVal lpString As *Byte, ByVal nMaxCount As Long) As Long

Function WideClsProc(hWnd As HWND, msg As DWord, wp As WPARAM, lp As LPARAM) As LRESULT
    WideClsProc = DefWindowProc(hWnd, msg, wp, lp)
End Function

FillMemory(VarPtr(wc), Len(wc), 0)
wc.cbSize = Len(wc)
wc.lpfnWndProc = AddressOf(WideClsProc)
wc.hInstance = GetModuleHandle(0)
wc.lpszClassName = "編集"
atom = RegisterClassEx(wc)
If atom = 0 Then Assert(1, 0, "atom")
h = CreateWindowEx(0, "編集", "編集", 0, 0, 0, 10, 10, 0, 0, GetModuleHandle(0), 0)
If h = 0 Then Assert(1, 0, "hwnd")
' DefWindowProc の WM_NCCREATE がタイトルを付ける
GetWindowTextA(h, VarPtr(buf), 16)
Assert(&H95, buf[0], "t0")
Assert(&HD2, buf[1], "t1")
Assert(&H8F, buf[2], "t2")
Assert(&H57, buf[3], "t3")
Assert(0, buf[4], "t4")
GetClassNameA(h, VarPtr(buf), 16)
Assert(&H95, buf[0], "a0")
Assert(&HD2, buf[1], "a1")
Assert(&H8F, buf[2], "a2")
Assert(&H57, buf[3], "a3")
GetClassName(h, VarPtr(buf), 16)
Assert(&HE7, buf[0], "u0")
Assert(&HB7, buf[1], "u1")
Assert(&HA8, buf[2], "u2")
Assert(&HE9, buf[3], "u3")
Assert(&H9B, buf[4], "u4")
Assert(&H86, buf[5], "u5")
Assert(0, buf[6], "u6")
FillMemory(VarPtr(info), Len(info), 0)
info.cbSize = Len(info)
If GetClassInfoEx(GetModuleHandle(0), "編集", info) = 0 Then Assert(1, 0, "info")
p = info.lpszClassName
Assert(&HE7, p[0], "i0")
Assert(&H86, p[5], "i5")
DelWnd h
If UnregisterClass("編集", GetModuleHandle(0)) = 0 Then Assert(1, 0, "unreg")
