' ByteCharUtils

Assert(true, IsLower(Asc("a")), "IsLower a")
Assert(true, IsLower(Asc("m")), "IsLower m")
Assert(true, IsLower(Asc("z")), "IsLower z")
Assert(false, IsLower(Asc("`")), "IsLower before a")
Assert(false, IsLower(Asc("{")), "IsLower after z")
Assert(false, IsLower(Asc("A")), "IsLower A")
Assert(false, IsLower(Asc("Z")), "IsLower Z")
Assert(false, IsLower(Asc("0")), "IsLower 0")
Assert(false, IsLower(Asc(" ")), "IsLower space")

Assert(true, IsUpper(Asc("A")), "IsUpper A")
Assert(true, IsUpper(Asc("M")), "IsUpper M")
Assert(true, IsUpper(Asc("Z")), "IsUpper Z")
Assert(false, IsUpper(Asc("@")), "IsUpper before A")
Assert(false, IsUpper(Asc("[")), "IsUpper after Z")
Assert(false, IsUpper(Asc("a")), "IsUpper a")
Assert(false, IsUpper(Asc("z")), "IsUpper z")
Assert(false, IsUpper(Asc("0")), "IsUpper 0")

Assert(true, IsAlphabet(Asc("A")), "IsAlphabet A")
Assert(true, IsAlphabet(Asc("Z")), "IsAlphabet Z")
Assert(true, IsAlphabet(Asc("a")), "IsAlphabet a")
Assert(true, IsAlphabet(Asc("z")), "IsAlphabet z")
Assert(false, IsAlphabet(Asc("@")), "IsAlphabet before A")
Assert(false, IsAlphabet(Asc("[")), "IsAlphabet after Z")
Assert(false, IsAlphabet(Asc("`")), "IsAlphabet before a")
Assert(false, IsAlphabet(Asc("{")), "IsAlphabet after z")
Assert(false, IsAlphabet(Asc("0")), "IsAlphabet 0")
Assert(false, IsAlphabet(Asc("_")), "IsAlphabet under")

Assert(true, IsDigit(Asc("0")), "IsDigit 0")
Assert(true, IsDigit(Asc("5")), "IsDigit 5")
Assert(true, IsDigit(Asc("9")), "IsDigit 9")
Assert(false, IsDigit(Asc("/")), "IsDigit before 0")
Assert(false, IsDigit(Asc(":")), "IsDigit after 9")
Assert(false, IsDigit(Asc("A")), "IsDigit A")
Assert(false, IsDigit(Asc("a")), "IsDigit a")

Assert(true, IsSpace(32), "IsSpace sp")
Assert(true, IsSpace(9), "IsSpace tab")
Assert(true, IsSpace(10), "IsSpace nl")
Assert(true, IsSpace(13), "IsSpace cr")
Assert(false, IsSpace(0), "IsSpace nul")
Assert(false, IsSpace(11), "IsSpace vt")
Assert(false, IsSpace(Asc("a")), "IsSpace a")

Assert(true, IsHSpace(32), "IsHSpace sp")
Assert(true, IsHSpace(9), "IsHSpace tab")
Assert(false, IsHSpace(10), "IsHSpace nl")
Assert(false, IsHSpace(13), "IsHSpace cr")
Assert(false, IsHSpace(0), "IsHSpace nul")
Assert(false, IsHSpace(Asc("a")), "IsHSpace a")

Assert(true, IsEol(10), "IsEol nl")
Assert(true, IsEol(13), "IsEol cr")
Assert(false, IsEol(32), "IsEol sp")
Assert(false, IsEol(9), "IsEol tab")
Assert(false, IsEol(0), "IsEol nul")

Assert(true, IsIdentChar(Asc("A")), "IsIdentChar A")
Assert(true, IsIdentChar(Asc("Z")), "IsIdentChar Z")
Assert(true, IsIdentChar(Asc("a")), "IsIdentChar a")
Assert(true, IsIdentChar(Asc("z")), "IsIdentChar z")
Assert(true, IsIdentChar(Asc("_")), "IsIdentChar under")
Assert(false, IsIdentChar(Asc("0")), "IsIdentChar 0")
Assert(false, IsIdentChar(Asc("9")), "IsIdentChar 9")
Assert(false, IsIdentChar(32), "IsIdentChar sp")

Assert(true, IsIdentCont(Asc("A")), "IsIdentCont A")
Assert(true, IsIdentCont(Asc("a")), "IsIdentCont a")
Assert(true, IsIdentCont(Asc("_")), "IsIdentCont under")
Assert(true, IsIdentCont(Asc("0")), "IsIdentCont 0")
Assert(true, IsIdentCont(Asc("9")), "IsIdentCont 9")
Assert(false, IsIdentCont(32), "IsIdentCont sp")
Assert(false, IsIdentCont(Asc("$")), "IsIdentCont dollar")

Assert(true, IsHexDigit(Asc("0")), "IsHexDigit 0")
Assert(true, IsHexDigit(Asc("9")), "IsHexDigit 9")
Assert(true, IsHexDigit(Asc("A")), "IsHexDigit A")
Assert(true, IsHexDigit(Asc("F")), "IsHexDigit F")
Assert(true, IsHexDigit(Asc("a")), "IsHexDigit a")
Assert(true, IsHexDigit(Asc("f")), "IsHexDigit f")
Assert(false, IsHexDigit(Asc("/")), "IsHexDigit before 0")
Assert(false, IsHexDigit(Asc(":")), "IsHexDigit after 9")
Assert(false, IsHexDigit(Asc("@")), "IsHexDigit before A")
Assert(false, IsHexDigit(Asc("G")), "IsHexDigit G")
Assert(false, IsHexDigit(Asc("`")), "IsHexDigit before a")
Assert(false, IsHexDigit(Asc("g")), "IsHexDigit g")

Assert(true, IsHexPrefix(Asc("H")), "IsHexPrefix H")
Assert(true, IsHexPrefix(Asc("h")), "IsHexPrefix h")
Assert(false, IsHexPrefix(Asc("G")), "IsHexPrefix G")
Assert(false, IsHexPrefix(Asc("I")), "IsHexPrefix I")
Assert(false, IsHexPrefix(Asc("g")), "IsHexPrefix g")
Assert(false, IsHexPrefix(Asc("i")), "IsHexPrefix i")
Assert(false, IsHexPrefix(Asc("X")), "IsHexPrefix X")

Assert(0, DigitValue(Asc("0")), "DigitValue 0")
Assert(5, DigitValue(Asc("5")), "DigitValue 5")
Assert(9, DigitValue(Asc("9")), "DigitValue 9")

Assert(0, HexDigitValue(Asc("0")), "HexDigitValue 0")
Assert(9, HexDigitValue(Asc("9")), "HexDigitValue 9")
Assert(10, HexDigitValue(Asc("A")), "HexDigitValue A")
Assert(15, HexDigitValue(Asc("F")), "HexDigitValue F")
Assert(10, HexDigitValue(Asc("a")), "HexDigitValue a")
Assert(15, HexDigitValue(Asc("f")), "HexDigitValue f")
Assert(-1, HexDigitValue(Asc("G")), "HexDigitValue G")
Assert(-1, HexDigitValue(Asc("g")), "HexDigitValue g")
Assert(-1, HexDigitValue(Asc("/")), "HexDigitValue slash")
Assert(-1, HexDigitValue(32), "HexDigitValue sp")

Assert(Asc("a"), ToLowerChar(Asc("A")), "ToLower A")
Assert(Asc("m"), ToLowerChar(Asc("M")), "ToLower M")
Assert(Asc("z"), ToLowerChar(Asc("Z")), "ToLower Z")
Assert(Asc("a"), ToLowerChar(Asc("a")), "ToLower a")
Assert(Asc("z"), ToLowerChar(Asc("z")), "ToLower z")
Assert(Asc("@"), ToLowerChar(Asc("@")), "ToLower before A")
Assert(Asc("["), ToLowerChar(Asc("[")), "ToLower after Z")
Assert(Asc("0"), ToLowerChar(Asc("0")), "ToLower 0")
