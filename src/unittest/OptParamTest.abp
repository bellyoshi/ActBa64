' 2 つ目の括弧は省略できる引数。渡せば普通の引数と同じ。
Dim optOut As Long

Function OptAddOne(a As Long)(ByRef e As Long) As Long
    If VarPtr(e) <> 0 Then e = a * 10
    OptAddOne = a + 1
End Function

Sub OptStore(a As Long)(ByRef e As Long, b As Long)
    If VarPtr(e) <> 0 Then e = a + b
End Sub

optOut = 0
Assert(3, OptAddOne(2, optOut), "opt ret")
Assert(20, optOut, "opt byref")
OptStore(4, optOut, 5)
Assert(9, optOut, "opt sub")

' 省略した引数は 0。ByRef なら VarPtr が 0。
Function OptAddr(a As Long)(ByRef e As Long) As Long
    OptAddr = VarPtr(e)
End Function

Function OptTail(a As Long)(b As Long, c As Long) As Long
    OptTail = a * 100 + b * 10 + c
End Function

Function OptDbl(a As Long)(d As Double) As Double
    OptDbl = a + d
End Function

Dim optI As Long
For optI = 1 To 3
    Assert(0, OptAddr(optI), "opt omit byref")
    Assert(6, OptAddOne(5), "opt omit ret")
    Assert(120, OptTail(1, 2), "opt omit tail")
    Assert(700, OptTail(7), "opt omit all")
Next
If OptDbl(2) <> 2 Then Assert(1, 0, "opt omit dbl")
