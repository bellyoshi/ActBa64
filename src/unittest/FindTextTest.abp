#console

' FindText_Forward / Backward は 0 始まり。見つからなければ -1。
' 前向きの origin は含む。後ろ向きの origin は含まない。1 周だけ戻る。
' matchCase が 0 のとき A-Z だけを折る。空の検索語は -1。

Assert(-1, FindText_Forward("ab", "", 0, 1), "fwd empty needle")
Assert(-1, FindText_Forward("", "a", 0, 1), "fwd empty hay")
Assert(-1, FindText_Forward("ab", "abc", 0, 1), "fwd needle longer")
Assert(-1, FindText_Forward("ab ab", "zz", 0, 1), "fwd miss")
Assert(0, FindText_Forward("ab ab", "ab", 0, 1), "fwd at start")
Assert(3, FindText_Forward("ab ab", "ab", 1, 1), "fwd after first")
Assert(3, FindText_Forward("ab ab", "ab", 3, 1), "fwd inclusive")
Assert(0, FindText_Forward("ab ab", "ab", 4, 1), "fwd wrap")
Assert(0, FindText_Forward("ab", "ab", 1, 1), "fwd wrap only")
Assert(0, FindText_Forward("ab", "ab", -3, 1), "fwd neg origin")
Assert(0, FindText_Forward("ab ab", "ab", 100, 1), "fwd far wrap")
Assert(3, FindText_Forward("aB ab", "ab", 0, 1), "fwd skip case")
Assert(-1, FindText_Forward("Ab", "ab", 0, 1), "fwd case miss")
Assert(0, FindText_Forward("Ab", "ab", 0, 0), "fwd ignore case")
Assert(2, FindText_Forward("xxAb", "aB", 0, 0), "fwd ci later")
Assert(2, FindText_Forward("aaba", "b", 0, 1), "fwd letter")
Assert(3, FindText_Forward("あい", "い", 0, 1), "fwd utf8")
Assert(0, FindText_Backward("ab ab", "ab", 3, 1), "back earlier")
Assert(3, FindText_Backward("ab ab", "ab", 4, 1), "back at second")
Assert(3, FindText_Backward("ab ab", "ab", 0, 1), "back wrap")
Assert(0, FindText_Backward("ab", "ab", 0, 1), "back wrap only")
Assert(3, FindText_Backward("ab ab", "ab", 100, 1), "back far")
Assert(-1, FindText_Backward("ab", "", 0, 1), "back empty")
Assert(-1, FindText_Backward("Ab", "ab", 2, 1), "back case miss")
Assert(0, FindText_Backward("Ab", "ab", 2, 0), "back ci")
