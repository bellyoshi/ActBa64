' Atn / Sqr は Double の精度。Atn(1) が π/4 から 0.0125 ずれ（級数の打ち切り）、Sqr は 1e-10 の誤差が残っていた。
' 実数の定数は小数部 9 桁までしか読まれないので、長い定数とは比べず、逆の計算で元に戻るかを見る。
Function MpNear(a As Double, b As Double, tol As Double) As Long
    MpNear = 0
    If Abs(a - b) < tol Then MpNear = 1
End Function

Function MpTol() As Double
    MpTol = (1 / 1000000) / 1000000
End Function

Assert(1, MpNear(Tan(Atn(0.75)), 0.75, MpTol()), "Tan(Atn(0.75))")
Assert(1, MpNear(Tan(Atn(-0.2)), -0.2, MpTol()), "Tan(Atn(-0.2))")
Assert(1, MpNear(Atn(1) * 4, 3.14159265, 1 / 100000000), "Atn(1)*4")
Assert(1, MpNear(Atn(30) + Atn(1 / 30), MathPi() / 2, MpTol()), "Atn(30)+Atn(1/30)")
Assert(1, MpNear(Sqr(0.99) * Sqr(0.99), 0.99, MpTol()), "Sqr(0.99)^2")
Assert(1, MpNear(Sqr(2) * Sqr(2), 2, MpTol()), "Sqr(2)^2")
