' Atn / Sqr は Double の精度。Atn(1) が π/4 から 0.0125 ずれ（級数の打ち切り）、Sqr は 1e-10 の誤差が残っていた。
' 期待値は 17 桁のリテラルで直接書く（実数リテラルは Double の精度で読む）。Atn / Sqr は数 ulp の差を許す。
Sub MpNear(expected As Double, actual As Double, msg As String)
    If Abs(expected - actual) < 0.000000000000001 Then Exit Sub
    AssertDblFail(expected, actual, msg)
End Sub

MpNear(0.6435011087932844, Atn(0.75), "Atn(0.75)")
MpNear(-0.19739555984988078, Atn(-0.2), "Atn(-0.2)")
MpNear(3.141592653589793, Atn(1) * 4, "Atn(1)*4")
MpNear(1.5374753309166493, Atn(30), "Atn(30)")
MpNear(0.99498743710662, Sqr(0.99), "Sqr(0.99)")
MpNear(1.4142135623730951, Sqr(2), "Sqr(2)")
MpNear(0.75, Tan(Atn(0.75)), "Tan(Atn(0.75))")
AssertDbl(1.5707963267948966, MathPi() / 2, "MathPi()/2")
