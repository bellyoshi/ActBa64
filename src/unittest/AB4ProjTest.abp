' AB4ProjText（「AB4 プロジェクト作成」と ProjectCmd -createPj が書くファイルの中身）。
' 期待する文は AB 4.20 の「EXE - ノーマル ウィンドウ ベース」が書いたもの（Desktop の noramlWnd）と同じ。

Dim apN As String
Dim apQ As String
Dim apS As String
apN = Chr$(13) & Chr$(10)
apQ = Chr$(34)

Sub AB4T_Ends(s As String, tail As String, msg As String)
    Assert(-1, Right$(s, Len(tail)) = tail, msg)
End Sub

' 名前は識別子（<name>_DestroyObjects になる）
Assert(1, AB4Proj_NameOk("noramlWnd"), "ab4 name ok")
Assert(1, AB4Proj_NameOk("_a1"), "ab4 name underscore")
Assert(0, AB4Proj_NameOk(""), "ab4 name empty")
Assert(0, AB4Proj_NameOk("1a"), "ab4 name digit first")
Assert(0, AB4Proj_NameOk("a b"), "ab4 name space")
Assert(0, AB4Proj_NameOk("a:b"), "ab4 name colon")
Assert(0, AB4Proj_NameOk("テスト"), "ab4 name kana")
Assert(1, AB4Proj_CanMake(AB4PROJ_NORMAL), "ab4 can normal")
Assert(1, AB4Proj_CanMake(AB4PROJ_N88), "ab4 can n88")
Assert(1, AB4Proj_CanMake(AB4PROJ_DOS), "ab4 can dos")
Assert(1, AB4Proj_IsSingle(AB4PROJ_DOS), "ab4 single dos")
Assert(0, AB4Proj_IsSingle(AB4PROJ_NORMAL), "ab4 single normal")
Assert(1, AB4Proj_CanMake(AB4PROJ_DLL), "ab4 can dll")
Assert(0, AB4Proj_CanMake(AB4PROJ_DIRECTX), "ab4 can directx")
Assert(1, AB4Proj_HasHello(AB4PROJ_DOS), "ab4 hello dos")
Assert(0, AB4Proj_HasHello(AB4PROJ_NOBASE), "ab4 hello nobase")
Assert(0, AB4Proj_HasHello(AB4PROJ_DLL), "ab4 hello dll")
Assert(1, AB4Proj_CanMake(AB4PROJ_NOBASE), "ab4 can nobase")
Assert(1, AB4Proj_IsSingle(AB4PROJ_NOBASE), "ab4 single nobase")

' .pj
apS = AB4Proj_Pj$("nw", apN)
Assert(-1, InStr(1, apS, "#NAME=nw" & apN & apN & "#PLATFORM=32" & apN & apN & "#USEWINDOW=1" & apN) > 0, "ab4 pj head")
Assert(-1, InStr(1, apS, "#OPTION=&H00010000" & apN & apN & "#OUTPUT_RELEASE=.\nw.exe" & apN) > 0, "ab4 pj option")
AB4T_Ends(apS, "#RESOURCE=0" & apN & apN & "#SOURCE" & apN & "nw.abp" & apN & "MainWnd.sbp" & apN, "ab4 pj source")

' .abp / .idx
apS = AB4Proj_Abp$("nw", apN)
Assert(-1, Left$(apS, 21) = "#include " & apQ & "nw.idx" & apQ & apN & apN, "ab4 abp include")
AB4T_Ends(apS, "' Call destructores and exit process" & apN & "End" & apN, "ab4 abp end")
apS = AB4Proj_Idx$(apN)
Assert(-1, InStr(1, apS, apN & "#strict" & apN) > 0, "ab4 idx strict")
AB4T_Ends(apS, "#include " & apQ & "MakeWindow.wbp" & apQ & apN, "ab4 idx make")

' .wnd は RadWnd で読める
RadWnd_Parse(AB4Proj_Wnd$("nw", apN))
Assert(1, g_rwCount, "ab4 wnd one window")
Assert(-1, g_rwName(0) = "MainWnd" And g_rwCaption(0) = "nw", "ab4 wnd name")
Assert(-1, g_rwSize(0) = "480,360" And g_rwStyle(0) = "&H10cf0000", "ab4 wnd size")
Assert(-1, InStr(1, AB4Proj_Wnd$("nw", apN), apN & "    SIZE      = 480,360" & apN) > 0, "ab4 wnd key pad")

' MainWnd.sbp と、そこから作る Callback.wbp
apS = AB4Proj_MainWnd$("nw", 0, apN)
AB4T_Ends(apS, "Sub MainWnd_Destroy()" & apN & Chr$(9) & "nw_DestroyObjects()" & apN & Chr$(9) & "PostQuitMessage(0)" & apN & "End Sub" & apN, "ab4 main destroy")
Assert(0, InStr(1, apS, "MainWnd_Paint"), "ab4 main no paint")
apS = AB4Proj_MainWnd$("nw", 1, apN)
RadSrc_Reset()
RadSrc_Scan(0, apS)
RadSrc_ScanCb(apS)
Assert(1, RadSrc_Has(0, "Paint"), "ab4 hello paint")
Assert(-1, InStr(1, RadGen_Callback$("nw", &H10000), "Sub nw_DestroyObjects()" & apN) > 0, "ab4 cb destroy")
Assert(-1, InStr(1, RadGen_Callback$("nw", &H10000), "MainWnd_Paint(hDC)") > 0, "ab4 cb paint")

' .wrk は最後に改行が無い
AB4T_Ends(AB4Proj_Wrk$(apN), apN & "0,0,0,0,0", "ab4 wrk tail")
' EXE - N88 プロンプト ベース（Desktop の n88 / n88hello と同じ）
apS = AB4Proj_SinglePj$("n8", AB4PROJ_N88, apN)
Assert(-1, InStr(1, apS, "#USEWINDOW=0" & apN & apN & "#OPTION=&H00010000" & apN) > 0, "ab4 n88 pj usewindow")
AB4T_Ends(apS, "#RESOURCE=0" & apN & apN & "#SOURCE" & apN & "n8.abp" & apN, "ab4 n88 pj source")
apS = AB4Proj_PromptAbp$("n8", AB4PROJ_N88, 0, apN)
Assert(-1, apS = "#include " & apQ & "n8.idx" & apQ & apN & apN & "#N88BASIC" & apN & apN & "' ↓ ここからプログラムが実行されます" & apN & apN, "ab4 n88 abp")
AB4T_Ends(AB4Proj_PromptAbp$("n8", AB4PROJ_N88, 1, apN), "ます" & apN & apN & "Print " & apQ & "Hello World!" & apQ & apN, "ab4 n88 abp hello")
Assert(-1, AB4Proj_SingleIdx$(apN) = "' インデックス プログラム" & apN & apN & "#strict" & apN & apN & "'Win32APIの定義ファイル" & apN, "ab4 n88 idx")
Assert(-1, AB4Proj_SingleWrk$("n8", apN) = "case4" & apN & apN & "text," & apQ & "n8.abp" & apQ & ",0,0,0,0" & apN & apN & "0" & apN & "0" & apN & "0" & apN & "0,0,0,0,0", "ab4 n88 wrk")
' EXE - DOS プロンプト ベース（Desktop の dos と同じ。.pj .idx .wrk は N88 と同じ）
apS = AB4Proj_PromptAbp$("n8", AB4PROJ_DOS, 0, apN)
Assert(-1, apS = "#include " & apQ & "n8.idx" & apQ & apN & apN & "#console" & apN & apN & "' ↓ ここからプログラムが実行されます" & apN & apN, "ab4 dos abp")
AB4T_Ends(AB4Proj_PromptAbp$("n8", AB4PROJ_DOS, 1, apN), "ます" & apN & apN & "Print " & apQ & "Hello World!" & apQ & apN, "ab4 dos abp hello")
' EXE - ベースなし（Desktop の none と同じ。指令を置かず、Hello も足さない）
apS = "#include " & apQ & "n8.idx" & apQ & apN & apN & "' ↓ ここからプログラムが実行されます" & apN & apN
Assert(-1, AB4Proj_PromptAbp$("n8", AB4PROJ_NOBASE, 0, apN) = apS, "ab4 nobase abp")
Assert(-1, AB4Proj_PromptAbp$("n8", AB4PROJ_NOBASE, 1, apN) = apS, "ab4 nobase abp hello")
' DLL - プロシージャ ライブラリ（Desktop の dll と同じ）
apS = AB4Proj_SinglePj$("d1", AB4PROJ_DLL, apN)
Assert(-1, InStr(1, apS, "#MODULETYPE=1" & apN) > 0, "ab4 dll pj moduletype")
Assert(-1, InStr(1, apS, "#OUTPUT_RELEASE=.\d1.dll" & apN & apN & "#OUTPUT_DEBUG=.\d1_debug.exe" & apN) > 0, "ab4 dll pj output")
AB4T_Ends(apS, "#SOURCE" & apN & "d1.abp" & apN, "ab4 dll pj source")
apS = AB4Proj_SingleAbp$("d1", AB4PROJ_DLL, 1, apN)
Assert(-1, Left$(apS, 19) = "#include " & apQ & "d1.idx" & apQ & apN, "ab4 dll abp head")
Assert(-1, InStr(1, apS, Chr$(9) & Chr$(9) & Chr$(9) & "_System_StartupProgram()" & apN) > 0, "ab4 dll abp startup")
AB4T_Ends(apS, "End Select" & apN & "End Function" & apN & apN, "ab4 dll abp tail")
Assert(-1, AB4Proj_SinglePj$("n8", AB4PROJ_NOBASE, apN) = AB4Proj_SinglePj$("n8", AB4PROJ_N88, apN), "ab4 single pj nobase")
' ProjectCmd の種類のオプション
Assert(-1, AB4Proj_KindOpt$(AB4PROJ_DLL) = "-dll", "ab4 opt dll")
Assert(-1, AB4Proj_KindOpt$(AB4PROJ_DIRECTX) = "", "ab4 opt directx")
Assert(AB4PROJ_NOBASE, AB4Proj_KindOfOpt("-NOBASE"), "ab4 kind of nobase")
Assert(AB4PROJ_NORMAL, AB4Proj_KindOfOpt("-nomalWnd"), "ab4 kind of nomalwnd")
Assert(-1, AB4Proj_KindOfOpt("-hello"), "ab4 kind of hello")
