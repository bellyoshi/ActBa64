' ProjTreeText（プロジェクト ウィンドウのツリー: 相対パスをフォルダーとファイル名に分ける）。

Assert(-1, ProjTree_Dir$("Main.abp") = "", "ptree dir none")
Assert(-1, ProjTree_Name$("Main.abp") = "Main.abp", "ptree name none")
Assert(-1, ProjTree_Dir$("..\common\TextEnc.abp") = "..\common", "ptree dir up")
Assert(-1, ProjTree_Name$("..\common\TextEnc.abp") = "TextEnc.abp", "ptree name up")
Assert(-1, ProjTree_Dir$("sub/表示.sbp") = "sub", "ptree dir slash")
Assert(-1, ProjTree_Name$("sub/表示.sbp") = "表示.sbp", "ptree name jp")
Assert(-1, ProjTree_Dir$("") = "", "ptree dir empty")
Assert(-1, ProjTree_Name$("C:\x\a.pj") = "a.pj", "ptree root title")
' 同じフォルダーかは大文字小文字と / \ を区別しない
Assert(1, ProjTree_SameDir("Sub\A", "sub/a"), "ptree same dir")
Assert(0, ProjTree_SameDir("sub", "sub2"), "ptree other dir")
' <.pj の名前>.wnd は <.pj の名前>.abp の下にぶら下げる
Assert(-1, ProjTree_WndName$("C:\d\hello2.pj") = "hello2.wnd", "ptree wnd name")
Assert(-1, ProjTree_WndName$("C:\d\Hello2.PJ") = "Hello2.wnd", "ptree wnd name upper")
Assert(1, ProjTree_IsMainSrc("hello2.abp", "C:\d\hello2.pj"), "ptree main src")
Assert(1, ProjTree_IsMainSrc("HELLO2.ABP", "C:\d\hello2.pj"), "ptree main src case")
Assert(0, ProjTree_IsMainSrc("MainWnd.sbp", "C:\d\hello2.pj"), "ptree not main")
Assert(0, ProjTree_IsMainSrc("sub\hello2.abp", "C:\d\hello2.pj"), "ptree main in sub")
' 右クリックの「ファイルを挿入」の相対パス
Assert(-1, ProjTree_RelPath$("C:\d\pj\", "C:\d\pj\a.abp", "\", 1) = "a.abp", "ptree rel same")
Assert(-1, ProjTree_RelPath$("C:\d\pj\", "C:\d\pj\sub\b.sbp", "\", 1) = "sub\b.sbp", "ptree rel sub")
Assert(-1, ProjTree_RelPath$("C:\d\pj\", "C:\d\common\c.sbp", "\", 1) = "..\common\c.sbp", "ptree rel up")
Assert(-1, ProjTree_RelPath$("C:\d\pj\x\", "c:\D\e.sbp", "\", 1) = "..\..\e.sbp", "ptree rel up2 case")
Assert(-1, ProjTree_RelPath$("C:\d\pj\", "D:\e.sbp", "\", 1) = "D:\e.sbp", "ptree rel drive")
Assert(-1, ProjTree_RelPath$("/home/u/pj/", "/home/u/lib/l.sbp", "/", 0) = "../lib/l.sbp", "ptree rel linux")
Assert(-1, ProjTree_RelPath$("/home/u/pj/", "/home/U/pj/l.sbp", "/", 0) = "../../U/pj/l.sbp", "ptree rel linux case")
Assert(1, ProjTree_SamePath("..\Common/B.sbp", "..\common\b.sbp", 1), "ptree same path")
Assert(0, ProjTree_SamePath("..\Common/B.sbp", "..\common\b.sbp", 0), "ptree same path case")
Assert(1, ProjTree_IsAbp("Main.ABP"), "ptree is abp")
Assert(0, ProjTree_IsAbp("Main.sbp"), "ptree not abp")
