' コモンダイアログの構造体サイズは Windows SDK と同じ。lCustData は LPARAM（64bit では 8 バイト）。
' lStructSize が違うと ChooseFont などは CDERR_STRUCTSIZE で何も出さずに失敗する。
' 32bit の PRINTDLG は SDK が pack(1) なので対象外。

Dim cdsFont As CHOOSEFONT
Dim cdsColor As CHOOSECOLOR
Dim cdsFind As FINDREPLACE
Dim cdsPage As PAGESETUPDLG
Dim cdsPrint As PRINTDLG

#ifdef _WIN64
Assert(104, Len(cdsFont), "CHOOSEFONT size")
Assert(48, VarPtr(cdsFont.lCustData) - VarPtr(cdsFont), "CHOOSEFONT lCustData")
Assert(88, VarPtr(cdsFont.nFontType) - VarPtr(cdsFont), "CHOOSEFONT nFontType")
Assert(72, Len(cdsColor), "CHOOSECOLOR size")
Assert(80, Len(cdsFind), "FINDREPLACE size")
Assert(128, Len(cdsPage), "PAGESETUPDLG size")
Assert(120, Len(cdsPrint), "PRINTDLG size")
#else
Assert(60, Len(cdsFont), "CHOOSEFONT size 32")
Assert(36, Len(cdsColor), "CHOOSECOLOR size 32")
Assert(40, Len(cdsFind), "FINDREPLACE size 32")
Assert(84, Len(cdsPage), "PAGESETUPDLG size 32")
#endif
