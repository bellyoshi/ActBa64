' ModifyMenu の見出しは UTF-8。GetMenuStringA は CP932。GetMenuString は UTF-8。
Dim h As HMENU
Dim buf(15) As Byte

Declare Function GetMenuStringA Lib "user32.dll" (ByVal hMenu As HMENU, ByVal uIDItem As DWord, ByVal lpString As *Byte, ByVal cchMax As Long, ByVal flags As DWord) As Long
Declare Function GetMenuItemCount Lib "user32.dll" (ByVal hMenu As HMENU) As Long

h = CreateMenu()
If h = 0 Then Assert(1, 0, "hmenu")
AppendMenu(h, MF_STRING, 1, "x")
ModifyMenu(h, 0, MF_BYPOSITION, 50, "編集")
GetMenuStringA(h, 0, VarPtr(buf), 16, MF_BYPOSITION)
Assert(&H95, buf[0], "a0")
Assert(&HD2, buf[1], "a1")
Assert(&H8F, buf[2], "a2")
Assert(&H57, buf[3], "a3")
GetMenuString(h, 0, VarPtr(buf), 16, MF_BYPOSITION)
Assert(&HE7, buf[0], "u0")
Assert(&HB7, buf[1], "u1")
Assert(&HA8, buf[2], "u2")
Assert(&HE9, buf[3], "u3")
Assert(&H9B, buf[4], "u4")
Assert(&H86, buf[5], "u5")
Assert(0, buf[6], "u6")
ModifyMenu(h, 0, MF_BYPOSITION Or MF_SEPARATOR, 0, 0)
Assert(1, GetMenuItemCount(h), "sep")
DestroyMenu(h)
