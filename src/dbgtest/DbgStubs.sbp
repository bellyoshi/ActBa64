' DbgStubs - デバッガーのユニットテスト用の代わり（ProjectEditor の窓やパイプの部分を使わずに試すため）。
' 送ったコマンド・ツリーに入れた項目・開いた項目を文字にためておき、テストが比べる

Dim g_tsSent As String
Dim g_tsIns As String
Dim g_tsOpen As LONG_PTR

' Project.sbp の代わり（大文字小文字を見ない）
Function ProjSamePath(a As String, b As String) As Long
    ProjSamePath = 0
    If Len(a) = 0 Or Len(b) = 0 Then Exit Function
    If Ad_lstrcmpi(StrPtr(a), StrPtr(b)) = 0 Then ProjSamePath = 1
End Function

' EditorDbg.sbp の代わり（abdbg へ送る 1 行）
Sub EditorDbg_Send(cmd As String)
    g_tsSent = g_tsSent + cmd + "|"
End Sub

' EditorDbgTree.sbp の代わり（ツリーに 1 つ入れる / 開く）
Sub EditorDbgTree_Insert(text As String, expr As String, ByVal kids As Long)
    g_tsIns = g_tsIns + text + "/" + expr + "/" + Str$(kids) + ";"
End Sub

Sub EditorDbgTree_Open(h As LONG_PTR)
    g_tsOpen = h
End Sub

Sub DbgStubs_Reset()
    g_tsSent = ""
    g_tsIns = ""
    g_tsOpen = 0
End Sub
