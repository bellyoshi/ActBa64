' AdCond（条件付きブレークポイントの条件）と、b / d の場所の読み方（AdCmd）

Dim dtP As Long

' 比べ方は長いものから探す
Assert(-1, AdCondOp$("i = 5", dtP) = "=", "cond op eq")
Assert(3, dtP, "cond op eq pos")
Assert(-1, AdCondOp$("n >= 10", dtP) = ">=", "cond op ge")
Assert(-1, AdCondOp$("a <> b", dtP) = "<>", "cond op ne")
Assert(-1, AdCondOp$("x <= 1", dtP) = "<=", "cond op le")
Assert(-1, AdCondOp$("x < 1", dtP) = "<", "cond op lt")
Assert(-1, AdCondOp$("x > 1", dtP) = ">", "cond op gt")
Assert(-1, AdCondOp$("abc", dtP) = "", "cond op none")

' 数として
Assert(1, AdCmpNum(5, 5, "="), "num eq")
Assert(0, AdCmpNum(5, 6, "="), "num eq false")
Assert(1, AdCmpNum(5, 6, "<>"), "num ne")
Assert(1, AdCmpNum(4, 5, "<"), "num lt")
Assert(0, AdCmpNum(5, 5, "<"), "num lt equal")
Assert(1, AdCmpNum(6, 5, ">"), "num gt")
Assert(1, AdCmpNum(5, 5, "<="), "num le")
Assert(1, AdCmpNum(5, 5, ">="), "num ge")
Assert(1, AdCmpNum(-1.5, -1.5, "="), "num real eq")

' 文字として（= と <> だけ）
Assert(1, AdCmpStr(Chr$(34) + "ab" + Chr$(34), Chr$(34) + "ab" + Chr$(34), "="), "str eq")
Assert(0, AdCmpStr(Chr$(34) + "ab" + Chr$(34), Chr$(34) + "ac" + Chr$(34), "="), "str eq false")
Assert(1, AdCmpStr(Chr$(34) + "ab" + Chr$(34), Chr$(34) + "ac" + Chr$(34), "<>"), "str ne")
Assert(0, AdCmpStr(Chr$(34) + "ab" + Chr$(34), Chr$(34) + "ab" + Chr$(34), "<>"), "str ne false")
Assert(-1, AdCmpStr("a", "b", "<"), "str lt is an error")

Assert(-1, AdCsvAt$("a,bb,c,", 0) = "a", "csv 0")
Assert(-1, AdCsvAt$("a,bb,c,", 1) = "bb", "csv 1")
Assert(-1, AdCsvAt$("a,bb,c,", 2) = "c", "csv 2")

' b <場所> if <条件> の " if "（大文字小文字は見ない）
Assert(7, AdFindIf("b 12:3 if i = 5"), "find if")
Assert(5, AdFindIf("b 12 IF n > 1"), "find IF")
Assert(0, AdFindIf("b 12"), "find if none")
Assert(0, AdFindIf("b gift.abp:3"), "find if in name")

' 最後の : （ドライブの C: より後ろ）
Assert(16, AdLastColon("C:/src/main.abp:12"), "last colon path")
Assert(0, AdLastColon("12"), "last colon none")
