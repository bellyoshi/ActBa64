' EditorDbgParse（abdbg の答えの行を分ける）と EditorDbgTreeReq（変数のツリーの問いと答えを組にする）

Assert(-1, EditorDbg_Word$("stop bp 1 4 Twice C:/x.abp") = "stop", "word")
Assert(-1, EditorDbg_After$("stop bp 1 4 Twice C:/x.abp") = "bp 1 4 Twice C:/x.abp", "after")
Assert(-1, EditorDbg_Word$("ready") = "ready", "word only")
Assert(-1, EditorDbg_After$("ready") = "", "after none")
Assert(-1, EditorDbg_NoCr$("abc" + Chr$(13)) = "abc", "no cr")
Assert(-1, EditorDbg_NoCr$("abc") = "abc", "no cr none")

' 一番上（親 0）: 入れるだけで開かない
DbgStubs_Reset()
EditorDbgTree_Ask("@locals", 0)
Assert(-1, g_tsSent = "x @locals|", "ask sends x")
EditorDbgTree_OnHead(2)
EditorDbgTree_OnItem("1 b b {x=1}")
EditorDbgTree_OnItem("0 n n 5(&H5)")
Assert(-1, g_tsIns = "b  {x=1}/b/1;n  5(&H5)/n/0;", "top items")
Assert(0, g_tsOpen, "top not opened")

' 子（親あり）: 入れ終えたら親を開く。数より多い xi は入れない
DbgStubs_Reset()
EditorDbgTree_Ask("b", 1234)
EditorDbgTree_OnHead(1)
EditorDbgTree_OnItem("0 b.x x 1(&H1)")
EditorDbgTree_OnItem("0 b.y y 2(&H2)")
Assert(-1, g_tsIns = "x  1(&H1)/b.x/0;", "child items")
Assert(1234, g_tsOpen, "parent opened")

' ツリーを消した（世代が進んだ）後に来た古い問いの答えは捨てる
DbgStubs_Reset()
EditorDbgTree_Ask("c", 77)
g_dbgTreeGen = g_dbgTreeGen + 1
EditorDbgTree_Ask("@globals", 0)
EditorDbgTree_OnHead(1)
EditorDbgTree_OnItem("0 c.x x 3(&H3)")
EditorDbgTree_OnHead(1)
EditorDbgTree_OnItem("0 g g 7(&H7)")
Assert(-1, g_tsIns = "g  7(&H7)/g/0;", "old answer dropped")
Assert(0, g_tsOpen, "old parent not opened")

' 問いが無いのに来た答えは捨てる
DbgStubs_Reset()
EditorDbgTree_OnHead(1)
EditorDbgTree_OnItem("0 z z 1(&H1)")
Assert(-1, g_tsIns = "", "answer without question")
