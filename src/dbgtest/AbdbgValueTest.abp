' AdValue / AdVarCmd / AdTree の値の種類と大きさ（メモリを読まないところ）、AdVec

' 符号を広げる
Assert(-1, AdSx16(&HFFFF), "sx16 -1")
Assert(5, AdSx16(5), "sx16 5")
Assert(-32768, AdSx16(&H8000), "sx16 min")
Dim dtQ As QWord
dtQ = &HFFFFFFFF
Assert(-1, AdSigned(dtQ, VK_LONG), "signed long")
dtQ = &HFFFE
Assert(-2, AdSigned(dtQ, VK_INTEGER), "signed integer")
Assert(-1, AdUpHex$(255) = "FF", "up hex")
Assert(-1, AdUpHex$(0) = "0", "up hex 0")

' 大きさから
Assert(VK_BYTE, AdVkBySize(1), "by size 1")
Assert(VK_INTEGER, AdVkBySize(2), "by size 2")
Assert(VK_LONG, AdVkBySize(4), "by size 4")
Assert(VK_PTR, AdVkBySize(8), "by size 8")

' 変数の kind（TY_*）と typeIdx（LOW_PTI_*）から
Assert(VK_LONG, AdKindVk(0, -1), "kind long")
Assert(VK_DWORD, AdKindVk(0, -12), "kind dword")
Assert(VK_INT64, AdKindVk(0, -13), "kind int64")
Assert(VK_QWORD, AdKindVk(0, -14), "kind qword")
Assert(VK_PTR, AdKindVk(0, -2), "kind voidptr")
Assert(VK_LPTR, AdKindVk(0, -17), "kind long_ptr")
Assert(VK_STRING, AdKindVk(1, -1), "kind string")
Assert(VK_BYTE, AdKindVk(2, -1), "kind byte")
Assert(VK_UDT, AdKindVk(5, 0), "kind udt")
Assert(VK_PUDT, AdKindVk(7, 0), "kind ptr udt")
Assert(VK_DOUBLE, AdKindVk(10, -1), "kind double")
Assert(VK_SINGLE, AdKindVk(13, -1), "kind single")
Assert(VK_STRING, AdKindVk(8, -1), "kind string array elem")
Assert(VK_WORD, AdKindVk(17, -1), "kind word array elem")
Assert(1, AdKindIsArr(6), "is arr long")
Assert(1, AdKindIsArr(19), "is arr qword")
Assert(0, AdKindIsArr(0), "is arr scalar")
Assert(0, AdKindIsArr(7), "is arr ptr")

' 大きさ（x64。.abdbg の arch x64 を読んだ後）
Assert(4, AdVkSize(VK_LONG, 0), "size long")
Assert(8, AdVkSize(VK_PTR, 0), "size ptr x64")
Assert(8, AdVkSize(VK_STRING, 0), "size string x64")
Assert(2, AdVkSize(VK_WORD, 0), "size word")
Assert(8, AdVkSize(VK_UDT, 0), "size udt Pt")
Assert(1, AdIsIntVk(VK_DWORD), "int dword")
Assert(0, AdIsIntVk(VK_STRING), "int string")
Assert(0, AdIsIntVk(VK_PTR), "int ptr")

' 32bit の exe ではポインタが 4 バイト
g_adArch64 = 0
Assert(4, AdPtrSize(), "ptr size x86")
Assert(4, AdVkSize(VK_STRING, 0), "size string x86")
Assert(-1, AdSigned(&HFFFFFFFF, VK_LPTR), "long_ptr x86 signed")
g_adArch64 = 1
Assert(8, AdPtrSize(), "ptr size x64")

' AdVec は伸びる
Dim dtV As AdVec
Dim dtI As Long
For dtI = 0 To 999
    AdVecPush(VarPtr(dtV), dtI * 3)
Next
Assert(1000, dtV.n, "vec count")
Assert(2997, AdVecAt(VarPtr(dtV), 999), "vec last")
AdVecSet(VarPtr(dtV), 5, 7)
Assert(7, AdVecAt(VarPtr(dtV), 5), "vec set")
