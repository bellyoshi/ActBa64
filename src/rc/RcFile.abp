' RcFile - バイナリの読み書き

Function RcLoad(path As *Byte, ByRef sz As Long) As *Byte
    RcLoad = LoadFile(path, sz)
End Function

Function RcSave(path As *Byte, buf As *Byte, n As Long) As Long
    RcSave = WriteAll(path, buf, n)
    If RcSave = 0 Then Print "error: cannot write " + MakeStr(path)
End Function
