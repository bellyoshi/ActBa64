' RcFile - バイナリの読み書き

Function RcFileSize(h As HANDLE) As Long
    Dim n As DWord
    n = GetFileSize(h, 0)
    RcFileSize = n
End Function

Function RcReadOk(p As *Byte, nRead As Long, sz As Long) As *Byte
    RcReadOk = p
    If nRead = sz Then Exit Function
    free(p)
    RcReadOk = 0
End Function

Function RcReadAll(h As HANDLE, sz As Long) As *Byte
    Dim p As *Byte
    Dim nRead As Long
    RcReadAll = 0
    p = malloc(sz + 1)
    If p = 0 Then Exit Function
    ReadFile(h, p, sz, VarPtr(nRead), 0)
    p[sz] = 0
    RcReadAll = RcReadOk(p, nRead, sz)
End Function

Function RcLoad(path As *Byte, ByRef sz As Long) As *Byte
    Dim h As HANDLE
    RcLoad = 0
    sz = 0
    h = CreateFile(path, GENERIC_READ, FILE_SHARE_READ, 0, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, 0)
    If h = INVALID_HANDLE_VALUE Then Exit Function
    sz = RcFileSize(h)
    If sz > 0 Then RcLoad = RcReadAll(h, sz)
    CloseHandle(h)
End Function

Function RcWriteClose(h As HANDLE, buf As *Byte, n As Long) As Long
    Dim nw As Long
    WriteFile(h, buf, n, VarPtr(nw), 0)
    CloseHandle(h)
    RcWriteClose = 0
    If nw = n Then RcWriteClose = 1
End Function

Function RcSave(path As *Byte, buf As *Byte, n As Long) As Long
    Dim h As HANDLE
    RcSave = 0
    h = CreateFile(path, GENERIC_WRITE, 0, 0, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, 0)
    If h = INVALID_HANDLE_VALUE Then Print "error: cannot write " + MakeStr(path)
    If h = INVALID_HANDLE_VALUE Then Exit Function
    RcSave = RcWriteClose(h, buf, n)
End Function
