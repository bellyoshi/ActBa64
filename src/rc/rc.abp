' rc - ICON 文を RT_ICON / RT_GROUP_ICON の .res にする
#console

Function RcLoadSrc(path As *Byte) As Long
    Dim n As Long
    g_src = RcLoad(path, n)
    If g_src = 0 Then Print "error: cannot open " + MakeStr(path)
    If g_src = 0 Then Exit Function
    g_srcN = n
    g_src[n] = 0
    RcLoadSrc = 1
End Function

Function RcCompile(rcPath As *Byte, outPath As *Byte) As Long
    If RcLoadSrc(rcPath) = 0 Then Exit Function
    If RcParse() = 0 Then Exit Function
    If RcLoadIcons(rcPath) = 0 Then Exit Function
    RcCompile = RcWriteRes(outPath)
End Function

Sub RcUsage()
    Print "usage: rc input.rc -o output.res"
    ExitProcess(1)
End Sub

Sub RcRun()
    RcLoadCmd()
    RcPullArgs()
    If g_argc <> 4 Then RcUsage()
    If RcIsOptO(RcArg(2)) = 0 Then RcUsage()
    If RcCompile(RcArg(1), RcArg(3)) = 0 Then ExitProcess(1)
    ExitProcess(0)
End Sub

RcRun()
