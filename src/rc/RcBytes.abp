' RcBytes - 256 バイト刻みの読み書き

Function RcAtFar(p As *Byte, n As Long) As *Byte
    Dim q As *Byte
    q = p
    While n >= 256
        q = VarPtr(q[256])
        n = n - 256
    Wend
    RcAtFar = q
End Function

Function RcAt(p As *Byte, off As Long) As *Byte
    Dim q As *Byte
    Dim n As Long
    q = RcAtFar(p, off)
    n = off And 255
    If n > 0 Then q = VarPtr(q[n])
    RcAt = q
End Function

Function RcU8(p As *Byte, off As Long) As Long
    Dim q As *Byte
    q = RcAt(p, off)
    RcU8 = GetByte(q) And 255
End Function

Function RcU16(p As *Byte, off As Long) As Long
    Dim a As Long
    Dim b As Long
    a = RcU8(p, off)
    b = RcU8(p, off + 1)
    b = b * 256
    RcU16 = a Or b
End Function

Function RcU32(p As *Byte, off As Long) As Long
    Dim v As Long
    v = RcU16(p, off)
    v = v Or (RcU16(p, off + 2) * 65536)
    RcU32 = v
End Function

Sub RcPut8(p As *Byte, off As Long, v As Long)
    Dim q As *Byte
    q = RcAt(p, off)
    SetByte(q, v)
End Sub

Sub RcPut16(p As *Byte, off As Long, v As Long)
    RcPut8(p, off, v And 255)
    RcPut8(p, off + 1, (v \ 256) And 255)
End Sub

Sub RcPut32(p As *Byte, off As Long, v As Long)
    RcPut16(p, off, v And 65535)
    RcPut16(p, off + 2, (v \ 65536) And 65535)
End Sub
