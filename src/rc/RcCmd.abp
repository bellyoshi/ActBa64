' RcCmd - コマンドライン

Function RcArg(i As Long) As *Byte
    Dim off As Long
    off = i * 512
    RcArg = VarPtr(g_arg(off))
End Function

Function RcPullAt(i As Long) As Long
    Dim buf[MAX_PATH] As Byte
    RcPullAt = 0
    If GetCmd(i, VarPtr(buf)) = 0 Then Exit Function
    lstrcpy(RcArg(i), VarPtr(buf))
    g_argc = i + 1
    RcPullAt = 1
End Function

Sub RcPullArgs()
    g_argc = 0
    If RcPullAt(0) = 0 Then Exit Sub
    If RcPullAt(1) = 0 Then Exit Sub
    If RcPullAt(2) = 0 Then Exit Sub
    RcPullAt(3)
End Sub

Function RcIsOptO(p As *Byte) As Long
    RcIsOptO = 0
    If p[0] <> 45 And p[0] <> 47 Then Exit Function
    If p[1] <> 111 And p[1] <> 79 Then Exit Function
    If p[2] <> 0 Then Exit Function
    RcIsOptO = 1
End Function
