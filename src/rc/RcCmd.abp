' RcCmd - コマンドライン

Function RcArg(i As Long) As *Byte
    Dim off As Long
    off = i * 512
    RcArg = VarPtr(g_arg(off))
End Function

Sub RcLoadCmd()
    Dim p As *Byte
    p = GetCommandLine()
    g_rawN = lstrlen(p)
    If g_rawN > 1023 Then g_rawN = 1023
    memcpy(VarPtr(g_raw), p, g_rawN)
    g_raw(g_rawN) = 0
End Sub

Sub RcSkipSp()
    While g_at < g_rawN
        If g_raw(g_at) <> 32 Then Exit Sub
        g_at = g_at + 1
    Wend
End Sub

Sub RcTakeRaw(dst As *Byte, ByRef m As Long)
    While g_at < g_rawN And g_raw(g_at) <> 32
        If m < 511 Then dst[m] = g_raw(g_at)
        If m < 511 Then m = m + 1
        g_at = g_at + 1
    Wend
End Sub

Sub RcTakeQ(dst As *Byte, ByRef m As Long)
    g_at = g_at + 1
    While g_at < g_rawN And g_raw(g_at) <> 34
        If m < 511 Then dst[m] = g_raw(g_at)
        If m < 511 Then m = m + 1
        g_at = g_at + 1
    Wend
    If g_at < g_rawN Then g_at = g_at + 1
End Sub

Sub RcTakeTok(dst As *Byte)
    Dim m As Long
    m = 0
    If g_raw(g_at) = 34 Then
        RcTakeQ(dst, m)
    Else
        RcTakeRaw(dst, m)
    End If
    dst[m] = 0
End Sub

Sub RcPullArgs()
    g_argc = 0
    g_at = 0
    While g_argc < 4 And g_at < g_rawN
        RcSkipSp()
        If g_at >= g_rawN Then Exit Sub
        RcTakeTok(RcArg(g_argc))
        g_argc = g_argc + 1
    Wend
End Sub

Function RcIsOptO(p As *Byte) As Long
    RcIsOptO = 0
    If p[0] <> 45 And p[0] <> 47 Then Exit Function
    If p[1] <> 111 And p[1] <> 79 Then Exit Function
    If p[2] <> 0 Then Exit Function
    RcIsOptO = 1
End Function
