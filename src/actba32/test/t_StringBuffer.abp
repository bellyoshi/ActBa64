' StringBuffer サンプル
' Expect: 8
#console

#include "..\CharUtils.abp"
#include "..\Common.abp"
#include "..\StringBuffer.abp"

Dim sb As StringBuffer
Dim other As StringBuffer
Dim s As String
Dim n As Long

SbInit(VarPtr(sb))
SbInit(VarPtr(other))

If SbIsEmpty(VarPtr(sb)) = 0 Then
    ExitProcess(1)
End If

SbAppendStr(VarPtr(sb), "foo")
SbAppendStr(VarPtr(sb), "bar")
' "foobar"
SbAppendCRLF(VarPtr(sb))
' "foobar\r\n" len=8

SbClear(VarPtr(sb))
SbAppendStr(VarPtr(sb), "xy")
SbAppendByte(VarPtr(sb), Asc("z"))
' "xyz"

SbAppendStr(VarPtr(other), "!")
SbAppendSb(VarPtr(sb), VarPtr(other))
' "xyz!"

s = SbToString$(VarPtr(sb))
n = SbLen(VarPtr(sb))
' n=4, Len(s)=4 -> 8

SbFree(VarPtr(other))
SbFree(VarPtr(sb))

ExitProcess(n + Len(s))
