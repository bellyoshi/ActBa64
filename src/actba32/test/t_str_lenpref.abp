' Length-prefixed String (AB4.20 compatible)
Dim s As String
Dim t As String
Dim n As Long

s = Chr$(0)
n = Len(s)
If n <> 1 Then
    Print "fail Chr$(0) Len=" + Str$(n)
    End
End If

s = "Hello" + Chr$(0) + "World"
n = Len(s)
If n <> 11 Then
    Print "fail cat Len=" + Str$(n)
    End
End If

t = Left$(s, 5)
If t <> "Hello" Then
    Print "fail Left$"
    End
End If

t = Mid$(s, 7, 5)
If t <> "World" Then
    Print "fail Mid$"
    End
End If

If Asc(s) <> 72 Then
    Print "fail Asc"
    End
End If

s = ""
If Len(s) <> 0 Then
    Print "fail empty"
    End
End If

Print "ok"
End
