' Include/default 自動読み込み一覧（ソースに #include 不要）
' Windows.sbp - Win32 ハンドル型（actba32 サブセット）
' AB420 の Include\windows.sbp 相当の TypeDef 部分のみ。
' api_*.sbp の Declare 群は未対応のためここでは読まない。
TypeDef VoidPtr = Long
TypeDef HANDLE = VoidPtr
TypeDef HGLOBAL = HANDLE
TypeDef HLOCAL = HANDLE
Type _System_DeclareHandle_HINSTANCE
    unused As DWord
End Type
TypeDef HINSTANCE = *_System_DeclareHandle_HINSTANCE
Type _System_DeclareHandle_HKEY
    unused As DWord
End Type
TypeDef HKEY = *_System_DeclareHandle_HKEY
Type _System_DeclareHandle_HMENU
    unused As DWord
End Type
TypeDef HMENU = *_System_DeclareHandle_HMENU
Type _System_DeclareHandle_HWND
    unused As DWord
End Type
TypeDef HWND = *_System_DeclareHandle_HWND
TypeDef HFILE = Long
Type _System_DeclareHandle_HBITMAP
    unused As DWord
End Type
TypeDef HBITMAP = *_System_DeclareHandle_HBITMAP
Type _System_DeclareHandle_HBRUSH
    unused As DWord
End Type
TypeDef HBRUSH = *_System_DeclareHandle_HBRUSH
Type _System_DeclareHandle_HCURSOR
    unused As DWord
End Type
TypeDef HCURSOR = *_System_DeclareHandle_HCURSOR
Type _System_DeclareHandle_HDC
    unused As DWord
End Type
TypeDef HDC = *_System_DeclareHandle_HDC
Type _System_DeclareHandle_HFONT
    unused As DWord
End Type
TypeDef HFONT = *_System_DeclareHandle_HFONT
Type _System_DeclareHandle_HICON
    unused As DWord
End Type
TypeDef HICON = *_System_DeclareHandle_HICON
Type _System_DeclareHandle_HPEN
    unused As DWord
End Type
TypeDef HPEN = *_System_DeclareHandle_HPEN
Type _System_DeclareHandle_HRGN
    unused As DWord
End Type
TypeDef HRGN = *_System_DeclareHandle_HRGN
Type _System_DeclareHandle_HDROP
    unused As DWord
End Type
TypeDef HDROP = *_System_DeclareHandle_HDROP
TypeDef LONG_PTR = Long
TypeDef ULONG_PTR = DWord
TypeDef LRESULT = LONG_PTR
TypeDef WPARAM = ULONG_PTR
TypeDef LPARAM = LONG_PTR
TypeDef LPSTR = *Byte
TypeDef LPCSTR = *Byte
TypeDef BytePtr = *Byte
TypeDef Integer = Long
' WinConsts.sbp - ProjectEditor 等で使う Win32 定数（リテラルのみ）
' AB420 api_window.sbp / api_msg.sbp から必要分を抜粋
' Class styles
Const CS_VREDRAW = &H0001
Const CS_HREDRAW = &H0002
Const CS_DBLCLKS = &H0008
' Sys colors
Const COLOR_BTNFACE = 15
Const COLOR_3DFACE = 15
' Window messages (ProjectEditor で使用)
Const WM_CREATE = &H0001
Const WM_DESTROY = &H0002
Const WM_CLOSE = &H0010
Const WM_QUIT = &H0012
Const WM_SETFONT = &H0030
Const WM_COMMAND = &H0111
' Button notifications
Const BN_CLICKED = 0
' GetWindow
Const GW_OWNER = 4
' Stock icons / cursors
Const IDC_ARROW = 32512
Const IDI_APPLICATION = 32512
Const IDI_WINLOGO = 32517
' MessageBox
Const MB_OK = 0
' NULL（識別子 null も Emit で 0。Const 併用）
Const NULL = 0
' WinTypes.sbp - Win32 構造体（abc 自己ホスト用。AB420 は api_system.sbp 側を使う）
Type SECURITY_ATTRIBUTES
    nLength As DWord
    lpSecurityDescriptor As Long
    bInheritHandle As Long
End Type
Type PROCESS_INFORMATION
    hProcess As HANDLE
    hThread As HANDLE
    dwProcessId As DWord
    dwThreadId As DWord
End Type
Type STARTUPINFO
    cb As DWord
    lpReserved As Long
    lpDesktop As Long
    lpTitle As Long
    dwX As DWord
    dwY As DWord
    dwXSize As DWord
    dwYSize As DWord
    dwXCountChars As DWord
    dwYCountChars As DWord
    dwFillAttribute As DWord
    dwFlags As DWord
    wShowWindow As Word
    cbReserved2 As Word
    lpReserved2 As Long
    hStdInput As HANDLE
    hStdOutput As HANDLE
    hStdError As HANDLE
End Type
Type POINTAPI
    x As Long
    y As Long
End Type
Type MSG
    hwnd As HWND
    message As DWord
    wParam As WPARAM
    lParam As LPARAM
    time As DWord
    pt As POINTAPI
End Type
Type WNDCLASSEX
    cbSize As DWord
    style As DWord
    lpfnWndProc As VoidPtr
    cbClsExtra As Long
    cbWndExtra As Long
    hInstance As HINSTANCE
    hIcon As HICON
    hCursor As HCURSOR
    hbrBackground As HBRUSH
    lpszMenuName As BytePtr
    lpszClassName As BytePtr
    hIconSm As HICON
End Type
' Expect: 41
#console
Dim c As Long
c = Asc(")")
ExitProcess(c)
