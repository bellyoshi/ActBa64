#include "..\CharUtils.abp"
#include "..\Utils.abp"
#include "..\Common.abp"
#include "..\FileIO.abp"
#console
Dim text As String
Dim oneLine As String
Dim eq As Long
Dim value As String
Dim key As String
Dim tmp As String
text = LoadTextFile$("actba32.pj")
Print "len=" + Str$(Len(text))
eq = InStr(1, text, "#PLATFORM=")
Print "pos=" + Str$(eq)
oneLine = Mid$(text, eq, 20)
Print "slice=[" + oneLine + "]"
tmp = "#PLATFORM=32"
eq = InStr(1, tmp, "=")
value = Trim$(Mid$(tmp, eq + 1, Len(tmp) - eq))
key = Lower$(Trim$(Left$(tmp, eq - 1)))
Print "key=[" + key + "]"
Print "value=[" + value + "]"
If value = "32" Then
    Print "OK match"
Else
    Print "NO match"
End If
ExitProcess(0)
