Const CS_HREDRAW = &H0002
Const CS_DBLCLKS = &H0008

' Sys colors
Const COLOR_BTNFACE = 15
Const COLOR_3DFACE = 15

' Window messages (ProjectEditor で使用)
Const WM_CREATE = &H0001
Const WM_DESTROY = &H0002
Const WM_CLOSE = &H0010
Const WM_QUIT = &H0012
Const WM_SETFONT = &H0030
Const WM_COMMAND = &H0111

' Button notifications
Const BN_CLICKED = 0

' GetWindow
Const GW_OWNER = 4

' Stock icons / cursors
Const IDC_ARROW = 32512
Const IDI_APPLICATION = 32512
Const IDI_WINLOGO = 32517

' MessageBox
Const MB_OK = 0

' NULL（識別子 null も Emit で 0。Const 併用）
Const NULL = 0
