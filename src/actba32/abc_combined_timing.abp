' ---- abcLexer.abp ----
' abcLexer.abp - 蟄怜唱隗｣譫撰ｼ亥ｼ乗枚蟄怜・ 竊・繝医・繧ｯ繝ｳ蛻暦ｼ・
' 繝医・繧ｯ繝ｳ繝ｻAST 逕ｨ縺ｮ蜈ｱ譛峨・繝ｼ繝ｫ繧ゅ％縺薙↓鄂ｮ縺・

Const TK_EOF = 0
Const TK_NUM = 1
Const TK_IDENT = 2
Const TK_STR = 3
Const TK_PLUS = 4
Const TK_MINUS = 5
Const TK_STAR = 6
Const TK_SLASH = 7
Const TK_BSLASH = 8
Const TK_EQ = 9
Const TK_NE = 10
Const TK_LT = 11
Const TK_GT = 12
Const TK_LE = 13
Const TK_GE = 14
Const TK_LPAREN = 15
Const TK_RPAREN = 16
Const TK_LBRACK = 17
Const TK_RBRACK = 18
Const TK_COMMA = 19
Const TK_DOT = 20
Const TK_ARROW = 21
Const TK_AND = 22
Const TK_OR = 23
Const TK_XOR = 24
Const TK_MOD = 25

Const MAX_TOKS = 1024
Const MAX_AST = 1024
Const MAX_POOL = 512
Const AST_NIL = -1

' 繝医・繧ｯ繝ｳ・井ｸｦ蛻鈴・蛻暦ｼ・
Dim gTokKind(1023) As Long
Dim gTokSIdx(1023) As Long
Dim gTokIVal(1023) As Long
Dim gNTok As Long
Dim gTokPos As Long

' 譁・ｭ怜・繝励・繝ｫ・郁ｭ伜挨蟄舌・繝ｪ繝・Λ繝ｫ譛ｬ譁・ｼ・
Dim gPool(511) As String
Dim gNPool As Long

' AST・井ｸｦ蛻鈴・蛻暦ｼ・
Dim gAstKind(1023) As Long
Dim gAstOp(1023) As Long
Dim gAstA(1023) As Long
Dim gAstB(1023) As Long
Dim gAstC(1023) As Long
Dim gAstD(1023) As Long
Dim gAstIVal(1023) As Long
Dim gAstSIdx(1023) As Long
Dim gAstFlags(1023) As Long
Dim gNAst As Long
Dim gParseCondMode As Long

Function LexIsIdentStart(c As Long) As Long
    If c >= Asc("A") And c <= Asc("Z") Then
        LexIsIdentStart = 1
    ElseIf c >= Asc("a") And c <= Asc("z") Then
        LexIsIdentStart = 1
    ElseIf c = Asc("_") Then
        LexIsIdentStart = 1
    Else
        LexIsIdentStart = 0
    End If
End Function

Function LexIsIdentChar(c As Long) As Long
    If LexIsIdentStart(c) <> 0 Then
        LexIsIdentChar = 1
    ElseIf c >= Asc("0") And c <= Asc("9") Then
        LexIsIdentChar = 1
    ElseIf c = Asc("$") Then
        LexIsIdentChar = 1
    Else
        LexIsIdentChar = 0
    End If
End Function

Function PoolAdd(s As String) As Long
    If gNPool >= MAX_POOL Then
        Print "string pool overflow"
        PoolAdd = -1
        Exit Function
    End If
    gPool(gNPool) = s
    PoolAdd = gNPool
    gNPool = gNPool + 1
End Function

Function TokPush(kind As Long, sIdx As Long, iVal As Long) As Long
    If gNTok >= MAX_TOKS Then
        Print "token overflow"
        TokPush = 0
        Exit Function
    End If
    gTokKind(gNTok) = kind
    gTokSIdx(gNTok) = sIdx
    gTokIVal(gNTok) = iVal
    gNTok = gNTok + 1
    TokPush = 1
End Function

Function LexKeywordKind(name As String) As Long
    Dim n As String
    n = Lower$(name)
    LexKeywordKind = TK_IDENT
    If n = "and" Then LexKeywordKind = TK_AND
    If n = "or" Then LexKeywordKind = TK_OR
    If n = "xor" Then LexKeywordKind = TK_XOR
    If n = "mod" Then LexKeywordKind = TK_MOD
    If n = "byval" Then LexKeywordKind = TK_IDENT
    If n = "byref" Then LexKeywordKind = TK_IDENT
End Function

Function LexParseNum(p As *Byte, n As Long, ByRef pos As Long, ByRef outVal As Long) As Long
    Dim i As Long
    Dim sign As Long
    Dim v As Long
    Dim c As Long
    Dim start As Long

    LexParseNum = 0
    i = pos
    sign = 1
    If i < n And p[i] = Asc("-") Then
        ' 蜊倬・・繝代・繧ｵ蛛ｴ縲ゅ％縺薙〒縺ｯ謨ｰ蛟､譛ｬ菴薙・縺ｿ
    End If
    start = i
    If i + 1 < n And p[i] = Asc("&") And (p[i + 1] = Asc("H") Or p[i + 1] = Asc("h")) Then
        i = i + 2
        v = 0
        If i >= n Then Exit Function
        While i < n
            c = p[i]
            If c >= Asc("0") And c <= Asc("9") Then
                v = v * 16 + (c - Asc("0"))
            ElseIf c >= Asc("A") And c <= Asc("F") Then
                v = v * 16 + (c - Asc("A") + 10)
            ElseIf c >= Asc("a") And c <= Asc("f") Then
                v = v * 16 + (c - Asc("a") + 10)
            Else
                Exit While
            End If
            i = i + 1
        Wend
        If i = start + 2 Then Exit Function
        outVal = v
        pos = i
        LexParseNum = 1
        Exit Function
    End If

    If i >= n Then Exit Function
    If p[i] < Asc("0") Or p[i] > Asc("9") Then Exit Function
    v = 0
    While i < n
        c = p[i]
        If c < Asc("0") Or c > Asc("9") Then Exit While
        v = v * 10 + (c - Asc("0"))
        i = i + 1
    Wend
    outVal = v
    pos = i
    LexParseNum = 1
End Function

' 蠑乗枚蟄怜・繧偵ヨ繝ｼ繧ｯ繝ｳ蛹悶よ・蜉溘〒 1
Function LexExpr(expr As String) As Long
    Dim e As String
    Dim p As *Byte
    Dim n As Long
    Dim i As Long
    Dim c As Long
    Dim start As Long
    Dim name As String
    Dim lit As String
    Dim sIdx As Long
    Dim kw As Long
    Dim numVal As Long
    Dim closed As Long

    LexExpr = 0
    e = Trim$(expr)
    gNTok = 0
    gTokPos = 0
    gNPool = 0
    gNAst = 0

    n = Len(e)
    If n = 0 Then
        Print "empty expression"
        Exit Function
    End If
    p = StrPtr(e)
    i = 0

    While i < n
        c = p[i]
        If c = Asc(" ") Or c = 9 Then
            i = i + 1
        ElseIf c = Asc("+") Then
            If TokPush(TK_PLUS, -1, 0) = 0 Then Exit Function
            i = i + 1
        ElseIf c = Asc("-") And i + 1 < n And p[i + 1] = Asc(">") Then
            If TokPush(TK_ARROW, -1, 0) = 0 Then Exit Function
            i = i + 2
        ElseIf c = Asc("-") Then
            If TokPush(TK_MINUS, -1, 0) = 0 Then Exit Function
            i = i + 1
        ElseIf c = Asc("*") Then
            If TokPush(TK_STAR, -1, 0) = 0 Then Exit Function
            i = i + 1
        ElseIf c = Asc("/") Then
            If TokPush(TK_SLASH, -1, 0) = 0 Then Exit Function
            i = i + 1
        ElseIf c = Asc("\") Then
            If TokPush(TK_BSLASH, -1, 0) = 0 Then Exit Function
            i = i + 1
        ElseIf c = Asc("=") Then
            If TokPush(TK_EQ, -1, 0) = 0 Then Exit Function
            i = i + 1
        ElseIf c = Asc("<") Then
            If i + 1 < n And p[i + 1] = Asc(">") Then
                If TokPush(TK_NE, -1, 0) = 0 Then Exit Function
                i = i + 2
            ElseIf i + 1 < n And p[i + 1] = Asc("=") Then
                If TokPush(TK_LE, -1, 0) = 0 Then Exit Function
                i = i + 2
            Else
                If TokPush(TK_LT, -1, 0) = 0 Then Exit Function
                i = i + 1
            End If
        ElseIf c = Asc(">") Then
            If i + 1 < n And p[i + 1] = Asc("=") Then
                If TokPush(TK_GE, -1, 0) = 0 Then Exit Function
                i = i + 2
            Else
                If TokPush(TK_GT, -1, 0) = 0 Then Exit Function
                i = i + 1
            End If
        ElseIf c = Asc("(") Then
            If TokPush(TK_LPAREN, -1, 0) = 0 Then Exit Function
            i = i + 1
        ElseIf c = Asc(")") Then
            If TokPush(TK_RPAREN, -1, 0) = 0 Then Exit Function
            i = i + 1
        ElseIf c = &H5B Then
            If TokPush(TK_LBRACK, -1, 0) = 0 Then Exit Function
            i = i + 1
        ElseIf c = &H5D Then
            If TokPush(TK_RBRACK, -1, 0) = 0 Then Exit Function
            i = i + 1
        ElseIf c = Asc(",") Then
            If TokPush(TK_COMMA, -1, 0) = 0 Then Exit Function
            i = i + 1
        ElseIf c = Asc(".") Then
            If TokPush(TK_DOT, -1, 0) = 0 Then Exit Function
            i = i + 1
        ElseIf c = Asc("&") And i + 1 < n And (p[i + 1] = Asc("H") Or p[i + 1] = Asc("h")) Then
            If LexParseNum(p, n, i, numVal) = 0 Then
                Print "bad hex number"
                Exit Function
            End If
            If TokPush(TK_NUM, -1, numVal) = 0 Then Exit Function
        ElseIf c >= Asc("0") And c <= Asc("9") Then
            If LexParseNum(p, n, i, numVal) = 0 Then
                Print "bad number"
                Exit Function
            End If
            If TokPush(TK_NUM, -1, numVal) = 0 Then Exit Function
        ElseIf c = 34 Then
            ' VB 鬚ｨ: "..." 蜀・・ "" 縺ｯ譁・ｭ・"
            i = i + 1
            lit = ""
            closed = 0
            While i < n
                If p[i] = 34 Then
                    If i + 1 < n And p[i + 1] = 34 Then
                        lit = lit + Chr$(34)
                        i = i + 2
                    Else
                        i = i + 1
                        closed = 1
                        Exit While
                    End If
                Else
                    lit = lit + Chr$(p[i])
                    i = i + 1
                End If
            Wend
            If closed = 0 Then
                Print "unterminated string"
                Exit Function
            End If
            sIdx = PoolAdd(lit)
            If sIdx < 0 Then Exit Function
            If TokPush(TK_STR, sIdx, 0) = 0 Then Exit Function
        ElseIf LexIsIdentStart(c) <> 0 Then
            start = i
            i = i + 1
            While i < n
                If LexIsIdentChar(p[i]) = 0 Then Exit While
                i = i + 1
            Wend
            name = Mid$(e, start + 1, i - start)
            ' byval/byref 縺ｯ隱ｭ縺ｿ鬟帙・縺暦ｼ・enArith 莠呈鋤・・
            If Lower$(name) = "byval" Or Lower$(name) = "byref" Then
                ' skip
            Else
                kw = LexKeywordKind(name)
                sIdx = PoolAdd(name)
                If sIdx < 0 Then Exit Function
                If TokPush(kw, sIdx, 0) = 0 Then Exit Function
            End If
        Else
            Print "bad token near: " + Mid$(e, i + 1, 8)
            Exit Function
        End If
    Wend

    If TokPush(TK_EOF, -1, 0) = 0 Then Exit Function
    gTokPos = 0
    LexExpr = 1
End Function
' ---- abcParser.abp ----
' abcParser.abp - 讒区枚隗｣譫撰ｼ医ヨ繝ｼ繧ｯ繝ｳ 竊・AST・・

Const NK_NUM = 1
Const NK_IDENT = 2
Const NK_STR = 3
Const NK_BIN = 4
Const NK_UNARY = 5
Const NK_CALL = 6
Const NK_INDEX = 7
Const NK_MEMBER = 8
Const NK_VARPTR = 9
Const NK_SIZEOF = 10
Const NK_CMP = 11
Const NK_LOGOR = 12
Const NK_LOGAND = 13
Const NK_ARG = 14
Const NK_ADDRESSOF = 15

Const OP_ADD = 1
Const OP_SUB = 2
Const OP_MUL = 3
Const OP_DIV = 4
Const OP_MOD = 5
Const OP_AND = 6
Const OP_OR = 7
Const OP_XOR = 8
Const OP_NEG = 9
Const OP_EQ = 10
Const OP_NE = 11
Const OP_LT = 12
Const OP_GT = 13
Const OP_LE = 14
Const OP_GE = 15
Const OP_DOT = 16
Const OP_ARROW = 17

Function AstNew(kind As Long) As Long
    Dim ni As Long
    If gNAst >= MAX_AST Then
        Print "AST overflow"
        AstNew = -1
        Exit Function
    End If
    ni = gNAst
    gAstKind(ni) = kind
    gAstOp(ni) = 0
    gAstA(ni) = AST_NIL
    gAstB(ni) = AST_NIL
    gAstC(ni) = AST_NIL
    gAstD(ni) = AST_NIL
    gAstIVal(ni) = 0
    gAstSIdx(ni) = -1
    gAstFlags(ni) = 0
    gNAst = gNAst + 1
    AstNew = ni
End Function

Function TokPeek() As Long
    If gTokPos >= gNTok Then
        TokPeek = TK_EOF
    Else
        TokPeek = gTokKind(gTokPos)
    End If
End Function

Function TokTake() As Long
    Dim k As Long
    k = TokPeek()
    If gTokPos < gNTok Then gTokPos = gTokPos + 1
    TokTake = k
End Function

Function TokExpect(kind As Long) As Long
    Dim k As Long
    If TokPeek() <> kind Then
        TokExpect = 0
        Exit Function
    End If
    k = TokTake()
    TokExpect = 1
End Function

Function ParseExpr() As Long
    ParseExpr = ParseBitOr()
End Function

Function ParseCondExpr() As Long
    ParseCondExpr = ParseLogOr()
End Function

Function ParseLogOr() As Long
    Dim left As Long
    Dim right As Long
    Dim ni As Long
    Dim k As Long
    left = ParseLogAnd()
    If left < 0 Then
        ParseLogOr = -1
        Exit Function
    End If
    While TokPeek() = TK_OR
        k = TokTake()
        right = ParseLogAnd()
        If right < 0 Then
            ParseLogOr = -1
            Exit Function
        End If
        ni = AstNew(NK_LOGOR)
        If ni < 0 Then
            ParseLogOr = -1
            Exit Function
        End If
        gAstA(ni) = left
        gAstB(ni) = right
        left = ni
    Wend
    ParseLogOr = left
End Function

Function ParseLogAnd() As Long
    Dim left As Long
    Dim right As Long
    Dim ni As Long
    Dim k As Long
    left = ParseCmp()
    If left < 0 Then
        ParseLogAnd = -1
        Exit Function
    End If
    While TokPeek() = TK_AND
        k = TokTake()
        right = ParseCmp()
        If right < 0 Then
            ParseLogAnd = -1
            Exit Function
        End If
        ni = AstNew(NK_LOGAND)
        If ni < 0 Then
            ParseLogAnd = -1
            Exit Function
        End If
        gAstA(ni) = left
        gAstB(ni) = right
        left = ni
    Wend
    ParseLogAnd = left
End Function

Function ParseCmp() As Long
    Dim left As Long
    Dim right As Long
    Dim ni As Long
    Dim k As Long
    Dim op As Long
    left = ParseExprNoLog()
    If left < 0 Then
        ParseCmp = -1
        Exit Function
    End If
    k = TokPeek()
    op = 0
    If k = TK_EQ Then
        op = OP_EQ
    ElseIf k = TK_NE Then
        op = OP_NE
    ElseIf k = TK_LT Then
        op = OP_LT
    ElseIf k = TK_GT Then
        op = OP_GT
    ElseIf k = TK_LE Then
        op = OP_LE
    ElseIf k = TK_GE Then
        op = OP_GE
    End If
    If op = 0 Then
        ParseCmp = left
        Exit Function
    End If
    k = TokTake()
    right = ParseExprNoLog()
    If right < 0 Then
        ParseCmp = -1
        Exit Function
    End If
    ni = AstNew(NK_CMP)
    If ni < 0 Then
        ParseCmp = -1
        Exit Function
    End If
    gAstOp(ni) = op
    gAstA(ni) = left
    gAstB(ni) = right
    ParseCmp = ni
End Function

' 譚｡莉ｶ縺ｮ豈碑ｼ・が繝壹Λ繝ｳ繝臥畑: And/Or 縺ｯ隲也炊貍皮ｮ怜ｭ舌→縺励※谿九☆・医ン繝・ヨ And 縺ｫ鬟溘ｏ縺帙↑縺・ｼ・
' Xor 縺縺代・蛟､貍皮ｮ励→縺励※縺薙％縺ｧ謇ｱ縺・
Function ParseExprNoLog() As Long
    Dim left As Long
    Dim right As Long
    Dim ni As Long
    Dim k As Long
    left = ParseAdd()
    If left < 0 Then
        ParseExprNoLog = -1
        Exit Function
    End If
    While TokPeek() = TK_XOR
        k = TokTake()
        right = ParseAdd()
        If right < 0 Then
            ParseExprNoLog = -1
            Exit Function
        End If
        ni = AstNew(NK_BIN)
        If ni < 0 Then
            ParseExprNoLog = -1
            Exit Function
        End If
        gAstOp(ni) = OP_XOR
        gAstA(ni) = left
        gAstB(ni) = right
        left = ni
    Wend
    ParseExprNoLog = left
End Function

Function ParseBitOr() As Long
    Dim left As Long
    Dim right As Long
    Dim ni As Long
    Dim k As Long
    left = ParseBitXor()
    If left < 0 Then
        ParseBitOr = -1
        Exit Function
    End If
    While TokPeek() = TK_OR
        k = TokTake()
        right = ParseBitXor()
        If right < 0 Then
            ParseBitOr = -1
            Exit Function
        End If
        ni = AstNew(NK_BIN)
        If ni < 0 Then
            ParseBitOr = -1
            Exit Function
        End If
        gAstOp(ni) = OP_OR
        gAstA(ni) = left
        gAstB(ni) = right
        left = ni
    Wend
    ParseBitOr = left
End Function

Function ParseBitXor() As Long
    Dim left As Long
    Dim right As Long
    Dim ni As Long
    Dim k As Long
    left = ParseBitAnd()
    If left < 0 Then
        ParseBitXor = -1
        Exit Function
    End If
    While TokPeek() = TK_XOR
        k = TokTake()
        right = ParseBitAnd()
        If right < 0 Then
            ParseBitXor = -1
            Exit Function
        End If
        ni = AstNew(NK_BIN)
        If ni < 0 Then
            ParseBitXor = -1
            Exit Function
        End If
        gAstOp(ni) = OP_XOR
        gAstA(ni) = left
        gAstB(ni) = right
        left = ni
    Wend
    ParseBitXor = left
End Function

Function ParseBitAnd() As Long
    Dim left As Long
    Dim right As Long
    Dim ni As Long
    Dim k As Long
    left = ParseAdd()
    If left < 0 Then
        ParseBitAnd = -1
        Exit Function
    End If
    While TokPeek() = TK_AND
        k = TokTake()
        right = ParseAdd()
        If right < 0 Then
            ParseBitAnd = -1
            Exit Function
        End If
        ni = AstNew(NK_BIN)
        If ni < 0 Then
            ParseBitAnd = -1
            Exit Function
        End If
        gAstOp(ni) = OP_AND
        gAstA(ni) = left
        gAstB(ni) = right
        left = ni
    Wend
    ParseBitAnd = left
End Function

Function ParseAdd() As Long
    Dim left As Long
    Dim right As Long
    Dim ni As Long
    Dim k As Long
    left = ParseMul()
    If left < 0 Then
        ParseAdd = -1
        Exit Function
    End If
    k = TokPeek()
    While k = TK_PLUS Or k = TK_MINUS
        k = TokTake()
        right = ParseMul()
        If right < 0 Then
            ParseAdd = -1
            Exit Function
        End If
        ni = AstNew(NK_BIN)
        If ni < 0 Then
            ParseAdd = -1
            Exit Function
        End If
        If k = TK_PLUS Then
            gAstOp(ni) = OP_ADD
        Else
            gAstOp(ni) = OP_SUB
        End If
        gAstA(ni) = left
        gAstB(ni) = right
        left = ni
        k = TokPeek()
    Wend
    ParseAdd = left
End Function

Function ParseMul() As Long
    Dim left As Long
    Dim right As Long
    Dim ni As Long
    Dim k As Long
    Dim op As Long
    left = ParseUnary()
    If left < 0 Then
        ParseMul = -1
        Exit Function
    End If
    k = TokPeek()
    While k = TK_STAR Or k = TK_BSLASH Or k = TK_SLASH Or k = TK_MOD
        k = TokTake()
        op = 0
        If k = TK_STAR Then
            op = OP_MUL
        ElseIf k = TK_BSLASH Or k = TK_SLASH Then
            op = OP_DIV
        ElseIf k = TK_MOD Then
            op = OP_MOD
        End If
        right = ParseUnary()
        If right < 0 Then
            ParseMul = -1
            Exit Function
        End If
        ni = AstNew(NK_BIN)
        If ni < 0 Then
            ParseMul = -1
            Exit Function
        End If
        gAstOp(ni) = op
        gAstA(ni) = left
        gAstB(ni) = right
        left = ni
        k = TokPeek()
    Wend
    ParseMul = left
End Function

Function ParseUnary() As Long
    Dim ni As Long
    Dim child As Long
    Dim k As Long
    If TokPeek() = TK_MINUS Then
        k = TokTake()
        child = ParseUnary()
        If child < 0 Then
            ParseUnary = -1
            Exit Function
        End If
        ni = AstNew(NK_UNARY)
        If ni < 0 Then
            ParseUnary = -1
            Exit Function
        End If
        gAstOp(ni) = OP_NEG
        gAstA(ni) = child
        ParseUnary = ni
        Exit Function
    End If
    ParseUnary = ParsePostfix()
End Function

Function ParseArgList() As Long
    Dim head As Long
    Dim tail As Long
    Dim arg As Long
    Dim ni As Long
    Dim k As Long
    head = AST_NIL
    tail = AST_NIL
    If TokPeek() = TK_RPAREN Then
        ParseArgList = AST_NIL
        Exit Function
    End If
    While TokPeek() <> TK_EOF
        arg = ParseExpr()
        If arg < 0 Then
            ParseArgList = -2
            Exit Function
        End If
        ni = AstNew(NK_ARG)
        If ni < 0 Then
            ParseArgList = -2
            Exit Function
        End If
        gAstA(ni) = arg
        gAstB(ni) = AST_NIL
        If head = AST_NIL Then
            head = ni
            tail = ni
        Else
            gAstB(tail) = ni
            tail = ni
        End If
        If TokPeek() <> TK_COMMA Then Exit While
        k = TokTake()
    Wend
    ParseArgList = head
End Function

Function ParsePostfix() As Long
    Dim ni As Long
    Dim child As Long
    Dim idx As Long
    Dim args As Long
    Dim name As String
    Dim sIdx As Long
    Dim k As Long
    Dim fieldIdx As Long
    Dim opKind As Long

    If TokPeek() = TK_LPAREN Then
        k = TokTake()
        If gParseCondMode <> 0 Then
            child = ParseCondExpr()
        Else
            child = ParseExpr()
        End If
        If child < 0 Then
            ParsePostfix = -1
            Exit Function
        End If
        If TokExpect(TK_RPAREN) = 0 Then
            Print "expected )"
            ParsePostfix = -1
            Exit Function
        End If
        ParsePostfix = child
        Exit Function
    End If

    If TokPeek() = TK_NUM Then
        ni = AstNew(NK_NUM)
        If ni < 0 Then
            ParsePostfix = -1
            Exit Function
        End If
        gAstIVal(ni) = gTokIVal(gTokPos)
        k = TokTake()
        ParsePostfix = ni
        Exit Function
    End If

    If TokPeek() = TK_STR Then
        ni = AstNew(NK_STR)
        If ni < 0 Then
            ParsePostfix = -1
            Exit Function
        End If
        gAstSIdx(ni) = gTokSIdx(gTokPos)
        k = TokTake()
        ParsePostfix = ni
        Exit Function
    End If

    If TokPeek() <> TK_IDENT Then
        Print "expected expression"
        ParsePostfix = -1
        Exit Function
    End If

    sIdx = gTokSIdx(gTokPos)
    name = Lower$(gPool(sIdx))
    k = TokTake()
    ' VarPtr(...) / SizeOf(...) / AddressOf(...)
    If name = "varptr" And TokPeek() = TK_LPAREN Then
        k = TokTake()
        child = ParseExpr()
        If child < 0 Then
            ParsePostfix = -1
            Exit Function
        End If
        If TokExpect(TK_RPAREN) = 0 Then
            Print "VarPtr needs )"
            ParsePostfix = -1
            Exit Function
        End If
        ni = AstNew(NK_VARPTR)
        If ni < 0 Then
            ParsePostfix = -1
            Exit Function
        End If
        gAstA(ni) = child
        ParsePostfix = ni
        Exit Function
    End If

    If name = "addressof" And TokPeek() = TK_LPAREN Then
        k = TokTake()
        If TokPeek() <> TK_IDENT Then
            Print "AddressOf needs procedure name"
            ParsePostfix = -1
            Exit Function
        End If
        ni = AstNew(NK_ADDRESSOF)
        If ni < 0 Then
            ParsePostfix = -1
            Exit Function
        End If
        gAstSIdx(ni) = gTokSIdx(gTokPos)
        k = TokTake()
        If TokExpect(TK_RPAREN) = 0 Then
            Print "AddressOf needs )"
            ParsePostfix = -1
            Exit Function
        End If
        ParsePostfix = ni
        Exit Function
    End If

    If name = "sizeof" And TokPeek() = TK_LPAREN Then
        k = TokTake()
        If TokPeek() = TK_IDENT Then
            ni = AstNew(NK_SIZEOF)
            If ni < 0 Then
                ParsePostfix = -1
                Exit Function
            End If
            gAstSIdx(ni) = gTokSIdx(gTokPos)
            k = TokTake()
            If TokExpect(TK_RPAREN) = 0 Then
                Print "SizeOf needs )"
                ParsePostfix = -1
                Exit Function
            End If
            ParsePostfix = ni
            Exit Function
        End If
        Print "SizeOf needs name"
        ParsePostfix = -1
        Exit Function
    End If

    ' 蜻ｼ縺ｳ蜃ｺ縺・/ 豺ｻ蟄・/ 繝｡繝ｳ繝・
    ni = AstNew(NK_IDENT)
    If ni < 0 Then
        ParsePostfix = -1
        Exit Function
    End If
    gAstSIdx(ni) = sIdx

    k = TokPeek()
    While k = TK_LPAREN Or k = TK_LBRACK Or k = TK_DOT Or k = TK_ARROW
        If k = TK_LPAREN Then
            k = TokTake()
            args = ParseArgList()
            If args < -1 Then
                ParsePostfix = -1
                Exit Function
            End If
            If TokExpect(TK_RPAREN) = 0 Then
                Print "expected )"
                ParsePostfix = -1
                Exit Function
            End If
            child = AstNew(NK_CALL)
            If child < 0 Then
                ParsePostfix = -1
                Exit Function
            End If
            gAstSIdx(child) = gAstSIdx(ni)
            gAstA(child) = args
            ni = child
        ElseIf k = TK_LBRACK Then
            k = TokTake()
            idx = ParseExpr()
            If idx < 0 Then
                ParsePostfix = -1
                Exit Function
            End If
            If TokExpect(TK_RBRACK) = 0 Then
                Print "expected ]"
                ParsePostfix = -1
                Exit Function
            End If
            child = AstNew(NK_INDEX)
            If child < 0 Then
                ParsePostfix = -1
                Exit Function
            End If
            gAstA(child) = ni
            gAstB(child) = idx
            ni = child
        Else
            ' DOT or ARROW
            opKind = TokTake()
            If TokPeek() <> TK_IDENT Then
                Print "expected field name"
                ParsePostfix = -1
                Exit Function
            End If
            fieldIdx = gTokSIdx(gTokPos)
            k = TokTake()
            child = AstNew(NK_MEMBER)
            If child < 0 Then
                ParsePostfix = -1
                Exit Function
            End If
            If opKind = TK_ARROW Then
                gAstOp(child) = OP_ARROW
            Else
                gAstOp(child) = OP_DOT
            End If
            gAstA(child) = ni
            gAstSIdx(child) = fieldIdx
            ni = child
        End If
        k = TokPeek()
    Wend

    ' expr As Type / expr As *Type ・亥､縺ｯ螟峨∴縺壼梛縺縺托ｼ・
    If TokPeek() = TK_IDENT Then
        If Lower$(gPool(gTokSIdx(gTokPos))) = "as" Then
            k = TokTake()
            If TokPeek() = TK_STAR Then
                k = TokTake()
            End If
            If TokPeek() <> TK_IDENT Then
                Print "expected type after As"
                ParsePostfix = -1
                Exit Function
            End If
            k = TokTake()
        End If
    End If

    ParsePostfix = ni
End Function
' ---- abcEmit.abp ----
' abcEmit.abp - AST 縺九ｉ ASM 繧堤函謌・

Function AstIsString(ni As Long) As Long
    Dim name As String
    Dim idx As Long
    Dim base As Long
    AstIsString = 0
    If ni < 0 Then Exit Function
    If gAstKind(ni) = NK_STR Then
        AstIsString = 1
        Exit Function
    End If
    If gAstKind(ni) = NK_BIN And gAstOp(ni) = OP_ADD Then
        If AstIsString(gAstA(ni)) <> 0 Or AstIsString(gAstB(ni)) <> 0 Then
            AstIsString = 1
        End If
        Exit Function
    End If
    If gAstKind(ni) = NK_CALL Then
        name = Lower$(gPool(gAstSIdx(ni)))
        ' VB 諷｣鄙・ 蜷榊燕縺・$ 縺ｧ邨ゅｏ繧矩未謨ｰ縺ｯ String 謌ｻ繧奇ｼ域忰蟆ｾ繝舌う繝医〒蛻､螳夲ｼ・
        idx = Len(name)
        If idx > 0 Then
            ' Mid$/譁・ｭ怜・ = 縺ｫ萓晏ｭ倥○縺壹∵忰蟆ｾ縺・$ 縺玖ｦ九ｋ
            If Asc(Mid$(name, idx, 1)) = Asc("$") Then
                AstIsString = 1
                Exit Function
            End If
        End If
        If name = "chr$" Or name = "left$" Or name = "mid$" Or name = "right$" Or name = "str$" Or name = "hex$" Or name = "lower$" Or name = "trim$" Or name = "makestr" Then
            AstIsString = 1
            Exit Function
        End If
        idx = FindVar(gPool(gAstSIdx(ni)))
        If idx >= 0 Then
            AstIsString = gVarIsStr(idx)
        End If
        Exit Function
    End If
    If gAstKind(ni) = NK_IDENT Then
        idx = FindVar(gPool(gAstSIdx(ni)))
        If idx >= 0 Then AstIsString = gVarIsStr(idx)
        Exit Function
    End If
    If gAstKind(ni) = NK_INDEX Or gAstKind(ni) = NK_CALL Then
        ' CALL 縺ｧ螟画焚豺ｻ蟄励・蝣ｴ蜷医・荳九〒 IDENT 謇ｱ縺・↓縺ｪ繧九％縺ｨ縺悟､壹＞
    End If
    If gAstKind(ni) = NK_INDEX Then
        base = gAstA(ni)
        If gAstKind(base) = NK_IDENT Then
            idx = FindVar(gPool(gAstSIdx(base)))
            If idx >= 0 Then AstIsString = gVarIsStr(idx)
        End If
    End If
End Function

Function CountArgs(argHead As Long) As Long
    Dim n As Long
    Dim p As Long
    n = 0
    p = argHead
    While p <> AST_NIL
        n = n + 1
        p = gAstB(p)
    Wend
    CountArgs = n
End Function

Function ArgAt(argHead As Long, index As Long) As Long
    Dim p As Long
    Dim i As Long
    p = argHead
    i = 0
    While p <> AST_NIL
        If i = index Then
            ArgAt = gAstA(p)
            Exit Function
        End If
        i = i + 1
        p = gAstB(p)
    Wend
    ArgAt = AST_NIL
End Function

' 蟾ｦ霎ｺ蛟､繧｢繝峨Ξ繧ｹ 竊・eax・・yRef 螳溷ｼ墓焚・・
Function EmitLValueAddr(ni As Long) As Long
    Dim kind As Long
    Dim name As String
    Dim idx As Long
    Dim args As Long
    Dim fieldSize As Long
    Dim access As String

    EmitLValueAddr = 0
    If ni < 0 Then Exit Function
    kind = gAstKind(ni)

    If kind = NK_IDENT Then
        name = gPool(gAstSIdx(ni))
        idx = FindVar(name)
        If idx < 0 Then
            Print "ByRef undeclared: " + name
            Exit Function
        End If
        EmitAddrOfVar(idx)
        EmitAsm("mov eax, ebx")
        EmitLValueAddr = 1
        Exit Function
    End If

    If kind = NK_INDEX Then
        If gAstKind(gAstA(ni)) <> NK_IDENT Then
            Print "ByRef bad index"
            Exit Function
        End If
        name = gPool(gAstSIdx(gAstA(ni)))
        idx = FindVar(name)
        If idx < 0 Then
            Print "ByRef undeclared: " + name
            Exit Function
        End If
        If EmitExpr(gAstB(ni)) = 0 Then Exit Function
        EmitScaleAddBase(idx)
        EmitAsm("mov eax, ebx")
        EmitLValueAddr = 1
        Exit Function
    End If

    If kind = NK_MEMBER Then
        If gAstKind(gAstA(ni)) <> NK_IDENT Then
            Print "ByRef member base must be ident"
            Exit Function
        End If
        If gAstOp(ni) = OP_ARROW Then
            access = gPool(gAstSIdx(gAstA(ni))) + "->" + gPool(gAstSIdx(ni))
        Else
            access = gPool(gAstSIdx(gAstA(ni))) + "." + gPool(gAstSIdx(ni))
        End If
        fieldSize = 0
        If EmitMemberAddr(access, fieldSize) = 0 Then
            Print "ByRef bad member: " + access
            Exit Function
        End If
        EmitAsm("mov eax, ebx")
        EmitLValueAddr = 1
        Exit Function
    End If

    If kind = NK_CALL Then
        ' a(i) 豺ｻ蟄怜ｽ｢蠑・
        name = gPool(gAstSIdx(ni))
        idx = FindVar(name)
        args = gAstA(ni)
        If idx < 0 Or CountArgs(args) <> 1 Then
            Print "ByRef needs a variable: " + name
            Exit Function
        End If
        If EmitExpr(ArgAt(args, 0)) = 0 Then Exit Function
        EmitScaleAddBase(idx)
        EmitAsm("mov eax, ebx")
        EmitLValueAddr = 1
        Exit Function
    End If

    Print "ByRef needs a variable"
End Function

Function EmitExpr(ni As Long) As Long
    Dim kind As Long
    Dim op As Long
    Dim name As String
    Dim idx As Long
    Dim ci As Long
    Dim args As Long
    Dim nArgs As Long
    Dim a0 As Long
    Dim a1 As Long
    Dim a2 As Long
    Dim i As Long
    Dim base As Long
    Dim lit As String
    Dim label As String
    Dim fieldSize As Long
    Dim access As String
    Dim fi As Long
    Dim ti As Long
    Dim si As Long

    EmitExpr = 0
    If ni < 0 Then Exit Function
    kind = gAstKind(ni)
    op = gAstOp(ni)

    If kind = NK_NUM Then
        EmitAsm("mov eax, " + Trim$(Str$(gAstIVal(ni))))
        EmitExpr = 1
        Exit Function
    End If

    If kind = NK_STR Then
        lit = Chr$(34) + gPool(gAstSIdx(ni)) + Chr$(34)
        label = AddStringLit$(lit)
        EmitAsm("push " + label)
        EmitAsm("pop eax")
        EmitExpr = 1
        Exit Function
    End If

    If kind = NK_IDENT Then
        name = gPool(gAstSIdx(ni))
        If Lower$(name) = "null" Then
            EmitAsm("mov eax, 0")
            EmitExpr = 1
            Exit Function
        End If
        ' Function 蜀・〒閾ｪ蛻・・蜷榊燕繧貞盾辣ｧ 竊・謌ｻ繧雁､繧ｹ繝ｭ繝・ヨ
        If gInProc <> 0 And gProcIsFunc <> 0 Then
            If StrEqCI(name, gProcName) <> 0 Then
                EmitAsm("mov ebx, ebp")
                EmitAsm("add ebx, " + Trim$(Str$(gRetOff)))
                EmitAsm("mov eax, " + Chr$(&H5B) + "ebx" + Chr$(&H5D))
                EmitExpr = 1
                Exit Function
            End If
        End If
        ci = FindConst(name)
        If ci >= 0 Then
            EmitAsm("mov eax, " + Trim$(Str$(gConstVal(ci))))
            EmitExpr = 1
            Exit Function
        End If
        idx = FindVar(name)
        If idx >= 0 Then
            If gVarCount(idx) > 1 Then
                ' 驟榊・蜷榊腰菴・竊・蜈磯ｭ繧｢繝峨Ξ繧ｹ
                EmitAddrVar(idx)
                EmitAsm("mov eax, ebx")
            ElseIf gVarTypeIdx(idx) >= 0 And gVarIsPtr(idx) = 0 Then
                ' UDT・・ype 螟画焚・俄・ ByRef 逶ｸ蠖薙〒繧｢繝峨Ξ繧ｹ繧呈ｸ｡縺・
                ' ・亥､繝ｭ繝ｼ繝峨・ eax 縺ｫ霈峨ｉ縺ｪ縺・/ CreateProcess 遲峨・ WinAPI 蜷代￠・・
                EmitAddrVar(idx)
                EmitAsm("mov eax, ebx")
            Else
                EmitLoadVar(idx)
            End If
            EmitExpr = 1
            Exit Function
        End If
        Print "error: unknown or undeclared name in expression: " + name
        Print "  hint: Dim/Const it first, or check spelling; unary minus uses '- x' form"
        Exit Function
    End If

    If kind = NK_UNARY And op = OP_NEG Then
        If EmitExpr(gAstA(ni)) = 0 Then Exit Function
        EmitAsm("neg eax")
        EmitExpr = 1
        Exit Function
    End If

    If kind = NK_BIN Then
        If op = OP_ADD And (AstIsString(gAstA(ni)) <> 0 Or AstIsString(gAstB(ni)) <> 0) Then
            EnsureStringRt()
            If EmitExpr(gAstB(ni)) = 0 Then Exit Function
            EmitAsm("push eax")
            If EmitExpr(gAstA(ni)) = 0 Then Exit Function
            EmitAsm("push eax")
            EmitAsm("call _rt_Cat")
            EmitExpr = 1
            Exit Function
        End If
        If op = OP_SUB Or op = OP_DIV Or op = OP_MOD Then
            If EmitExpr(gAstA(ni)) = 0 Then Exit Function
            EmitAsm("push eax")
            If EmitExpr(gAstB(ni)) = 0 Then Exit Function
            EmitAsm("mov ecx, eax")
            EmitAsm("pop eax")
            If op = OP_SUB Then
                EmitAsm("sub eax, ecx")
            ElseIf op = OP_DIV Then
                EmitAsm("xor edx, edx")
                EmitAsm("div ecx")
            Else
                EmitAsm("xor edx, edx")
                EmitAsm("div ecx")
                EmitAsm("mov eax, edx")
            End If
            EmitExpr = 1
            Exit Function
        End If
        If EmitExpr(gAstA(ni)) = 0 Then Exit Function
        EmitAsm("push eax")
        If EmitExpr(gAstB(ni)) = 0 Then Exit Function
        EmitAsm("pop ecx")
        If op = OP_ADD Then
            EmitAsm("add eax, ecx")
        ElseIf op = OP_MUL Then
            EmitAsm("imul eax, ecx")
        ElseIf op = OP_AND Then
            EmitAsm("and eax, ecx")
        ElseIf op = OP_OR Then
            EmitAsm("or eax, ecx")
        ElseIf op = OP_XOR Then
            EmitAsm("xor eax, ecx")
        Else
            Print "unknown bin op"
            Exit Function
        End If
        EmitExpr = 1
        Exit Function
    End If

    If kind = NK_VARPTR Then
        base = gAstA(ni)
        If gAstKind(base) = NK_IDENT Then
            idx = FindVar(gPool(gAstSIdx(base)))
            If idx < 0 Then
                Print "VarPtr undeclared: " + gPool(gAstSIdx(base))
                Exit Function
            End If
            EmitAddrOfVar(idx)
            EmitAsm("mov eax, ebx")
            EmitExpr = 1
            Exit Function
        End If
        If gAstKind(base) = NK_CALL Then
            name = gPool(gAstSIdx(base))
            idx = FindVar(name)
            args = gAstA(base)
            If idx < 0 Or CountArgs(args) <> 1 Then
                Print "VarPtr bad index"
                Exit Function
            End If
            If EmitExpr(ArgAt(args, 0)) = 0 Then Exit Function
            EmitScaleAddBase(idx)
            EmitAsm("mov eax, ebx")
            EmitExpr = 1
            Exit Function
        End If
        If gAstKind(base) = NK_INDEX Then
            If gAstKind(gAstA(base)) <> NK_IDENT Then
                Print "VarPtr bad index"
                Exit Function
            End If
            idx = FindVar(gPool(gAstSIdx(gAstA(base))))
            If idx < 0 Then
                Print "VarPtr undeclared"
                Exit Function
            End If
            If EmitExpr(gAstB(base)) = 0 Then Exit Function
            EmitScaleAddBase(idx)
            EmitAsm("mov eax, ebx")
            EmitExpr = 1
            Exit Function
        End If
        Print "VarPtr bad form"
        Exit Function
    End If

    If kind = NK_SIZEOF Then
        name = gPool(gAstSIdx(ni))
        idx = FindVar(name)
        If idx >= 0 Then
            EmitAsm("mov eax, " + Trim$(Str$(gVarSize(idx))))
            EmitExpr = 1
            Exit Function
        End If
        i = TypeSizeOf(name)
        If i > 0 Then
            EmitAsm("mov eax, " + Trim$(Str$(i)))
            EmitExpr = 1
            Exit Function
        End If
        Print "unknown SizeOf target: " + name
        Exit Function
    End If

    If kind = NK_ADDRESSOF Then
        ' 謇狗ｶ壹″繝ｩ繝吶Ν _Name 縺ｮ繧｢繝峨Ξ繧ｹ・・tdcall 繧ｳ繝ｼ繝ｫ繝舌ャ繧ｯ逕ｨ・・
        name = gPool(gAstSIdx(ni))
        If IsIdentName(name) = 0 Then
            Print "AddressOf needs procedure name"
            Exit Function
        End If
        EmitAsm("mov eax, _" + name)
        EmitExpr = 1
        Exit Function
    End If

    If kind = NK_MEMBER Then
        ' EmitMemberAddr 莠呈鋤縺ｮ譁・ｭ怜・繧堤ｵ・∩遶九※
        If gAstKind(gAstA(ni)) <> NK_IDENT Then
            Print "member base must be ident"
            Exit Function
        End If
        If gAstOp(ni) = OP_ARROW Then
            access = gPool(gAstSIdx(gAstA(ni))) + "->" + gPool(gAstSIdx(ni))
        Else
            access = gPool(gAstSIdx(gAstA(ni))) + "." + gPool(gAstSIdx(ni))
        End If
        fieldSize = 0
        If EmitMemberAddr(access, fieldSize) = 0 Then
            Print "error: bad member access: " + access
            Print "  hint: base must be a Dim'd Type (or Type pointer for ->)"
            Exit Function
        End If
        EmitLoadSized(fieldSize)
        EmitExpr = 1
        Exit Function
    End If

    If kind = NK_INDEX Then
        If gAstKind(gAstA(ni)) <> NK_IDENT Then
            Print "index base must be ident"
            Exit Function
        End If
        name = gPool(gAstSIdx(gAstA(ni)))
        idx = FindVar(name)
        If idx < 0 Then
            Print "undeclared: " + name
            Exit Function
        End If
        If EmitExpr(gAstB(ni)) = 0 Then Exit Function
        EmitScaleAddBase(idx)
        EmitLoadSized(gVarSize(idx))
        EmitExpr = 1
        Exit Function
    End If

    If kind = NK_CALL Then
        name = gPool(gAstSIdx(ni))
        args = gAstA(ni)
        nArgs = CountArgs(args)
        idx = FindVar(name)

        ' 螟画焚縺ｮ a(i) 豺ｻ蟄・
        If idx >= 0 Then
            If nArgs <> 1 Then
                Print "bad index arity: " + name
                Exit Function
            End If
            If EmitExpr(ArgAt(args, 0)) = 0 Then Exit Function
            EmitScaleAddBase(idx)
            EmitLoadSized(gVarSize(idx))
            EmitExpr = 1
            Exit Function
        End If

        ' 譁・ｭ怜・邨・∩霎ｼ縺ｿ
        If Lower$(name) = "len" Or Lower$(name) = "asc" Or Lower$(name) = "strptr" Or Lower$(name) = "chr$" Or Lower$(name) = "left$" Or Lower$(name) = "mid$" Or Lower$(name) = "right$" Or Lower$(name) = "str$" Or Lower$(name) = "hex$" Or Lower$(name) = "val" Or Lower$(name) = "loword" Or Lower$(name) = "hiword" Or Lower$(name) = "makeintresource" Then
            a0 = ArgAt(args, 0)
            a1 = ArgAt(args, 1)
            a2 = ArgAt(args, 2)
            If Lower$(name) = "len" Or Lower$(name) = "asc" Or Lower$(name) = "strptr" Or Lower$(name) = "chr$" Or Lower$(name) = "str$" Or Lower$(name) = "hex$" Or Lower$(name) = "val" Or Lower$(name) = "loword" Or Lower$(name) = "hiword" Or Lower$(name) = "makeintresource" Then
                If nArgs <> 1 Then
                    Print Lower$(name) + " needs 1 argument"
                    Exit Function
                End If
                ' Len(讒矩菴・ 縺ｯ EmitExpr(a0) 蜑阪↓蛻､螳夲ｼ亥､縺ｯ荳崎ｦ・ｼ・
                If Lower$(name) = "len" Then
                    If gAstKind(a0) = NK_IDENT Then
                        idx = FindVar(gPool(gAstSIdx(a0)))
                        If idx >= 0 Then
                            If gVarIsStr(idx) = 0 And gVarTypeIdx(idx) >= 0 And gVarCount(idx) = 1 Then
                                EmitAsm("mov eax, " + Trim$(Str$(gTypeSize(gVarTypeIdx(idx)))))
                                EmitExpr = 1
                                Exit Function
                            End If
                        End If
                    End If
                End If
                If EmitExpr(a0) = 0 Then Exit Function
                If Lower$(name) = "strptr" Then
                    EmitExpr = 1
                    Exit Function
                End If
                If Lower$(name) = "loword" Then
                    EmitAsm("and eax, 65535")
                    EmitExpr = 1
                    Exit Function
                End If
                If Lower$(name) = "hiword" Then
                    EmitAsm("shr eax, 16")
                    EmitAsm("and eax, 65535")
                    EmitExpr = 1
                    Exit Function
                End If
                If Lower$(name) = "makeintresource" Then
                    EmitExpr = 1
                    Exit Function
                End If
                EnsureStringRt()
                EmitAsm("push eax")
                If Lower$(name) = "len" Then
                    EmitAsm("call _rt_Len")
                ElseIf Lower$(name) = "asc" Then
                    EmitAsm("call _rt_Asc")
                ElseIf Lower$(name) = "str$" Then
                    EmitAsm("call _rt_Str")
                ElseIf Lower$(name) = "hex$" Then
                    EmitAsm("call _rt_Hex")
                ElseIf Lower$(name) = "val" Then
                    EmitAsm("call _rt_Val")
                Else
                    EmitAsm("call _rt_Chr")
                End If
                EmitExpr = 1
                Exit Function
            ElseIf Lower$(name) = "left$" Then
                If nArgs <> 2 Then
                    Print "Left$ needs 2 arguments"
                    Exit Function
                End If
                EnsureStringRt()
                If EmitExpr(a1) = 0 Then Exit Function
                EmitAsm("push eax")
                If EmitExpr(a0) = 0 Then Exit Function
                EmitAsm("push eax")
                EmitAsm("call _rt_Left")
                EmitExpr = 1
                Exit Function
            ElseIf Lower$(name) = "right$" Then
                ' Right$(s, n) = Mid$(s, Len(s)-n+1, n)
                If nArgs <> 2 Then
                    Print "Right$ needs 2 arguments"
                    Exit Function
                End If
                EnsureStringRt()
                If EmitExpr(a0) = 0 Then Exit Function
                EmitAsm("push eax")
                EmitAsm("push eax")
                EmitAsm("call _rt_Len")
                EmitAsm("push eax")
                If EmitExpr(a1) = 0 Then Exit Function
                EmitAsm("mov ecx, eax")
                EmitAsm("pop eax")
                EmitAsm("sub eax, ecx")
                EmitAsm("add eax, 1")
                EmitAsm("pop edx")
                EmitAsm("push ecx")
                EmitAsm("push eax")
                EmitAsm("push edx")
                EmitAsm("call _rt_Mid")
                EmitExpr = 1
                Exit Function
            Else
                If nArgs <> 2 And nArgs <> 3 Then
                    Print "Mid$ needs 2 or 3 arguments"
                    Exit Function
                End If
                EnsureStringRt()
                If nArgs = 3 Then
                    If EmitExpr(a2) = 0 Then Exit Function
                Else
                    EmitAsm("mov eax, -1")
                End If
                EmitAsm("push eax")
                If EmitExpr(a1) = 0 Then Exit Function
                EmitAsm("push eax")
                If EmitExpr(a0) = 0 Then Exit Function
                EmitAsm("push eax")
                EmitAsm("call _rt_Mid")
                EmitExpr = 1
                Exit Function
            End If
        End If

        ' 荳闊ｬ蜻ｼ縺ｳ蜃ｺ縺暦ｼ・tdcall: 蜿ｳ縺九ｉ push・・
        si = FindSig(name)
        i = nArgs - 1
        While i >= 0
            If SigArgByRef(si, i) <> 0 Then
                If EmitLValueAddr(ArgAt(args, i)) = 0 Then Exit Function
            Else
                If EmitExpr(ArgAt(args, i)) = 0 Then Exit Function
            End If
            EmitAsm("push eax")
            i = i - 1
        Wend
        EmitCallName(name)
        EmitExpr = 1
        Exit Function
    End If

    Print "EmitExpr: bad node"
End Function

Function EmitCond(ni As Long, falseLab As String) As Long
    Dim rightLab As String
    Dim doneLab As String
    Dim isStr As Long
    Dim op As Long

    EmitCond = 0
    If ni < 0 Then Exit Function

    If gAstKind(ni) = NK_LOGOR Then
        rightLab = NewLabel$()
        doneLab = NewLabel$()
        If EmitCond(gAstA(ni), rightLab) = 0 Then Exit Function
        EmitAsm("jmp " + doneLab)
        EmitLabel(rightLab)
        If EmitCond(gAstB(ni), falseLab) = 0 Then Exit Function
        EmitLabel(doneLab)
        EmitCond = 1
        Exit Function
    End If

    If gAstKind(ni) = NK_LOGAND Then
        If EmitCond(gAstA(ni), falseLab) = 0 Then Exit Function
        EmitCond = EmitCond(gAstB(ni), falseLab)
        Exit Function
    End If

    If gAstKind(ni) = NK_CMP Then
        op = gAstOp(ni)
        isStr = AstIsString(gAstA(ni)) Or AstIsString(gAstB(ni))
        If (op = OP_EQ Or op = OP_NE) And isStr <> 0 Then
            EnsureStringRt()
            If EmitExpr(gAstB(ni)) = 0 Then Exit Function
            EmitAsm("push eax")
            If EmitExpr(gAstA(ni)) = 0 Then Exit Function
            EmitAsm("push eax")
            EmitAsm("call _lstrcmpA@8")
            EmitAsm("cmp eax, 0")
            If op = OP_EQ Then
                EmitAsm("jne " + falseLab)
            Else
                EmitAsm("je " + falseLab)
            End If
            EmitCond = 1
            Exit Function
        End If
        If EmitExpr(gAstA(ni)) = 0 Then Exit Function
        EmitAsm("push eax")
        If EmitExpr(gAstB(ni)) = 0 Then Exit Function
        EmitAsm("pop ecx")
        EmitAsm("cmp ecx, eax")
        If op = OP_EQ Then
            EmitAsm("jne " + falseLab)
        ElseIf op = OP_NE Then
            EmitAsm("je " + falseLab)
        ElseIf op = OP_LT Then
            EmitAsm("jge " + falseLab)
        ElseIf op = OP_GT Then
            EmitAsm("jle " + falseLab)
        ElseIf op = OP_LE Then
            EmitAsm("jg " + falseLab)
        ElseIf op = OP_GE Then
            EmitAsm("jl " + falseLab)
        End If
        EmitCond = 1
        Exit Function
    End If

    ' 蛟､縺ｮ逵溷⊃
    If EmitExpr(ni) = 0 Then Exit Function
    EmitAsm("cmp eax, 0")
    EmitAsm("je " + falseLab)
    EmitCond = 1
End Function
