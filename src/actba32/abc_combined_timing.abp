    RtLine("    call _GetProcessHeap@0")
    RtLine("    push 12")
    RtLine("    push 0")
    RtLine("    push eax")
    RtLine("    call _HeapAlloc@12")
    RtLine("    mov edi, eax")
    RtLine("    mov ebx, eax")
    RtLine("    add ebx, 11")
    RtLine("    mov eax, 0")
    RtLine("    mov " + Chr$(&H5B) + "ebx" + Chr$(&H5D) + ", al")
    RtLine("    sub ebx, 1")
    RtLine("    mov eax, esi")
    RtLine("rt_hex_dig:")
    RtLine("    mov edx, eax")
    RtLine("    and edx, 15")
    RtLine("    cmp edx, 10")
    RtLine("    jl rt_hex_dec")
    RtLine("    add edx, 55")
    RtLine("    jmp rt_hex_store")
    RtLine("rt_hex_dec:")
    RtLine("    add edx, 48")
    RtLine("rt_hex_store:")
    RtLine("    mov " + Chr$(&H5B) + "ebx" + Chr$(&H5D) + ", dl")
    RtLine("    sub ebx, 1")
    RtLine("    shr eax, 4")
    RtLine("    cmp eax, 0")
    RtLine("    jne rt_hex_dig")
    RtLine("    add ebx, 1")
    RtLine("    mov eax, ebx")
    RtLine("    pop edi")
    RtLine("    pop esi")
    RtLine("    pop ebx")
    RtLine("    mov esp, ebp")
    RtLine("    pop ebp")
    RtLine("    ret 4")

    ' Print s 窶・stdout + CRLF
    RtLine("_rt_Print:")
    RtLine("    push ebp")
    RtLine("    mov ebp, esp")
    RtLine("    sub esp, 8")
    RtLine("    push ebx")
    RtLine("    push esi")
    RtLine("    push -11")
    RtLine("    call _GetStdHandle@4")
    RtLine("    mov ebx, eax")
    RtLine("    mov esi, ebp")
    RtLine("    add esi, 8")
    RtLine("    mov eax, " + Chr$(&H5B) + "esi" + Chr$(&H5D))
    RtLine("    cmp eax, 0")
    RtLine("    je rt_print_nl")
    RtLine("    mov esi, eax")
    RtLine("    push esi")
    RtLine("    call _lstrlenA@4")
    RtLine("    mov edx, ebp")
    RtLine("    sub edx, 4")
    RtLine("    push 0")
    RtLine("    push edx")
    RtLine("    push eax")
    RtLine("    push esi")
    RtLine("    push ebx")
    RtLine("    call _WriteFile@20")
    RtLine("rt_print_nl:")
    RtLine("    mov edx, ebp")
    RtLine("    sub edx, 4")
    RtLine("    push 0")
    RtLine("    push edx")
    RtLine("    push 2")
    RtLine("    push rt_crlf")
    RtLine("    push ebx")
    RtLine("    call _WriteFile@20")
    RtLine("    pop esi")
    RtLine("    pop ebx")
    RtLine("    mov esp, ebp")
    RtLine("    pop ebp")
    RtLine("    ret 4")

    ' Val(s) 窶・蜈磯ｭ縺ｮ隨ｦ蜿ｷ莉倥″蜊・ｲ繧・Long 縺ｫ
    RtLine("_rt_Val:")
    RtLine("    push ebp")
    RtLine("    mov ebp, esp")
    RtLine("    push ebx")
    RtLine("    push esi")
    RtLine("    mov ebx, ebp")
    RtLine("    add ebx, 8")
    RtLine("    mov esi, " + Chr$(&H5B) + "ebx" + Chr$(&H5D))
    RtLine("    xor eax, eax")
    RtLine("    mov edx, 0")
    RtLine("    cmp esi, 0")
    RtLine("    je rt_val_done")
    RtLine("rt_val_sp:")
    RtLine("    movzx ecx, " + Chr$(&H5B) + "esi" + Chr$(&H5D))
    RtLine("    cmp ecx, 32")
    RtLine("    jne rt_val_sign")
    RtLine("    add esi, 1")
    RtLine("    jmp rt_val_sp")
    RtLine("rt_val_sign:")
    RtLine("    cmp ecx, 45")
    RtLine("    jne rt_val_plus")
    RtLine("    mov edx, 1")
    RtLine("    add esi, 1")
    RtLine("    jmp rt_val_dig")
    RtLine("rt_val_plus:")
    RtLine("    cmp ecx, 43")
    RtLine("    jne rt_val_dig")
    RtLine("    add esi, 1")
    RtLine("rt_val_dig:")
    RtLine("    movzx ecx, " + Chr$(&H5B) + "esi" + Chr$(&H5D))
    RtLine("    cmp ecx, 48")
    RtLine("    jl rt_val_end")
    RtLine("    cmp ecx, 57")
    RtLine("    jg rt_val_end")
    RtLine("    sub ecx, 48")
    RtLine("    mov ebx, 10")
    RtLine("    imul eax, ebx")
    RtLine("    add eax, ecx")
    RtLine("    add esi, 1")
    RtLine("    jmp rt_val_dig")
    RtLine("rt_val_end:")
    RtLine("    cmp edx, 0")
    RtLine("    je rt_val_done")
    RtLine("    neg eax")
    RtLine("rt_val_done:")
    RtLine("    pop esi")
    RtLine("    pop ebx")
    RtLine("    mov esp, ebp")
    RtLine("    pop ebp")
    RtLine("    ret 4")

    ' Input$ 窶・stdin 縺九ｉ1陦瑚ｪｭ縺ｿ縲√ヲ繝ｼ繝嶺ｸ翫・譁・ｭ怜・繧定ｿ斐☆・・R/LF 髯､蜴ｻ・・
    ' 繝代う繝励〒繧り､・焚陦後ｒ荳蠎ｦ縺ｫ鬟溘ｏ縺ｪ縺・ｈ縺・・繝舌う繝医★縺､隱ｭ繧
    RtLine("_rt_Input:")
    RtLine("    push ebp")
    RtLine("    mov ebp, esp")
    RtLine("    sub esp, 8")
    RtLine("    push ebx")
    RtLine("    push esi")
    RtLine("    push edi")
    RtLine("    call _GetProcessHeap@0")
    RtLine("    push 256")
    RtLine("    push 0")
    RtLine("    push eax")
    RtLine("    call _HeapAlloc@12")
    RtLine("    mov edi, eax")
    RtLine("    cmp eax, 0")
    RtLine("    je rt_input_fail")
    RtLine("    push -10")
    RtLine("    call _GetStdHandle@4")
    RtLine("    mov ebx, eax")
    RtLine("    mov esi, 0")
    RtLine("rt_input_loop:")
    RtLine("    cmp esi, 255")
    RtLine("    jge rt_input_done")
    RtLine("    mov edx, ebp")
    RtLine("    sub edx, 4")
    RtLine("    mov ecx, ebp")
    RtLine("    sub ecx, 8")
    RtLine("    push 0")
    RtLine("    push edx")
    RtLine("    push 1")
    RtLine("    push ecx")
    RtLine("    push ebx")
    RtLine("    call _ReadFile@20")
    RtLine("    cmp eax, 0")
    RtLine("    je rt_input_done")
    RtLine("    mov edx, ebp")
    RtLine("    sub edx, 4")
    RtLine("    mov eax, " + Chr$(&H5B) + "edx" + Chr$(&H5D))
    RtLine("    cmp eax, 0")
    RtLine("    je rt_input_done")
    RtLine("    mov edx, ebp")
    RtLine("    sub edx, 8")
    RtLine("    movzx eax, " + Chr$(&H5B) + "edx" + Chr$(&H5D))
    RtLine("    cmp eax, 13")
    RtLine("    je rt_input_loop")
    RtLine("    cmp eax, 10")
    RtLine("    je rt_input_done")
    RtLine("    mov ecx, edi")
    RtLine("    add ecx, esi")
    RtLine("    mov " + Chr$(&H5B) + "ecx" + Chr$(&H5D) + ", al")
    RtLine("    add esi, 1")
    RtLine("    jmp rt_input_loop")
    RtLine("rt_input_done:")
    RtLine("    mov ecx, edi")
    RtLine("    add ecx, esi")
    RtLine("    mov eax, 0")
    RtLine("    mov " + Chr$(&H5B) + "ecx" + Chr$(&H5D) + ", al")
    RtLine("    mov eax, edi")
    RtLine("    jmp rt_input_ret")
    RtLine("rt_input_fail:")
    RtLine("    mov eax, 0")
    RtLine("rt_input_ret:")
    RtLine("    pop edi")
    RtLine("    pop esi")
    RtLine("    pop ebx")
    RtLine("    mov esp, ebp")
    RtLine("    pop ebp")
    RtLine("    ret")
End Sub

' MakeStr / InStr / memcpy / malloc / free・医・繧ｹ繝育ｵ・∩霎ｼ縺ｿ莠呈鋤・・
Sub EnsureHostRt()
    If gUseHostRt <> 0 Then Exit Sub
    gUseHostRt = 1
    EnsureStringRt()
    If InStr(1, gApiExternLines, "extern _GetProcessHeap@0" + Chr$(13)) = 0 Then
        gApiExternLines = gApiExternLines + "extern _GetProcessHeap@0" + Chr$(13) + Chr$(10)
    End If
    If InStr(1, gApiExternLines, "extern _HeapAlloc@12" + Chr$(13)) = 0 Then
        gApiExternLines = gApiExternLines + "extern _HeapAlloc@12" + Chr$(13) + Chr$(10)
    End If
    If InStr(1, gApiExternLines, "extern _HeapFree@12" + Chr$(13)) = 0 Then
        gApiExternLines = gApiExternLines + "extern _HeapFree@12" + Chr$(13) + Chr$(10)
    End If
    If InStr(1, gApiExternLines, "extern _lstrlenA@4" + Chr$(13)) = 0 Then
        gApiExternLines = gApiExternLines + "extern _lstrlenA@4" + Chr$(13) + Chr$(10)
    End If
    If InStr(1, gApiExternLines, "extern _lstrcpyA@8" + Chr$(13)) = 0 Then
        gApiExternLines = gApiExternLines + "extern _lstrcpyA@8" + Chr$(13) + Chr$(10)
    End If

    ' malloc(n) -> eax
    RtLine("_rt_Malloc:")
    RtLine("    push ebp")
    RtLine("    mov ebp, esp")
    RtLine("    mov ebx, ebp")
    RtLine("    add ebx, 8")
    RtLine("    mov eax, " + Chr$(&H5B) + "ebx" + Chr$(&H5D))
    RtLine("    push eax")
    RtLine("    push 0")
    RtLine("    call _GetProcessHeap@0")
    RtLine("    push eax")
    RtLine("    call _HeapAlloc@12")
    RtLine("    mov esp, ebp")
    RtLine("    pop ebp")
    RtLine("    ret 4")

    ' free(p)
    RtLine("_rt_Free:")
    RtLine("    push ebp")
    RtLine("    mov ebp, esp")
    RtLine("    mov ebx, ebp")
    RtLine("    add ebx, 8")
    RtLine("    mov eax, " + Chr$(&H5B) + "ebx" + Chr$(&H5D))
    RtLine("    cmp eax, 0")
    RtLine("    je rt_free_done")
    RtLine("    push eax")
    RtLine("    push 0")
    RtLine("    call _GetProcessHeap@0")
    RtLine("    push eax")
    RtLine("    call _HeapFree@12")
    RtLine("rt_free_done:")
    RtLine("    mov esp, ebp")
    RtLine("    pop ebp")
    RtLine("    ret 4")

    ' memcpy(dst, src, n) 窶・stdcall 蜿ｳ縺九ｉ push 貂医∩
    RtLine("_rt_Memcpy:")
    RtLine("    push ebp")
    RtLine("    mov ebp, esp")
    RtLine("    push ebx")
    RtLine("    push esi")
    RtLine("    push edi")
    RtLine("    mov ebx, ebp")
    RtLine("    add ebx, 8")
    RtLine("    mov edi, " + Chr$(&H5B) + "ebx" + Chr$(&H5D))
    RtLine("    add ebx, 4")
    RtLine("    mov esi, " + Chr$(&H5B) + "ebx" + Chr$(&H5D))
    RtLine("    add ebx, 4")
    RtLine("    mov ecx, " + Chr$(&H5B) + "ebx" + Chr$(&H5D))
    RtLine("rt_memcpy_loop:")
    RtLine("    cmp ecx, 0")
    RtLine("    je rt_memcpy_done")
    RtLine("    movzx eax, " + Chr$(&H5B) + "esi" + Chr$(&H5D))
    RtLine("    mov " + Chr$(&H5B) + "edi" + Chr$(&H5D) + ", al")
    RtLine("    add esi, 1")
    RtLine("    add edi, 1")
    RtLine("    sub ecx, 1")
    RtLine("    jmp rt_memcpy_loop")
    RtLine("rt_memcpy_done:")
    RtLine("    mov ebx, ebp")
    RtLine("    add ebx, 8")
    RtLine("    mov eax, " + Chr$(&H5B) + "ebx" + Chr$(&H5D))
    RtLine("    pop edi")
    RtLine("    pop esi")
    RtLine("    pop ebx")
    RtLine("    mov esp, ebp")
    RtLine("    pop ebp")
    RtLine("    ret 12")

    ' FillMemory(dst, n, fill) 窶・stdcall
    RtLine("_rt_FillMemory:")
    RtLine("    push ebp")
    RtLine("    mov ebp, esp")
    RtLine("    push ebx")
    RtLine("    push edi")
    RtLine("    mov ebx, ebp")
    RtLine("    add ebx, 8")
    RtLine("    mov edi, " + Chr$(&H5B) + "ebx" + Chr$(&H5D))
    RtLine("    add ebx, 4")
    RtLine("    mov ecx, " + Chr$(&H5B) + "ebx" + Chr$(&H5D))
    RtLine("    add ebx, 4")
    RtLine("    movzx eax, " + Chr$(&H5B) + "ebx" + Chr$(&H5D))
    RtLine("rt_fill_loop:")
    RtLine("    cmp ecx, 0")
    RtLine("    je rt_fill_done")
    RtLine("    mov " + Chr$(&H5B) + "edi" + Chr$(&H5D) + ", al")
    RtLine("    add edi, 1")
    RtLine("    sub ecx, 1")
    RtLine("    jmp rt_fill_loop")
    RtLine("rt_fill_done:")
    RtLine("    pop edi")
    RtLine("    pop ebx")
    RtLine("    mov esp, ebp")
    RtLine("    pop ebp")
    RtLine("    ret 12")

    ' MakeStr(p) 窶・C 譁・ｭ怜・繧偵ヲ繝ｼ繝励∈隍・｣ｽ縺励※霑斐☆
    RtLine("_rt_MakeStr:")
    RtLine("    push ebp")
    RtLine("    mov ebp, esp")
    RtLine("    push ebx")
    RtLine("    push esi")
    RtLine("    push edi")
    RtLine("    mov ebx, ebp")
    RtLine("    add ebx, 8")
    RtLine("    mov esi, " + Chr$(&H5B) + "ebx" + Chr$(&H5D))
    RtLine("    cmp esi, 0")
    RtLine("    jne rt_makestr_ok")
    RtLine("    push str_empty")
    RtLine("    pop eax")
    RtLine("    jmp rt_makestr_done")
    RtLine("rt_makestr_ok:")
    RtLine("    push esi")
    RtLine("    call _lstrlenA@4")
    RtLine("    add eax, 1")
    RtLine("    mov ebx, eax")
    RtLine("    push eax")
    RtLine("    push 0")
    RtLine("    call _GetProcessHeap@0")
    RtLine("    push eax")
    RtLine("    call _HeapAlloc@12")
    RtLine("    mov edi, eax")
    RtLine("    push esi")
    RtLine("    push edi")
    RtLine("    call _lstrcpyA@8")
    RtLine("    mov eax, edi")
    RtLine("rt_makestr_done:")
    RtLine("    pop edi")
    RtLine("    pop esi")
    RtLine("    pop ebx")
    RtLine("    mov esp, ebp")
    RtLine("    pop ebp")
    RtLine("    ret 4")

    ' InStr(start, hay, needle) 窶・1-based縲∫┌縺代ｌ縺ｰ 0
    RtLine("_rt_InStr:")
    RtLine("    push ebp")
    RtLine("    mov ebp, esp")
    RtLine("    push ebx")
    RtLine("    push esi")
    RtLine("    push edi")
    RtLine("    mov ebx, ebp")
    RtLine("    add ebx, 8")
    RtLine("    mov eax, " + Chr$(&H5B) + "ebx" + Chr$(&H5D))
    RtLine("    add ebx, 4")
    RtLine("    mov esi, " + Chr$(&H5B) + "ebx" + Chr$(&H5D))
    RtLine("    add ebx, 4")
    RtLine("    mov edi, " + Chr$(&H5B) + "ebx" + Chr$(&H5D))
    RtLine("    cmp esi, 0")
    RtLine("    je rt_instr_zero")
    RtLine("    cmp edi, 0")
    RtLine("    je rt_instr_zero")
    RtLine("    cmp eax, 1")
    RtLine("    jge rt_instr_start_ok")
    RtLine("    mov eax, 1")
    RtLine("rt_instr_start_ok:")
    RtLine("    sub eax, 1")
    RtLine("    add esi, eax")
    RtLine("    mov ebx, eax")
    RtLine("rt_instr_outer:")
    RtLine("    movzx eax, " + Chr$(&H5B) + "esi" + Chr$(&H5D))
    RtLine("    cmp eax, 0")
    RtLine("    je rt_instr_zero")
    RtLine("    push esi")
    RtLine("    push edi")
    RtLine("    mov edx, edi")
    RtLine("rt_instr_inner:")
    RtLine("    movzx eax, " + Chr$(&H5B) + "edx" + Chr$(&H5D))
    RtLine("    cmp eax, 0")
    RtLine("    je rt_instr_found")
    RtLine("    movzx ecx, " + Chr$(&H5B) + "esi" + Chr$(&H5D))
    RtLine("    cmp ecx, 0")
    RtLine("    je rt_instr_next")
    RtLine("    cmp eax, ecx")
    RtLine("    jne rt_instr_next")
    RtLine("    add esi, 1")
    RtLine("    add edx, 1")
    RtLine("    jmp rt_instr_inner")
    RtLine("rt_instr_next:")
    RtLine("    pop edi")
    RtLine("    pop esi")
    RtLine("    add esi, 1")
    RtLine("    add ebx, 1")
    RtLine("    jmp rt_instr_outer")
    RtLine("rt_instr_found:")
    RtLine("    pop edi")
    RtLine("    pop esi")
    RtLine("    mov eax, ebx")
    RtLine("    add eax, 1")
    RtLine("    jmp rt_instr_done")
    RtLine("rt_instr_zero:")
    RtLine("    mov eax, 0")
    RtLine("rt_instr_done:")
    RtLine("    pop edi")
    RtLine("    pop esi")
    RtLine("    pop ebx")
    RtLine("    mov esp, ebp")
    RtLine("    pop ebp")
    RtLine("    ret 12")
End Sub

' --- 蟄怜唱繝ｻ讒区枚繝ｻEmit・・mitAsm 遲峨・蠕後↓蜿悶ｊ霎ｼ繧・・--
#include "abcLexer.abp"
#include "abcParser.abp"
#include "abcEmit.abp"

' 譛ｫ蟆ｾ縺ｮ " As Type" / " As *Type" 繧帝勁蜴ｻ・亥､縺ｯ螟峨ｏ繧峨↑縺・く繝｣繧ｹ繝茨ｼ・
Function StripTypeCast$(expr As String) As String
    Dim t As String
    Dim low As String
    Dim n As Long
    Dim i As Long
    Dim depth As Long
    Dim inQ As Long
    Dim c As Long
    Dim p As *Byte
    Dim pos As Long
    Dim rest As String
    Dim r As String
    t = Trim$(expr)
    n = Len(t)
    StripTypeCast$ = t
    If n < 4 Then Exit Function
    low = Lower$(t)
    p = StrPtr(t)
    depth = 0
    inQ = 0
    pos = 0
    i = 0
    While i < n
        c = p[i]
        If inQ <> 0 Then
            If c = 34 Then inQ = 0
        ElseIf c = 34 Then
            inQ = 1
        ElseIf c = 40 Or c = &H5B Then
            depth = depth + 1
        ElseIf c = 41 Or c = &H5D Then
            depth = depth - 1
        ElseIf depth = 0 Then
            If i + 3 < n Then
                If Mid$(low, i + 1, 4) = " as " Then
                    rest = Trim$(Mid$(t, i + 5, n - i - 4))
                    r = rest
                    If Left$(r, 1) = "*" Then
                        r = Trim$(Mid$(r, 2, Len(r) - 1))
                    End If
                    If IsIdentName(r) <> 0 Then
                        pos = i + 1
                    End If
                End If
            End If
        End If
        i = i + 1
    Wend
    If pos > 0 Then
        StripTypeCast$ = Trim$(Left$(t, pos - 1))
    End If
End Function

' 邂苓｡灘ｼ・竊・eax
Function GenArith(expr As String) As Long
    Dim ni As Long
    Dim e As String
    GenArith = 0
    gParseCondMode = 0
    e = StripTypeCast$(expr)
    If LexExpr(e) = 0 Then Exit Function
    ni = ParseExpr()
    If ni < 0 Then Exit Function
    If TokPeek() <> TK_EOF Then
        Print "junk after expression: " + expr
        Exit Function
    End If
    GenArith = EmitExpr(ni)
End Function

' 蟾ｦ霎ｺ蛟､縺ｮ繧｢繝峨Ξ繧ｹ 竊・eax・・yRef 螳溷ｼ墓焚逕ｨ・・
Function GenArithAddr(expr As String) As Long
    Dim ni As Long
    Dim e As String
    GenArithAddr = 0
    gParseCondMode = 0
    e = StripTypeCast$(expr)
    If LexExpr(e) = 0 Then Exit Function
    ni = ParseExpr()
    If ni < 0 Then Exit Function
    If TokPeek() <> TK_EOF Then
        Print "junk after expression: " + expr
        Exit Function
    End If
    GenArithAddr = EmitLValueAddr(ni)
End Function

Function GenCond(expr As String, falseLab As String) As Long
    Dim e As String
    Dim n As Long
    Dim p As *Byte
    Dim closePos As Long
    Dim ni As Long

    GenCond = 0
    e = Trim$(expr)

    ' 螟門・縺ｮ (...) 繧貞翁縺後☆・・nd/Or 縺梧峡蠑ｧ蜀・□縺ｨ隕矩・☆縺溘ａ・・
    n = Len(e)
    While n >= 2
        p = StrPtr(e)
        If p[0] <> 40 Then Exit While
        closePos = MatchClose(p, n, 0)
        If closePos <> n - 1 Then Exit While
        e = Trim$(Mid$(e, 2, n - 2))
        n = Len(e)
    Wend

    gParseCondMode = 1
    If LexExpr(e) = 0 Then Exit Function
    ni = ParseCondExpr()
    If ni < 0 Then Exit Function
    If TokPeek() <> TK_EOF Then
        Print "junk after condition: " + e
        Exit Function
    End If
    GenCond = EmitCond(ni, falseLab)
End Function


Function StripComment$(s As String) As String
    Dim p As *Byte
    Dim i As Long
    Dim n As Long
    Dim inQ As Long
    Dim c As Long

    n = Len(s)
    If n = 0 Then
        StripComment$ = ""
        Exit Function
    End If
    p = StrPtr(s)
    i = 0
    inQ = 0
    While i < n
        c = p[i]
        If inQ <> 0 Then
            If c = 34 Then
                inQ = 0
            End If
        Else
            If c = 34 Then
                inQ = 1
            ElseIf c = Asc("'") Then
                StripComment$ = Left$(s, i)
                Exit Function
            End If
        End If
        i = i + 1
    Wend
    StripComment$ = s
End Function

' 繧ｫ繝ｳ繝槫玄蛻・ｊ蠑墓焚繧貞・蜑ｲ・域枚蟄怜・繝ｻ諡ｬ蠑ｧ繝阪せ繝亥・縺ｮ繧ｫ繝ｳ繝槭・辟｡隕厄ｼ・
Function SplitArgs(argsText As String) As Long
    Dim p As *Byte
    Dim n As Long
    Dim i As Long
    Dim start As Long
    Dim inQ As Long
    Dim quote As Long
    Dim depth As Long
    Dim c As Long

    SplitArgs = 0
    gNArgs = 0
    n = Len(argsText)
    If n = 0 Then
        SplitArgs = 1
        Exit Function
    End If

    p = StrPtr(argsText)
    i = 0
    start = 0
    inQ = 0
    quote = 0
    depth = 0

    While i < n
        c = p[i]
        If inQ <> 0 Then
            If c = quote Then
                inQ = 0
            End If
        Else
            If c = 34 Or c = Asc("'") Then
                inQ = 1
                quote = c
            ElseIf c = 40 Or c = &H5B Then
                depth = depth + 1
            ElseIf c = 41 Or c = &H5D Then
                depth = depth - 1
            ElseIf c = Asc(",") And depth = 0 Then
                If gNArgs >= MAX_ARGS Then
                    Print "error: too many arguments (max " + Trim$(Str$(MAX_ARGS)) + ")"
                    Exit Function
                End If
                gArgs(gNArgs) = Trim$(Mid$(argsText, start + 1, i - start))
                gNArgs = gNArgs + 1
                start = i + 1
            End If
        End If
        i = i + 1
    Wend

    If inQ <> 0 Then
        Print "error: unterminated string in arguments"
        Exit Function
    End If

    If gNArgs >= MAX_ARGS Then
        Print "error: too many arguments (max " + Trim$(Str$(MAX_ARGS)) + ")"
        Exit Function
    End If
    gArgs(gNArgs) = Trim$(Mid$(argsText, start + 1, n - start))
    gNArgs = gNArgs + 1
    SplitArgs = 1
End Function

' NULL / MB_OK -> 0縲∵枚蟄怜・ -> str_N縲√◎繧御ｻ･螟悶・縺昴・縺ｾ縺ｾ
Function ArgToAsm$(arg As String) As String
    Dim t As String
    Dim label As String
    Dim lit As String
    Dim dq As String

    t = Trim$(arg)
    If IsStringLit(t) <> 0 Then
        label = AddStringLit$(t)
        ArgToAsm$ = label
    ElseIf t = "NULL" Or t = "MB_OK" Then
        ArgToAsm$ = "0"
    Else
        ArgToAsm$ = t
    End If
End Function

Function CompileMessageBox(lineStr As String) As Long
    Dim argsText As String
    Dim a As Long
    Dim lp As Long
    Dim rp As Long

    CompileMessageBox = 0
    lp = InStr(1, lineStr, "(")
    rp = 0
    a = Len(lineStr)
    While a >= 1
        If Mid$(lineStr, a, 1) = ")" Then
            rp = a
            Exit While
        End If
        a = a - 1
    Wend
    If lp = 0 Or rp = 0 Or rp <= lp Then
        Print "bad MessageBox syntax: " + lineStr
        Exit Function
    End If

    argsText = ArgsBetween$(lineStr, lp, rp)
    If SplitArgs(argsText) = 0 Then Exit Function
    If gNArgs <> 4 Then
        Print "MessageBox needs 4 arguments, got " + Str$(gNArgs)
        Exit Function
    End If

    For a = 0 To gNArgs - 1
        gAsmArgs(a) = ArgToAsm$(gArgs(a))
    Next

    ' stdcall: 蜿ｳ縺九ｉ蟾ｦ縺ｸ push
    a = gNArgs - 1
    While a >= 0
        EmitAsm("push    " + gAsmArgs(a))
        a = a - 1
    Wend
    EmitAsm("call    _MessageBoxA@16")
    SbAppendCRLF(VarPtr(gSbText))
    gUseMsgBox = 1
    CompileMessageBox = 1
End Function

Function CompilePrint(lineStr As String) As Long
    Dim e As String
    CompilePrint = 0
    e = Trim$(Mid$(lineStr, 6, Len(lineStr) - 5))
    If e = "" Then
        Print "Print needs expression"
        Exit Function
    End If
    EnsureStringRt()
    If IsStringExpr(e) <> 0 Then
        If GenArith(e) = 0 Then Exit Function
    Else
        If GenArith(e) = 0 Then Exit Function
        EmitAsm("push eax")
        EmitAsm("call _rt_Str")
    End If
    EmitAsm("push eax")
    EmitAsm("call _rt_Print")
    CompilePrint = 1
End Function

' Input var 窶・1陦瑚ｪｭ縺ｿ蜿悶ｊ縲４tring 縺ｪ繧峨◎縺ｮ縺ｾ縺ｾ縲√◎繧御ｻ･螟悶・ Val 縺励※莉｣蜈･
Function CompileInput(lineStr As String) As Long
    Dim name As String
    Dim idx As Long
    CompileInput = 0
    name = Trim$(Mid$(lineStr, 6, Len(lineStr) - 5))
    If name = "" Then
        Print "Input needs variable"
        Exit Function
    End If
    idx = FindVar(name)
    If idx < 0 Then
        Print "undeclared variable: " + name
        Exit Function
    End If
    EnsureStringRt()
    gUseInput = 1
    EmitAsm("call _rt_Input")
    If gVarIsStr(idx) <> 0 Then
        EmitStoreVar(idx)
    Else
        EmitAsm("push eax")
        EmitAsm("call _rt_Val")
        EmitStoreVar(idx)
    End If
    CompileInput = 1
End Function

Function CompileExitProcess(lineStr As String) As Long
    Dim argsText As String
    Dim lp As Long
    Dim rp As Long
    Dim a As Long

    CompileExitProcess = 0
    lp = InStr(1, lineStr, "(")
    rp = 0
    a = Len(lineStr)
    While a >= 1
        If Mid$(lineStr, a, 1) = ")" Then
            rp = a
            Exit While
        End If
        a = a - 1
    Wend
    If lp = 0 Or rp = 0 Or rp <= lp Then
        Print "bad ExitProcess syntax: " + lineStr
        Exit Function
    End If

    argsText = ArgsBetween$(lineStr, lp, rp)
    If argsText = "" Then
        Print "ExitProcess needs 1 argument"
        Exit Function
    End If
    If GenArith(argsText) = 0 Then Exit Function
    EmitAsm("push eax")
    EmitCallName("ExitProcess")
    gEmittedExit = 1
    CompileExitProcess = 1
End Function

Function CompileConst(lineStr As String) As Long
    Dim rest As String
    Dim name As String
    Dim expr As String
    Dim pos As Long
    Dim ci As Long
    Dim v As Long
    CompileConst = 0
    rest = Trim$(Mid$(lineStr, 6, Len(lineStr) - 5))
    pos = FindOp1(rest, "=")
    If pos = 0 Then
        Print "Const needs =: " + lineStr
        Exit Function
    End If
    name = Trim$(Left$(rest, pos - 1))
    expr = Trim$(Mid$(rest, pos + 1, Len(rest) - pos))
    If IsNumStr(expr) <> 0 Then
        v = ParseNum(expr)
    ElseIf FindConst(expr) >= 0 Then
        v = gConstVal(FindConst(expr))
    ElseIf InStr(1, expr, "+") > 0 Or InStr(1, expr, "-") > 1 Or InStr(1, expr, "*") > 0 Or InStr(1, expr, "(") > 0 Then
        ' Const 蠑擾ｼ・AX - 1 繧・(A+B)・峨ょ・鬆ｭ縺ｮ荳蜈・'-' 縺ｯ IsNumStr 蛛ｴ
        v = ParseCountExpr(expr)
    Else
        Print "Const needs number or Const: " + lineStr
        Exit Function
    End If
    ci = FindConst(name)
    If ci >= 0 Then
        If gConstVal(ci) = v Then
            CompileConst = 1
            Exit Function
        End If
        Print "error: duplicate Const: " + name
        Print "  hint: already defined (often from Include/default); remove the duplicate"
        Exit Function
    End If
    If gNConsts >= MAX_CONSTS Then
        Print "error: too many Const (max " + Trim$(Str$(MAX_CONSTS)) + ")"
        Exit Function
    End If
    ci = gNConsts
    gConstName(ci) = Lower$(name)
    gConstVal(ci) = v
    gNConsts = gNConsts + 1
    CompileConst = 1
End Function

' 驟榊・豺ｻ蟄励・螳壽焚蠑・ 謨ｰ蛟､ / Const / + - * 縺ｨ諡ｬ蠑ｧ
Function ParseCountAtom(s As String) As Long
    Dim t As String
    Dim ci As Long
    Dim n As Long
    Dim inner As String
    t = Trim$(s)
    n = Len(t)
    ParseCountAtom = 0
    If n = 0 Then
        Print "bad array size: (empty)"
        Exit Function
    End If
    ' (expr)
    If Left$(t, 1) = "(" And Right$(t, 1) = ")" Then
        If MatchClose(StrPtr(t), n, 0) = n - 1 Then
            inner = Mid$(t, 2, n - 2)
            ParseCountAtom = ParseCountExpr(inner)
            Exit Function
        End If
    End If
    If IsNumStr(t) <> 0 Then
        ParseCountAtom = ParseNum(t)
        Exit Function
    End If
    ci = FindConst(t)
    If ci >= 0 Then
        ParseCountAtom = gConstVal(ci)
        Exit Function
    End If
    Print "bad array size: " + s
    ParseCountAtom = 0
End Function

Function ParseCountExpr(s As String) As Long
    Dim t As String
    Dim n As Long
    Dim i As Long
    Dim depth As Long
    Dim c As Long
    Dim p As *Byte
    Dim opPos As Long
    Dim op As String
    Dim leftV As Long
    Dim rightV As Long
    t = Trim$(s)
    n = Len(t)
    ParseCountExpr = 0
    If n = 0 Then
        Print "bad array size: (empty)"
        Exit Function
    End If

    ' 螟門・縺ｮ (...) 繧貞翁縺後☆
    While n >= 2
        p = StrPtr(t)
        If p[0] <> 40 Then Exit While
        If MatchClose(p, n, 0) <> n - 1 Then Exit While
        t = Trim$(Mid$(t, 2, n - 2))
        n = Len(t)
    Wend

    ' 豺ｱ縺・縺ｮ + / -・亥承遶ｯ蜆ｪ蜈医ょ・鬆ｭ縺ｮ隨ｦ蜿ｷ縺ｯ辟｡隕厄ｼ・
    opPos = 0
    op = ""
    depth = 0
    p = StrPtr(t)
    i = n - 1
    While i >= 1
        c = p[i]
        If c = 41 Then
            depth = depth + 1
        ElseIf c = 40 Then
            depth = depth - 1
        ElseIf depth = 0 Then
            If c = Asc("+") Or c = Asc("-") Then
                opPos = i + 1
                op = Mid$(t, i + 1, 1)
                Exit While
            End If
        End If
        i = i - 1
    Wend
    If opPos > 0 Then
        leftV = ParseCountExpr(Left$(t, opPos - 1))
        rightV = ParseCountExpr(Mid$(t, opPos + 1, n - opPos))
        If op = "+" Then
            ParseCountExpr = leftV + rightV
        Else
            ParseCountExpr = leftV - rightV
        End If
        Exit Function
    End If

    ' 豺ｱ縺・縺ｮ *
    opPos = 0
    depth = 0
    i = n - 1
    While i >= 1
        c = p[i]
        If c = 41 Then
            depth = depth + 1
        ElseIf c = 40 Then
            depth = depth - 1
        ElseIf depth = 0 Then
            If c = Asc("*") Then
                opPos = i + 1
                Exit While
            End If
        End If
        i = i - 1
    Wend
    If opPos > 0 Then
        leftV = ParseCountExpr(Left$(t, opPos - 1))
        rightV = ParseCountExpr(Mid$(t, opPos + 1, n - opPos))
        ParseCountExpr = leftV * rightV
        Exit Function
    End If

    ParseCountExpr = ParseCountAtom(t)
End Function

' 繝帙せ繝・WinAPI 繝倥ャ繝逶ｸ蠖難ｼ郁・蟾ｱ繝帙せ繝域凾・峨ゅた繝ｼ繧ｹ蛛ｴ縺ｧ縺ｯ螳夂ｾｩ縺励↑縺・
' 蜷榊燕縺ｯ蟆乗枚蟄励〒菫晄戟・・indConst 縺・Lower$ 荳蝗槭□縺題｡後≧縺溘ａ・・
Sub InitBuiltinConsts()
    Dim ci As Long
    gNConsts = 0
    ci = 0
    gConstName(ci) = "max_path"
    gConstVal(ci) = 260
    ci = ci + 1
    gConstName(ci) = "null"
    gConstVal(ci) = 0
    ci = ci + 1
    gConstName(ci) = "invalid_handle_value"
    gConstVal(ci) = -1
    ci = ci + 1
    gConstName(ci) = "generic_read"
    gConstVal(ci) = &H80000000
    ci = ci + 1
    gConstName(ci) = "generic_write"
    gConstVal(ci) = &H40000000
    ci = ci + 1
    gConstName(ci) = "file_share_read"
    gConstVal(ci) = 1
    ci = ci + 1
    gConstName(ci) = "open_existing"
    gConstVal(ci) = 3
    ci = ci + 1
    gConstName(ci) = "create_always"
    gConstVal(ci) = 2
    ci = ci + 1
    gConstName(ci) = "file_attribute_normal"
    gConstVal(ci) = 128
    ci = ci + 1
    gConstName(ci) = "infinite"
    gConstVal(ci) = -1
    ci = ci + 1
    gConstName(ci) = "mb_ok"
    gConstVal(ci) = 0
    ci = ci + 1
    gNConsts = ci
End Sub

Function CompileTypeStart(lineStr As String) As Long
    Dim name As String
    CompileTypeStart = 0
    name = Trim$(Mid$(lineStr, 6, Len(lineStr) - 5))
    If IsIdentName(name) = 0 Then
        Print "bad Type: " + lineStr
        Exit Function
    End If
    ' Include/default 縺ｨ譏守､ｺ螳夂ｾｩ縺ｮ莠碁㍾繧定ｨｱ螳ｹ・・蝗樒岼縺ｯ繧ｹ繧ｭ繝・・・・
    If FindType(name) >= 0 Then
        gCurType = -2
        gInType = 1
        CompileTypeStart = 1
        Exit Function
    End If
    If gNTypes >= MAX_TYPES Then
        Print "too many Type: " + lineStr
        Exit Function
    End If
    gCurType = gNTypes
    gTypeName(gCurType) = Lower$(name)
    gTypeSize(gCurType) = 0
    gTypeFirstField(gCurType) = -1
    gTypeLastField(gCurType) = -1
    gNTypes = gNTypes + 1
    gInType = 1
    CompileTypeStart = 1
End Function

Function CompileTypeField(lineStr As String) As Long
    Dim pos As Long
    Dim namePart As String
    Dim typeName As String
    Dim name As String
    Dim count As Long
    Dim n As Long
    Dim p As *Byte
    Dim lb As Long
    Dim i As Long
    Dim sz As Long
    Dim off As Long
    Dim align As Long
    Dim fi As Long
    Dim isPtr As Long
    CompileTypeField = 0
    If gCurType = -2 Then
        CompileTypeField = 1
        Exit Function
    End If
    pos = InStr(1, Lower$(lineStr), " as ")
    If pos = 0 Then
        Print "Type field needs As: " + lineStr
        Exit Function
    End If
    namePart = Trim$(Left$(lineStr, pos - 1))
    typeName = Trim$(Mid$(lineStr, pos + 4, Len(lineStr) - pos - 3))
    count = 1
    name = namePart
    n = Len(namePart)
    p = StrPtr(namePart)
    lb = 0
    For i = 0 To n - 1
        If p[i] = 40 Or p[i] = &H5B Then
            lb = i + 1
            Exit For
        End If
    Next
    If lb > 1 Then
        If (p[lb - 1] = 40 And p[n - 1] <> 41) Or (p[lb - 1] = &H5B And p[n - 1] <> &H5D) Then
            Print "bad Type field array: " + lineStr
            Exit Function
        End If
        name = Trim$(Left$(namePart, lb - 1))
        count = ParseCountExpr(Mid$(namePart, lb + 1, n - lb - 1)) + 1
    End If
    isPtr = 0
    ExpandTypeName(typeName, isPtr)
    sz = TypeSizeOf(typeName)
    If isPtr <> 0 Then sz = 4
    If sz = 0 Or count <= 0 Or gNFields >= MAX_FIELDS Then
        Print "bad Type field: " + lineStr
        Exit Function
    End If
    align = sz
    If align > 4 Then align = 4
    off = gTypeSize(gCurType)
    While (off Mod align) <> 0
        off = off + 1
    Wend
    fi = gNFields
    gFieldName(fi) = Lower$(name)
    gFieldType(fi) = FindType(typeName)
    gFieldOff(fi) = off
    gFieldSize(fi) = sz
    gFieldCount(fi) = count
    gFieldNext(fi) = -1
    If gTypeFirstField(gCurType) < 0 Then
        gTypeFirstField(gCurType) = fi
    Else
        gFieldNext(gTypeLastField(gCurType)) = fi
    End If
    gTypeLastField(gCurType) = fi
    gNFields = gNFields + 1
    gTypeSize(gCurType) = off + sz * count
    CompileTypeField = 1
End Function

Function CompileTypeEnd() As Long
    CompileTypeEnd = 0
    If gInType = 0 Then
        Print "End Type without Type"
        Exit Function
    End If
    gInType = 0
    gCurType = -1
    CompileTypeEnd = 1
End Function

' 蜈磯ｭ縺ｮ繝医ャ繝励Ξ繝吶Ν繧ｫ繝ｳ繝樔ｽ咲ｽｮ・・蟋九∪繧奇ｼ峨よ峡蠑ｧ繝ｻ蠑慕畑隨ｦ蜀・・辟｡隕・
Function FindCommaTop(expr As String) As Long
    Dim n As Long
    Dim i As Long
    Dim depth As Long
    Dim inQ As Long
    Dim c As Long
    Dim p As *Byte
    n = Len(expr)
    p = StrPtr(expr)
    depth = 0
    inQ = 0
    FindCommaTop = 0
    For i = 0 To n - 1
        c = p[i]
        If inQ <> 0 Then
            If c = 34 Then inQ = 0
        ElseIf c = 34 Then
            inQ = 1
        ElseIf c = Asc("(") Or c = &H5B Then
            depth = depth + 1
        ElseIf c = Asc(")") Or c = &H5D Then
            depth = depth - 1
        ElseIf depth = 0 And c = Asc(",") Then
            FindCommaTop = i + 1
            Exit Function
        End If
    Next
End Function

' 1 螟画焚蛻・ "name As T" / "name=expr As T" / "name As T = expr"
Function CompileOneDim(decl As String) As Long
    Dim name As String
    Dim typeName As String
    Dim pos As Long
    Dim i As Long
    Dim count As Long
    Dim elemSize As Long
    Dim isPtr As Long
    Dim isStr As Long
    Dim namePart As String
    Dim idxPart As String
    Dim p As *Byte
    Dim n As Long
    Dim lb As Long
    Dim typeIdx As Long
    Dim varIdx As Long
    Dim lab As String
    Dim lab2 As String
    Dim initExpr As String
    Dim eqPos As Long

    CompileOneDim = 0
    pos = InStr(1, Lower$(decl), " as ")
    If pos = 0 Then
        Print "Dim needs As: " + decl
        Exit Function
    End If
    namePart = Trim$(Left$(decl, pos - 1))
    typeName = Trim$(Mid$(decl, pos + 4, Len(decl) - pos - 3))
    initExpr = ""

    ' Dim name=expr As T  /  Dim name As T = expr
    eqPos = InStr(1, typeName, "=")
    If eqPos > 0 Then
        initExpr = Trim$(Mid$(typeName, eqPos + 1, Len(typeName) - eqPos))
        typeName = Trim$(Left$(typeName, eqPos - 1))
    Else
        eqPos = FindOp1(namePart, "=")
        If eqPos > 0 Then
            initExpr = Trim$(Mid$(namePart, eqPos + 1, Len(namePart) - eqPos))
            namePart = Trim$(Left$(namePart, eqPos - 1))
        End If
    End If

    isPtr = 0
    ExpandTypeName(typeName, isPtr)
    elemSize = TypeSizeOf(typeName)
    If elemSize = 0 Then
        Print "unknown type: " + typeName
        Exit Function
    End If

    count = 1
    name = namePart
    n = Len(namePart)
    p = StrPtr(namePart)
    lb = 0
    i = 0
    While i < n
        If p[i] = 40 Or p[i] = &H5B Then
            lb = i + 1
            Exit While
        End If
        i = i + 1
    Wend
    If lb > 1 Then
        If (p[lb - 1] = 40 And p[n - 1] = 41) Or (p[lb - 1] = &H5B And p[n - 1] = &H5D) Then
            name = Trim$(Left$(namePart, lb - 1))
            idxPart = Mid$(namePart, lb + 1, n - lb - 1)
            ' Dim a(N) 竊・豺ｻ蟄・0..N・郁ｦ∫ｴ謨ｰ N+1・峨７B/AB 莠呈鋤
            count = ParseCountExpr(idxPart) + 1
            If count <= 0 Then Exit Function
            If isPtr <> 0 Then
                Print "pointer array not supported: " + decl
                Exit Function
            End If
            If initExpr <> "" Then
                Print "array Dim cannot have initializer: " + decl
                Exit Function
            End If
        Else
            Print "bad Dim name: " + decl
            Exit Function
        End If
    End If

    If FindVar(name) >= 0 Then
        Print "duplicate Dim: " + name
        Exit Function
    End If
    isStr = 0
    If Lower$(typeName) = "string" Then
        isStr = 1
    End If
    typeIdx = FindType(typeName)
    varIdx = AddVarEx(name, elemSize, count, isPtr, isStr)
    If varIdx < 0 Then Exit Function
    gVarTypeIdx(varIdx) = typeIdx
    If initExpr <> "" Then
        If GenArith(initExpr) = 0 Then Exit Function
        EmitStoreVar(FindVar(name))
    ElseIf isStr <> 0 Then
        EnsureStringRt()
        If count = 1 Then
            EmitAsm("push str_empty")
            EmitAsm("pop eax")
            EmitStoreVar(FindVar(name))
        ElseIf gVarIsGlobal(varIdx) = 0 Then
            EmitAddrVar(FindVar(name))
            EmitAsm("mov ecx, " + Trim$(Str$(count * 4)))
            EmitAsm("xor eax, eax")
            lab = NewLabel$()
            lab2 = NewLabel$()
            EmitLabel(lab)
            EmitAsm("cmp ecx, 0")
            EmitAsm("je " + lab2)
            EmitAsm("mov " + Chr$(&H5B) + "ebx" + Chr$(&H5D) + ", eax")
            EmitAsm("add ebx, 4")
            EmitAsm("sub ecx, 4")
            EmitAsm("jmp " + lab)
            EmitLabel(lab2)
        End If
    End If
    CompileOneDim = 1
End Function

Function CompileDim(lineStr As String) As Long
    Dim rest As String
    Dim piece As String
    Dim comPos As Long

    CompileDim = 0
    rest = Trim$(Mid$(lineStr, 4, Len(lineStr) - 3))
    If rest = "" Then
        Print "Dim needs As: " + lineStr
        Exit Function
    End If
    ' Dim a As T, b As U  窶ｦ 隍・焚螳｣險
    While rest <> ""
        comPos = FindCommaTop(rest)
        If comPos = 0 Then
            piece = Trim$(rest)
            rest = ""
        Else
            piece = Trim$(Left$(rest, comPos - 1))
            rest = Trim$(Mid$(rest, comPos + 1, Len(rest) - comPos))
        End If
        If piece = "" Then
            Print "bad Dim: " + lineStr
            Exit Function
        End If
        If CompileOneDim(piece) = 0 Then Exit Function
    Wend
    CompileDim = 1
End Function

Function CompileAssign(lineStr As String) As Long
    Dim pos As Long
    Dim name As String
    Dim expr As String
    Dim idx As Long
    Dim lhs As String
    Dim idxExpr As String
    Dim i As Long
    Dim n As Long
    Dim lb As Long
    Dim p As *Byte
    Dim fieldSize As Long

    CompileAssign = 0
    pos = FindOp1(lineStr, "=")
    If pos = 0 Then
        Print "bad assignment: " + lineStr
        Exit Function
    End If
    lhs = Trim$(Left$(lineStr, pos - 1))
    expr = Trim$(Mid$(lineStr, pos + 1, Len(lineStr) - pos))

    ' Function 蜷阪∈縺ｮ莉｣蜈･ = 謌ｻ繧雁､
    ' Lower$(a)=Lower$(b) 縺ｯ String 謌ｻ繧翫ｒ隱､縺｣縺ｦ繝昴う繝ｳ繧ｿ豈碑ｼ・☆繧九％縺ｨ縺後≠繧九◆繧・StrEqCI 繧剃ｽｿ縺・
    If gInProc <> 0 And gProcIsFunc <> 0 Then
        If StrEqCI(lhs, gProcName) <> 0 Then
            If GenArith(expr) = 0 Then Exit Function
            EmitAsm("mov ebx, ebp")
            EmitAsm("add ebx, " + Trim$(Str$(gRetOff)))
            EmitAsm("mov " + Chr$(&H5B) + "ebx" + Chr$(&H5D) + ", eax")
            CompileAssign = 1
            Exit Function
        End If
    End If

    ' 讒矩菴薙Γ繝ｳ繝蝉ｻ｣蜈･
    If InStr(1, lhs, ".") > 0 Or InStr(1, lhs, "->") > 0 Then
        If GenArith(expr) = 0 Then Exit Function
        EmitAsm("push eax")
        If EmitMemberAddr(lhs, fieldSize) = 0 Then
            Print "error: cannot assign to member: " + lhs
            Print "  hint: base must be Dim'd As a Type; for pointers use p->field"
            Exit Function
        End If
        EmitAsm("pop eax")
        EmitStoreSized(fieldSize)
        CompileAssign = 1
        Exit Function
    End If

    ' 豺ｻ蟄嶺ｻ｣蜈･ a(i)= / a[i]= / p[i]=
    n = Len(lhs)
    p = StrPtr(lhs)
    lb = 0
    i = 0
    While i < n
        If p[i] = 40 Or p[i] = &H5B Then
            lb = i + 1
            Exit While
        End If
        i = i + 1
    Wend
    If lb > 1 Then
        i = MatchClose(p, n, lb - 1)
        If i = n - 1 Then
            name = Trim$(Left$(lhs, lb - 1))
            idxExpr = Mid$(lhs, lb + 1, i - lb)
            idx = FindVar(name)
            If idx < 0 Then
                Print "undeclared variable: " + name
                Exit Function
            End If
            If GenArith(expr) = 0 Then Exit Function
            EmitAsm("push eax")
            If GenArith(idxExpr) = 0 Then Exit Function
            EmitScaleAddBase(idx)
            EmitAsm("pop eax")
            If gVarSize(idx) = 1 Then
                EmitAsm("mov " + Chr$(&H5B) + "ebx" + Chr$(&H5D) + ", al")
            ElseIf gVarSize(idx) = 2 Then
                EmitAsm("mov " + Chr$(&H5B) + "ebx" + Chr$(&H5D) + ", ax")
            Else
                EmitAsm("mov " + Chr$(&H5B) + "ebx" + Chr$(&H5D) + ", eax")
            End If
            CompileAssign = 1
            Exit Function
        End If
    End If

    idx = FindVar(lhs)
    If idx < 0 Then
        Print "undeclared variable: " + lhs
        Exit Function
    End If
    If GenArith(expr) = 0 Then Exit Function
    EmitStoreVar(idx)
    CompileAssign = 1
End Function

Function CompileIfThen(lineStr As String) As Long
    Dim e As String
    Dim rest As String
    Dim labElse As String
    Dim labEnd As String
    Dim pos As Long
    Dim lowRest As String
    CompileIfThen = 0
    ' If <cond> Then [stmt]
    e = Trim$(Mid$(lineStr, 3, Len(lineStr) - 2))
    pos = InStr(1, Lower$(e), " then")
    If pos = 0 Then
        Print "If needs Then: " + lineStr
        Exit Function
    End If
    rest = Trim$(Mid$(e, pos + 5, Len(e) - pos - 4))
    e = Trim$(Left$(e, pos - 1))
    If gIfSp >= MAX_IF Then
        Print "If nesting too deep"
        Exit Function
    End If
    labElse = NewLabel$()
    labEnd = NewLabel$()
    gIfElse(gIfSp) = labElse
    gIfEnd(gIfSp) = labEnd
    gIfSp = gIfSp + 1
    If GenCond(e, labElse) = 0 Then Exit Function
    If rest <> "" Then
        lowRest = Lower$(rest)
        If lowRest = "exit function" Or lowRest = "exit sub" Then
            If CompileExitProc() = 0 Then Exit Function
        ElseIf lowRest = "exit while" Then
            If CompileExitWhile() = 0 Then Exit Function
        ElseIf lowRest = "exit do" Then
            If CompileExitDo() = 0 Then Exit Function
        ElseIf lowRest = "exit for" Then
            If CompileExitFor() = 0 Then Exit Function
        ElseIf StartsWith(rest, "ExitProcess(") <> 0 Then
            If CompileExitProcess(rest) = 0 Then Exit Function
        ElseIf StartsWith(rest, "MessageBox(") <> 0 Then
            If CompileMessageBox(rest) = 0 Then Exit Function
        ElseIf FindOp1(rest, "=") > 0 Then
            If CompileAssign(rest) = 0 Then Exit Function
        ElseIf InStr(1, rest, "(") > 1 Then
            If CompileCallStmt(rest) = 0 Then Exit Function
        Else
            Print "unsupported Then body: " + rest
            Exit Function
        End If
        If CompileEndIf() = 0 Then Exit Function
    End If
    CompileIfThen = 1
End Function

Function CompileElse() As Long
    Dim labElse As String
    Dim labEnd As String
    CompileElse = 0
    If gIfSp <= 0 Then
        Print "Else without If"
        Exit Function
    End If
    labElse = gIfElse(gIfSp - 1)
    labEnd = gIfEnd(gIfSp - 1)
    EmitAsm("jmp " + labEnd)
    EmitLabel(labElse)
    gIfElse(gIfSp - 1) = ""
    CompileElse = 1
End Function

Function CompileElseIfThen(lineStr As String) As Long
    Dim e As String
    Dim rest As String
    Dim labElse As String
    Dim labEnd As String
    Dim pos As Long
    Dim lowRest As String
    CompileElseIfThen = 0
    If gIfSp <= 0 Then
        Print "ElseIf without If"
        Exit Function
    End If
    ' ElseIf <cond> Then [stmt]
    e = Trim$(Mid$(lineStr, 7, Len(lineStr) - 6))
    pos = InStr(1, Lower$(e), " then")
    If pos = 0 Then
        Print "ElseIf needs Then: " + lineStr
        Exit Function
    End If
    rest = Trim$(Mid$(e, pos + 5, Len(e) - pos - 4))
    e = Trim$(Left$(e, pos - 1))
    labElse = gIfElse(gIfSp - 1)
    labEnd = gIfEnd(gIfSp - 1)
    EmitAsm("jmp " + labEnd)
    EmitLabel(labElse)
    labElse = NewLabel$()
    gIfElse(gIfSp - 1) = labElse
    If GenCond(e, labElse) = 0 Then Exit Function
    If rest <> "" Then
        lowRest = Lower$(rest)
        If lowRest = "exit function" Or lowRest = "exit sub" Then
            If CompileExitProc() = 0 Then Exit Function
        ElseIf lowRest = "exit while" Then
            If CompileExitWhile() = 0 Then Exit Function
        ElseIf lowRest = "exit do" Then
            If CompileExitDo() = 0 Then Exit Function
        ElseIf lowRest = "exit for" Then
            If CompileExitFor() = 0 Then Exit Function
        ElseIf StartsWith(rest, "ExitProcess(") <> 0 Then
            If CompileExitProcess(rest) = 0 Then Exit Function
        ElseIf FindOp1(rest, "=") > 0 Then
            If CompileAssign(rest) = 0 Then Exit Function
        ElseIf InStr(1, rest, "(") > 1 Then
            If CompileCallStmt(rest) = 0 Then Exit Function
        Else
            Print "unsupported ElseIf Then body: " + rest
            Exit Function
        End If
        If CompileEndIf() = 0 Then Exit Function
    End If
    CompileElseIfThen = 1
End Function

Function CompileEndIf() As Long
    Dim labElse As String
    Dim labEnd As String
    CompileEndIf = 0
    If gIfSp <= 0 Then
        Print "End If without If"
        Exit Function
    End If
    gIfSp = gIfSp - 1
    labElse = gIfElse(gIfSp)
    labEnd = gIfEnd(gIfSp)
    If labElse <> "" Then
        EmitLabel(labElse)
    End If
    EmitLabel(labEnd)
    CompileEndIf = 1
End Function

Sub EnsureSelectSlot(depth As Long)
    Dim lab As String
    If depth < 0 Or depth >= MAX_SELECT Then Exit Sub
    If gSelSlotReady(depth) <> 0 Then Exit Sub
    gSelSlotReady(depth) = 1
    lab = "v__sel" + Trim$(Str$(depth))
    SbAppendStr(VarPtr(gSbData), "    " + lab + ":")
    SbAppendCRLF(VarPtr(gSbData))
    SbAppendStr(VarPtr(gSbData), "    dd 0")
    SbAppendCRLF(VarPtr(gSbData))
End Sub

Function SelectSlotName$(depth As Long) As String
    SelectSlotName$ = "v__sel" + Trim$(Str$(depth))
End Function

Function CompileSelectCase(lineStr As String) As Long
    Dim e As String
    Dim labEnd As String
    Dim labNext As String
    Dim slot As String
    CompileSelectCase = 0
    e = Trim$(Mid$(lineStr, 12, Len(lineStr) - 11))
    If e = "" Then
        Print "Select Case needs expression"
        Exit Function
    End If
    If gSelSp >= MAX_SELECT Then
        Print "Select Case nesting too deep"
        Exit Function
    End If
    If GenArith(e) = 0 Then Exit Function
    EnsureSelectSlot(gSelSp)
    slot = SelectSlotName$(gSelSp)
    EmitAsm("mov ebx, " + slot)
    EmitAsm("mov " + Chr$(&H5B) + "ebx" + Chr$(&H5D) + ", eax")
    labEnd = NewLabel$()
    labNext = NewLabel$()
    gSelEnd(gSelSp) = labEnd
    gSelNext(gSelSp) = labNext
    gSelStarted(gSelSp) = 0
    gSelSp = gSelSp + 1
    EmitAsm("jmp " + labNext)
    CompileSelectCase = 1
End Function

Function CompileCase(lineStr As String) As Long
    Dim rest As String
    Dim lowRest As String
    Dim sp As Long
    Dim labNext As String
    Dim slot As String
    CompileCase = 0
    If gSelSp <= 0 Then
        Print "Case without Select Case"
        Exit Function
    End If
    sp = gSelSp - 1
    rest = Trim$(Mid$(lineStr, 5, Len(lineStr) - 4))
    lowRest = Lower$(rest)
    If gSelStarted(sp) <> 0 Then
        EmitAsm("jmp " + gSelEnd(sp))
    End If
    EmitLabel(gSelNext(sp))
    labNext = NewLabel$()
    gSelNext(sp) = labNext
    gSelStarted(sp) = 1
    If lowRest = "else" Then
        CompileCase = 1
        Exit Function
    End If
    If GenArith(rest) = 0 Then Exit Function
    EmitAsm("mov ecx, eax")
    slot = SelectSlotName$(sp)
    EmitAsm("mov ebx, " + slot)
    EmitAsm("mov eax, " + Chr$(&H5B) + "ebx" + Chr$(&H5D))
    EmitAsm("cmp eax, ecx")
    EmitAsm("jne " + labNext)
    CompileCase = 1
End Function

Function CompileEndSelect() As Long
    Dim sp As Long
    CompileEndSelect = 0
    If gSelSp <= 0 Then
        Print "End Select without Select Case"
        Exit Function
    End If
    sp = gSelSp - 1
    EmitAsm("jmp " + gSelEnd(sp))
    EmitLabel(gSelNext(sp))
    EmitLabel(gSelEnd(sp))
    gSelSp = sp
    CompileEndSelect = 1
End Function

Function CompileWhile(lineStr As String) As Long
    Dim e As String
    Dim labTop As String
    Dim labEnd As String
    CompileWhile = 0
    e = Trim$(Mid$(lineStr, 6, Len(lineStr) - 5))
    If e = "" Then
        Print "While needs condition"
        Exit Function
    End If
    If gLoopSp >= MAX_LOOP Then
        Print "loop nesting too deep"
        Exit Function
    End If
    labTop = NewLabel$()
    labEnd = NewLabel$()
    gLoopTop(gLoopSp) = labTop
    gLoopCont(gLoopSp) = labTop
    gLoopEnd(gLoopSp) = labEnd
    gLoopKind(gLoopSp) = 1
    gLoopSp = gLoopSp + 1
    EmitLabel(labTop)
    If GenCond(e, labEnd) = 0 Then Exit Function
    CompileWhile = 1
End Function

Function CompileWend() As Long
    CompileWend = 0
    If gLoopSp <= 0 Then
        Print "Wend without While"
        Exit Function
    End If
    If gLoopKind(gLoopSp - 1) <> 1 Then
        Print "Wend without While"
        Exit Function
    End If
    gLoopSp = gLoopSp - 1
    EmitAsm("jmp " + gLoopTop(gLoopSp))
    EmitLabel(gLoopEnd(gLoopSp))
    CompileWend = 1
End Function

Function CompileExitWhile() As Long
    CompileExitWhile = 0
    If gLoopSp <= 0 Then
        Print "Exit While without While"
        Exit Function
    End If
    If gLoopKind(gLoopSp - 1) <> 1 Then
        Print "Exit While without While"
        Exit Function
    End If
    EmitAsm("jmp " + gLoopEnd(gLoopSp - 1))
    CompileExitWhile = 1
End Function

' Do / Do While cond / Do Until cond
Function CompileDo(lineStr As String) As Long
    Dim rest As String
    Dim low As String
    Dim e As String
    Dim labTop As String
    Dim labBody As String
    Dim labEnd As String
    CompileDo = 0
    rest = Trim$(Mid$(lineStr, 3, Len(lineStr) - 2))
    low = Lower$(rest)
    If gLoopSp >= MAX_LOOP Then
        Print "loop nesting too deep"
        Exit Function
    End If
    labTop = NewLabel$()
    labEnd = NewLabel$()
    gLoopTop(gLoopSp) = labTop
    gLoopCont(gLoopSp) = labTop
    gLoopEnd(gLoopSp) = labEnd
    gLoopKind(gLoopSp) = 2
    gLoopSp = gLoopSp + 1
    EmitLabel(labTop)
    If rest = "" Then
        CompileDo = 1
        Exit Function
    End If
    If StartsWith(low, "while ") <> 0 Then
        e = Trim$(Mid$(rest, 7, Len(rest) - 6))
        If e = "" Then
            Print "Do While needs condition"
            Exit Function
        End If
        If GenCond(e, labEnd) = 0 Then Exit Function
        CompileDo = 1
        Exit Function
    End If
    If StartsWith(low, "until ") <> 0 Then
        e = Trim$(Mid$(rest, 7, Len(rest) - 6))
        If e = "" Then
            Print "Do Until needs condition"
            Exit Function
        End If
        ' 蛛ｽ縺ｪ繧画悽菴薙∫悄縺ｪ繧臥ｵゆｺ・
        labBody = NewLabel$()
        If GenCond(e, labBody) = 0 Then Exit Function
        EmitAsm("jmp " + labEnd)
        EmitLabel(labBody)
        CompileDo = 1
        Exit Function
    End If
    Print "bad Do: " + lineStr
End Function

Function CompileLoop(lineStr As String) As Long
    Dim rest As String
    Dim low As String
    Dim e As String
    Dim sp As Long
    Dim labTop As String
    Dim labEnd As String
    CompileLoop = 0
    If gLoopSp <= 0 Then
        Print "Loop without Do"
        Exit Function
    End If
    If gLoopKind(gLoopSp - 1) <> 2 Then
        Print "Loop without Do"
        Exit Function
    End If
    sp = gLoopSp - 1
    labTop = gLoopTop(sp)
    labEnd = gLoopEnd(sp)
    rest = Trim$(Mid$(lineStr, 5, Len(lineStr) - 4))
    low = Lower$(rest)
    If rest = "" Then
        EmitAsm("jmp " + labTop)
        EmitLabel(labEnd)
        gLoopSp = sp
        CompileLoop = 1
        Exit Function
    End If
    If StartsWith(low, "while ") <> 0 Then
        e = Trim$(Mid$(rest, 7, Len(rest) - 6))
        If e = "" Then
            Print "Loop While needs condition"
            Exit Function
        End If
        If GenCond(e, labEnd) = 0 Then Exit Function
        EmitAsm("jmp " + labTop)
        EmitLabel(labEnd)
        gLoopSp = sp
        CompileLoop = 1
        Exit Function
    End If
    If StartsWith(low, "until ") <> 0 Then
        e = Trim$(Mid$(rest, 7, Len(rest) - 6))
        If e = "" Then
            Print "Loop Until needs condition"
            Exit Function
        End If
        ' 逵溘↑繧臥ｵゆｺ・∝⊃縺ｪ繧牙・鬆ｭ縺ｸ
        If GenCond(e, labTop) = 0 Then Exit Function
        EmitLabel(labEnd)
        gLoopSp = sp
        CompileLoop = 1
        Exit Function
    End If
    Print "bad Loop: " + lineStr
End Function

Function CompileExitDo() As Long
    CompileExitDo = 0
    If gLoopSp <= 0 Then
        Print "Exit Do without Do"
        Exit Function
    End If
    If gLoopKind(gLoopSp - 1) <> 2 Then
        Print "Exit Do without Do"
        Exit Function
    End If
    EmitAsm("jmp " + gLoopEnd(gLoopSp - 1))
    CompileExitDo = 1
End Function

Function CompileFor(lineStr As String) As Long
    Dim rest As String
    Dim pos As Long
    Dim posTo As Long
    Dim posStep As Long
    Dim varName As String
    Dim exprFrom As String
    Dim exprTo As String
    Dim exprStep As String
    Dim idx As Long
    Dim labTop As String
    Dim labCont As String
    Dim labEnd As String

    CompileFor = 0
    rest = Trim$(Mid$(lineStr, 4, Len(lineStr) - 3))
    pos = FindOp1(rest, "=")
    If pos = 0 Then
        Print "For needs ="
        Exit Function
    End If
    varName = Trim$(Left$(rest, pos - 1))
    rest = Trim$(Mid$(rest, pos + 1, Len(rest) - pos))
    posTo = InStr(1, Lower$(rest), " to ")
    If posTo = 0 Then
        Print "For needs To"
        Exit Function
    End If
    exprFrom = Trim$(Left$(rest, posTo - 1))
    rest = Trim$(Mid$(rest, posTo + 4, Len(rest) - posTo - 3))
    posStep = InStr(1, Lower$(rest), " step ")
    If posStep > 0 Then
        exprTo = Trim$(Left$(rest, posStep - 1))
        exprStep = Trim$(Mid$(rest, posStep + 6, Len(rest) - posStep - 5))
    Else
        exprTo = rest
        exprStep = "1"
    End If

    idx = FindVar(varName)
    If idx < 0 Then
        Print "For variable undeclared: " + varName
        Exit Function
    End If
    If GenArith(exprFrom) = 0 Then Exit Function
    EmitStoreVar(idx)

    If gLoopSp >= MAX_LOOP Then
        Print "loop nesting too deep"
        Exit Function
    End If
    labTop = NewLabel$()
    labCont = NewLabel$()
    labEnd = NewLabel$()
    gLoopTop(gLoopSp) = labTop
    gLoopCont(gLoopSp) = labCont
    gLoopEnd(gLoopSp) = labEnd
    gLoopKind(gLoopSp) = 3
    gForVar(gLoopSp) = varName
    gForStep(gLoopSp) = exprStep
    gLoopSp = gLoopSp + 1

    EmitLabel(labTop)
    ' If var > to Then exit (Step>0 蜑肴署)
    EmitLoadVar(idx)
    EmitAsm("push eax")
    If GenArith(exprTo) = 0 Then Exit Function
    EmitAsm("pop ecx")
    EmitAsm("cmp ecx, eax")
    EmitAsm("jg " + labEnd)
    CompileFor = 1
End Function

Function CompileNext() As Long
    Dim sp As Long
    Dim idx As Long
    Dim varName As String
    Dim exprStep As String
    CompileNext = 0
    If gLoopSp <= 0 Then
        Print "Next without For"
        Exit Function
    End If
    If gLoopKind(gLoopSp - 1) <> 3 Then
        Print "Next without For"
        Exit Function
    End If
    sp = gLoopSp - 1
    varName = gForVar(sp)
    exprStep = gForStep(sp)
    idx = FindVar(varName)
    If idx < 0 Then
        Print "Next: bad variable"
        Exit Function
    End If
    EmitLabel(gLoopCont(sp))
    EmitLoadVar(idx)
    EmitAsm("push eax")
    If GenArith(exprStep) = 0 Then Exit Function
    EmitAsm("pop ecx")
    EmitAsm("add eax, ecx")
    EmitStoreVar(idx)
    EmitAsm("jmp " + gLoopTop(sp))
    EmitLabel(gLoopEnd(sp))
    gLoopSp = sp
    CompileNext = 1
End Function

Function CompileExitFor() As Long
    CompileExitFor = 0
    If gLoopSp <= 0 Then
        Print "Exit For without For"
        Exit Function
    End If
    If gLoopKind(gLoopSp - 1) <> 3 Then
        Print "Exit For without For"
        Exit Function
    End If
    EmitAsm("jmp " + gLoopEnd(gLoopSp - 1))
    CompileExitFor = 1
End Function

Sub SaveMainScope()
    Dim i As Long
    SbMove(VarPtr(gSbSaved), VarPtr(gSbText))
    gSavedNVars = gNVars
    gSavedFrame = gFrameSize
    If gNVars > 0 Then
        For i = 0 To gNVars - 1
            gSavedVarName(i) = gVarName(i)
            gSavedVarOff(i) = gVarOff(i)
            gSavedVarSize(i) = gVarSize(i)
            gSavedVarCount(i) = gVarCount(i)
            gSavedVarIsPtr(i) = gVarIsPtr(i)
            gSavedVarIsStr(i) = gVarIsStr(i)
            gSavedVarIsGlobal(i) = gVarIsGlobal(i)
            gSavedVarIsByRef(i) = gVarIsByRef(i)
        Next
    End If
End Sub

Sub RestoreMainScope()
    Dim i As Long
    SbMove(VarPtr(gSbText), VarPtr(gSbSaved))
    gNVars = gSavedNVars
    gFrameSize = gSavedFrame
    If gNVars > 0 Then
        For i = 0 To gNVars - 1
            gVarName(i) = gSavedVarName(i)
            gVarOff(i) = gSavedVarOff(i)
            gVarSize(i) = gSavedVarSize(i)
            gVarCount(i) = gSavedVarCount(i)
            gVarIsPtr(i) = gSavedVarIsPtr(i)
            gVarIsStr(i) = gSavedVarIsStr(i)
            gVarIsGlobal(i) = gSavedVarIsGlobal(i)
            gVarIsByRef(i) = gSavedVarIsByRef(i)
        Next
    End If
End Sub

Function AddArgVar(name As String, off As Long, elemSize As Long, isPtr As Long, isStr As Long, typeIdx As Long, isByRef As Long) As Long
    Dim idx As Long
    If gNVars >= MAX_VARS Then
        Print "too many variables"
        AddArgVar = -1
        Exit Function
    End If
    idx = gNVars
    gVarName(idx) = Lower$(name)
    gVarOff(idx) = off
    ' gVarSize 縺ｯ豺ｻ蟄励せ繧ｱ繝ｼ繝ｫ / p[i] 縺ｮ隕∫ｴ繧ｵ繧､繧ｺ縲・
    ' 繝昴う繝ｳ繧ｿ蠑墓焚縺ｯ繝昴う繝ｳ繧ｿ蟷・4)縺ｧ縺ｯ縺ｪ縺乗欠縺怜・縺ｮ繧ｵ繧､繧ｺ繧剃ｿ晄戟縺吶ｋ・・ddVarEx 縺ｨ蜷後§・峨・
    gVarSize(idx) = elemSize
    If isStr <> 0 Then gVarSize(idx) = 4
    gVarCount(idx) = 1
    gVarIsPtr(idx) = isPtr
    gVarIsStr(idx) = isStr
    gVarIsGlobal(idx) = 0
    gVarIsByRef(idx) = isByRef
    gVarTypeIdx(idx) = typeIdx
    gNVars = gNVars + 1
    AddArgVar = idx
End Function

Function FindSig(name As String) As Long
    Dim i As Long
    Dim n As String
    n = Lower$(name)
    FindSig = -1
    If gNSigs <= 0 Then Exit Function
    For i = 0 To gNSigs - 1
        If gSigName(i) = n Then
            FindSig = i
            Exit Function
        End If
    Next
End Function

Function SigArgByRef(si As Long, argIndex As Long) As Long
    Dim bit As Long
    Dim k As Long
    Dim masked As Long
    SigArgByRef = 0
    If si < 0 Or argIndex < 0 Then Exit Function
    bit = 1
    k = 0
    While k < argIndex
        bit = bit * 2
        k = k + 1
    Wend
    ' If 譚｡莉ｶ蜀・・ And 縺ｯ隲也炊 And 縺ｫ縺ｪ繧九・縺ｧ縲√ン繝・ヨ遨阪・莉｣蜈･縺ｧ陦後≧
    masked = gSigByRef(si) And bit
    If masked <> 0 Then SigArgByRef = 1
End Function

Sub RegisterSig(name As String, byRefBits As Long)
    Dim i As Long
    Dim n As String
    n = Lower$(name)
    i = FindSig(n)
    If i >= 0 Then
        gSigByRef(i) = byRefBits
        Exit Sub
    End If
    If gNSigs >= MAX_PROCS Then
        Print "too many procedures"
        Exit Sub
    End If
    gSigName(gNSigs) = n
    gSigByRef(gNSigs) = byRefBits
    gNSigs = gNSigs + 1
End Sub

Function CompileProcHeader(lineStr As String, isFunc As Long) As Long
    Dim low As String
    Dim rest As String
    Dim name As String
    Dim argsText As String
    Dim lp As Long
    Dim rp As Long
    Dim a As Long
    Dim arg As String
    Dim pos As Long
    Dim argOff As Long
    Dim i As Long
    Dim argIsStr As Long
    Dim argIsPtr As Long
    Dim argIsByRef As Long
    Dim argType As String
    Dim argElem As Long
    Dim argTypeIdx As Long
    Dim byRefBits As Long
    Dim bit As Long

    CompileProcHeader = 0
    If gInProc <> 0 Then
        Print "nested Sub/Function not allowed"
        Exit Function
    End If
    If gIfSp <> 0 Or gLoopSp <> 0 Then
        Print "Sub/Function inside If/loop not allowed"
        Exit Function
    End If

    low = Lower$(lineStr)
    If isFunc <> 0 Then
        rest = Trim$(Mid$(lineStr, 9, Len(lineStr) - 8))
    Else
        rest = Trim$(Mid$(lineStr, 4, Len(lineStr) - 3))
    End If

    lp = InStr(1, rest, "(")
    If lp = 0 Then
        Print "Sub/Function needs ()"
        Exit Function
    End If
    name = Trim$(Left$(rest, lp - 1))
    rp = 0
    a = Len(rest)
    While a >= 1
        If Mid$(rest, a, 1) = ")" Then
            rp = a
            Exit While
        End If
        a = a - 1
    Wend
    If rp = 0 Or rp <= lp Then
        Print "bad Sub/Function header"
        Exit Function
    End If
    argsText = ArgsBetween$(rest, lp, rp)

    SaveMainScope()
    ' 繧ｰ繝ｭ繝ｼ繝舌Ν縺ｯ谿九☆縲ゅΟ繝ｼ繧ｫ繝ｫ縺縺代ヵ繝ｬ繝ｼ繝繧呈眠隕上↓
    gFrameSize = 0
    gInProc = 1
    gProcName = name
    gProcIsFunc = isFunc
    gProcArgBytes = 0
    gRetOff = 0
    byRefBits = 0

    If isFunc <> 0 Then
        ' 謌ｻ繧雁､繧ｹ繝ｭ繝・ヨ
        gFrameSize = 4
        gRetOff = -4
    End If

    If argsText <> "" Then
        If SplitArgs(argsText) = 0 Then Exit Function
        argOff = 8
        bit = 1
        For i = 0 To gNArgs - 1
            arg = Trim$(gArgs(i))
            argIsByRef = 0
            ' ByRef/ByVal 繧帝勁蜴ｻ・・yRef 縺ｯ繝昴う繝ｳ繧ｿ貂｡縺励→縺励※險倬鹸・・
            If StartsWith(Lower$(arg), "byref ") <> 0 Then
                argIsByRef = 1
                arg = Trim$(Mid$(arg, 7, Len(arg) - 6))
            ElseIf StartsWith(Lower$(arg), "byval ") <> 0 Then
                arg = Trim$(Mid$(arg, 7, Len(arg) - 6))
            End If
            pos = InStr(1, Lower$(arg), " as ")
            argIsStr = 0
            argIsPtr = 0
            argElem = 4
            argTypeIdx = -1
            If pos > 0 Then
                argType = Trim$(Mid$(arg, pos + 4, Len(arg) - pos - 3))
                ExpandTypeName(argType, argIsPtr)
                If Lower$(argType) = "string" Then argIsStr = 1
                argElem = TypeSizeOf(argType)
                If argElem <= 0 Then argElem = 4
                argTypeIdx = FindType(argType)
                arg = Trim$(Left$(arg, pos - 1))
            End If
            If AddArgVar(arg, argOff, argElem, argIsPtr, argIsStr, argTypeIdx, argIsByRef) < 0 Then Exit Function
            If argIsByRef <> 0 Then byRefBits = byRefBits Or bit
            bit = bit * 2
            argOff = argOff + 4
            gProcArgBytes = gProcArgBytes + 4
        Next
    End If

    RegisterSig(name, byRefBits)
    CompileProcHeader = 1
End Function

Function CompileEndProc() As Long
    CompileEndProc = 0
    If gInProc = 0 Then
        Print "End Sub/Function without header"
        Exit Function
    End If
    If gIfSp <> 0 Or gLoopSp <> 0 Then
        Print "unclosed If/loop in procedure"
        Exit Function
    End If

    SbMove(VarPtr(gSbTmp), VarPtr(gSbText))
    EmitAsm("push ebp")
    EmitAsm("mov ebp, esp")
    If gFrameSize > 0 Then
        EmitAsm("sub esp, " + Trim$(Str$(gFrameSize)))
    End If
    SbAppendSb(VarPtr(gSbText), VarPtr(gSbTmp))
    SbClear(VarPtr(gSbTmp))

    If gProcIsFunc <> 0 Then
        EmitAsm("mov ebx, ebp")
        EmitAsm("add ebx, " + Trim$(Str$(gRetOff)))
        EmitAsm("mov eax, " + Chr$(&H5B) + "ebx" + Chr$(&H5D))
    End If
    EmitAsm("mov esp, ebp")
    EmitAsm("pop ebp")
    If gProcArgBytes > 0 Then
        EmitAsm("ret " + Trim$(Str$(gProcArgBytes)))
    Else
        EmitAsm("ret")
    End If

    SbAppendStr(VarPtr(gSbProc), "_" + gProcName + ":")
    SbAppendCRLF(VarPtr(gSbProc))
    SbAppendSb(VarPtr(gSbProc), VarPtr(gSbText))
    SbAppendCRLF(VarPtr(gSbProc))
    SbClear(VarPtr(gSbText))

    gInProc = 0
    gProcName = ""
    gProcIsFunc = 0
    RestoreMainScope()
    CompileEndProc = 1
End Function

Function CompileExitProc() As Long
    CompileExitProc = 0
    If gInProc = 0 Then
        Print "Exit Sub/Function outside procedure"
        Exit Function
    End If
    If gProcIsFunc <> 0 Then
        EmitAsm("mov ebx, ebp")
        EmitAsm("add ebx, " + Trim$(Str$(gRetOff)))
        EmitAsm("mov eax, " + Chr$(&H5B) + "ebx" + Chr$(&H5D))
    End If
    EmitAsm("mov esp, ebp")
    EmitAsm("pop ebp")
    If gProcArgBytes > 0 Then
        EmitAsm("ret " + Trim$(Str$(gProcArgBytes)))
    Else
        EmitAsm("ret")
    End If
    CompileExitProc = 1
End Function

Function CompileCallStmt(lineStr As String) As Long
    Dim lp As Long
    Dim rp As Long
    Dim a As Long
    Dim name As String
    Dim argsText As String
    Dim i As Long
    Dim si As Long

    CompileCallStmt = 0
    lp = InStr(1, lineStr, "(")
    If lp <= 1 Then Exit Function
    name = Trim$(Left$(lineStr, lp - 1))
    If Lower$(name) = "if" Or Lower$(name) = "while" Or Lower$(name) = "for" Then Exit Function

    rp = 0
    a = Len(lineStr)
    While a >= 1
        If Mid$(lineStr, a, 1) = ")" Then
            rp = a
            Exit While
        End If
        a = a - 1
    Wend
    If rp = 0 Or rp <= lp Then
        Print "bad call: " + lineStr
        Exit Function
    End If
    argsText = ArgsBetween$(lineStr, lp, rp)

    If argsText = "" Then
        gNArgs = 0
    Else
        If SplitArgs(argsText) = 0 Then Exit Function
    End If

    si = FindSig(name)
    ' stdcall: 蜿ｳ縺九ｉ push・・tep -1 縺ｮ For 縺ｯ逕滓・繧ｳ繝ｼ繝峨′諤ｪ縺励＞縺ｮ縺ｧ While 繧剃ｽｿ縺・ｼ・
    If gNArgs > 0 Then
        i = gNArgs - 1
        While i >= 0
            If SigArgByRef(si, i) <> 0 Then
                If GenArithAddr(gArgs(i)) = 0 Then Exit Function
            Else
                If GenArith(gArgs(i)) = 0 Then Exit Function
            End If
            EmitAsm("push eax")
            i = i - 1
        Wend
    End If
    EmitCallName(name)
    CompileCallStmt = 1
End Function

Sub ExpandIncludesSub(src As *Byte, srcSize As Long, currentFile As String, depth As Long)
    Dim i As Long
    Dim start As Long
    Dim c As Long
    Dim n As Long
    Dim lineBuf[MAX_LINE] As Byte
    Dim lineStr As String
    Dim low As String
    Dim q1 As Long
    Dim q2 As Long
    Dim inc As String
    Dim full As String
    Dim child As *Byte
    Dim childSize As Long
    Dim j As Long
    Dim outText As String
    Dim childText As String

    gExpandResult = ""
    If depth >= 16 Then
        Print "#include nesting/cycle too deep"
        Exit Sub
    End If
    i = 0
    While i < srcSize
        start = i
        While i < srcSize
            c = src[i]
            If c = 10 Or c = 13 Then Exit While
            i = i + 1
        Wend
        n = i - start
        If n >= MAX_LINE Then n = MAX_LINE - 1
        If n > 0 Then memcpy(lineBuf, VarPtr(src[start]), n)
        lineBuf[n] = 0
        lineStr = MakeStr(lineBuf)
        low = Lower$(Trim$(StripComment$(lineStr)))
        If StartsWith(low, "#include") <> 0 Then
            q1 = InStr(1, lineStr, Chr$(34))
            q2 = 0
            If q1 > 0 Then q2 = InStr(q1 + 1, lineStr, Chr$(34))
            If q1 = 0 Or q2 <= q1 Then
                Print "bad #include: " + lineStr
                gExpandResult = ""
                Exit Sub
            End If
            inc = Mid$(lineStr, q1 + 1, q2 - q1 - 1)
            full = inc
            If InStr(1, inc, ":") = 0 And Left$(inc, 1) <> "\" And Left$(inc, 1) <> "/" Then
                full = DirOf$(currentFile) + inc
            End If
            For j = 0 To depth - 1
                If Lower$(gIncludeStack(j)) = Lower$(full) Then
                    Print "#include cycle: " + full
                    gExpandResult = ""
                    Exit Sub
                End If
            Next
            LoadFileToGlobal(StrPtr(full))
            child = gLoadPtr
            childSize = gLastLoadSize
            If child = NULL Then
                Print "cannot include: " + full
                gExpandResult = ""
                Exit Sub
            End If
            gIncludeStack(depth) = full
            ExpandIncludesSub(child, childSize, full, depth + 1)
            childText = gExpandResult
            free(child)
            outText = outText + childText
        Else
            outText = outText + lineStr + Chr$(13) + Chr$(10)
        End If
        If i < srcSize And src[i] = 13 Then i = i + 1
        If i < srcSize And src[i] = 10 Then i = i + 1
    Wend
    gExpandResult = outText
End Sub

Function ExpandIncludes$(src As *Byte, srcSize As Long, currentFile As String, depth As Long) As String
    ExpandIncludesSub(src, srcSize, currentFile, depth)
    ExpandIncludes$ = gExpandResult
End Function

' 螳溯｡後ヵ繧｡繧､繝ｫ髫｣ or 繧ｫ繝ｬ繝ｳ繝医・ Include\default\default.idx
Function DefaultIncludeIdx$() As String
    Dim buf[MAX_PATH] As Byte
    Dim s As String
    Dim i As Long
    Dim n As Long
    Dim ch As String
    Dim slashPos As Long
    Dim dir As String
    Dim p As String

    GetModuleFileName(NULL, buf, MAX_PATH)
    s = MakeStr(buf)
    n = Len(s)
    slashPos = 0
    For i = 1 To n
        ch = Mid$(s, i, 1)
        If ch = "\" Or ch = "/" Then slashPos = i
    Next
    If slashPos > 0 Then
        dir = Left$(s, slashPos)
    Else
        dir = ""
    End If
    p = dir + "Include\default\default.idx"
    If FileExists(p) <> 0 Then
        DefaultIncludeIdx$ = p
        Exit Function
    End If
    p = "Include\default\default.idx"
    If FileExists(p) <> 0 Then
        DefaultIncludeIdx$ = p
        Exit Function
    End If
    DefaultIncludeIdx$ = ""
End Function

' 繧ｽ繝ｼ繧ｹ縺ｫ譏守､ｺ縺後↑縺上※繧・Include/default 繧貞・鬆ｭ縺ｸ螻暮幕
Sub PrependDefaultIncludes()
    Dim idx As String
    Dim p As *Byte
    Dim n As Long
    Dim saved As String

    idx = DefaultIncludeIdx$()
    If idx = "" Then Exit Sub
    LoadFileToGlobal(StrPtr(idx))
    p = gLoadPtr
    n = gLastLoadSize
    If p = 0 Or n <= 0 Then Exit Sub
    saved = gExpandResult
    ExpandIncludesSub(p, n, idx, 0)
    free(p)
    If gExpandResult = "" Then
        gExpandResult = saved
        Exit Sub
    End If
    gExpandResult = gExpandResult + saved
End Sub

Function CompileBuffer(src As *Byte, srcSize As Long) As Long
    Dim i As Long
    Dim start As Long
    Dim lineBuf[MAX_LINE] As Byte
    Dim lenLine As Long
    Dim c As Long
    Dim lineStr As String
    Dim low As String

    CompileBuffer = 0
    gCompileOk = 0
    gSrcLine = 0
    gSrcLineText = ""
    SbClear(VarPtr(gSbData))
    SbClear(VarPtr(gSbText))
    SbClear(VarPtr(gSbProc))
    SbClear(VarPtr(gSbRt))
    SbClear(VarPtr(gSbOut))
    SbClear(VarPtr(gSbTmp))
    SbClear(VarPtr(gSbSaved))
    gStrCount = 0
    gUseMsgBox = 0
    gEmittedExit = 0
    gUseStringRt = 0
    gUseHostRt = 0
    gUseInput = 0
    gApiExternLines = ""
    gNVars = 0
    gNSigs = 0
    gFrameSize = 0
    InitBuiltinConsts()
    gNTypes = 0
    gNTypeDefs = 0
    gNFields = 0
    gInType = 0
    gCurType = -1
    gLabelId = 0
    gIfSp = 0
    gLoopSp = 0
    gSelSp = 0
    i = 0
    While i < MAX_SELECT
        gSelSlotReady(i) = 0
        i = i + 1
    Wend
    gInProc = 0
    gProcName = ""
    gProcIsFunc = 0

    i = 0
    While i < srcSize
        start = i
        While i < srcSize
            c = src[i]
            If c = 10 Or c = 13 Then Exit While
            i = i + 1
        Wend
        gSrcLine = gSrcLine + 1
        lenLine = i - start
        If lenLine >= MAX_LINE Then lenLine = MAX_LINE - 1
        If lenLine > 0 Then
            memcpy(lineBuf, VarPtr(src[start]), lenLine)
        End If
        lineBuf[lenLine] = 0
        lineStr = Trim$(StripComment$(MakeStr(lineBuf)))
        gSrcLineText = lineStr

        If lineStr <> "" Then
            low = Lower$(lineStr)
            If StartsWith(low, "#console") <> 0 Or StartsWith(low, "#strict") <> 0 Then
                ' ignore
            ElseIf gInType <> 0 Then
                If low = "end type" Then
                    If CompileTypeEnd() = 0 Then
                        Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                        Exit Function
                    End If
                ElseIf CompileTypeField(lineStr) = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
            ElseIf StartsWith(low, "typedef ") <> 0 Then
                If CompileTypeDef(lineStr) = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
            ElseIf StartsWith(low, "type ") <> 0 Then
                If CompileTypeStart(lineStr) = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
            ElseIf low = "end select" Then
                If CompileEndSelect() = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
            ElseIf low = "end" Then
                ' End = 繝励Ο繧ｻ繧ｹ邨ゆｺ・ｼ・ub 蜀・・ USAGE 遲峨〒繧ゑｼ・
                EmitAsm("push 0")
                EmitCallName("ExitProcess")
                gEmittedExit = 1
            ElseIf StartsWith(low, "select case ") <> 0 Then
                If CompileSelectCase(lineStr) = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
            ElseIf StartsWith(low, "case ") <> 0 Then
                If CompileCase(lineStr) = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
            ElseIf StartsWith(low, "elseif ") <> 0 Then
                If CompileElseIfThen(lineStr) = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
            ElseIf low = "else" Then
                If CompileElse() = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
            ElseIf low = "end if" Then
                If CompileEndIf() = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
            ElseIf low = "wend" Then
                If CompileWend() = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
            ElseIf low = "loop" Or StartsWith(low, "loop ") <> 0 Then
                If CompileLoop(lineStr) = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
            ElseIf low = "next" Or StartsWith(low, "next ") <> 0 Then
                If CompileNext() = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
            ElseIf low = "exit while" Then
                If CompileExitWhile() = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
            ElseIf low = "exit do" Then
                If CompileExitDo() = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
            ElseIf low = "exit for" Then
                If CompileExitFor() = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
            ElseIf low = "exit sub" Or low = "exit function" Then
                If CompileExitProc() = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
            ElseIf low = "end sub" Or low = "end function" Then
                If CompileEndProc() = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
            ElseIf low = "do" Or StartsWith(low, "do ") <> 0 Then
                If CompileDo(lineStr) = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
            ElseIf StartsWith(low, "while ") <> 0 Then
                If CompileWhile(lineStr) = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
            ElseIf StartsWith(low, "for ") <> 0 Then
                If CompileFor(lineStr) = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
            ElseIf StartsWith(low, "sub ") <> 0 Then
                If CompileProcHeader(lineStr, 0) = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
            ElseIf StartsWith(low, "function ") <> 0 Then
                If CompileProcHeader(lineStr, 1) = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
            ElseIf StartsWith(low, "if ") <> 0 Then
                If CompileIfThen(lineStr) = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
            ElseIf StartsWith(low, "const ") <> 0 Then
                If CompileConst(lineStr) = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
            ElseIf StartsWith(low, "dim ") <> 0 Then
                If CompileDim(lineStr) = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
            ElseIf StartsWith(low, "print ") <> 0 Then
                If CompilePrint(lineStr) = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
            ElseIf StartsWith(low, "input ") <> 0 Then
                If CompileInput(lineStr) = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
            ElseIf StartsWith(lineStr, "MessageBox(") <> 0 Then
                If CompileMessageBox(lineStr) = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
            ElseIf StartsWith(lineStr, "ExitProcess(") <> 0 Then
                If CompileExitProcess(lineStr) = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
            ElseIf FindOp1(lineStr, "=") > 0 Then
                If CompileAssign(lineStr) = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
            ElseIf InStr(1, lineStr, "(") > 1 Then
                If CompileCallStmt(lineStr) = 0 Then
                    Print "error: unknown statement at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
            Else
                Print "error: unknown statement at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                Exit Function
            End If
        End If

        If i < srcSize And src[i] = 13 Then i = i + 1
        If i < srcSize And src[i] = 10 Then i = i + 1
    Wend

    If gInProc <> 0 Then
        Print "error: unclosed Sub/Function at end of file"
        Exit Function
    End If
    If gInType <> 0 Then
        Print "error: unclosed Type at end of file"
        Exit Function
    End If
    If gIfSp <> 0 Then
        Print "error: unclosed If at end of file"
        Exit Function
    End If
    If gLoopSp <> 0 Then
        Print "error: unclosed loop (While/For) at end of file"
        Exit Function
    End If

    SbMove(VarPtr(gSbTmp), VarPtr(gSbText))
    If gNVars > 0 Then
        EmitAsm("push ebp")
        EmitAsm("mov ebp, esp")
        EmitAsm("sub esp, " + Trim$(Str$(gFrameSize)))
    End If
    SbAppendSb(VarPtr(gSbText), VarPtr(gSbTmp))
    SbClear(VarPtr(gSbTmp))

    If gEmittedExit = 0 Then
        EmitAsm("push 0")
        EmitCallName("ExitProcess")
        gEmittedExit = 1
    End If

    SbAppendStr(VarPtr(gSbOut), "bits 32")
    SbAppendCRLF(VarPtr(gSbOut))
    SbAppendCRLF(VarPtr(gSbOut))
    SbAppendStr(VarPtr(gSbOut), "; generated by abc (Phase5)")
    SbAppendCRLF(VarPtr(gSbOut))
    If gUseMsgBox <> 0 Then
        SbAppendStr(VarPtr(gSbOut), "extern _MessageBoxA@16")
        SbAppendCRLF(VarPtr(gSbOut))
    End If
    If gApiExternLines <> "" Then
        SbAppendStr(VarPtr(gSbOut), gApiExternLines)
        SbAppendCRLF(VarPtr(gSbOut))
    End If
    If gUseStringRt <> 0 Then
        SbAppendStr(VarPtr(gSbOut), "extern _lstrlenA@4")
        SbAppendCRLF(VarPtr(gSbOut))
        SbAppendStr(VarPtr(gSbOut), "extern _lstrcpyA@8")
        SbAppendCRLF(VarPtr(gSbOut))
        SbAppendStr(VarPtr(gSbOut), "extern _lstrcatA@8")
        SbAppendCRLF(VarPtr(gSbOut))
        SbAppendStr(VarPtr(gSbOut), "extern _lstrcmpA@8")
        SbAppendCRLF(VarPtr(gSbOut))
        SbAppendStr(VarPtr(gSbOut), "extern _GetProcessHeap@0")
        SbAppendCRLF(VarPtr(gSbOut))
        SbAppendStr(VarPtr(gSbOut), "extern _HeapAlloc@12")
        SbAppendCRLF(VarPtr(gSbOut))
        SbAppendStr(VarPtr(gSbOut), "extern _GetStdHandle@4")
        SbAppendCRLF(VarPtr(gSbOut))
        SbAppendStr(VarPtr(gSbOut), "extern _WriteFile@20")
        SbAppendCRLF(VarPtr(gSbOut))
        If gUseInput <> 0 Then
            SbAppendStr(VarPtr(gSbOut), "extern _ReadFile@20")
            SbAppendCRLF(VarPtr(gSbOut))
        End If
        SbAppendCRLF(VarPtr(gSbOut))
    End If
    SbAppendStr(VarPtr(gSbOut), "section .data")
    SbAppendCRLF(VarPtr(gSbOut))
    If SbIsEmpty(VarPtr(gSbData)) = 0 Then
        SbAppendSb(VarPtr(gSbOut), VarPtr(gSbData))
    Else
        SbAppendStr(VarPtr(gSbOut), "    dummy db 0")
        SbAppendCRLF(VarPtr(gSbOut))
    End If
    SbAppendCRLF(VarPtr(gSbOut))
    SbAppendStr(VarPtr(gSbOut), "section .text")
    SbAppendCRLF(VarPtr(gSbOut))
    SbAppendStr(VarPtr(gSbOut), "    global _main")
    SbAppendCRLF(VarPtr(gSbOut))
    SbAppendCRLF(VarPtr(gSbOut))
    If SbIsEmpty(VarPtr(gSbProc)) = 0 Then
        SbAppendSb(VarPtr(gSbOut), VarPtr(gSbProc))
    End If
    If SbIsEmpty(VarPtr(gSbRt)) = 0 Then
        SbAppendSb(VarPtr(gSbOut), VarPtr(gSbRt))
        SbAppendCRLF(VarPtr(gSbOut))
    End If
    SbAppendStr(VarPtr(gSbOut), "_main:")
    SbAppendCRLF(VarPtr(gSbOut))
    SbAppendSb(VarPtr(gSbOut), VarPtr(gSbText))

    gCompileOk = 1
    CompileBuffer = 1
End Function

' --- 繝｡繧､繝ｳ ---
' String 髢｢謨ｰ縺ｮ謌ｻ繧贋ｻ｣蜈･縺梧ｪ縺励＞縺ｮ縺ｧ縲∝・蜉帙・ *Byte + gLastLoadSize縲∝・蜉帙・繧ｰ繝ｭ繝ｼ繝舌Ν縺ｸ
Dim inPath[MAX_PATH] As Byte
Dim outPath[MAX_PATH] As Byte
Dim srcBuf As *Byte
Dim srcSize As Long
Dim outName As String

If GetCmd(1, inPath) = 0 Then
    USAGE()
End If
If GetCmd(2, outPath) = 0 Then
    outName = ChangeExtension$(MakeStr(inPath), ".asm")
    lstrcpy(outPath, StrPtr(outName))
End If

LoadFileToGlobal(inPath)
srcBuf = gLoadPtr
srcSize = gLastLoadSize
If srcBuf = NULL Or srcSize <= 0 Then
    Print "error: cannot open input: " + MakeStr(inPath)
    End
End If
Print "loaded bytes=" + Str$(srcSize)

' String 謌ｻ繧雁､邨檎罰縺ｯ螢翫ｌ繧九％縺ｨ縺後≠繧九・縺ｧ縲∝ｱ暮幕邨先棡縺ｯ gExpandResult 繧剃ｽｿ縺・
ExpandIncludesSub(srcBuf, srcSize, MakeStr(inPath), 0)
free(srcBuf)
If gExpandResult = "" Then
    Print "error: #include expand failed for: " + MakeStr(inPath)
    End
End If
' Include/default・・inTypes 遲会ｼ峨ｒ繧ｽ繝ｼ繧ｹ譏守､ｺ縺ｪ縺励〒蜈磯ｭ縺ｫ謖ｿ蜈･
PrependDefaultIncludes()
If CompileBuffer(StrPtr(gExpandResult), Len(gExpandResult)) = 0 Then
    Print "error: compile failed for: " + MakeStr(inPath)
    End
End If
If gCompileOk = 0 Or gSbOut.len <= 0 Then
    Print "error: compile produced no asm output for: " + MakeStr(inPath)
    End
End If

If WriteAll(outPath, gSbOut.p, gSbOut.len) = 0 Then
    Print "error: cannot write output: " + MakeStr(outPath)
Else
    Print "OK: " + MakeStr(inPath) + " -> " + MakeStr(outPath) + " (" + Trim$(Str$(gSbOut.len)) + " bytes)"
End If

End
' ---- Utils.abp ----
' Utils.abp - 譁・ｭ怜・繝ｻ繝代せ蜈ｱ騾壹Θ繝ｼ繝・ぅ繝ｪ繝・ぅ
' 蜷・ヤ繝ｼ繝ｫ縺ｯ xxx.idx 邨檎罰縺ｧ #include 縺吶ｋ・・pj 縺ｮ #SOURCE 縺ｫ繧ょ・謖呻ｼ・

Function IsSpace(c As Long) As Long
    If c = Asc(" ") Or c = 9 Or c = 13 Or c = 10 Then
        IsSpace = 1
    Else
        IsSpace = 0
    End If
End Function

Function Trim$(s As String) As String
    Dim p As *Byte
    Dim i As Long
    Dim j As Long
    Dim n As Long
    n = Len(s)
    If n = 0 Then
        Trim$ = ""
        Exit Function
    End If
    p = StrPtr(s)
    i = 0
    While i < n And IsSpace(p[i]) <> 0
        i = i + 1
    Wend
    j = n - 1
    While j >= i And IsSpace(p[j]) <> 0
        j = j - 1
    Wend
    If j < i Then
        Trim$ = ""
    Else
        Trim$ = Mid$(s, i + 1, j - i + 1)
    End If
End Function

' 螟ｧ譁・ｭ怜ｰ乗枚蟄励ｒ辟｡隕悶＠縺滓枚蟄怜・豈碑ｼ・ｼ医・繧､繝ｳ繧ｿ豈碑ｼ・↓關ｽ縺ｨ縺輔↑縺・ｼ・
Function StrEqCI(a As String, b As String) As Long
    Dim i As Long
    Dim n As Long
    Dim pa As *Byte
    Dim pb As *Byte
    Dim ca As Long
    Dim cb As Long
    StrEqCI = 0
    n = Len(a)
    If n <> Len(b) Then Exit Function
    If n = 0 Then
        StrEqCI = 1
        Exit Function
    End If
    pa = StrPtr(a)
    pb = StrPtr(b)
    For i = 0 To n - 1
        ca = pa[i]
        cb = pb[i]
        If ca >= Asc("A") And ca <= Asc("Z") Then ca = ca + 32
        If cb >= Asc("A") And cb <= Asc("Z") Then cb = cb + 32
        If ca <> cb Then Exit Function
    Next
    StrEqCI = 1
End Function

' Mid$/Left$ 縺ｮ驛ｨ蛻・枚蟄怜・縺ｯ Len 縺ｨ迢ｬ遶九＠縺・\0 邨らｫｯ繧呈戟縺溘↑縺・％縺ｨ縺後≠繧九・
' MakeStr(StrPtr(s)) 縺ｯ lstrlen 萓晏ｭ倥・縺溘ａ菴ｿ繧上★縲´en 蛻・□縺代さ繝斐・縺励※縺九ｉ MakeStr 縺吶ｋ縲・
Function DupStr$(s As String) As String
    Dim n As Long
    Dim i As Long
    Dim p As *Byte
    Dim q As *Byte
    Dim tmp As Long
    Dim bp As *Byte
    n = Len(s)
    If n = 0 Then
        DupStr$ = ""
        Exit Function
    End If
    q = malloc(n + 1)
    If q = 0 Then
        DupStr$ = ""
        Exit Function
    End If
    p = StrPtr(s)
    bp = VarPtr(tmp)
    For i = 0 To n - 1
        tmp = p[i]
        q[i] = bp[0]
    Next
    q[n] = 0
    DupStr$ = MakeStr(q)
    free(q)
End Function

Function Lower$(s As String) As String
    Dim p As *Byte
    Dim i As Long
    Dim n As Long
    Dim c As Long
    Dim tmp As Long
    Dim bp As *Byte
    Dim r As String
    n = Len(s)
    If n = 0 Then
        Lower$ = ""
        Exit Function
    End If
    ' Len 繝吶・繧ｹ隍・｣ｽ縺ｮ縺・∴蟆乗枚蟄怜喧・・id$(s,1,n) / MakeStr(StrPtr) 縺ｯ荳榊庄・・
    r = DupStr$(s)
    p = StrPtr(r)
    bp = VarPtr(tmp)
    For i = 0 To n - 1
        c = p[i]
        If c >= Asc("A") And c <= Asc("Z") Then
            tmp = c + 32
            p[i] = bp[0]
        End If
    Next
    Lower$ = r
End Function

' 螟ｧ譁・ｭ怜ｰ乗枚蟄励ｒ蛹ｺ蛻･縺吶ｋ蜑肴婿荳閾ｴ
Function StartsWith(s As String, prefix As String) As Long
    Dim n As Long
    Dim m As Long
    n = Len(s)
    m = Len(prefix)
    If n < m Then
        StartsWith = 0
    ElseIf Left$(s, m) = prefix Then
        StartsWith = 1
    Else
        StartsWith = 0
    End If
End Function

' 螟ｧ譁・ｭ怜ｰ乗枚蟄励ｒ蛹ｺ蛻･縺励↑縺・燕譁ｹ荳閾ｴ
Function StartsWithCI(s As String, prefix As String) As Long
    Dim n As Long
    Dim m As Long
    Dim a As String
    n = Len(s)
    m = Len(prefix)
    If n < m Then
        StartsWithCI = 0
        Exit Function
    End If
    If m = 0 Then
        StartsWithCI = 1
        Exit Function
    End If
    a = Left$(s, m)
    StartsWithCI = StrEqCI(a, prefix)
End Function

' 諡｡蠑ｵ蟄舌ｒ髯､縺・◆繝代せ・医ョ繧｣繝ｬ繧ｯ繝医Μ蜷ｫ繧・・
Function BaseName$(inPath As String) As String
    Dim i As Long
    Dim n As Long
    Dim ch As String
    Dim dotPos As Long
    Dim slashPos As Long
    n = Len(inPath)
    dotPos = 0
    slashPos = 0
    For i = 1 To n
        ch = Mid$(inPath, i, 1)
        If ch = "\" Or ch = "/" Then
            slashPos = i
            dotPos = 0
        ElseIf ch = "." Then
            dotPos = i
        End If
    Next
    If dotPos > slashPos Then
        BaseName$ = Left$(inPath, dotPos - 1)
    Else
        BaseName$ = inPath
    End If
End Function

' 繝・ぅ繝ｬ繧ｯ繝医Μ驛ｨ蛻・ｼ域忰蟆ｾ縺ｫ \ 縺ｾ縺溘・ / 繧貞性繧・峨ら┌縺代ｌ縺ｰ ""
Function DirOf$(path As String) As String
    Dim i As Long
    Dim n As Long
    Dim ch As String
    Dim slashPos As Long
    n = Len(path)
    slashPos = 0
    For i = 1 To n
        ch = Mid$(path, i, 1)
        If ch = "\" Or ch = "/" Then
            slashPos = i
        End If
    Next
    If slashPos > 0 Then
        DirOf$ = Left$(path, slashPos)
    Else
        DirOf$ = ""
    End If
End Function

Function FileNameOnly$(path As String) As String
    Dim d As String
    Dim n As Long
    d = DirOf$(path)
    n = Len(d)
    If n = 0 Then
        FileNameOnly$ = path
    Else
        FileNameOnly$ = Mid$(path, n + 1, Len(path) - n)
    End If
End Function

Function EndsWithExt(path As String, ext As String) As Long
    Dim n As Long
    Dim m As Long
    Dim i As Long
    Dim cp As Long
    Dim ce As Long
    Dim pp As *Byte
    Dim pe As *Byte
    n = Len(path)
    m = Len(ext)
    EndsWithExt = 0
    If n < m Then Exit Function
    If m = 0 Then
        EndsWithExt = 1
        Exit Function
    End If
    pp = StrPtr(path)
    pe = StrPtr(ext)
    For i = 0 To m - 1
        cp = pp[n - m + i]
        ce = pe[i]
        If cp >= Asc("A") And cp <= Asc("Z") Then cp = cp + 32
        If ce >= Asc("A") And ce <= Asc("Z") Then ce = ce + 32
        If cp <> ce Then Exit Function
    Next
    EndsWithExt = 1
End Function

' 諡｡蠑ｵ蟄舌ｒ newExt・井ｾ・ ".asm"・峨↓鄂ｮ謠帙＠縺溘ヱ繧ｹ繧定ｿ斐☆
Function ChangeExtension$(inPath As String, newExt As String) As String
    Dim base As String
    base = BaseName$(inPath)
    ChangeExtension$ = base + newExt
End Function
' ---- Common.abp ----
' Common.abp - 繧ｳ繝槭Φ繝芽｡後・繝｡繝｢繝ｪ繝ｻ譖ｸ蠑上・蜈ｱ騾壼・逅・
' WinAPI 螳壽焚 (MAX_PATH / NULL 遲・ 縺ｯ繝帙せ繝医・繝・ム縺ｾ縺溘・ abc 邨・∩霎ｼ縺ｿ繧剃ｽｿ縺・

Function GetCmd(cnt As Long, buf As *Byte) As Long
    Dim cmd As *Byte
    Dim cmdlen As Long
    Dim cidx As Long
    Dim ctmp[MAX_PATH] As Byte
    Dim n As Long
    Dim m As Long
    Dim pBuf As *Byte

    pBuf = buf
    cmd = GetCommandLine()
    cmdlen = lstrlen(cmd)
    cmd[cmdlen] = &H20
    pBuf[0] = 0
    cidx = 0

    For n = 0 To cmdlen
        If cmd[n] = &H20 And cmd[n + 1] = &H20 Then
            memcpy(VarPtr(cmd[n]), VarPtr(cmd[n + 1]), cmdlen - n)
            n = n - 1
            cmdlen = cmdlen - 1
        End If
    Next

    For n = 0 To cmdlen
        m = 0
        While cmd[n] <> &H20
            ctmp[m] = cmd[n]
            m = m + 1
            n = n + 1
        Wend
        ctmp[m] = 0
        If cidx = cnt Then
            lstrcpy(buf, ctmp)
            GetCmd = 1
            Exit Function
        End If
        cidx = cidx + 1
    Next
    GetCmd = 0
End Function

Sub ZeroMem(p As *Byte, n As Long)
    Dim i As Long
    Dim q As *Byte
    If n <= 0 Then Exit Sub
    q = p
    For i = 0 To n - 1
        q[i] = 0
    Next
End Sub

Function HexPad$(num As Long, digits As Long) As String
    Dim s As String
    s = Hex$(num)
    While Len(s) < digits
        s = "0" + s
    Wend
    HexPad$ = s
End Function
' ---- FileIO.abp ----
' FileIO.abp - 繝輔ぃ繧､繝ｫ蜈･蜃ｺ蜉帛・騾壼・逅・
' 繝帙せ繝・AB: 繝昴う繝ｳ繧ｿ蠑墓焚縺ｮ縺ｿ ByVal NULL縲・ANDLE 遲峨・ NULL/0

Dim gLastLoadSize As Long
Dim gLoadPtr As *Byte

Function FileExists(path As String) As Long
    Dim attr As DWord
    attr = GetFileAttributes(StrPtr(path))
    If attr = &HFFFFFFFF Then
        FileExists = 0
    Else
        FileExists = 1
    End If
End Function

' Function 謌ｻ繧・(*Byte) 縺悟｣翫ｌ繧九％縺ｨ縺後≠繧九◆繧√∫ｵ先棡縺ｯ gLoadPtr / gLastLoadSize 縺ｸ
Sub LoadFileToGlobal(path As *Byte)
    Dim hFile As HANDLE
    Dim fsiz As Long
    Dim nRead As DWord
    Dim p As *Byte

    gLoadPtr = 0
    gLastLoadSize = 0

    hFile = CreateFile(path, GENERIC_READ, FILE_SHARE_READ, ByVal NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL)
    If hFile = INVALID_HANDLE_VALUE Then Exit Sub

    fsiz = GetFileSize(hFile, NULL)
    If fsiz <= 0 Then
        CloseHandle(hFile)
        Exit Sub
    End If

    p = malloc(fsiz + 1)
    If p = 0 Then
        CloseHandle(hFile)
        Exit Sub
    End If

    ReadFile(hFile, p, fsiz, VarPtr(nRead), ByVal NULL)
    CloseHandle(hFile)
    p[fsiz] = 0
    gLastLoadSize = fsiz
    gLoadPtr = p
End Sub

Function LoadFile(path As *Byte, ByRef outSize As Long) As *Byte
    LoadFileToGlobal(path)
    outSize = gLastLoadSize
    LoadFile = gLoadPtr
End Function

Function WriteAll(path As *Byte, p As *Byte, size As Long) As Long
    Dim hFile As HANDLE
    Dim nWritten As DWord

    WriteAll = 0
    hFile = CreateFile(path, GENERIC_WRITE, 0, ByVal NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL)
    If hFile = INVALID_HANDLE_VALUE Then Exit Function

    WriteFile(hFile, p, size, VarPtr(nWritten), ByVal NULL)
    CloseHandle(hFile)
    If nWritten = size Then WriteAll = 1
End Function

Function LoadTextFile$(path As String) As String
    Dim hFile As HANDLE
    Dim fsiz As Long
    Dim nRead As DWord
    Dim p As *Byte

    LoadTextFile$ = ""
    hFile = CreateFile(StrPtr(path), GENERIC_READ, FILE_SHARE_READ, ByVal NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL)
    If hFile = INVALID_HANDLE_VALUE Then
        Print "cannot open: " + path
        Exit Function
    End If
    fsiz = GetFileSize(hFile, NULL)
    If fsiz < 0 Then
        CloseHandle(hFile)
        Exit Function
    End If
    p = malloc(fsiz + 1)
    If p = 0 Then
        CloseHandle(hFile)
        Exit Function
    End If
    If fsiz > 0 Then
        ReadFile(hFile, p, fsiz, VarPtr(nRead), ByVal NULL)
    End If
    CloseHandle(hFile)
    p[fsiz] = 0
    LoadTextFile$ = MakeStr(p)
    free(p)
End Function

Function WriteTextFile(path As String, text As String) As Long
    Dim hFile As HANDLE
    Dim nWritten As DWord
    Dim n As Long

    WriteTextFile = 0
    n = Len(text)
    hFile = CreateFile(StrPtr(path), GENERIC_WRITE, 0, ByVal NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL)
    If hFile = INVALID_HANDLE_VALUE Then Exit Function
    If n > 0 Then
        WriteFile(hFile, StrPtr(text), n, VarPtr(nWritten), ByVal NULL)
    Else
        nWritten = 0
    End If
    CloseHandle(hFile)
    If nWritten = n Then
        WriteTextFile = 1
    End If
End Function
' ---- StringBuffer.abp ----
' StringBuffer.abp - 蜿ｯ螟蛾聞繝舌う繝医ヰ繝・ヵ繧｡・医け繝ｩ繧ｹ縺ｪ縺暦ｼ・
' 蟾ｨ螟ｧ縺ｪ String 騾｣邨舌・ O(n^2) 繧帝∩縺代ｋ縺溘ａ縲∵忰蟆ｾ霑ｽ險・+ 蛟榊｢礼｢ｺ菫・
' 豕ｨ: abc 縺ｯ base->field[i] 譛ｪ蟇ｾ蠢懊・縺溘ａ縲∵ｷｻ蟄励・荳譎・*Byte 邨檎罰

Const SB_INIT_CAP = 4096

Type StringBuffer
    p As *Byte
    len As Long
    cap As Long
End Type

Sub SbInit(sb As *StringBuffer)
    sb->p = 0
    sb->len = 0
    sb->cap = 0
End Sub

Sub SbFree(sb As *StringBuffer)
    Dim p As *Byte
    p = sb->p
    If p <> 0 Then
        free(p)
    End If
    sb->p = 0
    sb->len = 0
    sb->cap = 0
End Sub

Sub SbClear(sb As *StringBuffer)
    Dim p As *Byte
    sb->len = 0
    p = sb->p
    If p <> 0 Then
        p[0] = 0
    End If
End Sub

Function SbEnsure(sb As *StringBuffer, need As Long) As Long
    Dim np As *Byte
    Dim ncap As Long
    Dim op As *Byte
    Dim n As Long
    SbEnsure = 0
    If need <= sb->cap Then
        SbEnsure = 1
        Exit Function
    End If
    ncap = sb->cap
    If ncap <= 0 Then ncap = SB_INIT_CAP
    While ncap < need
        ncap = ncap * 2
    Wend
    np = malloc(ncap)
    If np = 0 Then
        Print "StringBuffer: out of memory"
        Exit Function
    End If
    n = sb->len
    op = sb->p
    If n > 0 And op <> 0 Then
        memcpy(np, op, n)
    End If
    If op <> 0 Then
        free(op)
    End If
    sb->p = np
    sb->cap = ncap
    SbEnsure = 1
End Function

Sub SbAppendBytes(sb As *StringBuffer, src As *Byte, n As Long)
    Dim p As *Byte
    Dim off As Long
    If n <= 0 Then Exit Sub
    If SbEnsure(sb, sb->len + n + 1) = 0 Then
        ExitProcess(1)
    End If
    p = sb->p
    off = sb->len
    memcpy(VarPtr(p[off]), src, n)
    off = off + n
    sb->len = off
    p[off] = 0
End Sub

Sub SbAppendStr(sb As *StringBuffer, s As String)
    Dim n As Long
    n = Len(s)
    If n <= 0 Then Exit Sub
    SbAppendBytes(sb, StrPtr(s), n)
End Sub

Sub SbAppendCRLF(sb As *StringBuffer)
    Dim crlf[2] As Byte
    crlf[0] = 13
    crlf[1] = 10
    SbAppendBytes(sb, crlf, 2)
End Sub

Sub SbAppendSb(dst As *StringBuffer, src As *StringBuffer)
    Dim sp As *Byte
    Dim n As Long
    n = src->len
    If n <= 0 Then Exit Sub
    sp = src->p
    SbAppendBytes(dst, sp, n)
End Sub

Sub SbAppendByte(sb As *StringBuffer, b As Long)
    Dim p As *Byte
    Dim off As Long
    If SbEnsure(sb, sb->len + 2) = 0 Then
        ExitProcess(1)
    End If
    p = sb->p
    off = sb->len
    p[off] = b And &HFF
    off = off + 1
    sb->len = off
    p[off] = 0
End Sub

Sub SbAppendZeros(sb As *StringBuffer, n As Long)
    Dim p As *Byte
    Dim off As Long
    If n <= 0 Then Exit Sub
    If SbEnsure(sb, sb->len + n + 1) = 0 Then
        ExitProcess(1)
    End If
    p = sb->p
    off = sb->len
    ZeroMem(VarPtr(p[off]), n)
    off = off + n
    sb->len = off
    p[off] = 0
End Sub

' dst 繧定ｧ｣謾ｾ縺励《rc 縺ｮ謇譛画ｨｩ繧堤ｧｻ縺呻ｼ・rc 縺ｯ遨ｺ縺ｫ縺ｪ繧具ｼ・
Sub SbMove(dst As *StringBuffer, src As *StringBuffer)
    Dim p As *Byte
    p = dst->p
    If p <> 0 Then
        free(p)
    End If
    dst->p = src->p
    dst->len = src->len
    dst->cap = src->cap
    src->p = 0
    src->len = 0
    src->cap = 0
End Sub

Function SbLen(sb As *StringBuffer) As Long
    SbLen = sb->len
End Function

Function SbData(sb As *StringBuffer) As *Byte
    SbData = sb->p
End Function

Function SbIsEmpty(sb As *StringBuffer) As Long
    If sb->len <= 0 Then
        SbIsEmpty = 1
    Else
        SbIsEmpty = 0
    End If
End Function

Function SbToString$(sb As *StringBuffer) As String
    Dim p As *Byte
    Dim n As Long
    p = sb->p
    n = sb->len
    If p = 0 Or n <= 0 Then
        SbToString$ = ""
    Else
        p[n] = 0
        SbToString$ = MakeStr(p)
    End If
End Function
' ---- abcGlobals.abp ----
' abcGlobals.abp - abc 縺ｮ Const / Dim・育ｵ仙粋譎ゅ・ Lexer/Emit 繧医ｊ蜑阪↓鄂ｮ縺擾ｼ・

Const MAX_ARGS = 16
Const MAX_LINE = 512
Const MAX_VARS = 1024
Const MAX_CONSTS = 256
Const MAX_TYPES = 64
Const MAX_TYPEDEFS = 64
Const MAX_FIELDS = 256
Const MAX_APIS = 24
Const MAX_IF = 16
Const MAX_LOOP = 16
Const MAX_SELECT = 16
Const MAX_PROCS = 512

Dim gArgs(MAX_ARGS - 1) As String
Dim gNArgs As Long
Dim gAsmArgs(MAX_ARGS - 1) As String
Dim gSbData As StringBuffer
Dim gSbText As StringBuffer
Dim gSbProc As StringBuffer
Dim gSbRt As StringBuffer
Dim gSbOut As StringBuffer
Dim gSbTmp As StringBuffer
Dim gSbSaved As StringBuffer
Dim gStrCount As Long
Dim gUseMsgBox As Long
Dim gEmittedExit As Long

Dim gVarName(MAX_VARS - 1) As String
Dim gVarOff(MAX_VARS - 1) As Long
Dim gVarSize(MAX_VARS - 1) As Long
Dim gVarCount(MAX_VARS - 1) As Long
Dim gVarIsPtr(MAX_VARS - 1) As Long
Dim gVarIsStr(MAX_VARS - 1) As Long
Dim gVarIsGlobal(MAX_VARS - 1) As Long
Dim gVarIsByRef(MAX_VARS - 1) As Long
Dim gVarTypeIdx(MAX_VARS - 1) As Long
Dim gNVars As Long
Dim gFrameSize As Long
Dim gLabelId As Long
Dim gIfElse(MAX_IF - 1) As String
Dim gIfEnd(MAX_IF - 1) As String
Dim gIfSp As Long

Dim gSelEnd(MAX_SELECT - 1) As String
Dim gSelNext(MAX_SELECT - 1) As String
Dim gSelStarted(MAX_SELECT - 1) As Long
Dim gSelSlotReady(MAX_SELECT - 1) As Long
Dim gSelSp As Long

Dim gConstName(MAX_CONSTS - 1) As String
Dim gConstVal(MAX_CONSTS - 1) As Long
Dim gNConsts As Long

Dim gLoopTop(MAX_LOOP - 1) As String
Dim gLoopCont(MAX_LOOP - 1) As String
Dim gLoopEnd(MAX_LOOP - 1) As String
Dim gLoopKind(MAX_LOOP - 1) As Long
Dim gForVar(MAX_LOOP - 1) As String
Dim gForStep(MAX_LOOP - 1) As String
Dim gLoopSp As Long

