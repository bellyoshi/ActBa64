' ---- Include/default ----
' Include/default 閾ｪ蜍戊ｪｭ縺ｿ霎ｼ縺ｿ荳隕ｧ・医た繝ｼ繧ｹ縺ｫ #include 荳崎ｦ・ｼ・
#include "Windows.sbp"
#include "WinConsts.sbp"
#include "WinTypes.sbp"
' ---- abc.abp ----
#include "abc.idx"

#console

' abc - ABP Phase5 繧ｳ繝ｳ繝代う繝ｩ (.abp -> .asm)
' 菴ｿ縺・婿: abc <input.abp> [output.asm]
'
' Phase5:
'   Dim s As String / 譁・ｭ怜・繝ｪ繝・Λ繝ｫ / + 騾｣邨・
'   Len / Left$ / Mid$ / Chr$ / Asc / StrPtr
'   譁・ｭ怜・ = <> 縲∵擅莉ｶ Or / And
' Const/Dim 縺ｯ abcGlobals.abp

Sub USAGE()
    Print "abc - Phase5 ABP compiler (.abp -> .asm)"
    Print "usage: abc <input.abp> [output.asm]"
    End
End Sub

Sub EmitAsm(line As String)
    SbAppendStr(VarPtr(gSbText), "    ")
    SbAppendStr(VarPtr(gSbText), line)
    SbAppendCRLF(VarPtr(gSbText))
End Sub

Sub EmitLabel(lab As String)
    SbAppendStr(VarPtr(gSbText), lab)
    SbAppendStr(VarPtr(gSbText), ":")
    SbAppendCRLF(VarPtr(gSbText))
End Sub

Function NewLabel$() As String
    gLabelId = gLabelId + 1
    NewLabel$ = "L" + Trim$(Str$(gLabelId))
End Function

Function IsIdentStart(c As Long) As Long
    If (c >= Asc("A") And c <= Asc("Z")) Or (c >= Asc("a") And c <= Asc("z")) Or c = Asc("_") Then
        IsIdentStart = 1
    Else
        IsIdentStart = 0
    End If
End Function

Function IsIdentChar2(c As Long) As Long
    If IsIdentStart(c) <> 0 Or (c >= Asc("0") And c <= Asc("9")) Or c = Asc("$") Then
        IsIdentChar2 = 1
    Else
        IsIdentChar2 = 0
    End If
End Function

Function IsIdentName(s As String) As Long
    Dim t As String
    Dim p As *Byte
    Dim i As Long
    Dim n As Long
    t = Trim$(s)
    n = Len(t)
    IsIdentName = 0
    If n = 0 Then Exit Function
    p = StrPtr(t)
    If IsIdentStart(p[0]) = 0 Then Exit Function
    i = 1
    While i < n
        If IsIdentChar2(p[i]) = 0 Then Exit Function
        i = i + 1
    Wend
    IsIdentName = 1
End Function

' openPos(0-based) 縺ｮ ( 縺ｾ縺溘・ [ 縺ｫ蟇ｾ蠢懊☆繧矩哩縺倅ｽ咲ｽｮ縲ょ､ｱ謨励・ -1
Function MatchClose(p As *Byte, n As Long, openPos As Long) As Long
    Dim depth As Long
    Dim i As Long
    Dim openCh As Long
    Dim closeCh As Long
    Dim inQ As Long
    Dim c As Long
    MatchClose = -1
    If openPos < 0 Or openPos >= n Then Exit Function
    openCh = p[openPos]
    If openCh = 40 Then
        closeCh = 41
    ElseIf openCh = &H5B Then
        closeCh = &H5D
    Else
        Exit Function
    End If
    depth = 1
    inQ = 0
    i = openPos + 1
    While i < n
        c = p[i]
        If inQ <> 0 Then
            If c = 34 Then inQ = 0
        ElseIf c = 34 Then
            inQ = 1
        ElseIf c = openCh Then
            depth = depth + 1
        ElseIf c = closeCh Then
            depth = depth - 1
            If depth = 0 Then
                MatchClose = i
                Exit Function
            End If
        End If
        i = i + 1
    Wend
End Function

' openParen / closeParen 縺ｯ縺ｩ縺｡繧峨ｂ 1-based・・(' 縺ｨ ')' 縺ｮ菴咲ｽｮ・・
Function ArgsBetween$(expr As String, openParen As Long, closeParen As Long) As String
    Dim n As Long
    n = closeParen - openParen - 1
    If n <= 0 Then
        ArgsBetween$ = ""
    Else
        ArgsBetween$ = Trim$(Mid$(expr, openParen + 1, n))
    End If
End Function

Function IsNumStr(s As String) As Long
    Dim t As String
    Dim p As *Byte
    Dim i As Long
    Dim n As Long
    t = Trim$(s)
    n = Len(t)
    If n = 0 Then
        IsNumStr = 0
        Exit Function
    End If
    p = StrPtr(t)
    i = 0
    If p[0] = Asc("-") Or p[0] = Asc("+") Then
        i = 1
        If n = 1 Then
            IsNumStr = 0
            Exit Function
        End If
    End If
    If i + 1 < n And p[i] = Asc("&") And (p[i + 1] = Asc("H") Or p[i + 1] = Asc("h")) Then
        IsNumStr = 1
        Exit Function
    End If
    While i < n
        If p[i] < Asc("0") Or p[i] > Asc("9") Then
            IsNumStr = 0
            Exit Function
        End If
        i = i + 1
    Wend
    IsNumStr = 1
End Function

Function ParseNum(s As String) As Long
    Dim t As String
    Dim p As *Byte
    Dim i As Long
    Dim n As Long
    Dim sign As Long
    Dim v As Long
    Dim c As Long
    t = Trim$(s)
    n = Len(t)
    p = StrPtr(t)
    sign = 1
    i = 0
    If p[0] = Asc("-") Then
        sign = -1
        i = 1
    ElseIf p[0] = Asc("+") Then
        i = 1
    End If
    If i + 1 < n And p[i] = Asc("&") And (p[i + 1] = Asc("H") Or p[i + 1] = Asc("h")) Then
        i = i + 2
        v = 0
        While i < n
            c = p[i]
            v = v * 16
            If c >= Asc("0") And c <= Asc("9") Then
                v = v + (c - Asc("0"))
            ElseIf c >= Asc("a") And c <= Asc("f") Then
                v = v + (c - Asc("a") + 10)
            ElseIf c >= Asc("A") And c <= Asc("F") Then
                v = v + (c - Asc("A") + 10)
            End If
            i = i + 1
        Wend
        ParseNum = v * sign
        Exit Function
    End If
    v = 0
    While i < n
        v = v * 10 + (p[i] - Asc("0"))
        i = i + 1
    Wend
    ParseNum = v * sign
End Function

Function FindVar(name As String) As Long
    Dim i As Long
    Dim n As String
    n = Lower$(name)
    FindVar = -1
    If gNVars <= 0 Then Exit Function
    For i = 0 To gNVars - 1
        If gVarName(i) = n Then
            FindVar = i
            Exit Function
        End If
    Next
End Function

Function FindConst(name As String) As Long
    Dim i As Long
    Dim n As String
    n = Lower$(name)
    FindConst = -1
    If gNConsts <= 0 Then Exit Function
    For i = 0 To gNConsts - 1
        If gConstName(i) = n Then
            FindConst = i
            Exit Function
        End If
    Next
End Function

Function TypeSizeOf(typeName As String) As Long
    Dim t As String
    Dim i As Long
    t = Lower$(Trim$(typeName))
    If t = "byte" Then
        TypeSizeOf = 1
    ElseIf t = "word" Then
        TypeSizeOf = 2
    ElseIf t = "long" Or t = "dword" Or t = "handle" Or t = "string" Or t = "integer" Or t = "voidptr" Or t = "long_ptr" Or t = "ulong_ptr" Then
        TypeSizeOf = 4
    Else
        TypeSizeOf = 0
        For i = 0 To gNTypes - 1
            If gTypeName(i) = t Then
                TypeSizeOf = gTypeSize(i)
                Exit Function
            End If
        Next
    End If
End Function

Function FindType(typeName As String) As Long
    Dim i As Long
    Dim t As String
    t = Lower$(Trim$(typeName))
    FindType = -1
    For i = 0 To gNTypes - 1
        If gTypeName(i) = t Then
            FindType = i
            Exit Function
        End If
    Next
End Function

Function FindTypeDef(name As String) As Long
    Dim i As Long
    Dim t As String
    t = Lower$(Trim$(name))
    FindTypeDef = -1
    For i = 0 To gNTypeDefs - 1
        If gTypeDefName(i) = t Then
            FindTypeDef = i
            Exit Function
        End If
    Next
End Function

' TypeDef / *T 繧貞ｱ暮幕縲よ怙邨ゅ・蝓ｺ蠎募梛蜷阪→ isPtr 繧定ｿ斐☆
Sub ExpandTypeName(ByRef typeName As String, ByRef isPtr As Long)
    Dim guard As Long
    Dim td As Long
    isPtr = 0
    typeName = Trim$(typeName)
    guard = 0
    While guard < 16
        While Left$(typeName, 1) = "*"
            isPtr = 1
            typeName = Trim$(Mid$(typeName, 2, Len(typeName) - 1))
        Wend
        td = FindTypeDef(typeName)
        If td < 0 Then Exit While
        typeName = Trim$(gTypeDefTarget(td))
        guard = guard + 1
    Wend
    While Left$(typeName, 1) = "*"
        isPtr = 1
        typeName = Trim$(Mid$(typeName, 2, Len(typeName) - 1))
    Wend
End Sub

' TypeDef Name = Target
Function CompileTypeDef(lineStr As String) As Long
    Dim rest As String
    Dim name As String
    Dim target As String
    Dim eq As Long
    Dim td As Long
    CompileTypeDef = 0
    rest = Trim$(Mid$(lineStr, 8, Len(lineStr) - 7))
    eq = InStr(1, rest, "=")
    If eq = 0 Then
        Print "bad TypeDef: " + lineStr
        Exit Function
    End If
    name = Trim$(Left$(rest, eq - 1))
    target = Trim$(Mid$(rest, eq + 1, Len(rest) - eq))
    If IsIdentName(name) = 0 Or target = "" Then
        Print "bad TypeDef: " + lineStr
        Exit Function
    End If
    td = FindTypeDef(name)
    If td >= 0 Then
        ' 蜀榊ｮ夂ｾｩ縺ｯ蜷御ｸ繧ｿ繝ｼ繧ｲ繝・ヨ縺ｪ繧芽ｨｱ蜿ｯ
        If Lower$(gTypeDefTarget(td)) = Lower$(target) Then
            CompileTypeDef = 1
            Exit Function
        End If
        Print "duplicate TypeDef: " + name
        Exit Function
    End If
    If gNTypeDefs >= MAX_TYPEDEFS Then
        Print "too many TypeDef"
        Exit Function
    End If
    td = gNTypeDefs
    gTypeDefName(td) = Lower$(name)
    gTypeDefTarget(td) = target
    gNTypeDefs = gNTypeDefs + 1
    CompileTypeDef = 1
End Function

Function FindField(typeIdx As Long, fieldName As String) As Long
    Dim i As Long
    Dim n As String
    n = Lower$(Trim$(fieldName))
    FindField = -1
    If typeIdx < 0 Or typeIdx >= gNTypes Then Exit Function
    i = gTypeFirstField(typeIdx)
    While i >= 0
        If gFieldName(i) = n Then
            FindField = i
            Exit Function
        End If
        i = gFieldNext(i)
    Wend
End Function

Sub EmitLoadSized(size As Long)
    If size = 1 Then
        EmitAsm("movzx eax, " + Chr$(&H5B) + "ebx" + Chr$(&H5D))
    ElseIf size = 2 Then
        EmitAsm("movzx eax, word " + Chr$(&H5B) + "ebx" + Chr$(&H5D))
    Else
        EmitAsm("mov eax, " + Chr$(&H5B) + "ebx" + Chr$(&H5D))
    End If
End Sub

Sub EmitStoreSized(size As Long)
    If size = 1 Then
        EmitAsm("mov " + Chr$(&H5B) + "ebx" + Chr$(&H5D) + ", al")
    ElseIf size = 2 Then
        EmitAsm("mov " + Chr$(&H5B) + "ebx" + Chr$(&H5D) + ", ax")
    Else
        EmitAsm("mov " + Chr$(&H5B) + "ebx" + Chr$(&H5D) + ", eax")
    End If
End Sub

' base.field / base->field 縺ｮ繧｢繝峨Ξ繧ｹ繧・ebx 縺ｫ險ｭ螳壹☆繧・
Function EmitMemberAddr(access As String, ByRef fieldSize As Long) As Long
    Dim p As Long
    Dim baseName As String
    Dim fieldName As String
    Dim vi As Long
    Dim fi As Long
    EmitMemberAddr = 0
    p = InStr(1, access, "->")
    If p > 0 Then
        baseName = Trim$(Left$(access, p - 1))
        fieldName = Trim$(Mid$(access, p + 2, Len(access) - p - 1))
    Else
        p = InStr(1, access, ".")
        If p = 0 Then
            Print "error: member access needs . or -> : " + access
            Exit Function
        End If
        baseName = Trim$(Left$(access, p - 1))
        fieldName = Trim$(Mid$(access, p + 1, Len(access) - p))
    End If
    vi = FindVar(baseName)
    If vi < 0 Then
        Print "error: undeclared variable in member access: " + baseName + " (from " + access + ")"
        Exit Function
    End If
    If gVarTypeIdx(vi) < 0 Then
        Print "error: not a Type variable (need Dim x As SomeType): " + baseName + " (from " + access + ")"
        Exit Function
    End If
    fi = FindField(gVarTypeIdx(vi), fieldName)
    If fi < 0 Then
        Print "error: unknown field '" + fieldName + "' in " + access + " (type " + gTypeName(gVarTypeIdx(vi)) + ")"
        Exit Function
    End If
    If gVarIsPtr(vi) <> 0 Then
        EmitLoadVar(vi)
        EmitAsm("mov ebx, eax")
    Else
        EmitAddrOfVar(vi)
    End If
    If gFieldOff(fi) <> 0 Then EmitAsm("add ebx, " + Trim$(Str$(gFieldOff(fi))))
    fieldSize = gFieldSize(fi)
    EmitMemberAddr = 1
End Function

Function ApiBytes(name As String) As Long
    Dim n As String
    n = Lower$(name)
    ApiBytes = -1
    If n = "exitprocess" Then ApiBytes = 4
    If n = "getcommandlinea" Or n = "getcommandline" Then ApiBytes = 0
    If n = "lstrlena" Or n = "lstrlen" Then ApiBytes = 4
    If n = "messageboxa" Or n = "messagebox" Then ApiBytes = 16
    If n = "getprocessheap" Then ApiBytes = 0
    If n = "heapalloc" Then ApiBytes = 12
    If n = "heapfree" Then ApiBytes = 12
    If n = "lstrcpya" Or n = "lstrcpy" Or n = "lstrcata" Or n = "lstrcat" Or n = "lstrcmpa" Or n = "lstrcmp" Then ApiBytes = 8
    If n = "createfilea" Or n = "createfile" Then ApiBytes = 28
    If n = "readfile" Or n = "writefile" Then ApiBytes = 20
    If n = "closehandle" Then ApiBytes = 4
    If n = "getfilesize" Then ApiBytes = 8
    If n = "getmodulefilenamea" Or n = "getmodulefilename" Then ApiBytes = 12
    If n = "getfileattributesa" Or n = "getfileattributes" Or n = "deletefilea" Or n = "deletefile" Then ApiBytes = 4
    If n = "createprocessa" Or n = "createprocess" Then ApiBytes = 40
    If n = "waitforsingleobject" Then ApiBytes = 8
    If n = "getstdhandle" Then ApiBytes = 4
    ' user32 / gdi32・・rojectEditor 遲会ｼ・
    If n = "getmodulehandlea" Or n = "getmodulehandle" Then ApiBytes = 4
    If n = "createwindowexa" Or n = "createwindowex" Then ApiBytes = 48
    If n = "defwindowproca" Or n = "defwindowproc" Then ApiBytes = 16
    If n = "sendmessagea" Or n = "sendmessage" Then ApiBytes = 16
    If n = "getdlgitem" Then ApiBytes = 8
    If n = "destroywindow" Then ApiBytes = 4
    If n = "loadicona" Or n = "loadicon" Then ApiBytes = 8
    If n = "loadcursora" Or n = "loadcursor" Then ApiBytes = 8
    If n = "registerclassexa" Or n = "registerclassex" Then ApiBytes = 4
    If n = "enablewindow" Then ApiBytes = 8
    If n = "getwindow" Then ApiBytes = 8
    If n = "postmessagea" Or n = "postmessage" Then ApiBytes = 16
    If n = "postquitmessage" Then ApiBytes = 4
    If n = "getmessagea" Or n = "getmessage" Then ApiBytes = 16
    If n = "translatemessage" Then ApiBytes = 4
    If n = "dispatchmessagea" Or n = "dispatchmessage" Then ApiBytes = 4
    If n = "createfonta" Or n = "createfont" Then ApiBytes = 56
    If n = "createsolidbrush" Then ApiBytes = 4
    If n = "getsyscolor" Then ApiBytes = 4
    If n = "deleteobject" Then ApiBytes = 4
End Function

Sub EmitCallName(name As String)
    Dim b As Long
    Dim sym As String
    Dim n As String
    Dim apiName As String
    n = Lower$(name)

    ' ActiveBasic 邨・∩霎ｼ縺ｿ 竊・閾ｪ蜑・RT・・ernel32 縺ｫ辟｡縺・ｼ・
    If n = "makestr" Or n = "instr" Or n = "memcpy" Or n = "malloc" Or n = "free" Or n = "fillmemory" Then
        EnsureHostRt()
        If n = "makestr" Then
            EmitAsm("call _rt_MakeStr")
        ElseIf n = "instr" Then
            EmitAsm("call _rt_InStr")
        ElseIf n = "memcpy" Then
            EmitAsm("call _rt_Memcpy")
        ElseIf n = "fillmemory" Then
            EmitAsm("call _rt_FillMemory")
        ElseIf n = "malloc" Then
            EmitAsm("call _rt_Malloc")
        Else
            EmitAsm("call _rt_Free")
        End If
        Exit Sub
    End If

    ' ANSI API 蜷阪∈豁｣隕丞喧
    apiName = name
    If n = "getcommandline" Then apiName = "GetCommandLineA"
    If n = "lstrlen" Then apiName = "lstrlenA"
    If n = "lstrcpy" Then apiName = "lstrcpyA"
    If n = "lstrcat" Then apiName = "lstrcatA"
    If n = "lstrcmp" Then apiName = "lstrcmpA"
    If n = "createfile" Then apiName = "CreateFileA"
    If n = "getfileattributes" Then apiName = "GetFileAttributesA"
    If n = "messagebox" Then apiName = "MessageBoxA"
    If n = "getmodulefilename" Then apiName = "GetModuleFileNameA"
    If n = "deletefile" Then apiName = "DeleteFileA"
    If n = "createprocess" Then apiName = "CreateProcessA"
    If n = "getmodulehandle" Then apiName = "GetModuleHandleA"
    If n = "createwindowex" Then apiName = "CreateWindowExA"
    If n = "defwindowproc" Then apiName = "DefWindowProcA"
    If n = "sendmessage" Then apiName = "SendMessageA"
    If n = "loadicon" Then apiName = "LoadIconA"
    If n = "loadcursor" Then apiName = "LoadCursorA"
    If n = "registerclassex" Then apiName = "RegisterClassExA"
    If n = "postmessage" Then apiName = "PostMessageA"
    If n = "getmessage" Then apiName = "GetMessageA"
    If n = "dispatchmessage" Then apiName = "DispatchMessageA"
    If n = "createfont" Then apiName = "CreateFontA"

    b = ApiBytes(apiName)
    If b >= 0 Then
        sym = "_" + apiName + "@" + Trim$(Str$(b))
        If InStr(1, gApiExternLines, "extern " + sym + Chr$(13)) = 0 Then
            gApiExternLines = gApiExternLines + "extern " + sym + Chr$(13) + Chr$(10)
        End If
        EmitAsm("call " + sym)
    Else
        EmitAsm("call _" + name)
    End If
End Sub

Function AddVarEx(name As String, elemSize As Long, count As Long, isPtr As Long, isStr As Long) As Long
    Dim idx As Long
    Dim bytes As Long
    Dim isGlob As Long
    idx = FindVar(name)
    If idx >= 0 Then
        Print "duplicate Dim: " + name
        AddVarEx = -1
        Exit Function
    End If
    If gNVars >= MAX_VARS Then
        Print "too many variables"
        AddVarEx = -1
        Exit Function
    End If
    If isPtr <> 0 Then
        bytes = 4
    ElseIf isStr <> 0 Then
        bytes = 4 * count
    Else
        bytes = elemSize * count
    End If
    If bytes <= 0 Then
        Print "bad variable size"
        AddVarEx = -1
        Exit Function
    End If
    idx = gNVars
    gVarName(idx) = Lower$(name)
    If gInProc = 0 Then
        isGlob = 1
    Else
        isGlob = 0
    End If
    gVarIsGlobal(idx) = isGlob
    If isGlob <> 0 Then
        ' 繝｢繧ｸ繝･繝ｼ繝ｫ螟画焚縺ｯ .data・域焔邯壹″縺九ｉ ebp 逶ｸ蟇ｾ縺ｧ隗ｦ繧後↑縺・ｼ・
        gVarOff(idx) = 0
        SbAppendStr(VarPtr(gSbData), "    v_" + gVarName(idx) + ":")
        SbAppendCRLF(VarPtr(gSbData))
        SbAppendStr(VarPtr(gSbData), "    times " + Trim$(Str$(bytes)) + " db 0")
        SbAppendCRLF(VarPtr(gSbData))
    Else
        gFrameSize = gFrameSize + bytes
        gVarOff(idx) = -gFrameSize
    End If
    gVarSize(idx) = elemSize
    If isStr <> 0 Then gVarSize(idx) = 4
    If isPtr <> 0 Then gVarSize(idx) = elemSize
    gVarCount(idx) = count
    gVarIsPtr(idx) = isPtr
    gVarIsStr(idx) = isStr
    gVarIsByRef(idx) = 0
    gVarTypeIdx(idx) = -1
    gNVars = gNVars + 1
    AddVarEx = idx
End Function

Function AddVar(name As String) As Long
    AddVar = AddVarEx(name, 4, 1, 0, 0)
End Function

' ebx = 螟画焚繧ｹ繝ｭ繝・ヨ縺ｮ繧｢繝峨Ξ繧ｹ・・yRef 蠑墓焚縺ｪ繧峨せ繧ｿ繝・け荳翫・繝昴う繝ｳ繧ｿ閾ｪ菴薙・蝣ｴ謇・・
Sub EmitAddrVar(idx As Long)
    If gVarIsGlobal(idx) <> 0 Then
        EmitAsm("mov ebx, v_" + gVarName(idx))
    Else
        EmitAsm("mov ebx, ebp")
        EmitAsm("add ebx, " + Trim$(Str$(gVarOff(idx))))
    End If
End Sub

' ebx = 螳滉ｽ薙・繧｢繝峨Ξ繧ｹ・・yRef 縺ｪ繧峨せ繝ｭ繝・ヨ縺九ｉ繝昴う繝ｳ繧ｿ繧定ｪｭ繧・・
Sub EmitAddrOfVar(idx As Long)
    EmitAddrVar(idx)
    If gVarIsByRef(idx) <> 0 Then
        EmitAsm("mov ebx, " + Chr$(&H5B) + "ebx" + Chr$(&H5D))
    End If
End Sub

' 螟画焚繧・eax 縺ｸ繝ｭ繝ｼ繝・
Sub EmitLoadVar(idx As Long)
    EmitAddrOfVar(idx)
    If gVarIsPtr(idx) <> 0 Or gVarIsStr(idx) <> 0 Or gVarSize(idx) = 4 Then
        EmitAsm("mov eax, " + Chr$(&H5B) + "ebx" + Chr$(&H5D))
    ElseIf gVarSize(idx) = 1 Then
        EmitAsm("movzx eax, " + Chr$(&H5B) + "ebx" + Chr$(&H5D))
    ElseIf gVarSize(idx) = 2 Then
        EmitAsm("movzx eax, word " + Chr$(&H5B) + "ebx" + Chr$(&H5D))
    Else
        Print "unsupported load size"
        End
    End If
End Sub

Sub EmitStoreVar(idx As Long)
    EmitAddrOfVar(idx)
    If gVarIsPtr(idx) <> 0 Or gVarIsStr(idx) <> 0 Or gVarSize(idx) = 4 Then
        EmitAsm("mov " + Chr$(&H5B) + "ebx" + Chr$(&H5D) + ", eax")
    ElseIf gVarSize(idx) = 1 Then
        EmitAsm("mov " + Chr$(&H5B) + "ebx" + Chr$(&H5D) + ", al")
    ElseIf gVarSize(idx) = 2 Then
        EmitAsm("mov " + Chr$(&H5B) + "ebx" + Chr$(&H5D) + ", ax")
    Else
        Print "unsupported store size"
        End
    End If
End Sub

' eax = 豺ｻ蟄励Ｆbx = 隕∫ｴ繧｢繝峨Ξ繧ｹ縺ｫ縺吶ｋ・・enArith 繧貞他縺ｰ縺ｪ縺・ｼ・
Sub EmitScaleAddBase(idx As Long)
    If gVarIsPtr(idx) <> 0 Then
        EmitAsm("push eax")
        EmitLoadVar(idx)
        EmitAsm("mov ebx, eax")
        EmitAsm("pop eax")
        If gVarSize(idx) > 1 Then
            EmitAsm("mov ecx, " + Trim$(Str$(gVarSize(idx))))
            EmitAsm("imul eax, ecx")
        End If
        EmitAsm("add ebx, eax")
    Else
        If gVarCount(idx) <= 1 Then
            Print "not an array: " + gVarName(idx)
            End
        End If
        EmitAsm("push eax")
        EmitAddrVar(idx)
        EmitAsm("pop eax")
        If gVarSize(idx) > 1 Then
            EmitAsm("mov ecx, " + Trim$(Str$(gVarSize(idx))))
            EmitAsm("imul eax, ecx")
        End If
        EmitAsm("add ebx, eax")
    End If
End Sub

' 豺ｱ縺・縺ｮ2譁・ｭ玲ｼ皮ｮ怜ｭ撰ｼ亥承遶ｯ蜆ｪ蜈茨ｼ峨よ綾繧雁､縺ｯ 1-based 髢句ｧ倶ｽ咲ｽｮ
Function FindOp2(expr As String, op As String) As Long
    Dim n As Long
    Dim i As Long
    Dim depth As Long
    Dim inQ As Long
    Dim c As Long
    n = Len(expr)
    depth = 0
    inQ = 0
    FindOp2 = 0
    i = n
    While i >= 1
        c = Asc(Mid$(expr, i, 1))
        If inQ <> 0 Then
            If c = 34 Then inQ = 0
        ElseIf c = 34 Then
            inQ = 1
        ElseIf c = Asc(")") Then
            depth = depth + 1
        ElseIf c = Asc("(") Then
            depth = depth - 1
        ElseIf c = &H5D Then
            depth = depth + 1
        ElseIf c = &H5B Then
            depth = depth - 1
        ElseIf depth = 0 Then
            If i < n Then
                If Mid$(expr, i, 2) = op Then
                    FindOp2 = i
                    Exit Function
                End If
            End If
        End If
        i = i - 1
    Wend
End Function

' 豺ｱ縺・縺ｮ1譁・ｭ玲ｼ皮ｮ怜ｭ撰ｼ亥承遶ｯ蜆ｪ蜈茨ｼ峨ＱartOf2 縺碁團縺ｫ縺ゅｌ縺ｰ辟｡隕・
Function FindOp1(expr As String, ch As String) As Long
    Dim n As Long
    Dim i As Long
    Dim depth As Long
    Dim inQ As Long
    Dim c As Long
    Dim p As *Byte
    Dim oc As Long
    n = Len(expr)
    p = StrPtr(expr)
    oc = Asc(ch)
    depth = 0
    inQ = 0
    FindOp1 = 0
    i = n - 1
    While i >= 0
        c = p[i]
        If inQ <> 0 Then
            If c = 34 Then inQ = 0
        ElseIf c = 34 Then
            inQ = 1
        ElseIf c = Asc(")") Then
            depth = depth + 1
        ElseIf c = Asc("(") Then
            depth = depth - 1
        ElseIf c = &H5D Then
            depth = depth + 1
        ElseIf c = &H5B Then
            depth = depth - 1
        ElseIf depth = 0 And c = oc Then
            ' <> <= >= 縺ｮ荳驛ｨ繧帝勁螟・
            If ch = "=" Then
                If i > 0 And (p[i - 1] = Asc("<") Or p[i - 1] = Asc(">") Or p[i - 1] = Asc("=")) Then
                    ' skip
                Else
                    FindOp1 = i + 1
                    Exit Function
                End If
            ElseIf ch = "<" Then
                If i + 1 < n And (p[i + 1] = Asc("=") Or p[i + 1] = Asc(">")) Then
                    ' skip
                Else
                    FindOp1 = i + 1
                    Exit Function
                End If
            ElseIf ch = ">" Then
                If i + 1 < n And p[i + 1] = Asc("=") Then
                    ' skip
                Else
                    FindOp1 = i + 1
                    Exit Function
                End If
            Else
                FindOp1 = i + 1
                Exit Function
            End If
        End If
        i = i - 1
    Wend
End Function

' 譁・ｭ怜・繝ｪ繝・Λ繝ｫ・・..." 縺ｾ縺溘・ '...'・峨る比ｸｭ縺ｫ蜷後§蠑慕畑隨ｦ縺後≠繧後・髱槭Μ繝・Λ繝ｫ
Function IsStringLit(s As String) As Long
    Dim t As String
    Dim n As Long
    Dim p As *Byte
    Dim i As Long
    Dim q As Long
    t = Trim$(s)
    n = Len(t)
    IsStringLit = 0
    If n < 2 Then Exit Function
    p = StrPtr(t)
    If p[0] = 34 Or p[0] = Asc("'") Then
        q = p[0]
    Else
        Exit Function
    End If
    If p[n - 1] <> q Then Exit Function
    i = 1
    While i < n - 1
        If p[i] = q Then Exit Function
        i = i + 1
    Wend
    IsStringLit = 1
End Function

Function AddStringLit$(s As String) As String
    Dim t As String
    Dim label As String
    Dim lit As String
    Dim n As Long
    Dim i As Long
    Dim p As *Byte
    Dim outLine As String
    t = Trim$(s)
    label = "str_" + Trim$(Str$(gStrCount))
    n = Len(t) - 2
    If n <= 0 Then
        lit = ""
    Else
        lit = Mid$(t, 2, n)
    End If
    ' " 繧・\ 繧貞性繧縺ｨ db "..." 縺悟｣翫ｌ繧九・縺ｧ蟶ｸ縺ｫ謨ｰ蛟､繝舌う繝亥・縺ｧ蜃ｺ縺・
    outLine = "    " + label + " db "
    If Len(lit) = 0 Then
        outLine = outLine + "0"
    Else
        p = StrPtr(lit)
        i = 0
        While i < Len(lit)
            If i > 0 Then outLine = outLine + ", "
            outLine = outLine + Trim$(Str$(p[i]))
            i = i + 1
        Wend
        outLine = outLine + ", 0"
    End If
    SbAppendStr(VarPtr(gSbData), outLine)
    SbAppendCRLF(VarPtr(gSbData))
    gStrCount = gStrCount + 1
    AddStringLit$ = label
End Function

' 豺ｱ縺・縺ｮ蜊倩ｪ樊ｼ皮ｮ怜ｭ撰ｼ亥承遶ｯ蜆ｪ蜈茨ｼ・
Function FindOpWord(expr As String, word As String) As Long
    Dim e As String
    Dim w As String
    Dim n As Long
    Dim m As Long
    Dim i As Long
    Dim depth As Long
    Dim inQ As Long
    Dim c As Long
    Dim beforeOk As Long
    Dim afterOk As Long
    e = Lower$(expr)
    w = Lower$(word)
    n = Len(e)
    m = Len(w)
    FindOpWord = 0
    depth = 0
    inQ = 0
    i = n
    While i >= 1
        c = Asc(Mid$(e, i, 1))
        If inQ <> 0 Then
            If c = 34 Then inQ = 0
        ElseIf c = 34 Then
            inQ = 1
        ElseIf c = Asc(")") Or c = &H5D Then
            depth = depth + 1
        ElseIf c = Asc("(") Or c = &H5B Then
            depth = depth - 1
        ElseIf depth = 0 Then
            If i + m - 1 <= n Then
                If Mid$(e, i, m) = w Then
                    beforeOk = 1
                    afterOk = 1
                    If i > 1 Then
                        c = Asc(Mid$(e, i - 1, 1))
                        If IsIdentChar2(c) <> 0 Then beforeOk = 0
                    End If
                    If i + m <= n Then
                        c = Asc(Mid$(e, i + m, 1))
                        If IsIdentChar2(c) <> 0 Then afterOk = 0
                    End If
                    If beforeOk <> 0 And afterOk <> 0 Then
                        FindOpWord = i
                        Exit Function
                    End If
                End If
            End If
        End If
        i = i - 1
    Wend
End Function

Function IsStringExpr(expr As String) As Long
    Dim e As String
    Dim n As Long
    Dim p As *Byte
    Dim pos As Long
    Dim idx As Long
    Dim i As Long
    e = Trim$(expr)
    IsStringExpr = 0
    If IsStringLit(e) <> 0 Then
        IsStringExpr = 1
        Exit Function
    End If
    n = Len(e)
    If n >= 2 Then
        p = StrPtr(e)
        If p[0] = 40 And p[n - 1] = 41 Then
            IsStringExpr = IsStringExpr(Mid$(e, 2, n - 2))
            Exit Function
        End If
    End If
    pos = FindOp1(e, "+")
    If pos > 0 Then
        If IsStringExpr(Left$(e, pos - 1)) <> 0 Or IsStringExpr(Mid$(e, pos + 1, Len(e) - pos)) <> 0 Then
            IsStringExpr = 1
            Exit Function
        End If
    End If
    If Lower$(Left$(e, 5)) = "chr$(" Or Lower$(Left$(e, 6)) = "left$(" Or Lower$(Left$(e, 5)) = "mid$(" Or Lower$(Left$(e, 5)) = "str$(" Or Lower$(Left$(e, 5)) = "hex$(" Then
        IsStringExpr = 1
        Exit Function
    End If
    idx = FindVar(e)
    If idx >= 0 Then
        IsStringExpr = gVarIsStr(idx)
        Exit Function
    End If
    ' gArgs(i) 縺ｪ縺ｩ String 驟榊・隕∫ｴ
    p = StrPtr(e)
    i = 0
    While i < n
        If p[i] = 40 Or p[i] = &H5B Then
            idx = FindVar(Trim$(Left$(e, i)))
            If idx >= 0 Then
                IsStringExpr = gVarIsStr(idx)
            End If
            Exit Function
        End If
        i = i + 1
    Wend
End Function

Sub RtLine(line As String)
    SbAppendStr(VarPtr(gSbRt), line)
    SbAppendCRLF(VarPtr(gSbRt))
End Sub

