' abcGlobals.abp - abc の Const / Dim（結合時は Lexer/Emit より前に置く）

Const MAX_ARGS = 16
Const MAX_LINE = 512
Const MAX_VARS = 1024
Const MAX_CONSTS = 256
Const MAX_TYPES = 64
Const MAX_TYPEDEFS = 64
Const MAX_FIELDS = 256
Const MAX_APIS = 24
Const MAX_IF = 16
Const MAX_LOOP = 16
Const MAX_SELECT = 16
Const MAX_PROCS = 512
Const MAX_NAME_ARENA = 16384
' 文字コード定数は CharUtils.abp

Dim gArgs(MAX_ARGS - 1) As String
Dim gNArgs As Long
Dim gAsmArgs(MAX_ARGS - 1) As String
Dim gSbData As StringBuffer
Dim gSbText As StringBuffer
Dim gSbProc As StringBuffer
Dim gSbRt As StringBuffer
Dim gSbOut As StringBuffer
Dim gSbTmp As StringBuffer
Dim gSbSaved As StringBuffer
Dim gSbExpand As StringBuffer
' FindType / TypeSizeOf 用の正規化バッファ（Lower$ ヒープを避ける）
Dim gNormType[128] As Byte
Dim gNormTypeLen As Long
Dim gStrCount As Long
Dim gUseMsgBox As Long
Dim gEmittedExit As Long

Dim gVarName(MAX_VARS - 1) As String
Dim gVarOff(MAX_VARS - 1) As Long
Dim gVarSize(MAX_VARS - 1) As Long
Dim gVarCount(MAX_VARS - 1) As Long
Dim gVarIsPtr(MAX_VARS - 1) As Long
Dim gVarIsStr(MAX_VARS - 1) As Long
Dim gVarIsGlobal(MAX_VARS - 1) As Long
Dim gVarIsByRef(MAX_VARS - 1) As Long
Dim gVarTypeIdx(MAX_VARS - 1) As Long
Dim gNVars As Long
Dim gFrameSize As Long
Dim gLabelId As Long
Dim gIfElse(MAX_IF - 1) As String
Dim gIfEnd(MAX_IF - 1) As String
Dim gIfSp As Long

Dim gSelEnd(MAX_SELECT - 1) As String
Dim gSelNext(MAX_SELECT - 1) As String
Dim gSelStarted(MAX_SELECT - 1) As Long
Dim gSelSlotReady(MAX_SELECT - 1) As Long
Dim gSelSp As Long

Dim gConstName(MAX_CONSTS - 1) As String
Dim gConstVal(MAX_CONSTS - 1) As Long
Dim gNConsts As Long

Dim gLoopTop(MAX_LOOP - 1) As String
Dim gLoopCont(MAX_LOOP - 1) As String
Dim gLoopEnd(MAX_LOOP - 1) As String
Dim gLoopKind(MAX_LOOP - 1) As Long
Dim gForVar(MAX_LOOP - 1) As String
Dim gForStep(MAX_LOOP - 1) As String
Dim gLoopSp As Long

Dim gInProc As Long
Dim gProcName As String
Dim gProcIsFunc As Long
Dim gProcArgBytes As Long
Dim gRetOff As Long
Dim gSavedNVars As Long
Dim gSavedFrame As Long
Dim gSavedVarName(MAX_VARS - 1) As String
Dim gSavedVarOff(MAX_VARS - 1) As Long
Dim gSavedVarSize(MAX_VARS - 1) As Long
Dim gSavedVarCount(MAX_VARS - 1) As Long
Dim gSavedVarIsPtr(MAX_VARS - 1) As Long
Dim gSavedVarIsStr(MAX_VARS - 1) As Long
Dim gSavedVarIsGlobal(MAX_VARS - 1) As Long
Dim gSavedVarIsByRef(MAX_VARS - 1) As Long
Dim gUseStringRt As Long
Dim gUseHostRt As Long
Dim gUseInput As Long

' Sub/Function シグネチャ（ByRef 引数ビット。bit0 = 第1引数）
Dim gSigName(MAX_PROCS - 1) As String
Dim gSigByRef(MAX_PROCS - 1) As Long
Dim gNSigs As Long

' Phase 6: ユーザー定義 Type とフィールドのメタデータ
Dim gTypeSize(MAX_TYPES - 1) As Long
Dim gTypeFirstField(MAX_TYPES - 1) As Long
Dim gTypeLastField(MAX_TYPES - 1) As Long
Dim gNTypes As Long
' 型名は MakeStr せずバイトアリーナへ（Include/default のホットパス）
Dim gNameArena[MAX_NAME_ARENA] As Byte
Dim gNameArenaUsed As Long
Dim gTypeNameOff(MAX_TYPES - 1) As Long
Dim gTypeNameLen(MAX_TYPES - 1) As Long
Dim gTypeDefNameOff(MAX_TYPEDEFS - 1) As Long
Dim gTypeDefNameLen(MAX_TYPEDEFS - 1) As Long
Dim gTypeDefTargetOff(MAX_TYPEDEFS - 1) As Long
Dim gTypeDefTargetLen(MAX_TYPEDEFS - 1) As Long
Dim gNTypeDefs As Long
Dim gFieldType(MAX_FIELDS - 1) As Long
Dim gFieldNameOff(MAX_FIELDS - 1) As Long
Dim gFieldNameLen(MAX_FIELDS - 1) As Long
Dim gFieldOff(MAX_FIELDS - 1) As Long
Dim gFieldSize(MAX_FIELDS - 1) As Long
Dim gFieldCount(MAX_FIELDS - 1) As Long
Dim gFieldIsPtr(MAX_FIELDS - 1) As Long
Dim gFieldElemSize(MAX_FIELDS - 1) As Long
Dim gFieldNext(MAX_FIELDS - 1) As Long
Dim gNFields As Long
Dim gInType As Long
Dim gCurType As Long
' EmitMemberAddr / EmitMemberLValue が最後に解決したフィールド
Dim gLastFieldIdx As Long

' 既知 stdcall API の使用状況
Dim gApiUsed(MAX_APIS - 1) As Long
Dim gApiExternLines As String
Dim gIncludeStack(15) As String

Dim gExpandResult As String
Dim gCompileOk As Long
Dim gSrcLine As Long
Dim gSrcLineText As String
' EmitLValueAddr / メンバ代入用の最後の左辺値サイズ（バイト）
Dim gLValueSize As Long
