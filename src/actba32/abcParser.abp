' abcParser.abp - 構文解析（トークン → AST）

Const NK_NUM = 1
Const NK_IDENT = 2
Const NK_STR = 3
Const NK_BIN = 4
Const NK_UNARY = 5
Const NK_CALL = 6
Const NK_INDEX = 7
Const NK_MEMBER = 8
Const NK_VARPTR = 9
Const NK_SIZEOF = 10
Const NK_CMP = 11
Const NK_LOGOR = 12
Const NK_LOGAND = 13
Const NK_ARG = 14
Const NK_ADDRESSOF = 15

Const OP_ADD = 1
Const OP_SUB = 2
Const OP_MUL = 3
Const OP_DIV = 4
Const OP_MOD = 5
Const OP_AND = 6
Const OP_OR = 7
Const OP_XOR = 8
Const OP_NEG = 9
Const OP_EQ = 10
Const OP_NE = 11
Const OP_LT = 12
Const OP_GT = 13
Const OP_LE = 14
Const OP_GE = 15
Const OP_DOT = 16
Const OP_ARROW = 17

Function AstNew(kind As Long) As Long
    Dim ni As Long
    If gNAst >= MAX_AST Then
        Print "AST overflow"
        AstNew = -1
        Exit Function
    End If
    ni = gNAst
    gAst[ni].Kind = kind
    gAst[ni].Op = 0
    gAst[ni].A = AST_NIL
    gAst[ni].B = AST_NIL
    gAst[ni].C = AST_NIL
    gAst[ni].D = AST_NIL
    gAst[ni].IVal = 0
    gAst[ni].SIdx = -1
    gAst[ni].Flags = 0
    gNAst = gNAst + 1
    AstNew = ni
End Function

Function TokPeek() As Long
    If gTokPos >= gNTok Then
        TokPeek = TK_EOF
    Else
        TokPeek = gTok[gTokPos].Kind
    End If
End Function

Function TokTake() As Long
    Dim k As Long
    k = TokPeek()
    If gTokPos < gNTok Then gTokPos = gTokPos + 1
    TokTake = k
End Function

Function TokExpect(kind As Long) As Long
    Dim k As Long
    If TokPeek() <> kind Then
        TokExpect = 0
        Exit Function
    End If
    k = TokTake()
    TokExpect = 1
End Function

Function ParseExpr() As Long
    ParseExpr = ParseBitOr()
End Function

Function ParseCondExpr() As Long
    ParseCondExpr = ParseLogOr()
End Function

Function ParseLogOr() As Long
    Dim left As Long
    Dim right As Long
    Dim ni As Long
    Dim k As Long
    left = ParseLogAnd()
    If left < 0 Then
        ParseLogOr = -1
        Exit Function
    End If
    While TokPeek() = TK_OR
        k = TokTake()
        right = ParseLogAnd()
        If right < 0 Then
            ParseLogOr = -1
            Exit Function
        End If
        ni = AstNew(NK_LOGOR)
        If ni < 0 Then
            ParseLogOr = -1
            Exit Function
        End If
        gAst[ni].A = left
        gAst[ni].B = right
        left = ni
    Wend
    ParseLogOr = left
End Function

Function ParseLogAnd() As Long
    Dim left As Long
    Dim right As Long
    Dim ni As Long
    Dim k As Long
    left = ParseCmp()
    If left < 0 Then
        ParseLogAnd = -1
        Exit Function
    End If
    While TokPeek() = TK_AND
        k = TokTake()
        right = ParseCmp()
        If right < 0 Then
            ParseLogAnd = -1
            Exit Function
        End If
        ni = AstNew(NK_LOGAND)
        If ni < 0 Then
            ParseLogAnd = -1
            Exit Function
        End If
        gAst[ni].A = left
        gAst[ni].B = right
        left = ni
    Wend
    ParseLogAnd = left
End Function

Function ParseCmp() As Long
    Dim left As Long
    Dim right As Long
    Dim ni As Long
    Dim k As Long
    Dim op As Long
    left = ParseExprNoLog()
    If left < 0 Then
        ParseCmp = -1
        Exit Function
    End If
    k = TokPeek()
    op = 0
    If k = TK_EQ Then
        op = OP_EQ
    ElseIf k = TK_NE Then
        op = OP_NE
    ElseIf k = TK_LT Then
        op = OP_LT
    ElseIf k = TK_GT Then
        op = OP_GT
    ElseIf k = TK_LE Then
        op = OP_LE
    ElseIf k = TK_GE Then
        op = OP_GE
    End If
    If op = 0 Then
        ParseCmp = left
        Exit Function
    End If
    k = TokTake()
    right = ParseExprNoLog()
    If right < 0 Then
        ParseCmp = -1
        Exit Function
    End If
    ni = AstNew(NK_CMP)
    If ni < 0 Then
        ParseCmp = -1
        Exit Function
    End If
    gAst[ni].Op = op
    gAst[ni].A = left
    gAst[ni].B = right
    ParseCmp = ni
End Function

' 条件の比較オペランド用: And/Or は論理演算子として残す（ビット And に食わせない）
' Xor だけは値演算としてここで扱う
Function ParseExprNoLog() As Long
    Dim left As Long
    Dim right As Long
    Dim ni As Long
    Dim k As Long
    left = ParseAdd()
    If left < 0 Then
        ParseExprNoLog = -1
        Exit Function
    End If
    While TokPeek() = TK_XOR
        k = TokTake()
        right = ParseAdd()
        If right < 0 Then
            ParseExprNoLog = -1
            Exit Function
        End If
        ni = AstNew(NK_BIN)
        If ni < 0 Then
            ParseExprNoLog = -1
            Exit Function
        End If
        gAst[ni].Op = OP_XOR
        gAst[ni].A = left
        gAst[ni].B = right
        left = ni
    Wend
    ParseExprNoLog = left
End Function

Function ParseBitOr() As Long
    Dim left As Long
    Dim right As Long
    Dim ni As Long
    Dim k As Long
    left = ParseBitXor()
    If left < 0 Then
        ParseBitOr = -1
        Exit Function
    End If
    While TokPeek() = TK_OR
        k = TokTake()
        right = ParseBitXor()
        If right < 0 Then
            ParseBitOr = -1
            Exit Function
        End If
        ni = AstNew(NK_BIN)
        If ni < 0 Then
            ParseBitOr = -1
            Exit Function
        End If
        gAst[ni].Op = OP_OR
        gAst[ni].A = left
        gAst[ni].B = right
        left = ni
    Wend
    ParseBitOr = left
End Function

Function ParseBitXor() As Long
    Dim left As Long
    Dim right As Long
    Dim ni As Long
    Dim k As Long
    left = ParseBitAnd()
    If left < 0 Then
        ParseBitXor = -1
        Exit Function
    End If
    While TokPeek() = TK_XOR
        k = TokTake()
        right = ParseBitAnd()
        If right < 0 Then
            ParseBitXor = -1
            Exit Function
        End If
        ni = AstNew(NK_BIN)
        If ni < 0 Then
            ParseBitXor = -1
            Exit Function
        End If
        gAst[ni].Op = OP_XOR
        gAst[ni].A = left
        gAst[ni].B = right
        left = ni
    Wend
    ParseBitXor = left
End Function

Function ParseBitAnd() As Long
    Dim left As Long
    Dim right As Long
    Dim ni As Long
    Dim k As Long
    left = ParseAdd()
    If left < 0 Then
        ParseBitAnd = -1
        Exit Function
    End If
    While TokPeek() = TK_AND
        k = TokTake()
        right = ParseAdd()
        If right < 0 Then
            ParseBitAnd = -1
            Exit Function
        End If
        ni = AstNew(NK_BIN)
        If ni < 0 Then
            ParseBitAnd = -1
            Exit Function
        End If
        gAst[ni].Op = OP_AND
        gAst[ni].A = left
        gAst[ni].B = right
        left = ni
    Wend
    ParseBitAnd = left
End Function

Function ParseAdd() As Long
    Dim left As Long
    Dim right As Long
    Dim ni As Long
    Dim k As Long
    left = ParseMul()
    If left < 0 Then
        ParseAdd = -1
        Exit Function
    End If
    k = TokPeek()
    While k = TK_PLUS Or k = TK_MINUS
        k = TokTake()
        right = ParseMul()
        If right < 0 Then
            ParseAdd = -1
            Exit Function
        End If
        ni = AstNew(NK_BIN)
        If ni < 0 Then
            ParseAdd = -1
            Exit Function
        End If
        If k = TK_PLUS Then
            gAst[ni].Op = OP_ADD
        Else
            gAst[ni].Op = OP_SUB
        End If
        gAst[ni].A = left
        gAst[ni].B = right
        left = ni
        k = TokPeek()
    Wend
    ParseAdd = left
End Function

Function ParseMul() As Long
    Dim left As Long
    Dim right As Long
    Dim ni As Long
    Dim k As Long
    Dim op As Long
    left = ParseUnary()
    If left < 0 Then
        ParseMul = -1
        Exit Function
    End If
    k = TokPeek()
    While k = TK_STAR Or k = TK_BSLASH Or k = TK_SLASH Or k = TK_MOD
        k = TokTake()
        op = 0
        If k = TK_STAR Then
            op = OP_MUL
        ElseIf k = TK_BSLASH Or k = TK_SLASH Then
            op = OP_DIV
        ElseIf k = TK_MOD Then
            op = OP_MOD
        End If
        right = ParseUnary()
        If right < 0 Then
            ParseMul = -1
            Exit Function
        End If
        ni = AstNew(NK_BIN)
        If ni < 0 Then
            ParseMul = -1
            Exit Function
        End If
        gAst[ni].Op = op
        gAst[ni].A = left
        gAst[ni].B = right
        left = ni
        k = TokPeek()
    Wend
    ParseMul = left
End Function

Function ParseUnary() As Long
    Dim ni As Long
    Dim child As Long
    Dim k As Long
    ' 単独引数 GenArith("ByVal NULL") 用（Call 文の SplitArgs 経路）
    While TokPeek() = TK_BYVAL Or TokPeek() = TK_BYREF
        k = TokTake()
    Wend
    If TokPeek() = TK_MINUS Then
        k = TokTake()
        child = ParseUnary()
        If child < 0 Then
            ParseUnary = -1
            Exit Function
        End If
        ni = AstNew(NK_UNARY)
        If ni < 0 Then
            ParseUnary = -1
            Exit Function
        End If
        gAst[ni].Op = OP_NEG
        gAst[ni].A = child
        ParseUnary = ni
        Exit Function
    End If
    ParseUnary = ParsePostfix()
End Function

Function ParseArgList() As Long
    Dim head As Long
    Dim tail As Long
    Dim arg As Long
    Dim ni As Long
    Dim k As Long
    head = AST_NIL
    tail = AST_NIL
    If TokPeek() = TK_RPAREN Then
        ParseArgList = AST_NIL
        Exit Function
    End If
    While TokPeek() <> TK_EOF
        While TokPeek() = TK_BYVAL Or TokPeek() = TK_BYREF
            k = TokTake()
        Wend
        arg = ParseExpr()
        If arg < 0 Then
            ParseArgList = -2
            Exit Function
        End If
        ni = AstNew(NK_ARG)
        If ni < 0 Then
            ParseArgList = -2
            Exit Function
        End If
        gAst[ni].A = arg
        gAst[ni].B = AST_NIL
        If head = AST_NIL Then
            head = ni
            tail = ni
        Else
            gAst[tail].B = ni
            tail = ni
        End If
        If TokPeek() <> TK_COMMA Then Exit While
        k = TokTake()
    Wend
    ParseArgList = head
End Function

Function ParsePostfix() As Long
    Dim ni As Long
    Dim child As Long
    Dim idx As Long
    Dim args As Long
    Dim sIdx As Long
    Dim k As Long
    Dim fieldIdx As Long
    Dim opKind As Long

    If TokPeek() = TK_LPAREN Then
        k = TokTake()
        If gParseCondMode <> 0 Then
            child = ParseCondExpr()
        Else
            child = ParseExpr()
        End If
        If child < 0 Then
            ParsePostfix = -1
            Exit Function
        End If
        If TokExpect(TK_RPAREN) = 0 Then
            Print "expected )"
            ParsePostfix = -1
            Exit Function
        End If
        ParsePostfix = child
        Exit Function
    End If

    If TokPeek() = TK_NUM Or TokPeek() = TK_FLOAT Then
        ni = AstNew(NK_NUM)
        If ni < 0 Then
            ParsePostfix = -1
            Exit Function
        End If
        gAst[ni].IVal = gTok[gTokPos].IVal
        If TokPeek() = TK_FLOAT Then
            gAst[ni].Flags = 1
        End If
        k = TokTake()
        ParsePostfix = ni
        Exit Function
    End If

    If TokPeek() = TK_STR Then
        ni = AstNew(NK_STR)
        If ni < 0 Then
            ParsePostfix = -1
            Exit Function
        End If
        gAst[ni].SIdx = gTok[gTokPos].SIdx
        k = TokTake()
        ParsePostfix = ni
        Exit Function
    End If

    ' VarPtr(...) / AddressOf(...) / SizeOf(...)
    If TokPeek() = TK_VARPTR Then
        k = TokTake()
        If TokExpect(TK_LPAREN) = 0 Then
            Print "VarPtr needs ("
            ParsePostfix = -1
            Exit Function
        End If
        child = ParseExpr()
        If child < 0 Then
            ParsePostfix = -1
            Exit Function
        End If
        If TokExpect(TK_RPAREN) = 0 Then
            Print "VarPtr needs )"
            ParsePostfix = -1
            Exit Function
        End If
        ni = AstNew(NK_VARPTR)
        If ni < 0 Then
            ParsePostfix = -1
            Exit Function
        End If
        gAst[ni].A = child
        ParsePostfix = ni
        Exit Function
    End If

    If TokPeek() = TK_ADDRESSOF Then
        k = TokTake()
        If TokExpect(TK_LPAREN) = 0 Then
            Print "AddressOf needs ("
            ParsePostfix = -1
            Exit Function
        End If
        If TokPeek() <> TK_IDENT Then
            Print "AddressOf needs procedure name"
            ParsePostfix = -1
            Exit Function
        End If
        ni = AstNew(NK_ADDRESSOF)
        If ni < 0 Then
            ParsePostfix = -1
            Exit Function
        End If
        gAst[ni].SIdx = gTok[gTokPos].SIdx
        k = TokTake()
        If TokExpect(TK_RPAREN) = 0 Then
            Print "AddressOf needs )"
            ParsePostfix = -1
            Exit Function
        End If
        ParsePostfix = ni
        Exit Function
    End If

    If TokPeek() = TK_SIZEOF Then
        k = TokTake()
        If TokExpect(TK_LPAREN) = 0 Then
            Print "SizeOf needs ("
            ParsePostfix = -1
            Exit Function
        End If
        If TokPeek() <> TK_IDENT Then
            Print "SizeOf needs name"
            ParsePostfix = -1
            Exit Function
        End If
        ni = AstNew(NK_SIZEOF)
        If ni < 0 Then
            ParsePostfix = -1
            Exit Function
        End If
        gAst[ni].SIdx = gTok[gTokPos].SIdx
        k = TokTake()
        If TokExpect(TK_RPAREN) = 0 Then
            Print "SizeOf needs )"
            ParsePostfix = -1
            Exit Function
        End If
        ParsePostfix = ni
        Exit Function
    End If

    If TokPeek() <> TK_IDENT Then
        Print "expected expression"
        ParsePostfix = -1
        Exit Function
    End If

    sIdx = gTok[gTokPos].SIdx
    k = TokTake()

    ' 呼び出し / 添字 / メンバ
    ni = AstNew(NK_IDENT)
    If ni < 0 Then
        ParsePostfix = -1
        Exit Function
    End If
    gAst[ni].SIdx = sIdx

    k = TokPeek()
    While k = TK_LPAREN Or k = TK_LBRACK Or k = TK_DOT Or k = TK_ARROW
        If k = TK_LPAREN Then
            k = TokTake()
            args = ParseArgList()
            If args < -1 Then
                ParsePostfix = -1
                Exit Function
            End If
            If TokExpect(TK_RPAREN) = 0 Then
                Print "expected )"
                ParsePostfix = -1
                Exit Function
            End If
            child = AstNew(NK_CALL)
            If child < 0 Then
                ParsePostfix = -1
                Exit Function
            End If
            gAst[child].SIdx = gAst[ni].SIdx
            gAst[child].A = args
            ni = child
        ElseIf k = TK_LBRACK Then
            k = TokTake()
            idx = ParseExpr()
            If idx < 0 Then
                ParsePostfix = -1
                Exit Function
            End If
            If TokExpect(TK_RBRACK) = 0 Then
                Print "expected ]"
                ParsePostfix = -1
                Exit Function
            End If
            child = AstNew(NK_INDEX)
            If child < 0 Then
                ParsePostfix = -1
                Exit Function
            End If
            gAst[child].A = ni
            gAst[child].B = idx
            ni = child
        Else
            ' DOT or ARROW
            opKind = TokTake()
            If TokPeek() <> TK_IDENT Then
                Print "expected field name"
                ParsePostfix = -1
                Exit Function
            End If
            fieldIdx = gTok[gTokPos].SIdx
            k = TokTake()
            child = AstNew(NK_MEMBER)
            If child < 0 Then
                ParsePostfix = -1
                Exit Function
            End If
            If opKind = TK_ARROW Then
                gAst[child].Op = OP_ARROW
            Else
                gAst[child].Op = OP_DOT
            End If
            gAst[child].A = ni
            gAst[child].SIdx = fieldIdx
            ni = child
        End If
        k = TokPeek()
    Wend

    ' expr As Type / expr As *Type （値は変えず型だけ）
    If TokPeek() = TK_AS Then
        k = TokTake()
        If TokPeek() = TK_STAR Then
            k = TokTake()
        End If
        If TokPeek() <> TK_IDENT Then
            Print "expected type after As"
            ParsePostfix = -1
            Exit Function
        End If
        k = TokTake()
    End If

    ParsePostfix = ni
End Function
