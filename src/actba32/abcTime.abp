' abcTime.abp - コンパイル時間計測

Const ABC_TIME_DEBUG = 1


Function AbcTick() As Long
    AbcTick = GetTickCount()
End Function

Sub AbcTimePrint(name As String, t0 As Long, t1 As Long)
    Dim d As Long
    If ABC_TIME_DEBUG = 0 Then Exit Sub
    d = t1 - t0
    ' GetTickCount 折り返しは短時間計測では無視
    Print "time: " + name + "=" + Trim$(Str$(d)) + "ms"
End Sub

