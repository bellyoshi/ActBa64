' abcCompile.abp - 式・文のコンパイルと CompileBuffer

Function StripTypeCast$(expr As String) As String
    Dim t As String
    Dim low As String
    Dim n As Long
    Dim i As Long
    Dim depth As Long
    Dim inQ As Long
    Dim c As Long
    Dim p As *Byte
    Dim pos As Long
    Dim rest As String
    Dim r As String
    t = Trim$(expr)
    n = Len(t)
    StripTypeCast$ = t
    If n < 4 Then Exit Function
    low = Lower$(t)
    p = StrPtr(t)
    depth = 0
    inQ = 0
    pos = 0
    i = 0
    While i < n
        c = p[i]
        If inQ <> 0 Then
            If c = CH_DQUOTE Then inQ = 0
        ElseIf c = CH_DQUOTE Then
            inQ = 1
        ElseIf c = CH_LPAREN Or c = CH_LBRACK Then
            depth = depth + 1
        ElseIf c = CH_RPAREN Or c = CH_RBRACK Then
            depth = depth - 1
        ElseIf depth = 0 Then
            If i + 3 < n Then
                If Mid$(low, i + 1, 4) = " as " Then
                    rest = Trim$(Mid$(t, i + 5, n - i - 4))
                    r = rest
                    If Left$(r, 1) = "*" Then
                        r = Trim$(Mid$(r, 2, Len(r) - 1))
                    End If
                    If IsIdentName(r) <> 0 Then
                        pos = i + 1
                    End If
                End If
            End If
        End If
        i = i + 1
    Wend
    If pos > 0 Then
        StripTypeCast$ = Trim$(Left$(t, pos - 1))
    End If
End Function

' 算術式 → eax
Function GenArith(expr As String) As Long
    Dim ni As Long
    Dim e As String
    GenArith = 0
    gParseCondMode = 0
    e = StripTypeCast$(expr)
    If LexExpr(e) = 0 Then Exit Function
    ni = ParseExpr()
    If ni < 0 Then Exit Function
    If TokPeek() <> TK_EOF Then
        Print "junk after expression: " + expr
        Exit Function
    End If
    GenArith = EmitExpr(ni)
End Function

' 左辺値のアドレス → eax（ByRef 実引数用）
Function GenArithAddr(expr As String) As Long
    Dim ni As Long
    Dim e As String
    GenArithAddr = 0
    gParseCondMode = 0
    e = StripTypeCast$(expr)
    If LexExpr(e) = 0 Then Exit Function
    ni = ParseExpr()
    If ni < 0 Then Exit Function
    If TokPeek() <> TK_EOF Then
        Print "junk after expression: " + expr
        Exit Function
    End If
    GenArithAddr = EmitLValueAddr(ni)
End Function

Function GenCond(expr As String, falseLab As String) As Long
    Dim e As String
    Dim n As Long
    Dim p As *Byte
    Dim closePos As Long
    Dim ni As Long

    GenCond = 0
    e = Trim$(expr)

    ' 外側の (...) を剥がす（And/Or が括弧内だと見逃すため）
    n = Len(e)
    While n >= 2
        p = StrPtr(e)
        If p[0] <> CH_LPAREN Then Exit While
        closePos = MatchClose(p, n, 0)
        If closePos <> n - 1 Then Exit While
        e = Trim$(Mid$(e, 2, n - 2))
        n = Len(e)
    Wend

    gParseCondMode = 1
    If LexExpr(e) = 0 Then Exit Function
    ni = ParseCondExpr()
    If ni < 0 Then Exit Function
    If TokPeek() <> TK_EOF Then
        Print "junk after condition: " + e
        Exit Function
    End If
    GenCond = EmitCond(ni, falseLab)
End Function


' lineBuf[0..n) をその場でコメント除去＋Trim。結果の長さを n に返す（空なら 0）
Sub PrepSourceLine(p As *Byte, ByRef n As Long)
    Dim i As Long
    Dim j As Long
    Dim c As Long
    Dim inQ As Long
    Dim lo As Long
    Dim hi As Long

    If n <= 0 Then
        n = 0
        Exit Sub
    End If
    ' コメント除去（' 以降、文字列外）
    i = 0
    inQ = 0
    While i < n
        c = p[i]
        If inQ <> 0 Then
            If c = CH_DQUOTE Then inQ = 0
        Else
            If c = CH_DQUOTE Then
                inQ = 1
            ElseIf c = CH_SQUOTE Then
                n = i
                Exit While
            End If
        End If
        i = i + 1
    Wend
    ' Trim
    lo = 0
    While lo < n
        c = p[lo]
        If c <> CH_SP And c <> CH_TAB Then Exit While
        lo = lo + 1
    Wend
    If lo >= n Then
        n = 0
        p[0] = 0
        Exit Sub
    End If
    hi = n - 1
    While hi > lo
        c = p[hi]
        If c <> CH_SP And c <> CH_TAB Then Exit While
        hi = hi - 1
    Wend
    If lo > 0 Then
        j = 0
        i = lo
        While i <= hi
            p[j] = p[i]
            j = j + 1
            i = i + 1
        Wend
        n = j
    Else
        n = hi - lo + 1
    End If
    p[n] = 0
End Sub

' 文区切り ':'（左端優先）。文字列・()・[] の外のみ。戻り値は 1-based、無ければ 0
Function FindStmtColon(expr As String) As Long
    Dim n As Long
    Dim i As Long
    Dim depth As Long
    Dim inQ As Long
    Dim c As Long
    Dim p As *Byte

    n = Len(expr)
    p = StrPtr(expr)
    depth = 0
    inQ = 0
    FindStmtColon = 0
    i = 0
    While i < n
        c = p[i]
        If inQ <> 0 Then
            If c = CH_DQUOTE Then inQ = 0
        ElseIf c = CH_DQUOTE Then
            inQ = 1
        ElseIf c = CH_LPAREN Or c = CH_LBRACK Then
            depth = depth + 1
        ElseIf c = CH_RPAREN Or c = CH_RBRACK Then
            depth = depth - 1
        ElseIf depth = 0 And c = CH_COLON Then
            FindStmtColon = i + 1
            Exit Function
        End If
        i = i + 1
    Wend
End Function

Function StripComment$(s As String) As String
    Dim p As *Byte
    Dim i As Long
    Dim n As Long
    Dim inQ As Long
    Dim c As Long

    n = Len(s)
    If n = 0 Then
        StripComment$ = ""
        Exit Function
    End If
    p = StrPtr(s)
    i = 0
    inQ = 0
    While i < n
        c = p[i]
        If inQ <> 0 Then
            If c = CH_DQUOTE Then
                inQ = 0
            End If
        Else
            If c = CH_DQUOTE Then
                inQ = 1
            ElseIf c = CH_SQUOTE Then
                StripComment$ = Left$(s, i)
                Exit Function
            End If
        End If
        i = i + 1
    Wend
    StripComment$ = s
End Function

' カンマ区切り引数を分割（文字列・括弧ネスト内のカンマは無視）
Function SplitArgs(argsText As String) As Long
    Dim p As *Byte
    Dim n As Long
    Dim i As Long
    Dim start As Long
    Dim inQ As Long
    Dim quote As Long
    Dim depth As Long
    Dim c As Long

    SplitArgs = 0
    gNArgs = 0
    n = Len(argsText)
    If n = 0 Then
        SplitArgs = 1
        Exit Function
    End If

    p = StrPtr(argsText)
    i = 0
    start = 0
    inQ = 0
    quote = 0
    depth = 0

    While i < n
        c = p[i]
        If inQ <> 0 Then
            If c = quote Then
                inQ = 0
            End If
        Else
            If c = CH_DQUOTE Or c = CH_SQUOTE Then
                inQ = 1
                quote = c
            ElseIf c = CH_LPAREN Or c = CH_LBRACK Then
                depth = depth + 1
            ElseIf c = CH_RPAREN Or c = CH_RBRACK Then
                depth = depth - 1
            ElseIf c = CH_COMMA And depth = 0 Then
                If gNArgs >= MAX_ARGS Then
                    Print "error: too many arguments (max " + Trim$(Str$(MAX_ARGS)) + ")"
                    Exit Function
                End If
                gArgs(gNArgs) = Trim$(Mid$(argsText, start + 1, i - start))
                gNArgs = gNArgs + 1
                start = i + 1
            End If
        End If
        i = i + 1
    Wend

    If inQ <> 0 Then
        Print "error: unterminated string in arguments"
        Exit Function
    End If

    If gNArgs >= MAX_ARGS Then
        Print "error: too many arguments (max " + Trim$(Str$(MAX_ARGS)) + ")"
        Exit Function
    End If
    gArgs(gNArgs) = Trim$(Mid$(argsText, start + 1, n - start))
    gNArgs = gNArgs + 1
    SplitArgs = 1
End Function

' NULL / MB_OK -> 0、文字列 -> str_N、それ以外はそのまま
Function ArgToAsm$(arg As String) As String
    Dim t As String
    Dim label As String
    Dim lit As String
    Dim dq As String

    t = Trim$(arg)
    If IsStringLit(t) <> 0 Then
        label = AddStringLit$(t)
        ArgToAsm$ = label
    ElseIf t = "NULL" Or t = "MB_OK" Then
        ArgToAsm$ = "0"
    Else
        ArgToAsm$ = t
    End If
End Function

Function CompileMessageBox(lineStr As String) As Long
    Dim argsText As String
    Dim a As Long
    Dim lp As Long
    Dim rp As Long

    CompileMessageBox = 0
    lp = InStr(1, lineStr, "(")
    rp = 0
    a = Len(lineStr)
    While a >= 1
        If Mid$(lineStr, a, 1) = ")" Then
            rp = a
            Exit While
        End If
        a = a - 1
    Wend
    If lp = 0 Or rp = 0 Or rp <= lp Then
        Print "bad MessageBox syntax: " + lineStr
        Exit Function
    End If

    argsText = ArgsBetween$(lineStr, lp, rp)
    If SplitArgs(argsText) = 0 Then Exit Function
    If gNArgs <> 4 Then
        Print "MessageBox needs 4 arguments, got " + Str$(gNArgs)
        Exit Function
    End If

    For a = 0 To gNArgs - 1
        gAsmArgs(a) = ArgToAsm$(gArgs(a))
    Next

    ' stdcall: 右から左へ push
    a = gNArgs - 1
    While a >= 0
        EmitAsm("push    " + gAsmArgs(a))
        a = a - 1
    Wend
    EmitAsm("call    _MessageBoxA@16")
    SbAppendCRLF(VarPtr(gSbText))
    gUseMsgBox = 1
    CompileMessageBox = 1
End Function

Function CompilePrint(lineStr As String) As Long
    Dim e As String
    CompilePrint = 0
    e = Trim$(Mid$(lineStr, 6, Len(lineStr) - 5))
    If e = "" Then
        Print "Print needs expression"
        Exit Function
    End If
    EnsureStringRt()
    If IsStringExpr(e) <> 0 Then
        If GenArith(e) = 0 Then Exit Function
    Else
        If GenArith(e) = 0 Then Exit Function
        EmitAsm("push eax")
        EmitAsm("call _rt_Str")
    End If
    EmitAsm("push eax")
    EmitAsm("call _rt_Print")
    CompilePrint = 1
End Function

' Input var ― 1行読み取り。String ならそのまま、それ以外は Val して代入
Function CompileInput(lineStr As String) As Long
    Dim name As String
    Dim idx As Long
    CompileInput = 0
    name = Trim$(Mid$(lineStr, 6, Len(lineStr) - 5))
    If name = "" Then
        Print "Input needs variable"
        Exit Function
    End If
    idx = FindVar(name)
    If idx < 0 Then
        Print "undeclared variable: " + name
        Exit Function
    End If
    EnsureStringRt()
    gUseInput = 1
    EmitAsm("call _rt_Input")
    If gVarIsStr(idx) <> 0 Then
        EmitStoreVar(idx)
    Else
        EmitAsm("push eax")
        EmitAsm("call _rt_Val")
        EmitStoreVar(idx)
    End If
    CompileInput = 1
End Function

Function CompileExitProcess(lineStr As String) As Long
    Dim argsText As String
    Dim lp As Long
    Dim rp As Long
    Dim a As Long

    CompileExitProcess = 0
    lp = InStr(1, lineStr, "(")
    rp = 0
    a = Len(lineStr)
    While a >= 1
        If Mid$(lineStr, a, 1) = ")" Then
            rp = a
            Exit While
        End If
        a = a - 1
    Wend
    If lp = 0 Or rp = 0 Or rp <= lp Then
        Print "bad ExitProcess syntax: " + lineStr
        Exit Function
    End If

    argsText = ArgsBetween$(lineStr, lp, rp)
    If argsText = "" Then
        Print "ExitProcess needs 1 argument"
        Exit Function
    End If
    If GenArith(argsText) = 0 Then Exit Function
    EmitAsm("push eax")
    EmitCallName("ExitProcess")
    gEmittedExit = 1
    CompileExitProcess = 1
End Function

Function CompileConst(lineStr As String) As Long
    Dim rest As String
    Dim name As String
    Dim expr As String
    Dim pos As Long
    Dim ci As Long
    Dim v As Long
    CompileConst = 0
    rest = Trim$(Mid$(lineStr, 6, Len(lineStr) - 5))
    pos = FindOp1(rest, "=")
    If pos = 0 Then
        Print "Const needs =: " + lineStr
        Exit Function
    End If
    name = Trim$(Left$(rest, pos - 1))
    expr = Trim$(Mid$(rest, pos + 1, Len(rest) - pos))
    If IsNumStr(expr) <> 0 Then
        v = ParseNum(expr)
    ElseIf FindConst(expr) >= 0 Then
        v = gConstVal(FindConst(expr))
    ElseIf InStr(1, expr, "+") > 0 Or InStr(1, expr, "-") > 1 Or InStr(1, expr, "*") > 0 Or InStr(1, expr, "(") > 0 Then
        ' Const 式（MAX - 1 や (A+B)）。先頭の一元 '-' は IsNumStr 側
        v = ParseCountExpr(expr)
    Else
        Print "Const needs number or Const: " + lineStr
        Exit Function
    End If
    ci = FindConst(name)
    If ci >= 0 Then
        If gConstVal(ci) = v Then
            CompileConst = 1
            Exit Function
        End If
        Print "error: duplicate Const: " + name
        Print "  hint: already defined (often from Include/default); remove the duplicate"
        Exit Function
    End If
    If gNConsts >= MAX_CONSTS Then
        Print "error: too many Const (max " + Trim$(Str$(MAX_CONSTS)) + ")"
        Exit Function
    End If
    ci = gNConsts
    NormTypeName(name)
    gConstName(ci) = MakeStr(gNormType)
    gConstVal(ci) = v
    gNConsts = gNConsts + 1
    CompileConst = 1
End Function

Function CompileConstBytes(p As *Byte, n As Long) As Long
    Dim eq As Long
    Dim i As Long
    Dim ci As Long
    Dim v As Long
    Dim ok As Long
    Dim expr As String
    CompileConstBytes = 0
    ' "const " の後
    eq = -1
    i = 6
    While i < n
        If p[i] = CH_EQ Then
            eq = i
            Exit While
        End If
        i = i + 1
    Wend
    If eq < 0 Then
        Print "Const needs ="
        Exit Function
    End If
    NormTypeBytes(p, 6, eq - 6)
    If gNormTypeLen = 0 Then
        Print "Const needs name"
        Exit Function
    End If
    v = ParseNumBytes(p, eq + 1, n - eq - 1, ok)
    If ok = 0 Then
        expr = SliceToStr$(p, eq + 1, n - eq - 1)
        If FindConst(expr) >= 0 Then
            v = gConstVal(FindConst(expr))
        ElseIf InStr(1, expr, "+") > 0 Or InStr(1, expr, "-") > 1 Or InStr(1, expr, "*") > 0 Or InStr(1, expr, "(") > 0 Then
            v = ParseCountExpr(expr)
        Else
            Print "Const needs number or Const"
            Exit Function
        End If
    End If
    ci = FindConstNorm()
    If ci >= 0 Then
        If gConstVal(ci) = v Then
            CompileConstBytes = 1
            Exit Function
        End If
        Print "error: duplicate Const: " + MakeStr(gNormType)
        Exit Function
    End If
    If gNConsts >= MAX_CONSTS Then
        Print "error: too many Const"
        Exit Function
    End If
    ci = gNConsts
    gConstName(ci) = MakeStr(gNormType)
    gConstVal(ci) = v
    gNConsts = gNConsts + 1
    CompileConstBytes = 1
End Function

' 配列添字の定数式: 数値 / Const / + - * と括弧
Function ParseCountAtom(s As String) As Long
    Dim t As String
    Dim ci As Long
    Dim n As Long
    Dim inner As String
    t = Trim$(s)
    n = Len(t)
    ParseCountAtom = 0
    If n = 0 Then
        Print "bad array size: (empty)"
        Exit Function
    End If
    ' (expr)
    If Left$(t, 1) = "(" And Right$(t, 1) = ")" Then
        If MatchClose(StrPtr(t), n, 0) = n - 1 Then
            inner = Mid$(t, 2, n - 2)
            ParseCountAtom = ParseCountExpr(inner)
            Exit Function
        End If
    End If
    If IsNumStr(t) <> 0 Then
        ParseCountAtom = ParseNum(t)
        Exit Function
    End If
    ci = FindConst(t)
    If ci >= 0 Then
        ParseCountAtom = gConstVal(ci)
        Exit Function
    End If
    Print "bad array size: " + s
    ParseCountAtom = 0
End Function

Function ParseCountExpr(s As String) As Long
    Dim t As String
    Dim n As Long
    Dim i As Long
    Dim depth As Long
    Dim c As Long
    Dim p As *Byte
    Dim opPos As Long
    Dim op As String
    Dim leftV As Long
    Dim rightV As Long
    t = Trim$(s)
    n = Len(t)
    ParseCountExpr = 0
    If n = 0 Then
        Print "bad array size: (empty)"
        Exit Function
    End If

    ' 外側の (...) を剥がす
    While n >= 2
        p = StrPtr(t)
        If p[0] <> CH_LPAREN Then Exit While
        If MatchClose(p, n, 0) <> n - 1 Then Exit While
        t = Trim$(Mid$(t, 2, n - 2))
        n = Len(t)
    Wend

    ' 深さ0の + / -（右端優先。先頭の符号は無視）
    opPos = 0
    op = ""
    depth = 0
    p = StrPtr(t)
    i = n - 1
    While i >= 1
        c = p[i]
        If c = CH_RPAREN Then
            depth = depth + 1
        ElseIf c = CH_LPAREN Then
            depth = depth - 1
        ElseIf depth = 0 Then
            If c = CH_PLUS Or c = CH_MINUS Then
                opPos = i + 1
                op = Mid$(t, i + 1, 1)
                Exit While
            End If
        End If
        i = i - 1
    Wend
    If opPos > 0 Then
        leftV = ParseCountExpr(Left$(t, opPos - 1))
        rightV = ParseCountExpr(Mid$(t, opPos + 1, n - opPos))
        If op = "+" Then
            ParseCountExpr = leftV + rightV
        Else
            ParseCountExpr = leftV - rightV
        End If
        Exit Function
    End If

    ' 深さ0の *
    opPos = 0
    depth = 0
    i = n - 1
    While i >= 1
        c = p[i]
        If c = CH_RPAREN Then
            depth = depth + 1
        ElseIf c = CH_LPAREN Then
            depth = depth - 1
        ElseIf depth = 0 Then
            If c = CH_STAR Then
                opPos = i + 1
                Exit While
            End If
        End If
        i = i - 1
    Wend
    If opPos > 0 Then
        leftV = ParseCountExpr(Left$(t, opPos - 1))
        rightV = ParseCountExpr(Mid$(t, opPos + 1, n - opPos))
        ParseCountExpr = leftV * rightV
        Exit Function
    End If

    ParseCountExpr = ParseCountAtom(t)
End Function

' ホスト WinAPI ヘッダ相当（自己ホスト時）。ソース側では定義しない
' 名前は小文字で保持（FindConst が Lower$ 一回だけ行うため）
Sub InitBuiltinConsts()
    Dim ci As Long
    gNConsts = 0
    ci = 0
    gConstName(ci) = "max_path"
    gConstVal(ci) = 260
    ci = ci + 1
    gConstName(ci) = "null"
    gConstVal(ci) = 0
    ci = ci + 1
    gConstName(ci) = "invalid_handle_value"
    gConstVal(ci) = -1
    ci = ci + 1
    gConstName(ci) = "generic_read"
    gConstVal(ci) = &H80000000
    ci = ci + 1
    gConstName(ci) = "generic_write"
    ' &H40000000 直書きは SbAppendDec(旧 / Mod) で即値が壊れるので積で作る
    gConstVal(ci) = 1024
    gConstVal(ci) = gConstVal(ci) * 1024
    gConstVal(ci) = gConstVal(ci) * 1024
    ci = ci + 1
    gConstName(ci) = "file_share_read"
    gConstVal(ci) = 1
    ci = ci + 1
    gConstName(ci) = "open_existing"
    gConstVal(ci) = 3
    ci = ci + 1
    gConstName(ci) = "create_always"
    gConstVal(ci) = 2
    ci = ci + 1
    gConstName(ci) = "file_attribute_normal"
    gConstVal(ci) = 128
    ci = ci + 1
    gConstName(ci) = "infinite"
    gConstVal(ci) = -1
    ci = ci + 1
    gConstName(ci) = "mb_ok"
    gConstVal(ci) = 0
    ci = ci + 1
    gNConsts = ci
End Sub

Function CompileTypeStart(lineStr As String) As Long
    CompileTypeStart = CompileTypeStartBytes(StrPtr(lineStr), Len(lineStr))
End Function

Function CompileTypeStartBytes(p As *Byte, n As Long) As Long
    Dim i As Long
    Dim off As Long
    CompileTypeStartBytes = 0
    If IsIdentBytes(p, 5, n - 5) = 0 Then
        Print "bad Type"
        Exit Function
    End If
    NormTypeBytes(p, 5, n - 5)
    If FindTypeNorm() >= 0 Then
        gCurType = -2
        gInType = 1
        CompileTypeStartBytes = 1
        Exit Function
    End If
    If gNTypes >= MAX_TYPES Then
        Print "too many Type"
        Exit Function
    End If
    off = ArenaPutNorm()
    If off < 0 Then Exit Function
    gCurType = gNTypes
    gTypeNameOff(gCurType) = off
    gTypeNameLen(gCurType) = gNormTypeLen
    gTypeSize(gCurType) = 0
    gTypeFirstField(gCurType) = -1
    gTypeLastField(gCurType) = -1
    gNTypes = gNTypes + 1
    gInType = 1
    CompileTypeStartBytes = 1
End Function

Function CompileTypeField(lineStr As String) As Long
    CompileTypeField = CompileTypeFieldBytes(StrPtr(lineStr), Len(lineStr))
End Function

Function CompileTypeFieldBytes(p As *Byte, n As Long) As Long
    Dim pos As Long
    Dim i As Long
    Dim nameStart As Long
    Dim nameLen As Long
    Dim count As Long
    Dim lb As Long
    Dim sz As Long
    Dim off As Long
    Dim align As Long
    Dim fi As Long
    Dim isPtr As Long
    Dim ca As Long
    Dim cb As Long
    Dim nameOff As Long
    CompileTypeFieldBytes = 0
    If gCurType = -2 Then
        CompileTypeFieldBytes = 1
        Exit Function
    End If
    ' " as " をバイト検索
    pos = -1
    i = 0
    While i + 3 < n
        ca = p[i]
        ca = ToLowerChar(ca)
        If ca = CH_SP Then
            ca = p[i + 1]
            ca = ToLowerChar(ca)
            cb = p[i + 2]
            cb = ToLowerChar(cb)
            If ca = CH_LA And cb = CH_LS Then
                ca = p[i + 3]
                If ca = CH_SP Or ca = CH_TAB Then
                    pos = i
                    Exit While
                End If
            End If
        End If
        i = i + 1
    Wend
    If pos < 0 Then
        Print "Type field needs As"
        Exit Function
    End If
    count = 1
    nameStart = 0
    nameLen = pos
    ' As 直前の空白を除いた名前終端（Name(7)   As → ) を見る）
    nameLen = pos
    While nameLen > 0
        ca = p[nameLen - 1]
        If ca <> CH_SP And ca <> CH_TAB Then Exit While
        nameLen = nameLen - 1
    Wend
    lb = -1
    For i = 0 To nameLen - 1
        If p[i] = CH_LPAREN Or p[i] = CH_LBRACK Then
            lb = i
            Exit For
        End If
    Next
    If lb > 0 Then
        If (p[lb] = CH_LPAREN And p[nameLen - 1] <> CH_RPAREN) Or (p[lb] = CH_LBRACK And p[nameLen - 1] <> CH_RBRACK) Then
            Print "bad Type field array"
            Exit Function
        End If
        count = ParseCountExpr(SliceToStr$(p, lb + 1, nameLen - lb - 2)) + 1
        nameLen = lb
    End If
    If IsIdentBytes(p, nameStart, nameLen) = 0 Then
        Print "bad Type field"
        Exit Function
    End If
    NormTypeBytes(p, pos + 4, n - pos - 4)
    isPtr = 0
    ExpandTypeNameNorm(isPtr)
    sz = TypeSizeOfNorm()
    ' ポインタ: 格納は 4 バイト、添字時はポインティサイズ (sz)
    If isPtr <> 0 Then
        If sz = 0 Then sz = 1
        align = 4
    Else
        If sz = 0 Then
            Print "bad Type field"
            Exit Function
        End If
        align = sz
        If align > 4 Then align = 4
    End If
    If count <= 0 Or gNFields >= MAX_FIELDS Then
        Print "bad Type field"
        Exit Function
    End If
    off = gTypeSize(gCurType)
    While (off Mod align) <> 0
        off = off + 1
    Wend
    fi = gNFields
    gFieldType(fi) = FindTypeNorm()
    NormTypeBytes(p, nameStart, nameLen)
    nameOff = ArenaPutNorm()
    If nameOff < 0 Then Exit Function
    gFieldNameOff(fi) = nameOff
    gFieldNameLen(fi) = gNormTypeLen
    gFieldOff(fi) = off
    gFieldIsPtr(fi) = isPtr
    If isPtr <> 0 Then
        gFieldElemSize(fi) = sz
        gFieldSize(fi) = 4
    Else
        gFieldElemSize(fi) = sz
        gFieldSize(fi) = sz
    End If
    gFieldCount(fi) = count
    gFieldNext(fi) = -1
    If gTypeFirstField(gCurType) < 0 Then
        gTypeFirstField(gCurType) = fi
    Else
        gFieldNext(gTypeLastField(gCurType)) = fi
    End If
    gTypeLastField(gCurType) = fi
    gNFields = gNFields + 1
    gTypeSize(gCurType) = off + gFieldSize(fi) * count
    CompileTypeFieldBytes = 1
End Function

Function CompileTypeEnd() As Long
    CompileTypeEnd = 0
    If gInType = 0 Then
        Print "End Type without Type"
        Exit Function
    End If
    gInType = 0
    gCurType = -1
    CompileTypeEnd = 1
End Function

' 先頭のトップレベルカンマ位置（1始まり）。括弧・引用符内は無視
Function FindCommaTop(expr As String) As Long
    Dim n As Long
    Dim i As Long
    Dim depth As Long
    Dim inQ As Long
    Dim c As Long
    Dim p As *Byte
    n = Len(expr)
    p = StrPtr(expr)
    depth = 0
    inQ = 0
    FindCommaTop = 0
    For i = 0 To n - 1
        c = p[i]
        If inQ <> 0 Then
            If c = CH_DQUOTE Then inQ = 0
        ElseIf c = CH_DQUOTE Then
            inQ = 1
        ElseIf c = CH_LPAREN Or c = CH_LBRACK Then
            depth = depth + 1
        ElseIf c = CH_RPAREN Or c = CH_RBRACK Then
            depth = depth - 1
        ElseIf depth = 0 And c = CH_COMMA Then
            FindCommaTop = i + 1
            Exit Function
        End If
    Next
End Function

' 1 変数分: "name As T" / "name=expr As T" / "name As T = expr"
Function CompileOneDim(decl As String) As Long
    Dim name As String
    Dim typeName As String
    Dim pos As Long
    Dim i As Long
    Dim count As Long
    Dim elemSize As Long
    Dim isPtr As Long
    Dim isStr As Long
    Dim namePart As String
    Dim idxPart As String
    Dim p As *Byte
    Dim n As Long
    Dim lb As Long
    Dim typeIdx As Long
    Dim varIdx As Long
    Dim lab As String
    Dim lab2 As String
    Dim initExpr As String
    Dim eqPos As Long

    CompileOneDim = 0
    pos = InStr(1, Lower$(decl), " as ")
    If pos = 0 Then
        Print "Dim needs As: " + decl
        Exit Function
    End If
    namePart = Trim$(Left$(decl, pos - 1))
    typeName = Trim$(Mid$(decl, pos + 4, Len(decl) - pos - 3))
    initExpr = ""

    ' Dim name=expr As T  /  Dim name As T = expr
    eqPos = InStr(1, typeName, "=")
    If eqPos > 0 Then
        initExpr = Trim$(Mid$(typeName, eqPos + 1, Len(typeName) - eqPos))
        typeName = Trim$(Left$(typeName, eqPos - 1))
    Else
        eqPos = FindOp1(namePart, "=")
        If eqPos > 0 Then
            initExpr = Trim$(Mid$(namePart, eqPos + 1, Len(namePart) - eqPos))
            namePart = Trim$(Left$(namePart, eqPos - 1))
        End If
    End If

    isPtr = 0
    ExpandTypeName(typeName, isPtr)
    elemSize = TypeSizeOf(typeName)
    If elemSize = 0 Then
        Print "unknown type: " + typeName
        Exit Function
    End If

    count = 1
    name = namePart
    n = Len(namePart)
    p = StrPtr(namePart)
    lb = 0
    i = 0
    While i < n
        If p[i] = CH_LPAREN Or p[i] = CH_LBRACK Then
            lb = i + 1
            Exit While
        End If
        i = i + 1
    Wend
    If lb > 1 Then
        If (p[lb - 1] = CH_LPAREN And p[n - 1] = CH_RPAREN) Or (p[lb - 1] = CH_LBRACK And p[n - 1] = CH_RBRACK) Then
            name = Trim$(Left$(namePart, lb - 1))
            idxPart = Mid$(namePart, lb + 1, n - lb - 1)
            ' Dim a(N) → 添字 0..N（要素数 N+1）。VB/AB 互換
            count = ParseCountExpr(idxPart) + 1
            If count <= 0 Then Exit Function
            If isPtr <> 0 Then
                Print "pointer array not supported: " + decl
                Exit Function
            End If
            If initExpr <> "" Then
                Print "array Dim cannot have initializer: " + decl
                Exit Function
            End If
        Else
            Print "bad Dim name: " + decl
            Exit Function
        End If
    End If

    If FindVar(name) >= 0 Then
        Print "duplicate Dim: " + name
        Exit Function
    End If
    isStr = 0
    If Lower$(typeName) = "string" Then
        isStr = 1
    End If
    typeIdx = FindType(typeName)
    varIdx = AddVarEx(name, elemSize, count, isPtr, isStr)
    If varIdx < 0 Then Exit Function
    gVarTypeIdx(varIdx) = typeIdx
    ' ローカル String はスロットを先に 0 クリア（EmitStoreVar→StrFree がゴミを解放しないように）
    If isStr <> 0 And gVarIsGlobal(varIdx) = 0 And count = 1 Then
        EmitAsm("xor eax, eax")
        EmitAddrOfVar(varIdx)
        EmitAsmStoreEbx()
    End If
    If initExpr <> "" Then
        If GenArith(initExpr) = 0 Then Exit Function
        EmitStoreVar(FindVar(name))
    ElseIf isStr <> 0 Then
        EnsureStringRt()
        If count = 1 Then
            EmitAsm("push str_empty")
            EmitAsm("pop eax")
            EmitStoreVar(FindVar(name))
        ElseIf gVarIsGlobal(varIdx) = 0 Then
            EmitAddrVar(FindVar(name))
            EmitAsm("mov ecx, " + Trim$(Str$(count * 4)))
            EmitAsm("xor eax, eax")
            lab = NewLabel$()
            lab2 = NewLabel$()
            EmitLabel(lab)
            EmitAsm("cmp ecx, 0")
            EmitAsm("je " + lab2)
            EmitAsmStoreEbx()
            EmitAsm("add ebx, 4")
            EmitAsm("sub ecx, 4")
            EmitAsm2("jmp ", lab)
            EmitLabel(lab2)
        End If
    End If
    CompileOneDim = 1
End Function

Function CompileDim(lineStr As String) As Long
    Dim rest As String
    Dim piece As String
    Dim comPos As Long

    CompileDim = 0
    rest = Trim$(Mid$(lineStr, 4, Len(lineStr) - 3))
    If rest = "" Then
        Print "Dim needs As: " + lineStr
        Exit Function
    End If
    ' Dim a As T, b As U  … 複数宣言
    While rest <> ""
        comPos = FindCommaTop(rest)
        If comPos = 0 Then
            piece = Trim$(rest)
            rest = ""
        Else
            piece = Trim$(Left$(rest, comPos - 1))
            rest = Trim$(Mid$(rest, comPos + 1, Len(rest) - comPos))
        End If
        If piece = "" Then
            Print "bad Dim: " + lineStr
            Exit Function
        End If
        If CompileOneDim(piece) = 0 Then Exit Function
    Wend
    CompileDim = 1
End Function

Function CompileAssign(lineStr As String) As Long
    Dim pos As Long
    Dim name As String
    Dim expr As String
    Dim idx As Long
    Dim lhs As String
    Dim idxExpr As String
    Dim i As Long
    Dim n As Long
    Dim lb As Long
    Dim p As *Byte

    CompileAssign = 0
    pos = FindOp1(lineStr, "=")
    If pos = 0 Then
        Print "bad assignment: " + lineStr
        Exit Function
    End If
    lhs = Trim$(Left$(lineStr, pos - 1))
    expr = Trim$(Mid$(lineStr, pos + 1, Len(lineStr) - pos))

    ' Function 名への代入 = 戻り値
    ' Lower$(a)=Lower$(b) は String 戻りを誤ってポインタ比較することがあるため StrEqCI を使う
    If gInProc <> 0 And gProcIsFunc <> 0 Then
        If StrEqCI(lhs, gProcName) <> 0 Then
            If GenArith(expr) = 0 Then Exit Function
            EmitAsm("mov ebx, ebp")
            EmitAsmImm("add ebx, ", gRetOff)
            EmitAsmStoreEbx()
            CompileAssign = 1
            Exit Function
        End If
    End If

    ' 構造体メンバ代入（x.f / p->f / p[i].f）
    If InStr(1, lhs, ".") > 0 Or InStr(1, lhs, "->") > 0 Then
        If GenArith(expr) = 0 Then Exit Function
        EmitAsm("push eax")
        If GenArithAddr(lhs) = 0 Then
            Print "error: cannot assign to member: " + lhs
            Print "  hint: base must be Dim'd As a Type; for pointers use p->field or p[i].field"
            Exit Function
        End If
        EmitAsm("mov ebx, eax")
        EmitAsm("pop eax")
        EmitStoreSized(gLValueSize)
        CompileAssign = 1
        Exit Function
    End If

    ' 添字代入 a(i)= / a[i]= / p[i]=
    n = Len(lhs)
    p = StrPtr(lhs)
    lb = 0
    i = 0
    While i < n
        If p[i] = CH_LPAREN Or p[i] = CH_LBRACK Then
            lb = i + 1
            Exit While
        End If
        i = i + 1
    Wend
    If lb > 1 Then
        i = MatchClose(p, n, lb - 1)
        If i = n - 1 Then
            name = Trim$(Left$(lhs, lb - 1))
            idxExpr = Mid$(lhs, lb + 1, i - lb)
            idx = FindVar(name)
            If idx < 0 Then
                Print "undeclared variable: " + name
                Exit Function
            End If
            If GenArith(expr) = 0 Then Exit Function
            EmitAsm("push eax")
            If GenArith(idxExpr) = 0 Then Exit Function
            EmitScaleAddBase(idx)
            EmitAsm("pop eax")
            If gVarSize(idx) = 1 Then
                EmitAsmStoreEbxReg("al")
            ElseIf gVarSize(idx) = 2 Then
                EmitAsmStoreEbxReg("ax")
            Else
                EmitAsmStoreEbx()
            End If
            CompileAssign = 1
            Exit Function
        End If
    End If

    idx = FindVar(lhs)
    If idx < 0 Then
        Print "undeclared variable: " + lhs
        Exit Function
    End If
    If GenArith(expr) = 0 Then Exit Function
    EmitStoreVar(idx)
    CompileAssign = 1
End Function

Function CompileIfThen(lineStr As String) As Long
    Dim e As String
    Dim rest As String
    Dim labElse As String
    Dim labEnd As String
    Dim pos As Long
    Dim lowRest As String
    CompileIfThen = 0
    ' If <cond> Then [stmt]
    e = Trim$(Mid$(lineStr, 3, Len(lineStr) - 2))
    pos = InStr(1, Lower$(e), " then")
    If pos = 0 Then
        Print "If needs Then: " + lineStr
        Exit Function
    End If
    rest = Trim$(Mid$(e, pos + 5, Len(e) - pos - 4))
    e = Trim$(Left$(e, pos - 1))
    If gIfSp >= MAX_IF Then
        Print "If nesting too deep"
        Exit Function
    End If
    labElse = NewLabel$()
    labEnd = NewLabel$()
    gIfElse(gIfSp) = labElse
    gIfEnd(gIfSp) = labEnd
    gIfSp = gIfSp + 1
    If GenCond(e, labElse) = 0 Then Exit Function
    If rest <> "" Then
        lowRest = Lower$(rest)
        If lowRest = "exit function" Or lowRest = "exit sub" Then
            If CompileExitProc() = 0 Then Exit Function
        ElseIf lowRest = "exit while" Then
            If CompileExitWhile() = 0 Then Exit Function
        ElseIf lowRest = "exit do" Then
            If CompileExitDo() = 0 Then Exit Function
        ElseIf lowRest = "exit for" Then
            If CompileExitFor() = 0 Then Exit Function
        ElseIf StartsWith(rest, "ExitProcess(") <> 0 Then
            If CompileExitProcess(rest) = 0 Then Exit Function
        ElseIf StartsWith(rest, "MessageBox(") <> 0 Then
            If CompileMessageBox(rest) = 0 Then Exit Function
        ElseIf FindOp1(rest, "=") > 0 Then
            If CompileAssign(rest) = 0 Then Exit Function
        ElseIf InStr(1, rest, "(") > 1 Then
            If CompileCallStmt(rest) = 0 Then Exit Function
        Else
            Print "unsupported Then body: " + rest
            Exit Function
        End If
        If CompileEndIf() = 0 Then Exit Function
    End If
    CompileIfThen = 1
End Function

Function CompileElse() As Long
    Dim labElse As String
    Dim labEnd As String
    CompileElse = 0
    If gIfSp <= 0 Then
        Print "Else without If"
        Exit Function
    End If
    labElse = gIfElse(gIfSp - 1)
    labEnd = gIfEnd(gIfSp - 1)
    EmitAsm2("jmp ", labEnd)
    EmitLabel(labElse)
    gIfElse(gIfSp - 1) = ""
    CompileElse = 1
End Function

Function CompileElseIfThen(lineStr As String) As Long
    Dim e As String
    Dim rest As String
    Dim labElse As String
    Dim labEnd As String
    Dim pos As Long
    Dim lowRest As String
    CompileElseIfThen = 0
    If gIfSp <= 0 Then
        Print "ElseIf without If"
        Exit Function
    End If
    ' ElseIf <cond> Then [stmt]
    e = Trim$(Mid$(lineStr, 7, Len(lineStr) - 6))
    pos = InStr(1, Lower$(e), " then")
    If pos = 0 Then
        Print "ElseIf needs Then: " + lineStr
        Exit Function
    End If
    rest = Trim$(Mid$(e, pos + 5, Len(e) - pos - 4))
    e = Trim$(Left$(e, pos - 1))
    labElse = gIfElse(gIfSp - 1)
    labEnd = gIfEnd(gIfSp - 1)
    EmitAsm2("jmp ", labEnd)
    EmitLabel(labElse)
    labElse = NewLabel$()
    gIfElse(gIfSp - 1) = labElse
    If GenCond(e, labElse) = 0 Then Exit Function
    If rest <> "" Then
        lowRest = Lower$(rest)
        If lowRest = "exit function" Or lowRest = "exit sub" Then
            If CompileExitProc() = 0 Then Exit Function
        ElseIf lowRest = "exit while" Then
            If CompileExitWhile() = 0 Then Exit Function
        ElseIf lowRest = "exit do" Then
            If CompileExitDo() = 0 Then Exit Function
        ElseIf lowRest = "exit for" Then
            If CompileExitFor() = 0 Then Exit Function
        ElseIf StartsWith(rest, "ExitProcess(") <> 0 Then
            If CompileExitProcess(rest) = 0 Then Exit Function
        ElseIf FindOp1(rest, "=") > 0 Then
            If CompileAssign(rest) = 0 Then Exit Function
        ElseIf InStr(1, rest, "(") > 1 Then
            If CompileCallStmt(rest) = 0 Then Exit Function
        Else
            Print "unsupported ElseIf Then body: " + rest
            Exit Function
        End If
        If CompileEndIf() = 0 Then Exit Function
    End If
    CompileElseIfThen = 1
End Function

Function CompileEndIf() As Long
    Dim labElse As String
    Dim labEnd As String
    CompileEndIf = 0
    If gIfSp <= 0 Then
        Print "End If without If"
        Exit Function
    End If
    gIfSp = gIfSp - 1
    labElse = gIfElse(gIfSp)
    labEnd = gIfEnd(gIfSp)
    If labElse <> "" Then
        EmitLabel(labElse)
    End If
    EmitLabel(labEnd)
    CompileEndIf = 1
End Function

Sub EnsureSelectSlot(depth As Long)
    Dim lab As String
    If depth < 0 Or depth >= MAX_SELECT Then Exit Sub
    If gSelSlotReady(depth) <> 0 Then Exit Sub
    gSelSlotReady(depth) = 1
    lab = "v__sel" + Trim$(Str$(depth))
    SbAppendStr(VarPtr(gSbData), "    " + lab + ":")
    SbAppendCRLF(VarPtr(gSbData))
    SbAppendStr(VarPtr(gSbData), "    dd 0")
    SbAppendCRLF(VarPtr(gSbData))
End Sub

Function SelectSlotName$(depth As Long) As String
    SelectSlotName$ = "v__sel" + Trim$(Str$(depth))
End Function

Function CompileSelectCase(lineStr As String) As Long
    Dim e As String
    Dim labEnd As String
    Dim labNext As String
    Dim slot As String
    CompileSelectCase = 0
    e = Trim$(Mid$(lineStr, 12, Len(lineStr) - 11))
    If e = "" Then
        Print "Select Case needs expression"
        Exit Function
    End If
    If gSelSp >= MAX_SELECT Then
        Print "Select Case nesting too deep"
        Exit Function
    End If
    If GenArith(e) = 0 Then Exit Function
    EnsureSelectSlot(gSelSp)
    slot = SelectSlotName$(gSelSp)
    EmitAsm("mov ebx, " + slot)
    EmitAsmStoreEbx()
    labEnd = NewLabel$()
    labNext = NewLabel$()
    gSelEnd(gSelSp) = labEnd
    gSelNext(gSelSp) = labNext
    gSelStarted(gSelSp) = 0
    gSelSp = gSelSp + 1
    EmitAsm2("jmp ", labNext)
    CompileSelectCase = 1
End Function

Function CompileCase(lineStr As String) As Long
    Dim rest As String
    Dim lowRest As String
    Dim sp As Long
    Dim labNext As String
    Dim slot As String
    CompileCase = 0
    If gSelSp <= 0 Then
        Print "Case without Select Case"
        Exit Function
    End If
    sp = gSelSp - 1
    rest = Trim$(Mid$(lineStr, 5, Len(lineStr) - 4))
    lowRest = Lower$(rest)
    If gSelStarted(sp) <> 0 Then
        EmitAsm2("jmp ", gSelEnd(sp))
    End If
    EmitLabel(gSelNext(sp))
    labNext = NewLabel$()
    gSelNext(sp) = labNext
    gSelStarted(sp) = 1
    If lowRest = "else" Then
        CompileCase = 1
        Exit Function
    End If
    If GenArith(rest) = 0 Then Exit Function
    EmitAsm("mov ecx, eax")
    slot = SelectSlotName$(sp)
    EmitAsm("mov ebx, " + slot)
    EmitAsmLoadEbx()
    EmitAsm("cmp eax, ecx")
    EmitAsm("jne " + labNext)
    CompileCase = 1
End Function

Function CompileEndSelect() As Long
    Dim sp As Long
    CompileEndSelect = 0
    If gSelSp <= 0 Then
        Print "End Select without Select Case"
        Exit Function
    End If
    sp = gSelSp - 1
        EmitAsm2("jmp ", gSelEnd(sp))
    EmitLabel(gSelNext(sp))
    EmitLabel(gSelEnd(sp))
    gSelSp = sp
    CompileEndSelect = 1
End Function

Function CompileWhile(lineStr As String) As Long
    Dim e As String
    Dim labTop As String
    Dim labEnd As String
    CompileWhile = 0
    e = Trim$(Mid$(lineStr, 6, Len(lineStr) - 5))
    If e = "" Then
        Print "While needs condition"
        Exit Function
    End If
    If gLoopSp >= MAX_LOOP Then
        Print "loop nesting too deep"
        Exit Function
    End If
    labTop = NewLabel$()
    labEnd = NewLabel$()
    gLoopTop(gLoopSp) = labTop
    gLoopCont(gLoopSp) = labTop
    gLoopEnd(gLoopSp) = labEnd
    gLoopKind(gLoopSp) = 1
    gLoopSp = gLoopSp + 1
    EmitLabel(labTop)
    If GenCond(e, labEnd) = 0 Then Exit Function
    CompileWhile = 1
End Function

Function CompileWend() As Long
    CompileWend = 0
    If gLoopSp <= 0 Then
        Print "Wend without While"
        Exit Function
    End If
    If gLoopKind(gLoopSp - 1) <> 1 Then
        Print "Wend without While"
        Exit Function
    End If
    gLoopSp = gLoopSp - 1
    EmitAsm2("jmp ", gLoopTop(gLoopSp))
    EmitLabel(gLoopEnd(gLoopSp))
    CompileWend = 1
End Function

Function CompileExitWhile() As Long
    CompileExitWhile = 0
    If gLoopSp <= 0 Then
        Print "Exit While without While"
        Exit Function
    End If
    If gLoopKind(gLoopSp - 1) <> 1 Then
        Print "Exit While without While"
        Exit Function
    End If
    EmitAsm2("jmp ", gLoopEnd(gLoopSp - 1))
    CompileExitWhile = 1
End Function

' Do / Do While cond / Do Until cond
Function CompileDo(lineStr As String) As Long
    Dim rest As String
    Dim low As String
    Dim e As String
    Dim labTop As String
    Dim labBody As String
    Dim labEnd As String
    CompileDo = 0
    rest = Trim$(Mid$(lineStr, 3, Len(lineStr) - 2))
    low = Lower$(rest)
    If gLoopSp >= MAX_LOOP Then
        Print "loop nesting too deep"
        Exit Function
    End If
    labTop = NewLabel$()
    labEnd = NewLabel$()
    gLoopTop(gLoopSp) = labTop
    gLoopCont(gLoopSp) = labTop
    gLoopEnd(gLoopSp) = labEnd
    gLoopKind(gLoopSp) = 2
    gLoopSp = gLoopSp + 1
    EmitLabel(labTop)
    If rest = "" Then
        CompileDo = 1
        Exit Function
    End If
    If StartsWith(low, "while ") <> 0 Then
        e = Trim$(Mid$(rest, 7, Len(rest) - 6))
        If e = "" Then
            Print "Do While needs condition"
            Exit Function
        End If
        If GenCond(e, labEnd) = 0 Then Exit Function
        CompileDo = 1
        Exit Function
    End If
    If StartsWith(low, "until ") <> 0 Then
        e = Trim$(Mid$(rest, 7, Len(rest) - 6))
        If e = "" Then
            Print "Do Until needs condition"
            Exit Function
        End If
        ' 偽なら本体、真なら終了
        labBody = NewLabel$()
        If GenCond(e, labBody) = 0 Then Exit Function
        EmitAsm2("jmp ", labEnd)
        EmitLabel(labBody)
        CompileDo = 1
        Exit Function
    End If
    Print "bad Do: " + lineStr
End Function

Function CompileLoop(lineStr As String) As Long
    Dim rest As String
    Dim low As String
    Dim e As String
    Dim sp As Long
    Dim labTop As String
    Dim labEnd As String
    CompileLoop = 0
    If gLoopSp <= 0 Then
        Print "Loop without Do"
        Exit Function
    End If
    If gLoopKind(gLoopSp - 1) <> 2 Then
        Print "Loop without Do"
        Exit Function
    End If
    sp = gLoopSp - 1
    labTop = gLoopTop(sp)
    labEnd = gLoopEnd(sp)
    rest = Trim$(Mid$(lineStr, 5, Len(lineStr) - 4))
    low = Lower$(rest)
    If rest = "" Then
        EmitAsm2("jmp ", labTop)
        EmitLabel(labEnd)
        gLoopSp = sp
        CompileLoop = 1
        Exit Function
    End If
    If StartsWith(low, "while ") <> 0 Then
        e = Trim$(Mid$(rest, 7, Len(rest) - 6))
        If e = "" Then
            Print "Loop While needs condition"
            Exit Function
        End If
        If GenCond(e, labEnd) = 0 Then Exit Function
        EmitAsm2("jmp ", labTop)
        EmitLabel(labEnd)
        gLoopSp = sp
        CompileLoop = 1
        Exit Function
    End If
    If StartsWith(low, "until ") <> 0 Then
        e = Trim$(Mid$(rest, 7, Len(rest) - 6))
        If e = "" Then
            Print "Loop Until needs condition"
            Exit Function
        End If
        ' 真なら終了、偽なら先頭へ
        If GenCond(e, labTop) = 0 Then Exit Function
        EmitLabel(labEnd)
        gLoopSp = sp
        CompileLoop = 1
        Exit Function
    End If
    Print "bad Loop: " + lineStr
End Function

Function CompileExitDo() As Long
    CompileExitDo = 0
    If gLoopSp <= 0 Then
        Print "Exit Do without Do"
        Exit Function
    End If
    If gLoopKind(gLoopSp - 1) <> 2 Then
        Print "Exit Do without Do"
        Exit Function
    End If
    EmitAsm2("jmp ", gLoopEnd(gLoopSp - 1))
    CompileExitDo = 1
End Function

Function CompileFor(lineStr As String) As Long
    Dim rest As String
    Dim pos As Long
    Dim posTo As Long
    Dim posStep As Long
    Dim varName As String
    Dim exprFrom As String
    Dim exprTo As String
    Dim exprStep As String
    Dim idx As Long
    Dim labTop As String
    Dim labCont As String
    Dim labEnd As String

    CompileFor = 0
    rest = Trim$(Mid$(lineStr, 4, Len(lineStr) - 3))
    pos = FindOp1(rest, "=")
    If pos = 0 Then
        Print "For needs ="
        Exit Function
    End If
    varName = Trim$(Left$(rest, pos - 1))
    rest = Trim$(Mid$(rest, pos + 1, Len(rest) - pos))
    posTo = InStr(1, Lower$(rest), " to ")
    If posTo = 0 Then
        Print "For needs To"
        Exit Function
    End If
    exprFrom = Trim$(Left$(rest, posTo - 1))
    rest = Trim$(Mid$(rest, posTo + 4, Len(rest) - posTo - 3))
    posStep = InStr(1, Lower$(rest), " step ")
    If posStep > 0 Then
        exprTo = Trim$(Left$(rest, posStep - 1))
        exprStep = Trim$(Mid$(rest, posStep + 6, Len(rest) - posStep - 5))
    Else
        exprTo = rest
        exprStep = "1"
    End If

    idx = FindVar(varName)
    If idx < 0 Then
        Print "For variable undeclared: " + varName
        Exit Function
    End If
    If GenArith(exprFrom) = 0 Then Exit Function
    EmitStoreVar(idx)

    If gLoopSp >= MAX_LOOP Then
        Print "loop nesting too deep"
        Exit Function
    End If
    labTop = NewLabel$()
    labCont = NewLabel$()
    labEnd = NewLabel$()
    gLoopTop(gLoopSp) = labTop
    gLoopCont(gLoopSp) = labCont
    gLoopEnd(gLoopSp) = labEnd
    gLoopKind(gLoopSp) = 3
    gForVar(gLoopSp) = varName
    gForStep(gLoopSp) = exprStep
    gLoopSp = gLoopSp + 1

    EmitLabel(labTop)
    ' If var > to Then exit (Step>0 前提)
    EmitLoadVar(idx)
    EmitAsm("push eax")
    If GenArith(exprTo) = 0 Then Exit Function
    EmitAsm("pop ecx")
    EmitAsm("cmp ecx, eax")
    EmitAsm("jg " + labEnd)
    CompileFor = 1
End Function

Function CompileNext() As Long
    Dim sp As Long
    Dim idx As Long
    Dim varName As String
    Dim exprStep As String
    CompileNext = 0
    If gLoopSp <= 0 Then
        Print "Next without For"
        Exit Function
    End If
    If gLoopKind(gLoopSp - 1) <> 3 Then
        Print "Next without For"
        Exit Function
    End If
    sp = gLoopSp - 1
    varName = gForVar(sp)
    exprStep = gForStep(sp)
    idx = FindVar(varName)
    If idx < 0 Then
        Print "Next: bad variable"
        Exit Function
    End If
    EmitLabel(gLoopCont(sp))
    EmitLoadVar(idx)
    EmitAsm("push eax")
    If GenArith(exprStep) = 0 Then Exit Function
    EmitAsm("pop ecx")
    EmitAsm("add eax, ecx")
    EmitStoreVar(idx)
    EmitAsm2("jmp ", gLoopTop(sp))
    EmitLabel(gLoopEnd(sp))
    gLoopSp = sp
    CompileNext = 1
End Function

Function CompileExitFor() As Long
    CompileExitFor = 0
    If gLoopSp <= 0 Then
        Print "Exit For without For"
        Exit Function
    End If
    If gLoopKind(gLoopSp - 1) <> 3 Then
        Print "Exit For without For"
        Exit Function
    End If
    EmitAsm2("jmp ", gLoopEnd(gLoopSp - 1))
    CompileExitFor = 1
End Function

Sub SaveMainScope()
    Dim i As Long
    SbMove(VarPtr(gSbSaved), VarPtr(gSbText))
    gSavedNVars = gNVars
    gSavedFrame = gFrameSize
    If gNVars > 0 Then
        For i = 0 To gNVars - 1
            gSavedVarName(i) = gVarName(i)
            gSavedVarOff(i) = gVarOff(i)
            gSavedVarSize(i) = gVarSize(i)
            gSavedVarCount(i) = gVarCount(i)
            gSavedVarIsPtr(i) = gVarIsPtr(i)
            gSavedVarIsStr(i) = gVarIsStr(i)
            gSavedVarIsGlobal(i) = gVarIsGlobal(i)
            gSavedVarIsByRef(i) = gVarIsByRef(i)
        Next
    End If
End Sub

Sub RestoreMainScope()
    Dim i As Long
    SbMove(VarPtr(gSbText), VarPtr(gSbSaved))
    gNVars = gSavedNVars
    gFrameSize = gSavedFrame
    If gNVars > 0 Then
        For i = 0 To gNVars - 1
            gVarName(i) = gSavedVarName(i)
            gVarOff(i) = gSavedVarOff(i)
            gVarSize(i) = gSavedVarSize(i)
            gVarCount(i) = gSavedVarCount(i)
            gVarIsPtr(i) = gSavedVarIsPtr(i)
            gVarIsStr(i) = gSavedVarIsStr(i)
            gVarIsGlobal(i) = gSavedVarIsGlobal(i)
            gVarIsByRef(i) = gSavedVarIsByRef(i)
        Next
    End If
End Sub

Function AddArgVar(name As String, off As Long, elemSize As Long, isPtr As Long, isStr As Long, typeIdx As Long, isByRef As Long) As Long
    Dim idx As Long
    If gNVars >= MAX_VARS Then
        Print "too many variables"
        AddArgVar = -1
        Exit Function
    End If
    idx = gNVars
    gVarName(idx) = Lower$(name)
    gVarOff(idx) = off
    ' gVarSize は添字スケール / p[i] の要素サイズ。
    ' ポインタ引数はポインタ幅(4)ではなく指し先のサイズを保持する（AddVarEx と同じ）。
    gVarSize(idx) = elemSize
    If isStr <> 0 Then gVarSize(idx) = 4
    gVarCount(idx) = 1
    gVarIsPtr(idx) = isPtr
    gVarIsStr(idx) = isStr
    gVarIsGlobal(idx) = 0
    gVarIsByRef(idx) = isByRef
    gVarTypeIdx(idx) = typeIdx
    gNVars = gNVars + 1
    AddArgVar = idx
End Function

Function FindSig(name As String) As Long
    Dim i As Long
    Dim n As String
    n = Lower$(name)
    FindSig = -1
    If gNSigs <= 0 Then Exit Function
    For i = 0 To gNSigs - 1
        If gSigName(i) = n Then
            FindSig = i
            Exit Function
        End If
    Next
End Function

Function SigArgByRef(si As Long, argIndex As Long) As Long
    Dim bit As Long
    Dim k As Long
    Dim masked As Long
    SigArgByRef = 0
    If si < 0 Or argIndex < 0 Then Exit Function
    bit = 1
    k = 0
    While k < argIndex
        bit = bit * 2
        k = k + 1
    Wend
    ' If 条件内の And は論理 And になるので、ビット積は代入で行う
    masked = gSigByRef(si) And bit
    If masked <> 0 Then SigArgByRef = 1
End Function

Sub RegisterSig(name As String, byRefBits As Long)
    Dim i As Long
    Dim n As String
    n = Lower$(name)
    i = FindSig(n)
    If i >= 0 Then
        gSigByRef(i) = byRefBits
        Exit Sub
    End If
    If gNSigs >= MAX_PROCS Then
        Print "too many procedures"
        Exit Sub
    End If
    gSigName(gNSigs) = n
    gSigByRef(gNSigs) = byRefBits
    gNSigs = gNSigs + 1
End Sub

Function CompileProcHeader(lineStr As String, isFunc As Long) As Long
    Dim low As String
    Dim rest As String
    Dim name As String
    Dim argsText As String
    Dim lp As Long
    Dim rp As Long
    Dim a As Long
    Dim arg As String
    Dim pos As Long
    Dim argOff As Long
    Dim i As Long
    Dim argIsStr As Long
    Dim argIsPtr As Long
    Dim argIsByRef As Long
    Dim argType As String
    Dim argElem As Long
    Dim argTypeIdx As Long
    Dim byRefBits As Long
    Dim bit As Long

    CompileProcHeader = 0
    If gInProc <> 0 Then
        Print "nested Sub/Function not allowed"
        Exit Function
    End If
    If gIfSp <> 0 Or gLoopSp <> 0 Then
        Print "Sub/Function inside If/loop not allowed"
        Exit Function
    End If

    low = Lower$(lineStr)
    If isFunc <> 0 Then
        rest = Trim$(Mid$(lineStr, 9, Len(lineStr) - 8))
    Else
        rest = Trim$(Mid$(lineStr, 4, Len(lineStr) - 3))
    End If

    lp = InStr(1, rest, "(")
    If lp = 0 Then
        Print "Sub/Function needs ()"
        Exit Function
    End If
    name = Trim$(Left$(rest, lp - 1))
    rp = 0
    a = Len(rest)
    While a >= 1
        If Mid$(rest, a, 1) = ")" Then
            rp = a
            Exit While
        End If
        a = a - 1
    Wend
    If rp = 0 Or rp <= lp Then
        Print "bad Sub/Function header"
        Exit Function
    End If
    argsText = ArgsBetween$(rest, lp, rp)

    SaveMainScope()
    ' グローバルは残す。ローカルだけフレームを新規に
    gFrameSize = 0
    gInProc = 1
    gProcName = name
    gProcIsFunc = isFunc
    gProcArgBytes = 0
    gRetOff = 0
    byRefBits = 0

    If isFunc <> 0 Then
        ' 戻り値スロット
        gFrameSize = 4
        gRetOff = -4
    End If

    If argsText <> "" Then
        If SplitArgs(argsText) = 0 Then Exit Function
        argOff = 8
        bit = 1
        For i = 0 To gNArgs - 1
            arg = Trim$(gArgs(i))
            argIsByRef = 0
            ' ByRef/ByVal を除去（ByRef はポインタ渡しとして記録）
            If StartsWith(Lower$(arg), "byref ") <> 0 Then
                argIsByRef = 1
                arg = Trim$(Mid$(arg, 7, Len(arg) - 6))
            ElseIf StartsWith(Lower$(arg), "byval ") <> 0 Then
                arg = Trim$(Mid$(arg, 7, Len(arg) - 6))
            End If
            pos = InStr(1, Lower$(arg), " as ")
            argIsStr = 0
            argIsPtr = 0
            argElem = 4
            argTypeIdx = -1
            If pos > 0 Then
                argType = Trim$(Mid$(arg, pos + 4, Len(arg) - pos - 3))
                ExpandTypeName(argType, argIsPtr)
                If Lower$(argType) = "string" Then argIsStr = 1
                argElem = TypeSizeOf(argType)
                If argElem <= 0 Then argElem = 4
                argTypeIdx = FindType(argType)
                arg = Trim$(Left$(arg, pos - 1))
            End If
            If AddArgVar(arg, argOff, argElem, argIsPtr, argIsStr, argTypeIdx, argIsByRef) < 0 Then Exit Function
            If argIsByRef <> 0 Then byRefBits = byRefBits Or bit
            bit = bit * 2
            argOff = argOff + 4
            gProcArgBytes = gProcArgBytes + 4
        Next
    End If

    RegisterSig(name, byRefBits)
    CompileProcHeader = 1
End Function

Function CompileEndProc() As Long
    CompileEndProc = 0
    If gInProc = 0 Then
        Print "End Sub/Function without header"
        Exit Function
    End If
    If gIfSp <> 0 Or gLoopSp <> 0 Then
        Print "unclosed If/loop in procedure"
        Exit Function
    End If

    SbMove(VarPtr(gSbTmp), VarPtr(gSbText))
    EmitAsm("push ebp")
    EmitAsm("mov ebp, esp")
    If gFrameSize > 0 Then
        EmitAsm("sub esp, " + Trim$(Str$(gFrameSize)))
    End If
    SbAppendSb(VarPtr(gSbText), VarPtr(gSbTmp))
    SbClear(VarPtr(gSbTmp))

    If gProcIsFunc <> 0 Then
        EmitAsm("mov ebx, ebp")
        EmitAsmImm("add ebx, ", gRetOff)
        EmitAsmLoadEbx()
    End If
    EmitAsm("mov esp, ebp")
    EmitAsm("pop ebp")
    If gProcArgBytes > 0 Then
        EmitAsm("ret " + Trim$(Str$(gProcArgBytes)))
    Else
        EmitAsm("ret")
    End If

    SbAppendStr(VarPtr(gSbProc), "_" + gProcName + ":")
    SbAppendCRLF(VarPtr(gSbProc))
    SbAppendSb(VarPtr(gSbProc), VarPtr(gSbText))
    SbAppendCRLF(VarPtr(gSbProc))
    SbClear(VarPtr(gSbText))

    gInProc = 0
    gProcName = ""
    gProcIsFunc = 0
    RestoreMainScope()
    CompileEndProc = 1
End Function

Function CompileExitProc() As Long
    CompileExitProc = 0
    If gInProc = 0 Then
        Print "Exit Sub/Function outside procedure"
        Exit Function
    End If
    If gProcIsFunc <> 0 Then
        EmitAsm("mov ebx, ebp")
        EmitAsmImm("add ebx, ", gRetOff)
        EmitAsmLoadEbx()
    End If
    EmitAsm("mov esp, ebp")
    EmitAsm("pop ebp")
    If gProcArgBytes > 0 Then
        EmitAsm("ret " + Trim$(Str$(gProcArgBytes)))
    Else
        EmitAsm("ret")
    End If
    CompileExitProc = 1
End Function

Function CompileCallStmt(lineStr As String) As Long
    Dim lp As Long
    Dim rp As Long
    Dim a As Long
    Dim name As String
    Dim argsText As String
    Dim i As Long
    Dim si As Long

    CompileCallStmt = 0
    lp = InStr(1, lineStr, "(")
    If lp <= 1 Then Exit Function
    name = Trim$(Left$(lineStr, lp - 1))
    If Lower$(name) = "if" Or Lower$(name) = "while" Or Lower$(name) = "for" Then Exit Function

    rp = 0
    a = Len(lineStr)
    While a >= 1
        If Mid$(lineStr, a, 1) = ")" Then
            rp = a
            Exit While
        End If
        a = a - 1
    Wend
    If rp = 0 Or rp <= lp Then
        Print "bad call: " + lineStr
        Exit Function
    End If
    argsText = ArgsBetween$(lineStr, lp, rp)

    If argsText = "" Then
        gNArgs = 0
    Else
        If SplitArgs(argsText) = 0 Then Exit Function
    End If

    si = FindSig(name)
    ' stdcall: 右から push（Step -1 の For は生成コードが怪しいので While を使う）
    If gNArgs > 0 Then
        i = gNArgs - 1
        While i >= 0
            If SigArgByRef(si, i) <> 0 Then
                If GenArithAddr(gArgs(i)) = 0 Then Exit Function
            Else
                If GenArith(gArgs(i)) = 0 Then Exit Function
            End If
            EmitAsm("push eax")
            i = i - 1
        Wend
    End If
    EmitCallName(name)
    CompileCallStmt = 1
End Function

' 行頭（空白除去後）が #include か。MakeStr/Lower$ なしの高速判定
Function LineIsIncludeDir(p As *Byte, n As Long) As Long
    Dim i As Long
    Dim c As Long
    LineIsIncludeDir = 0
    i = 0
    While i < n
        c = p[i]
        If c <> CH_SP And c <> CH_TAB Then Exit While
        i = i + 1
    Wend
    If i >= n Then Exit Function
    c = p[i]
    ' 行コメント
    If c = CH_SQUOTE Then Exit Function
    If c <> CH_HASH Then Exit Function
    i = i + 1
    If i + 7 > n Then Exit Function
    ' include（大文字小文字無視）
    c = p[i]
    c = ToLowerChar(c)
    If c <> CH_LI Then Exit Function
    c = p[i + 1]
    c = ToLowerChar(c)
    If c <> CH_LN Then Exit Function
    c = p[i + 2]
    c = ToLowerChar(c)
    If c <> CH_LC Then Exit Function
    c = p[i + 3]
    c = ToLowerChar(c)
    If c <> CH_LL Then Exit Function
    c = p[i + 4]
    c = ToLowerChar(c)
    If c <> CH_LU Then Exit Function
    c = p[i + 5]
    c = ToLowerChar(c)
    If c <> CH_LD Then Exit Function
    c = p[i + 6]
    c = ToLowerChar(c)
    If c <> CH_LE Then Exit Function
    LineIsIncludeDir = 1
End Function

' dst に展開結果を追記（呼び出し側で SbClear/SbInit 済み想定）。成功=1 / 失敗=0（失敗時 dst を空）
Function ExpandIncludesInto(dst As *StringBuffer, src As *Byte, srcSize As Long, currentFile As String, depth As Long) As Long
    Dim i As Long
    Dim start As Long
    Dim c As Long
    Dim n As Long
    Dim lineBuf[MAX_LINE] As Byte
    Dim lineStr As String
    Dim q1 As Long
    Dim q2 As Long
    Dim inc As String
    Dim full As String
    Dim child As *Byte
    Dim childSize As Long
    Dim j As Long
    Dim childSb As StringBuffer

    ExpandIncludesInto = 0
    If depth >= 16 Then
        Print "#include nesting/cycle too deep"
        SbClear(dst)
        Exit Function
    End If
    i = 0
    While i < srcSize
        start = i
        While i < srcSize
            c = src[i]
            If c = CH_NL Or c = CH_CR Then Exit While
            i = i + 1
        Wend
        n = i - start
        If n >= MAX_LINE Then n = MAX_LINE - 1
        If n > 0 Then memcpy(lineBuf, VarPtr(src[start]), n)
        lineBuf[n] = 0
        If LineIsIncludeDir(lineBuf, n) <> 0 Then
            lineStr = MakeStr(lineBuf)
            q1 = InStr(1, lineStr, Chr$(CH_DQUOTE))
            q2 = 0
            If q1 > 0 Then q2 = InStr(q1 + 1, lineStr, Chr$(CH_DQUOTE))
            If q1 = 0 Or q2 <= q1 Then
                Print "bad #include: " + lineStr
                SbClear(dst)
                Exit Function
            End If
            inc = Mid$(lineStr, q1 + 1, q2 - q1 - 1)
            full = inc
            If InStr(1, inc, ":") = 0 And Left$(inc, 1) <> "\" And Left$(inc, 1) <> "/" Then
                full = DirOf$(currentFile) + inc
            End If
            For j = 0 To depth - 1
                If Lower$(gIncludeStack(j)) = Lower$(full) Then
                    Print "#include cycle: " + full
                    SbClear(dst)
                    Exit Function
                End If
            Next
            LoadFileToGlobal(StrPtr(full))
            child = gLoadPtr
            childSize = gLastLoadSize
            If child = NULL Then
                Print "cannot include: " + full
                SbClear(dst)
                Exit Function
            End If
            gIncludeStack(depth) = full
            SbInit(VarPtr(childSb))
            If ExpandIncludesInto(VarPtr(childSb), child, childSize, full, depth + 1) = 0 Then
                free(child)
                SbFree(VarPtr(childSb))
                SbClear(dst)
                Exit Function
            End If
            free(child)
            SbAppendSb(dst, VarPtr(childSb))
            SbFree(VarPtr(childSb))
        Else
            ' 非 #include 行はバイト列をそのまま追記（MakeStr 不要）
            If n > 0 Then SbAppendBytes(dst, lineBuf, n)
            SbAppendCRLF(dst)
        End If
        If i < srcSize And src[i] = CH_CR Then i = i + 1
        If i < srcSize And src[i] = CH_NL Then i = i + 1
    Wend
    ExpandIncludesInto = 1
End Function

Sub ExpandIncludesSub(src As *Byte, srcSize As Long, currentFile As String, depth As Long)
    SbClear(VarPtr(gSbExpand))
    If ExpandIncludesInto(VarPtr(gSbExpand), src, srcSize, currentFile, depth) = 0 Then
        SbClear(VarPtr(gSbExpand))
        gExpandResult = ""
        Exit Sub
    End If
    ' 本体は gSbExpand。gExpandResult は ExpandIncludes$ 用に遅延
    gExpandResult = ""
End Sub

Function ExpandIncludes$(src As *Byte, srcSize As Long, currentFile As String, depth As Long) As String
    ExpandIncludesSub(src, srcSize, currentFile, depth)
    gExpandResult = SbToString$(VarPtr(gSbExpand))
    ExpandIncludes$ = gExpandResult
End Function

' src\Include。exe 隣 / 3 階層上まで / カレント
Function IncludeFind$(rel As String) As String
    Dim buf[MAX_PATH] As Byte
    Dim s As String
    Dim i As Long
    Dim n As Long
    Dim ch As String
    Dim slashPos As Long
    Dim dir As String
    Dim p As String

    IncludeFind$ = ""
    GetModuleFileName(NULL, buf, MAX_PATH)
    s = MakeStr(buf)
    n = Len(s)
    slashPos = 0
    For i = 1 To n
        ch = Mid$(s, i, 1)
        If ch = "\" Or ch = "/" Then slashPos = i
    Next
    If slashPos > 0 Then
        dir = Left$(s, slashPos)
    Else
        dir = ""
    End If
    p = dir + rel
    If FileExists(p) <> 0 Then
        IncludeFind$ = p
        Exit Function
    End If
    p = dir + "..\" + rel
    If FileExists(p) <> 0 Then
        IncludeFind$ = p
        Exit Function
    End If
    p = dir + "..\..\" + rel
    If FileExists(p) <> 0 Then
        IncludeFind$ = p
        Exit Function
    End If
    p = dir + "..\..\..\" + rel
    If FileExists(p) <> 0 Then
        IncludeFind$ = p
        Exit Function
    End If
    p = rel
    If FileExists(p) <> 0 Then
        IncludeFind$ = p
    End If
End Function

Function DefaultIncludeIdx$() As String
    DefaultIncludeIdx$ = IncludeFind$("Include\default\default.idx")
End Function

' ソースに明示がなくても Include/default を先頭へ展開
' abpc が既に default を先頭結合している場合はスキップ
Function ExpandAlreadyHasDefaults() As Long
    Dim p As *Byte
    Dim n As Long
    Dim i As Long
    Dim lim As Long
    ExpandAlreadyHasDefaults = 0
    n = SbLen(VarPtr(gSbExpand))
    If n < 16 Then Exit Function
    p = SbData(VarPtr(gSbExpand))
    If p = 0 Then Exit Function
    lim = n - 15
    If lim > 120 Then lim = 120
    i = 0
    While i <= lim
        ' 固定マーカー "Include/default"（abpc CombineSources）
        If p[i] = CH_I And p[i + 1] = CH_LN And p[i + 2] = CH_LC And p[i + 3] = CH_LL Then
            If p[i + 7] = CH_SLASH And p[i + 8] = CH_LD And p[i + 9] = CH_LE And p[i + 10] = CH_LF Then
                ExpandAlreadyHasDefaults = 1
                Exit Function
            End If
        End If
        i = i + 1
    Wend
End Function

Sub PrependDefaultIncludes()
    Dim idx As String
    Dim p As *Byte
    Dim n As Long
    Dim defSb As StringBuffer

    If ExpandAlreadyHasDefaults() <> 0 Then
        If ABC_TIME_DEBUG <> 0 Then
            Print "time: main.prepend_default=skipped"
        End If
        Exit Sub
    End If
    idx = DefaultIncludeIdx$()
    If idx = "" Then Exit Sub
    LoadFileToGlobal(StrPtr(idx))
    p = gLoadPtr
    n = gLastLoadSize
    If p = 0 Or n <= 0 Then Exit Sub
    ' 本体を退避し、default を先頭へ（巨大 String + を避ける）
    SbMove(VarPtr(gSbSaved), VarPtr(gSbExpand))
    SbInit(VarPtr(defSb))
    If ExpandIncludesInto(VarPtr(defSb), p, n, idx, 0) = 0 Then
        free(p)
        SbFree(VarPtr(defSb))
        SbMove(VarPtr(gSbExpand), VarPtr(gSbSaved))
        Exit Sub
    End If
    free(p)
    SbClear(VarPtr(gSbExpand))
    SbAppendSb(VarPtr(gSbExpand), VarPtr(defSb))
    SbAppendSb(VarPtr(gSbExpand), VarPtr(gSbSaved))
    SbFree(VarPtr(defSb))
    SbFree(VarPtr(gSbSaved))
End Sub

Function CompileBuffer(src As *Byte, srcSize As Long) As Long
    Dim i As Long
    Dim start As Long
    Dim lineBuf[MAX_LINE] As Byte
    Dim lenLine As Long
    Dim c As Long
    Dim lineStr As String
    Dim tAll As Long
    Dim t0 As Long
    Dim t1 As Long
    Dim nStmt As Long
    Dim tPrep As Long
    Dim tTd As Long
    Dim tField As Long
    Dim tConst As Long
    Dim tOther As Long
    Dim tMark As Long
    Dim stmtRest As String
    Dim colonPos As Long

    CompileBuffer = 0
    gCompileOk = 0
    tAll = AbcTick()
    gSrcLine = 0
    gSrcLineText = ""
    SbClear(VarPtr(gSbData))
    SbClear(VarPtr(gSbText))
    SbClear(VarPtr(gSbProc))
    SbClear(VarPtr(gSbRt))
    SbClear(VarPtr(gSbOut))
    SbClear(VarPtr(gSbTmp))
    SbClear(VarPtr(gSbSaved))
    gStrCount = 0
    gUseMsgBox = 0
    gEmittedExit = 0
    gUseStringRt = 0
    gUseHostRt = 0
    gUseInput = 0
    gApiExternLines = ""
    gNVars = 0
    gNSigs = 0
    gFrameSize = 0
    InitBuiltinConsts()
    gNameArenaUsed = 0
    gNTypes = 0
    gNTypeDefs = 0
    gNFields = 0
    gInType = 0
    gCurType = -1
    gLastFieldIdx = -1
    gLabelId = 0
    gIfSp = 0
    gLoopSp = 0
    gSelSp = 0
    i = 0
    While i < MAX_SELECT
        gSelSlotReady(i) = 0
        i = i + 1
    Wend
    gInProc = 0
    gProcName = ""
    gProcIsFunc = 0
    t1 = AbcTick()
    AbcTimePrint("compile.init", tAll, t1)

    nStmt = 0
    tPrep = 0
    tTd = 0
    tField = 0
    tConst = 0
    tOther = 0
    t0 = AbcTick()
    i = 0
    While i < srcSize
        start = i
        While i < srcSize
            c = src[i]
            If c = CH_NL Or c = CH_CR Then Exit While
            i = i + 1
        Wend
        gSrcLine = gSrcLine + 1
        lenLine = i - start
        If lenLine >= MAX_LINE Then lenLine = MAX_LINE - 1
        tMark = AbcTick()
        If lenLine > 0 Then
            memcpy(lineBuf, VarPtr(src[start]), lenLine)
        End If
        lineBuf[lenLine] = 0
        PrepSourceLine(lineBuf, lenLine)
        tPrep = tPrep + (AbcTick() - tMark)
        If lenLine > 0 Then
            tMark = AbcTick()
            stmtRest = MakeStr(lineBuf)
            While stmtRest <> ""
                colonPos = FindStmtColon(stmtRest)
                If colonPos = 0 Then
                    lineStr = stmtRest
                    stmtRest = ""
                Else
                    lineStr = Trim$(Left$(stmtRest, colonPos - 1))
                    stmtRest = Trim$(Mid$(stmtRest, colonPos + 1, Len(stmtRest) - colonPos))
                End If
                If lineStr <> "" Then
                    nStmt = nStmt + 1
                    gSrcLineText = lineStr
            If StartsWithCI(lineStr, "#console") <> 0 Or StartsWithCI(lineStr, "#strict") <> 0 Or StartsWithCI(lineStr, "#n88basic") <> 0 Or StartsWithCI(lineStr, "#prompt") <> 0 Then
                ' ignore
            ElseIf gInType <> 0 Then
                If StrEqCI(lineStr, "end type") <> 0 Then
                    If CompileTypeEnd() = 0 Then
                        Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                        Exit Function
                    End If
                ElseIf CompileTypeField(lineStr) = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
                tField = tField + (AbcTick() - tMark)
            ElseIf StartsWithCI(lineStr, "typedef ") <> 0 Then
                If CompileTypeDef(lineStr) = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
                tTd = tTd + (AbcTick() - tMark)
            ElseIf StartsWithCI(lineStr, "type ") <> 0 Then
                If CompileTypeStart(lineStr) = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
                tTd = tTd + (AbcTick() - tMark)
            ElseIf StartsWithCI(lineStr, "const ") <> 0 Then
                If CompileConst(lineStr) = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
                tConst = tConst + (AbcTick() - tMark)
            ElseIf StrEqCI(lineStr, "end select") <> 0 Then
                If CompileEndSelect() = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
                tOther = tOther + (AbcTick() - tMark)
            ElseIf StrEqCI(lineStr, "end") <> 0 Then
                EmitAsm("push 0")
                EmitCallName("ExitProcess")
                gEmittedExit = 1
                tOther = tOther + (AbcTick() - tMark)
            ElseIf StartsWithCI(lineStr, "select case ") <> 0 Then
                If CompileSelectCase(lineStr) = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
                tOther = tOther + (AbcTick() - tMark)
            ElseIf StartsWithCI(lineStr, "case ") <> 0 Then
                If CompileCase(lineStr) = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
                tOther = tOther + (AbcTick() - tMark)
            ElseIf StartsWithCI(lineStr, "elseif ") <> 0 Then
                If CompileElseIfThen(lineStr) = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
                tOther = tOther + (AbcTick() - tMark)
            ElseIf StrEqCI(lineStr, "else") <> 0 Then
                If CompileElse() = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
                tOther = tOther + (AbcTick() - tMark)
            ElseIf StrEqCI(lineStr, "end if") <> 0 Then
                If CompileEndIf() = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
                tOther = tOther + (AbcTick() - tMark)
            ElseIf StrEqCI(lineStr, "wend") <> 0 Then
                If CompileWend() = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
                tOther = tOther + (AbcTick() - tMark)
            ElseIf StrEqCI(lineStr, "loop") <> 0 Or StartsWithCI(lineStr, "loop ") <> 0 Then
                If CompileLoop(lineStr) = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
                tOther = tOther + (AbcTick() - tMark)
            ElseIf StrEqCI(lineStr, "next") <> 0 Or StartsWithCI(lineStr, "next ") <> 0 Then
                If CompileNext() = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
                tOther = tOther + (AbcTick() - tMark)
            ElseIf StrEqCI(lineStr, "exit while") <> 0 Then
                If CompileExitWhile() = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
                tOther = tOther + (AbcTick() - tMark)
            ElseIf StrEqCI(lineStr, "exit do") <> 0 Then
                If CompileExitDo() = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
                tOther = tOther + (AbcTick() - tMark)
            ElseIf StrEqCI(lineStr, "exit for") <> 0 Then
                If CompileExitFor() = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
                tOther = tOther + (AbcTick() - tMark)
            ElseIf StrEqCI(lineStr, "exit sub") <> 0 Or StrEqCI(lineStr, "exit function") <> 0 Then
                If CompileExitProc() = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
                tOther = tOther + (AbcTick() - tMark)
            ElseIf StrEqCI(lineStr, "end sub") <> 0 Or StrEqCI(lineStr, "end function") <> 0 Then
                If CompileEndProc() = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
                tOther = tOther + (AbcTick() - tMark)
            ElseIf StrEqCI(lineStr, "do") <> 0 Or StartsWithCI(lineStr, "do ") <> 0 Then
                If CompileDo(lineStr) = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
                tOther = tOther + (AbcTick() - tMark)
            ElseIf StartsWithCI(lineStr, "while ") <> 0 Then
                If CompileWhile(lineStr) = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
                tOther = tOther + (AbcTick() - tMark)
            ElseIf StartsWithCI(lineStr, "for ") <> 0 Then
                If CompileFor(lineStr) = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
                tOther = tOther + (AbcTick() - tMark)
            ElseIf StartsWithCI(lineStr, "sub ") <> 0 Then
                If CompileProcHeader(lineStr, 0) = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
                tOther = tOther + (AbcTick() - tMark)
            ElseIf StartsWithCI(lineStr, "function ") <> 0 Then
                If CompileProcHeader(lineStr, 1) = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
                tOther = tOther + (AbcTick() - tMark)
            ElseIf StartsWithCI(lineStr, "if ") <> 0 Then
                If CompileIfThen(lineStr) = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
                tOther = tOther + (AbcTick() - tMark)
            ElseIf StartsWithCI(lineStr, "dim ") <> 0 Then
                If CompileDim(lineStr) = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
                tOther = tOther + (AbcTick() - tMark)
            ElseIf StartsWithCI(lineStr, "print ") <> 0 Then
                If CompilePrint(lineStr) = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
                tOther = tOther + (AbcTick() - tMark)
            ElseIf StartsWithCI(lineStr, "input ") <> 0 Then
                If CompileInput(lineStr) = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
                tOther = tOther + (AbcTick() - tMark)
            ElseIf StartsWith(lineStr, "MessageBox(") <> 0 Then
                If CompileMessageBox(lineStr) = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
                tOther = tOther + (AbcTick() - tMark)
            ElseIf StartsWith(lineStr, "ExitProcess(") <> 0 Then
                If CompileExitProcess(lineStr) = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
                tOther = tOther + (AbcTick() - tMark)
            ElseIf FindOp1(lineStr, "=") > 0 Then
                If CompileAssign(lineStr) = 0 Then
                    Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
                tOther = tOther + (AbcTick() - tMark)
            ElseIf InStr(1, lineStr, "(") > 1 Then
                If CompileCallStmt(lineStr) = 0 Then
                    Print "error: unknown statement at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                    Exit Function
                End If
                tOther = tOther + (AbcTick() - tMark)
            Else
                Print "error: unknown statement at line " + Trim$(Str$(gSrcLine)) + ": " + lineStr
                Exit Function
            End If
                End If
            Wend
        End If

        If i < srcSize And src[i] = CH_CR Then i = i + 1
        If i < srcSize And src[i] = CH_NL Then i = i + 1
    Wend
    t1 = AbcTick()
    AbcTimePrint("compile.lines", t0, t1)
    If ABC_TIME_DEBUG <> 0 Then
        Print "time: compile.lines_info srcLines=" + Trim$(Str$(gSrcLine)) + " stmts=" + Trim$(Str$(nStmt)) + " srcBytes=" + Trim$(Str$(srcSize))
        Print "time: compile.prep=" + Trim$(Str$(tPrep)) + "ms typedef/type=" + Trim$(Str$(tTd)) + "ms field=" + Trim$(Str$(tField)) + "ms const=" + Trim$(Str$(tConst)) + "ms other=" + Trim$(Str$(tOther)) + "ms"
    End If

    If gInProc <> 0 Then
        Print "error: unclosed Sub/Function at end of file"
        Exit Function
    End If
    If gInType <> 0 Then
        Print "error: unclosed Type at end of file"
        Exit Function
    End If
    If gIfSp <> 0 Then
        Print "error: unclosed If at end of file"
        Exit Function
    End If
    If gLoopSp <> 0 Then
        Print "error: unclosed loop (While/For) at end of file"
        Exit Function
    End If

    t0 = AbcTick()
    SbMove(VarPtr(gSbTmp), VarPtr(gSbText))
    If gNVars > 0 Then
        EmitAsm("push ebp")
        EmitAsm("mov ebp, esp")
        EmitAsm("sub esp, " + Trim$(Str$(gFrameSize)))
    End If
    SbAppendSb(VarPtr(gSbText), VarPtr(gSbTmp))
    SbClear(VarPtr(gSbTmp))

    If gEmittedExit = 0 Then
        EmitAsm("push 0")
        EmitCallName("ExitProcess")
        gEmittedExit = 1
    End If

    SbAppendStr(VarPtr(gSbOut), "bits 32")
    SbAppendCRLF(VarPtr(gSbOut))
    SbAppendCRLF(VarPtr(gSbOut))
    SbAppendStr(VarPtr(gSbOut), "; generated by abc (Phase5)")
    SbAppendCRLF(VarPtr(gSbOut))
    If gUseMsgBox <> 0 Then
        SbAppendStr(VarPtr(gSbOut), "extern _MessageBoxA@16")
        SbAppendCRLF(VarPtr(gSbOut))
    End If
    If gApiExternLines <> "" Then
        SbAppendStr(VarPtr(gSbOut), gApiExternLines)
        SbAppendCRLF(VarPtr(gSbOut))
    End If
    If gUseStringRt <> 0 Then
        SbAppendStr(VarPtr(gSbOut), "extern _lstrlenA@4")
        SbAppendCRLF(VarPtr(gSbOut))
        SbAppendStr(VarPtr(gSbOut), "extern _lstrcpyA@8")
        SbAppendCRLF(VarPtr(gSbOut))
        SbAppendStr(VarPtr(gSbOut), "extern _lstrcatA@8")
        SbAppendCRLF(VarPtr(gSbOut))
        SbAppendStr(VarPtr(gSbOut), "extern _lstrcmpA@8")
        SbAppendCRLF(VarPtr(gSbOut))
        SbAppendStr(VarPtr(gSbOut), "extern _GetProcessHeap@0")
        SbAppendCRLF(VarPtr(gSbOut))
        SbAppendStr(VarPtr(gSbOut), "extern _HeapAlloc@12")
        SbAppendCRLF(VarPtr(gSbOut))
        SbAppendStr(VarPtr(gSbOut), "extern _HeapFree@12")
        SbAppendCRLF(VarPtr(gSbOut))
        SbAppendStr(VarPtr(gSbOut), "extern _GetStdHandle@4")
        SbAppendCRLF(VarPtr(gSbOut))
        SbAppendStr(VarPtr(gSbOut), "extern _WriteFile@20")
        SbAppendCRLF(VarPtr(gSbOut))
        If gUseInput <> 0 Then
            SbAppendStr(VarPtr(gSbOut), "extern _ReadFile@20")
            SbAppendCRLF(VarPtr(gSbOut))
        End If
        SbAppendCRLF(VarPtr(gSbOut))
    End If
    SbAppendStr(VarPtr(gSbOut), "section .data")
    SbAppendCRLF(VarPtr(gSbOut))
    If SbIsEmpty(VarPtr(gSbData)) = 0 Then
        SbAppendSb(VarPtr(gSbOut), VarPtr(gSbData))
    Else
        SbAppendStr(VarPtr(gSbOut), "    dummy db 0")
        SbAppendCRLF(VarPtr(gSbOut))
    End If
    SbAppendCRLF(VarPtr(gSbOut))
    SbAppendStr(VarPtr(gSbOut), "section .text")
    SbAppendCRLF(VarPtr(gSbOut))
    SbAppendStr(VarPtr(gSbOut), "    global _main")
    SbAppendCRLF(VarPtr(gSbOut))
    SbAppendCRLF(VarPtr(gSbOut))
    If SbIsEmpty(VarPtr(gSbProc)) = 0 Then
        SbAppendSb(VarPtr(gSbOut), VarPtr(gSbProc))
    End If
    If SbIsEmpty(VarPtr(gSbRt)) = 0 Then
        SbAppendSb(VarPtr(gSbOut), VarPtr(gSbRt))
        SbAppendCRLF(VarPtr(gSbOut))
    End If
    SbAppendStr(VarPtr(gSbOut), "_main:")
    SbAppendCRLF(VarPtr(gSbOut))
    SbAppendSb(VarPtr(gSbOut), VarPtr(gSbText))

    t1 = AbcTick()
    AbcTimePrint("compile.emit_out", t0, t1)
    AbcTimePrint("compile.total", tAll, t1)
    TokFree()
    gCompileOk = 1
    CompileBuffer = 1
End Function

