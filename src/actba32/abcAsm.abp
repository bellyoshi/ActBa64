' abcAsm.abp - 低レベル asm 出力 / 型・変数 / ランタイム雛形

Sub EmitAsm(line As String)
    SbAppendStr(VarPtr(gSbText), "    ")
    SbAppendStr(VarPtr(gSbText), line)
    SbAppendCRLF(VarPtr(gSbText))
End Sub

' prefix + 十進即値（"mov eax, " + Str$(n) の割当を避ける）
Sub EmitAsmImm(prefix As String, v As Long)
    SbAppendStr(VarPtr(gSbText), "    ")
    SbAppendStr(VarPtr(gSbText), prefix)
    SbAppendDec(VarPtr(gSbText), v)
    SbAppendCRLF(VarPtr(gSbText))
End Sub

' 2 断片連結
Sub EmitAsm2(a As String, b As String)
    SbAppendStr(VarPtr(gSbText), "    ")
    SbAppendStr(VarPtr(gSbText), a)
    SbAppendStr(VarPtr(gSbText), b)
    SbAppendCRLF(VarPtr(gSbText))
End Sub

' mov/… [ebx] （Chr$(5B) 連結を避ける）
Sub EmitAsmEbxMem(op As String)
    SbAppendStr(VarPtr(gSbText), "    ")
    SbAppendStr(VarPtr(gSbText), op)
    SbAppendByte(VarPtr(gSbText), CH_LBRACK)
    SbAppendStr(VarPtr(gSbText), "ebx")
    SbAppendByte(VarPtr(gSbText), CH_RBRACK)
    SbAppendCRLF(VarPtr(gSbText))
End Sub

' mov eax, [ebx]
Sub EmitAsmLoadEbx()
    EmitAsmEbxMem("mov eax, ")
End Sub

' mov [ebx], eax
Sub EmitAsmStoreEbx()
    SbAppendStr(VarPtr(gSbText), "    mov ")
    SbAppendByte(VarPtr(gSbText), CH_LBRACK)
    SbAppendStr(VarPtr(gSbText), "ebx")
    SbAppendByte(VarPtr(gSbText), CH_RBRACK)
    SbAppendStr(VarPtr(gSbText), ", eax")
    SbAppendCRLF(VarPtr(gSbText))
End Sub

' mov [ebx], al / ax
Sub EmitAsmStoreEbxReg(reg As String)
    SbAppendStr(VarPtr(gSbText), "    mov ")
    SbAppendByte(VarPtr(gSbText), CH_LBRACK)
    SbAppendStr(VarPtr(gSbText), "ebx")
    SbAppendByte(VarPtr(gSbText), CH_RBRACK)
    SbAppendStr(VarPtr(gSbText), ", ")
    SbAppendStr(VarPtr(gSbText), reg)
    SbAppendCRLF(VarPtr(gSbText))
End Sub

Sub EmitLabel(lab As String)
    SbAppendStr(VarPtr(gSbText), lab)
    SbAppendStr(VarPtr(gSbText), ":")
    SbAppendCRLF(VarPtr(gSbText))
End Sub

Function NewLabel$() As String
    gLabelId = gLabelId + 1
    NewLabel$ = "L" + Trim$(Str$(gLabelId))
End Function

Function IsIdentStart(c As Long) As Long
    If (IsAlphabet(c) <> 0) Or c = CH_UNDER Then
        IsIdentStart = 1
    Else
        IsIdentStart = 0
    End If
End Function

Function IsIdentChar2(c As Long) As Long
    If IsIdentStart(c) <> 0 Or (IsDigit(c) <> 0) Or c = CH_DOLLAR Then
        IsIdentChar2 = 1
    Else
        IsIdentChar2 = 0
    End If
End Function

Function IsIdentName(s As String) As Long
    Dim t As String
    Dim p As *Byte
    Dim i As Long
    Dim n As Long
    t = Trim$(s)
    n = Len(t)
    IsIdentName = 0
    If n = 0 Then Exit Function
    p = StrPtr(t)
    If IsIdentStart(p[0]) = 0 Then Exit Function
    i = 1
    While i < n
        If IsIdentChar2(p[i]) = 0 Then Exit Function
        i = i + 1
    Wend
    IsIdentName = 1
End Function

' openPos(0-based) の ( または [ に対応する閉じ位置。失敗は -1
Function MatchClose(p As *Byte, n As Long, openPos As Long) As Long
    Dim depth As Long
    Dim i As Long
    Dim openCh As Long
    Dim closeCh As Long
    Dim inQ As Long
    Dim c As Long
    MatchClose = -1
    If openPos < 0 Or openPos >= n Then Exit Function
    openCh = p[openPos]
    If openCh = CH_LPAREN Then
        closeCh = CH_RPAREN
    ElseIf openCh = CH_LBRACK Then
        closeCh = CH_RBRACK
    Else
        Exit Function
    End If
    depth = 1
    inQ = 0
    i = openPos + 1
    While i < n
        c = p[i]
        If inQ <> 0 Then
            If c = CH_DQUOTE Then inQ = 0
        ElseIf c = CH_DQUOTE Then
            inQ = 1
        ElseIf c = openCh Then
            depth = depth + 1
        ElseIf c = closeCh Then
            depth = depth - 1
            If depth = 0 Then
                MatchClose = i
                Exit Function
            End If
        End If
        i = i + 1
    Wend
End Function

' openParen / closeParen はどちらも 1-based（'(' と ')' の位置）
Function ArgsBetween$(expr As String, openParen As Long, closeParen As Long) As String
    Dim n As Long
    n = closeParen - openParen - 1
    If n <= 0 Then
        ArgsBetween$ = ""
    Else
        ArgsBetween$ = Trim$(Mid$(expr, openParen + 1, n))
    End If
End Function

Function IsNumStr(s As String) As Long
    Dim t As String
    Dim p As *Byte
    Dim i As Long
    Dim n As Long
    t = Trim$(s)
    n = Len(t)
    If n = 0 Then
        IsNumStr = 0
        Exit Function
    End If
    p = StrPtr(t)
    i = 0
    If p[0] = CH_MINUS Or p[0] = CH_PLUS Then
        i = 1
        If n = 1 Then
            IsNumStr = 0
            Exit Function
        End If
    End If
    If i + 1 < n And p[i] = CH_AMP And (p[i + 1] = CH_H Or p[i + 1] = CH_LH) Then
        IsNumStr = 1
        Exit Function
    End If
    While i < n
        If IsDigit(p[i]) = 0 Then
            IsNumStr = 0
            Exit Function
        End If
        i = i + 1
    Wend
    IsNumStr = 1
End Function

Function ParseNum(s As String) As Long
    Dim t As String
    Dim p As *Byte
    Dim i As Long
    Dim n As Long
    Dim sign As Long
    Dim v As Long
    Dim c As Long
    t = Trim$(s)
    n = Len(t)
    p = StrPtr(t)
    sign = 1
    i = 0
    If p[0] = CH_MINUS Then
        sign = -1
        i = 1
    ElseIf p[0] = CH_PLUS Then
        i = 1
    End If
    If i + 1 < n And p[i] = CH_AMP And (p[i + 1] = CH_H Or p[i + 1] = CH_LH) Then
        i = i + 2
        v = 0
        While i < n
            c = p[i]
            v = v * 16
            If IsDigit(c) <> 0 Then
                v = v + (c - CH_0)
            ElseIf IsLower(c) <> 0 And c <= CH_LF Then
                v = v + (c - CH_LA + 10)
            ElseIf IsUpper(c) <> 0 And c <= CH_F Then
                v = v + (c - CH_A + 10)
            End If
            i = i + 1
        Wend
        ParseNum = v * sign
        Exit Function
    End If
    v = 0
    While i < n
        v = v * 10 + (p[i] - CH_0)
        i = i + 1
    Wend
    ParseNum = v * sign
End Function

' p[start..start+length) を数値として解釈（Trim 済み想定）。失敗は ok=0
Function ParseNumBytes(p As *Byte, start As Long, length As Long, ByRef ok As Long) As Long
    Dim i As Long
    Dim hi As Long
    Dim sign As Long
    Dim v As Long
    Dim c As Long
    ok = 0
    ParseNumBytes = 0
    If length <= 0 Then Exit Function
    i = start
    hi = start + length - 1
    While i <= hi And (p[i] = CH_SP Or p[i] = CH_TAB)
        i = i + 1
    Wend
    While hi >= i And (p[hi] = CH_SP Or p[hi] = CH_TAB)
        hi = hi - 1
    Wend
    If i > hi Then Exit Function
    sign = 1
    If p[i] = CH_MINUS Then
        sign = -1
        i = i + 1
    ElseIf p[i] = CH_PLUS Then
        i = i + 1
    End If
    If i > hi Then Exit Function
    If i + 1 <= hi And p[i] = CH_AMP And (p[i + 1] = CH_H Or p[i + 1] = CH_LH) Then
        i = i + 2
        v = 0
        If i > hi Then Exit Function
        While i <= hi
            c = p[i]
            v = v * 16
            If IsDigit(c) <> 0 Then
                v = v + (c - CH_0)
            ElseIf IsLower(c) <> 0 And c <= CH_LF Then
                v = v + (c - CH_LA + 10)
            ElseIf IsUpper(c) <> 0 And c <= CH_F Then
                v = v + (c - CH_A + 10)
            Else
                Exit Function
            End If
            i = i + 1
        Wend
        ok = 1
        ParseNumBytes = v * sign
        Exit Function
    End If
    v = 0
    While i <= hi
        c = p[i]
        If IsDigit(c) = 0 Then Exit Function
        v = v * 10 + (c - CH_0)
        i = i + 1
    Wend
    ok = 1
    ParseNumBytes = v * sign
End Function

Function FindVar(name As String) As Long
    Dim i As Long
    Dim n As String
    n = Lower$(name)
    FindVar = -1
    If gNVars <= 0 Then Exit Function
    For i = 0 To gNVars - 1
        If gVarName(i) = n Then
            FindVar = i
            Exit Function
        End If
    Next
End Function

Function FindConst(name As String) As Long
    Dim i As Long
    NormTypeName(name)
    FindConst = -1
    If gNConsts <= 0 Then Exit Function
    For i = 0 To gNConsts - 1
        If NormEqStored(gConstName(i)) <> 0 Then
            FindConst = i
            Exit Function
        End If
    Next
End Function

Function FindConstNorm() As Long
    Dim i As Long
    FindConstNorm = -1
    If gNConsts <= 0 Then Exit Function
    For i = 0 To gNConsts - 1
        If NormEqStored(gConstName(i)) <> 0 Then
            FindConstNorm = i
            Exit Function
        End If
    Next
End Function

' typeName を trim+小文字で gNormType へ（ヒープなし）
Sub NormTypeName(typeName As String)
    Dim p As *Byte
    Dim n As Long
    Dim i As Long
    Dim lo As Long
    Dim hi As Long
    Dim c As Long
    Dim o As Long
    n = Len(typeName)
    gNormTypeLen = 0
    If n <= 0 Then
        gNormType[0] = 0
        Exit Sub
    End If
    p = StrPtr(typeName)
    lo = 0
    While lo < n
        c = p[lo]
        If c <> CH_SP And c <> CH_TAB Then Exit While
        lo = lo + 1
    Wend
    If lo >= n Then
        gNormType[0] = 0
        Exit Sub
    End If
    hi = n - 1
    While hi > lo
        c = p[hi]
        If c <> CH_SP And c <> CH_TAB Then Exit While
        hi = hi - 1
    Wend
    o = 0
    i = lo
    While i <= hi
        If o >= 127 Then Exit While
        c = p[i]
        c = ToLowerChar(c)
        gNormType[o] = c
        o = o + 1
        i = i + 1
    Wend
    gNormType[o] = 0
    gNormTypeLen = o
End Sub

' gNormType と格納済み小文字名が一致するか
Function NormEqStored(stored As String) As Long
    Dim p As *Byte
    Dim n As Long
    Dim i As Long
    NormEqStored = 0
    n = Len(stored)
    If n <> gNormTypeLen Then Exit Function
    If n = 0 Then
        NormEqStored = 1
        Exit Function
    End If
    p = StrPtr(stored)
    For i = 0 To n - 1
        If p[i] <> gNormType[i] Then Exit Function
    Next
    NormEqStored = 1
End Function

Function ArenaEqNorm(off As Long, n As Long) As Long
    Dim i As Long
    ArenaEqNorm = 0
    If n <> gNormTypeLen Then Exit Function
    If n = 0 Then
        ArenaEqNorm = 1
        Exit Function
    End If
    If off < 0 Or off + n > gNameArenaUsed Then Exit Function
    For i = 0 To n - 1
        If gNameArena[off + i] <> gNormType[i] Then Exit Function
    Next
    ArenaEqNorm = 1
End Function

Function ArenaPutNorm() As Long
    Dim o As Long
    Dim i As Long
    ArenaPutNorm = -1
    If gNormTypeLen < 0 Then Exit Function
    If gNameArenaUsed + gNormTypeLen + 1 > MAX_NAME_ARENA Then
        Print "name arena full"
        Exit Function
    End If
    o = gNameArenaUsed
    i = 0
    While i < gNormTypeLen
        gNameArena[o + i] = gNormType[i]
        i = i + 1
    Wend
    gNameArena[o + gNormTypeLen] = 0
    gNameArenaUsed = o + gNormTypeLen + 1
    ArenaPutNorm = o
End Function

Function ArenaPutBytes(p As *Byte, start As Long, length As Long) As Long
    Dim lo As Long
    Dim hi As Long
    Dim o As Long
    Dim i As Long
    Dim c As Long
    Dim n As Long
    ArenaPutBytes = -1
    If length <= 0 Then
        If gNameArenaUsed + 1 > MAX_NAME_ARENA Then Exit Function
        o = gNameArenaUsed
        gNameArena[o] = 0
        gNameArenaUsed = o + 1
        ArenaPutBytes = o
        Exit Function
    End If
    lo = start
    hi = start + length - 1
    While lo <= hi
        c = p[lo]
        If c <> CH_SP And c <> CH_TAB Then Exit While
        lo = lo + 1
    Wend
    While hi >= lo
        c = p[hi]
        If c <> CH_SP And c <> CH_TAB Then Exit While
        hi = hi - 1
    Wend
    If lo > hi Then
        n = 0
    Else
        n = hi - lo + 1
    End If
    If gNameArenaUsed + n + 1 > MAX_NAME_ARENA Then
        Print "name arena full"
        Exit Function
    End If
    o = gNameArenaUsed
    i = 0
    While i < n
        gNameArena[o + i] = p[lo + i]
        i = i + 1
    Wend
    gNameArena[o + n] = 0
    gNameArenaUsed = o + n + 1
    ArenaPutBytes = o
End Function

Function ArenaMakeStr$(off As Long, n As Long) As String
    Dim buf[128] As Byte
    Dim i As Long
    ArenaMakeStr$ = ""
    If n <= 0 Or off < 0 Then Exit Function
    If n > 127 Then n = 127
    If off + n > gNameArenaUsed Then Exit Function
    For i = 0 To n - 1
        buf[i] = gNameArena[off + i]
    Next
    buf[n] = 0
    ArenaMakeStr$ = MakeStr(buf)
End Function

Sub CopyArenaToNorm(off As Long, n As Long)
    Dim i As Long
    Dim c As Long
    Dim o As Long
    Dim lo As Long
    Dim hi As Long
    gNormTypeLen = 0
    gNormType[0] = 0
    If n <= 0 Or off < 0 Then Exit Sub
    If off + n > gNameArenaUsed Then Exit Sub
    lo = 0
    While lo < n
        c = gNameArena[off + lo]
        If c <> CH_SP And c <> CH_TAB Then Exit While
        lo = lo + 1
    Wend
    If lo >= n Then Exit Sub
    hi = n - 1
    While hi > lo
        c = gNameArena[off + hi]
        If c <> CH_SP And c <> CH_TAB Then Exit While
        hi = hi - 1
    Wend
    o = 0
    i = lo
    While i <= hi
        If o >= 127 Then Exit While
        c = gNameArena[off + i]
        c = ToLowerChar(c)
        gNormType[o] = c
        o = o + 1
        i = i + 1
    Wend
    gNormType[o] = 0
    gNormTypeLen = o
End Sub

Function TypeSizeOfNorm() As Long
    Dim i As Long
    Dim p As *Byte
    Dim n As Long
    n = gNormTypeLen
    p = gNormType
    ' byte / word / long / dword / handle / string / integer / voidptr / long_ptr / ulong_ptr
    If n = 4 And p[0] = CH_LB And p[1] = CH_LY And p[2] = CH_LT And p[3] = CH_LE Then
        TypeSizeOfNorm = 1
        Exit Function
    End If
    If n = 4 And p[0] = CH_LW And p[1] = CH_LO And p[2] = CH_LR And p[3] = CH_LD Then
        TypeSizeOfNorm = 2
        Exit Function
    End If
    If n = 4 And p[0] = CH_LL And p[1] = CH_LO And p[2] = CH_LN And p[3] = CH_LG Then
        TypeSizeOfNorm = 4
        Exit Function
    End If
    If n = 5 And p[0] = CH_LD And p[1] = CH_LW And p[2] = CH_LO And p[3] = CH_LR And p[4] = CH_LD Then
        TypeSizeOfNorm = 4
        Exit Function
    End If
    If n = 6 And p[0] = CH_LH And p[1] = CH_LA And p[2] = CH_LN And p[3] = CH_LD And p[4] = CH_LL And p[5] = CH_LE Then
        TypeSizeOfNorm = 4
        Exit Function
    End If
    If n = 6 And p[0] = CH_LS And p[1] = CH_LT And p[2] = CH_LR And p[3] = CH_LI And p[4] = CH_LN And p[5] = CH_LG Then
        TypeSizeOfNorm = 4
        Exit Function
    End If
    If n = 7 And p[0] = CH_LI And p[1] = CH_LN And p[2] = CH_LT And p[3] = CH_LE And p[4] = CH_LG And p[5] = CH_LE And p[6] = CH_LR Then
        TypeSizeOfNorm = 4
        Exit Function
    End If
    If n = 7 And p[0] = CH_LV And p[1] = CH_LO And p[2] = CH_LI And p[3] = CH_LD And p[4] = CH_LP And p[5] = CH_LT And p[6] = CH_LR Then
        TypeSizeOfNorm = 4
        Exit Function
    End If
    If n = 8 And p[0] = CH_LL And p[1] = CH_LO And p[2] = CH_LN And p[3] = CH_LG And p[4] = CH_UNDER And p[5] = CH_LP And p[6] = CH_LT And p[7] = CH_LR Then
        TypeSizeOfNorm = 4
        Exit Function
    End If
    If n = 9 And p[0] = CH_LU And p[1] = CH_LL And p[2] = CH_LO And p[3] = CH_LN And p[4] = CH_LG And p[5] = CH_UNDER And p[6] = CH_LP And p[7] = CH_LT And p[8] = CH_LR Then
        TypeSizeOfNorm = 4
        Exit Function
    End If
    TypeSizeOfNorm = 0
    For i = 0 To gNTypes - 1
        If ArenaEqNorm(gTypeNameOff(i), gTypeNameLen(i)) <> 0 Then
            TypeSizeOfNorm = gTypeSize(i)
            Exit Function
        End If
    Next
End Function

Function TypeSizeOf(typeName As String) As Long
    NormTypeName(typeName)
    TypeSizeOf = TypeSizeOfNorm()
End Function

Function FindTypeNorm() As Long
    Dim i As Long
    FindTypeNorm = -1
    For i = 0 To gNTypes - 1
        If ArenaEqNorm(gTypeNameOff(i), gTypeNameLen(i)) <> 0 Then
            FindTypeNorm = i
            Exit Function
        End If
    Next
End Function

Function FindType(typeName As String) As Long
    NormTypeName(typeName)
    FindType = FindTypeNorm()
End Function

Function FindTypeDefNorm() As Long
    Dim i As Long
    FindTypeDefNorm = -1
    For i = 0 To gNTypeDefs - 1
        If ArenaEqNorm(gTypeDefNameOff(i), gTypeDefNameLen(i)) <> 0 Then
            FindTypeDefNorm = i
            Exit Function
        End If
    Next
End Function

Function FindTypeDef(name As String) As Long
    NormTypeName(name)
    FindTypeDef = FindTypeDefNorm()
End Function

' gNormType 上で TypeDef / *T を展開（ヒープなし）
Sub ExpandTypeNameNorm(ByRef isPtr As Long)
    Dim guard As Long
    Dim td As Long
    Dim start As Long
    Dim i As Long
    Dim o As Long
    isPtr = 0
    guard = 0
    While guard < 16
        start = 0
        While start < gNormTypeLen And gNormType[start] = CH_STAR
            isPtr = 1
            start = start + 1
            While start < gNormTypeLen And (gNormType[start] = CH_SP Or gNormType[start] = CH_TAB)
                start = start + 1
            Wend
        Wend
        If start > 0 Then
            o = 0
            i = start
            While i < gNormTypeLen
                If o >= 127 Then Exit While
                gNormType[o] = gNormType[i]
                o = o + 1
                i = i + 1
            Wend
            gNormType[o] = 0
            gNormTypeLen = o
        End If
        td = FindTypeDefNorm()
        If td < 0 Then Exit While
        CopyArenaToNorm(gTypeDefTargetOff(td), gTypeDefTargetLen(td))
        guard = guard + 1
    Wend
    start = 0
    While start < gNormTypeLen And gNormType[start] = CH_STAR
        isPtr = 1
        start = start + 1
        While start < gNormTypeLen And (gNormType[start] = CH_SP Or gNormType[start] = CH_TAB)
            start = start + 1
        Wend
    Wend
    If start > 0 Then
        o = 0
        i = start
        While i < gNormTypeLen
            If o >= 127 Then Exit While
            gNormType[o] = gNormType[i]
            o = o + 1
            i = i + 1
        Wend
        gNormType[o] = 0
        gNormTypeLen = o
    End If
End Sub

' TypeDef / *T を展開。最終の基底型名と isPtr を返す
Sub ExpandTypeName(ByRef typeName As String, ByRef isPtr As Long)
    NormTypeName(typeName)
    ExpandTypeNameNorm(isPtr)
    typeName = MakeStr(gNormType)
End Sub

' TypeDef Name = Target
' p[off..] が lit（小文字想定）と一致するか（長さは lit）
Sub NormTypeBytes(p As *Byte, start As Long, length As Long)
    Dim i As Long
    Dim o As Long
    Dim c As Long
    Dim lo As Long
    Dim hi As Long
    gNormTypeLen = 0
    gNormType[0] = 0
    If length <= 0 Then Exit Sub
    lo = start
    hi = start + length - 1
    While lo <= hi
        c = p[lo]
        If c <> CH_SP And c <> CH_TAB Then Exit While
        lo = lo + 1
    Wend
    While hi >= lo
        c = p[hi]
        If c <> CH_SP And c <> CH_TAB Then Exit While
        hi = hi - 1
    Wend
    o = 0
    i = lo
    While i <= hi
        If o >= 127 Then Exit While
        c = p[i]
        c = ToLowerChar(c)
        gNormType[o] = c
        o = o + 1
        i = i + 1
    Wend
    gNormType[o] = 0
    gNormTypeLen = o
End Sub

Function SliceToStr$(p As *Byte, start As Long, length As Long) As String
    Dim buf[256] As Byte
    Dim lo As Long
    Dim hi As Long
    Dim o As Long
    Dim c As Long
    Dim i As Long
    SliceToStr$ = ""
    If length <= 0 Then Exit Function
    lo = start
    hi = start + length - 1
    While lo <= hi
        c = p[lo]
        If c <> CH_SP And c <> CH_TAB Then Exit While
        lo = lo + 1
    Wend
    While hi >= lo
        c = p[hi]
        If c <> CH_SP And c <> CH_TAB Then Exit While
        hi = hi - 1
    Wend
    o = 0
    i = lo
    While i <= hi
        If o >= 255 Then Exit While
        buf[o] = p[i]
        o = o + 1
        i = i + 1
    Wend
    buf[o] = 0
    If o = 0 Then Exit Function
    SliceToStr$ = MakeStr(buf)
End Function

Function IsIdentBytes(p As *Byte, start As Long, length As Long) As Long
    Dim i As Long
    Dim c As Long
    Dim lo As Long
    Dim hi As Long
    IsIdentBytes = 0
    If length <= 0 Then Exit Function
    lo = start
    hi = start + length - 1
    While lo <= hi
        c = p[lo]
        If c <> CH_SP And c <> CH_TAB Then Exit While
        lo = lo + 1
    Wend
    While hi >= lo
        c = p[hi]
        If c <> CH_SP And c <> CH_TAB Then Exit While
        hi = hi - 1
    Wend
    If lo > hi Then Exit Function
    If IsIdentStart(p[lo]) = 0 Then Exit Function
    i = lo + 1
    While i <= hi
        If IsIdentChar2(p[i]) = 0 Then Exit Function
        i = i + 1
    Wend
    IsIdentBytes = 1
End Function

Function CompileTypeDef(lineStr As String) As Long
    CompileTypeDef = CompileTypeDefBytes(StrPtr(lineStr), Len(lineStr))
End Function

Function CompileTypeDefBytes(p As *Byte, n As Long) As Long
    Dim i As Long
    Dim eq As Long
    Dim td As Long
    Dim nameOff As Long
    Dim nameLen As Long
    Dim tgtOff As Long
    Dim tgtLen As Long
    Dim j As Long
    Dim ca As Long
    Dim cb As Long
    CompileTypeDefBytes = 0
    ' "TypeDef " プレフィックス済み想定
    eq = -1
    i = 8
    While i < n
        If p[i] = CH_EQ Then
            eq = i
            Exit While
        End If
        i = i + 1
    Wend
    If eq < 0 Then
        Print "bad TypeDef"
        Exit Function
    End If
    If IsIdentBytes(p, 8, eq - 8) = 0 Then
        Print "bad TypeDef"
        Exit Function
    End If
    NormTypeBytes(p, 8, eq - 8)
    If gNormTypeLen = 0 Then
        Print "bad TypeDef"
        Exit Function
    End If
    nameLen = gNormTypeLen
    td = FindTypeDefNorm()
    If td >= 0 Then
        ' 同一ターゲットなら許可（バイト比較）
        j = eq + 1
        While j < n And (p[j] = CH_SP Or p[j] = CH_TAB)
            j = j + 1
        Wend
        tgtLen = 0
        While j + tgtLen < n
            tgtLen = tgtLen + 1
        Wend
        While tgtLen > 0
            ca = p[j + tgtLen - 1]
            If ca <> CH_SP And ca <> CH_TAB Then Exit While
            tgtLen = tgtLen - 1
        Wend
        If gTypeDefTargetLen(td) = tgtLen Then
            i = 0
            While i < tgtLen
                ca = gNameArena[gTypeDefTargetOff(td) + i]
                cb = p[j + i]
                ca = ToLowerChar(ca)
                cb = ToLowerChar(cb)
                If ca <> cb Then Exit While
                i = i + 1
            Wend
            If i = tgtLen Then
                CompileTypeDefBytes = 1
                Exit Function
            End If
        End If
        Print "duplicate TypeDef: " + MakeStr(gNormType)
        Exit Function
    End If
    If gNTypeDefs >= MAX_TYPEDEFS Then
        Print "too many TypeDef"
        Exit Function
    End If
    nameOff = ArenaPutNorm()
    If nameOff < 0 Then Exit Function
    tgtOff = ArenaPutBytes(p, eq + 1, n - eq - 1)
    If tgtOff < 0 Then Exit Function
    tgtLen = 0
    While gNameArena[tgtOff + tgtLen] <> 0
        tgtLen = tgtLen + 1
    Wend
    If tgtLen = 0 Then
        Print "bad TypeDef"
        Exit Function
    End If
    td = gNTypeDefs
    gTypeDefNameOff(td) = nameOff
    gTypeDefNameLen(td) = nameLen
    gTypeDefTargetOff(td) = tgtOff
    gTypeDefTargetLen(td) = tgtLen
    gNTypeDefs = gNTypeDefs + 1
    CompileTypeDefBytes = 1
End Function

Function FindField(typeIdx As Long, fieldName As String) As Long
    Dim i As Long
    NormTypeName(fieldName)
    FindField = -1
    If typeIdx < 0 Or typeIdx >= gNTypes Then Exit Function
    i = gTypeFirstField(typeIdx)
    While i >= 0
        If ArenaEqNorm(gFieldNameOff(i), gFieldNameLen(i)) <> 0 Then
            FindField = i
            Exit Function
        End If
        i = gFieldNext(i)
    Wend
End Function

Sub EmitLoadSized(size As Long)
    If size = 1 Then
        EmitAsm("movzx eax, " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK))
    ElseIf size = 2 Then
        EmitAsm("movzx eax, word " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK))
    Else
        EmitAsmLoadEbx()
    End If
End Sub

Sub EmitStoreSized(size As Long)
    If size = 1 Then
        EmitAsmStoreEbxReg("al")
    ElseIf size = 2 Then
        EmitAsmStoreEbxReg("ax")
    Else
        EmitAsmStoreEbx()
    End If
End Sub

' base.field / base->field のアドレスを ebx に設定する
Function EmitMemberAddr(access As String, ByRef fieldSize As Long) As Long
    Dim p As Long
    Dim baseName As String
    Dim fieldName As String
    Dim vi As Long
    Dim fi As Long
    EmitMemberAddr = 0
    p = InStr(1, access, "->")
    If p > 0 Then
        baseName = Trim$(Left$(access, p - 1))
        fieldName = Trim$(Mid$(access, p + 2, Len(access) - p - 1))
    Else
        p = InStr(1, access, ".")
        If p = 0 Then
            Print "error: member access needs . or -> : " + access
            Exit Function
        End If
        baseName = Trim$(Left$(access, p - 1))
        fieldName = Trim$(Mid$(access, p + 1, Len(access) - p))
    End If
    vi = FindVar(baseName)
    If vi < 0 Then
        Print "error: undeclared variable in member access: " + baseName + " (from " + access + ")"
        Exit Function
    End If
    If gVarTypeIdx(vi) < 0 Then
        Print "error: not a Type variable (need Dim x As SomeType): " + baseName + " (from " + access + ")"
        Exit Function
    End If
    fi = FindField(gVarTypeIdx(vi), fieldName)
    If fi < 0 Then
        Print "error: unknown field '" + fieldName + "' in " + access + " (type " + ArenaMakeStr$(gTypeNameOff(gVarTypeIdx(vi)), gTypeNameLen(gVarTypeIdx(vi))) + ")"
        Exit Function
    End If
    If gVarIsPtr(vi) <> 0 Then
        EmitLoadVar(vi)
        EmitAsm("mov ebx, eax")
    Else
        EmitAddrOfVar(vi)
    End If
    If gFieldOff(fi) <> 0 Then EmitAsmImm("add ebx, ", gFieldOff(fi))
    fieldSize = gFieldSize(fi)
    gLastFieldIdx = fi
    EmitMemberAddr = 1
End Function

Function ApiBytes(name As String) As Long
    Dim n As String
    n = Lower$(name)
    ApiBytes = -1
    If n = "exitprocess" Then ApiBytes = 4
    If n = "getcommandlinea" Or n = "getcommandline" Then ApiBytes = 0
    If n = "lstrlena" Or n = "lstrlen" Then ApiBytes = 4
    If n = "messageboxa" Or n = "messagebox" Then ApiBytes = 16
    If n = "getprocessheap" Then ApiBytes = 0
    If n = "heapalloc" Then ApiBytes = 12
    If n = "heapfree" Then ApiBytes = 12
    If n = "lstrcpya" Or n = "lstrcpy" Or n = "lstrcata" Or n = "lstrcat" Or n = "lstrcmpa" Or n = "lstrcmp" Then ApiBytes = 8
    If n = "createfilea" Or n = "createfile" Then ApiBytes = 28
    If n = "readfile" Or n = "writefile" Then ApiBytes = 20
    If n = "closehandle" Then ApiBytes = 4
    If n = "getfilesize" Then ApiBytes = 8
    If n = "getmodulefilenamea" Or n = "getmodulefilename" Then ApiBytes = 12
    If n = "getfileattributesa" Or n = "getfileattributes" Or n = "deletefilea" Or n = "deletefile" Then ApiBytes = 4
    If n = "createprocessa" Or n = "createprocess" Then ApiBytes = 40
    If n = "waitforsingleobject" Then ApiBytes = 8
    If n = "getstdhandle" Then ApiBytes = 4
    If n = "gettickcount" Then ApiBytes = 0
    If n = "peekmessagea" Or n = "peekmessage" Then ApiBytes = 20
    If n = "msgwaitformultipleobjects" Then ApiBytes = 20
    ' user32 / gdi32（ProjectEditor 等）
    If n = "getmodulehandlea" Or n = "getmodulehandle" Then ApiBytes = 4
    If n = "createwindowexa" Or n = "createwindowex" Then ApiBytes = 48
    If n = "defwindowproca" Or n = "defwindowproc" Then ApiBytes = 16
    If n = "sendmessagea" Or n = "sendmessage" Then ApiBytes = 16
    If n = "getdlgitem" Then ApiBytes = 8
    If n = "destroywindow" Then ApiBytes = 4
    If n = "loadicona" Or n = "loadicon" Then ApiBytes = 8
    If n = "loadcursora" Or n = "loadcursor" Then ApiBytes = 8
    If n = "registerclassexa" Or n = "registerclassex" Then ApiBytes = 4
    If n = "enablewindow" Then ApiBytes = 8
    If n = "getwindow" Then ApiBytes = 8
    If n = "postmessagea" Or n = "postmessage" Then ApiBytes = 16
    If n = "postquitmessage" Then ApiBytes = 4
    If n = "getmessagea" Or n = "getmessage" Then ApiBytes = 16
    If n = "translatemessage" Then ApiBytes = 4
    If n = "dispatchmessagea" Or n = "dispatchmessage" Then ApiBytes = 4
    If n = "createfonta" Or n = "createfont" Then ApiBytes = 56
    If n = "createsolidbrush" Then ApiBytes = 4
    If n = "getsyscolor" Then ApiBytes = 4
    If n = "deleteobject" Then ApiBytes = 4
    If n = "getdc" Then ApiBytes = 4
    If n = "releasedc" Then ApiBytes = 8
    If n = "showwindow" Then ApiBytes = 8
    If n = "updatewindow" Then ApiBytes = 4
    If n = "beginpaint" Then ApiBytes = 8
    If n = "endpaint" Then ApiBytes = 8
    If n = "getclientrect" Then ApiBytes = 8
    If n = "fillrect" Then ApiBytes = 12
    If n = "adjustwindowrect" Then ApiBytes = 12
    If n = "getstockobject" Then ApiBytes = 4
    If n = "createcompatibledc" Then ApiBytes = 4
    If n = "createcompatiblebitmap" Then ApiBytes = 12
    If n = "selectobject" Then ApiBytes = 8
    If n = "createpen" Then ApiBytes = 12
    If n = "movetoex" Then ApiBytes = 16
    If n = "lineto" Then ApiBytes = 12
    If n = "rectangle" Then ApiBytes = 20
    If n = "ellipse" Then ApiBytes = 20
    If n = "arc" Then ApiBytes = 36
    If n = "pie" Then ApiBytes = 36
    If n = "bitblt" Then ApiBytes = 36
    If n = "setbkmode" Then ApiBytes = 8
    If n = "settextcolor" Then ApiBytes = 8
    If n = "textouta" Or n = "textout" Then ApiBytes = 20
    If n = "extfloodfill" Then ApiBytes = 20
End Function

Sub EmitCallName(name As String)
    Dim b As Long
    Dim sym As String
    Dim n As String
    Dim apiName As String
    n = Lower$(name)

    ' ActiveBasic 組み込み → 自前 RT（kernel32 に無い）
    If n = "makestr" Or n = "instr" Or n = "memcpy" Or n = "malloc" Or n = "calloc" Or n = "free" Or n = "fillmemory" Then
        EnsureHostRt()
        If n = "makestr" Then
            EmitAsm("call _rt_MakeStr")
        ElseIf n = "instr" Then
            EmitAsm("call _rt_InStr")
        ElseIf n = "memcpy" Then
            EmitAsm("call _rt_Memcpy")
        ElseIf n = "fillmemory" Then
            EmitAsm("call _rt_FillMemory")
        ElseIf n = "malloc" Then
            EmitAsm("call _rt_Malloc")
        ElseIf n = "calloc" Then
            EmitAsm("call _rt_Calloc")
        Else
            EmitAsm("call _rt_Free")
        End If
        Exit Sub
    End If

    ' ANSI API 名へ正規化
    apiName = name
    If n = "getcommandline" Then apiName = "GetCommandLineA"
    If n = "lstrlen" Then apiName = "lstrlenA"
    If n = "lstrcpy" Then apiName = "lstrcpyA"
    If n = "lstrcat" Then apiName = "lstrcatA"
    If n = "lstrcmp" Then apiName = "lstrcmpA"
    If n = "createfile" Then apiName = "CreateFileA"
    If n = "getfileattributes" Then apiName = "GetFileAttributesA"
    If n = "messagebox" Then apiName = "MessageBoxA"
    If n = "getmodulefilename" Then apiName = "GetModuleFileNameA"
    If n = "deletefile" Then apiName = "DeleteFileA"
    If n = "createprocess" Then apiName = "CreateProcessA"
    If n = "getmodulehandle" Then apiName = "GetModuleHandleA"
    If n = "createwindowex" Then apiName = "CreateWindowExA"
    If n = "defwindowproc" Then apiName = "DefWindowProcA"
    If n = "sendmessage" Then apiName = "SendMessageA"
    If n = "loadicon" Then apiName = "LoadIconA"
    If n = "loadcursor" Then apiName = "LoadCursorA"
    If n = "registerclassex" Then apiName = "RegisterClassExA"
    If n = "postmessage" Then apiName = "PostMessageA"
    If n = "getmessage" Then apiName = "GetMessageA"
    If n = "peekmessage" Then apiName = "PeekMessageA"
    If n = "dispatchmessage" Then apiName = "DispatchMessageA"
    If n = "createfont" Then apiName = "CreateFontA"
    If n = "textout" Then apiName = "TextOutA"

    b = ApiBytes(apiName)
    If b >= 0 Then
        sym = "_" + apiName + "@" + Trim$(Str$(b))
        If InStr(1, gApiExternLines, "extern " + sym + Chr$(CH_CR)) = 0 Then
            gApiExternLines = gApiExternLines + "extern " + sym + Chr$(CH_CR) + Chr$(CH_NL)
        End If
        EmitAsm("call " + sym)
    Else
        EmitAsm("call _" + name)
    End If
End Sub

Function AddVarEx(name As String, elemSize As Long, count As Long, isPtr As Long, isStr As Long) As Long
    Dim idx As Long
    Dim bytes As Long
    Dim isGlob As Long
    idx = FindVar(name)
    If idx >= 0 Then
        Print "duplicate Dim: " + name
        AddVarEx = -1
        Exit Function
    End If
    If gNVars >= MAX_VARS Then
        Print "too many variables"
        AddVarEx = -1
        Exit Function
    End If
    If isPtr <> 0 Then
        bytes = 4
    ElseIf isStr <> 0 Then
        bytes = 4 * count
    Else
        bytes = elemSize * count
    End If
    If bytes <= 0 Then
        Print "bad variable size"
        AddVarEx = -1
        Exit Function
    End If
    idx = gNVars
    gVarName(idx) = Lower$(name)
    If gInProc = 0 Then
        isGlob = 1
    Else
        isGlob = 0
    End If
    gVarIsGlobal(idx) = isGlob
    If isGlob <> 0 Then
        ' モジュール変数は .data（手続きから ebp 相対で触れない）
        gVarOff(idx) = 0
        SbAppendStr(VarPtr(gSbData), "    v_" + gVarName(idx) + ":")
        SbAppendCRLF(VarPtr(gSbData))
        SbAppendStr(VarPtr(gSbData), "    times " + Trim$(Str$(bytes)) + " db 0")
        SbAppendCRLF(VarPtr(gSbData))
    Else
        gFrameSize = gFrameSize + bytes
        gVarOff(idx) = -gFrameSize
    End If
    gVarSize(idx) = elemSize
    If isStr <> 0 Then gVarSize(idx) = 4
    If isPtr <> 0 Then gVarSize(idx) = elemSize
    gVarCount(idx) = count
    gVarIsPtr(idx) = isPtr
    gVarIsStr(idx) = isStr
    gVarIsByRef(idx) = 0
    gVarTypeIdx(idx) = -1
    gNVars = gNVars + 1
    AddVarEx = idx
End Function

Function AddVar(name As String) As Long
    AddVar = AddVarEx(name, 4, 1, 0, 0)
End Function

' ebx = 変数スロットのアドレス（ByRef 引数ならスタック上のポインタ自体の場所）
Sub EmitAddrVar(idx As Long)
    If gVarIsGlobal(idx) <> 0 Then
        EmitAsm("mov ebx, v_" + gVarName(idx))
    Else
        EmitAsm("mov ebx, ebp")
        EmitAsmImm("add ebx, ", gVarOff(idx))
    End If
End Sub

' ebx = 実体のアドレス（ByRef ならスロットからポインタを読む）
Sub EmitAddrOfVar(idx As Long)
    EmitAddrVar(idx)
    If gVarIsByRef(idx) <> 0 Then
        EmitAsm("mov ebx, " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK))
    End If
End Sub

' 変数を eax へロード
Sub EmitLoadVar(idx As Long)
    EmitAddrOfVar(idx)
    If gVarIsPtr(idx) <> 0 Or gVarIsStr(idx) <> 0 Or gVarSize(idx) = 4 Then
        EmitAsmLoadEbx()
    ElseIf gVarSize(idx) = 1 Then
        EmitAsm("movzx eax, " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK))
    ElseIf gVarSize(idx) = 2 Then
        EmitAsm("movzx eax, word " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK))
    Else
        Print "unsupported load size"
        End
    End If
End Sub

Sub EmitStoreVar(idx As Long)
    If gVarIsStr(idx) <> 0 Then
        ' eax=new; free old heap string then store
        EmitAsm("push eax")
        EmitAddrOfVar(idx)
        EmitAsm("mov eax, " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK))
        EmitAsm("push ebx")
        EmitAsm("push eax")
        EmitAsm("call _rt_StrFree")
        EmitAsm("pop ebx")
        EmitAsm("pop eax")
        EmitAsmStoreEbx()
        Exit Sub
    End If
    EmitAddrOfVar(idx)
    If gVarIsPtr(idx) <> 0 Or gVarSize(idx) = 4 Then
        EmitAsmStoreEbx()
    ElseIf gVarSize(idx) = 1 Then
        EmitAsmStoreEbxReg("al")
    ElseIf gVarSize(idx) = 2 Then
        EmitAsmStoreEbxReg("ax")
    Else
        Print "unsupported store size"
        End
    End If
End Sub

' eax = 添字。ebx = 要素アドレスにする（GenArith を呼ばない）
Sub EmitScaleAddBase(idx As Long)
    If gVarIsPtr(idx) <> 0 Then
        EmitAsm("push eax")
        EmitLoadVar(idx)
        EmitAsm("mov ebx, eax")
        EmitAsm("pop eax")
        If gVarSize(idx) > 1 Then
            EmitAsm("mov ecx, " + Trim$(Str$(gVarSize(idx))))
            EmitAsm("imul eax, ecx")
        End If
        EmitAsm("add ebx, eax")
    Else
        If gVarCount(idx) <= 1 Then
            Print "not an array: " + gVarName(idx)
            End
        End If
        EmitAsm("push eax")
        EmitAddrVar(idx)
        EmitAsm("pop eax")
        If gVarSize(idx) > 1 Then
            EmitAsm("mov ecx, " + Trim$(Str$(gVarSize(idx))))
            EmitAsm("imul eax, ecx")
        End If
        EmitAsm("add ebx, eax")
    End If
End Sub

' 深さ0の2文字演算子（右端優先）。戻り値は 1-based 開始位置
Function FindOp2(expr As String, op As String) As Long
    Dim n As Long
    Dim i As Long
    Dim depth As Long
    Dim inQ As Long
    Dim c As Long
    n = Len(expr)
    depth = 0
    inQ = 0
    FindOp2 = 0
    i = n
    While i >= 1
        c = Asc(Mid$(expr, i, 1))
        If inQ <> 0 Then
            If c = CH_DQUOTE Then inQ = 0
        ElseIf c = CH_DQUOTE Then
            inQ = 1
        ElseIf c = CH_RPAREN Then
            depth = depth + 1
        ElseIf c = CH_LPAREN Then
            depth = depth - 1
        ElseIf c = CH_RBRACK Then
            depth = depth + 1
        ElseIf c = CH_LBRACK Then
            depth = depth - 1
        ElseIf depth = 0 Then
            If i < n Then
                If Mid$(expr, i, 2) = op Then
                    FindOp2 = i
                    Exit Function
                End If
            End If
        End If
        i = i - 1
    Wend
End Function

' 深さ0の1文字演算子（右端優先）。partOf2 が隣にあれば無視
Function FindOp1(expr As String, ch As String) As Long
    Dim n As Long
    Dim i As Long
    Dim depth As Long
    Dim inQ As Long
    Dim c As Long
    Dim p As *Byte
    Dim oc As Long
    n = Len(expr)
    p = StrPtr(expr)
    oc = Asc(ch)
    depth = 0
    inQ = 0
    FindOp1 = 0
    i = n - 1
    While i >= 0
        c = p[i]
        If inQ <> 0 Then
            If c = CH_DQUOTE Then inQ = 0
        ElseIf c = CH_DQUOTE Then
            inQ = 1
        ElseIf c = CH_RPAREN Then
            depth = depth + 1
        ElseIf c = CH_LPAREN Then
            depth = depth - 1
        ElseIf c = CH_RBRACK Then
            depth = depth + 1
        ElseIf c = CH_LBRACK Then
            depth = depth - 1
        ElseIf depth = 0 And c = oc Then
            ' <> <= >= の一部を除外
            If ch = "=" Then
                If i > 0 And (p[i - 1] = CH_LESS Or p[i - 1] = CH_GREATER Or p[i - 1] = CH_EQ) Then
                    ' skip
                Else
                    FindOp1 = i + 1
                    Exit Function
                End If
            ElseIf ch = "<" Then
                If i + 1 < n And (p[i + 1] = CH_EQ Or p[i + 1] = CH_GREATER) Then
                    ' skip
                Else
                    FindOp1 = i + 1
                    Exit Function
                End If
            ElseIf ch = ">" Then
                If i + 1 < n And p[i + 1] = CH_EQ Then
                    ' skip
                Else
                    FindOp1 = i + 1
                    Exit Function
                End If
            Else
                FindOp1 = i + 1
                Exit Function
            End If
        End If
        i = i - 1
    Wend
End Function

' 文字列リテラル（"..." または '...'）。途中に同じ引用符があれば非リテラル
Function IsStringLit(s As String) As Long
    Dim t As String
    Dim n As Long
    Dim p As *Byte
    Dim i As Long
    Dim q As Long
    t = Trim$(s)
    n = Len(t)
    IsStringLit = 0
    If n < 2 Then Exit Function
    p = StrPtr(t)
    If p[0] = CH_DQUOTE Or p[0] = CH_SQUOTE Then
        q = p[0]
    Else
        Exit Function
    End If
    If p[n - 1] <> q Then Exit Function
    i = 1
    While i < n - 1
        If p[i] = q Then Exit Function
        i = i + 1
    Wend
    IsStringLit = 1
End Function

Function AddStringLit$(s As String) As String
    Dim t As String
    Dim label As String
    Dim lit As String
    Dim n As Long
    Dim litLen As Long
    Dim i As Long
    Dim p As *Byte
    t = Trim$(s)
    label = "str_" + Trim$(Str$(gStrCount))
    n = Len(t) - 2
    If n <= 0 Then
        lit = ""
    Else
        lit = Mid$(t, 2, n)
    End If
    litLen = Len(lit)
    ' AB 互換: [dd 長さ][データ...][末尾 0]。ラベルはデータ先頭（長さは -4）
    SbAppendStr(VarPtr(gSbData), "    ")
    SbAppendStr(VarPtr(gSbData), label)
    SbAppendStr(VarPtr(gSbData), "_hdr dd ")
    SbAppendDec(VarPtr(gSbData), litLen)
    SbAppendCRLF(VarPtr(gSbData))
    SbAppendStr(VarPtr(gSbData), "    ")
    SbAppendStr(VarPtr(gSbData), label)
    SbAppendStr(VarPtr(gSbData), " db ")
    If litLen = 0 Then
        SbAppendByte(VarPtr(gSbData), CH_0)
    Else
        p = StrPtr(lit)
        i = 0
        While i < litLen
            If i > 0 Then SbAppendStr(VarPtr(gSbData), ", ")
            SbAppendDec(VarPtr(gSbData), p[i] And 255)
            i = i + 1
        Wend
        SbAppendStr(VarPtr(gSbData), ", 0")
    End If
    SbAppendCRLF(VarPtr(gSbData))
    gStrCount = gStrCount + 1
    AddStringLit$ = label
End Function

' 深さ0の単語演算子（右端優先）
Function FindOpWord(expr As String, word As String) As Long
    Dim e As String
    Dim w As String
    Dim n As Long
    Dim m As Long
    Dim i As Long
    Dim depth As Long
    Dim inQ As Long
    Dim c As Long
    Dim beforeOk As Long
    Dim afterOk As Long
    e = Lower$(expr)
    w = Lower$(word)
    n = Len(e)
    m = Len(w)
    FindOpWord = 0
    depth = 0
    inQ = 0
    i = n
    While i >= 1
        c = Asc(Mid$(e, i, 1))
        If inQ <> 0 Then
            If c = CH_DQUOTE Then inQ = 0
        ElseIf c = CH_DQUOTE Then
            inQ = 1
        ElseIf c = CH_RPAREN Or c = CH_RBRACK Then
            depth = depth + 1
        ElseIf c = CH_LPAREN Or c = CH_LBRACK Then
            depth = depth - 1
        ElseIf depth = 0 Then
            If i + m - 1 <= n Then
                If Mid$(e, i, m) = w Then
                    beforeOk = 1
                    afterOk = 1
                    If i > 1 Then
                        c = Asc(Mid$(e, i - 1, 1))
                        If IsIdentChar2(c) <> 0 Then beforeOk = 0
                    End If
                    If i + m <= n Then
                        c = Asc(Mid$(e, i + m, 1))
                        If IsIdentChar2(c) <> 0 Then afterOk = 0
                    End If
                    If beforeOk <> 0 And afterOk <> 0 Then
                        FindOpWord = i
                        Exit Function
                    End If
                End If
            End If
        End If
        i = i - 1
    Wend
End Function

Function IsStringExpr(expr As String) As Long
    Dim e As String
    Dim n As Long
    Dim p As *Byte
    Dim pos As Long
    Dim idx As Long
    Dim i As Long
    e = Trim$(expr)
    IsStringExpr = 0
    If IsStringLit(e) <> 0 Then
        IsStringExpr = 1
        Exit Function
    End If
    n = Len(e)
    If n >= 2 Then
        p = StrPtr(e)
        If p[0] = CH_LPAREN And p[n - 1] = CH_RPAREN Then
            IsStringExpr = IsStringExpr(Mid$(e, 2, n - 2))
            Exit Function
        End If
    End If
    pos = FindOp1(e, "+")
    If pos > 0 Then
        If IsStringExpr(Left$(e, pos - 1)) <> 0 Or IsStringExpr(Mid$(e, pos + 1, Len(e) - pos)) <> 0 Then
            IsStringExpr = 1
            Exit Function
        End If
    End If
    If Lower$(Left$(e, 5)) = "chr$(" Or Lower$(Left$(e, 6)) = "left$(" Or Lower$(Left$(e, 5)) = "mid$(" Or Lower$(Left$(e, 5)) = "str$(" Or Lower$(Left$(e, 5)) = "hex$(" Then
        IsStringExpr = 1
        Exit Function
    End If
    idx = FindVar(e)
    If idx >= 0 Then
        IsStringExpr = gVarIsStr(idx)
        Exit Function
    End If
    ' gArgs(i) など String 配列要素
    p = StrPtr(e)
    i = 0
    While i < n
        If p[i] = CH_LPAREN Or p[i] = CH_LBRACK Then
            idx = FindVar(Trim$(Left$(e, i)))
            If idx >= 0 Then
                IsStringExpr = gVarIsStr(idx)
            End If
            Exit Function
        End If
        i = i + 1
    Wend
End Function

Sub RtLine(line As String)
    SbAppendStr(VarPtr(gSbRt), line)
    SbAppendCRLF(VarPtr(gSbRt))
End Sub

Sub EnsureStringRt()
    If gUseStringRt <> 0 Then Exit Sub
    gUseStringRt = 1
    ' 空文字: 長さ0 + 末尾NUL。ポインタはデータ先頭
    SbAppendStr(VarPtr(gSbData), "    str_empty_hdr dd 0")
    SbAppendCRLF(VarPtr(gSbData))
    SbAppendStr(VarPtr(gSbData), "    str_empty db 0")
    SbAppendCRLF(VarPtr(gSbData))

    ' Len(s): dword at (s-4) の下位31bit。NULL→0
    RtLine("_rt_Len:")
    RtLine("    push ebp")
    RtLine("    mov ebp, esp")
    RtLine("    mov ebx, ebp")
    RtLine("    add ebx, 8")
    RtLine("    mov eax, " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK))
    RtLine("    cmp eax, 0")
    RtLine("    je rt_len_zero")
    RtLine("    mov ebx, eax")
    RtLine("    sub ebx, 4")
    RtLine("    mov eax, " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK))
    RtLine("    and eax, 2147483647")
    RtLine("    jmp rt_len_done")
    RtLine("rt_len_zero:")
    RtLine("    mov eax, 0")
    RtLine("rt_len_done:")
    RtLine("    mov esp, ebp")
    RtLine("    pop ebp")
    RtLine("    ret 4")

    ' StrCmp(a,b): 長さ付き辞書順比較 → eax (<0/0/>0)。NULL→空
    RtLine("_rt_StrCmp:")
    RtLine("    push ebp")
    RtLine("    mov ebp, esp")
    RtLine("    push ebx")
    RtLine("    push esi")
    RtLine("    push edi")
    RtLine("    mov ebx, ebp")
    RtLine("    add ebx, 8")
    RtLine("    mov esi, " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK))
    RtLine("    cmp esi, 0")
    RtLine("    jne rt_sc_a_ok")
    RtLine("    push str_empty")
    RtLine("    pop esi")
    RtLine("rt_sc_a_ok:")
    RtLine("    add ebx, 4")
    RtLine("    mov edi, " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK))
    RtLine("    cmp edi, 0")
    RtLine("    jne rt_sc_b_ok")
    RtLine("    push str_empty")
    RtLine("    pop edi")
    RtLine("rt_sc_b_ok:")
    RtLine("    mov ebx, esi")
    RtLine("    sub ebx, 4")
    RtLine("    mov eax, " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK))
    RtLine("    and eax, 0x7FFFFFFF")
    RtLine("    push eax")
    RtLine("    mov ebx, edi")
    RtLine("    sub ebx, 4")
    RtLine("    mov edx, " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK))
    RtLine("    and edx, 0x7FFFFFFF")
    RtLine("    push edx")
    RtLine("    mov ebx, eax")
    RtLine("    cmp ebx, edx")
    RtLine("    jle rt_sc_n_ok")
    RtLine("    mov ebx, edx")
    RtLine("rt_sc_n_ok:")
    RtLine("rt_sc_loop:")
    RtLine("    cmp ebx, 0")
    RtLine("    je rt_sc_len")
    RtLine("    movzx eax, " + Chr$(CH_LBRACK) + "esi" + Chr$(CH_RBRACK))
    RtLine("    movzx ecx, " + Chr$(CH_LBRACK) + "edi" + Chr$(CH_RBRACK))
    RtLine("    cmp eax, ecx")
    RtLine("    jne rt_sc_diff")
    RtLine("    add esi, 1")
    RtLine("    add edi, 1")
    RtLine("    sub ebx, 1")
    RtLine("    jmp rt_sc_loop")
    RtLine("rt_sc_diff:")
    RtLine("    sub eax, ecx")
    RtLine("    add esp, 8")
    RtLine("    jmp rt_sc_done")
    RtLine("rt_sc_len:")
    RtLine("    pop edx")
    RtLine("    pop eax")
    RtLine("    sub eax, edx")
    RtLine("    jmp rt_sc_done2")
    RtLine("rt_sc_done:")
    RtLine("rt_sc_done2:")
    RtLine("    pop edi")
    RtLine("    pop esi")
    RtLine("    pop ebx")
    RtLine("    mov esp, ebp")
    RtLine("    pop ebp")
    RtLine("    ret 8")

    ' StrFree(p): ヒープ印付きなら HeapFree(p-4)
    RtLine("_rt_StrFree:")
    RtLine("    push ebp")
    RtLine("    mov ebp, esp")
    RtLine("    push ebx")
    RtLine("    mov ebx, ebp")
    RtLine("    add ebx, 8")
    RtLine("    mov eax, " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK))
    RtLine("    cmp eax, 0")
    RtLine("    je rt_sfree_done")
    RtLine("    mov ebx, eax")
    RtLine("    sub ebx, 4")
    RtLine("    mov eax, " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK))
    RtLine("    and eax, 0x80000000")
    RtLine("    jz rt_sfree_done")
    RtLine("    push ebx")
    RtLine("    push 0")
    RtLine("    call _GetProcessHeap@0")
    RtLine("    push eax")
    RtLine("    call _HeapFree@12")
    RtLine("rt_sfree_done:")
    RtLine("    pop ebx")
    RtLine("    mov esp, ebp")
    RtLine("    pop ebp")
    RtLine("    ret 4")

    RtLine("_rt_Asc:")
    RtLine("    push ebp")
    RtLine("    mov ebp, esp")
    RtLine("    mov ebx, ebp")
    RtLine("    add ebx, 8")
    RtLine("    mov eax, " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK))
    RtLine("    cmp eax, 0")
    RtLine("    je rt_asc_zero")
    RtLine("    mov ebx, eax")
    RtLine("    movzx eax, " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK))
    RtLine("    jmp rt_asc_done")
    RtLine("rt_asc_zero:")
    RtLine("    mov eax, 0")
    RtLine("rt_asc_done:")
    RtLine("    mov esp, ebp")
    RtLine("    pop ebp")
    RtLine("    ret 4")

    ' Chr$(n): HeapAlloc(4+1+1)、長さ1、埋め込み NUL 可
    RtLine("_rt_Chr:")
    RtLine("    push ebp")
    RtLine("    mov ebp, esp")
    RtLine("    push ebx")
    RtLine("    push esi")
    RtLine("    push edi")
    RtLine("    mov ebx, ebp")
    RtLine("    add ebx, 8")
    RtLine("    mov esi, " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK))
    RtLine("    call _GetProcessHeap@0")
    RtLine("    push 6")
    RtLine("    push 0")
    RtLine("    push eax")
    RtLine("    call _HeapAlloc@12")
    RtLine("    mov edi, eax")
    RtLine("    mov ebx, eax")
    RtLine("    mov eax, 1")
    RtLine("    or eax, 0x80000000")
    RtLine("    mov " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK) + ", eax")
    RtLine("    add ebx, 4")
    RtLine("    mov eax, esi")
    RtLine("    mov " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK) + ", al")
    RtLine("    add ebx, 1")
    RtLine("    mov eax, 0")
    RtLine("    mov " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK) + ", al")
    RtLine("    mov eax, edi")
    RtLine("    add eax, 4")
    RtLine("    pop edi")
    RtLine("    pop esi")
    RtLine("    pop ebx")
    RtLine("    mov esp, ebp")
    RtLine("    pop ebp")
    RtLine("    ret 4")

    ' Cat(a,b): 長さプレフィックス付き連結（埋め込み NUL 対応）
    RtLine("_rt_Cat:")
    RtLine("    push ebp")
    RtLine("    mov ebp, esp")
    RtLine("    push ebx")
    RtLine("    push esi")
    RtLine("    push edi")
    RtLine("    mov ebx, ebp")
    RtLine("    add ebx, 8")
    RtLine("    mov edi, " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK))
    RtLine("    cmp edi, 0")
    RtLine("    jne rt_cat_a_ok")
    RtLine("    push str_empty")
    RtLine("    pop edi")
    RtLine("rt_cat_a_ok:")
    RtLine("    add ebx, 4")
    RtLine("    mov esi, " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK))
    RtLine("    cmp esi, 0")
    RtLine("    jne rt_cat_b_ok")
    RtLine("    push str_empty")
    RtLine("    pop esi")
    RtLine("rt_cat_b_ok:")
    RtLine("    mov ebx, edi")
    RtLine("    sub ebx, 4")
    RtLine("    mov eax, " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK))
    RtLine("    and eax, 0x7FFFFFFF")
    RtLine("    mov ebx, esi")
    RtLine("    sub ebx, 4")
    RtLine("    mov edx, " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK))
    RtLine("    and edx, 0x7FFFFFFF")
    RtLine("    add eax, edx")
    RtLine("    push eax")
    RtLine("    add eax, 5")
    RtLine("    push eax")
    RtLine("    call _GetProcessHeap@0")
    RtLine("    pop ecx")
    RtLine("    push ecx")
    RtLine("    push 0")
    RtLine("    push eax")
    RtLine("    call _HeapAlloc@12")
    RtLine("    mov ebx, eax")
    RtLine("    pop edx")
    RtLine("    or edx, 0x80000000")
    RtLine("    mov " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK) + ", edx")
    RtLine("    push ebx")
    RtLine("    add ebx, 4")
    RtLine("    mov ecx, edi")
    RtLine("    sub ecx, 4")
    RtLine("    mov ecx, " + Chr$(CH_LBRACK) + "ecx" + Chr$(CH_RBRACK))
    RtLine("    and ecx, 0x7FFFFFFF")
    RtLine("rt_cat_copy_a:")
    RtLine("    cmp ecx, 0")
    RtLine("    je rt_cat_copy_b")
    RtLine("    movzx eax, " + Chr$(CH_LBRACK) + "edi" + Chr$(CH_RBRACK))
    RtLine("    mov " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK) + ", al")
    RtLine("    add edi, 1")
    RtLine("    add ebx, 1")
    RtLine("    sub ecx, 1")
    RtLine("    jmp rt_cat_copy_a")
    RtLine("rt_cat_copy_b:")
    RtLine("    mov ecx, esi")
    RtLine("    sub ecx, 4")
    RtLine("    mov ecx, " + Chr$(CH_LBRACK) + "ecx" + Chr$(CH_RBRACK))
    RtLine("    and ecx, 0x7FFFFFFF")
    RtLine("rt_cat_copy_b_loop:")
    RtLine("    cmp ecx, 0")
    RtLine("    je rt_cat_nul")
    RtLine("    movzx eax, " + Chr$(CH_LBRACK) + "esi" + Chr$(CH_RBRACK))
    RtLine("    mov " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK) + ", al")
    RtLine("    add esi, 1")
    RtLine("    add ebx, 1")
    RtLine("    sub ecx, 1")
    RtLine("    jmp rt_cat_copy_b_loop")
    RtLine("rt_cat_nul:")
    RtLine("    mov eax, 0")
    RtLine("    mov " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK) + ", al")
    RtLine("    pop eax")
    RtLine("    add eax, 4")
    RtLine("    pop edi")
    RtLine("    pop esi")
    RtLine("    pop ebx")
    RtLine("    mov esp, ebp")
    RtLine("    pop ebp")
    RtLine("    ret 8")

    RtLine("_rt_Left:")
    RtLine("    push ebp")
    RtLine("    mov ebp, esp")
    RtLine("    push ebx")
    RtLine("    push esi")
    RtLine("    push edi")
    RtLine("    mov ebx, ebp")
    RtLine("    add ebx, 8")
    RtLine("    mov edi, " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK))
    RtLine("    cmp edi, 0")
    RtLine("    jne rt_left_s_ok")
    RtLine("    push str_empty")
    RtLine("    pop edi")
    RtLine("rt_left_s_ok:")
    RtLine("    add ebx, 4")
    RtLine("    mov esi, " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK))
    RtLine("    cmp esi, 0")
    RtLine("    jge rt_left_n_ok")
    RtLine("    mov esi, 0")
    RtLine("rt_left_n_ok:")
    RtLine("    mov ebx, edi")
    RtLine("    sub ebx, 4")
    RtLine("    mov eax, " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK))
    RtLine("    and eax, 0x7FFFFFFF")
    RtLine("    cmp esi, eax")
    RtLine("    jle rt_left_count_ok")
    RtLine("    mov esi, eax")
    RtLine("rt_left_count_ok:")
    RtLine("    mov eax, esi")
    RtLine("    add eax, 5")
    RtLine("    push esi")
    RtLine("    push eax")
    RtLine("    call _GetProcessHeap@0")
    RtLine("    pop ecx")
    RtLine("    push ecx")
    RtLine("    push 0")
    RtLine("    push eax")
    RtLine("    call _HeapAlloc@12")
    RtLine("    mov ebx, eax")
    RtLine("    pop ecx")
    RtLine("    mov eax, ecx")
    RtLine("    or eax, 0x80000000")
    RtLine("    mov " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK) + ", eax")
    RtLine("    push ebx")
    RtLine("    add ebx, 4")
    RtLine("    mov edx, ebx")
    RtLine("rt_left_loop:")
    RtLine("    cmp ecx, 0")
    RtLine("    je rt_left_end")
    RtLine("    movzx eax, " + Chr$(CH_LBRACK) + "edi" + Chr$(CH_RBRACK))
    RtLine("    mov " + Chr$(CH_LBRACK) + "edx" + Chr$(CH_RBRACK) + ", al")
    RtLine("    add edi, 1")
    RtLine("    add edx, 1")
    RtLine("    sub ecx, 1")
    RtLine("    jmp rt_left_loop")
    RtLine("rt_left_end:")
    RtLine("    mov eax, 0")
    RtLine("    mov " + Chr$(CH_LBRACK) + "edx" + Chr$(CH_RBRACK) + ", al")
    RtLine("    pop eax")
    RtLine("    add eax, 4")
    RtLine("    pop edi")
    RtLine("    pop esi")
    RtLine("    pop ebx")
    RtLine("    mov esp, ebp")
    RtLine("    pop ebp")
    RtLine("    ret 8")

    RtLine("_rt_Mid:")
    RtLine("    push ebp")
    RtLine("    mov ebp, esp")
    RtLine("    push ebx")
    RtLine("    push esi")
    RtLine("    push edi")
    RtLine("    mov ebx, ebp")
    RtLine("    add ebx, 8")
    RtLine("    mov edi, " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK))
    RtLine("    cmp edi, 0")
    RtLine("    jne rt_mid_s_ok")
    RtLine("    push str_empty")
    RtLine("    pop edi")
    RtLine("rt_mid_s_ok:")
    RtLine("    add ebx, 4")
    RtLine("    mov esi, " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK))
    RtLine("    sub esi, 1")
    RtLine("    cmp esi, 0")
    RtLine("    jge rt_mid_start_ok")
    RtLine("    mov esi, 0")
    RtLine("rt_mid_start_ok:")
    RtLine("    add ebx, 4")
    RtLine("    mov edx, " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK))
    RtLine("    mov ebx, edi")
    RtLine("    sub ebx, 4")
    RtLine("    mov eax, " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK))
    RtLine("    and eax, 0x7FFFFFFF")
    RtLine("    sub eax, esi")
    RtLine("    cmp eax, 0")
    RtLine("    jge rt_mid_rem_ok")
    RtLine("    mov eax, 0")
    RtLine("rt_mid_rem_ok:")
    RtLine("    cmp edx, 0")
    RtLine("    jl rt_mid_count_ok")
    RtLine("    cmp edx, eax")
    RtLine("    jle rt_mid_use_len")
    RtLine("rt_mid_count_ok:")
    RtLine("    mov edx, eax")
    RtLine("rt_mid_use_len:")
    RtLine("    add edi, esi")
    RtLine("    mov esi, edx")
    RtLine("    mov eax, esi")
    RtLine("    add eax, 5")
    RtLine("    push esi")
    RtLine("    push eax")
    RtLine("    call _GetProcessHeap@0")
    RtLine("    pop ecx")
    RtLine("    push ecx")
    RtLine("    push 0")
    RtLine("    push eax")
    RtLine("    call _HeapAlloc@12")
    RtLine("    mov ebx, eax")
    RtLine("    pop ecx")
    RtLine("    mov eax, ecx")
    RtLine("    or eax, 0x80000000")
    RtLine("    mov " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK) + ", eax")
    RtLine("    push ebx")
    RtLine("    add ebx, 4")
    RtLine("    mov edx, ebx")
    RtLine("rt_mid_loop:")
    RtLine("    cmp ecx, 0")
    RtLine("    je rt_mid_end")
    RtLine("    movzx eax, " + Chr$(CH_LBRACK) + "edi" + Chr$(CH_RBRACK))
    RtLine("    mov " + Chr$(CH_LBRACK) + "edx" + Chr$(CH_RBRACK) + ", al")
    RtLine("    add edi, 1")
    RtLine("    add edx, 1")
    RtLine("    sub ecx, 1")
    RtLine("    jmp rt_mid_loop")
    RtLine("rt_mid_end:")
    RtLine("    mov eax, 0")
    RtLine("    mov " + Chr$(CH_LBRACK) + "edx" + Chr$(CH_RBRACK) + ", al")
    RtLine("    pop eax")
    RtLine("    add eax, 4")
    RtLine("    pop edi")
    RtLine("    pop esi")
    RtLine("    pop ebx")
    RtLine("    mov esp, ebp")
    RtLine("    pop ebp")
    RtLine("    ret 12")

    SbAppendStr(VarPtr(gSbData), "    rt_crlf db 13, 10")
    SbAppendCRLF(VarPtr(gSbData))

    ' Str$(n) ― 符号付き十進（長さプレフィックス）
    RtLine("_rt_Str:")
    RtLine("    push ebp")
    RtLine("    mov ebp, esp")
    RtLine("    push ebx")
    RtLine("    push esi")
    RtLine("    push edi")
    RtLine("    mov ebx, ebp")
    RtLine("    add ebx, 8")
    RtLine("    mov esi, " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK))
    RtLine("    call _GetProcessHeap@0")
    RtLine("    push 20")
    RtLine("    push 0")
    RtLine("    push eax")
    RtLine("    call _HeapAlloc@12")
    RtLine("    mov edi, eax")
    RtLine("    mov ebx, eax")
    RtLine("    add ebx, 19")
    RtLine("    mov eax, 0")
    RtLine("    mov " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK) + ", al")
    RtLine("    sub ebx, 1")
    RtLine("    mov eax, esi")
    RtLine("    cmp eax, 0")
    RtLine("    jge rt_str_pos")
    RtLine("    xor edx, edx")
    RtLine("    sub edx, eax")
    RtLine("    mov eax, edx")
    RtLine("    push 1")
    RtLine("    jmp rt_str_go")
    RtLine("rt_str_pos:")
    RtLine("    push 0")
    RtLine("rt_str_go:")
    RtLine("rt_str_dig:")
    RtLine("    mov ecx, 10")
    RtLine("    xor edx, edx")
    RtLine("    div ecx")
    RtLine("    add edx, 48")
    RtLine("    mov " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK) + ", dl")
    RtLine("    sub ebx, 1")
    RtLine("    cmp eax, 0")
    RtLine("    jne rt_str_dig")
    RtLine("    pop ecx")
    RtLine("    cmp ecx, 0")
    RtLine("    je rt_str_nosign")
    RtLine("    mov eax, 45")
    RtLine("    mov " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK) + ", al")
    RtLine("    sub ebx, 1")
    RtLine("rt_str_nosign:")
    RtLine("    add ebx, 1")
    RtLine("    mov eax, edi")
    RtLine("    add eax, 19")
    RtLine("    sub eax, ebx")
    RtLine("    or eax, 0x80000000")
    RtLine("    mov edx, ebx")
    RtLine("    sub edx, 4")
    RtLine("    mov " + Chr$(CH_LBRACK) + "edx" + Chr$(CH_RBRACK) + ", eax")
    RtLine("    mov eax, ebx")
    RtLine("    pop edi")
    RtLine("    pop esi")
    RtLine("    pop ebx")
    RtLine("    mov esp, ebp")
    RtLine("    pop ebp")
    RtLine("    ret 4")

    ' Hex$(n) ― 必要桁の大文字 hex（長さプレフィックス）
    RtLine("_rt_Hex:")
    RtLine("    push ebp")
    RtLine("    mov ebp, esp")
    RtLine("    push ebx")
    RtLine("    push esi")
    RtLine("    push edi")
    RtLine("    mov ebx, ebp")
    RtLine("    add ebx, 8")
    RtLine("    mov esi, " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK))
    RtLine("    call _GetProcessHeap@0")
    RtLine("    push 16")
    RtLine("    push 0")
    RtLine("    push eax")
    RtLine("    call _HeapAlloc@12")
    RtLine("    mov edi, eax")
    RtLine("    mov ebx, eax")
    RtLine("    add ebx, 15")
    RtLine("    mov eax, 0")
    RtLine("    mov " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK) + ", al")
    RtLine("    sub ebx, 1")
    RtLine("    mov eax, esi")
    RtLine("rt_hex_dig:")
    RtLine("    mov edx, eax")
    RtLine("    and edx, 15")
    RtLine("    cmp edx, 10")
    RtLine("    jl rt_hex_dec")
    RtLine("    add edx, 55")
    RtLine("    jmp rt_hex_store")
    RtLine("rt_hex_dec:")
    RtLine("    add edx, 48")
    RtLine("rt_hex_store:")
    RtLine("    mov " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK) + ", dl")
    RtLine("    sub ebx, 1")
    RtLine("    shr eax, 4")
    RtLine("    cmp eax, 0")
    RtLine("    jne rt_hex_dig")
    RtLine("    add ebx, 1")
    RtLine("    mov eax, edi")
    RtLine("    add eax, 15")
    RtLine("    sub eax, ebx")
    RtLine("    or eax, 0x80000000")
    RtLine("    mov edx, ebx")
    RtLine("    sub edx, 4")
    RtLine("    mov " + Chr$(CH_LBRACK) + "edx" + Chr$(CH_RBRACK) + ", eax")
    RtLine("    mov eax, ebx")
    RtLine("    pop edi")
    RtLine("    pop esi")
    RtLine("    pop ebx")
    RtLine("    mov esp, ebp")
    RtLine("    pop ebp")
    RtLine("    ret 4")

    ' Print s ― stdout + CRLF（長さはプレフィックス）
    RtLine("_rt_Print:")
    RtLine("    push ebp")
    RtLine("    mov ebp, esp")
    RtLine("    sub esp, 8")
    RtLine("    push ebx")
    RtLine("    push esi")
    RtLine("    push -11")
    RtLine("    call _GetStdHandle@4")
    RtLine("    mov ebx, eax")
    RtLine("    mov esi, ebp")
    RtLine("    add esi, 8")
    RtLine("    mov eax, " + Chr$(CH_LBRACK) + "esi" + Chr$(CH_RBRACK))
    RtLine("    cmp eax, 0")
    RtLine("    je rt_print_nl")
    RtLine("    mov esi, eax")
    RtLine("    mov edx, esi")
    RtLine("    sub edx, 4")
    RtLine("    mov eax, " + Chr$(CH_LBRACK) + "edx" + Chr$(CH_RBRACK))
    RtLine("    and eax, 0x7FFFFFFF")
    RtLine("    mov edx, ebp")
    RtLine("    sub edx, 4")
    RtLine("    push 0")
    RtLine("    push edx")
    RtLine("    push eax")
    RtLine("    push esi")
    RtLine("    push ebx")
    RtLine("    call _WriteFile@20")
    RtLine("rt_print_nl:")
    RtLine("    mov edx, ebp")
    RtLine("    sub edx, 4")
    RtLine("    push 0")
    RtLine("    push edx")
    RtLine("    push 2")
    RtLine("    push rt_crlf")
    RtLine("    push ebx")
    RtLine("    call _WriteFile@20")
    RtLine("    pop esi")
    RtLine("    pop ebx")
    RtLine("    mov esp, ebp")
    RtLine("    pop ebp")
    RtLine("    ret 4")

    ' Val(s) ― 先頭の符号付き十進を Long に
    RtLine("_rt_Val:")
    RtLine("    push ebp")
    RtLine("    mov ebp, esp")
    RtLine("    push ebx")
    RtLine("    push esi")
    RtLine("    mov ebx, ebp")
    RtLine("    add ebx, 8")
    RtLine("    mov esi, " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK))
    RtLine("    xor eax, eax")
    RtLine("    mov edx, 0")
    RtLine("    cmp esi, 0")
    RtLine("    je rt_val_done")
    RtLine("rt_val_sp:")
    RtLine("    movzx ecx, " + Chr$(CH_LBRACK) + "esi" + Chr$(CH_RBRACK))
    RtLine("    cmp ecx, 32")
    RtLine("    jne rt_val_sign")
    RtLine("    add esi, 1")
    RtLine("    jmp rt_val_sp")
    RtLine("rt_val_sign:")
    RtLine("    cmp ecx, 45")
    RtLine("    jne rt_val_plus")
    RtLine("    mov edx, 1")
    RtLine("    add esi, 1")
    RtLine("    jmp rt_val_dig")
    RtLine("rt_val_plus:")
    RtLine("    cmp ecx, 43")
    RtLine("    jne rt_val_dig")
    RtLine("    add esi, 1")
    RtLine("rt_val_dig:")
    RtLine("    movzx ecx, " + Chr$(CH_LBRACK) + "esi" + Chr$(CH_RBRACK))
    RtLine("    cmp ecx, 48")
    RtLine("    jl rt_val_end")
    RtLine("    cmp ecx, 57")
    RtLine("    jg rt_val_end")
    RtLine("    sub ecx, 48")
    RtLine("    mov ebx, 10")
    RtLine("    imul eax, ebx")
    RtLine("    add eax, ecx")
    RtLine("    add esi, 1")
    RtLine("    jmp rt_val_dig")
    RtLine("rt_val_end:")
    RtLine("    cmp edx, 0")
    RtLine("    je rt_val_done")
    RtLine("    neg eax")
    RtLine("rt_val_done:")
    RtLine("    pop esi")
    RtLine("    pop ebx")
    RtLine("    mov esp, ebp")
    RtLine("    pop ebp")
    RtLine("    ret 4")

    ' Input$ ― stdin から1行（長さプレフィックス付きヒープ文字列）
    RtLine("_rt_Input:")
    RtLine("    push ebp")
    RtLine("    mov ebp, esp")
    RtLine("    sub esp, 8")
    RtLine("    push ebx")
    RtLine("    push esi")
    RtLine("    push edi")
    RtLine("    call _GetProcessHeap@0")
    RtLine("    push 260")
    RtLine("    push 0")
    RtLine("    push eax")
    RtLine("    call _HeapAlloc@12")
    RtLine("    mov edi, eax")
    RtLine("    cmp eax, 0")
    RtLine("    je rt_input_fail")
    RtLine("    push -10")
    RtLine("    call _GetStdHandle@4")
    RtLine("    mov ebx, eax")
    RtLine("    mov esi, 0")
    RtLine("rt_input_loop:")
    RtLine("    cmp esi, 255")
    RtLine("    jge rt_input_done")
    RtLine("    mov edx, ebp")
    RtLine("    sub edx, 4")
    RtLine("    mov ecx, ebp")
    RtLine("    sub ecx, 8")
    RtLine("    push 0")
    RtLine("    push edx")
    RtLine("    push 1")
    RtLine("    push ecx")
    RtLine("    push ebx")
    RtLine("    call _ReadFile@20")
    RtLine("    cmp eax, 0")
    RtLine("    je rt_input_done")
    RtLine("    mov edx, ebp")
    RtLine("    sub edx, 4")
    RtLine("    mov eax, " + Chr$(CH_LBRACK) + "edx" + Chr$(CH_RBRACK))
    RtLine("    cmp eax, 0")
    RtLine("    je rt_input_done")
    RtLine("    mov edx, ebp")
    RtLine("    sub edx, 8")
    RtLine("    movzx eax, " + Chr$(CH_LBRACK) + "edx" + Chr$(CH_RBRACK))
    RtLine("    cmp eax, 13")
    RtLine("    je rt_input_loop")
    RtLine("    cmp eax, 10")
    RtLine("    je rt_input_done")
    RtLine("    mov ecx, edi")
    RtLine("    add ecx, 4")
    RtLine("    add ecx, esi")
    RtLine("    mov " + Chr$(CH_LBRACK) + "ecx" + Chr$(CH_RBRACK) + ", al")
    RtLine("    add esi, 1")
    RtLine("    jmp rt_input_loop")
    RtLine("rt_input_done:")
    RtLine("    mov eax, esi")
    RtLine("    or eax, 0x80000000")
    RtLine("    mov " + Chr$(CH_LBRACK) + "edi" + Chr$(CH_RBRACK) + ", eax")
    RtLine("    mov ecx, edi")
    RtLine("    add ecx, 4")
    RtLine("    add ecx, esi")
    RtLine("    mov eax, 0")
    RtLine("    mov " + Chr$(CH_LBRACK) + "ecx" + Chr$(CH_RBRACK) + ", al")
    RtLine("    mov eax, edi")
    RtLine("    add eax, 4")
    RtLine("    jmp rt_input_ret")
    RtLine("rt_input_fail:")
    RtLine("    mov eax, 0")
    RtLine("rt_input_ret:")
    RtLine("    pop edi")
    RtLine("    pop esi")
    RtLine("    pop ebx")
    RtLine("    mov esp, ebp")
    RtLine("    pop ebp")
    RtLine("    ret")
End Sub

' MakeStr / InStr / memcpy / malloc / calloc / free（ホスト組み込み互換）
Sub EnsureHostRt()
    If gUseHostRt <> 0 Then Exit Sub
    gUseHostRt = 1
    EnsureStringRt()
    If InStr(1, gApiExternLines, "extern _GetProcessHeap@0" + Chr$(CH_CR)) = 0 Then
        gApiExternLines = gApiExternLines + "extern _GetProcessHeap@0" + Chr$(CH_CR) + Chr$(CH_NL)
    End If
    If InStr(1, gApiExternLines, "extern _HeapAlloc@12" + Chr$(CH_CR)) = 0 Then
        gApiExternLines = gApiExternLines + "extern _HeapAlloc@12" + Chr$(CH_CR) + Chr$(CH_NL)
    End If
    If InStr(1, gApiExternLines, "extern _HeapFree@12" + Chr$(CH_CR)) = 0 Then
        gApiExternLines = gApiExternLines + "extern _HeapFree@12" + Chr$(CH_CR) + Chr$(CH_NL)
    End If
    If InStr(1, gApiExternLines, "extern _lstrlenA@4" + Chr$(CH_CR)) = 0 Then
        gApiExternLines = gApiExternLines + "extern _lstrlenA@4" + Chr$(CH_CR) + Chr$(CH_NL)
    End If
    If InStr(1, gApiExternLines, "extern _lstrcpyA@8" + Chr$(CH_CR)) = 0 Then
        gApiExternLines = gApiExternLines + "extern _lstrcpyA@8" + Chr$(CH_CR) + Chr$(CH_NL)
    End If

    ' malloc(n) -> eax
    RtLine("_rt_Malloc:")
    RtLine("    push ebp")
    RtLine("    mov ebp, esp")
    RtLine("    mov ebx, ebp")
    RtLine("    add ebx, 8")
    RtLine("    mov eax, " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK))
    RtLine("    push eax")
    RtLine("    push 0")
    RtLine("    call _GetProcessHeap@0")
    RtLine("    push eax")
    RtLine("    call _HeapAlloc@12")
    RtLine("    mov esp, ebp")
    RtLine("    pop ebp")
    RtLine("    ret 4")

    ' calloc(n) -> eax（HEAP_ZERO_MEMORY=8 でゼロ埋め確保）
    RtLine("_rt_Calloc:")
    RtLine("    push ebp")
    RtLine("    mov ebp, esp")
    RtLine("    mov ebx, ebp")
    RtLine("    add ebx, 8")
    RtLine("    mov eax, " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK))
    RtLine("    push eax")
    RtLine("    push 8")
    RtLine("    call _GetProcessHeap@0")
    RtLine("    push eax")
    RtLine("    call _HeapAlloc@12")
    RtLine("    mov esp, ebp")
    RtLine("    pop ebp")
    RtLine("    ret 4")

    ' free(p)
    RtLine("_rt_Free:")
    RtLine("    push ebp")
    RtLine("    mov ebp, esp")
    RtLine("    mov ebx, ebp")
    RtLine("    add ebx, 8")
    RtLine("    mov eax, " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK))
    RtLine("    cmp eax, 0")
    RtLine("    je rt_free_done")
    RtLine("    push eax")
    RtLine("    push 0")
    RtLine("    call _GetProcessHeap@0")
    RtLine("    push eax")
    RtLine("    call _HeapFree@12")
    RtLine("rt_free_done:")
    RtLine("    mov esp, ebp")
    RtLine("    pop ebp")
    RtLine("    ret 4")

    ' memcpy(dst, src, n) ― stdcall 右から push 済み
    RtLine("_rt_Memcpy:")
    RtLine("    push ebp")
    RtLine("    mov ebp, esp")
    RtLine("    push ebx")
    RtLine("    push esi")
    RtLine("    push edi")
    RtLine("    mov ebx, ebp")
    RtLine("    add ebx, 8")
    RtLine("    mov edi, " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK))
    RtLine("    add ebx, 4")
    RtLine("    mov esi, " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK))
    RtLine("    add ebx, 4")
    RtLine("    mov ecx, " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK))
    RtLine("rt_memcpy_loop:")
    RtLine("    cmp ecx, 0")
    RtLine("    je rt_memcpy_done")
    RtLine("    movzx eax, " + Chr$(CH_LBRACK) + "esi" + Chr$(CH_RBRACK))
    RtLine("    mov " + Chr$(CH_LBRACK) + "edi" + Chr$(CH_RBRACK) + ", al")
    RtLine("    add esi, 1")
    RtLine("    add edi, 1")
    RtLine("    sub ecx, 1")
    RtLine("    jmp rt_memcpy_loop")
    RtLine("rt_memcpy_done:")
    RtLine("    mov ebx, ebp")
    RtLine("    add ebx, 8")
    RtLine("    mov eax, " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK))
    RtLine("    pop edi")
    RtLine("    pop esi")
    RtLine("    pop ebx")
    RtLine("    mov esp, ebp")
    RtLine("    pop ebp")
    RtLine("    ret 12")

    ' FillMemory(dst, n, fill) ― stdcall
    RtLine("_rt_FillMemory:")
    RtLine("    push ebp")
    RtLine("    mov ebp, esp")
    RtLine("    push ebx")
    RtLine("    push edi")
    RtLine("    mov ebx, ebp")
    RtLine("    add ebx, 8")
    RtLine("    mov edi, " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK))
    RtLine("    add ebx, 4")
    RtLine("    mov ecx, " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK))
    RtLine("    add ebx, 4")
    RtLine("    movzx eax, " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK))
    RtLine("rt_fill_loop:")
    RtLine("    cmp ecx, 0")
    RtLine("    je rt_fill_done")
    RtLine("    mov " + Chr$(CH_LBRACK) + "edi" + Chr$(CH_RBRACK) + ", al")
    RtLine("    add edi, 1")
    RtLine("    sub ecx, 1")
    RtLine("    jmp rt_fill_loop")
    RtLine("rt_fill_done:")
    RtLine("    pop edi")
    RtLine("    pop ebx")
    RtLine("    mov esp, ebp")
    RtLine("    pop ebp")
    RtLine("    ret 12")

    ' MakeStr(p) ― NUL 終端 BytePtr から長さ付き String を複製
    RtLine("_rt_MakeStr:")
    RtLine("    push ebp")
    RtLine("    mov ebp, esp")
    RtLine("    push ebx")
    RtLine("    push esi")
    RtLine("    push edi")
    RtLine("    mov ebx, ebp")
    RtLine("    add ebx, 8")
    RtLine("    mov esi, " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK))
    RtLine("    cmp esi, 0")
    RtLine("    jne rt_makestr_ok")
    RtLine("    push str_empty")
    RtLine("    pop eax")
    RtLine("    jmp rt_makestr_done")
    RtLine("rt_makestr_ok:")
    RtLine("    push esi")
    RtLine("    call _lstrlenA@4")
    RtLine("    mov ebx, eax")
    RtLine("    add eax, 5")
    RtLine("    push ebx")
    RtLine("    push eax")
    RtLine("    call _GetProcessHeap@0")
    RtLine("    pop ecx")
    RtLine("    push ecx")
    RtLine("    push 0")
    RtLine("    push eax")
    RtLine("    call _HeapAlloc@12")
    RtLine("    mov edi, eax")
    RtLine("    pop ebx")
    RtLine("    mov eax, ebx")
    RtLine("    or eax, 0x80000000")
    RtLine("    mov " + Chr$(CH_LBRACK) + "edi" + Chr$(CH_RBRACK) + ", eax")
    RtLine("    push edi")
    RtLine("    add edi, 4")
    RtLine("    mov ecx, ebx")
    RtLine("rt_makestr_copy:")
    RtLine("    cmp ecx, 0")
    RtLine("    je rt_makestr_nul")
    RtLine("    movzx eax, " + Chr$(CH_LBRACK) + "esi" + Chr$(CH_RBRACK))
    RtLine("    mov " + Chr$(CH_LBRACK) + "edi" + Chr$(CH_RBRACK) + ", al")
    RtLine("    add esi, 1")
    RtLine("    add edi, 1")
    RtLine("    sub ecx, 1")
    RtLine("    jmp rt_makestr_copy")
    RtLine("rt_makestr_nul:")
    RtLine("    mov eax, 0")
    RtLine("    mov " + Chr$(CH_LBRACK) + "edi" + Chr$(CH_RBRACK) + ", al")
    RtLine("    pop eax")
    RtLine("    add eax, 4")
    RtLine("rt_makestr_done:")
    RtLine("    pop edi")
    RtLine("    pop esi")
    RtLine("    pop ebx")
    RtLine("    mov esp, ebp")
    RtLine("    pop ebp")
    RtLine("    ret 4")

    ' InStr(start, hay, needle) ― 1-based、無ければ 0
    RtLine("_rt_InStr:")
    RtLine("    push ebp")
    RtLine("    mov ebp, esp")
    RtLine("    push ebx")
    RtLine("    push esi")
    RtLine("    push edi")
    RtLine("    mov ebx, ebp")
    RtLine("    add ebx, 8")
    RtLine("    mov eax, " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK))
    RtLine("    add ebx, 4")
    RtLine("    mov esi, " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK))
    RtLine("    add ebx, 4")
    RtLine("    mov edi, " + Chr$(CH_LBRACK) + "ebx" + Chr$(CH_RBRACK))
    RtLine("    cmp esi, 0")
    RtLine("    je rt_instr_zero")
    RtLine("    cmp edi, 0")
    RtLine("    je rt_instr_zero")
    RtLine("    cmp eax, 1")
    RtLine("    jge rt_instr_start_ok")
    RtLine("    mov eax, 1")
    RtLine("rt_instr_start_ok:")
    RtLine("    sub eax, 1")
    RtLine("    add esi, eax")
    RtLine("    mov ebx, eax")
    RtLine("rt_instr_outer:")
    RtLine("    movzx eax, " + Chr$(CH_LBRACK) + "esi" + Chr$(CH_RBRACK))
    RtLine("    cmp eax, 0")
    RtLine("    je rt_instr_zero")
    RtLine("    push esi")
    RtLine("    push edi")
    RtLine("    mov edx, edi")
    RtLine("rt_instr_inner:")
    RtLine("    movzx eax, " + Chr$(CH_LBRACK) + "edx" + Chr$(CH_RBRACK))
    RtLine("    cmp eax, 0")
    RtLine("    je rt_instr_found")
    RtLine("    movzx ecx, " + Chr$(CH_LBRACK) + "esi" + Chr$(CH_RBRACK))
    RtLine("    cmp ecx, 0")
    RtLine("    je rt_instr_next")
    RtLine("    cmp eax, ecx")
    RtLine("    jne rt_instr_next")
    RtLine("    add esi, 1")
    RtLine("    add edx, 1")
    RtLine("    jmp rt_instr_inner")
    RtLine("rt_instr_next:")
    RtLine("    pop edi")
    RtLine("    pop esi")
    RtLine("    add esi, 1")
    RtLine("    add ebx, 1")
    RtLine("    jmp rt_instr_outer")
    RtLine("rt_instr_found:")
    RtLine("    pop edi")
    RtLine("    pop esi")
    RtLine("    mov eax, ebx")
    RtLine("    add eax, 1")
    RtLine("    jmp rt_instr_done")
    RtLine("rt_instr_zero:")
    RtLine("    mov eax, 0")
    RtLine("rt_instr_done:")
    RtLine("    pop edi")
    RtLine("    pop esi")
    RtLine("    pop ebx")
    RtLine("    mov esp, ebp")
    RtLine("    pop ebp")
    RtLine("    ret 12")
End Sub

