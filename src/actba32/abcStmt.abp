' abcStmt.abp - 文の Parse 中に Emit（ソース全体レキシング後）

Const SK_DIM_SPAN = 1
Const SK_CONST_SPAN = 2
Const SK_TYPE_SPAN = 3
Const SK_TYPEDEF_SPAN = 4
Const SK_TYPEFIELD_SPAN = 5
Const SK_TYPEEND = 6
Const SK_ASSIGN = 7
Const SK_CALL = 8
Const SK_PRINT = 9
Const SK_INPUT = 10
Const SK_MSGBOX = 11
Const SK_EXITPROCESS = 12
Const SK_END_PROG = 13
Const SK_IF = 14
Const SK_ELSEIF = 15
Const SK_ELSE = 16
Const SK_ENDIF = 17
Const SK_WHILE = 18
Const SK_WEND = 19
Const SK_DO = 20
Const SK_LOOP = 21
Const SK_FOR_SPAN = 22
Const SK_NEXT = 23
Const SK_SELECT_SPAN = 24
Const SK_CASE_SPAN = 25
Const SK_ENDSELECT = 26
Const SK_EXIT_WHILE = 27
Const SK_EXIT_DO = 28
Const SK_EXIT_FOR = 29
Const SK_EXIT_PROC = 30
Const SK_SUB_SPAN = 31
Const SK_FUNC_SPAN = 32
Const SK_ENDPROC = 33
Const SK_IGNORE = 34

' Do/Loop Flags: 0=bare, 1=While, 2=Until
Const DOF_BARE = 0
Const DOF_WHILE = 1
Const DOF_UNTIL = 2

' LexExpr が gAst/gPool を壊すので SPAN 用に退避（現行 LexExpr は保全するが保険）
Dim gParseInType As Long
Dim gParseLineLo As Long
Dim gSbTokJoin As StringBuffer
Dim gSbTokJoinReady As Long

Sub TokSkipEols()
    While TokPeek() = TK_EOL
        TokTake()
    Wend
End Sub

Function TokAtEol() As Long
    Dim k As Long
    k = TokPeek()
    If k = TK_EOL Or k = TK_EOF Then
        TokAtEol = 1
    Else
        TokAtEol = 0
    End If
End Function

Function TokKindText$(k As Long) As String
    If k = TK_PLUS Then
        TokKindText$ = "+"
    ElseIf k = TK_MINUS Then
        TokKindText$ = "-"
    ElseIf k = TK_STAR Then
        TokKindText$ = "*"
    ElseIf k = TK_SLASH Then
        TokKindText$ = "/"
    ElseIf k = TK_BSLASH Then
        TokKindText$ = Chr$(CH_BSLASH)
    ElseIf k = TK_EQ Then
        TokKindText$ = "="
    ElseIf k = TK_NE Then
        TokKindText$ = "<>"
    ElseIf k = TK_LT Then
        TokKindText$ = "<"
    ElseIf k = TK_GT Then
        TokKindText$ = ">"
    ElseIf k = TK_LE Then
        TokKindText$ = "<="
    ElseIf k = TK_GE Then
        TokKindText$ = ">="
    ElseIf k = TK_LPAREN Then
        TokKindText$ = "("
    ElseIf k = TK_RPAREN Then
        TokKindText$ = ")"
    ElseIf k = TK_LBRACK Then
        TokKindText$ = "["
    ElseIf k = TK_RBRACK Then
        TokKindText$ = "]"
    ElseIf k = TK_COMMA Then
        TokKindText$ = ","
    ElseIf k = TK_DOT Then
        TokKindText$ = "."
    ElseIf k = TK_ARROW Then
        TokKindText$ = "->"
    ElseIf k = TK_AND Then
        TokKindText$ = "And"
    ElseIf k = TK_OR Then
        TokKindText$ = "Or"
    ElseIf k = TK_XOR Then
        TokKindText$ = "Xor"
    ElseIf k = TK_MOD Then
        TokKindText$ = "Mod"
    ElseIf k = TK_IF Then
        TokKindText$ = "If"
    ElseIf k = TK_THEN Then
        TokKindText$ = "Then"
    ElseIf k = TK_ELSE Then
        TokKindText$ = "Else"
    ElseIf k = TK_ELSEIF Then
        TokKindText$ = "ElseIf"
    ElseIf k = TK_END Then
        TokKindText$ = "End"
    ElseIf k = TK_DIM Then
        TokKindText$ = "Dim"
    ElseIf k = TK_CONST Then
        TokKindText$ = "Const"
    ElseIf k = TK_TYPE Then
        TokKindText$ = "Type"
    ElseIf k = TK_TYPEDEF Then
        TokKindText$ = "TypeDef"
    ElseIf k = TK_SUB Then
        TokKindText$ = "Sub"
    ElseIf k = TK_FUNCTION Then
        TokKindText$ = "Function"
    ElseIf k = TK_WHILE Then
        TokKindText$ = "While"
    ElseIf k = TK_WEND Then
        TokKindText$ = "Wend"
    ElseIf k = TK_FOR Then
        TokKindText$ = "For"
    ElseIf k = TK_NEXT Then
        TokKindText$ = "Next"
    ElseIf k = TK_DO Then
        TokKindText$ = "Do"
    ElseIf k = TK_LOOP Then
        TokKindText$ = "Loop"
    ElseIf k = TK_UNTIL Then
        TokKindText$ = "Until"
    ElseIf k = TK_SELECT Then
        TokKindText$ = "Select"
    ElseIf k = TK_CASE Then
        TokKindText$ = "Case"
    ElseIf k = TK_EXIT Then
        TokKindText$ = "Exit"
    ElseIf k = TK_PRINT Then
        TokKindText$ = "Print"
    ElseIf k = TK_INPUT Then
        TokKindText$ = "Input"
    ElseIf k = TK_AS Then
        TokKindText$ = "As"
    ElseIf k = TK_BYREF Then
        TokKindText$ = "ByRef"
    ElseIf k = TK_BYVAL Then
        TokKindText$ = "ByVal"
    ElseIf k = TK_TO Then
        TokKindText$ = "To"
    ElseIf k = TK_STEP Then
        TokKindText$ = "Step"
    ElseIf k = TK_VARPTR Then
        TokKindText$ = "VarPtr"
    ElseIf k = TK_ADDRESSOF Then
        TokKindText$ = "AddressOf"
    ElseIf k = TK_SIZEOF Then
        TokKindText$ = "SizeOf"
    Else
        TokKindText$ = ""
    End If
End Function

Function TokTextAt$(i As Long) As String
    Dim k As Long
    Dim sIdx As Long
    If i < 0 Or i >= gNTok Then
        TokTextAt$ = ""
        Exit Function
    End If
    k = gTok[i].Kind
    If k = TK_NUM Then
        TokTextAt$ = Trim$(Str$(gTok[i].IVal))
        Exit Function
    End If
    If k = TK_STR Then
        sIdx = gTok[i].SIdx
        If sIdx >= 0 And sIdx < gNPool Then
            TokTextAt$ = Chr$(CH_DQUOTE) + gPool(sIdx) + Chr$(CH_DQUOTE)
        Else
            TokTextAt$ = Chr$(CH_DQUOTE) + Chr$(CH_DQUOTE)
        End If
        Exit Function
    End If
    If k = TK_IDENT Then
        sIdx = TokIdentSIdx(i)
        If sIdx >= 0 And sIdx < gNPool Then
            TokTextAt$ = gPool(sIdx)
        Else
            TokTextAt$ = ""
        End If
        Exit Function
    End If
    TokTextAt$ = TokKindText$(k)
End Function

Function TokJoinNeedSpace(prevKind As Long, nextKind As Long) As Long
    TokJoinNeedSpace = 1
    If prevKind = TK_LPAREN Or prevKind = TK_LBRACK Or prevKind = TK_DOT Or prevKind = TK_ARROW Then
        TokJoinNeedSpace = 0
        Exit Function
    End If
    If nextKind = TK_RPAREN Or nextKind = TK_RBRACK Or nextKind = TK_COMMA Then
        TokJoinNeedSpace = 0
        Exit Function
    End If
    ' 負数: -1
    If prevKind = TK_MINUS And nextKind = TK_NUM Then
        TokJoinNeedSpace = 0
        Exit Function
    End If
    ' ポインタ型: *Byte
    If prevKind = TK_STAR And nextKind = TK_IDENT Then
        TokJoinNeedSpace = 0
        Exit Function
    End If
End Function

Function TokJoinSpanToSb(lo As Long, hi As Long) As Long
    Dim i As Long
    Dim t As String
    Dim prevKind As Long
    Dim k As Long
    Dim sp As String
    Dim p As *Byte
    TokJoinSpanToSb = 0
    If gSbTokJoinReady = 0 Then
        SbInit(VarPtr(gSbTokJoin))
        gSbTokJoinReady = 1
    End If
    SbClear(VarPtr(gSbTokJoin))
    prevKind = -1
    sp = " "
    i = lo
    While i < hi And i < gNTok
        k = gTok[i].Kind
        If k = TK_EOL Or k = TK_EOF Then Exit While
        t = TokTextAt$(i)
        If t <> "" Then
            If prevKind >= 0 Then
                If TokJoinNeedSpace(prevKind, k) <> 0 Then
                    SbAppendStr(VarPtr(gSbTokJoin), sp)
                End If
            End If
            SbAppendStr(VarPtr(gSbTokJoin), t)
            prevKind = k
        End If
        i = i + 1
    Wend
    p = gSbTokJoin.p
    If p <> 0 Then
        p[gSbTokJoin.len] = 0
    End If
    TokJoinSpanToSb = 1
End Function

Function TokJoinSpan$(lo As Long, hi As Long) As String
    If TokJoinSpanToSb(lo, hi) = 0 Then
        TokJoinSpan$ = ""
        Exit Function
    End If
    TokJoinSpan$ = SbToString$(VarPtr(gSbTokJoin))
End Function

Function TokLineStr$() As String
    Dim hi As Long
    hi = gTokPos
    While hi < gNTok
        If gTok[hi].Kind = TK_EOL Or gTok[hi].Kind = TK_EOF Then Exit While
        hi = hi + 1
    Wend
    TokLineStr$ = TokJoinSpan$(gTokPos, hi)
End Function

Function ParseSpanEmitNow(kind As Long) As Long
    Dim lo As Long
    Dim hi As Long
    Dim lineNo As Long
    Dim srcLo As Long
    Dim srcHi As Long
    ParseSpanEmitNow = 0
    lo = gTokPos
    If lo < gNTok Then
        lineNo = gTok[lo].LineNo
        srcLo = gTok[lo].SrcPos
    Else
        lineNo = gSrcLine
        srcLo = 0
    End If
    gSrcLine = lineNo
    While TokAtEol() = 0
        TokTake()
    Wend
    hi = gTokPos
    If hi > lo Then
        srcHi = gTok[hi - 1].SrcEnd
    Else
        srcHi = srcLo
    End If
    If EmitSpanCall(srcLo, srcHi, kind) = 0 Then Exit Function
    ParseSpanEmitNow = 1
End Function

Function ParseExpectThen() As Long
    ParseExpectThen = 0
    If TokPeek() <> TK_THEN Then
        Print "If/ElseIf needs Then"
        Exit Function
    End If
    TokTake()
    ParseExpectThen = 1
End Function

Function ParseTrailingAfterThen() As Long
    ParseTrailingAfterThen = 0
    If TokAtEol() <> 0 Then
        ParseTrailingAfterThen = 1
        Exit Function
    End If
    If ParseOneStmt() = 0 Then Exit Function
    If TokPeek() = TK_ELSE Then
        TokTake()
        If CompileElse() = 0 Then Exit Function
        If TokAtEol() <> 0 Then
            Print "Else needs statement"
            Exit Function
        End If
        If ParseOneStmt() = 0 Then Exit Function
    End If
    If CompileEndIf() = 0 Then Exit Function
    ParseTrailingAfterThen = 1
End Function

Function ParseOneStmt() As Long
    Dim k As Long
    Dim k2 As Long
    Dim ni As Long
    Dim rhs As Long
    Dim lineNo As Long
    Dim name As String
    Dim oldCond As Long

    ParseOneStmt = 0
    gNAst = 0
    If gTokPos < gNTok Then
        lineNo = gTok[gTokPos].LineNo
    Else
        lineNo = gSrcLine
    End If
    gSrcLine = lineNo
    gParseLineLo = gTokPos
    gSrcLineText = ""
    k = TokPeek()

    If k = TK_EOF Then
        ParseOneStmt = 1
        Exit Function
    End If

    ' Type 本体のフィールド
    If gParseInType <> 0 Then
        If k = TK_END Then
            TokTake()
            If TokPeek() <> TK_TYPE Then
                Print "End Type expected"
                Exit Function
            End If
            TokTake()
            If CompileTypeEnd() = 0 Then Exit Function
            gParseInType = 0
            ParseOneStmt = 1
            Exit Function
        End If
        If ParseSpanEmitNow(SK_TYPEFIELD_SPAN) = 0 Then Exit Function
        ParseOneStmt = 1
        Exit Function
    End If

    If k = TK_DIM Then
        If ParseSpanEmitNow(SK_DIM_SPAN) = 0 Then Exit Function
        ParseOneStmt = 1
        Exit Function
    End If
    If k = TK_CONST Then
        If ParseSpanEmitNow(SK_CONST_SPAN) = 0 Then Exit Function
        ParseOneStmt = 1
        Exit Function
    End If
    If k = TK_TYPEDEF Then
        If ParseSpanEmitNow(SK_TYPEDEF_SPAN) = 0 Then Exit Function
        ParseOneStmt = 1
        Exit Function
    End If
    If k = TK_TYPE Then
        If ParseSpanEmitNow(SK_TYPE_SPAN) = 0 Then Exit Function
        gParseInType = 1
        ParseOneStmt = 1
        Exit Function
    End If
    If k = TK_SUB Then
        If ParseSpanEmitNow(SK_SUB_SPAN) = 0 Then Exit Function
        ParseOneStmt = 1
        Exit Function
    End If
    If k = TK_FUNCTION Then
        If ParseSpanEmitNow(SK_FUNC_SPAN) = 0 Then Exit Function
        ParseOneStmt = 1
        Exit Function
    End If
    If k = TK_FOR Then
        If ParseSpanEmitNow(SK_FOR_SPAN) = 0 Then Exit Function
        ParseOneStmt = 1
        Exit Function
    End If
    If k = TK_SELECT Then
        If ParseSpanEmitNow(SK_SELECT_SPAN) = 0 Then Exit Function
        ParseOneStmt = 1
        Exit Function
    End If
    If k = TK_CASE Then
        If ParseSpanEmitNow(SK_CASE_SPAN) = 0 Then Exit Function
        ParseOneStmt = 1
        Exit Function
    End If

    If k = TK_IF Then
        TokTake()
        oldCond = gParseCondMode
        gParseCondMode = 1
        ni = ParseCondExpr()
        gParseCondMode = oldCond
        If ni < 0 Then Exit Function
        If ParseExpectThen() = 0 Then Exit Function
        If EmitIfOpen(ni) = 0 Then Exit Function
        If ParseTrailingAfterThen() = 0 Then Exit Function
        ParseOneStmt = 1
        Exit Function
    End If

    If k = TK_ELSEIF Then
        TokTake()
        oldCond = gParseCondMode
        gParseCondMode = 1
        ni = ParseCondExpr()
        gParseCondMode = oldCond
        If ni < 0 Then Exit Function
        If ParseExpectThen() = 0 Then Exit Function
        If EmitElseIfOpen(ni) = 0 Then Exit Function
        If ParseTrailingAfterThen() = 0 Then Exit Function
        ParseOneStmt = 1
        Exit Function
    End If

    If k = TK_ELSE Then
        TokTake()
        If CompileElse() = 0 Then Exit Function
        ParseOneStmt = 1
        Exit Function
    End If

    If k = TK_WHILE Then
        TokTake()
        oldCond = gParseCondMode
        gParseCondMode = 1
        ni = ParseCondExpr()
        gParseCondMode = oldCond
        If ni < 0 Then Exit Function
        If EmitWhileOpen(ni) = 0 Then Exit Function
        ParseOneStmt = 1
        Exit Function
    End If

    If k = TK_WEND Then
        TokTake()
        If CompileWend() = 0 Then Exit Function
        ParseOneStmt = 1
        Exit Function
    End If

    If k = TK_DO Then
        TokTake()
        If TokAtEol() <> 0 Then
            If EmitDoOpen(AST_NIL, DOF_BARE) = 0 Then Exit Function
            ParseOneStmt = 1
            Exit Function
        End If
        If TokPeek() = TK_WHILE Then
            TokTake()
            oldCond = gParseCondMode
            gParseCondMode = 1
            ni = ParseCondExpr()
            gParseCondMode = oldCond
            If ni < 0 Then Exit Function
            If EmitDoOpen(ni, DOF_WHILE) = 0 Then Exit Function
            ParseOneStmt = 1
            Exit Function
        End If
        If TokPeek() = TK_UNTIL Then
            TokTake()
            oldCond = gParseCondMode
            gParseCondMode = 1
            ni = ParseCondExpr()
            gParseCondMode = oldCond
            If ni < 0 Then Exit Function
            If EmitDoOpen(ni, DOF_UNTIL) = 0 Then Exit Function
            ParseOneStmt = 1
            Exit Function
        End If
        Print "bad Do"
        Exit Function
    End If

    If k = TK_LOOP Then
        TokTake()
        If TokAtEol() <> 0 Then
            If EmitLoopClose(AST_NIL, DOF_BARE) = 0 Then Exit Function
            ParseOneStmt = 1
            Exit Function
        End If
        If TokPeek() = TK_WHILE Then
            TokTake()
            oldCond = gParseCondMode
            gParseCondMode = 1
            ni = ParseCondExpr()
            gParseCondMode = oldCond
            If ni < 0 Then Exit Function
            If EmitLoopClose(ni, DOF_WHILE) = 0 Then Exit Function
            ParseOneStmt = 1
            Exit Function
        End If
        If TokPeek() = TK_UNTIL Then
            TokTake()
            oldCond = gParseCondMode
            gParseCondMode = 1
            ni = ParseCondExpr()
            gParseCondMode = oldCond
            If ni < 0 Then Exit Function
            If EmitLoopClose(ni, DOF_UNTIL) = 0 Then Exit Function
            ParseOneStmt = 1
            Exit Function
        End If
        Print "bad Loop"
        Exit Function
    End If

    If k = TK_NEXT Then
        TokTake()
        ' Next [var] — 変数名は無視（CompileNext と同様）
        While TokAtEol() = 0
            TokTake()
        Wend
        If CompileNext() = 0 Then Exit Function
        ParseOneStmt = 1
        Exit Function
    End If

    If k = TK_PRINT Then
        TokTake()
        ni = ParseExpr()
        If ni < 0 Then Exit Function
        If EmitPrintAst(ni) = 0 Then Exit Function
        ParseOneStmt = 1
        Exit Function
    End If

    If k = TK_INPUT Then
        TokTake()
        If TokPeek() <> TK_IDENT Then
            Print "Input needs variable"
            Exit Function
        End If
        ni = TokIdentSIdx(gTokPos)
        If ni < 0 Then
            Print "Input needs variable"
            Exit Function
        End If
        TokTake()
        If EmitInputAst(ni) = 0 Then Exit Function
        ParseOneStmt = 1
        Exit Function
    End If

    If k = TK_END Then
        TokTake()
        k2 = TokPeek()
        If k2 = TK_IF Then
            TokTake()
            If CompileEndIf() = 0 Then Exit Function
            ParseOneStmt = 1
            Exit Function
        End If
        If k2 = TK_SELECT Then
            TokTake()
            If CompileEndSelect() = 0 Then Exit Function
            ParseOneStmt = 1
            Exit Function
        End If
        If k2 = TK_SUB Or k2 = TK_FUNCTION Then
            TokTake()
            If CompileEndProc() = 0 Then Exit Function
            ParseOneStmt = 1
            Exit Function
        End If
        If k2 = TK_TYPE Then
            TokTake()
            If CompileTypeEnd() = 0 Then Exit Function
            gParseInType = 0
            ParseOneStmt = 1
            Exit Function
        End If
        If TokAtEol() <> 0 Then
            EmitAsm("push 0")
            EmitCallName("ExitProcess")
            gEmittedExit = 1
            ParseOneStmt = 1
            Exit Function
        End If
        Print "bad End"
        Exit Function
    End If

    If k = TK_EXIT Then
        TokTake()
        k2 = TokPeek()
        If k2 = TK_WHILE Then
            TokTake()
            If CompileExitWhile() = 0 Then Exit Function
            ParseOneStmt = 1
            Exit Function
        End If
        If k2 = TK_DO Then
            TokTake()
            If CompileExitDo() = 0 Then Exit Function
            ParseOneStmt = 1
            Exit Function
        End If
        If k2 = TK_FOR Then
            TokTake()
            If CompileExitFor() = 0 Then Exit Function
            ParseOneStmt = 1
            Exit Function
        End If
        If k2 = TK_SUB Or k2 = TK_FUNCTION Then
            TokTake()
            If CompileExitProc() = 0 Then Exit Function
            ParseOneStmt = 1
            Exit Function
        End If
        Print "bad Exit"
        Exit Function
    End If

    ' 代入 / 呼び出し / MessageBox / ExitProcess
    If k = TK_IDENT Then
        ni = TokIdentSIdx(gTokPos)
        If ni < 0 Then Exit Function
        name = gPool(ni)
        ni = ParseLValue()
        If ni < 0 Then Exit Function
        If TokPeek() = TK_EQ Then
            TokTake()
            rhs = ParseExpr()
            If rhs < 0 Then Exit Function
            If EmitAssignAst(ni, rhs) = 0 Then Exit Function
            ParseOneStmt = 1
            Exit Function
        End If
        If Lower$(name) = "messagebox" And gAst[ni].Kind = NK_CALL Then
            If EmitExpr(ni) = 0 Then Exit Function
            ParseOneStmt = 1
            Exit Function
        End If
        If Lower$(name) = "exitprocess" And gAst[ni].Kind = NK_CALL Then
            If EmitExpr(ni) = 0 Then Exit Function
            gEmittedExit = 1
            ParseOneStmt = 1
            Exit Function
        End If
        If gAst[ni].Kind = NK_CALL Then
            If EmitExpr(ni) = 0 Then Exit Function
            ParseOneStmt = 1
            Exit Function
        End If
        Print "unknown statement: " + gSrcLineText
        Exit Function
    End If

    Print "unknown statement at line " + Trim$(Str$(lineNo)) + ": " + gSrcLineText
End Function

Function ParseProgram() As Long
    ParseProgram = 0
    gTokPos = 0
    gNStmt = 0
    gParseInType = 0
    While TokPeek() <> TK_EOF
        TokSkipEols()
        If TokPeek() = TK_EOF Then Exit While
        If ParseOneStmt() = 0 Then
            If gSrcLineText = "" Then
                gSrcLineText = TokJoinSpan$(gParseLineLo, gNTok)
            End If
            Print "error: at line " + Trim$(Str$(gSrcLine)) + ": " + gSrcLineText
            Exit Function
        End If
        If TokPeek() = TK_EOL Then
            TokTake()
        ElseIf TokPeek() <> TK_EOF Then
            If gSrcLineText = "" Then
                gSrcLineText = TokJoinSpan$(gParseLineLo, gNTok)
            End If
            Print "junk after statement at line " + Trim$(Str$(gSrcLine)) + ": " + gSrcLineText
            Exit Function
        End If
    Wend
    ParseProgram = 1
End Function

' スパン文を Emit（元ソース [srcLo, srcHi) を直接参照。TokJoin しない）
Function EmitSpanCall(srcLo As Long, srcHi As Long, mode As Long) As Long
    Dim ok As Long
    Dim lineStr As String
    Dim p As *Byte
    Dim n As Long

    EmitSpanCall = 0
    If gLexSrc = 0 Or srcLo < 0 Or srcHi < srcLo Or srcHi > gLexSrcSize Then
        Print "bad source span"
        Exit Function
    End If
    n = srcHi - srcLo
    p = VarPtr(gLexSrc[srcLo])
    ok = 0
    If mode = SK_CONST_SPAN Then
        ok = CompileConstBytes(p, n)
    ElseIf mode = SK_TYPE_SPAN Then
        ok = CompileTypeStartBytes(p, n)
    ElseIf mode = SK_TYPEDEF_SPAN Then
        ok = CompileTypeDefBytes(p, n)
    ElseIf mode = SK_TYPEFIELD_SPAN Then
        ok = CompileTypeFieldBytes(p, n)
    Else
        If gSbTokJoinReady = 0 Then
            SbInit(VarPtr(gSbTokJoin))
            gSbTokJoinReady = 1
        End If
        SbClear(VarPtr(gSbTokJoin))
        If n > 0 Then
            SbAppendBytes(VarPtr(gSbTokJoin), p, n)
        End If
        lineStr = SbToString$(VarPtr(gSbTokJoin))
        gSrcLineText = lineStr
        If mode = SK_DIM_SPAN Then
            ok = CompileDim(lineStr)
        ElseIf mode = SK_FOR_SPAN Then
            ok = CompileFor(lineStr)
        ElseIf mode = SK_SELECT_SPAN Then
            ok = CompileSelectCase(lineStr)
        ElseIf mode = SK_CASE_SPAN Then
            ok = CompileCase(lineStr)
        ElseIf mode = SK_SUB_SPAN Then
            ok = CompileProcHeader(lineStr, 0)
        ElseIf mode = SK_FUNC_SPAN Then
            ok = CompileProcHeader(lineStr, 1)
        End If
        EmitSpanCall = ok
        Exit Function
    End If
    EmitSpanCall = ok
End Function

Function EmitAssignAst(lhs As Long, rhs As Long) As Long
    Dim name As String
    Dim kind As Long
    Dim idx As Long
    Dim lhsFloat As Long

    EmitAssignAst = 0
    lhsFloat = 0
    If gAst[lhs].Kind = NK_IDENT Then
        name = gPool(gAst[lhs].SIdx)
        If gInProc <> 0 And gProcIsFunc <> 0 And StrEqCI(name, gProcName) <> 0 Then
            If gProcRetIsFloat <> 0 Then lhsFloat = 1
        Else
            idx = FindVar(name)
            If idx >= 0 And gVarIsFloat(idx) <> 0 Then lhsFloat = 1
        End If
    End If

    If lhsFloat <> 0 Then
        If EmitExprAsDouble(rhs) = 0 Then Exit Function
    Else
        If EmitExpr(rhs) = 0 Then Exit Function
    End If

    ' Function 名への代入 = 戻り値
    If gInProc <> 0 And gProcIsFunc <> 0 Then
        If gAst[lhs].Kind = NK_IDENT Then
            name = gPool(gAst[lhs].SIdx)
            If StrEqCI(name, gProcName) <> 0 Then
                EmitAsm("mov ebx, ebp")
                EmitAsmImm("add ebx, ", gRetOff)
                If gProcRetIsFloat <> 0 Then
                    EmitFstpQwordEbx()
                Else
                    EmitAsmStoreEbx()
                End If
                EmitAssignAst = 1
                Exit Function
            End If
        End If
    End If

    kind = gAst[lhs].Kind
    If kind = NK_IDENT Then
        name = gPool(gAst[lhs].SIdx)
        idx = FindVar(name)
        If idx < 0 Then
            Print "undeclared variable: " + name
            Exit Function
        End If
        EmitStoreVar(idx)
        EmitAssignAst = 1
        Exit Function
    End If

    ' メンバ / 添字 / a(i)
    If lhsFloat <> 0 Or AstIsFloat(rhs) <> 0 Then
        EmitAsm("sub esp, 8")
        EmitFstpQwordEsp()
        If EmitLValueAddr(lhs) = 0 Then
            Print "error: cannot assign to lvalue"
            Exit Function
        End If
        EmitAsm("mov ebx, eax")
        EmitFldQwordEsp()
        EmitAsm("add esp, 8")
        EmitStoreSized(gLValueSize)
    Else
        EmitAsm("push eax")
        If EmitLValueAddr(lhs) = 0 Then
            Print "error: cannot assign to lvalue"
            Exit Function
        End If
        EmitAsm("mov ebx, eax")
        EmitAsm("pop eax")
        EmitStoreSized(gLValueSize)
    End If
    EmitAssignAst = 1
End Function

Function EmitIfOpen(cond As Long) As Long
    Dim labElse As String
    Dim labEnd As String
    EmitIfOpen = 0
    If gIfSp >= MAX_IF Then
        Print "If nesting too deep"
        Exit Function
    End If
    labElse = NewLabel$()
    labEnd = NewLabel$()
    gIfElse(gIfSp) = labElse
    gIfEnd(gIfSp) = labEnd
    gIfSp = gIfSp + 1
    If EmitCond(cond, labElse) = 0 Then Exit Function
    EmitIfOpen = 1
End Function

Function EmitElseIfOpen(cond As Long) As Long
    Dim labElse As String
    Dim labEnd As String
    EmitElseIfOpen = 0
    If gIfSp <= 0 Then
        Print "ElseIf without If"
        Exit Function
    End If
    labElse = gIfElse(gIfSp - 1)
    labEnd = gIfEnd(gIfSp - 1)
    EmitAsm2("jmp ", labEnd)
    EmitLabel(labElse)
    labElse = NewLabel$()
    gIfElse(gIfSp - 1) = labElse
    If EmitCond(cond, labElse) = 0 Then Exit Function
    EmitElseIfOpen = 1
End Function

Function EmitWhileOpen(cond As Long) As Long
    Dim labTop As String
    Dim labEnd As String
    EmitWhileOpen = 0
    If gLoopSp >= MAX_LOOP Then
        Print "loop nesting too deep"
        Exit Function
    End If
    labTop = NewLabel$()
    labEnd = NewLabel$()
    gLoopTop(gLoopSp) = labTop
    gLoopCont(gLoopSp) = labTop
    gLoopEnd(gLoopSp) = labEnd
    gLoopKind(gLoopSp) = 1
    gLoopSp = gLoopSp + 1
    EmitLabel(labTop)
    If EmitCond(cond, labEnd) = 0 Then Exit Function
    EmitWhileOpen = 1
End Function

Function EmitDoOpen(cond As Long, flags As Long) As Long
    Dim labTop As String
    Dim labBody As String
    Dim labEnd As String
    EmitDoOpen = 0
    If gLoopSp >= MAX_LOOP Then
        Print "loop nesting too deep"
        Exit Function
    End If
    labTop = NewLabel$()
    labEnd = NewLabel$()
    gLoopTop(gLoopSp) = labTop
    gLoopCont(gLoopSp) = labTop
    gLoopEnd(gLoopSp) = labEnd
    gLoopKind(gLoopSp) = 2
    gLoopSp = gLoopSp + 1
    EmitLabel(labTop)
    If flags = DOF_BARE Then
        EmitDoOpen = 1
        Exit Function
    End If
    If flags = DOF_WHILE Then
        If EmitCond(cond, labEnd) = 0 Then Exit Function
        EmitDoOpen = 1
        Exit Function
    End If
    If flags = DOF_UNTIL Then
        labBody = NewLabel$()
        If EmitCond(cond, labBody) = 0 Then Exit Function
        EmitAsm2("jmp ", labEnd)
        EmitLabel(labBody)
        EmitDoOpen = 1
        Exit Function
    End If
    Print "bad Do flags"
End Function

Function EmitLoopClose(cond As Long, flags As Long) As Long
    Dim sp As Long
    Dim labTop As String
    Dim labEnd As String
    EmitLoopClose = 0
    If gLoopSp <= 0 Then
        Print "Loop without Do"
        Exit Function
    End If
    If gLoopKind(gLoopSp - 1) <> 2 Then
        Print "Loop without Do"
        Exit Function
    End If
    sp = gLoopSp - 1
    labTop = gLoopTop(sp)
    labEnd = gLoopEnd(sp)
    If flags = DOF_BARE Then
        EmitAsm2("jmp ", labTop)
        EmitLabel(labEnd)
        gLoopSp = sp
        EmitLoopClose = 1
        Exit Function
    End If
    If flags = DOF_WHILE Then
        If EmitCond(cond, labEnd) = 0 Then Exit Function
        EmitAsm2("jmp ", labTop)
        EmitLabel(labEnd)
        gLoopSp = sp
        EmitLoopClose = 1
        Exit Function
    End If
    If flags = DOF_UNTIL Then
        If EmitCond(cond, labTop) = 0 Then Exit Function
        EmitLabel(labEnd)
        gLoopSp = sp
        EmitLoopClose = 1
        Exit Function
    End If
    Print "bad Loop flags"
End Function

Function EmitPrintAst(ni As Long) As Long
    EmitPrintAst = 0
    EnsureStringRt()
    If EmitExpr(ni) = 0 Then Exit Function
    If AstIsString(ni) = 0 Then
        EmitAsm("push eax")
        EmitAsm("call _rt_Str")
    End If
    EmitAsm("push eax")
    EmitAsm("call _rt_Print")
    EmitPrintAst = 1
End Function

Function EmitInputAst(sIdx As Long) As Long
    Dim name As String
    Dim idx As Long
    EmitInputAst = 0
    name = gPool(sIdx)
    idx = FindVar(name)
    If idx < 0 Then
        Print "undeclared variable: " + name
        Exit Function
    End If
    EnsureStringRt()
    gUseInput = 1
    EmitAsm("call _rt_Input")
    If gVarIsStr(idx) <> 0 Then
        EmitStoreVar(idx)
    Else
        EmitAsm("push eax")
        EmitAsm("call _rt_Val")
        EmitStoreVar(idx)
    End If
    EmitInputAst = 1
End Function

Function EmitProgram() As Long
    ' 文は ParseOneStmt 中に既に emit 済み
    EmitProgram = 1
End Function
