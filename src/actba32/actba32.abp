#include "actba32.idx"

#console

' actba32 - ABP build driver (32bit toolchain)
' usage:
'   actba32 <input.abp> [-o output.exe]       ' single source (#include expand)
'   actba32 <project.pj> [-o output.exe]      ' #SOURCE combine (#include expand) -> abc -> asm -> obj -> exe
'
' -o overrides .pj #OUTPUT_RELEASE. If omitted, use .pj out (or basename.exe for single .abp).
'
' pipeline:
'   1. #include expand (actba32)
'   2. abc         (.abp -> .asm)
'   3. abassembler (.asm -> .obj)
'   4. ablinker    (.obj -> .exe)

Const MAX_CMDLINE = 1024
Const MAX_SOURCES = 32
Const MAX_INCLUDES = 64

Dim gSources(31) As String' todo: gSources(MAX_SOURCES)
Dim gNSources As Long
Dim gOutExe As String
Dim gPlatform As Long
Dim gProjDir As String
Dim gProjName As String
Dim gIncSeen(63) As String
Dim gNIncSeen As Long
Dim gExpandOk As Long
Dim gPreparedAbp As String
Dim gCombinedAbp As String
Dim gSbCombine As StringBuffer
Dim gCliOutOk As Long

Sub USAGE()
    Print "actba32 build driver"
    Print "actba32 <abp|pj> [-o out.exe]"
    Print "expand/abc/asm/link"
    End
End Sub

Function ToolDir$() As String
    Dim buf[MAX_PATH] As Byte
    Dim s As String
    Dim i As Long
    Dim n As Long
    Dim ch As String
    Dim slashPos As Long

    GetModuleFileName(NULL, buf, MAX_PATH)
    s = MakeStr(buf)
    n = Len(s)
    slashPos = 0
    For i = 1 To n
        ch = Mid$(s, i, 1)
        If ch = "\" Or ch = "/" Then
            slashPos = i
        End If
    Next
    If slashPos > 0 Then
        ToolDir$ = Left$(s, slashPos)
    Else
        ToolDir$ = ""
    End If
End Function

' Include/default/default.idx（ツール隣 or カレント）
Function DefaultIncludeIdx$() As String
    Dim p As String
    p = ToolDir$() + "Include\default\default.idx"
    If FileExists(p) <> 0 Then
        DefaultIncludeIdx$ = p
        Exit Function
    End If
    p = "Include\default\default.idx"
    If FileExists(p) <> 0 Then
        DefaultIncludeIdx$ = p
        Exit Function
    End If
    DefaultIncludeIdx$ = ""
End Function

Function ConsoleIncludeIdx$() As String
    Dim p As String
    p = ToolDir$() + "Include\console\console.idx"
    If FileExists(p) <> 0 Then
        ConsoleIncludeIdx$ = p
        Exit Function
    End If
    p = "Include\console\console.idx"
    If FileExists(p) <> 0 Then
        ConsoleIncludeIdx$ = p
        Exit Function
    End If
    ConsoleIncludeIdx$ = ""
End Function

Function N88BasicIncludeIdx$() As String
    Dim p As String
    p = ToolDir$() + "Include\N88BASIC\n88basic.idx"
    If FileExists(p) <> 0 Then
        N88BasicIncludeIdx$ = p
        Exit Function
    End If
    p = "Include\N88BASIC\n88basic.idx"
    If FileExists(p) <> 0 Then
        N88BasicIncludeIdx$ = p
        Exit Function
    End If
    N88BasicIncludeIdx$ = ""
End Function

' ソースに #name ディレクティブがあるか（name は小文字。例: "console"）
Function TextHasHashDir(text As String, dirName As String) As Long
    Dim low As String
    Dim oneLine As String
    Dim i As Long
    Dim start As Long
    Dim n As Long
    Dim c As Long
    Dim p As *Byte
    Dim key As String
    TextHasHashDir = 0
    key = "#" + Lower$(dirName)
    n = Len(text)
    If n = 0 Then Exit Function
    p = StrPtr(text)
    i = 0
    While i < n
        start = i
        While i < n
            c = p[i]
            If c = CH_NL Or c = CH_CR Then Exit While
            i = i + 1
        Wend
        oneLine = StripCommentPj$(Mid$(text, start + 1, i - start))
        low = Lower$(Trim$(oneLine))
        If low = key Or StartsWith(low, key + " ") <> 0 Or StartsWith(low, key + Chr$(9)) <> 0 Then
            TextHasHashDir = 1
            Exit Function
        End If
        If i < n And p[i] = CH_CR Then i = i + 1
        If i < n And p[i] = CH_NL Then i = i + 1
    Wend
End Function

Function AppendDefaultIncludes() As Long
    Dim idx As String
    AppendDefaultIncludes = 0
    idx = DefaultIncludeIdx$()
    If idx = "" Then
        AppendDefaultIncludes = 1
        Exit Function
    End If
    SbAppendStr(VarPtr(gSbCombine), "' ---- Include/default ----")
    SbAppendCRLF(VarPtr(gSbCombine))
    If ExpandFileInto(VarPtr(gSbCombine), idx) = 0 Then Exit Function
    If gExpandOk = 0 Then Exit Function
    AppendDefaultIncludes = 1
End Function

' #console / #n88basic / #prompt に応じてプロファイル idx を追記
Function AppendProfileIncludes(text As String) As Long
    Dim idx As String
    Dim wantN88 As Long
    AppendProfileIncludes = 0
    If TextHasHashDir(text, "console") <> 0 Then
        idx = ConsoleIncludeIdx$()
        If idx = "" Then
            Print "warning: not found: Include\console\console.idx"
        Else
            SbAppendStr(VarPtr(gSbCombine), "' ---- Include/console ----")
            SbAppendCRLF(VarPtr(gSbCombine))
            If ExpandFileInto(VarPtr(gSbCombine), idx) = 0 Then Exit Function
            If gExpandOk = 0 Then Exit Function
        End If
    End If
    wantN88 = TextHasHashDir(text, "n88basic")
    If wantN88 = 0 Then
        wantN88 = TextHasHashDir(text, "prompt")
    End If
    If wantN88 <> 0 Then
        idx = N88BasicIncludeIdx$()
        If idx = "" Then
            Print "warning: not found: Include\N88BASIC\n88basic.idx"
        Else
            SbAppendStr(VarPtr(gSbCombine), "' ---- Include/N88BASIC ----")
            SbAppendCRLF(VarPtr(gSbCombine))
            If ExpandFileInto(VarPtr(gSbCombine), idx) = 0 Then Exit Function
            If gExpandOk = 0 Then Exit Function
        End If
    End If
    AppendProfileIncludes = 1
End Function

Function SourcesWantProfilesText$() As String
    Dim i As Long
    Dim t As String
    Dim all As String
    all = ""
    For i = 0 To gNSources - 1
        t = LoadTextFile$(gSources(i))
        all = all + t + Chr$(10)
    Next
    SourcesWantProfilesText$ = all
End Function

Function StripCommentPj$(s As String) As String
    Dim n As Long
    Dim i As Long
    Dim inQ As Long
    Dim c As Long
    Dim p As *Byte
    Dim t As String
    n = Len(s)
    If n = 0 Then
        StripCommentPj$ = ""
        Exit Function
    End If
    p = StrPtr(s)
    inQ = 0
    For i = 0 To n - 1
        c = p[i]
        If inQ <> 0 Then
            If c = CH_DQUOTE Then inQ = 0
        ElseIf c = CH_DQUOTE Then
            inQ = 1
        ElseIf c = CH_SQUOTE Then
            t = Left$(s, i)
            StripCommentPj$ = Trim$(t)
            Exit Function
        End If
    Next
    StripCommentPj$ = Trim$(s)
End Function

Function NormalizeOutPath$(p As String) As String
    Dim t As String
    t = Trim$(p)
    If Len(t) >= 2 Then
        If Left$(t, 2) = ".\" Then
            t = Mid$(t, 3, Len(t) - 2)
        End If
    End If
    NormalizeOutPath$ = t
End Function

Function JoinPath$(dir As String, name As String) As String
    If Len(DirOf$(name)) > 0 Then
        JoinPath$ = name
    ElseIf Len(dir) = 0 Then
        JoinPath$ = name
    Else
        JoinPath$ = dir + name
    End If
End Function

' CLI ??o???B-o path ?D??A???????u?????B??????? ""?B
' ?G???[???? gCliOutOk=0 ?????i????o?????? End?j?B
Function ParseCliOut$() As String
    Dim i As Long
    Dim buf[MAX_PATH] As Byte
    Dim nxt[MAX_PATH] As Byte
    Dim arg As String

    gCliOutOk = 1
    ParseCliOut$ = ""
    i = 2
    While GetCmd(i, buf) <> 0
        arg = MakeStr(buf)
        If arg = "-o" Or arg = "-O" Or arg = "/o" Then
            If GetCmd(i + 1, nxt) = 0 Then
                Print "error: -o requires an output path"
                gCliOutOk = 0
                ParseCliOut$ = ""
                Exit Function
            End If
            ParseCliOut$ = NormalizeOutPath$(MakeStr(nxt))
            Exit Function
        End If
        i = i + 1
    Wend
End Function

Function ParseProject(pjPath As String) As Long
    Dim text As String
    Dim oneLine As String
    Dim i As Long
    Dim start As Long
    Dim n As Long
    Dim c As Long
    Dim p As *Byte
    Dim inSource As Long
    Dim low As String
    Dim eq As Long
    Dim key As String
    Dim value As String
    Dim tmp As String

    ParseProject = 0
    gNSources = 0
    gOutExe = ""
    gPlatform = 0
    gProjDir = DirOf$(pjPath)
    tmp = BaseName$(pjPath)
    gProjName = FileNameOnly$(tmp)

    text = LoadTextFile$(pjPath)
    If text = "" Then
        If FileExists(pjPath) = 0 Then Exit Function
    End If

    n = Len(text)
    p = StrPtr(text)
    i = 0
    inSource = 0
    While i < n
        start = i
        While i < n
            c = p[i]
            If c = CH_NL Or c = CH_CR Then Exit While
            i = i + 1
        Wend
        oneLine = StripCommentPj$(Mid$(text, start + 1, i - start))
        While i < n
            c = p[i]
            If c <> CH_NL And c <> CH_CR Then Exit While
            i = i + 1
        Wend
        If oneLine = "" Then
            ' skip
        Else
            If Left$(oneLine, 1) = "#" Then
                low = Lower$(oneLine)
                If low = "#source" Then
                    inSource = 1
                Else
                    inSource = 0
                    eq = InStr(1, oneLine, "=")
                    If eq > 1 Then
                        tmp = Left$(oneLine, eq - 1)
                        tmp = Trim$(tmp)
                        key = Lower$(tmp)
                        tmp = Mid$(oneLine, eq + 1, Len(oneLine) - eq)
                        value = Trim$(tmp)
                        If key = "#output_release" Then
                            gOutExe = NormalizeOutPath$(value)
                        ElseIf key = "#platform" Then
                            If value = "32" Then
                                gPlatform = 32
                            Else
        Print "bad platform: " + value
                                Exit Function
                            End If
                        ElseIf key = "#name" Then
                            If value <> "" Then
                                gProjName = value
                            End If
                        End If
                    End If
                End If
            Else
                If inSource <> 0 Then
                    If gNSources >= MAX_SOURCES Then
                        Print "too many #SOURCE files"
                        Exit Function
                    End If
                    gSources(gNSources) = oneLine
                    gNSources = gNSources + 1
                End If
            End If
        End If
    Wend

    If gNSources <= 0 Then
        Print "no #SOURCE in " + pjPath
        Exit Function
    End If
    If gOutExe = "" Then
        gOutExe = gProjName + ".exe"
    End If
    If gPlatform = 0 Then
        gPlatform = 32
    End If
    gOutExe = JoinPath$(gProjDir, gOutExe)
    ParseProject = 1
End Function

Function TextHasInclude(text As String) As Long
    Dim low As String
    Dim oneLine As String
    Dim i As Long
    Dim start As Long
    Dim n As Long
    Dim c As Long
    Dim p As *Byte
    TextHasInclude = 0
    n = Len(text)
    If n = 0 Then Exit Function
    p = StrPtr(text)
    i = 0
    While i < n
        start = i
        While i < n
            c = p[i]
            If c = CH_NL Or c = CH_CR Then Exit While
            i = i + 1
        Wend
        oneLine = StripCommentPj$(Mid$(text, start + 1, i - start))
        low = Lower$(Trim$(oneLine))
        If StartsWith(low, "#include") <> 0 Then
            TextHasInclude = 1
            Exit Function
        End If
        If i < n And p[i] = CH_CR Then i = i + 1
        If i < n And p[i] = CH_NL Then i = i + 1
    Wend
End Function

Function FindIncSeen(path As String) As Long
    Dim i As Long
    Dim low As String
    FindIncSeen = 0
    low = Lower$(path)
    For i = 0 To gNIncSeen - 1
        If Lower$(gIncSeen(i)) = low Then
            FindIncSeen = 1
            Exit Function
        End If
    Next
End Function

Function MarkIncSeen(path As String) As Long
    MarkIncSeen = 0
    If gNIncSeen >= MAX_INCLUDES Then
        Print "too many includes"
        Exit Function
    End If
    gIncSeen(gNIncSeen) = path
    gNIncSeen = gNIncSeen + 1
    MarkIncSeen = 1
End Function

Function ResolveIncludePath$(currentFile As String, inc As String) As String
    Dim full As String
    full = Trim$(inc)
    If InStr(1, full, ":") = 0 And Left$(full, 1) <> "\" And Left$(full, 1) <> "/" Then
        full = DirOf$(currentFile) + full
    End If
    ResolveIncludePath$ = full
End Function

' 行頭が #include か（MakeStr/Lower$ なし）
Function LineIsIncludeDir(p As *Byte, n As Long) As Long
    Dim i As Long
    Dim c As Long
    LineIsIncludeDir = 0
    i = 0
    While i < n
        c = p[i]
        If c <> CH_SP And c <> CH_TAB Then Exit While
        i = i + 1
    Wend
    If i >= n Then Exit Function
    c = p[i]
    If c = CH_SQUOTE Then Exit Function
    If c <> CH_HASH Then Exit Function
    i = i + 1
    If i + 7 > n Then Exit Function
    c = p[i]
    c = ToLowerChar(c)
    If c <> CH_LI Then Exit Function
    c = p[i + 1]
    c = ToLowerChar(c)
    If c <> CH_LN Then Exit Function
    c = p[i + 2]
    c = ToLowerChar(c)
    If c <> CH_LC Then Exit Function
    c = p[i + 3]
    c = ToLowerChar(c)
    If c <> CH_LL Then Exit Function
    c = p[i + 4]
    c = ToLowerChar(c)
    If c <> CH_LU Then Exit Function
    c = p[i + 5]
    c = ToLowerChar(c)
    If c <> CH_LD Then Exit Function
    c = p[i + 6]
    c = ToLowerChar(c)
    If c <> CH_LE Then Exit Function
    LineIsIncludeDir = 1
End Function

' #include を展開して dst に追記。パスは once（再訪はスキップ）。失敗時 gExpandOk=0
Function ExpandFileInto(dst As *StringBuffer, path As String) As Long
    Dim text As String
    Dim oneLine As String
    Dim i As Long
    Dim start As Long
    Dim n As Long
    Dim c As Long
    Dim p As *Byte
    Dim q1 As Long
    Dim q2 As Long
    Dim inc As String
    Dim full As String
    Dim lineN As Long
    Dim lineBuf[512] As Byte

    ExpandFileInto = 0
    If gExpandOk = 0 Then Exit Function
    If FindIncSeen(path) <> 0 Then
        ExpandFileInto = 1
        Exit Function
    End If
    If MarkIncSeen(path) = 0 Then
        gExpandOk = 0
        Exit Function
    End If
    If FileExists(path) = 0 Then
        Print "cannot include: " + path
        gExpandOk = 0
        Exit Function
    End If

    text = LoadTextFile$(path)
    n = Len(text)
    p = StrPtr(text)
    i = 0
    While i < n
        start = i
        While i < n
            c = p[i]
            If c = CH_NL Or c = CH_CR Then Exit While
            i = i + 1
        Wend
        lineN = i - start
        If lineN >= 512 Then lineN = 511
        If lineN > 0 Then memcpy(lineBuf, VarPtr(p[start]), lineN)
        lineBuf[lineN] = 0
        If LineIsIncludeDir(lineBuf, lineN) <> 0 Then
            oneLine = MakeStr(lineBuf)
            q1 = InStr(1, oneLine, Chr$(CH_DQUOTE))
            q2 = 0
            If q1 > 0 Then q2 = InStr(q1 + 1, oneLine, Chr$(CH_DQUOTE))
            If q1 = 0 Or q2 <= q1 Then
                Print "bad #include: " + oneLine
                gExpandOk = 0
                Exit Function
            End If
            inc = Mid$(oneLine, q1 + 1, q2 - q1 - 1)
            full = ResolveIncludePath$(path, inc)
            If ExpandFileInto(dst, full) = 0 Then Exit Function
            If gExpandOk = 0 Then Exit Function
        Else
            If lineN > 0 Then SbAppendBytes(dst, lineBuf, lineN)
            SbAppendCRLF(dst)
        End If
        While i < n
            c = p[i]
            If c <> CH_NL And c <> CH_CR Then Exit While
            i = i + 1
        Wend
    Wend
    ExpandFileInto = 1
End Function

Function ExpandFile$(path As String) As String
    Dim sb As StringBuffer
    SbInit(VarPtr(sb))
    If ExpandFileInto(VarPtr(sb), path) = 0 Or gExpandOk = 0 Then
        SbFree(VarPtr(sb))
        ExpandFile$ = ""
        Exit Function
    End If
    ExpandFile$ = SbToString$(VarPtr(sb))
    SbFree(VarPtr(sb))
End Function

Function AppendSourceChunk(srcName As String) As Long
    Dim srcPath As String
    AppendSourceChunk = 0
    srcPath = JoinPath$(gProjDir, srcName)
    If FileExists(srcPath) = 0 Then
        Print "missing source: " + srcPath
        Exit Function
    End If
    ' 既に展開済みソースは #include 展開をスキップ（once）
    If FindIncSeen(srcPath) <> 0 Then
        AppendSourceChunk = 1
        Exit Function
    End If
    SbAppendStr(VarPtr(gSbCombine), "' ---- ")
    SbAppendStr(VarPtr(gSbCombine), srcName)
    SbAppendStr(VarPtr(gSbCombine), " ----")
    SbAppendCRLF(VarPtr(gSbCombine))
    If ExpandFileInto(VarPtr(gSbCombine), srcPath) = 0 Then Exit Function
    If gExpandOk = 0 Then Exit Function
    AppendSourceChunk = 1
End Function

Function CombineSources() As Long
    Dim i As Long
    Dim combined As String

    CombineSources = 0
    SbClear(VarPtr(gSbCombine))
    gNIncSeen = 0
    gExpandOk = 1
    gCombinedAbp = ""
    ' Include/default を先頭へ（ソースに明示 #include 不要）
    If AppendDefaultIncludes() = 0 Then Exit Function
    ' #console / #n88basic ならプロファイル idx
    If AppendProfileIncludes(SourcesWantProfilesText$()) = 0 Then Exit Function
    ' #SOURCE を順に展開。#include は once
    For i = 0 To gNSources - 1
        If AppendSourceChunk(gSources(i)) = 0 Then Exit Function
    Next
    If gExpandOk = 0 Then Exit Function

    combined = JoinPath$(gProjDir, gProjName + "_combined.abp")
    If WriteAll(StrPtr(combined), SbData(VarPtr(gSbCombine)), SbLen(VarPtr(gSbCombine))) = 0 Then
        Print "cannot write: " + combined
        Exit Function
    End If
    gCombinedAbp = combined
    CombineSources = 1
End Function

' ?P?? .abp ?? #include ??W?J?B????? gPreparedAbp?B
Function PrepareAbp(abpPath As String) As Long
    Dim text As String
    Dim expanded As String
    Dim expPath As String
    Dim idx As String
    Dim defaults As String
    Dim lowPath As String
    Dim part As String

    PrepareAbp = 0
    gPreparedAbp = ""
    If FileExists(abpPath) = 0 Then
        Print "missing: " + abpPath
        Exit Function
    End If

    gNIncSeen = 0
    gExpandOk = 1
    defaults = ""
    lowPath = Lower$(abpPath)
    text = LoadTextFile$(abpPath)
    ' *_combined.abp は CombineSources が default/profile 済み
    If InStr(1, lowPath, "_combined.abp") = 0 Then
        idx = DefaultIncludeIdx$()
        If idx <> "" Then
            defaults = ExpandFile$(idx)
            If gExpandOk = 0 Then Exit Function
        End If
        If TextHasHashDir(text, "console") <> 0 Then
            idx = ConsoleIncludeIdx$()
            If idx = "" Then
                Print "warning: not found: Include\console\console.idx"
            Else
                part = ExpandFile$(idx)
                If gExpandOk = 0 Then Exit Function
                defaults = defaults + part
            End If
        End If
        If TextHasHashDir(text, "n88basic") <> 0 Or TextHasHashDir(text, "prompt") <> 0 Then
            idx = N88BasicIncludeIdx$()
            If idx = "" Then
                Print "warning: not found: Include\N88BASIC\n88basic.idx"
            Else
                part = ExpandFile$(idx)
                If gExpandOk = 0 Then Exit Function
                defaults = defaults + part
            End If
        End If
    End If

    If TextHasInclude(text) = 0 And defaults = "" Then
        gPreparedAbp = abpPath
        PrepareAbp = 1
        Exit Function
    End If

    If TextHasInclude(text) <> 0 Then
        expanded = ExpandFile$(abpPath)
        If gExpandOk = 0 Then Exit Function
    Else
        expanded = text
    End If
    expanded = defaults + expanded

    expPath = BaseName$(abpPath) + ".tmp"
    If WriteTextFile(expPath, expanded) = 0 Then
        Print "cannot write: " + expPath
        Exit Function
    End If
    If defaults <> "" Or TextHasInclude(text) <> 0 Then
        Print "include: " + abpPath + " -> " + expPath
    End If
    gPreparedAbp = expPath
    PrepareAbp = 1
End Function

Function EnsureParentDir(path As String) As Long
    Dim d As String
    Dim n As Long
    Dim last As String
    EnsureParentDir = 0
    d = DirOf$(path)
    n = Len(d)
    If n = 0 Then
        EnsureParentDir = 1
        Exit Function
    End If
    last = Right$(d, 1)
    If last = "\" Or last = "/" Then
        d = Left$(d, n - 1)
    End If
    If Len(d) = 0 Or d = "." Then
        EnsureParentDir = 1
        Exit Function
    End If
    If FileExists(d) = 0 Then
        Print "no out dir: " + d
        Exit Function
    End If
    EnsureParentDir = 1
End Function

Function RunTool(toolName As String, arg1 As String, arg2 As String) As Long
    Dim toolPath As String
    Dim cmdStr As String
    Dim dir As String
    Dim cmdBuf[MAX_CMDLINE - 1] As Byte
    Dim si As STARTUPINFO
    Dim pi As PROCESS_INFORMATION
    Dim sa As SECURITY_ATTRIBUTES
    Dim ok As Long

    dir = ToolDir$()
    toolPath = dir + toolName
    cmdStr = toolPath + " " + arg1 + " " + arg2
    Print ">> " + cmdStr

    If Len(cmdStr) >= MAX_CMDLINE Then
        Print "error: command line too long (max " + Trim$(Str$(MAX_CMDLINE)) + " bytes)"
        Print "  cmd: " + cmdStr
        RunTool = 0
        Exit Function
    End If

    If FileExists(toolPath) = 0 Then
        Print "error: tool not found: " + toolPath
        Print "  hint: put " + toolName + " next to actba32.exe (ToolDir=" + dir + ")"
        RunTool = 0
        Exit Function
    End If

    ZeroMem(cmdBuf, MAX_CMDLINE)
    lstrcpy(cmdBuf, StrPtr(cmdStr))

    ZeroMem(VarPtr(si), SizeOf(STARTUPINFO))
    si.cb = SizeOf(STARTUPINFO)

    sa.nLength = SizeOf(SECURITY_ATTRIBUTES)
    sa.lpSecurityDescriptor = 0
    sa.bInheritHandle = 0

    ZeroMem(VarPtr(pi), SizeOf(PROCESS_INFORMATION))

    ' AB420: CreateProcess takes ByRef STARTUPINFO / PROCESS_INFORMATION / SECURITY_ATTRIBUTES
    ' (passing VarPtr(...) yields "invalid identifier" on AB420)
    ok = CreateProcess(NULL, cmdBuf, sa, sa, 0, 0, NULL, NULL, si, pi)
    If ok = 0 Then
        Print "error: CreateProcess failed for: " + toolPath
        Print "  cmd: " + cmdStr
        RunTool = 0
        Exit Function
    End If

    WaitForSingleObject(pi.hProcess, INFINITE)
    CloseHandle(pi.hThread)
    CloseHandle(pi.hProcess)
    RunTool = 1
End Function

Function BuildOne(abpPath As String, exePath As String) As Long
    Dim base As String
    Dim asmPath As String
    Dim objPath As String
    Dim srcPath As String

    BuildOne = 0
    If PrepareAbp(abpPath) = 0 Then
        Print "error: prepare/include failed for: " + abpPath
        Exit Function
    End If
    srcPath = gPreparedAbp
    If EnsureParentDir(exePath) = 0 Then
        Print "error: output directory missing for: " + exePath
        Exit Function
    End If

    base = BaseName$(srcPath)
    asmPath = base + ".asm"
    objPath = base + ".obj"

    Print "actba32: " + abpPath + " -> " + exePath

    DeleteFile(StrPtr(asmPath))
    If RunTool("abc.exe", srcPath, asmPath) = 0 Then
        Print "error: failed to launch abc.exe"
        Exit Function
    End If
    If FileExists(asmPath) = 0 Then
        Print "error: abc produced no .asm (compile failed or silent exit)"
        Print "  expected: " + asmPath
        Print "  input:    " + srcPath
        Print "  hint: run the >> command above manually; if abc prints nothing,"
        Print "        abc.exe may be a broken/GUI binary - restore abc_host.exe or rebuild"
        Exit Function
    End If

    DeleteFile(StrPtr(objPath))
    If RunTool("abassembler.exe", asmPath, objPath) = 0 Then
        Print "error: failed to launch abassembler.exe"
        Exit Function
    End If
    If FileExists(objPath) = 0 Then
        Print "error: abassembler produced no .obj (assemble failed)"
        Print "  expected: " + objPath
        Print "  input:    " + asmPath
        Exit Function
    End If

    DeleteFile(StrPtr(exePath))
    If RunTool("ablinker.exe", objPath, exePath) = 0 Then
        Print "error: failed to launch ablinker.exe"
        Exit Function
    End If
    If FileExists(exePath) = 0 Then
        Print "error: ablinker produced no .exe (link failed)"
        Print "  expected: " + exePath
        Print "  input:    " + objPath
        Exit Function
    End If

    Print "OK: " + abpPath + " -> " + exePath
    ' #include ?W?J?????i*.tmp / ?? *_exp.abp?j?????????????????
    If srcPath <> abpPath Then
        DeleteFile(StrPtr(srcPath))
    End If
    BuildOne = 1
End Function

' --- ???C?? ---
Dim inPath[MAX_PATH] As Byte
Dim inName As String
Dim exePath As String
Dim cliOut As String
Dim i As Long
Dim tmp As String

If GetCmd(1, inPath) = 0 Then
    USAGE()
End If

inName = MakeStr(inPath)
cliOut = ParseCliOut$()
If gCliOutOk = 0 Then
    End
End If

' .pj ????? EndsWithExt ?????y?C?????C???iAB ?? UDF ?????h????j
i = Len(inName)
tmp = ""
If i >= 3 Then
    tmp = Mid$(inName, i - 2, 3)
End If
If tmp = ".pj" Or tmp = ".PJ" Or tmp = ".Pj" Or tmp = ".pJ" Then
    If ParseProject(inName) = 0 Then
        End
    End If
    ' -o / ??u?????? .pj ?? #OUTPUT_RELEASE ???D??
    If cliOut <> "" Then
        gOutExe = JoinPath$(gProjDir, cliOut)
    End If
    Print "project: " + inName
    tmp = Str$(gNSources)
    tmp = Trim$(tmp)
    Print "  sources: " + tmp
    For i = 0 To gNSources - 1
        Print "    " + gSources(i)
    Next
    Print "  output: " + gOutExe
    If CombineSources() = 0 Then
        End
    End If
    If BuildOne(gCombinedAbp, gOutExe) = 0 Then
        End
    End If
    ' *_combined.abp ??????
    If gCombinedAbp <> "" Then
        DeleteFile(StrPtr(gCombinedAbp))
    End If
Else
    If cliOut = "" Then
        exePath = BaseName$(inName) + ".exe"
    Else
        exePath = cliOut
    End If
    If BuildOne(inName, exePath) = 0 Then
        End
    End If
End If

End
