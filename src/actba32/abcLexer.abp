' abcLexer.abp - 字句解析（式文字列 → トークン列）
' トークン・AST 用の共有プールもここに置く

Const TK_EOF = 0
Const TK_NUM = 1
Const TK_IDENT = 2
Const TK_STR = 3
Const TK_PLUS = 4
Const TK_MINUS = 5
Const TK_STAR = 6
Const TK_SLASH = 7
Const TK_BSLASH = 8
Const TK_EQ = 9
Const TK_NE = 10
Const TK_LT = 11
Const TK_GT = 12
Const TK_LE = 13
Const TK_GE = 14
Const TK_LPAREN = 15
Const TK_RPAREN = 16
Const TK_LBRACK = 17
Const TK_RBRACK = 18
Const TK_COMMA = 19
Const TK_DOT = 20
Const TK_ARROW = 21
Const TK_AND = 22
Const TK_OR = 23
Const TK_XOR = 24
Const TK_MOD = 25
Const TK_IF = 26
Const TK_THEN = 27
Const TK_ELSE = 28
Const TK_ELSEIF = 29
Const TK_END = 30
Const TK_DIM = 31
Const TK_CONST = 32
Const TK_TYPE = 33
Const TK_TYPEDEF = 34
Const TK_SUB = 35
Const TK_FUNCTION = 36
Const TK_WHILE = 37
Const TK_WEND = 38
Const TK_FOR = 39
Const TK_NEXT = 40
Const TK_DO = 41
Const TK_LOOP = 42
Const TK_UNTIL = 43
Const TK_SELECT = 44
Const TK_CASE = 45
Const TK_EXIT = 46
Const TK_PRINT = 47
Const TK_INPUT = 48
Const TK_AS = 49
Const TK_BYREF = 50
Const TK_BYVAL = 51
Const TK_TO = 52
Const TK_STEP = 53
Const TK_VARPTR = 54
Const TK_ADDRESSOF = 55
Const TK_SIZEOF = 56
Const TK_EOL = 57

Const MAX_AST = 1024
Const MAX_POOL = 512
Const AST_NIL = -1
Const TOK_INIT_CAP = 256

' トークン（ソース全体を読めるよう malloc。最悪 1 文字 1 トークン）
Type TTok
    Kind As Long
    SIdx As Long
    IVal As Long
    Str As String
End Type
Dim gTok As *TTok
Dim gTokCap As Long
Dim gNTok As Long
Dim gTokPos As Long

' 文字列プール（識別子・リテラル本文）
Dim gPool(MAX_POOL - 1) As String
Dim gNPool As Long

' AST
Type TAst
    Kind As Long
    Op As Long
    A As Long
    B As Long
    C As Long
    D As Long
    IVal As Long
    SIdx As Long
    Flags As Long
End Type
Dim gAst[MAX_AST - 1] As TAst
Dim gNAst As Long
Dim gParseCondMode As Long

Function LexIsIdentStart(c As Long) As Long
    If IsAlphabet(c) <> 0 Or c = CH_UNDER Then
        LexIsIdentStart = 1
    Else
        LexIsIdentStart = 0
    End If
End Function

Function LexIsIdentChar(c As Long) As Long
    If LexIsIdentStart(c) <> 0 Then
        LexIsIdentChar = 1
    ElseIf IsDigit(c) <> 0 Then
        LexIsIdentChar = 1
    ElseIf c = CH_DOLLAR Then
        LexIsIdentChar = 1
    Else
        LexIsIdentChar = 0
    End If
End Function

Function PoolAdd(s As String) As Long
    If gNPool >= MAX_POOL Then
        Print "string pool overflow"
        PoolAdd = -1
        Exit Function
    End If
    gPool(gNPool) = s
    PoolAdd = gNPool
    gNPool = gNPool + 1
End Function

' need 個以上の TTok を確保（ソース長に合わせて倍増）
Function TokEnsure(need As Long) As Long
    Dim np As *TTok
    Dim ncap As Long
    Dim nbytes As Long
    Dim oldBytes As Long
    TokEnsure = 0
    If need <= 0 Then
        TokEnsure = 1
        Exit Function
    End If
    If need <= gTokCap And gTok <> 0 Then
        TokEnsure = 1
        Exit Function
    End If
    ncap = gTokCap
    If ncap <= 0 Then ncap = TOK_INIT_CAP
    While ncap < need
        ncap = ncap * 2
    Wend
    nbytes = SizeOf(TTok) * ncap
    np = malloc(nbytes)
    If np = 0 Then
        Print "token alloc failed"
        Exit Function
    End If
    ZeroMem(np, nbytes)
    If gTok <> 0 And gNTok > 0 Then
        oldBytes = SizeOf(TTok) * gNTok
        memcpy(np, gTok, oldBytes)
    End If
    If gTok <> 0 Then free(gTok)
    gTok = np
    gTokCap = ncap
    TokEnsure = 1
End Function

Sub TokFree()
    If gTok <> 0 Then
        free(gTok)
        gTok = 0
    End If
    gTokCap = 0
    gNTok = 0
    gTokPos = 0
End Sub

' s = トークン文字列（識別子・リテラル本文・記号の字面）
' IDENT / STR のみ gPool にも入れ SIdx を付け、AST の gPool(SIdx) 互換を保つ
Function TokPush(kind As Long, s As String, iVal As Long) As Long
    Dim sIdx As Long
    If TokEnsure(gNTok + 1) = 0 Then
        TokPush = 0
        Exit Function
    End If
    sIdx = -1
    If kind = TK_IDENT Or kind = TK_STR Then
        sIdx = PoolAdd(s)
        If sIdx < 0 Then
            TokPush = 0
            Exit Function
        End If
    End If
    gTok[gNTok].Kind = kind
    gTok[gNTok].SIdx = sIdx
    gTok[gNTok].IVal = iVal
    gTok[gNTok].Str = s
    gNTok = gNTok + 1
    TokPush = 1
End Function

Function LexKeywordKind(name As String) As Long
    Dim n As String
    n = Lower$(name)
    LexKeywordKind = TK_IDENT
    If n = "and" Then
        LexKeywordKind = TK_AND
    ElseIf n = "or" Then
        LexKeywordKind = TK_OR
    ElseIf n = "xor" Then
        LexKeywordKind = TK_XOR
    ElseIf n = "mod" Then
        LexKeywordKind = TK_MOD
    ElseIf n = "if" Then
        LexKeywordKind = TK_IF
    ElseIf n = "then" Then
        LexKeywordKind = TK_THEN
    ElseIf n = "elseif" Then
        LexKeywordKind = TK_ELSEIF
    ElseIf n = "else" Then
        LexKeywordKind = TK_ELSE
    ElseIf n = "end" Then
        LexKeywordKind = TK_END
    ElseIf n = "dim" Then
        LexKeywordKind = TK_DIM
    ElseIf n = "const" Then
        LexKeywordKind = TK_CONST
    ElseIf n = "typedef" Then
        LexKeywordKind = TK_TYPEDEF
    ElseIf n = "type" Then
        LexKeywordKind = TK_TYPE
    ElseIf n = "sub" Then
        LexKeywordKind = TK_SUB
    ElseIf n = "function" Then
        LexKeywordKind = TK_FUNCTION
    ElseIf n = "while" Then
        LexKeywordKind = TK_WHILE
    ElseIf n = "wend" Then
        LexKeywordKind = TK_WEND
    ElseIf n = "for" Then
        LexKeywordKind = TK_FOR
    ElseIf n = "next" Then
        LexKeywordKind = TK_NEXT
    ElseIf n = "do" Then
        LexKeywordKind = TK_DO
    ElseIf n = "loop" Then
        LexKeywordKind = TK_LOOP
    ElseIf n = "until" Then
        LexKeywordKind = TK_UNTIL
    ElseIf n = "select" Then
        LexKeywordKind = TK_SELECT
    ElseIf n = "case" Then
        LexKeywordKind = TK_CASE
    ElseIf n = "exit" Then
        LexKeywordKind = TK_EXIT
    ElseIf n = "print" Then
        LexKeywordKind = TK_PRINT
    ElseIf n = "input" Then
        LexKeywordKind = TK_INPUT
    ElseIf n = "as" Then
        LexKeywordKind = TK_AS
    ElseIf n = "byref" Then
        LexKeywordKind = TK_BYREF
    ElseIf n = "byval" Then
        LexKeywordKind = TK_BYVAL
    ElseIf n = "to" Then
        LexKeywordKind = TK_TO
    ElseIf n = "step" Then
        LexKeywordKind = TK_STEP
    ElseIf n = "varptr" Then
        LexKeywordKind = TK_VARPTR
    ElseIf n = "addressof" Then
        LexKeywordKind = TK_ADDRESSOF
    ElseIf n = "sizeof" Then
        LexKeywordKind = TK_SIZEOF
    End If
End Function

Function LexParseNum(p As *Byte, n As Long, ByRef pos As Long, ByRef outVal As Long) As Long
    Dim i As Long
    Dim sign As Long
    Dim v As Long
    Dim c As Long
    Dim start As Long

    LexParseNum = 0
    i = pos
    sign = 1
    If i < n And p[i] = CH_MINUS Then
        ' 単項はパーサ側。ここでは数値本体のみ
    End If
    start = i
    If i + 1 < n And p[i] = CH_AMP And (p[i + 1] = CH_H Or p[i + 1] = CH_LH) Then
        i = i + 2
        v = 0
        If i >= n Then Exit Function
        While i < n
            c = p[i]
            If IsDigit(c) <> 0 Then
                v = v * 16 + (c - CH_0)
            ElseIf IsUpper(c) <> 0 And c <= CH_F Then
                v = v * 16 + (c - CH_A + 10)
            ElseIf IsLower(c) <> 0 And c <= CH_LF Then
                v = v * 16 + (c - CH_LA + 10)
            Else
                Exit While
            End If
            i = i + 1
        Wend
        If i = start + 2 Then Exit Function
        outVal = v
        pos = i
        LexParseNum = 1
        Exit Function
    End If

    If i >= n Then Exit Function
    If IsDigit(p[i]) = 0 Then Exit Function
    v = 0
    While i < n
        c = p[i]
        If IsDigit(c) = 0 Then Exit While
        v = v * 10 + (c - CH_0)
        i = i + 1
    Wend
    outVal = v
    pos = i
    LexParseNum = 1
End Function

' 式文字列をトークン化。成功で 1
Function LexExpr(expr As String) As Long
    Dim e As String
    Dim p As *Byte
    Dim n As Long
    Dim i As Long
    Dim c As Long
    Dim start As Long
    Dim name As String
    Dim lit As String
    Dim litBuf[512] As Byte
    Dim litLen As Long
    Dim kw As Long
    Dim numVal As Long
    Dim closed As Long

    LexExpr = 0
    e = Trim$(expr)
    gNTok = 0
    gTokPos = 0
    gNPool = 0
    gNAst = 0

    n = Len(e)
    If n = 0 Then
        Print "empty expression"
        Exit Function
    End If
    ' ソース（式）全体を読める容量: 最悪 1 文字 1 トークン + EOF
    If TokEnsure(n + 2) = 0 Then Exit Function
    p = StrPtr(e)
    i = 0

    While i < n
        c = p[i]
        If c = CH_SP Or c = CH_TAB Then
            i = i + 1
        ElseIf c = CH_PLUS Then
            If TokPush(TK_PLUS, "+", 0) = 0 Then Exit Function
            i = i + 1
        ElseIf c = CH_MINUS And i + 1 < n And p[i + 1] = CH_GREATER Then
            If TokPush(TK_ARROW, "->", 0) = 0 Then Exit Function
            i = i + 2
        ElseIf c = CH_MINUS Then
            If TokPush(TK_MINUS, "-", 0) = 0 Then Exit Function
            i = i + 1
        ElseIf c = CH_STAR Then
            If TokPush(TK_STAR, "*", 0) = 0 Then Exit Function
            i = i + 1
        ElseIf c = CH_SLASH Then
            If TokPush(TK_SLASH, "/", 0) = 0 Then Exit Function
            i = i + 1
        ElseIf c = CH_BSLASH Then
            If TokPush(TK_BSLASH, Chr$(CH_BSLASH), 0) = 0 Then Exit Function
            i = i + 1
        ElseIf c = CH_EQ Then
            If TokPush(TK_EQ, "=", 0) = 0 Then Exit Function
            i = i + 1
        ElseIf c = CH_LESS Then
            If i + 1 < n And p[i + 1] = CH_GREATER Then
                If TokPush(TK_NE, "<>", 0) = 0 Then Exit Function
                i = i + 2
            ElseIf i + 1 < n And p[i + 1] = CH_EQ Then
                If TokPush(TK_LE, "<=", 0) = 0 Then Exit Function
                i = i + 2
            Else
                If TokPush(TK_LT, "<", 0) = 0 Then Exit Function
                i = i + 1
            End If
        ElseIf c = CH_GREATER Then
            If i + 1 < n And p[i + 1] = CH_EQ Then
                If TokPush(TK_GE, ">=", 0) = 0 Then Exit Function
                i = i + 2
            Else
                If TokPush(TK_GT, ">", 0) = 0 Then Exit Function
                i = i + 1
            End If
        ElseIf c = CH_LPAREN Then
            If TokPush(TK_LPAREN, "(", 0) = 0 Then Exit Function
            i = i + 1
        ElseIf c = CH_RPAREN Then
            If TokPush(TK_RPAREN, ")", 0) = 0 Then Exit Function
            i = i + 1
        ElseIf c = CH_LBRACK Then
            If TokPush(TK_LBRACK, "[", 0) = 0 Then Exit Function
            i = i + 1
        ElseIf c = CH_RBRACK Then
            If TokPush(TK_RBRACK, "]", 0) = 0 Then Exit Function
            i = i + 1
        ElseIf c = CH_COMMA Then
            If TokPush(TK_COMMA, ",", 0) = 0 Then Exit Function
            i = i + 1
        ElseIf c = CH_DOT Then
            If TokPush(TK_DOT, ".", 0) = 0 Then Exit Function
            i = i + 1
        ElseIf c = CH_AMP And i + 1 < n And (p[i + 1] = CH_H Or p[i + 1] = CH_LH) Then
            If LexParseNum(p, n, i, numVal) = 0 Then
                Print "bad hex number"
                Exit Function
            End If
            If TokPush(TK_NUM, "", numVal) = 0 Then Exit Function
        ElseIf IsDigit(c) <> 0 Then
            If LexParseNum(p, n, i, numVal) = 0 Then
                Print "bad number"
                Exit Function
            End If
            If TokPush(TK_NUM, "", numVal) = 0 Then Exit Function
        ElseIf c = CH_DQUOTE Then
            ' VB 風: "..." 内の "" は文字 "（lit+Chr$ の O(m^2) を避ける）
            i = i + 1
            litLen = 0
            closed = 0
            While i < n
                If p[i] = CH_DQUOTE Then
                    If i + 1 < n And p[i + 1] = CH_DQUOTE Then
                        If litLen >= 511 Then
                            Print "string literal too long"
                            Exit Function
                        End If
                        litBuf[litLen] = CH_DQUOTE
                        litLen = litLen + 1
                        i = i + 2
                    Else
                        i = i + 1
                        closed = 1
                        Exit While
                    End If
                Else
                    If litLen >= 511 Then
                        Print "string literal too long"
                        Exit Function
                    End If
                    litBuf[litLen] = p[i]
                    litLen = litLen + 1
                    i = i + 1
                End If
            Wend
            If closed = 0 Then
                Print "unterminated string"
                Exit Function
            End If
            litBuf[litLen] = 0
            lit = MakeStr(litBuf)
            If TokPush(TK_STR, lit, 0) = 0 Then Exit Function
        ElseIf LexIsIdentStart(c) <> 0 Then
            start = i
            i = i + 1
            While i < n
                If LexIsIdentChar(p[i]) = 0 Then Exit While
                i = i + 1
            Wend
            name = Mid$(e, start + 1, i - start)
            kw = LexKeywordKind(name)
            If TokPush(kw, name, 0) = 0 Then Exit Function
        Else
            Print "bad token near: " + Mid$(e, i + 1, 8)
            Exit Function
        End If
    Wend

    If TokPush(TK_EOF, "", 0) = 0 Then Exit Function
    gTokPos = 0
    LexExpr = 1
End Function
