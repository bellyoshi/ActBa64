' Utils.abp - 文字列・パス共通ユーティリティ
' 各ツールは xxx.idx 経由で #include する（.pj の #SOURCE にも列挙）

Function IsSpace(c As Long) As Long
    If c = CH_SP Or c = CH_TAB Or c = CH_CR Or c = CH_NL Then
        IsSpace = 1
    Else
        IsSpace = 0
    End If
End Function

Function Trim$(s As String) As String
    Dim p As *Byte
    Dim i As Long
    Dim j As Long
    Dim n As Long
    n = Len(s)
    If n = 0 Then
        Trim$ = ""
        Exit Function
    End If
    p = StrPtr(s)
    i = 0
    While i < n And IsSpace(p[i]) <> 0
        i = i + 1
    Wend
    j = n - 1
    While j >= i And IsSpace(p[j]) <> 0
        j = j - 1
    Wend
    If j < i Then
        Trim$ = ""
    Else
        Trim$ = Mid$(s, i + 1, j - i + 1)
    End If
End Function

' 大文字小文字を無視した文字列比較（ポインタ比較に落とさない）
Function StrEqCI(a As String, b As String) As Long
    Dim i As Long
    Dim n As Long
    Dim pa As *Byte
    Dim pb As *Byte
    Dim ca As Long
    Dim cb As Long
    StrEqCI = 0
    n = Len(a)
    If n <> Len(b) Then Exit Function
    If n = 0 Then
        StrEqCI = 1
        Exit Function
    End If
    pa = StrPtr(a)
    pb = StrPtr(b)
    For i = 0 To n - 1
        ca = pa[i]
        cb = pb[i]
        ca = ToLowerChar(ca)
        cb = ToLowerChar(cb)
        If ca <> cb Then Exit Function
    Next
    StrEqCI = 1
End Function

' Mid$/Left$ の部分文字列は Len と独立した \0 終端を持たないことがある。
' フル文字列の複製は memcpy で足りる（文字単位ループは極端に遅い）。
Function DupStr$(s As String) As String
    Dim n As Long
    Dim q As *Byte
    n = Len(s)
    If n = 0 Then
        DupStr$ = ""
        Exit Function
    End If
    q = malloc(n + 1)
    If q = 0 Then
        DupStr$ = ""
        Exit Function
    End If
    memcpy(q, StrPtr(s), n)
    q[n] = 0
    DupStr$ = MakeStr(q)
    free(q)
End Function

Function Lower$(s As String) As String
    Dim p As *Byte
    Dim i As Long
    Dim n As Long
    Dim c As Long
    Dim tmp As Long
    Dim bp As *Byte
    Dim r As String
    n = Len(s)
    If n = 0 Then
        Lower$ = ""
        Exit Function
    End If
    ' Len ベース複製のうえ小文字化（Mid$(s,1,n) / MakeStr(StrPtr) は不可）
    r = DupStr$(s)
    p = StrPtr(r)
    bp = VarPtr(tmp)
    For i = 0 To n - 1
        c = p[i]
        If IsUpper(c) <> 0 Then
            tmp = ToLowerChar(c)
            p[i] = bp[0]
        End If
    Next
    Lower$ = r
End Function

' 大文字小文字無視の InStr（s 全体の Lower$ を作らない）。戻りは 1 始まり、なしは 0
Function InStrCI(s As String, needle As String) As Long
    Dim ps As *Byte
    Dim pn As *Byte
    Dim ns As Long
    Dim nn As Long
    Dim i As Long
    Dim j As Long
    Dim ca As Long
    Dim cb As Long
    InStrCI = 0
    ns = Len(s)
    nn = Len(needle)
    If nn <= 0 Then
        InStrCI = 1
        Exit Function
    End If
    If ns < nn Then Exit Function
    ps = StrPtr(s)
    pn = StrPtr(needle)
    For i = 0 To ns - nn
        j = 0
        While j < nn
            ca = ps[i + j]
            cb = pn[j]
            ca = ToLowerChar(ca)
            cb = ToLowerChar(cb)
            If ca <> cb Then Exit While
            j = j + 1
        Wend
        If j = nn Then
            InStrCI = i + 1
            Exit Function
        End If
    Next
End Function

' 大文字小文字を区別する前方一致（Left$ を作らない）
Function StartsWith(s As String, prefix As String) As Long
    Dim n As Long
    Dim m As Long
    Dim i As Long
    Dim ps As *Byte
    Dim pp As *Byte
    n = Len(s)
    m = Len(prefix)
    StartsWith = 0
    If n < m Then Exit Function
    If m = 0 Then
        StartsWith = 1
        Exit Function
    End If
    ps = StrPtr(s)
    pp = StrPtr(prefix)
    For i = 0 To m - 1
        If ps[i] <> pp[i] Then Exit Function
    Next
    StartsWith = 1
End Function

' 大文字小文字を区別しない前方一致（Left$/Lower$ を作らない）
Function StartsWithCI(s As String, prefix As String) As Long
    Dim n As Long
    Dim m As Long
    Dim i As Long
    Dim ps As *Byte
    Dim pp As *Byte
    Dim ca As Long
    Dim cb As Long
    n = Len(s)
    m = Len(prefix)
    StartsWithCI = 0
    If n < m Then Exit Function
    If m = 0 Then
        StartsWithCI = 1
        Exit Function
    End If
    ps = StrPtr(s)
    pp = StrPtr(prefix)
    For i = 0 To m - 1
        ca = ps[i]
        cb = pp[i]
        ca = ToLowerChar(ca)
        cb = ToLowerChar(cb)
        If ca <> cb Then Exit Function
    Next
    StartsWithCI = 1
End Function

' 拡張子を除いたパス（ディレクトリ含む）
Function BaseName$(inPath As String) As String
    Dim i As Long
    Dim n As Long
    Dim ch As String
    Dim dotPos As Long
    Dim slashPos As Long
    n = Len(inPath)
    dotPos = 0
    slashPos = 0
    For i = 1 To n
        ch = Mid$(inPath, i, 1)
        If ch = "\" Or ch = "/" Then
            slashPos = i
            dotPos = 0
        ElseIf ch = "." Then
            dotPos = i
        End If
    Next
    If dotPos > slashPos Then
        BaseName$ = Left$(inPath, dotPos - 1)
    Else
        BaseName$ = inPath
    End If
End Function

' ディレクトリ部分（末尾に \ または / を含む）。無ければ ""
Function DirOf$(path As String) As String
    Dim i As Long
    Dim n As Long
    Dim ch As String
    Dim slashPos As Long
    n = Len(path)
    slashPos = 0
    For i = 1 To n
        ch = Mid$(path, i, 1)
        If ch = "\" Or ch = "/" Then
            slashPos = i
        End If
    Next
    If slashPos > 0 Then
        DirOf$ = Left$(path, slashPos)
    Else
        DirOf$ = ""
    End If
End Function

Function FileNameOnly$(path As String) As String
    Dim d As String
    Dim n As Long
    d = DirOf$(path)
    n = Len(d)
    If n = 0 Then
        FileNameOnly$ = path
    Else
        FileNameOnly$ = Mid$(path, n + 1, Len(path) - n)
    End If
End Function

Function EndsWithExt(path As String, ext As String) As Long
    Dim n As Long
    Dim m As Long
    Dim i As Long
    Dim cp As Long
    Dim ce As Long
    Dim pp As *Byte
    Dim pe As *Byte
    n = Len(path)
    m = Len(ext)
    EndsWithExt = 0
    If n < m Then Exit Function
    If m = 0 Then
        EndsWithExt = 1
        Exit Function
    End If
    pp = StrPtr(path)
    pe = StrPtr(ext)
    For i = 0 To m - 1
        cp = pp[n - m + i]
        ce = pe[i]
        cp = ToLowerChar(cp)
        ce = ToLowerChar(ce)
        If cp <> ce Then Exit Function
    Next
    EndsWithExt = 1
End Function

' 拡張子を newExt（例: ".asm"）に置換したパスを返す
Function ChangeExtension$(inPath As String, newExt As String) As String
    Dim base As String
    base = BaseName$(inPath)
    ChangeExtension$ = base + newExt
End Function
